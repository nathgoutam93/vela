// The Vela compiler's command line.
//
//     vela build FILE [-o EXE]    compile to an executable
//     vela run FILE [ARGS...]     compile to a temporary executable and run it
//     vela test FILE [WORDS...]   run the program's tests (those whose names
//                                 contain one of the words, if any are given)
//     vela c FILE                 print the generated C
//     vela ir FILE                print the native backend's IR (see ir.vl)
//     vela asm FILE               print native host assembly (--target selects a format)
//     vela check FILE             check a program or library, generate nothing
//     vela check --json FILE      the same, as one JSON document on stdout
//     vela explain CODE           explain a stable diagnostic code
//     vela fix [--dry-run] FILE    apply diagnostic edits to local sources
//     vela guide                  generate a compact language reference
//     vela tokens FILE            print the token stream
//     vela ast FILE               print the syntax tree
//     vela fmt [-w | -l] FILE...  print the files formatted; -w rewrites them,
//                                 -l lists the ones that are not formatted
//     vela query WHAT ...         answer a question about a program, in JSON
//                                 (see query.vl)
//     vela rename FILE:LINE:COL NEW
//                                 rename the name there everywhere, if that
//                                 changes nothing else (see rename.vl)
//     vela lsp                    a language server, on stdin and stdout
//     vela get [-u] [NAME SOURCE [REF]]
//                                 fetch the packages vela.mod names, and
//                                 write vela.lock (see packages.vl)
//     vela new [--package] NAME   make a program (or a package) to start
//                                 from, in a new directory NAME
//
// Exit codes as in Stage 0: 0 success, 1 the program has errors, 2 bad
// command line, 70 internal compiler error.
//
//
// VELA_CC picks the C compiler (default `cc`); VELA_CFLAGS adds flags to its
// command line, split at spaces. The native backend (M11, lower.vl and
// x64.vl/arm64.vl) compiles programs to host assembly instead of C, which the C
// compiler then assembles beside the runtime: `vela run` and `vela test`
// use it on Linux x86-64 and macOS ARM64; `vela build` uses C. VELA_BACKEND=c or
// VELA_BACKEND=native says which for all three (see native()). The runtime and the standard modules are
// found in runtime/ and std/ next to the build/ directory this program is
// in, or under VELA_ROOT if it is set.
import ast
import agent_queries
import capabilities
import json
import sysio
import checker
import codegen
import complete
import errors
import diagnostics
import fixer
import guide
import files
import format
import ir
import lexer
import lower
import lsp
import modules
import opt
import os
import packages
import parser
import query
import rename
import strings
import tasks
import targets

fn main() {
    let args = os.args()
    if len(args) == 2 && args[1] == "lsp" {
        lsp.serve(modules.join(root_dir(), "std"))
        return
    }
    if len(args) == 2 && args[1] == "guide" {
        print(guide.reference(root_dir()))
        return
    }
    if len(args) < 2 || len(args) < 3 && args[1] != "get" {
        usage()
    }
    let command = args[1]
    if command == "explain" {
        if len(args) != 3 {
            usage()
        }
        match diagnostics.explain(args[2]) {
            Some(explanation) => print(explanation)
            None => {
                os.eprint("vela: error: unknown diagnostic code '" + args[2] + "' [E6006]")
                os.exit(2)
            }
        }
        return
    }
    if command == "fix" {
        let root = root_dir()
        if len(args) == 3 {
            fixer.command(args[2], root, false)
        } else if len(args) == 4 && args[2] == "--dry-run" {
            fixer.command(args[3], root, true)
        } else {
            usage()
        }
        return
    }
    if command == "get" {
        get_command(args[2..len(args)])
        return
    }
    if command == "new" {
        new_command(args[2..len(args)])
        return
    }
    if command == "fmt" {
        fmt(args[2..len(args)])
        return
    }
    let root = root_dir()
    if command == "query" {
        if len(args) == 5 && args[2] == "rename" {
            rename.command(args[3], args[4], modules.join(root, "std"), false)
            return
        }
        if len(args) == 4 && args[2] == "complete" {
            complete.command(args[3], modules.join(root, "std"))
            return
        }
        query.command(args[2..len(args)], modules.join(root, "std"))
        return
    }
    if command == "rename" {
        if len(args) != 4 {
            os.eprint("usage: vela rename FILE:LINE:COL NEW")
            os.exit(2)
        }
        rename.command(args[2], args[3], modules.join(root, "std"), true)
        return
    }
    if command == "check" && args[2] == "--json" {
        if len(args) != 4 {
            usage()
        }
        check_json(args[3], root)
        return
    }
    if command == "run" || command == "test" {
        let options = capabilities.parse(args[2..len(args)], command == "test")
        let path = options.rest[0]
        if command == "run" { run(path, options.rest[1..len(options.rest)], root, options) } else { test_command(path, options.rest[1..len(options.rest)], root, options) }
        return
    }
    let path = args[2]
    if command == "build" || command == "asm" {
        target_command(command, args[2..len(args)], root)
        return
    }
    if len(args) != 3 {
        usage()
    }
    if command == "tokens" {
        tokens(path)
    } else if command == "ast" {
        syntax_tree(path)
    } else if command == "check" {
        checked_mode(path, root, true)
    } else if command == "ir" {
        print(ir.program_text(lowered(path, native_program(path, checked(path, root), false))))
    } else if command == "c" {
        let out = c_code(path, codegen.generate(checked(path, root)))
        print(out[0..len(out) - 1])
    } else {
        usage()
    }
}

fn target_command(command: Str, words: [Str], root: Str) uses fs, os {
    let mut path = ""; let mut output = ""; let mut target = ""; let mut at = 0
    for at < len(words) {
        let word = words[at]; at = at + 1
        if word == "--target" || word == "-o" || word == "--output" {
            if at >= len(words) { usage() }; let value = words[at]; at = at + 1
            if word == "--target" { if target != "" { usage() }; target = targets.normalize(value) } else { if command != "build" || output != "" { usage() }; output = value }
        } else { if path != "" || len(word) > 0 && word[0] == '-' { usage() }; path = word }
    }
    if path == "" { usage() }
    if command == "asm" { targets.require_native(target); let out = targets.program(lowered(path, native_program(path, checked_target(path, root, false, target), false)), target); print(out[0..len(out) - 1]); return }
    if output == "" { output = default_output(path) }
    build_from(path, output, root, false, checked_target(path, root, false, target), link_flags(path), target)
}

fn usage() uses os {
    os.eprint("usage: vela (build | run | test | c | ir | asm | check | tokens | ast | fmt | query) FILE, vela rename, vela lsp, " +
        "vela get, vela new, vela explain CODE, vela fix [--dry-run] FILE, or vela guide")
    os.exit(2)
}

// The directory holding runtime/ and std/.
fn root_dir() -> Str uses os {
    match os.env("VELA_ROOT") {
        Some(r) => return r
        None => {}
    }
    return modules.dirname(modules.dirname(os.executable()))
}

fn driver_error(message: Str) uses os {
    os.eprint("vela: error: " + message + " [E6001]")
    os.exit(1)
}

fn internal_error(message: Str) uses os {
    os.eprint("vela: internal compiler error: " + message + " [E6002]")
    os.exit(70)
}

fn read(path: Str) -> Str uses fs, os {
    match files.read(path) {
        Ok(text) => return text
        Err(e) => driver_error(e)
    }
    return ""  // not reached
}

// Print every error, each with the file it is in, and stop.
fn fail(path: Str, errs: [errors.CompileError]) uses os {
    for e in errs {
        let mut shown = e
        if shown.path == "" {
            shown.path = path
        }
        os.eprint(errors.render(shown))
    }
    os.exit(1)
}

fn tokens(path: Str) uses fs, os {
    let lexed = lexer.tokenize(read(path))
    if len(lexed.errors) > 0 {
        fail(path, lexed.errors)
    }
    let out = lexer.dump(lexed.tokens)
    // print adds a newline, and the dump already ends with one.
    print(out[0..len(out) - 1])
}

fn syntax_tree(path: Str) uses fs, os {
    let lexed = lexer.tokenize(read(path))
    if len(lexed.errors) > 0 {
        fail(path, lexed.errors)
    }
    let parsed = parser.parse(lexed.tokens, 0)
    if len(parsed.errors) > 0 {
        fail(path, parsed.errors)
    }
    let out = ast.dump(parsed.program)
    if len(out) > 0 {
        print(out[0..len(out) - 1])
    }
}

// Load and check a whole program; returns it checked, or stops with its errors.
fn checked(path: Str, root: Str) -> checker.Checked uses fs, os {
    return checked_mode(path, root, false)
}

fn checked_mode(path: Str, root: Str, library: Bool) -> checker.Checked uses fs, os {
    return checked_target(path, root, library, "")
}

fn checked_target(path: Str, root: Str, library: Bool, target: Str) -> checker.Checked uses fs, os {
    let loaded = load(path, read(path), root)
    if len(loaded.errors) > 0 {
        fail(path, loaded.errors)
    }
    let result = checker.check_target(loaded, library, "", targets.selected(target))
    if len(result.errors) > 0 {
        fail(path, errors.merged(result.errors, result.warnings))
    }
    warn(path, result.warnings)
    return result
}

// The program whose main file is `path`, with the packages its vela.mod
// and vela.lock name; it stops if they cannot be found.
fn load(path: Str, source: Str, root: Str) -> modules.Loaded uses fs, os {
    match packages.for_program(path) {
        Ok(pk) => return modules.load_program(path, source, modules.join(root, "std"), [:], pk)
        Err(e) => driver_error(e)
    }
    return modules.load(path, source, modules.join(root, "std"))  // not reached
}

// `vela get [-u] [NAME SOURCE [REF]]`: fetch the packages vela.mod in this
// directory names, and write vela.lock. With NAME and SOURCE, first set
// the `use` line for NAME in vela.mod (writing vela.mod if there is none).
// With -u, the lock is not consulted: branches and tags are looked up again.
fn get_command(args: [Str]) uses fs, os {
    let mut rest = args
    let mut update = false
    if len(rest) > 0 && rest[0] == "-u" {
        update = true
        rest = rest[1..len(rest)]
    }
    if len(rest) == 1 || len(rest) > 3 {
        os.eprint("usage: vela get [-u] [NAME SOURCE [REF]]")
        os.exit(2)
    }
    if len(rest) >= 2 {
        let mut line = "use " + rest[0] + " " + rest[1]
        if len(rest) == 3 {
            line = line + " " + rest[2]
        }
        let mut text = ""
        match files.read("vela.mod") {
            Ok(t) => text = t
            Err(_) => {}
        }
        match files.write("vela.mod", packages.with_use(text, rest[0], line)) {
            Ok(_) => {}
            Err(e) => driver_error(e)
        }
    }
    let mut old: Map[Str, packages.Locked] = [:]
    if !update {
        match files.read("vela.lock") {
            Ok(t) => {
                match packages.parse_lock(t, "vela.lock") {
                    Ok(l) => old = l
                    Err(e) => driver_error(e)
                }
            }
            Err(_) => {}
        }
    }
    match packages.get("", old) {
        Ok(locked) => {
            match files.write("vela.lock", packages.lock_text(locked)) {
                Ok(_) => {}
                Err(e) => driver_error(e)
            }
            for l in locked {
                print(l.name + " " + l.ref + " " + l.commit[0..12] + " " + l.source)
            }
        }
        Err(e) => driver_error(e)
    }
}

// `vela new [--package] NAME`: a directory NAME with a program to start
// from (see packages.new_files), which builds, runs and tests as it is.
fn new_command(args: [Str]) uses fs, os {
    let mut rest = args
    let mut package = false
    if len(rest) > 0 && rest[0] == "--package" {
        package = true
        rest = rest[1..len(rest)]
    }
    if len(rest) != 1 {
        os.eprint("usage: vela new [--package] NAME")
        os.exit(2)
    }
    let name = rest[0]
    let why = packages.bad_name(name)
    if why != "" {
        driver_error(why)
    }
    match os.run(["test", "-e", name]) {
        Ok(code) => {
            if code == 0 {
                driver_error(name + " exists already")
            }
        }
        Err(e) => driver_error(e)
    }
    match os.run(["mkdir", name]) {
        Ok(code) => {
            if code != 0 {
                driver_error("cannot make the directory " + name)
            }
        }
        Err(e) => driver_error(e)
    }
    let made = packages.new_files(name, package)
    for f in made {
        match files.write(f[0], f[1]) {
            Ok(_) => {}
            Err(e) => driver_error(e)
        }
        print("made " + f[0])
    }
    if package {
        print("next: cd " + name + " && vela test " + name + ".vl")
    } else {
        print("next: cd " + name + " && vela run main.vl && vela test main.vl")
    }
}

// Print warnings; they do not stop the compiler.
fn warn(path: Str, warnings: [errors.CompileError]) {
    for w in warnings {
        let mut shown = w
        if shown.path == "" {
            shown.path = path
        }
        os.eprint(errors.render(shown))
    }
}

// FILE without its extension, as Stage 0 picks it.
fn default_output(path: Str) -> Str {
    let dir = modules.dirname(path)
    let name = modules.stem(path)
    if dir == "" {
        return name
    }
    return modules.join(dir, name)
}

// The words of VELA_CFLAGS.
fn split_flags(flags: Str) -> [Str] {
    let mut out: [Str] = []
    let mut start = 0
    for i in 0..len(flags) + 1 {
        if i == len(flags) || flags[i] == ' ' || flags[i] == '\t' {
            if i > start {
                push(mut out, flags[start..i])
            }
            start = i + 1
        }
    }
    return out
}

// Compile a .vl file all the way to an executable; `quick` for `vela run`.
fn build(path: Str, exe: Str, root: Str, quick: Bool) uses fs, os {
    build_from(path, exe, root, quick, checked(path, root), link_flags(path), "")
}
// Admission and generation use the same immutable source/link snapshot.
fn build_from(path: Str, exe: Str, root: Str, quick: Bool, k: checker.Checked, libraries: [Str], target: Str) uses fs, os {
    if native(quick) {
        targets.require_native(target)
        let p = lowered(path, native_program(path, k, false))
        assemble(targets.program(p, target), modules.stem(path), exe, root, "-O2", libraries, target)
        return
    }
    compile(c_code(path, codegen.generate(k)), modules.stem(path), exe, root, "-O2", libraries, target)
}

// VELA_BACKEND=c or VELA_BACKEND=native picks the backend. Otherwise `vela
// build` uses C, whose code is faster, and `vela run` and `vela test` (the
// `quick` ones) the native backend, which builds much faster (M11b): on
// Linux x86-64 and macOS ARM64, and C elsewhere.
fn native(quick: Bool) -> Bool uses os {
    match os.env("VELA_BACKEND") {
        Some(b) => return b == "native"
        None => {}
    }
    if !quick {
        return false
    }
    return targets.native_supported(targets.host())
}

// The IR, optimized (opt.vl) unless VELA_OPT=0.
fn native_program(path: Str, k: checker.Checked, for_tests: Bool) -> Result[ir.Program, [errors.CompileError]] uses os {
    match lower.lower(k, for_tests) {
        Ok(p) => {
            match os.env("VELA_OPT") {
                Some(v) => {
                    if v == "0" {
                        return Ok(p)
                    }
                }
                None => {}
            }
            match os.env("VELA_INLINE") {
                Some(v) => {
                    let n = strings.parse_float(v)
                    match n {
                        Some(x) => return Ok(opt.optimize_with(p, int(x), 2))
                        None => {}
                    }
                }
                None => {}
            }
            return Ok(opt.optimize(p))
        }
        Err(e) => return Err(e)
    }
}

// The IR, or stop with the errors that only making it found.
fn lowered(path: Str, made: Result[ir.Program, [errors.CompileError]]) -> ir.Program uses os {
    match made {
        Ok(p) => return p
        Err(errs) => fail(path, errs)
    }
    return ir.Program { funcs: [], data: [] }  // not reached
}

// Assembly into a scratch directory, assembled by the C compiler at the
// same time as it compiles the runtime (optimizing at `opt`), then linked.
fn assemble(asm: Str, stem: Str, exe: Str, root: Str, opt: Str, libraries: [Str], target: Str) uses fs, os {
    let mut tmp = ""
    match files.temp_dir() {
        Ok(dir) => tmp = dir
        Err(e) => driver_error(e)
    }
    let compiler = targets.compiler(target)
    let cc = compiler[0]
    let mut flags = targets.flags(target)
    match os.env("VELA_CFLAGS") {
        Some(f) => { for word in split_flags(f) { push(mut flags, word) } }
        None => {}
    }
    let runtime = modules.join(root, "runtime")
    let source = modules.join(tmp, stem + ".s")
    match files.write(source, asm) {
        Ok(_) => {}
        Err(e) => driver_error(e)
    }
    let program_o = modules.join(tmp, "program.o")
    let mut runtime_o = modules.join(tmp, "runtime.o")
    let mut rt = compiler
    for word in ["-std=c11", opt] { push(mut rt, word) }
    for f in flags {
        push(mut rt, f)
    }
    for word in ["-I", runtime, "-c", modules.join(runtime, "vela_rt.c"), "-o", runtime_o] {
        push(mut rt, word)
    }
    // The runtime from the cache when it is there (M16b).
    let cached = cached_runtime(root, join_words(compiler), opt, flags, target)
    let have = cached != "" && exists(cached)
    let mut assembler = compiler
    for f in targets.assembly_flags(target) { push(mut assembler, f) }
    for word in ["-c", source, "-o", program_o] { push(mut assembler, word) }
    let mut commands = [assembler, rt]
    if have { commands = [assembler] }
    let codes = tasks.map(commands, fn(command) {
        match os.run(command) {
            Ok(code) => return code
            Err(_) => return -1
        }
    })
    let mut failed: [Str] = []
    let mut linking_failed = false
    for i in 0..len(codes) {
        if codes[i] < 0 {
            driver_error("C compiler '" + cc + "' could not be run; install gcc or clang, or set VELA_CC")
        }
        if codes[i] != 0 {
            failed = commands[i]
        }
    }
    if len(failed) == 0 && cached != "" && !have {
        keep_runtime(runtime_o, cached, tmp)
    }
    if have {
        runtime_o = cached
    }
    if len(failed) == 0 {
        let mut link = compiler
        for f in flags {
            push(mut link, f)
        }
        for f in targets.libraries(target) { push(mut link, f) }
        for word in [program_o, runtime_o, "-lm", "-o", exe] {
            push(mut link, word)
        }
        for library in libraries { push(mut link, library) }
        match os.run(link) {
            Ok(c) => {
                if c != 0 {
                    failed = link
                    linking_failed = true
                }
            }
            Err(e) => driver_error("C compiler '" + cc + "' could not be run (" + e + ")")
        }
    }
    for f in [source, program_o, runtime_o] {
        if f != cached {
            files.remove(f)
        }
    }
    files.remove(tmp)
    if len(failed) > 0 {
        if linking_failed { driver_error("linker rejected the program; check extern symbols and link entries in vela.mod\ncommand: " + join_words(failed)) }
        if target != "" && targets.selected(target) != targets.host() { driver_error("target toolchain rejected assembly/runtime for " + targets.selected(target) + "; check VELA_TARGET_CC, VELA_SYSROOT and VELA_CFLAGS\ncommand: " + join_words(failed)) }
        internal_error("the assembler or linker rejected the generated code\ncommand: " + join_words(failed))
    }
}

// The C, or stop with the errors that only writing it found.
fn c_code(path: Str, generated: Result[Str, [errors.CompileError]]) -> Str uses os {
    match generated {
        Ok(c) => return c
        Err(errs) => fail(path, errs)
    }
    return ""  // not reached
}

// C into a scratch directory, then the C compiler, optimizing at `opt`.
//
// The C compiler gets a large program in parts, compiled at the same time
// as each other and the runtime, then linked: the code generator marks
// where the C may be cut, and every part starts with what all of them
// need (types, memory functions, prototypes). Building the compiler takes
// a third of the time on four cores.
fn compile(c_source: Str, stem: Str, exe: Str, root: Str, opt: Str, libraries: [Str], target: Str) uses fs, os {
    let mut tmp = ""
    match files.temp_dir() {
        Ok(dir) => tmp = dir
        Err(e) => driver_error(e)
    }
    let compiler = targets.compiler(target)
    let cc = compiler[0]
    let mut flags = targets.flags(target)
    match os.env("VELA_CFLAGS") {
        Some(f) => { for word in split_flags(f) { push(mut flags, word) } }
        None => {}
    }
    let runtime = modules.join(root, "runtime")
    // -pthread: the runtime runs tasks on threads.
    let mut base = compiler
    for word in ["-std=c11", opt] { push(mut base, word) }
    for f in flags {
        push(mut base, f)
    }
    push(mut base, "-I")
    push(mut base, runtime)
    let mut commands: [[Str]] = []
    let mut written: [Str] = []
    let mut objects: [Str] = []
    // The runtime once per set of flags, from the cache when it is there.
    let cached = cached_runtime(root, join_words(compiler), opt, flags, target)
    let have = cached != "" && exists(cached)
    // About 400 KB of C per unit before another is worth starting.
    let units = c_parts(c_source, tasks.workers(), 400000)
    for i in 0..len(units) + 1 {
        if i == len(units) && have {
            push(mut objects, cached)
            continue
        }
        let mut source = modules.join(runtime, "vela_rt.c")
        if i < len(units) {
            source = modules.join(tmp, stem + "_" + strings.from_int(i) + ".c")
            match files.write(source, units[i]) {
                Ok(_) => push(mut written, source)
                Err(e) => driver_error(e)
            }
        }
        let object = modules.join(tmp, "part" + strings.from_int(i) + ".o")
        push(mut objects, object)
        let mut command = base
        for word in ["-c", source, "-o", object] {
            push(mut command, word)
        }
        push(mut commands, command)
    }
    let codes = tasks.map(commands, fn(command) {
        match os.run(command) {
            Ok(code) => return code
            Err(_) => return -1
        }
    })
    let mut failed: [Str] = []
    let mut linking_failed = false
    for i in 0..len(codes) {
        if codes[i] < 0 {
            driver_error("C compiler '" + cc + "' could not be run; install gcc or clang, or set VELA_CC")
        }
        if codes[i] != 0 {
            failed = commands[i]
        }
    }
    let mut link = compiler
    for f in flags {
        push(mut link, f)
    }
    for o in objects {
        push(mut link, o)
    }
    for library in libraries { push(mut link, library) }
    for f in targets.libraries(target) { push(mut link, f) }
    push(mut link, "-lm")  // math.sqrt
    push(mut link, "-o")
    push(mut link, exe)
    let mut code = 0
    if len(failed) == 0 {
        match os.run(link) {
            Ok(c) => code = c
            Err(e) => driver_error("C compiler '" + cc + "' could not be run (" + e + "); install gcc or clang, or set VELA_CC")
        }
        if code != 0 {
            failed = link
            linking_failed = true
        }
    }
    if len(failed) == 0 && cached != "" && !have {
        keep_runtime(objects[len(objects) - 1], cached, tmp)
    }
    // The scratch directory goes either way.
    for f in written {
        files.remove(f)
    }
    for o in objects {
        if o != cached {
            files.remove(o)
        }
    }
    files.remove(tmp)
    if len(failed) > 0 {
        if linking_failed { driver_error("linker rejected the program; check extern symbols and link entries in vela.mod\ncommand: " + join_words(failed)) }
        if target != "" && targets.selected(target) != targets.host() { driver_error("target toolchain rejected C/runtime for " + targets.selected(target) + "; check VELA_TARGET_CC, VELA_SYSROOT and VELA_CFLAGS\ncommand: " + join_words(failed)) }
        internal_error("the C compiler rejected the generated code\ncommand: " + join_words(failed))
    }
}

// ---- The runtime's cache (M16b) ----
//
// Every build used to compile the C runtime, vela_rt.c, with the program:
// 0.55 of the 0.6 seconds `vela run` took for a program that prints one
// line. Now it is compiled once for each C compiler, optimization level,
// set of VELA_CFLAGS and version of the runtime, and kept in the cache
// directory: VELA_CACHE, else $XDG_CACHE_HOME/vela, else ~/.cache/vela.
// VELA_CACHE=off turns it off. Nothing else is cached: the program is
// compiled every time.

fn cache_dir() -> Str uses os {
    match os.env("VELA_CACHE") {
        Some(d) => {
            if d == "off" || d == "0" {
                return ""
            }
            if d != "" {
                return d
            }
        }
        None => {}
    }
    match os.env("XDG_CACHE_HOME") {
        Some(d) => {
            if d != "" {
                return modules.join(d, "vela")
            }
        }
        None => {}
    }
    match os.env("HOME") {
        Some(h) => {
            if h != "" {
                return modules.join(modules.join(h, ".cache"), "vela")
            }
        }
        None => {}
    }
    return ""
}

// A polynomial hash of the bytes, below `modulus` (under 2^31, so no step
// can overflow).
fn text_hash(text: Str, base: Int, modulus: Int) -> Int {
    let mut h = len(text) % modulus
    for c in text {
        h = (h * base + int(c) + 1) % modulus
    }
    return h
}

// Where the runtime compiled with these flags is kept, named by a hash of
// the flags and of the runtime's source; "" when there is no cache.
fn cached_runtime(root: Str, cc: Str, opt: Str, flags: [Str], target: Str) -> Str uses fs, os {
    let dir = cache_dir()
    if dir == "" {
        return ""
    }
    let mut b = strings.builder()
    strings.add(mut b, targets.selected(target) + "\n" + cc + "\n" + opt + "\n" + join_words(flags) + "\n")
    for name in ["vela_rt.c", "vela_rt.h", "vela_int.h", "vela_sys.inc", "vela_policy.inc", "vela_threads.h", "vela_policy_portable.inc", "vela_windows.h", "vela_windows_net.h", "vela_windows_process.inc"] {
        match files.read(modules.join(modules.join(root, "runtime"), name)) {
            Ok(t) => strings.add(mut b, t)
            Err(_) => return ""
        }
    }
    let text = strings.build(b)
    let key = strings.from_int(text_hash(text, 257, 2147483647)) + "-" + strings.from_int(text_hash(text, 65599, 2147483629))
    return modules.join(dir, "runtime-" + key + ".o")
}

fn exists(path: Str) -> Bool uses os {
    match os.run(["test", "-f", path]) {
        Ok(code) => return code == 0
        Err(_) => return false
    }
}

// Put the runtime just compiled, `object`, in the cache at `path`: copied
// beside it, then renamed, so that a build running at the same time never
// sees half of it. A cache that cannot be written is not an error.
fn keep_runtime(object: Str, path: Str, tmp: Str) uses os {
    let partial = path + "." + modules.stem(tmp) + ".part"
    match os.run(["mkdir", "-p", modules.dirname(path)]) {
        Ok(code) => {
            if code != 0 {
                return
            }
        }
        Err(_) => return
    }
    match os.run(["cp", object, partial]) {
        Ok(code) => {
            if code == 0 {
                os.run(["mv", "-f", partial, path])
            }
        }
        Err(_) => {}
    }
}

// The C cut into at most `n` translation units at the code generator's
// marks, each the shared beginning and a run of whole parts, of about the
// same size, and one unit for every `unit_size` bytes at most: each unit
// costs a run of the C compiler, so a small program stays in one.
fn c_parts(c: Str, n: Int, unit_size: Int) -> [Str] {
    let mark = codegen.part_mark()
    let mut cuts: [Int] = []  // where each part starts
    let mut i = 0
    for i + len(mark) <= len(c) {
        if c[i] == '/' && c[i..i + len(mark)] == mark {
            push(mut cuts, i)
            i = i + len(mark)
        } else {
            i = i + 1
        }
    }
    if len(cuts) == 0 {
        return [c]
    }
    let head = c[0..cuts[0]]
    let body = len(c) - cuts[0]
    let mut k = body / unit_size + 1
    if k > n {
        k = n
    }
    if k > len(cuts) {
        k = len(cuts)
    }
    let mut units: [Str] = []
    let mut start = cuts[0]
    let mut next = 1
    for u in 1..k {
        // The first cut at or after this unit's share of the body.
        let goal = cuts[0] + body * u / k
        for next < len(cuts) && cuts[next] < goal {
            next = next + 1
        }
        if next < len(cuts) && cuts[next] > start {
            push(mut units, head + c[start..cuts[next]])
            start = cuts[next]
        }
    }
    push(mut units, head + c[start..len(c)])
    return units
}
fn join_words(words: [Str]) -> Str {
    let mut b = strings.builder()
    for i in 0..len(words) {
        if i > 0 {
            strings.add_byte(mut b, ' ')
        }
        strings.add(mut b, words[i])
    }
    return strings.build(b)
}

// Compile to a temporary executable, run it with `args`, and exit with its code.
fn run(path: Str, args: [Str], root: Str, options: capabilities.Options) uses fs, os {
    let k = checked(path, root)
    let libraries = link_flags(path)
    capabilities.admit(k, options, libraries, false)
    let mut tmp = ""
    match files.temp_dir() {
        Ok(dir) => tmp = dir
        Err(e) => driver_error(e)
    }
    let exe = modules.join(tmp, "program")
    build_from(path, exe, root, true, k, libraries, "")
    let mut command = [exe]
    for a in args {
        push(mut command, a)
    }
    let result = sysio.sandbox_run(command, options.allow, options.deny)
    files.remove(exe)
    files.remove(tmp)
    match result {
        Ok(code) => os.exit(code)
        Err(e) => capabilities.fail(e)
    }
}

// `vela fmt`: every file is formatted, or its errors reported, before the
// exit code says whether all went well (and with -l, whether all were
// formatted already).
fn fmt(args: [Str]) uses fs, os {
    let mut mode = ""
    let mut paths = args
    if len(args) > 0 && (args[0] == "-w" || args[0] == "-l") {
        mode = args[0]
        paths = args[1..len(args)]
    }
    if len(paths) == 0 {
        os.eprint("usage: vela fmt [-w | -l] FILE...")
        os.exit(2)
    }
    let mut failed = false
    for path in paths {
        let source = read(path)
        match format.format(source) {
            Err(errs) => {
                for e in errs {
                    let mut shown = e
                    shown.path = path
                    os.eprint(errors.render(shown))
                }
                failed = true
            }
            Ok(out) => {
                if mode == "-w" {
                    if out != source {
                        match files.write(path, out) {
                            Ok(_) => {}
                            Err(e) => driver_error(e)
                        }
                    }
                } else if mode == "-l" {
                    if out != source {
                        print(path)
                        failed = true
                    }
                } else {
                    print(out[0..len(out) - 1])
                }
            }
        }
    }
    if failed {
        os.exit(1)
    }
}

// `vela check --json`: every error the program has, for tools to read:
//
//     {"ok": false, "errors": [
//       {"file": "a.vl", "line": 3, "col": 7, "severity": "error",
//        "message": "...", "code": "E3093", "fix": []}
//     ]}
//
// It exits 1 when there are errors, as `check` does.
fn check_json(path: Str, root: Str) uses fs, os {
    let mut errs: [errors.CompileError] = []
    let mut failed = false
    match files.read(path) {
        Err(e) => {
            push(mut errs, errors.CompileError { code: "E7002", fix: [], path: path, line: 0, col: 0, message: e, warning: false })
            failed = true
        }
        Ok(source) => {
            let mut loaded = modules.load(path, source, modules.join(root, "std"))
            match packages.for_program(path) {
                Ok(pk) => loaded = modules.load_program(path, source, modules.join(root, "std"), [:], pk)
                Err(e) => {
                    let at = modules.join(modules.dirname(path), "vela.mod")
                    // Only this: without the packages, what imports them cannot load either.
                    loaded.errors = [errors.CompileError { code: "E7003", fix: [], path: at, line: 1, col: 1, message: e, warning: false }]
                }
            }
            errs = loaded.errors
            if len(errs) == 0 {
                let k = checker.check_target(loaded, true, "", targets.host())
                failed = len(k.errors) > 0
                errs = errors.merged(k.errors, k.warnings)
            } else {
                failed = true
            }
        }
    }
    let mut b = strings.builder()
    if len(errs) == 0 {
        strings.add(mut b, "{\"ok\": true, \"errors\": []}")
    } else {
        if failed {
            strings.add(mut b, "{\"ok\": false, \"errors\": [")
        } else {
            strings.add(mut b, "{\"ok\": true, \"errors\": [")
        }
        for i in 0..len(errs) {
            let e = errs[i]
            let mut file = e.path
            if file == "" {
                file = path
            }
            strings.add(mut b, "\n  {\"file\": " + json_string(file) + ", \"line\": ")
            strings.add_int(mut b, e.line)
            strings.add(mut b, ", \"col\": ")
            strings.add_int(mut b, e.col)
            let mut severity = "error"
            if e.warning {
                severity = "warning"
            }
            strings.add(mut b, ", \"severity\": \"" + severity + "\", \"message\": " + json_string(e.message) + ", \"code\": " + json_string(e.code) + ", \"fix\": " + edits_json(e.fix) + "}")
            if i < len(errs) - 1 {
                strings.add_byte(mut b, ',')
            }
        }
        strings.add(mut b, "\n]}")
    }
    print(strings.build(b))
    if failed {
        os.exit(1)
    }
}

fn json_string(s: Str) -> Str {
    let mut b = strings.builder()
    strings.add_byte(mut b, '"')
    for c in s {
        if c == '"' || c == '\\' {
            strings.add_byte(mut b, '\\')
            strings.add_byte(mut b, c)
        } else if c == '\n' {
            strings.add(mut b, "\\n")
        } else if c == '\t' {
            strings.add(mut b, "\\t")
        } else if c < 32 {
            strings.add(mut b, "\\u00")
            strings.add_byte(mut b, hex_digit(int(c) / 16))
            strings.add_byte(mut b, hex_digit(int(c) % 16))
        } else {
            strings.add_byte(mut b, c)
        }
    }
    strings.add_byte(mut b, '"')
    return strings.build(b)
}

fn hex_digit(n: Int) -> Byte {
    if n < 10 {
        return byte(48 + n)
    }
    return byte(87 + n)
}

// `vela test`: build the program's tests into one executable, then run it
// once per test, so a test that panics fails alone and the rest still run.
fn test_command(path: Str, words: [Str], root: Str, options: capabilities.Options) uses fs, os {
    let loaded = load(path, read(path), root)
    if len(loaded.errors) > 0 {
        fail(path, loaded.errors)
    }
    let k = checker.check_target(loaded, true, "", targets.host())
    if len(k.errors) > 0 {
        fail(path, errors.merged(k.errors, k.warnings))
    }
    warn(path, k.warnings)
    let libraries = link_flags(path)
    capabilities.admit(k, options, libraries, true)
    let ids = codegen.test_ids(k)
    let mut chosen: [Int] = []
    for i in 0..len(ids) {
        let name = k.fns[ids[i]].decl.name
        let mut wanted = len(words) == 0
        for w in words {
            if contains(name, w) {
                wanted = true
            }
        }
        if wanted {
            push(mut chosen, i)
        }
    }
    if len(chosen) == 0 {
        if options.coverage != "" { match agent_queries.report(k, []) { Ok(data) => { match files.write(options.coverage, json.pretty(data)) { Ok(_) => {}, Err(e) => driver_error(e) } }, Err(e) => driver_error(e) } }
        print("no tests to run")
        return
    }
    let mut tmp = ""
    match files.temp_dir() {
        Ok(dir) => tmp = dir
        Err(e) => driver_error(e)
    }
    let exe = modules.join(tmp, "tests")
    // Tests are built often and run briefly, so the C compiler does not
    // optimize: building the compiler's own tests takes 3 s instead of 20.
    if native(true) {
        let mut made = native_program(path, k, true)
        if options.coverage != "" { made = coverage_program(k) }
        assemble(targets.program(lowered(path, made), ""), modules.stem(path) + "_tests", exe, root, "-O0", libraries, "")
    } else {
        let mut made = codegen.generate_tests(k)
        if options.coverage != "" { made = codegen.generate_coverage_tests(k) }
        compile(c_code(path, made), modules.stem(path) + "_tests", exe, root, "-O0", libraries, "")
    }
    let mut results: [json.Json] = []
    let mut failed = 0
    for i in chosen {
        let f = k.fns[ids[i]]
        let label = k.modules[f.module].path + ": " + f.decl.name
        let events = modules.join(tmp, "hits")
        let mut command = [exe, strings.from_int(i)]
        let mut allows = options.allow
        if options.coverage != "" { files.write(events, ""); push(mut command, events); push(mut allows, "coverage:" + events) }
        match sysio.sandbox_run(command, allows, options.deny) {
            Ok(code) => {
                if options.coverage != "" { let mut hits = ""; match files.read(events) { Ok(s) => hits = s, Err(_) => {} }; push(mut results, agent_queries.hit_record(k, ids[i], code, hits)) }
                if code == 0 {
                    print("PASS  " + label)
                } else if code == 101 {
                    print("FAIL  " + label)
                    failed = failed + 1
                } else {
                    print("FAIL  " + label + " (exit code " + strings.from_int(code) + ")")
                    failed = failed + 1
                }
            }
            Err(e) => { files.remove(events); files.remove(exe); files.remove(tmp); capabilities.fail(e) }
        }
    }
    files.remove(modules.join(tmp, "hits"))
    if options.coverage != "" { match agent_queries.report(k, results) { Ok(data) => { match files.write(options.coverage, json.pretty(data)) { Ok(_) => {}, Err(e) => driver_error(e) } }, Err(e) => driver_error(e) } }
    files.remove(exe)
    files.remove(tmp)
    let n = len(chosen)
    let mut summary = strings.from_int(n) + " tests"
    if n == 1 {
        summary = "1 test"
    }
    print(summary + ": " + strings.from_int(n - failed) + " passed, " + strings.from_int(failed) + " failed")
    if failed > 0 {
        os.exit(1)
    }
}

fn contains(s: Str, word: Str) -> Bool {
    for i in 0..len(s) - len(word) + 1 {
        if s[i..i + len(word)] == word {
            return true
        }
    }
    return false
}

test "the C is cut at the marks, into units of whole parts" {
    let m = codegen.part_mark()
    // Small: one unit, whatever the threads.
    let small = "head\n" + m + "\nf\n" + m + "\ng\n"
    let one = c_parts(small, 4, 1000)
    assert(len(one) == 1 && one[0] == small)
    assert(len(c_parts("no marks at all", 4, 1)) == 1)
    // Large: as many units as threads, each the head and whole parts.
    let mut b = strings.builder()
    strings.add(mut b, "HEAD\n")
    for i in 0..40 {
        strings.add(mut b, m + "\n")
        for _ in 0..10 {
            strings.add(mut b, "int x" + strings.from_int(i) + ";\n")
        }
    }
    let c = strings.build(b)
    let units = c_parts(c, 4, 100)
    assert(len(units) == 4)
    let mut total = 0
    for u in units {
        assert(u[0..5] == "HEAD\n" && u[5..5 + len(m)] == m)
        total = total + len(u) - 5
    }
    assert(total == len(c) - 5)
    assert(len(c_parts(c, 1, 100)) == 1)
    // Never more units than parts.
    assert(len(c_parts(small, 8, 1)) == 2)
}

fn edits_json(edits: [errors.Edit]) -> Str {
    let mut b = strings.builder()
    strings.add(mut b, "[")
    for i in 0..len(edits) {
        if i > 0 {
            strings.add(mut b, ", ")
        }
        let e = edits[i]
        strings.add(mut b, "{\"file\": " + json_string(e.file) + ", \"start\": " + strings.from_int(e.start) +
            ", \"end\": " + strings.from_int(e.end) + ", \"text\": " + json_string(e.text) + ", \"expected\": " + json_string(e.expected) + "}")
    }
    strings.add(mut b, "]")
    return strings.build(b)
}

fn link_flags(path: Str) -> [Str] uses fs, os {
    match packages.link_flags(path) { Ok(flags) => return flags, Err(e) => driver_error(e) }
    return []
}

fn coverage_program(k: checker.Checked) -> Result[ir.Program, [errors.CompileError]] uses os {
    match lower.lower_coverage(k) { Ok(p) => { match os.env("VELA_OPT") { Some("0") => return Ok(p), _ => {} }; return Ok(opt.optimize(p)) }, Err(e) => return Err(e) }
}
