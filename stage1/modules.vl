// Programs made of several files: a port of stage0/modules.py, which
// explains the rules. Modules are kept in one array and refer to each
// other by index.
import ast
import errors
import files
import lexer
import maps
import parser
import strings
import types

pub type Module = struct {
    // Its name in the program: what the program's own files import it as,
    // or "" for the main module. A package's main module is the package's
    // name; its other modules are "greet.util", which no file can be
    // called, so no two packages' modules can have the same name.
    name: Str
    package: Str  // whose file it is: "" for the program's own, a package's name, or "std"
    path: Str  // the file, as messages show it; "" for a built-in module
    file: Str  // the file, as it was read: "/vela/std/text.vl" where path says "std/text.vl"
    source: Str  // its text
    program: ast.Program
    has_program: Bool  // false for a built-in module, or a file that did not lex
    imports: Map[Str, Int]  // module indexes, by the name imported as
    std: [Str]  // the functions of a built-in module
    is_std: Bool
    // Filled in by the checker: the module's own declarations by name.
    types: Map[Str, Int]  // type ids
    fns: Map[Str, Int]  // function ids
}

// A package the program uses (M14): where its files are, and the packages
// it uses itself. The packages module makes these from vela.mod and
// vela.lock files; loading needs nothing else, and never the network.
pub type Package = struct {
    name: Str
    dir: Str  // holding NAME.vl, its main module, and its other modules
    deps: [Str]  // the packages its modules may import
}

pub type Packages = struct {
    deps: [Str]  // the packages the program's own modules may import
    all: Map[Str, Package]  // every package of the program, by name
}

pub fn no_packages() -> Packages {
    return Packages { deps: [], all: [:] }
}

pub type Loaded = struct {
    modules: [Module]  // every module, built-in ones included
    order: [Int]  // the program's files, dependencies first, the main one last
    errors: [errors.CompileError]  // sorted
    warnings: [errors.CompileError]  // sorted
    node_count: Int  // syntax tree ids handed out, across all files
}

type Loader = struct {
    directory: Str
    std_dir: Str
    open: Map[Str, Str]  // texts to use instead of the files, by normpath
    packages: Packages
    by_name: Map[Str, Str]  // the file of each module, by its name in the program
    modules: [Module]
    errors: [errors.CompileError]
    warnings: [errors.CompileError]
    by_path: Map[Str, Int]
    order: [Int]
    active: [Int]  // the chain of imports being followed
    next_id: Int
}

// The built-in modules and their functions, in Stage 0's order.
fn builtin_functions(name: Str) -> [Str] {
    return match name {
        "maps" => ["has", "get", "remove", "keys"]
        "files" => ["read", "write", "remove", "temp_dir"]
        "os" => ["args", "exit", "eprint", "run", "env", "read_line", "read", "write", "output"]
        "strings" => ["builder", "add", "add_byte", "add_int", "build", "from_int", "from_float", "parse_float"]
        "tasks" => ["map", "each", "workers"]
        "math" => ["sqrt"]
        _ => []
    }
}

pub fn is_builtin_module(name: Str) -> Bool {
    return len(builtin_functions(name)) > 0
}

fn empty_program() -> ast.Program {
    return ast.Program { imports: [], types: [], fns: [], tests: [] }
}

fn new_module(name: Str, path: Str) -> Module {
    return Module {
        name: name, package: "", path: path, file: path, source: "", program: empty_program(), has_program: false, imports: [:], std: [],
        is_std: false, types: [:], fns: [:],
    }
}

// The name to use in messages: the main module has none, so it goes by its
// file name.
pub fn label(m: Module) -> Str {
    if m.name != "" {
        return m.name
    }
    return stem(m.path)
}

// Load the program whose main file is `path`, with contents `source`.
// `std_dir` is where the standard modules written in Vela are.
pub fn load(path: Str, source: Str, std_dir: Str) -> Loaded uses fs {
    return load_open(path, source, std_dir, [:])
}

// The same, with `open` (texts by path) read instead of those files: an
// editor's buffers, changed but not saved.
pub fn load_open(path: Str, source: Str, std_dir: Str, open: Map[Str, Str]) -> Loaded uses fs {
    return load_program(path, source, std_dir, open, no_packages())
}

// The same, for a program that uses `packages`.
pub fn load_program(path: Str, source: Str, std_dir: Str, open: Map[Str, Str], packages: Packages) -> Loaded uses fs {
    let mut texts: Map[Str, Str] = [:]
    for p in maps.keys(open) {
        texts[normpath(p)] = open[p]
    }
    let mut ld = Loader {
        directory: dirname(path), std_dir: std_dir, open: texts, packages: packages, by_name: [:], modules: [], errors: [],
        warnings: [], by_path: [:], order: [], active: [], next_id: 0,
    }
    file(mut ld, "", "", path, source, path)
    return Loaded {
        modules: ld.modules, order: ld.order, errors: errors.sorted(ld.errors), warnings: errors.sorted(ld.warnings),
        node_count: ld.next_id,
    }
}

// Lex and parse one file, then load what it imports. Returns its index.
fn file(ld: mut Loader, name: Str, package: Str, path: Str, source: Str, shown: Str) -> Int uses fs {
    let mut m = new_module(name, shown)
    m.package = package
    m.file = path
    m.source = source
    push(mut ld.modules, m)
    let index = len(ld.modules) - 1
    ld.by_path[normpath(path)] = index
    if name != "" {
        ld.by_name[name] = normpath(path)
    }
    // The lexer and parser are each a phase: a file with lexical errors is
    // not parsed, and its imports are not followed.
    let lexed = lexer.tokenize(source)
    if len(lexed.errors) > 0 {
        add_errors(mut ld, lexed.errors, shown)
    } else {
        let parsed = parser.parse(lexed.tokens, ld.next_id)
        ld.next_id = parsed.next_id
        add_errors(mut ld, parsed.errors, shown)
        // The parser recovers, so a file with syntax errors still has imports.
        ld.modules[index].program = parsed.program
        ld.modules[index].has_program = true
        push(mut ld.active, index)
        for imp in parsed.program.imports {
            follow(mut ld, index, imp)
        }
        ld.active = ld.active[0..len(ld.active) - 1]
    }
    push(mut ld.order, index)
    return index
}

fn add_errors(ld: mut Loader, errs: [errors.CompileError], path: Str) {
    for e in errs {
        let mut with_path = e
        with_path.path = path
        errors.add(mut ld.errors, with_path)
    }
}

fn report(ld: mut Loader, importer: Int, imp: ast.Import, message: Str) {
    let e = errors.CompileError {
        path: ld.modules[importer].path, line: imp.line, col: imp.col, message: message, warning: false,
    }
    errors.add(mut ld.errors, e)
}

fn builtin_module(ld: mut Loader, name: Str) -> Int {
    for i in 0..len(ld.modules) {
        if ld.modules[i].is_std && ld.modules[i].name == name {
            return i
        }
    }
    let mut m = new_module(name, "")
    m.is_std = true
    m.std = builtin_functions(name)
    if name == "strings" {
        m.types["Builder"] = types.BUILDER()
    }
    push(mut ld.modules, m)
    return len(ld.modules) - 1
}

fn follow(ld: mut Loader, importer: Int, imp: ast.Import) uses fs {
    if maps.has(ld.modules[importer].imports, imp.name) {
        report(mut ld, importer, imp, "'" + imp.name + "' is already imported")
        return
    }
    if is_builtin_module(imp.name) {
        let std = builtin_module(mut ld, imp.name)
        ld.modules[importer].imports[imp.name] = std
        return
    }
    // Where the importer's own files are, and the packages it may use.
    let owner = ld.modules[importer].package
    let mut dir = ld.directory
    let mut deps = ld.packages.deps
    if owner == "std" {
        dir = ld.std_dir
        deps = []
    } else if owner != "" {
        let p = ld.packages.all[owner]
        dir = p.dir
        deps = p.deps
    }
    // First a file of the importer's own (the program's, a package's or
    // std's), then a package it uses, then the standard module: a module
    // added to std/ never takes the place of one a program already has
    // (M10c; until then std/ came first).
    let mut path = join(dir, imp.name + ".vl")
    let mut shown = path
    if owner == "std" {
        shown = "std/" + imp.name + ".vl"
    }
    let mut name = imp.name
    if owner != "" && owner != "std" && imp.name != owner {
        name = owner + "." + imp.name  // a package's own module
    }
    let mut package = owner
    let mut source = ""
    let mut have_source = false
    match read(ld, path) {
        Ok(text) => {
            source = text
            have_source = true
            hides(mut ld, importer, imp, path, deps)
        }
        Err(_) => {
            if has_word(deps, imp.name) {
                let p = ld.packages.all[imp.name]
                path = join(p.dir, imp.name + ".vl")
                shown = path
                name = imp.name
                package = imp.name
                match read(ld, path) {
                    Ok(text) => {
                        source = text
                        have_source = true
                    }
                    Err(_) => {
                        report(mut ld, importer, imp, "package '" + imp.name + "' has no main module: there is no file " +
                            path)
                        return
                    }
                }
            } else {
                match read(ld, join(ld.std_dir, imp.name + ".vl")) {
                    Ok(text) => {
                        path = join(ld.std_dir, imp.name + ".vl")
                        shown = "std/" + imp.name + ".vl"
                        name = imp.name
                        package = "std"
                        source = text
                        have_source = true
                    }
                    Err(_) => {}
                }
            }
        }
    }
    // Two files with one name in the program would be one module to the
    // checker, and one set of C names.
    match maps.get(ld.by_name, name) {
        Some(other) => {
            if other != normpath(path) {
                report(mut ld, importer, imp, "two different files would both be the module '" + name + "': " + other +
                    " and " + normpath(path) + "; rename one of them")
                return
            }
        }
        None => {}
    }
    let mut known = -1
    match maps.get(ld.by_path, normpath(path)) {
        Some(k) => known = k
        None => {}
    }
    for i in 0..len(ld.active) {
        if ld.active[i] == known {
            let chain = ld.active[i..len(ld.active)]
            if len(chain) == 1 {
                report(mut ld, importer, imp, "module '" + imp.name + "' imports itself")
            } else {
                let mut names = strings.builder()
                for m in chain {
                    strings.add(mut names, label(ld.modules[m]))
                    strings.add(mut names, " -> ")
                }
                strings.add(mut names, label(ld.modules[known]))
                report(mut ld, importer, imp, "import cycle: " + strings.build(names) +
                    "; modules cannot import each other, directly or through others")
            }
            return
        }
    }
    if known < 0 {
        if !have_source {
            match read(ld, path) {
                Ok(text) => source = text
                Err(_) => {
                    report(mut ld, importer, imp, "cannot find module '" + imp.name + "': there is no file " + path +
                        moved_to_package(imp.name))
                    return
                }
            }
        }
        known = file(mut ld, name, package, path, source, shown)
    }
    ld.modules[importer].imports[imp.name] = known
}

// What to do about a module that was standard and is a package now.
fn moved_to_package(name: Str) -> Str {
    if name == "json" {
        return "; json is a package since M12b: run `vela get json https://github.com/nathgoutam93/vela//packages/json " +
            "packages/json/v1.0.0`"
    }
    return ""
}

fn read(ld: Loader, path: Str) -> Result[Str, Str] uses fs {
    match maps.get(ld.open, normpath(path)) {
        Some(text) => return Ok(text)
        None => return files.read(path)
    }
}

// The importer's own `name.vl` is used where a package it uses, or a
// standard module, has the same name: allowed, so that adding to std/ or
// to vela.mod breaks no program, but said, since the file then hides the
// other. Said once, at the first import of it.
fn hides(ld: mut Loader, importer: Int, imp: ast.Import, path: Str, deps: [Str]) uses fs {
    if maps.has(ld.by_path, normpath(path)) {
        return  // already loaded, and already said
    }
    let owner = ld.modules[importer].package
    let mut whose = "this program's"
    if owner != "" && owner != "std" {
        whose = "package " + owner + "'s"
    }
    if has_word(deps, imp.name) {
        let w = errors.CompileError {
            path: ld.modules[importer].path, line: imp.line, col: imp.col, warning: true,
            message: "'" + imp.name + "' is " + whose + " " + imp.name + ".vl, which hides the package " + imp.name +
                " from vela.mod; rename the file to use the package",
        }
        errors.add(mut ld.warnings, w)
        return
    }
    let std_path = join(ld.std_dir, imp.name + ".vl")
    if normpath(std_path) == normpath(path) {
        return  // the program is in std/ itself
    }
    match read(ld, std_path) {
        Ok(_) => {
            let w = errors.CompileError {
                path: ld.modules[importer].path, line: imp.line, col: imp.col, warning: true,
                message: "'" + imp.name + "' is " + whose + " " + imp.name + ".vl, which hides the standard module " +
                    "std/" + imp.name + ".vl; rename the file to use the standard one",
            }
            errors.add(mut ld.warnings, w)
        }
        Err(_) => {}
    }
}

fn has_word(words: [Str], w: Str) -> Bool {
    for x in words {
        if x == w {
            return true
        }
    }
    return false
}

// ---- Paths, as Python's os.path does them for the cases that occur ----

fn last_slash(path: Str) -> Int {
    let mut i = len(path) - 1
    for i >= 0 && path[i] != '/' {
        i = i - 1
    }
    return i
}

pub fn dirname(path: Str) -> Str {
    let i = last_slash(path)
    if i < 0 {
        return ""
    }
    let mut end = i + 1
    // Trailing slashes go, unless the directory is the root.
    for end > 1 && path[end - 1] == '/' {
        end = end - 1
    }
    return path[0..end]
}

pub fn join(dir: Str, name: Str) -> Str {
    if len(name) > 0 && name[0] == '/' || dir == "" {
        return name
    }
    if dir[len(dir) - 1] == '/' {
        return dir + name
    }
    return dir + "/" + name
}

// The file name without its last extension: "main" for "src/main.vl".
pub fn stem(path: Str) -> Str {
    let name = path[last_slash(path) + 1..len(path)]
    let mut dot = len(name) - 1
    for dot > 0 && name[dot] != '.' {
        dot = dot - 1
    }
    if dot <= 0 {
        return name
    }
    return name[0..dot]
}

// The same path with `.` parts and `x/..` pairs gone, so two spellings of
// one file give one key.
pub fn normpath(path: Str) -> Str {
    let absolute = len(path) > 0 && path[0] == '/'
    let mut parts: [Str] = []
    let mut start = 0
    for i in 0..len(path) + 1 {
        if i == len(path) || path[i] == '/' {
            let part = path[start..i]
            start = i + 1
            if part == "" || part == "." {
                continue
            }
            if part == ".." && len(parts) > 0 && parts[len(parts) - 1] != ".." {
                parts = parts[0..len(parts) - 1]
            } else if part == ".." && absolute {
                continue
            } else {
                push(mut parts, part)
            }
        }
    }
    let mut b = strings.builder()
    if absolute {
        strings.add_byte(mut b, '/')
    }
    for i in 0..len(parts) {
        if i > 0 {
            strings.add_byte(mut b, '/')
        }
        strings.add(mut b, parts[i])
    }
    let out = strings.build(b)
    if out == "" {
        return "."
    }
    return out
}

test "paths" {
    assert(dirname("a/b/c.vl") == "a/b")
    assert(dirname("c.vl") == "")
    assert(dirname("/c.vl") == "/")
    assert(join("a", "b.vl") == "a/b.vl" && join("", "b.vl") == "b.vl" && join("a", "/x") == "/x")
    assert(stem("src/main.vl") == "main" && stem(".vl") == ".vl")
    assert(normpath("a/./b/../c") == "a/c" && normpath("../x") == "../x" && normpath("a/..") == ".")
}
