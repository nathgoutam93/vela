// The C code generator. The scheme: one C statement per operation, owned
// and borrowed values, cleanup frames, copy-on-write, and since M18 the
// checks that ranges.vl proves cannot fail left out.
import cffi
import ast
import checker
import errors
import integers
import layout
import maps
import mono
import ranges
import strings
import types

type Item = struct {
    c: Str
    ty: Int
}

// Values to release when a part of the program ends. kind is "function",
// "block", "body" (of a loop), "arm", "stmt" or "branch".
type Frame = struct {
    kind: Str
    items: [Item]
}

// The C expression for a value, and whether it holds a reference.
// A map lookup a write of the same key may use (M18): the map's and the
// key's locals, the block it was made in, and the C temporaries holding
// the value's slot (or NULL), the key's hash and the map looked in.
type Found = struct {
    map: Int
    key: Int
    depth: Int
    slot: Str
    hash: Str
    looked_in: Str
}

type Value = struct {
    c: Str
    ty: Int
    owned: Bool
    is_static: Bool  // a Str literal: never counted, so free to copy
}

type Gen = struct {
    k: checker.Checked
    l: layout.Layout
    filename: Str
    lines: [Str]
    depth: Int  // indentation level
    temps: Int
    names: Map[Int, Str]  // C names of locals, by local id
    used: Map[Str, Bool]
    frames: [Frame]
    dead: Bool  // true right after a return, break or continue
    current_fn: Int
    coverage: Bool
    // In a copy of a generic function, its type parameters and what they
    // are in this copy; empty otherwise.
    params: [Int]
    args: [Int]
    instance_names: Map[Str, Str]  // C names of generic copies, by mono.key
    cname: Str  // the C function being written
    // In a closure's body: the C expressions of the variables it captured,
    // by local id, and its result type; empty and -2 elsewhere.
    captures: Map[Int, Str]
    closure_result: Int
    closures: Int  // closures written so far in this C function, for names
    extra: [Str]  // C written before this function: its closures' environments and bodies
    wrappers: Map[Str, Str]  // functions used as values: wrapper definitions by name
    // Variables holding an array or map already made unique for a write
    // since the last block boundary, copy or call (M18): further writes to
    // them need no check. Forgotten when anything could share them.
    unique: [Str]
    // Map lookups since which nothing could have changed the map (M18).
    found: [Found]
    // Variables made unique before the loops being written, which nothing
    // in them can share (M18): their writes need no check.
    hoisted: [Str]
    // Arrays whose length and elements' address a loop cannot change,
    // loaded into C locals before it (M18): the place's C, to the local
    // holding its data; the length is in the same name plus "n".
    cached: Map[Str, Str]
    // What is known of Int values' ranges (M18, ranges.vl): an operation
    // that cannot overflow is plain C.
    env: ranges.Env
}

fn new_gen(k: checker.Checked, l: layout.Layout, id: Int, params: [Int], args: [Int],
    instance_names: Map[Str, Str], cname: Str, env: ranges.Env) -> Gen {
    return Gen {
        k: k, l: l, filename: k.modules[k.fns[id].module].path, lines: [], depth: 1, temps: 0, names: [:],
        used: [:], frames: [], dead: false, current_fn: id, coverage: false, params: params, args: args,
        instance_names: instance_names, cname: cname, captures: [:], closure_result: -2, closures: 0, extra: [],
        wrappers: [:], unique: [], found: [], hoisted: [], cached: [:], env: env,
    }
}

// What a match does with an arm's body: run it, or store its value in a
// temporary.
type ArmCode = enum {
    Statements
    StoreIn(Str)
}

pub fn generate(checked: checker.Checked) -> Result[Str, [errors.CompileError]] {
    return program(checked, false, false)
}

// The C for `vela test`: the program's tests, and a main that runs the one
// whose number it is given (its index in test_ids).
pub fn generate_tests(checked: checker.Checked) -> Result[Str, [errors.CompileError]] {
    return program(checked, true, false)
}

// The tests `vela test` runs: those of the main module, and of every module
// it imports but the standard ones.
pub fn test_ids(k: checker.Checked) -> [Int] {
    let mut out: [Int] = []
    for id in 0..len(k.fns) {
        let m = k.modules[k.fns[id].module]
        let standard = m.name != "" && len(m.path) > 4 && m.path[0..4] == "std/"
        if k.fns[id].is_test && !standard {
            push(mut out, id)
        }
    }
    return out
}

// The C, or the errors only making the generic copies finds.
pub fn generate_coverage_tests(checked: checker.Checked) -> Result[Str, [errors.CompileError]] { return program(checked, true, true) }

fn program(checked: checker.Checked, for_tests: Bool, coverage: Bool) -> Result[Str, [errors.CompileError]] {
    let mut k = checker.erased(checked)
    // The functions that are not generic are all written; generic ones only
    // as the copies they are called as. Tests only for `vela test`.
    let mut roots: [Int] = []
    for id in 0..len(k.fns) {
        if len(k.fns[id].type_params) == 0 && !k.fns[id].is_test && k.fns[id].decl.foreign == "" {
            push(mut roots, id)
        }
    }
    let tests = test_ids(k)
    if for_tests {
        for id in tests {
            push(mut roots, id)
        }
    }
    let copies = mono.collect(mut k, roots)
    if len(copies.errors) > 0 {
        return Err(copies.errors)
    }
    let mut elements: [Int] = []
    for t in k.table.arrays {
        if !types.is_open(k.table, t) {
            add_new(mut elements, t)
        }
    }
    for t in k.table.maps {
        if !types.is_open(k.table, t) {
            add_new(mut elements, t)
        }
    }
    let mut user_types: [Int] = []
    for t in k.decls {
        if !types.is_generic(k.table, t) && !types.is_interface(k.table, t) {
            push(mut user_types, t)
        }
    }
    let mut l = layout.new_layout(k.table, user_types, elements)
    let param_ranges = ranges.analyze(k)
    let mut out = ["// Generated by the Vela compiler. Do not edit.", "#include \"vela_rt.h\"", ""]
    // Each copy of a generic function is named for its type arguments:
    // f_first__Int.
    let mut instance_names: Map[Str, Str] = [:]
    let mut taken: Map[Str, Bool] = [:]
    let mut copy_names: [Str] = []
    for c in copies.instances {
        let mut name = fn_name(k, c.fn_id) + "_"
        for a in c.args {
            name = name + "_" + layout.suffix(l, a)
        }
        let base = name
        let mut n = 2
        for maps.has(taken, name) {
            name = base + "_" + strings.from_int(n)
            n = n + 1
        }
        taken[name] = true
        instance_names[mono.key(c.fn_id, c.args)] = name
        push(mut copy_names, name)
    }
    for t in elements {
        let hash = checker.method(k, t, "hash")
        let eq = checker.method(k, t, "eq")
        if types.used_as_key(k.table, t) && hash.fn_id >= 0 && eq.fn_id >= 0 {
            let hn = dispatch_name(k, instance_names, hash)
            let en = dispatch_name(k, instance_names, eq)
            let no_names: [Str] = []
            l.key_methods[t] = [hn, en,
                prototype(k, l, hash.fn_id, no_names, k.fns[hash.fn_id].type_params, hash.args, hn),
                prototype(k, l, eq.fn_id, no_names, k.fns[eq.fn_id].type_params, eq.args, en)]
        }
    }
    let defs = layout.definitions(mut l)
    if len(defs) > 0 {
        for line in defs {
            push(mut out, line)
        }
        push(mut out, "")
    }
    for id in 0..len(k.fns) {
        if k.fns[id].decl.foreign != "" { push(mut out, foreign_prototype(k, l, id) + ";") }
    }
    // Declare every function first, so each can call any other, in any order.
    let none: [Str] = []
    let no_types: [Int] = []
    for id in roots {
        push(mut out, prototype(k, l, id, none, no_types, no_types, fn_name(k, id)) + ";")
    }
    for i in 0..len(copies.instances) {
        let c = copies.instances[i]
        push(mut out, prototype(k, l, c.fn_id, none, k.fns[c.fn_id].type_params, c.args, copy_names[i]) + ";")
    }
    let mut bodies: [Str] = []
    let mut flow_envs: Map[Int, ranges.Env] = [:]
    let mut wrappers: Map[Str, Str] = [:]
    for i in 0..len(roots) + len(copies.instances) {
        let mut id = 0
        let mut params: [Int] = []
        let mut args: [Int] = []
        let mut name = ""
        if i < len(roots) {
            id = roots[i]
            name = fn_name(k, id)
        } else {
            let c = copies.instances[i - len(roots)]
            id = c.fn_id
            params = k.fns[id].type_params
            args = c.args
            name = copy_names[i - len(roots)]
        }
        if !maps.has(flow_envs, id) {
            flow_envs[id] = ranges.function_env(k, param_ranges, id)
        }
        let mut g = new_gen(k, l, id, params, args, instance_names, name, flow_envs[id])
        g.coverage = coverage
        let lines = function(mut g, id, name)
        // Where the driver may cut the C into parts compiled in parallel:
        // before each function, with the closures written for it.
        push(mut bodies, part_mark())
        for line in g.extra {
            push(mut bodies, line)
        }
        push(mut bodies, "")
        for line in lines {
            push(mut bodies, line)
        }
        for w in maps.keys(g.wrappers) {
            wrappers[w] = g.wrappers[w]
        }
        l = g.l  // the layout remembers which types are managed
    }
    // Functions used as values, wrapped to take an environment they ignore,
    // like a closure's: after the prototypes they call, before the bodies
    // that use them.
    for w in maps.keys(wrappers) {
        push(mut out, "")
        push(mut out, wrappers[w])
    }
    for line in bodies {
        push(mut out, line)
    }
    if for_tests {
        for line in ["", "int main(int argc, char **argv) {", "    vela_init(argc, argv);",
            "    long which = argc > 1 ? strtol(argv[1], NULL, 10) : -1;", "    switch (which) {"] {
            push(mut out, line)
        }
        if coverage {
            // Must precede the switch: instrumentation writes first-hit events.
            out = out[0..len(out) - 1]
            push(mut out, "    vela_coverage_begin(argc, argv, " + strings.from_int(len(k.fns)) + ");")
            push(mut out, "    switch (which) {")
        }
        for i in 0..len(tests) {
            push(mut out, "    case " + strings.from_int(i) + ": " + fn_name(k, tests[i]) + "(); return 0;")
        }
        for line in ["    default: return 2;", "    }", "}", ""] {
            push(mut out, line)
        }
    } else {
        for line in ["", "int main(int argc, char **argv) {", "    vela_init(argc, argv);", "    f_main();",
            "    return 0;", "}", ""] {
            push(mut out, line)
        }
    }
    let mut b = strings.builder()
    for i in 0..len(out) {
        if i > 0 {
            strings.add_byte(mut b, '\n')
        }
        strings.add(mut b, out[i])
    }
    return Ok(strings.build(b))
}

fn add_new(xs: mut [Int], x: Int) {
    for y in xs {
        if y == x {
            return
        }
    }
    push(mut xs, x)
}

fn fn_name(k: checker.Checked, id: Int) -> Str {
    let f = k.fns[id]
    if f.is_test {
        return "vela_test_" + strings.from_int(id)
    }
    return "f_" + layout.mangle(k.modules[f.module].name, f.decl.name)
}

// `int64_t f_fib(int64_t v_n)`, or with no names, `int64_t f_fib(int64_t)`.
// For a copy of a generic function, its types with `args` put in.
fn prototype(k: checker.Checked, l: layout.Layout, id: Int, names: [Str], tp: [Int], args: [Int], name: Str) -> Str {
    let f = k.fns[id]
    let mut params = strings.builder()
    for i in 0..len(f.params) {
        if i > 0 {
            strings.add(mut params, ", ")
        }
        strings.add(mut params, layout.c_type(l, types.find_subst(k.table, f.params[i], tp, args)))
        if f.mutable[i] {
            strings.add(mut params, " *")
        }
        if len(names) > 0 {
            strings.add(mut params, " " + names[i])
        }
    }
    let mut list = strings.build(params)
    if list == "" {
        list = "void"
    }
    return layout.c_type(l, types.find_subst(k.table, f.result, tp, args)) + " " + name + "(" + list + ")"
}

// A C string literal for any bytes: a file name or a Vela string.
pub fn c_string(data: Str) -> Str {
    let mut b = strings.builder()
    strings.add_byte(mut b, '"')
    for c in data {
        if c == '"' || c == '\\' || c == '?' {
            // `?` too: with -std=c11, `??/` and friends are trigraphs.
            strings.add_byte(mut b, '\\')
            strings.add_byte(mut b, c)
        } else if c >= 32 && c < 127 {
            strings.add_byte(mut b, c)
        } else {
            let n = int(c)
            strings.add_byte(mut b, '\\')  // octal escapes stop after 3 digits
            strings.add_byte(mut b, byte(48 + n / 64))
            strings.add_byte(mut b, byte(48 + n / 8 % 8))
            strings.add_byte(mut b, byte(48 + n % 8))
        }
    }
    strings.add_byte(mut b, '"')
    return strings.build(b)
}

// ---- Output ----

fn emit(g: mut Gen, line: Str) {
    if line == "" {
        return  // a retain or release of a value that needs none
    }
    let mut b = strings.builder()
    for _ in 0..g.depth {
        strings.add(mut b, "    ")
    }
    strings.add(mut b, line)
    push(mut g.lines, strings.build(b))
}

// Emit a line ending in `{` and indent.
fn open(g: mut Gen, line: Str) {
    emit(mut g, line)
    g.depth = g.depth + 1
    g.unique = []  // a block may be entered from elsewhere: a loop's next turn
    if len(line) >= 4 && line[0..4] == "for " {
        g.found = []  // the map may have changed on the turn before
    }
}

// Dedent and emit a line starting with `}`.
fn close(g: mut Gen, line: Str) {
    g.depth = g.depth - 1
    emit(mut g, line)
    g.dead = false
    g.unique = []
    forget_deeper(mut g)
}

// A lookup's temporaries go out of scope with its block.
fn forget_deeper(g: mut Gen) {
    let mut kept: [Found] = []
    for f in g.found {
        if f.depth <= g.depth {
            push(mut kept, f)
        }
    }
    g.found = kept
}

fn new_temp(g: mut Gen) -> Str {
    g.temps = g.temps + 1
    return "_t" + strings.from_int(g.temps)
}

fn c_type(g: Gen, t: Int) -> Str {
    return layout.c_type(g.l, t)
}

fn managed(g: mut Gen, t: Int) -> Bool {
    return layout.managed(mut g.l, t)
}

fn retain(g: mut Gen, t: Int, c: Str) -> Str {
    let code = layout.retain(mut g.l, t, c)
    if code != "" {
        g.unique = []  // a second reference to something: it may be a unique array
    }
    return code
}

fn release(g: mut Gen, t: Int, c: Str) -> Str {
    return layout.release(mut g.l, t, c)
}

fn share(g: mut Gen, t: Int, c: Str) -> Str {
    return layout.share(mut g.l, t, c)
}

fn loc(g: Gen, line: Int, col: Int) -> Str {
    return c_string(g.filename + ":" + strings.from_int(line) + ":" + strings.from_int(col))
}

fn loc_of(g: Gen, e: ast.Expr) -> Str {
    return loc(g, e.line, e.col)
}

fn ty(g: Gen, e: ast.Expr) -> Int {
    return sub(g, g.k.ty[e.id])
}

// A type as it is in this copy of the function.
fn sub(g: Gen, t: Int) -> Int {
    return types.find_subst(g.k.table, t, g.params, g.args)
}

fn local_ty(g: Gen, id: Int) -> Int {
    return sub(g, g.k.locals[id].ty)
}

// The C name of a local: `v_x`, or `v_x_2` for a second `x`, and `(*v_x)`
// for a mut parameter, which is a pointer to the caller's value.
fn local(g: mut Gen, id: Int) -> Str {
    match maps.get(g.captures, id) {
        Some(c) => return c  // a closure's copy, in its environment
        None => {}
    }
    let name = c_name(mut g, id)
    if g.k.locals[id].kind == "mut parameter" {
        return "(*" + name + ")"
    }
    return name
}

fn c_name(g: mut Gen, id: Int) -> Str {
    match maps.get(g.names, id) {
        Some(n) => return n
        None => {}
    }
    let base = "v_" + g.k.locals[id].name
    let mut name = base
    let mut n = 2
    for maps.has(g.used, name) {
        name = base + "_" + strings.from_int(n)
        n = n + 1
    }
    g.used[name] = true
    g.names[id] = name
    return name
}

fn local_of(g: Gen, id: Int) -> Int {
    return match g.k.refs[id] {
        checker.Ref.Local(l) => l
        _ => -1
    }
}

// ---- Ownership ----

fn push_frame(g: mut Gen, kind: Str) {
    push(mut g.frames, Frame { kind: kind, items: [] })
}

fn pop_frame(g: mut Gen) {
    let frame = g.frames[len(g.frames) - 1]
    g.frames = g.frames[0..len(g.frames) - 1]
    if !g.dead {
        release_frame(mut g, frame)
    }
}

fn release_frame(g: mut Gen, frame: Frame) {
    let mut i = len(frame.items) - 1
    for i >= 0 {
        let item = frame.items[i]
        if item.ty == restore_item() {
            emit(mut g, item.c)
        } else {
            emit(mut g, release(mut g, item.ty, item.c))
        }
        i = i - 1
    }
}

fn value(c: Str, t: Int) -> Value {
    return Value { c: c, ty: t, owned: false, is_static: false }
}

fn no_value() -> Value {
    return value("", types.NOTHING())
}

// Record a new owned temporary in the innermost frame.
fn own(g: mut Gen, c: Str, t: Int) -> Value {
    if managed(mut g, t) {
        push(mut g.frames[len(g.frames) - 1].items, Item { c: c, ty: t })
    }
    return Value { c: c, ty: t, owned: true, is_static: false }
}

// Put an expression's value in a fresh temporary, owned.
fn store(g: mut Gen, t: Int, c_expr: Str) -> Value {
    let temp = new_temp(mut g)
    emit(mut g, c_type(g, t) + " " + temp + " = " + c_expr + ";")
    return own(mut g, temp, t)
}

// A temporary for a value with no references (Int, Bool, Byte...).
fn scalar(g: mut Gen, t: Int, c_expr: Str) -> Str {
    let temp = new_temp(mut g)
    emit(mut g, c_type(g, t) + " " + temp + " = " + c_expr + ";")
    return temp
}

// The address of a copy of `value`, for runtime functions that take an
// element by pointer.
fn addr(g: mut Gen, c_ty: Str, v: Str) -> Str {
    let temp = new_temp(mut g)
    emit(mut g, c_ty + " " + temp + " = " + v + ";")
    return "&" + temp
}

fn is_word(c: Byte) -> Bool {
    return c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '_'
}

// A C variable or temporary (`v_x`, `_t3`), not a path into one.
// A temporary of this function's, `_t12`: nothing else changes it.
fn is_temp(c: Str) -> Bool {
    if len(c) <= 2 || c[0..2] != "_t" {
        return false
    }
    for ch in c[2..len(c)] {
        if ch < '0' || ch > '9' {
            return false
        }
    }
    return true
}

fn is_simple(c: Str) -> Bool {
    if len(c) > 2 && c[0..2] == "v_" {
        for ch in c[2..len(c)] {
            if !is_word(ch) {
                return false
            }
        }
        return true
    }
    if len(c) > 2 && c[0..2] == "_t" {
        for ch in c[2..len(c)] {
            if ch < '0' || ch > '9' {
                return false
            }
        }
        return true
    }
    return false
}

// Take ownership of a value; returns a C expression for it.
fn consume(g: mut Gen, v: Value) -> Str {
    if !managed(mut g, v.ty) || v.is_static {
        return v.c
    }
    if v.owned {
        let mut f = len(g.frames) - 1
        for f >= 0 {
            let items = g.frames[f].items
            for i in 0..len(items) {
                if items[i].c == v.c && items[i].ty == v.ty {
                    let mut kept = items[0..i]
                    for rest in items[i + 1..len(items)] {
                        push(mut kept, rest)
                    }
                    g.frames[f].items = kept
                    return v.c
                }
            }
            f = f - 1
        }
        return v.c
    }
    let mut c = v.c
    if !is_temp(c) {
        // Copy a variable, field or element path into a temporary first, so
        // later changes to where it came from cannot change the copy: in
        // `push(mut b.items, b)` the b pushed is b before the push, and the
        // place's copy-on-write must not show through it. Copying only
        // paths once let b.items hold a b that held b.items, a cycle that
        // leaked (found in M13).
        let temp = new_temp(mut g)
        emit(mut g, c_type(g, v.ty) + " " + temp + " = " + c + ";")
        c = temp
    }
    emit(mut g, retain(mut g, v.ty, c))
    return c
}

fn is_scope(kind: Str) -> Bool {
    return kind == "function" || kind == "block" || kind == "body" || kind == "arm"
}

// Declare a local holding an owned value, released when its scope ends.
fn declare(g: mut Gen, id: Int, v: Str) -> Str {
    let name = local(mut g, id)
    let t = local_ty(g, id)
    emit(mut g, c_type(g, t) + " " + name + " = " + v + ";")
    if managed(mut g, t) {
        let mut f = len(g.frames) - 1
        for !is_scope(g.frames[f].kind) {
            f = f - 1
        }
        push(mut g.frames[f].items, Item { c: name, ty: t })
    }
    return name
}

// Release every frame up to and including the innermost one of kind
// `stop` (for break and continue), or every frame ("", for return).
fn release_until(g: mut Gen, stop: Str) {
    let mut f = len(g.frames) - 1
    for f >= 0 {
        let frame = g.frames[f]
        release_frame(mut g, frame)
        if frame.kind == stop {
            break
        }
        f = f - 1
    }
}

// ---- Functions and statements ----

fn function(g: mut Gen, id: Int, cname: Str) -> [Str] {
    let f = g.k.fns[id]
    if g.coverage { emit(mut g, "vela_coverage_hit(" + strings.from_int(id) + ");") }
    push_frame(mut g, "function")
    let mut names: [Str] = []
    for i in 0..len(f.decl.params) {
        // Parameters are borrowed (M11b): the caller keeps its references,
        // and the function retains only what it keeps, as consume does for
        // any value it does not own. A function value's code, a closure's,
        // takes its arguments owned instead (closure_value).
        push(mut names, c_name(mut g, f.param_locals[i]))
        // Its range, from every call (ranges.analyze): full when unknown.
        if i < len(g.env.params[id]) && !f.mutable[i] && f.params[i] == types.INT() {
            g.env.locals[f.param_locals[i]] = g.env.params[id][i]
        }
    }
    for r in f.decl.requires {
        push_frame(mut g, "stmt")
        assert_code(mut g, r, r, "requires of '" + f.decl.name + "'")
        pop_frame(mut g)
    }
    for s in f.decl.body.stmts {
        stmt(mut g, s)
    }
    if !g.dead && f.result == types.NOTHING() {
        ensures_code(mut g, "")
    }
    pop_frame(mut g)
    let mut out = [prototype(g.k, g.l, id, names, g.params, g.args, cname) + " {"]
    for line in g.lines {
        push(mut out, line)
    }
    push(mut out, "}")
    return out
}

// The ensures clauses, checked as the function returns `result_c` ("" when
// it returns nothing), in a C block of their own: `result` names the value
// there, borrowed.
fn ensures_code(g: mut Gen, result_c: Str) {
    let f = g.k.fns[g.current_fn]
    if len(f.decl.ensures) == 0 || g.closure_result != -2 {
        return  // a closure's returns are not its function's
    }
    emit(mut g, "{")
    g.depth = g.depth + 1
    push_frame(mut g, "stmt")
    if f.result_local >= 0 && result_c != "" {
        let name = c_name(mut g, f.result_local)
        emit(mut g, c_type(g, local_ty(g, f.result_local)) + " " + name + " = " + result_c + ";")
    }
    for e in f.decl.ensures {
        assert_code(mut g, e, e, "ensures of '" + f.decl.name + "'")
    }
    pop_frame(mut g)
    g.depth = g.depth - 1
    forget_deeper(mut g)
    emit(mut g, "}")
}

fn block(g: mut Gen, b: ast.Block, kind: Str) {
    push_frame(mut g, kind)
    for s in b.stmts {
        stmt(mut g, s)
    }
    pop_frame(mut g)
}

fn stmt(g: mut Gen, s: ast.Stmt) {
    match s.kind {
        ast.StmtKind.Block(b) => {
            open(mut g, "{")
            block(mut g, b, "block")
            close(mut g, "}")
            return
        }
        _ => {}
    }
    emit(mut g, "// line " + strings.from_int(s.line))
    push_frame(mut g, "stmt")
    stmt_body(mut g, s)
    pop_frame(mut g)
}

fn stmt_body(g: mut Gen, s: ast.Stmt) {
    match s.kind {
        ast.StmtKind.ExprStmt(e) => expr(mut g, e)
        ast.StmtKind.Let(_, mutable, _, v) => {
            let c = consume(mut g, expr(mut g, v))
            let id = local_of(g, s.id)
            declare(mut g, id, c)
            if !mutable && id >= 0 && g.k.locals[id].ty == types.INT() {
                g.env.locals[id] = ranges.of(g.k, g.env, v)
            }
        }
        ast.StmtKind.Assign(target, v) => assign(mut g, target, v)
        ast.StmtKind.If(cond, then, otherwise) => if_stmt(mut g, cond, then, otherwise)
        ast.StmtKind.For(cond, body) => {
            // Any statements the condition needs must run on every
            // iteration, so the test goes inside the loop.
            let hoisted = g.hoisted
            let cached = g.cached
            hoist_unique(mut g, s)
            open(mut g, "for (;;) {")
            push_frame(mut g, "body")
            match cond {
                Some(e) => {
                    push_frame(mut g, "stmt")
                    let c = expr(mut g, e).c
                    let cond_c = scalar(mut g, types.BOOL(), c)
                    pop_frame(mut g)
                    emit(mut g, "if (!" + cond_c + ") break;")
                }
                None => {}
            }
            for inner in body.stmts {
                stmt(mut g, inner)
            }
            pop_frame(mut g)
            close(mut g, "}")
            g.hoisted = hoisted
            g.cached = cached
            // `for { ... }` with no break ends only by return: no code after it.
            match cond {
                None => g.dead = !g.k.breaks[s.id]
                Some(_) => {}
            }
        }
        ast.StmtKind.ForRange(_, start, end, body) => {
            let from = expr(mut g, start).c
            // The range is fixed when the loop starts.
            let to = scalar(mut g, types.INT(), expr(mut g, end).c)
            let i = new_temp(mut g)
            let hoisted = g.hoisted
            let cached = g.cached
            hoist_unique(mut g, s)
            open(mut g, "for (int64_t " + i + " = " + from + "; " + i + " < " + to + "; " + i + "++) {")
            push_frame(mut g, "body")
            let var = local_of(g, s.id)
            if var >= 0 {
                g.env.locals[var] = ranges.loop_range(g.k, g.env, start, end)
            }
            declare(mut g, var, i)
            for inner in body.stmts {
                stmt(mut g, inner)
            }
            pop_frame(mut g)
            close(mut g, "}")
            g.hoisted = hoisted
            g.cached = cached
        }
        ast.StmtKind.ForEach(_, iterable, body) => for_each(mut g, s, iterable, body)
        ast.StmtKind.Break => {
            release_until(mut g, "body")
            emit(mut g, "break;")
            g.dead = true
        }
        ast.StmtKind.Continue => {
            release_until(mut g, "body")
            emit(mut g, "continue;")
            g.dead = true
        }
        ast.StmtKind.Return(v) => {
            match v {
                None => {
                    ensures_code(mut g, "")
                    release_until(mut g, "")
                    emit(mut g, "return;")
                }
                Some(e) => {
                    let c = consume(mut g, expr(mut g, e))
                    let result = new_temp(mut g)
                    emit(mut g, c_type(g, ty(g, e)) + " " + result + " = " + c + ";")
                    ensures_code(mut g, result)
                    release_until(mut g, "")
                    emit(mut g, "return " + result + ";")
                }
            }
            g.dead = true
        }
        ast.StmtKind.MatchStmt(scrutinee, arms) => match_code(mut g, scrutinee, arms, ArmCode.Statements)
        ast.StmtKind.Unsafe(body) => block(mut g, body, "block")
        ast.StmtKind.With(items, body) => with_code(mut g, items, body)
        ast.StmtKind.Block(_) => {}  // handled in stmt
    }
}

// An Item that is not a value to release but a C statement to run when its
// frame ends: putting back what a `with` faked.
fn restore_item() -> Int {
    return -3
}

// `with`: each fake is set when the block starts and put back however the
// block is left, as its frame ends (at its end, or by return, break or ?).
fn with_code(g: mut Gen, items: [ast.WithItem], body: ast.Block) {
    open(mut g, "{")
    push_frame(mut g, "block")
    for w in items {
        let saved = new_temp(mut g)
        if w.name == "stdout" {
            let p = place(mut g, mut_place(w.value))
            emit(mut g, "vela_array **" + saved + " = vela_fake_stdout(&" + p + ");")
        } else {
            let v = consume(mut g, expr(mut g, w.value))
            let mut c_ty = "vela_map *"
            if w.name == "args" {
                c_ty = "vela_array *"
            } else if w.name == "stdin" || w.name == "clock" || w.name == "net" || w.name == "processes" {
                c_ty = "void *"
            }
            emit(mut g, c_ty + saved + " = vela_fake_" + w.name + "(" + v + ");")
        }
        let restore = "vela_fake_" + w.name + "_restore(" + saved + ");"
        push(mut g.frames[len(g.frames) - 1].items, Item { c: restore, ty: restore_item() })
    }
    for s in body.stmts {
        stmt(mut g, s)
    }
    pop_frame(mut g)
    close(mut g, "}")
}

fn if_stmt(g: mut Gen, cond: ast.Expr, then: ast.Block, otherwise: ast.Else) {
    let c = expr(mut g, cond).c
    open(mut g, "if (" + c + ") {")
    block(mut g, then, "block")
    let then_ends = g.dead
    match otherwise {
        ast.Else.NoElse => {
            close(mut g, "}")
            return
        }
        _ => {}
    }
    close(mut g, "} else {")
    g.depth = g.depth + 1
    let mut else_ends = false
    match otherwise {
        ast.Else.ElseIf(s) => {
            // `else if`'s condition may need statements of its own, which
            // must only run when the first condition was false.
            push_frame(mut g, "branch")
            match s.kind {
                ast.StmtKind.If(c2, then2, else2) => if_stmt(mut g, c2, then2, else2)
                _ => {}
            }
            else_ends = g.dead
            pop_frame(mut g)
        }
        ast.Else.ElseBlock(b) => {
            block(mut g, b, "block")
            else_ends = g.dead
        }
        ast.Else.NoElse => {}
    }
    close(mut g, "}")
    g.dead = then_ends && else_ends  // as for a match: no code after both branches end
}

// `for x in xs`: the loop keeps its own reference to xs.
fn for_each(g: mut Gen, s: ast.Stmt, iterable: ast.Expr, body: ast.Block) {
    let t = ty(g, iterable)
    let it = new_temp(mut g)
    let c = consume(mut g, expr(mut g, iterable))
    emit(mut g, c_type(g, t) + " " + it + " = " + c + ";")
    own(mut g, it, t)  // released when the for statement ends
    let i = new_temp(mut g)
    let mut length = it + "->len"
    if t == types.STR() {
        length = it + ".len"
    }
    if types.is_fixed(g.k.table, t) { length = strings.from_int(types.get(g.k.table, t).length) }
    let hoisted = g.hoisted
    let cached = g.cached
    hoist_unique(mut g, s)
    open(mut g, "for (int64_t " + i + " = 0; " + i + " < " + length + "; " + i + "++) {")
    push_frame(mut g, "body")
    let lid = local_of(g, s.id)
    if t == types.STR() {
        declare(mut g, lid, it + ".data[" + i + "]")
    } else {
        let elem = c_type(g, local_ty(g, lid))
        let mut item = "((" + elem + " *)" + it + "->data)[" + i + "]"
        if types.is_fixed(g.k.table, t) { item = "*(" + elem + " *)vela_fixed_at(&" + it + ", " + i + ", " + length + ", sizeof(" + elem + "), " + loc_of(g, iterable) + ")" }
        let name = declare(mut g, lid, item)
        emit(mut g, retain(mut g, local_ty(g, lid), name))
    }
    for inner in body.stmts {
        stmt(mut g, inner)
    }
    pop_frame(mut g)
    close(mut g, "}")
    g.hoisted = hoisted
    g.cached = cached
}

// A call, or a variant built with values (`Some(x)`). Afterwards no
// array is known to be unique any more (M18): the call may have shared it.
fn call_value(g: mut Gen, e: ast.Expr, args: [ast.Expr]) -> Value {
    let t = ty(g, e)
    match g.k.refs[e.id] {
        checker.Ref.Method(t, name) => return method_value(mut g, e, checker.method_args(e, args), sub(g, t), name)
        checker.Ref.Variant(enum, vi) => {
            let mut consumed: [Str] = []
            for a in args {
                push(mut consumed, consume(mut g, expr(mut g, a)))
            }
            return enum_value(mut g, sub(g, enum), vi, consumed)
        }
        checker.Ref.Builtin(name) => return builtin(mut g, e, name, args)
        checker.Ref.Function(id) => {
            if g.k.fns[id].decl.foreign != "" { return foreign_call(mut g, e, id, args) }
            // The function borrows its arguments (M11b): they stay
            // the caller's, temporaries released when the statement
            // ends. Unless an argument has a `mut` in it, which can
            // change a variable another argument was read from: then
            // each is a copy with a reference of its own, kept until
            // the statement ends. The other arguments first, left to
            // right; then the places of the mut ones, so nothing
            // evaluated in between can move them.
            let mut protect = false
            for a in args {
                if ast.has_mut(a) {
                    protect = true
                }
            }
            let mut cs: [Str] = []
            let mut kept: [Item] = []
            for a in args {
                match a.kind {
                    ast.ExprKind.MutArg(_) => push(mut cs, "")
                    _ => {
                        if protect {
                            let v = expr(mut g, a)
                            let c = consume(mut g, v)
                            push(mut cs, c)
                            push(mut kept, Item { c: c, ty: v.ty })
                        } else {
                            push(mut cs, expr(mut g, a).c)
                        }
                    }
                }
            }
            for i in 0..len(args) {
                match args[i].kind {
                    ast.ExprKind.MutArg(p) => cs[i] = "&" + place(mut g, p)
                    _ => {}
                }
            }
            let callee = function_name(g, id, e)
            let mut b = strings.builder()
            strings.add(mut b, callee + "(")
            for i in 0..len(cs) {
                if i > 0 {
                    strings.add(mut b, ", ")
                }
                strings.add(mut b, cs[i])
            }
            strings.add_byte(mut b, ')')
            let call = strings.build(b)
            let mut result = no_value()
            if t == types.NOTHING() {
                emit(mut g, call + ";")
            } else {
                result = store(mut g, t, call)
            }
            for item in kept {
                own(mut g, item.c, item.ty)  // released when the statement ends
            }
            return result
        }
        checker.Ref.Indirect => return indirect_call(mut g, e, args)
        _ => return no_value()
    }
}
// A call that cannot share an array: a built-in that only computes.
fn pure_call(g: Gen, e: ast.Expr) -> Bool {
    match g.k.refs[e.id] {
        checker.Ref.Builtin(name) => {
            return integers.type_id(name) >= 0 || len(name) > 5 && name[0..5] == "ints." || name == "math.sqrt" || name == "len" || name == "int" || name == "float" || name == "byte" ||
                name == "strings.from_int" || name == "strings.from_float" || name == "print" || name == "assert" ||
                name == "strings.add" || name == "strings.add_byte" || name == "strings.add_int" || name == "push"
        }
        checker.Ref.Variant(_, _) => return true
        _ => return false
    }
}

// Builtins that read a map without changing any.
fn looks_up(g: Gen, e: ast.Expr) -> Bool {
    match g.k.refs[e.id] {
        checker.Ref.Builtin(name) => return name == "maps.get" || name == "maps.has" || name == "maps.keys" || name == "len"
        _ => return false
    }
}

// The lookup of `key` in `m` the write `m[key] = ...` may use, or -1.
fn found_for(g: Gen, m: ast.Expr, key: ast.Expr) -> Int {
    let ml = match m.kind {
        ast.ExprKind.Name(_) => local_of(g, m.id)
        _ => -1
    }
    if ml < 0 || !unchanging(g, key) {
        return -1
    }
    let kl = local_of(g, key.id)
    for i in 0..len(g.found) {
        if g.found[i].map == ml && g.found[i].key == kl {
            return i
        }
    }
    return -1
}

// Forget the lookups in a map about to change.
fn forget_found(g: mut Gen, m: ast.Expr) {
    let ml = match m.kind {
        ast.ExprKind.Name(_) => local_of(g, m.id)
        _ => -1
    }
    let mut kept: [Found] = []
    for f in g.found {
        if ml >= 0 && f.map != ml {
            push(mut kept, f)
        }
    }
    g.found = kept
}

// ---- Assignment and places ----

fn assign(g: mut Gen, target: ast.Expr, v: ast.Expr) {
    // The new value is worked out first; then the place is changed.
    let c = consume(mut g, expr(mut g, v))
    match target.kind {
        ast.ExprKind.Name(_) => {
            g.unique = []  // the variable may hold another array now
            g.found = []
        }
        _ => {}
    }
    match target.kind {
        ast.ExprKind.Name(_) => {
            let name = local(mut g, local_of(g, target.id))
            emit(mut g, release(mut g, ty(g, target), name))
            emit(mut g, name + " = " + c + ";")
        }
        ast.ExprKind.Field(obj, field) => {
            let owner = ty(g, obj)
            let base = place(mut g, obj)
            let member = base + ".m_" + field
            if layout.is_boxed(g.l, owner, field, 0) {
                // Never write into a box someone else may share: drop this
                // value's box and give the field a new one.
                let box = layout.box_name(g.l, ty(g, target))
                emit(mut g, box + "_release(" + member + ");")
                emit(mut g, member + " = " + box + "_new(" + c + ");")
            } else {
                emit(mut g, release(mut g, ty(g, target), member))
                emit(mut g, member + " = " + c + ";")
            }
        }
        ast.ExprKind.Index(obj, i) => {
            let fi = found_for(g, obj, i)
            let mut f = Found { map: -1, key: -1, depth: 0, slot: "", hash: "", looked_in: "" }
            if fi >= 0 {
                f = g.found[fi]  // before the write's check forgets it
            }
            let container = writable(mut g, obj)
            let ot = ty(g, obj)
            if types.is_map(g.k.table, ot) {
                let k = c_type(g, types.get(g.k.table, ot).args[0])
                let vt = c_type(g, ty(g, target))
                if fi >= 0 {
                    // The key is borrowed: the map retains it only if it keeps it.
                    // A new value for a key already there, inline; anything
                    // else in the runtime. Not open and close: what is known
                    // of the variables holds after this if.
                    emit(mut g, "if (" + container + " == " + f.looked_in + " && " + f.slot + ") {")
                    g.depth = g.depth + 1
                    emit(mut g, release(mut g, ty(g, target), "*" + f.slot))
                    emit(mut g, "*" + f.slot + " = " + c + ";")
                    g.depth = g.depth - 1
                    emit(mut g, "} else {")
                    g.depth = g.depth + 1
                    let ka = addr(mut g, k, expr(mut g, i).c)
                    let va = addr(mut g, vt, c)
                    emit(mut g, "vela_map_set_found(" + container + ", " + f.looked_in + ", " + f.slot + ", " + f.hash + ", " + ka +
                        ", " + va + ");")
                    g.depth = g.depth - 1
                    emit(mut g, "}")
                } else {
                    let ka = addr(mut g, k, consume(mut g, expr(mut g, i)))
                    let va = addr(mut g, vt, c)
                    emit(mut g, "vela_map_set(" + container + ", " + ka + ", " + va + ");")
                }
            } else {
                // The old element goes, the new one takes its place.
                let index = expr(mut g, i).c
                let elem = c_type(g, ty(g, target))
                let slot = new_temp(mut g)
                // Worked out before emit: reading g in a call that also changes it copies all of it.
                let address = element_address(g, target, elem, container, index, loc_of(g, target))
                emit(mut g, elem + " *" + slot + " = " + address + ";")
                emit(mut g, release(mut g, ty(g, target), "*" + slot))
                emit(mut g, "*" + slot + " = " + c + ";")
            }
        }
        _ => {}
    }
}

// An lvalue for an array or map about to change, made unique first.
fn writable(g: mut Gen, e: ast.Expr) -> Str {
    let p = place(mut g, e)
    if types.is_fixed(g.k.table, ty(g, e)) { return p }
    forget_found(mut g, e)
    let mut kind = "array"
    if types.is_map(g.k.table, ty(g, e)) {
        kind = "map"
    }
    // Once per variable until something could share it (M18).
    let simple = match e.kind {
        ast.ExprKind.Name(_) => true
        _ => false
    }
    if simple {
        for u in g.unique {
            if u == p {
                return p
            }
        }
        for u in g.hoisted {
            if u == p {
                return p
            }
        }
    }
    if kind == "array" {
        emit(mut g, "vela_unique(&" + p + ");")
    } else {
        emit(mut g, "vela_unique_map(&" + p + ");")
    }
    if simple {
        push(mut g.unique, p)
    }
    return p
}

// ---- Copy-on-write checks before a loop (M18) ----
//
// An array or map a loop writes is made unique once, before the loop, when
// nothing in the loop can make a second reference to it: then no write in
// the loop needs a check, and the C compiler can keep its length and
// elements' address in registers. Anything but an element read or write,
// len, a map lookup or a push could share it: passing it, copying it,
// iterating over it, capturing it or giving the variable a new value.

type LoopUses = struct {
    k: checker.Checked  // here, not passed beside `mut u`, which would copy it at every call
    writes: [Int]  // locals written: an element, a push
    grows: [Int]  // locals pushed to, whose elements may move
    shared: Map[Int, Bool]  // locals used in a way that could share them
}

fn shares(u: mut LoopUses, e: ast.Expr) {
    let l = ref_local(u.k, e.id)
    if l >= 0 {
        u.shared[l] = true
    }
}

fn ref_local(k: checker.Checked, id: Int) -> Int {
    return match k.refs[id] {
        checker.Ref.Local(l) => l
        _ => -1
    }
}

fn is_name(e: ast.Expr) -> Bool {
    return match e.kind {
        ast.ExprKind.Name(_) => true
        _ => false
    }
}

fn uses_expr(u: mut LoopUses, e: ast.Expr, in_closure: Bool) {
    match e.kind {
        ast.ExprKind.Name(_) => shares(mut u, e)
        ast.ExprKind.Unary(_, x) => uses_expr(mut u, x, in_closure)
        ast.ExprKind.Binary(_, l, r) => {
            uses_expr(mut u, l, in_closure)
            uses_expr(mut u, r, in_closure)
        }
        ast.ExprKind.Call(f, args) => {
            let mut name = ""
            match u.k.refs[e.id] {
                checker.Ref.Builtin(n) => name = n
                _ => {}
            }
            let reads = name == "len" || name == "maps.get" || name == "maps.has" || name == "maps.keys"
            let pushes = name == "push" || name == "strings.add" || name == "strings.add_byte" || name == "strings.add_int" ||
                name == "maps.remove"
            uses_expr(mut u, f, in_closure)
            for i in 0..len(args) {
                let a = args[i]
                if i == 0 && reads && is_name(a) && !in_closure {
                    continue  // read where it is, never retained
                }
                match a.kind {
                    ast.ExprKind.MutArg(x) => {
                        if i == 0 && pushes && is_name(x) && !in_closure {
                            push(mut u.writes, ref_local(u.k, x.id))
                            push(mut u.grows, ref_local(u.k, x.id))
                        } else {
                            uses_expr(mut u, x, in_closure)
                        }
                    }
                    _ => uses_expr(mut u, a, in_closure)
                }
            }
        }
        ast.ExprKind.Field(x, _) => uses_expr(mut u, x, in_closure)
        ast.ExprKind.Index(x, i) => {
            if !is_name(x) || in_closure {
                uses_expr(mut u, x, in_closure)
            }
            uses_expr(mut u, i, in_closure)
        }
        ast.ExprKind.Try(x) => uses_expr(mut u, x, in_closure)
        ast.ExprKind.MutArg(x) => uses_expr(mut u, x, in_closure)
        ast.ExprKind.Slice(x, a, b) => {
            uses_expr(mut u, x, in_closure)
            uses_expr(mut u, a, in_closure)
            uses_expr(mut u, b, in_closure)
        }
        ast.ExprKind.ArrayLit(xs) => {
            for x in xs {
                uses_expr(mut u, x, in_closure)
            }
        }
        ast.ExprKind.MapLit(entries) => {
            for m in entries {
                uses_expr(mut u, m.key, in_closure)
                uses_expr(mut u, m.value, in_closure)
            }
        }
        ast.ExprKind.StructLit(_, _, fields) => {
            for f in fields {
                uses_expr(mut u, f.value, in_closure)
            }
        }
        ast.ExprKind.Match(x, arms) => {
            uses_expr(mut u, x, in_closure)
            uses_arms(mut u, arms, in_closure)
        }
        ast.ExprKind.Closure(_, _, body, _) => uses_block(mut u, body, true)
        _ => {}
    }
}

fn uses_arms(u: mut LoopUses, arms: [ast.Arm], in_closure: Bool) {
    for a in arms {
        match a.body {
            ast.ArmBody.Value(v) => uses_expr(mut u, v, in_closure)
            ast.ArmBody.Do(st) => uses_stmt(mut u, st, in_closure)
        }
    }
}

// The place an assignment writes: an element of a variable is a write of
// it; a variable itself gets a new value.
fn uses_target(u: mut LoopUses, e: ast.Expr, in_closure: Bool) {
    match e.kind {
        ast.ExprKind.Index(x, i) => {
            uses_expr(mut u, i, in_closure)
            if is_name(x) && !in_closure {
                push(mut u.writes, ref_local(u.k, x.id))
            } else {
                uses_target(mut u, x, in_closure)
            }
        }
        ast.ExprKind.Field(x, _) => uses_target(mut u, x, in_closure)
        _ => uses_expr(mut u, e, in_closure)
    }
}

fn uses_block(u: mut LoopUses, b: ast.Block, in_closure: Bool) {
    for st in b.stmts {
        uses_stmt(mut u, st, in_closure)
    }
}

fn uses_stmt(u: mut LoopUses, st: ast.Stmt, in_closure: Bool) {
    match st.kind {
        ast.StmtKind.Block(b) => uses_block(mut u, b, in_closure)
        ast.StmtKind.ExprStmt(e) => uses_expr(mut u, e, in_closure)
        ast.StmtKind.Let(_, _, _, v) => uses_expr(mut u, v, in_closure)
        ast.StmtKind.Assign(target, v) => {
            uses_expr(mut u, v, in_closure)
            uses_target(mut u, target, in_closure)
        }
        ast.StmtKind.If(cond, then, otherwise) => {
            uses_expr(mut u, cond, in_closure)
            uses_block(mut u, then, in_closure)
            match otherwise {
                ast.Else.ElseBlock(b) => uses_block(mut u, b, in_closure)
                ast.Else.ElseIf(inner) => uses_stmt(mut u, inner, in_closure)
                ast.Else.NoElse => {}
            }
        }
        ast.StmtKind.For(cond, body) => {
            match cond {
                Some(c) => uses_expr(mut u, c, in_closure)
                None => {}
            }
            uses_block(mut u, body, in_closure)
        }
        ast.StmtKind.ForRange(_, a, b, body) => {
            uses_expr(mut u, a, in_closure)
            uses_expr(mut u, b, in_closure)
            uses_block(mut u, body, in_closure)
        }
        ast.StmtKind.ForEach(_, it, body) => {
            uses_expr(mut u, it, in_closure)
            uses_block(mut u, body, in_closure)
        }
        ast.StmtKind.Return(v) => {
            match v {
                Some(e) => uses_expr(mut u, e, in_closure)
                None => {}
            }
        }
        ast.StmtKind.MatchStmt(x, arms) => {
            uses_expr(mut u, x, in_closure)
            uses_arms(mut u, arms, in_closure)
        }
        ast.StmtKind.Unsafe(b) => uses_block(mut u, b, in_closure)
        ast.StmtKind.With(items, b) => {
            for w in items {
                uses_expr(mut u, w.value, in_closure)
            }
            uses_block(mut u, b, in_closure)
        }
        _ => {}
    }
}

// Before a loop: make unique the arrays and maps declared before it that
// it writes and cannot share, and remember them for its writes.
fn hoist_unique(g: mut Gen, loop: ast.Stmt) {
    let mut u = LoopUses { k: g.k, writes: [], grows: [], shared: [:] }
    uses_stmt(mut u, loop, false)
    let mut done: [Int] = []
    for l in u.writes {
        if l < 0 || maps.has(u.shared, l) || !maps.has(g.names, l) || maps.has(g.captures, l) {
            continue
        }
        let mut seen = false
        for d in done {
            if d == l {
                seen = true
            }
        }
        if seen {
            continue
        }
        push(mut done, l)
        let t = local_ty(g, l)
        let p = local(mut g, l)
        let mut known = false
        for h in g.hoisted {
            if h == p {
                known = true  // by an enclosing loop
            }
        }
        if known {
            continue
        }
        if types.is_map(g.k.table, t) {
            emit(mut g, "vela_unique_map(&" + p + ");")
        } else {
            emit(mut g, "vela_unique(&" + p + ");")  // an array or a strings.Builder, as in writable
        }
        push(mut g.hoisted, p)
    }
    // Then the arrays the loop writes in place, whose length and elements'
    // address cannot change in it: never pushed to, given a new value or
    // passed as mut (those share them). C cannot tell that a store to an
    // element does not change the array's header, and would load both
    // again after every one. An array the loop only reads gains little,
    // and the locals cost registers across the loop's calls.
    let mut grows: Map[Int, Bool] = [:]
    for l in u.grows {
        grows[l] = true
    }
    for l in u.writes {
        if l < 0 || maps.has(u.shared, l) || maps.has(grows, l) || !maps.has(g.names, l) || maps.has(g.captures, l) {
            continue
        }
        if !types.is_array(g.k.table, local_ty(g, l)) {
            continue
        }
        let p = local(mut g, l)
        if maps.has(g.cached, p) {
            continue
        }
        let d = new_temp(mut g)
        emit(mut g, "unsigned char *" + d + " = " + p + "->data;")
        emit(mut g, "int64_t " + d + "n = " + p + "->len;")
        g.cached[p] = d
    }
}

// The address of element `index` of the array `container`, checked to be
// in bounds, as a pointer to `elem`, the element's C type. The check is
// inline, in vela_rt.h, so the C compiler can see through it (M16b).
fn element_address(g: Gen, e: ast.Expr, elem: Str, container: Str, index: Str, loc: Str) -> Str {
    match e.kind {
        ast.ExprKind.Index(obj, _) => {
            let t = ty(g, obj)
            if types.is_fixed(g.k.table, t) { return "(" + elem + " *)vela_fixed_at(&(" + container + "), " + index + ", " + strings.from_int(types.get(g.k.table, t).length) + ", sizeof(" + elem + "), " + loc + ")" }
        }
        _ => {}
    }
    let safe = maps.has(g.env.safe, e.id) && g.env.safe[e.id]
    match maps.get(g.cached, container) {
        Some(d) => {
            if safe {
                return "((" + elem + " *)" + d + " + " + index + ")"
            }
            return "(" + elem + " *)vela_at_in(" + d + ", " + d + "n, " + index + ", sizeof(" + elem + "), " + loc + ")"
        }
        None => {}
    }
    if safe {
        return "((" + elem + " *)" + container + "->data + " + index + ")"
    }
    return "(" + elem + " *)vela_at(" + container + ", " + index + ", sizeof(" + elem + "), " + loc + ")"
}

// A C lvalue for a variable, or a path inside one, about to be written
// through; shared boxes and arrays on the way are copied first.
fn place(g: mut Gen, e: ast.Expr) -> Str {
    match e.kind {
        ast.ExprKind.Name(_) => return local(mut g, local_of(g, e.id))
        ast.ExprKind.Field(obj, field) => {
            let base = place(mut g, obj)
            let member = base + ".m_" + field
            if !layout.is_boxed(g.l, ty(g, obj), field, 0) {
                return member
            }
            emit(mut g, layout.box_name(g.l, ty(g, e)) + "_unique(&" + member + ");")
            return layout.box_value(g.l, ty(g, e), member)
        }
        ast.ExprKind.Index(obj, i) => {
            let container = writable(mut g, obj)
            let ot = ty(g, obj)
            if types.is_map(g.k.table, ot) {
                let key = expr(mut g, i).c
                let k = c_type(g, types.get(g.k.table, ot).args[0])
                let ka = addr(mut g, k, key)
                return "(*(" + c_type(g, ty(g, e)) + " *)vela_map_at(" + container + ", " + ka + ", " + loc_of(g, e) + "))"
            }
            let index = expr(mut g, i).c
            return "(*" + element_address(g, e, c_type(g, ty(g, e)), container, index, loc_of(g, e)) + ")"
        }
        _ => return ""
    }
}

// ---- Match ----

// Whether `e` is a variable that cannot change while it is in scope: a
// parameter that is not mut, a `let` without mut, a loop variable or a
// match binding. What is bound from it in a match can borrow from it.
fn unchanging(g: Gen, e: ast.Expr) -> Bool {
    match e.kind {
        ast.ExprKind.Name(_) => {
            match g.k.refs[e.id] {
                checker.Ref.Local(id) => {
                    let kind = g.k.locals[id].kind
                    return kind == "parameter" || kind == "let" || kind == "loop variable" || kind == "match binding"
                }
                _ => return false
            }
        }
        _ => return false
    }
}

// An if / else-if chain, one test per arm, in order; the last arm is a
// plain `else`, since the checker proved the arms exhaustive.
fn match_code(g: mut Gen, scrutinee: ast.Expr, arms: [ast.Arm], code: ArmCode) {
    let v = expr(mut g, scrutinee).c
    let t = ty(g, scrutinee)
    let borrowed = unchanging(g, scrutinee)
    let mut all_end = true  // every arm returns, breaks or continues
    // Each arm starts from the lookups made before the match; after it,
    // those no arm forgot remain.
    let before = g.found
    let mut after = g.found
    for i in 0..len(arms) {
        let a = arms[i]
        let last = i == len(arms) - 1
        g.dead = false  // each arm is reachable, whatever the last one ended with
        g.found = before
        if last {
            if i > 0 {
                open(mut g, "} else {")
            } else {
                open(mut g, "{")
            }
        } else {
            let tests = tests(g, a.pattern, v, t)
            let mut cond = strings.builder()
            for j in 0..len(tests) {
                if j > 0 {
                    strings.add(mut cond, " && ")
                }
                strings.add(mut cond, tests[j])
            }
            let mut c = strings.build(cond)
            if c == "" {
                c = "true"
            }
            if i > 0 {
                open(mut g, "} else if (" + c + ") {")
            } else {
                open(mut g, "if (" + c + ") {")
            }
        }
        push_frame(mut g, "arm")
        for bound in bindings(g, a.pattern, v, t) {
            if borrowed {
                // Borrowed from a variable nothing can change (M16b), as a
                // parameter is: whatever keeps it retains it then.
                let name = local(mut g, bound.local)
                emit(mut g, c_type(g, local_ty(g, bound.local)) + " " + name + " = " + bound.path + ";")
            } else {
                // A binding is a copy of part of the value: it gets a reference of its own.
                let name = declare(mut g, bound.local, bound.path)
                emit(mut g, retain(mut g, local_ty(g, bound.local), name))
            }
        }
        match code {
            ArmCode.Statements => {
                match a.body {
                    ast.ArmBody.Do(s) => {
                        match s.kind {
                            ast.StmtKind.Block(b) => {
                                for inner in b.stmts {
                                    stmt(mut g, inner)
                                }
                            }
                            _ => stmt(mut g, s)
                        }
                    }
                    ast.ArmBody.Value(_) => {}
                }
            }
            ArmCode.StoreIn(result) => {
                match a.body {
                    ast.ArmBody.Value(e) => {
                        let c = consume(mut g, expr(mut g, e))
                        emit(mut g, result + " = " + c + ";")
                    }
                    ast.ArmBody.Do(_) => {}
                }
            }
        }
        if !g.dead {
            all_end = false
        }
        pop_frame(mut g)
        g.depth = g.depth - 1
        forget_deeper(mut g)
        let mut kept: [Found] = []
        for f in after {
            for h in g.found {
                if h.slot == f.slot {
                    push(mut kept, f)
                }
            }
        }
        after = kept
    }
    g.found = after
    emit(mut g, "}")
    // When every arm ends the function or the loop, nothing after the match
    // runs, and no code is written for it: no releases after a match whose
    // arms all return.
    g.dead = all_end
}

fn payload(g: Gen, path: Str, enum: Int, vi: Int, i: Int) -> Str {
    let name = types.get(g.k.table, enum).variants[vi].name
    let member = path + ".as.m_" + name + "._" + strings.from_int(i)
    if layout.is_boxed(g.l, enum, name, i) {
        return layout.box_value(g.l, types.get(g.k.table, enum).variants[vi].payload[i], member)
    }
    return member
}

fn variant_ref(g: Gen, id: Int) -> [Int] {
    return match g.k.refs[id] {
        checker.Ref.Variant(e, v) => [sub(g, e), v]
        _ => [0, 0]
    }
}

// C conditions, all of which hold when the value at `path` matches `p`.
fn tests(g: Gen, p: ast.Pattern, path: Str, t: Int) -> [Str] {
    let none: [Str] = []
    match p.kind {
        ast.PatternKind.Wild => return none
        ast.PatternKind.Bind(_) => return none
        ast.PatternKind.Lit(e) => {
            match e.kind {
                ast.ExprKind.BoolLit(b) => {
                    if b {
                        return [path]
                    }
                    return ["!" + path]
                }
                ast.ExprKind.StrLit(s) => {
                    return ["vela_str_eq(" + path + ", VELA_STR(" + c_string(s) + ", " + strings.from_int(len(s)) + "))"]
                }
                ast.ExprKind.IntLit(n) => return [path + " == " + integer_literal(n, t)]
                ast.ExprKind.FixedIntLit(n, _, _) => return [path + " == " + integer_literal(n, t)]
                ast.ExprKind.ByteLit(n) => return [path + " == " + strings.from_int(n)]
                _ => return none
            }
        }
        ast.PatternKind.Range(lo, hi) => {
            let mut out: [Str] = []
            let a = literal(lo)
            let b = literal(hi)
            // A test that can never fail (a Byte >= 0) would draw a C warning.
            if !(types.is_integer(t) && !types.integer_signed(t) && a == 0) {
                push(mut out, path + " >= " + integer_literal(a, t))
            }
            if !(types.is_integer(t) && ((t == 13 && b == -1) || t != 13 && b == integers.max(t))) {
                push(mut out, path + " <= " + integer_literal(b, t))
            }
            return out
        }
        ast.PatternKind.Variant(_, _, _, _, args) => {
            let r = variant_ref(g, p.id)
            let enum = r[0]
            let vi = r[1]
            let v = types.get(g.k.table, enum).variants[vi]
            let mut out = [path + ".tag == " + layout.tag(g.l, enum, v.name)]
            for i in 0..len(args) {
                for t2 in tests(g, args[i], payload(g, path, enum, vi, i), v.payload[i]) {
                    push(mut out, t2)
                }
            }
            return out
        }
    }
}

fn literal(e: ast.Expr) -> Int {
    return match e.kind {
        ast.ExprKind.IntLit(n) => n
        ast.ExprKind.FixedIntLit(n, _, _) => n
        ast.ExprKind.ByteLit(n) => n
        _ => 0
    }
}

type Binding = struct {
    local: Int
    path: Str
}

fn bindings(g: Gen, p: ast.Pattern, path: Str, t: Int) -> [Binding] {
    let mut out: [Binding] = []
    match p.kind {
        ast.PatternKind.Bind(_) => push(mut out, Binding { local: local_of(g, p.id), path: path })
        ast.PatternKind.Variant(_, _, _, _, args) => {
            let r = variant_ref(g, p.id)
            let v = types.get(g.k.table, r[0]).variants[r[1]]
            for i in 0..len(args) {
                for b in bindings(g, args[i], payload(g, path, r[0], r[1], i), v.payload[i]) {
                    push(mut out, b)
                }
            }
        }
        _ => {}
    }
    return out
}

// ---- Expressions ----

// Emit code for `e` and return its value: a literal, a variable, a
// temporary, or a field of one of those, so using it has no side effects.
// A call that produces no value has the C expression "".
fn expr(g: mut Gen, e: ast.Expr) -> Value {
    let t = ty(g, e)
    match e.kind {
        ast.ExprKind.IntLit(n) => {
            if t == types.FLOAT() {
                return value(strings.from_int(n) + ".0", t)  // so C divides as doubles
            }
            return value(integer_literal(n, t), t)
        }
        ast.ExprKind.FixedIntLit(n, _, neg) => {
            if t == types.FLOAT() { return value(integers.spelling(n, "", neg) + ".0", t) }
            return value(integer_literal(n, t), t)
        }
        ast.ExprKind.FloatLit(text) => return value(text, t)
        ast.ExprKind.ByteLit(n) => return value(strings.from_int(n), t)
        ast.ExprKind.BoolLit(b) => {
            if b {
                return value("true", t)
            }
            return value("false", t)
        }
        ast.ExprKind.StrLit(s) => {
            return Value { c: "VELA_STR(" + c_string(s) + ", " + strings.from_int(len(s)) + ")", ty: t, owned: false,
                is_static: true }
        }
        ast.ExprKind.UnitLit => return value("0", t)
        ast.ExprKind.Name(_) => {
            match g.k.refs[e.id] {
                checker.Ref.Local(id) => return value(local(mut g, id), t)
                checker.Ref.Variant(enum, vi) => return enum_value(mut g, sub(g, enum), vi, [])  // `None`
                checker.Ref.Function(id) => return function_value(mut g, id, e)  // a function as a value
                _ => return no_value()
            }
        }
        ast.ExprKind.Unary(op, operand) => {
            let c = expr(mut g, operand).c
            if op == "-" && t == types.FLOAT() {
                return value(scalar(mut g, t, "(-(" + c + "))"), t)
            }
            if op == "-" && types.is_integer(t) && ranges.cannot_fail(g.k, g.env, e) {
                return value(scalar(mut g, t, "(-(" + c + "))"), t)
            }
            if op == "~" || op == "-" && t != types.INT() {
                return fixed_operation(mut g, e, t, c, "0", unary_integer_op(op), 0)
            }
            if op == "-" {
                if ranges.cannot_fail(g.k, g.env, e) {
                    return value(scalar(mut g, types.INT(), "(-(" + c + "))"), t)
                }
                return value(scalar(mut g, types.INT(), "vela_neg(" + c + ", " + loc_of(g, e) + ")"), t)
            }
            return value(scalar(mut g, types.BOOL(), "!" + c), t)
        }
        ast.ExprKind.Binary(op, l, r) => return binary(mut g, e, op, l, r)
        ast.ExprKind.Call(_, args) => {
            let v = call_value(mut g, e, args)
            if !pure_call(g, e) {
                g.unique = []
                if !looks_up(g, e) {
                    g.found = []  // it could change any map it can reach
                }
            }
            return v
        }
        ast.ExprKind.Field(obj, name) => {
            match g.k.refs[e.id] {
                checker.Ref.Variant(enum, vi) => return enum_value(mut g, sub(g, enum), vi, [])
                checker.Ref.Function(id) => return function_value(mut g, id, e)  // `module.f` as a value
                _ => {}
            }
            let c = expr(mut g, obj).c
            let mut member = c + ".m_" + name
            if layout.is_boxed(g.l, ty(g, obj), name, 0) {
                member = layout.box_value(g.l, ty(g, e), member)
            }
            return value(member, t)
        }
        ast.ExprKind.Index(obj, i) => return index(mut g, e, obj, i)
        ast.ExprKind.Try(inner) => return try_value(mut g, e, inner)
        ast.ExprKind.MutArg(p) => return expr(mut g, p)  // not reached: only in calls
        ast.ExprKind.Slice(obj, lo, hi) => {
            let o = expr(mut g, obj).c
            let a = expr(mut g, lo).c
            let b = expr(mut g, hi).c
            let mut kind = "array"
            if t == types.STR() {
                kind = "str"
            }
            let mut f = "vela_" + kind + "_slice"
            if kind == "str" {
                f = "vela_slice"  // inline (M18)
            }
            return store(mut g, t, f + "(" + o + ", " + a + ", " + b + ", " + loc_of(g, e) + ")")
        }
        ast.ExprKind.ArrayLit(elems) => {
            if types.is_fixed(g.k.table, t) {
                let mut fields = ""
                for i in 0..len(elems) {
                    if i > 0 { fields = fields + ", " }
                    fields = fields + ".m__" + strings.from_int(i) + " = " + consume(mut g, expr(mut g, elems[i]))
                }
                if len(elems) == 0 { fields = "0" }
                return store(mut g, t, "(" + c_type(g, t) + "){" + fields + "}")
            }
            let elem_t = types.get(g.k.table, t).args[0]
            let array = store(mut g, t, "vela_array_new(" + layout.descriptor(g.l, elem_t) + ", " +
                strings.from_int(len(elems)) + ")")
            let elem = c_type(g, elem_t)
            for x in elems {
                let c = consume(mut g, expr(mut g, x))
                let a = addr(mut g, elem, c)
                emit(mut g, "vela_push(" + array.c + ", " + a + ", sizeof(" + elem + "));")
            }
            return array
        }
        ast.ExprKind.MapLit(entries) => {
            let ti = types.get(g.k.table, t)
            let m = store(mut g, t, "vela_map_new(" + layout.descriptor(g.l, ti.args[0]) + ", " +
                layout.descriptor(g.l, ti.args[1]) + ")")
            let k = c_type(g, ti.args[0])
            let vt = c_type(g, ti.args[1])
            for en in entries {
                let key = consume(mut g, expr(mut g, en.key))
                let val = consume(mut g, expr(mut g, en.value))
                let ka = addr(mut g, k, key)
                let va = addr(mut g, vt, val)
                emit(mut g, "vela_map_set(" + m.c + ", " + ka + ", " + va + ");")
            }
            return m
        }
        ast.ExprKind.StructLit(_, _, fields) => return struct_value(mut g, t, fields)
        ast.ExprKind.Match(scrutinee, arms) => {
            let result = new_temp(mut g)
            emit(mut g, c_type(g, t) + " " + result + ";")
            match_code(mut g, scrutinee, arms, ArmCode.StoreIn(result))
            return own(mut g, result, t)
        }
        ast.ExprKind.Closure(_, _, body, _) => return closure_value(mut g, e, body)
    }
}

// What the function (or closure) being written returns.
fn result_type(g: Gen) -> Int {
    if g.closure_result != -2 {
        return sub(g, g.closure_result)
    }
    return sub(g, g.k.fns[g.current_fn].result)
}

// A function used as a value: the pair of a wrapper that takes (and
// ignores) an environment, and no environment.
fn function_value(g: mut Gen, id: Int, e: ast.Expr) -> Value {
    let t = ty(g, e)
    let target = function_name(g, id, e)
    let wrapper = "vw_" + target
    if !maps.has(g.wrappers, wrapper) {
        let ft = types.get(g.k.table, t)
        let mut params = strings.builder()
        let mut args = strings.builder()
        strings.add(mut params, "vela_env *env")
        for i in 0..len(ft.args) {
            strings.add(mut params, ", " + c_type(g, ft.args[i]) + " a" + strings.from_int(i))
            if i > 0 {
                strings.add(mut args, ", ")
            }
            strings.add(mut args, "a" + strings.from_int(i))
        }
        let call = target + "(" + strings.build(args) + ");"
        // A function value takes its arguments owned; the function borrows them.
        let mut drops = strings.builder()
        for i in 0..len(ft.args) {
            let r = release(mut g, ft.args[i], "a" + strings.from_int(i))
            if r != "" {
                strings.add(mut drops, " " + r)
            }
        }
        let mut body = call + strings.build(drops)
        if ft.result != types.NOTHING() {
            body = c_type(g, ft.result) + " r = " + call + strings.build(drops) + " return r;"
        }
        g.wrappers[wrapper] = "static VELA_UNUSED " + c_type(g, ft.result) + " " + wrapper + "(" + strings.build(params) +
            ") { (void)env; " + body + " }"
    }
    return store(mut g, t, "(" + c_type(g, t) + "){ .fn = " + wrapper + ", .env = NULL }")
}

// A closure: its body becomes a C function of its own, which gets the
// captured copies through an environment, a counted block made here.
fn closure_value(g: mut Gen, e: ast.Expr, body: ast.Block) -> Value {
    let t = ty(g, e)
    let info = g.k.closures[e.id]
    g.closures = g.closures + 1
    let name = g.cname + "_c" + strings.from_int(g.closures)
    let env = "ve_" + name
    let fname = "vc_" + name
    // The body, written by a generator of its own.
    let mut inner = new_gen(g.k, g.l, g.current_fn, g.params, g.args, g.instance_names, name, g.env)
    inner.closure_result = info.result
    inner.filename = g.filename
    for i in 0..len(info.captures) {
        inner.captures[info.captures[i]] = "(env->c" + strings.from_int(i) + ")"
    }
    push_frame(mut inner, "function")
    let mut params = strings.builder()
    strings.add(mut params, "vela_env *env_")
    for lid in info.params {
        let pt = local_ty(inner, lid)
        let pname = c_name(mut inner, lid)
        strings.add(mut params, ", " + c_type(inner, pt) + " " + pname)
        if managed(mut inner, pt) {
            push(mut inner.frames[len(inner.frames) - 1].items, Item { c: pname, ty: pt })
        }
    }
    for s in body.stmts {
        stmt(mut inner, s)
    }
    pop_frame(mut inner)
    for line in inner.extra {
        push(mut g.extra, line)  // closures inside this one come first
    }
    for w in maps.keys(inner.wrappers) {
        g.wrappers[w] = inner.wrappers[w]
    }
    g.l = inner.l
    // The environment: a header the runtime knows, then the copies.
    let n = len(info.captures)
    if n > 0 {
        push(mut g.extra, "")
        push(mut g.extra, "typedef struct " + env + " {")
        push(mut g.extra, "    vela_env head;")
        for i in 0..n {
            push(mut g.extra, "    " + c_type(g, local_ty(g, info.captures[i])) + " c" + strings.from_int(i) + ";")
        }
        push(mut g.extra, "} " + env + ";")
        push(mut g.extra, "static void " + env + "_drop(vela_env *e_) {")
        push(mut g.extra, "    " + env + " *e = (" + env + " *)e_;")
        for i in 0..n {
            let r = release(mut g, local_ty(g, info.captures[i]), "e->c" + strings.from_int(i))
            if r != "" {
                push(mut g.extra, "    " + r)
            }
        }
        push(mut g.extra, "    vela_box_free(e, sizeof(" + env + "));")
        push(mut g.extra, "}")
        push(mut g.extra, "static void " + env + "_share(vela_env *e_) {")
        push(mut g.extra, "    " + env + " *e = (" + env + " *)e_;")
        push(mut g.extra, "    (void)e;")
        for i in 0..n {
            let m = share(mut g, local_ty(g, info.captures[i]), "e->c" + strings.from_int(i))
            if m != "" {
                push(mut g.extra, "    " + m)
            }
        }
        push(mut g.extra, "}")
    }
    push(mut g.extra, "")
    push(mut g.extra, "static " + c_type(g, sub(g, info.result)) + " " + fname + "(" + strings.build(params) + ") {")
    if n > 0 {
        push(mut g.extra, "    " + env + " *env = (" + env + " *)env_;")
    } else {
        push(mut g.extra, "    (void)env_;")
    }
    for line in inner.lines {
        push(mut g.extra, line)
    }
    push(mut g.extra, "}")
    if n == 0 {
        return store(mut g, t, "(" + c_type(g, t) + "){ .fn = " + fname + ", .env = NULL }")
    }
    let block = new_temp(mut g)
    emit(mut g, env + " *" + block + " = vela_box_alloc(sizeof(" + env + "));")
    emit(mut g, block + "->head.rc = 1;")
    emit(mut g, block + "->head.drop = " + env + "_drop;")
    emit(mut g, block + "->head.share = " + env + "_share;")
    for i in 0..n {
        let cid = info.captures[i]
        let member = block + "->c" + strings.from_int(i)
        emit(mut g, member + " = " + local(mut g, cid) + ";")
        emit(mut g, retain(mut g, local_ty(g, cid), member))
    }
    return store(mut g, t, "(" + c_type(g, t) + "){ .fn = " + fname + ", .env = &" + block + "->head }")
}

// The C function called, or named as a value, at node `e`: for a generic
// function, the copy for its type arguments there.
fn function_name(g: Gen, id: Int, e: ast.Expr) -> Str {
    if len(g.k.fns[id].type_params) == 0 {
        return fn_name(g.k, id)
    }
    let mut targs: [Int] = []
    for t in g.k.targs[e.id] {
        push(mut targs, sub(g, t))
    }
    return g.instance_names[mono.key(id, targs)]
}

// The line between the parts of the C that can be compiled apart: what
// comes before the first one (types, memory functions, prototypes) every
// part needs; each part after it is a function and the closures it uses.
pub fn part_mark() -> Str {
    return "/* vela: part */"
}

// tasks.map(xs, f) or tasks.each(xs, f): the runtime runs the calls, through
// a thunk written once per function type, vk_<type>, that calls f on one
// element and stores its result. The element is the array's, so the thunk
// retains it: a call takes its arguments owned.
fn tasks_call(g: mut Gen, name: Str, args: [ast.Expr], t: Int) -> Value {
    let xs = expr(mut g, args[0]).c
    let fv = expr(mut g, args[1])
    let f = scalar(mut g, fv.ty, fv.c)
    let ft = types.get(g.k.table, fv.ty)
    let fn_c = c_type(g, fv.ty)
    let arg_c = c_type(g, ft.args[0])
    let thunk = "vk_" + fn_c
    if !maps.has(g.wrappers, thunk) {
        let mut b = strings.builder()
        strings.add(mut b, "static VELA_UNUSED void " + thunk + "(void *f, const void *x, void *out) {\n")
        strings.add(mut b, "    " + fn_c + " *g = (" + fn_c + " *)f;\n")
        // `T const *`, not `const T *`: for a pointer type T the const must
        // apply to the pointer.
        strings.add(mut b, "    " + arg_c + " a = *(" + arg_c + " const *)x;\n")
        let keep = retain(mut g, ft.args[0], "a")
        if keep != "" {
            strings.add(mut b, "    " + keep + "\n")
        }
        if ft.result == types.NOTHING() {
            strings.add(mut b, "    (void)out;\n")
            strings.add(mut b, "    g->fn(g->env, a);\n")
        } else {
            strings.add(mut b, "    *(" + c_type(g, ft.result) + " *)out = g->fn(g->env, a);\n")
        }
        strings.add(mut b, "}")
        g.wrappers[thunk] = strings.build(b)
    }
    if name == "tasks.each" {
        emit(mut g, "vela_tasks_each(" + xs + ", &" + f + ", " + f + ".env, " + thunk + ");")
        return no_value()
    }
    let result = layout.descriptor(g.l, types.get(g.k.table, t).args[0])
    return store(mut g, t, "vela_tasks_map(" + xs + ", &" + f + ", " + f + ".env, " + thunk + ", " + result + ")")
}

// A call through a function value: the callee first, then the arguments,
// left to right, passed owned as to any function. The value's code gets
// its environment first.
fn indirect_call(g: mut Gen, e: ast.Expr, args: [ast.Expr]) -> Value {
    let mut callee = ""
    match e.kind {
        ast.ExprKind.Call(f, _) => {
            let v = expr(mut g, f)
            callee = v.c
            if !is_simple(callee) {
                // Evaluated once: a borrowed copy is enough for the call.
                callee = scalar(mut g, v.ty, callee)
            }
        }
        _ => {}
    }
    let mut b = strings.builder()
    strings.add(mut b, callee + ".fn(" + callee + ".env")
    for i in 0..len(args) {
        strings.add(mut b, ", ")
        strings.add(mut b, consume(mut g, expr(mut g, args[i])))
    }
    strings.add_byte(mut b, ')')
    let t = ty(g, e)
    if t == types.NOTHING() {
        emit(mut g, strings.build(b) + ";")
        return no_value()
    }
    return store(mut g, t, strings.build(b))
}

// `x?`: if x is an Err (or None), return it from the function now,
// releasing everything that is live, exactly as `return` does. Otherwise
// the value inside the Ok (or Some), borrowed from x.
fn try_value(g: mut Gen, e: ast.Expr, inner: ast.Expr) -> Value {
    let v = expr(mut g, inner)
    let t = ty(g, inner)
    let result = result_type(g)
    let ti = types.get(g.k.table, t)
    let mut fail = "None"
    let mut ok = "Some"
    if ti.name == "Result" {
        fail = "Err"
        ok = "Ok"
    }
    let r = c_type(g, result)
    open(mut g, "if (" + v.c + ".tag == " + layout.tag(g.l, t, fail) + ") {")
    let returned = new_temp(mut g)
    if fail == "Err" {
        // The error moves into the function's own Result type; it gets a
        // reference of its own, since x is released below.
        let err = payload(g, v.c, t, types.variant_index(g.k.table, t, "Err"), 0)
        emit(mut g, retain(mut g, ti.args[1], err))
        emit(mut g, r + " " + returned + " = (" + r + "){ .tag = " + layout.tag(g.l, result, "Err") +
            ", .as.m_Err = { ._0 = " + err + " } };")
    } else {
        emit(mut g, r + " " + returned + " = (" + r + "){ .tag = " + layout.tag(g.l, result, "None") + " };")
    }
    ensures_code(mut g, returned)
    release_until(mut g, "")
    emit(mut g, "return " + returned + ";")
    close(mut g, "}")
    return value(payload(g, v.c, t, types.variant_index(g.k.table, t, ok), 0), ty(g, e))
}

// Reading `xs[i]`, `s[i]` or `m[k]`: the element is copied into a
// temporary, borrowed (it still belongs to the container).
fn index(g: mut Gen, e: ast.Expr, obj: ast.Expr, i: ast.Expr) -> Value {
    let o = expr(mut g, obj).c
    let t = ty(g, obj)
    if t == types.STR() {
        let ix = expr(mut g, i).c
        if maps.has(g.env.safe, e.id) && g.env.safe[e.id] {
            return value(scalar(mut g, types.BYTE(), o + ".data[" + ix + "]"), types.BYTE())
        }
        return value(scalar(mut g, types.BYTE(), "vela_byte_at(" + o + ", " + ix + ", " + loc_of(g, e) + ")"), types.BYTE())
    }
    let elem = c_type(g, ty(g, e))
    let temp = new_temp(mut g)
    if types.is_map(g.k.table, t) {
        let key = expr(mut g, i).c
        let k = c_type(g, types.get(g.k.table, t).args[0])
        let ka = addr(mut g, k, key)
        emit(mut g, elem + " " + temp + " = *(" + elem + " *)vela_map_at(" + o + ", " + ka + ", " + loc_of(g, e) + ");")
    } else {
        let ix = expr(mut g, i).c
        let address = element_address(g, e, elem, o, ix, loc_of(g, e))  // before emit, as in assign
        emit(mut g, elem + " " + temp + " = *" + address + ";")
    }
    return value(temp, ty(g, e))
}

// `(t_Expr){ .tag = ..., .as.m_Add = { ._0 = ..., ._1 = ... } }`, owned.
// `args` are already consumed.
fn enum_value(g: mut Gen, enum: Int, vi: Int, args: [Str]) -> Value {
    let v = types.get(g.k.table, enum).variants[vi]
    let mut fields = ".tag = " + layout.tag(g.l, enum, v.name)
    if len(args) > 0 {
        let mut values = strings.builder()
        for i in 0..len(args) {
            if i >= len(v.payload) {
                break
            }
            let mut arg = args[i]
            if layout.is_boxed(g.l, enum, v.name, i) {
                arg = layout.box_name(g.l, v.payload[i]) + "_new(" + arg + ")"
            }
            if i > 0 {
                strings.add(mut values, ", ")
            }
            strings.add(mut values, "._" + strings.from_int(i) + " = " + arg)
        }
        fields = fields + ", .as.m_" + v.name + " = { " + strings.build(values) + " }"
    }
    return store(mut g, enum, "(" + c_type(g, enum) + "){ " + fields + " }")
}

fn struct_value(g: mut Gen, t: Int, fields: [ast.FieldInit]) -> Value {
    let mut values: Map[Str, Str] = [:]
    for f in fields {  // in source order: evaluation is left to right
        let mut c = consume(mut g, expr(mut g, f.value))
        if layout.is_boxed(g.l, t, f.name, 0) {
            let ft = types.get(g.k.table, t).fields[types.field_index(g.k.table, t, f.name)].ty
            c = layout.box_name(g.l, ft) + "_new(" + c + ")"
        }
        values[f.name] = c
    }
    let mut inits = strings.builder()
    let decl = types.get(g.k.table, t).fields
    for i in 0..len(decl) {
        if i > 0 {
            strings.add(mut inits, ", ")
        }
        strings.add(mut inits, ".m_" + decl[i].name + " = " + values[decl[i].name])
    }
    return store(mut g, t, "(" + c_type(g, t) + "){ " + strings.build(inits) + " }")
}

fn arith_name(op: Str) -> Str {
    return match op {
        "+" => "add"
        "-" => "sub"
        "*" => "mul"
        "/" => "div"
        _ => "rem"
    }
}

fn binary(g: mut Gen, e: ast.Expr, op: Str, l: ast.Expr, r: ast.Expr) -> Value {
    match g.k.refs[e.id] {
        checker.Ref.Method(t, name) => {
            let v = method_value(mut g, e, [l, r], sub(g, t), name)
            if name == "eq" {
                if op == "!=" { return value(scalar(mut g, types.BOOL(), "(!" + v.c + ")"), types.BOOL()) }
                return v
            }
            return value(scalar(mut g, types.BOOL(), "(" + v.c + " " + op + " 0)"), types.BOOL())
        }
        _ => {}
    }

    if op == "&&" || op == "||" {
        // Short-circuit: the right side runs only if it can change the
        // answer, so its code goes inside an `if`, in a frame of its own.
        let result = scalar(mut g, types.BOOL(), expr(mut g, l).c)
        let mut negate = ""
        if op == "||" {
            negate = "!"
        }
        open(mut g, "if (" + negate + result + ") {")
        push_frame(mut g, "branch")
        let right = expr(mut g, r).c
        emit(mut g, result + " = " + right + ";")
        pop_frame(mut g)
        close(mut g, "}")
        return value(result, types.BOOL())
    }
    let first = expr(mut g, l)
    let mut left = first.c
    if cffi.pointer(first.ty) || types.is_integer(first.ty) || first.ty == types.FLOAT() || first.ty == types.BOOL() || first.ty == types.UNIT() {
        left = scalar(mut g, first.ty, left)  // snapshot before the right side can mutate a local
    }
    let right = expr(mut g, r).c
    return operation(mut g, e, op, left, right, ty(g, l))
}

// `left op right`, for operands already worked out, of type `operand`.
fn operation(g: mut Gen, e: ast.Expr, op: Str, left: Str, right: Str, operand: Int) -> Value {
    if op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" {
        return fixed_operation(mut g, e, operand, left, right, integers.operation(op), 0)
    }
    if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" {
        if operand == types.FLOAT() {
            // IEEE arithmetic: no overflow checks, and x / 0.0 is an infinity.
            return value(scalar(mut g, operand, "(" + left + " " + op + " " + right + ")"), operand)
        }
        if operand == types.STR() {
            return store(mut g, types.STR(), "vela_str_concat(" + left + ", " + right + ")")
        }
        if types.is_integer(operand) && ranges.cannot_fail(g.k, g.env, e) {
            return value(scalar(mut g, operand, "(" + left + " " + op + " " + right + ")"), operand)
        }
        if types.is_integer(operand) && operand != types.INT() && operand != types.BYTE() {
            return fixed_operation(mut g, e, operand, left, right, integers.operation(arith_name(op)), 0)
        }
        let mut prefix = "vela_"
        if operand == types.BYTE() {
            prefix = "vela_byte_"
        }
        let t = ty(g, e)
        if operand == types.INT() && ranges.cannot_fail(g.k, g.env, e) {
            // Proved unable to overflow or divide by zero (M18): plain C.
            return value(scalar(mut g, t, "(" + left + " " + op + " " + right + ")"), t)
        }
        return value(scalar(mut g, t, prefix + arith_name(op) + "(" + left + ", " + right + ", " + loc_of(g, e) + ")"), t)
    }
    if operand == types.STR() && (op == "==" || op == "!=") {
        let mut negate = ""
        if op == "!=" {
            negate = "!"
        }
        return value(scalar(mut g, types.BOOL(), negate + "vela_str_eq(" + left + ", " + right + ")"), types.BOOL())
    }
    if operand == types.STR() {
        return value(scalar(mut g, types.BOOL(), "vela_str_cmp(" + left + ", " + right + ") " + op + " 0"), types.BOOL())
    }
    if types.is_enum(g.k.table, operand) {
        return value(scalar(mut g, types.BOOL(), left + ".tag " + op + " " + right + ".tag"), types.BOOL())
    }
    return value(scalar(mut g, types.BOOL(), left + " " + op + " " + right), types.BOOL())
}

fn print_function(t: Int) -> Str {
    if t == 13 { return "vela_print_uint" }
    if t == types.BOOL() {
        return "vela_print_bool"
    }
    if t == types.FLOAT() {
        return "vela_print_float"
    }
    if t == types.STR() {
        return "vela_print_str"
    }
    return "vela_print_int"  // Int and Byte
}

fn mut_place(e: ast.Expr) -> ast.Expr {
    return match e.kind {
        ast.ExprKind.MutArg(p) => p
        _ => e
    }
}

// `assert(cond)`: a panic if cond is false. When cond compares two values
// that can be printed, the message shows both.
// `kind` names the check in the panic: "assertion", "requires of 'f'"...
fn assert_code(g: mut Gen, e: ast.Expr, cond: ast.Expr, kind: Str) {
    let what = c_string(kind)
    let text = c_string(ast.expr_text(cond))
    match cond.kind {
        ast.ExprKind.Binary(op, l, r) => {
            let t = ty(g, l)
            let comparison = op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">="
            let printable = types.is_integer(t) || t == types.BOOL() || t == types.STR() ||
                t == types.FLOAT()
            if comparison && printable {
                let left = expr(mut g, l).c
                let right = expr(mut g, r).c
                let ok = operation(mut g, cond, op, left, right, t).c
                let mut quote = "false"
                if t == types.STR() {
                    quote = "true"
                }
                open(mut g, "if (!" + ok + ") {")
                emit(mut g, "vela_assert_failed_values(" + loc_of(g, e) + ", " + what + ", " + text + ", " + shown(t, left) + ", " +
                    shown(t, right) + ", " + quote + ");")
                close(mut g, "}")
                return
            }
        }
        _ => {}
    }
    let c = expr(mut g, cond).c
    emit(mut g, "if (!" + c + ") vela_assert_failed(" + loc_of(g, e) + ", " + what + ", " + text + ");")
}

// A value of a printable type as a Str, for an assertion's message.
fn shown(t: Int, c: Str) -> Str {
    if t == 13 { return "vela_from_uint(" + c + ")" }
    if t == types.STR() {
        return c
    }
    if t == types.BOOL() {
        return "(" + c + " ? VELA_STR(\"true\", 4) : VELA_STR(\"false\", 5))"
    }
    if t == types.FLOAT() {
        return "vela_from_float(" + c + ")"
    }
    return "vela_from_int((int64_t)" + c + ")"
}

fn builtin(g: mut Gen, e: ast.Expr, name: Str, args: [ast.Expr]) -> Value {
    if len(name) > 6 && (name[0..6] == "sysio." || name[0..6] == "clock.") { return system_builtin(mut g, e, name[6..len(name)], args) }
    if len(name) > 7 && name[0..7] == "memory." { return memory_builtin(mut g, e, name[7..len(name)], args) }
    if len(name) > 2 && name[0..2] == "c." { return c_builtin(mut g, e, name[2..len(name)], args) }
    let t = ty(g, e)
    if integers.type_id(name) >= 0 || len(name) > 5 && name[0..5] == "ints." {
        return integer_builtin(mut g, e, name, args)
    }
    if name == "tasks.map" || name == "tasks.each" {
        return tasks_call(mut g, name, args, t)
    }
    if name == "tasks.workers" {
        return value(scalar(mut g, types.INT(), "vela_tasks_workers()"), types.INT())
    }
    if name == "math.sqrt" {
        let x = expr(mut g, args[0]).c
        return value(scalar(mut g, types.FLOAT(), "vela_sqrt(" + x + ")"), types.FLOAT())
    }
    if name == "assert" {
        assert_code(mut g, e, args[0], "assertion")
        return no_value()
    }
    if name == "print" || name == "os.eprint" {
        let arg = expr(mut g, args[0])
        let mut func = print_function(arg.ty)
        if name == "os.eprint" {
            func = "vela_eprint" + func[10..len(func)]
        }
        emit(mut g, func + "(" + arg.c + ");")
        return no_value()
    }
    if name == "os.args" || name == "os.executable" || name == "strings.build" || name == "strings.from_int" || name == "strings.from_float" {
        let mut cs = strings.builder()
        for i in 0..len(args) {
            if i > 0 {
                strings.add(mut cs, ", ")
            }
            strings.add(mut cs, expr(mut g, args[i]).c)
        }
        let func = match name {
            "os.args" => "vela_os_args"
            "os.executable" => "vela_os_executable"
            "strings.build" => "vela_builder_build"
            "strings.from_float" => "vela_from_float"
            _ => "vela_from_int"
        }
        return store(mut g, t, func + "(" + strings.build(cs) + ")")
    }
    if name == "os.read" {
        let n = expr(mut g, args[0]).c
        return store(mut g, t, "vela_os_read(" + n + ", " + loc_of(g, e) + ")")
    }
    if name == "os.write" {
        emit(mut g, "vela_os_write(" + expr(mut g, args[0]).c + ");")
        return no_value()
    }
    if name == "os.exit" {
        let code = expr(mut g, args[0]).c
        emit(mut g, "vela_os_exit(" + code + ", " + loc_of(g, e) + ");")
        return no_value()
    }
    if name == "strings.builder" {
        return store(mut g, t, "vela_array_new(&vela_type_byte, 64)")  // room for a line without growing
    }
    if name == "strings.add" || name == "strings.add_byte" || name == "strings.add_int" {
        let v = expr(mut g, args[1]).c  // the value first, then the place, as for any mut argument
        let b = writable(mut g, mut_place(args[0]))
        if name == "strings.add_byte" {
            let a = addr(mut g, "uint8_t", v)
            emit(mut g, "vela_push(" + b + ", " + a + ", 1);")
        } else {
            emit(mut g, "vela_builder_" + name[8..len(name)] + "(" + b + ", " + v + ");")
        }
        return no_value()
    }
    if name == "files.read" || name == "files.write" || name == "files.remove" || name == "files.temp_dir" ||
        name == "os.run" || name == "os.output" {
        return file_call(mut g, e, name, args)
    }
    if name == "os.env" || name == "os.read_line" || name == "strings.parse_float" {
        let mut call = "vela_os_read_line("
        if name == "os.env" {
            call = "vela_os_env(" + expr(mut g, args[0]).c + ", "
        } else if name == "strings.parse_float" {
            call = "vela_parse_float(" + expr(mut g, args[0]).c + ", "
        }
        let text = new_temp(mut g)
        let ok = new_temp(mut g)
        if name == "strings.parse_float" {
            emit(mut g, "double " + text + " = 0;")
        } else {
            emit(mut g, "vela_str " + text + " = VELA_STR(\"\", 0);")
        }
        emit(mut g, "bool " + ok + " = " + call + "&" + text + ");")
        let opt = c_type(g, t)
        let some = "(" + opt + "){ .tag = " + layout.tag(g.l, t, "Some") + ", .as.m_Some = { ._0 = " + text + " } }"
        let none = "(" + opt + "){ .tag = " + layout.tag(g.l, t, "None") + " }"
        return store(mut g, t, ok + " ? " + some + " : " + none)
    }
    if name == "len" {
        let arg = expr(mut g, args[0])
        let mut length = arg.c + "->len"
        if arg.ty == types.STR() {
            length = arg.c + ".len"
        }
        if types.is_fixed(g.k.table, arg.ty) { length = strings.from_int(types.get(g.k.table, arg.ty).length) }
        return value(scalar(mut g, types.INT(), length), types.INT())
    }
    if name == "int" {
        let arg = expr(mut g, args[0])
        if arg.ty == types.FLOAT() {
            return value(scalar(mut g, types.INT(), "vela_float_to_int(" + arg.c + ", " + loc_of(g, e) + ")"), types.INT())
        }
        if arg.ty == 13 { return integer_cast(mut g, e, arg, types.INT()) }
        return value(scalar(mut g, types.INT(), "(int64_t)" + arg.c), types.INT())
    }
    if name == "float" {
        let c = expr(mut g, args[0]).c
        return value(scalar(mut g, types.FLOAT(), "(double)" + c), types.FLOAT())
    }
    if name == "byte" {
        if ty(g, args[0]) != types.INT() { return integer_cast(mut g, e, expr(mut g, args[0]), types.BYTE()) }
        let c = expr(mut g, args[0]).c
        return value(scalar(mut g, types.BYTE(), "vela_to_byte(" + c + ", " + loc_of(g, e) + ")"), types.BYTE())
    }
    if name == "push" {
        let v = consume(mut g, expr(mut g, args[1]))
        let array = writable(mut g, mut_place(args[0]))
        let elem = c_type(g, types.get(g.k.table, ty(g, args[0])).args[0])
        let a = addr(mut g, elem, v)
        emit(mut g, "vela_push(" + array + ", " + a + ", sizeof(" + elem + "));")
        return no_value()
    }
    let mt = ty(g, args[0])
    let mti = types.get(g.k.table, mt)
    let k = c_type(g, mti.args[0])
    if name == "maps.remove" {
        let key = expr(mut g, args[1]).c
        let m = writable(mut g, mut_place(args[0]))
        let ka = addr(mut g, k, key)
        emit(mut g, "(void)vela_map_remove(" + m + ", " + ka + ");")
        return no_value()
    }
    let m = expr(mut g, args[0]).c
    if name == "maps.keys" {
        return store(mut g, t, "vela_map_keys(" + m + ")")
    }
    let key = expr(mut g, args[1]).c
    let found = new_temp(mut g)
    let vt = c_type(g, mti.args[1])
    let ka = addr(mut g, k, key)
    let ml = match args[0].kind {
        ast.ExprKind.Name(_) => local_of(g, args[0].id)
        _ => -1
    }
    if ml >= 0 && unchanging(g, args[1]) {
        // Remembered for a write of the same key that may follow.
        let hash = new_temp(mut g)
        let looked_in = new_temp(mut g)
        emit(mut g, "uint64_t " + hash + ";")
        emit(mut g, vt + " *" + found + " = vela_map_find_hashed(" + m + ", " + ka + ", &" + hash + ");")
        emit(mut g, "vela_map *" + looked_in + " = " + m + ";")
        forget_found(mut g, args[0])
        push(mut g.found, Found {
            map: ml, key: local_of(g, args[1].id), depth: g.depth, slot: found, hash: hash, looked_in: looked_in,
        })
    } else {
        emit(mut g, vt + " *" + found + " = vela_map_find(" + m + ", " + ka + ");")
    }
    if name == "maps.has" {
        return value(scalar(mut g, types.BOOL(), found + " != NULL"), types.BOOL())
    }
    // get: Some(a copy of the value), or None.
    let opt = c_type(g, t)
    let result = new_temp(mut g)
    emit(mut g, opt + " " + result + ";")
    open(mut g, "if (" + found + ") {")
    emit(mut g, result + " = (" + opt + "){ .tag = " + layout.tag(g.l, t, "Some") + ", .as.m_Some = { ._0 = *" + found + " } };")
    emit(mut g, retain(mut g, mti.args[1], result + ".as.m_Some._0"))
    close(mut g, "} else {")
    g.depth = g.depth + 1
    emit(mut g, result + " = (" + opt + "){ .tag = " + layout.tag(g.l, t, "None") + " };")
    close(mut g, "}")
    return own(mut g, result, t)
}

// files.read, files.write, files.remove, files.temp_dir and os.run: the
// runtime reports success with a bool and fills in the result or the error
// message; this builds the Result.
fn file_call(g: mut Gen, e: ast.Expr, name: Str, args: [ast.Expr]) -> Value {
    let mut cs: [Str] = []
    for a in args {
        push(mut cs, expr(mut g, a).c)
    }
    let r = ty(g, e)
    let text = new_temp(mut g)  // the contents, or the error message
    let ok = new_temp(mut g)
    emit(mut g, "vela_str " + text + " = VELA_STR(\"\", 0);")
    let mut success = text
    if name == "files.read" {
        emit(mut g, "bool " + ok + " = vela_files_read(" + cs[0] + ", &" + text + ");")
    } else if name == "files.write" {
        emit(mut g, "bool " + ok + " = vela_files_write(" + cs[0] + ", " + cs[1] + ", &" + text + ");")
        success = cs[1] + ".len"
    } else if name == "files.remove" {
        emit(mut g, "bool " + ok + " = vela_files_remove(" + cs[0] + ", &" + text + ");")
        success = "0"
    } else if name == "files.temp_dir" {
        emit(mut g, "bool " + ok + " = vela_files_temp_dir(&" + text + ");")
    } else if name == "os.output" {
        emit(mut g, "bool " + ok + " = vela_os_output(" + cs[0] + ", &" + text + ");")
    } else {
        let code = new_temp(mut g)
        emit(mut g, "int64_t " + code + " = 0;")
        emit(mut g, "bool " + ok + " = vela_os_run(" + cs[0] + ", &" + code + ", &" + text + ");")
        success = code
    }
    let rt = c_type(g, r)
    let ok_value = "(" + rt + "){ .tag = " + layout.tag(g.l, r, "Ok") + ", .as.m_Ok = { ._0 = " + success + " } }"
    let err_value = "(" + rt + "){ .tag = " + layout.tag(g.l, r, "Err") + ", .as.m_Err = { ._0 = " + text + " } }"
    return store(mut g, r, ok + " ? " + ok_value + " : " + err_value)
}

fn unary_integer_op(op: Str) -> Int {
    if op == "-" { return 5 }
    return 9
}

fn integer_literal(bits: Int, t: Int) -> Str {
    if bits == integers.min(types.INT()) && t != 13 { return "(-INT64_C(9223372036854775807) - 1)" }
    if t == 13 { return "UINT64_C(" + integers.unsigned_text(bits) + ")" }
    return strings.from_int(bits)
}

fn fixed_signed(t: Int) -> Str {
    if types.integer_signed(t) { return "true" }
    return "false"
}

fn fixed_decoded(g: Gen, t: Int, raw: Str) -> Str {
    let ct = c_type(g, t)
    if types.integer_signed(t) { return "(" + ct + ")vela_fixed_signed(" + raw + ", " + strings.from_int(types.integer_width(t)) + ")" }
    return "(" + ct + ")(" + raw + ")"
}

fn fixed_operation(g: mut Gen, e: ast.Expr, t: Int, a: Str, b: Str, op: Int, mode: Int) -> Value {
    let raw = "vela_fixed_inline((uint64_t)(" + a + "), (uint64_t)(" + b + "), " + strings.from_int(types.integer_width(t)) +
        ", " + fixed_signed(t) + ", " + strings.from_int(op) + ", " + strings.from_int(mode) + ", " + loc_of(g, e) + ", NULL)"
    return value(scalar(mut g, t, fixed_decoded(g, t, raw)), t)
}

fn integer_cast(g: mut Gen, e: ast.Expr, source: Value, t: Int) -> Value {
    let raw = "vela_fixed_cast_inline((uint64_t)(" + source.c + "), " + strings.from_int(types.integer_width(source.ty)) +
        ", " + fixed_signed(source.ty) + ", " + strings.from_int(types.integer_width(t)) + ", " + fixed_signed(t) + ", " + loc_of(g, e) + ")"
    return value(scalar(mut g, t, fixed_decoded(g, t, raw)), t)
}

fn integer_builtin(g: mut Gen, e: ast.Expr, name: Str, args: [ast.Expr]) -> Value {
    let target = integers.type_id(name)
    let first = expr(mut g, args[0])
    if target >= 0 { return integer_cast(mut g, e, first, target) }
    let short = name[5..len(name)]
    let t = first.ty
    if short == "to_str" {
        let mut func = "vela_from_int"
        if t == 13 { func = "vela_from_uint" }
        return store(mut g, types.STR(), func + "(" + first.c + ")")
    }
    let left = scalar(mut g, t, first.c)  // arguments are read before later mutable arguments
    let mut second = "0"
    if len(args) == 2 { second = expr(mut g, args[1]).c }
    let op = integers.function_op(short)
    let mode = integers.mode(short)
    if mode != 1 { return fixed_operation(mut g, e, t, left, second, op, mode) }
    let ok = new_temp(mut g)
    let raw = new_temp(mut g)
    emit(mut g, "bool " + ok + " = false;")
    emit(mut g, "uint64_t " + raw + " = vela_fixed_inline((uint64_t)(" + left + "), (uint64_t)(" + second + "), " +
        strings.from_int(types.integer_width(t)) + ", " + fixed_signed(t) + ", " + strings.from_int(op) + ", 1, " + loc_of(g, e) + ", &" + ok + ");")
    let result = ty(g, e)
    let ct = c_type(g, result)
    let some = "(" + ct + "){ .tag = " + layout.tag(g.l, result, "Some") + ", .as.m_Some = { ._0 = " + fixed_decoded(g, t, raw) + " } }"
    let none = "(" + ct + "){ .tag = " + layout.tag(g.l, result, "None") + " }"
    return store(mut g, result, ok + " ? " + some + " : " + none)
}

fn method_value(g: mut Gen, e: ast.Expr, args: [ast.Expr], t: Int, name: Str) -> Value {
    let mut dispatch = checker.method(g.k, t, name)
    if dispatch.fn_id >= 0 {
        let written = g.k.targs[e.id]
        if len(written) > 0 && len(written) == len(dispatch.args) {
            for i in 0..len(written) { dispatch.args[i] = sub(g, written[i]) }
        }
        let saved = g.k.refs[e.id]
        let saved_args = g.k.targs[e.id]
        let saved_type = g.k.ty[e.id]
        g.k.refs[e.id] = checker.Ref.Function(dispatch.fn_id)
        g.k.targs[e.id] = dispatch.args
        g.k.ty[e.id] = types.find_subst(g.k.table, g.k.fns[dispatch.fn_id].result, g.k.fns[dispatch.fn_id].type_params, dispatch.args)
        let out = call_value(mut g, e, args)
        g.k.refs[e.id] = saved
        g.k.targs[e.id] = saved_args
        g.k.ty[e.id] = saved_type
        g.unique = []
        g.found = []
        return out
    }
    let first = expr(mut g, args[0])
    let left = scalar(mut g, t, first.c)
    if name == "hash" {
        return value(scalar(mut g, 13, "vela_hash_value(" + layout.descriptor(g.l, t) + ", &" + left + ")"), 13)
    }
    let right = expr(mut g, args[1]).c
    let equal = operation(mut g, e, "==", left, right, t)
    if name == "eq" { return equal }
    let less = operation(mut g, e, "<", left, right, t)
    return value(scalar(mut g, types.INT(), "(" + equal.c + " ? 0 : (" + less.c + " ? -1 : 1))"), types.INT())
}

fn dispatch_name(k: checker.Checked, names: Map[Str, Str], dispatch: checker.Dispatch) -> Str {
    if len(dispatch.args) == 0 { return fn_name(k, dispatch.fn_id) }
    return names[mono.key(dispatch.fn_id, dispatch.args)]
}

// ---- The C ABI ----
pub fn foreign_name(k: checker.Checked, id: Int) -> Str {
    return "vf_" + strings.from_int(id) + "_" + layout.mangle(k.modules[k.fns[id].module].name, k.fns[id].decl.name)
}
pub fn abi_float32(t: ast.TypeName) -> Bool { return t.module == "c" && t.name == "Float" }
fn foreign_type(l: layout.Layout, t: Int, written: Option[ast.TypeName]) -> Str {
    match written { Some(tn) => { if abi_float32(tn) { return "float" } }, None => {} }
    return layout.c_type(l, t)
}
fn foreign_prototype(k: checker.Checked, l: layout.Layout, id: Int) -> Str {
    let f = k.fns[id]
    let mut params = ""
    for i in 0..len(f.params) {
        if i > 0 { params = params + ", " }
        params = params + foreign_type(l, f.params[i], Some(f.decl.params[i].ty))
        if f.mutable[i] { params = params + " *" }
    }
    if f.decl.variadic { params = params + ", ..." }
    if params == "" { params = "void" }
    return "extern " + foreign_type(l, f.result, f.decl.result) + " " + foreign_name(k, id) + "(" + params + ") __asm__(VELA_C_SYMBOL(" + c_string(f.decl.foreign) + "))"
}

fn foreign_call(g: mut Gen, e: ast.Expr, id: Int, args: [ast.Expr]) -> Value {
    let f = g.k.fns[id]
    let mut values: [Str] = []
    let mut after: [Str] = []
    for arg in args {
        match arg.kind {
            ast.ExprKind.MutArg(_) => push(mut values, "")
            _ => { let v = expr(mut g, arg); push(mut values, scalar(mut g, v.ty, v.c)) }
        }
    }
    for i in 0..len(args) {
        match args[i].kind {
            ast.ExprKind.MutArg(p) => {
                let address = new_temp(mut g)
                emit(mut g, c_type(g, ty(g, p)) + " *" + address + " = &(" + place(mut g, p) + ");")
                if abi_float32(f.decl.params[i].ty) {
                    let temporary = new_temp(mut g)
                    emit(mut g, "float " + temporary + " = (float)*" + address + ";")
                    values[i] = "&" + temporary
                    push(mut after, "*" + address + " = (double)" + temporary + ";")
                } else { values[i] = address }
            }
            _ => {}
        }
    }
    let mut call = foreign_name(g.k, id) + "("
    for i in 0..len(values) { if i > 0 { call = call + ", " }; call = call + values[i] }
    call = call + ")"
    let mut result = no_value()
    if f.result == types.NOTHING() { emit(mut g, call + ";") } else { result = store(mut g, ty(g, e), call) }
    for statement in after { emit(mut g, statement) }
    g.unique = []
    g.found = []
    return result
}

fn callback(g: mut Gen, id: Int) -> Value {
    let f = g.k.fns[id]
    if f.decl.foreign != "" { return value(scalar(mut g, cffi.FN(), "(vela_c_fn)&" + foreign_name(g.k, id)), cffi.FN()) }
    let name = "vcabi_" + strings.from_int(id)
    if !maps.has(g.wrappers, name) {
        let mut params = ""
        let mut args = ""
        for i in 0..len(f.params) {
            if i > 0 { params = params + ", "; args = args + ", " }
            let arg = "a" + strings.from_int(i)
            params = params + foreign_type(g.l, f.params[i], Some(f.decl.params[i].ty)) + " " + arg
            args = args + arg
        }
        if params == "" { params = "void" }
        let mut statement = fn_name(g.k, id) + "(" + args + ");"
        if f.result >= 0 { statement = "return " + statement }
        g.wrappers[name] = "static " + foreign_type(g.l, f.result, f.decl.result) + " " + name + "(" + params + ") { " + statement + " }"
    }
    return value(scalar(mut g, cffi.FN(), "(vela_c_fn)&" + name), cffi.FN())
}

fn c_builtin(g: mut Gen, e: ast.Expr, name: Str, args: [ast.Expr]) -> Value {
    let t = ty(g, e)
    if name == "null" { return value("NULL", cffi.PTR()) }
    if name == "null_fn" { return value("(vela_c_fn)0", cffi.FN()) }
    if name == "callback" {
        match g.k.refs[args[0].id] { checker.Ref.Function(id) => return callback(mut g, id), _ => return no_value() }
    }
    if name == "addr" { return value(scalar(mut g, t, "(void *)&(" + place(mut g, mut_place(args[0])) + ")"), t) }
    let first = expr(mut g, args[0])
    let a = scalar(mut g, first.ty, first.c)
    if name == "data" && types.is_array(g.k.table, first.ty) { return value(scalar(mut g, t, "(void *)" + a + "->data"), t) }
    let mut b = ""
    if len(args) > 1 { let v = expr(mut g, args[1]); b = scalar(mut g, v.ty, v.c) }
    let loc = loc_of(g, e)
    if name == "is_null" { return value(scalar(mut g, t, "(" + a + " == 0)"), t) }
    if name == "address" {
        let mut code = "(uint64_t)(uintptr_t)" + a
        if first.ty == cffi.FN() { code = "vela_c_fn_bits(" + a + ")" }
        return value(scalar(mut g, t, code), t)
    }
    if name == "from_address" { return value(scalar(mut g, t, "(void *)(uintptr_t)" + a), t) }
    let mut call = "vela_c_" + name + "(" + a
    if name == "load" {
        if t == types.FLOAT() { call = "vela_c_load_double(" + a + ", " + loc + ")" } else {
            let mut size = 8
            if types.is_integer(t) { size = types.integer_width(t) / 8 }
            if t == types.BOOL() { size = 1 }
            let raw = "vela_c_load(" + a + ", " + strings.from_int(size) + ", " + loc + ")"
            if t == cffi.PTR() { call = "(void *)(uintptr_t)" + raw } else if t == cffi.FN() { call = "vela_c_fn_from_bits(" + raw + ")" } else if t == types.BOOL() { call = "(" + raw + " != 0)" } else { call = fixed_decoded(g, t, raw) }
        }
    } else if name == "store" {
        let value_type = ty(g, args[1])
        if value_type == types.FLOAT() { call = "vela_c_store_double(" + a + ", " + b + ", " + loc + ")" } else {
            let mut size = 8
            let mut raw = "(uint64_t)(uintptr_t)" + b
            if types.is_integer(value_type) { size = types.integer_width(value_type) / 8 }
            if value_type == types.BOOL() { size = 1 }
            if value_type == cffi.FN() { raw = "vela_c_fn_bits(" + b + ")" }
            call = "vela_c_store(" + a + ", " + raw + ", " + strings.from_int(size) + ", " + loc + ")"
        }
    } else {
        if b != "" { call = call + ", " + b }
        if name == "alloc" || name == "cstr" || name == "string" || name == "bytes" || name == "load_float32" || name == "store_float32" { call = call + ", " + loc }
        call = call + ")"
    }
    if t == types.NOTHING() { emit(mut g, call + ";"); return no_value() }
    return store(mut g, t, call)
}

fn memory_builtin(g: mut Gen, e: ast.Expr, name: Str, args: [ast.Expr]) -> Value {
    let t = ty(g, e)
    let loc = loc_of(g, e)
    if name == "reserve" || name == "fill" {
        let elem = types.get(g.k.table, t).args[0]
        let size = scalar(mut g, types.INT(), expr(mut g, args[0]).c)
        let mut call = "vela_memory_reserve(" + layout.descriptor(g.l, elem) + ", " + size + ", " + loc + ")"
        if name == "fill" {
            let v = expr(mut g, args[1])
            let at = addr(mut g, c_type(g, elem), v.c)
            call = "vela_memory_fill(" + layout.descriptor(g.l, elem) + ", " + size + ", " + at + ", " + loc + ")"
        }
        return store(mut g, t, call)
    }
    if name == "truncate" || name == "write" {
        let mut values: [Str] = []
        for i in 1..len(args) { let v = expr(mut g, args[i]); push(mut values, scalar(mut g, v.ty, v.c)) }
        let array = writable(mut g, mut_place(args[0]))
        let mut call = "vela_memory_" + name + "(" + array
        for v in values { call = call + ", " + v }
        emit(mut g, call + ", " + loc + ");")
        g.cached = [:]
        g.unique = []
        g.found = []
        return no_value()
    }
    let first = expr(mut g, args[0])
    if name == "bits" { return value(scalar(mut g, t, "(uint64_t)" + first.c), t) }
    if name == "signed" {
        let a = scalar(mut g, 13, first.c)
        let width = scalar(mut g, types.INT(), expr(mut g, args[1]).c)
        return value(scalar(mut g, t, "vela_memory_signed(" + a + ", " + width + ", " + loc + ")"), t)
    }
    if name == "from_str" || name == "to_str" { return store(mut g, t, "vela_memory_" + name + "(" + first.c + ")") }
    // Pin the data before later offset/width expressions can mutate its owner.
    let data = store(mut g, first.ty, consume(mut g, first))
    let mut call = "vela_memory_read"
    if first.ty == types.STR() { call = call + "_str" }
    call = call + "(" + data.c
    for i in 1..len(args) { let v = expr(mut g, args[i]); call = call + ", " + scalar(mut g, v.ty, v.c) }
    return store(mut g, t, call + ", " + loc + ")")
}

fn system_builtin(g: mut Gen, e: ast.Expr, name: Str, args: [ast.Expr]) -> Value {
    let r = ty(g, e)
    let rt = c_type(g, r)
    let payload = types.get(g.k.table, r).args[0]
    let mut call = "vela_sys_" + name + "("
    for a in args { let v = expr(mut g, a); let pinned = store(mut g, v.ty, consume(mut g, v)); call = call + pinned.c + ", " }
    let output = new_temp(mut g)
    let error = new_temp(mut g)
    let ok = new_temp(mut g)
    emit(mut g, c_type(g, payload) + " " + output + " = {0};")
    emit(mut g, "vela_str " + error + " = VELA_STR(\"\", 0);")
    emit(mut g, "bool " + ok + " = " + call + "&" + output + ", &" + error + ");")
    let yes = "(" + rt + "){.tag = " + layout.tag(g.l, r, "Ok") + ", .as.m_Ok = {._0 = " + output + "}}"
    let no = "(" + rt + "){.tag = " + layout.tag(g.l, r, "Err") + ", .as.m_Err = {._0 = " + error + "}}"
    return store(mut g, r, ok + " ? " + yes + " : " + no)
}
