// Stage 1 C code generator: a port of stage0/codegen_c.py, which explains
// the scheme (one C statement per operation, owned and borrowed values,
// cleanup frames, copy-on-write). The C it writes is byte for byte Stage 0's.
import ast
import checker
import layout
import maps
import strings
import types

type Item = struct {
    c: Str
    ty: Int
}

// Values to release when a part of the program ends. kind is "function",
// "block", "body" (of a loop), "arm", "stmt" or "branch".
type Frame = struct {
    kind: Str
    items: [Item]
}

// The C expression for a value, and whether it holds a reference.
type Value = struct {
    c: Str
    ty: Int
    owned: Bool
    is_static: Bool  // a Str literal: never counted, so free to copy
}

type Gen = struct {
    k: checker.Checked
    l: layout.Layout
    filename: Str
    lines: [Str]
    depth: Int  // indentation level
    temps: Int
    names: Map[Int, Str]  // C names of locals, by local id
    used: Map[Str, Bool]
    frames: [Frame]
    dead: Bool  // true right after a return, break or continue
    current_fn: Int
}

// What a match does with an arm's body: run it, or store its value in a
// temporary.
type ArmCode = enum {
    Statements
    StoreIn(Str)
}

pub fn generate(k: checker.Checked) -> Str {
    let mut elements: [Int] = []
    for t in k.table.arrays {
        add_new(mut elements, t)
    }
    for t in k.table.maps {
        add_new(mut elements, t)
    }
    let mut l = layout.new_layout(k.table, k.decls, elements)
    let mut out = ["// Generated by the Vela compiler. Do not edit.", "#include \"vela_rt.h\"", ""]
    let defs = layout.definitions(mut l)
    if len(defs) > 0 {
        for line in defs {
            push(mut out, line)
        }
        push(mut out, "")
    }
    // Declare every function first, so each can call any other, in any order.
    let none: [Str] = []
    for id in 0..len(k.fns) {
        push(mut out, prototype(k, l, id, none) + ";")
    }
    for id in 0..len(k.fns) {
        let mut g = Gen {
            k: k, l: l, filename: k.modules[k.fns[id].module].path, lines: [], depth: 1, temps: 0, names: [:],
            used: [:], frames: [], dead: false, current_fn: id,
        }
        push(mut out, "")
        for line in function(mut g, id) {
            push(mut out, line)
        }
        l = g.l  // the layout remembers which types are managed
    }
    for line in ["", "int main(int argc, char **argv) {", "    vela_init(argc, argv);", "    f_main();",
                 "    return 0;", "}", ""] {
        push(mut out, line)
    }
    let mut b = strings.builder()
    for i in 0..len(out) {
        if i > 0 {
            strings.add_byte(mut b, '\n')
        }
        strings.add(mut b, out[i])
    }
    return strings.build(b)
}

fn add_new(xs: mut [Int], x: Int) {
    for y in xs {
        if y == x {
            return
        }
    }
    push(mut xs, x)
}

fn fn_name(k: checker.Checked, id: Int) -> Str {
    let f = k.fns[id]
    return "f_" + layout.mangle(k.modules[f.module].name, f.decl.name)
}

// `int64_t f_fib(int64_t v_n)`, or with no names, `int64_t f_fib(int64_t)`.
fn prototype(k: checker.Checked, l: layout.Layout, id: Int, names: [Str]) -> Str {
    let f = k.fns[id]
    let mut params = strings.builder()
    for i in 0..len(f.params) {
        if i > 0 {
            strings.add(mut params, ", ")
        }
        strings.add(mut params, layout.c_type(l, f.params[i]))
        if f.mutable[i] {
            strings.add(mut params, " *")
        }
        if len(names) > 0 {
            strings.add(mut params, " " + names[i])
        }
    }
    let mut list = strings.build(params)
    if list == "" {
        list = "void"
    }
    return layout.c_type(l, f.result) + " " + fn_name(k, id) + "(" + list + ")"
}

// A C string literal for any bytes: a file name or a Vela string.
pub fn c_string(data: Str) -> Str {
    let mut b = strings.builder()
    strings.add_byte(mut b, '"')
    for c in data {
        if c == '"' || c == '\\' || c == '?' {
            // `?` too: with -std=c11, `??/` and friends are trigraphs.
            strings.add_byte(mut b, '\\')
            strings.add_byte(mut b, c)
        } else if c >= 32 && c < 127 {
            strings.add_byte(mut b, c)
        } else {
            let n = int(c)
            strings.add_byte(mut b, '\\')  // octal escapes stop after 3 digits
            strings.add_byte(mut b, byte(48 + n / 64))
            strings.add_byte(mut b, byte(48 + n / 8 % 8))
            strings.add_byte(mut b, byte(48 + n % 8))
        }
    }
    strings.add_byte(mut b, '"')
    return strings.build(b)
}

// ---- Output ----

fn emit(g: mut Gen, line: Str) {
    if line == "" {
        return  // a retain or release of a value that needs none
    }
    let mut b = strings.builder()
    for _ in 0..g.depth {
        strings.add(mut b, "    ")
    }
    strings.add(mut b, line)
    push(mut g.lines, strings.build(b))
}

// Emit a line ending in `{` and indent.
fn open(g: mut Gen, line: Str) {
    emit(mut g, line)
    g.depth = g.depth + 1
}

// Dedent and emit a line starting with `}`.
fn close(g: mut Gen, line: Str) {
    g.depth = g.depth - 1
    emit(mut g, line)
    g.dead = false
}

fn new_temp(g: mut Gen) -> Str {
    g.temps = g.temps + 1
    return "_t" + strings.from_int(g.temps)
}

fn c_type(g: Gen, t: Int) -> Str {
    return layout.c_type(g.l, t)
}

fn managed(g: mut Gen, t: Int) -> Bool {
    return layout.managed(mut g.l, t)
}

fn retain(g: mut Gen, t: Int, c: Str) -> Str {
    return layout.retain(mut g.l, t, c)
}

fn release(g: mut Gen, t: Int, c: Str) -> Str {
    return layout.release(mut g.l, t, c)
}

fn loc(g: Gen, line: Int, col: Int) -> Str {
    return c_string(g.filename + ":" + strings.from_int(line) + ":" + strings.from_int(col))
}

fn loc_of(g: Gen, e: ast.Expr) -> Str {
    return loc(g, e.line, e.col)
}

fn ty(g: Gen, e: ast.Expr) -> Int {
    return g.k.ty[e.id]
}

// The C name of a local: `v_x`, or `v_x_2` for a second `x`, and `(*v_x)`
// for a mut parameter, which is a pointer to the caller's value.
fn local(g: mut Gen, id: Int) -> Str {
    let name = c_name(mut g, id)
    if g.k.locals[id].kind == "mut parameter" {
        return "(*" + name + ")"
    }
    return name
}

fn c_name(g: mut Gen, id: Int) -> Str {
    match maps.get(g.names, id) {
        Some(n) => return n
        None => {}
    }
    let base = "v_" + g.k.locals[id].name
    let mut name = base
    let mut n = 2
    for maps.has(g.used, name) {
        name = base + "_" + strings.from_int(n)
        n = n + 1
    }
    g.used[name] = true
    g.names[id] = name
    return name
}

fn local_of(g: Gen, id: Int) -> Int {
    return match g.k.refs[id] {
        checker.Ref.Local(l) => l
        _ => -1
    }
}

// ---- Ownership ----

fn push_frame(g: mut Gen, kind: Str) {
    push(mut g.frames, Frame { kind: kind, items: [] })
}

fn pop_frame(g: mut Gen) {
    let frame = g.frames[len(g.frames) - 1]
    g.frames = g.frames[0..len(g.frames) - 1]
    if !g.dead {
        release_frame(mut g, frame)
    }
}

fn release_frame(g: mut Gen, frame: Frame) {
    let mut i = len(frame.items) - 1
    for i >= 0 {
        let item = frame.items[i]
        emit(mut g, release(mut g, item.ty, item.c))
        i = i - 1
    }
}

fn value(c: Str, t: Int) -> Value {
    return Value { c: c, ty: t, owned: false, is_static: false }
}

fn no_value() -> Value {
    return value("", types.NOTHING())
}

// Record a new owned temporary in the innermost frame.
fn own(g: mut Gen, c: Str, t: Int) -> Value {
    if managed(mut g, t) {
        push(mut g.frames[len(g.frames) - 1].items, Item { c: c, ty: t })
    }
    return Value { c: c, ty: t, owned: true, is_static: false }
}

// Put an expression's value in a fresh temporary, owned.
fn store(g: mut Gen, t: Int, c_expr: Str) -> Value {
    let temp = new_temp(mut g)
    emit(mut g, c_type(g, t) + " " + temp + " = " + c_expr + ";")
    return own(mut g, temp, t)
}

// A temporary for a value with no references (Int, Bool, Byte...).
fn scalar(g: mut Gen, t: Int, c_expr: Str) -> Str {
    let temp = new_temp(mut g)
    emit(mut g, c_type(g, t) + " " + temp + " = " + c_expr + ";")
    return temp
}

// The address of a copy of `value`, for runtime functions that take an
// element by pointer.
fn addr(g: mut Gen, c_ty: Str, v: Str) -> Str {
    let temp = new_temp(mut g)
    emit(mut g, c_ty + " " + temp + " = " + v + ";")
    return "&" + temp
}

fn is_word(c: Byte) -> Bool {
    return c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '_'
}

// A C variable or temporary (`v_x`, `_t3`), not a path into one.
fn is_simple(c: Str) -> Bool {
    if len(c) > 2 && c[0..2] == "v_" {
        for ch in c[2..len(c)] {
            if !is_word(ch) {
                return false
            }
        }
        return true
    }
    if len(c) > 2 && c[0..2] == "_t" {
        for ch in c[2..len(c)] {
            if ch < '0' || ch > '9' {
                return false
            }
        }
        return true
    }
    return false
}

// Take ownership of a value; returns a C expression for it.
fn consume(g: mut Gen, v: Value) -> Str {
    if !managed(mut g, v.ty) || v.is_static {
        return v.c
    }
    if v.owned {
        let mut f = len(g.frames) - 1
        for f >= 0 {
            let items = g.frames[f].items
            for i in 0..len(items) {
                if items[i].c == v.c && items[i].ty == v.ty {
                    let mut kept = items[0..i]
                    for rest in items[i + 1..len(items)] {
                        push(mut kept, rest)
                    }
                    g.frames[f].items = kept
                    return v.c
                }
            }
            f = f - 1
        }
        return v.c
    }
    let mut c = v.c
    if !is_simple(c) {
        // Copy a field or element path into a temporary first, so later
        // changes to where it came from cannot change the copy.
        let temp = new_temp(mut g)
        emit(mut g, c_type(g, v.ty) + " " + temp + " = " + c + ";")
        c = temp
    }
    emit(mut g, retain(mut g, v.ty, c))
    return c
}

fn is_scope(kind: Str) -> Bool {
    return kind == "function" || kind == "block" || kind == "body" || kind == "arm"
}

// Declare a local holding an owned value, released when its scope ends.
fn declare(g: mut Gen, id: Int, v: Str) -> Str {
    let name = local(mut g, id)
    let t = g.k.locals[id].ty
    emit(mut g, c_type(g, t) + " " + name + " = " + v + ";")
    if managed(mut g, t) {
        let mut f = len(g.frames) - 1
        for !is_scope(g.frames[f].kind) {
            f = f - 1
        }
        push(mut g.frames[f].items, Item { c: name, ty: t })
    }
    return name
}

// Release every frame up to and including the innermost one of kind
// `stop` (for break and continue), or every frame ("", for return).
fn release_until(g: mut Gen, stop: Str) {
    let mut f = len(g.frames) - 1
    for f >= 0 {
        let frame = g.frames[f]
        release_frame(mut g, frame)
        if frame.kind == stop {
            break
        }
        f = f - 1
    }
}

// ---- Functions and statements ----

fn function(g: mut Gen, id: Int) -> [Str] {
    let f = g.k.fns[id]
    push_frame(mut g, "function")
    let mut names: [Str] = []
    for i in 0..len(f.decl.params) {
        // The caller passes each argument owned and the callee releases it,
        // except a mut parameter, which stays the caller's.
        let lid = f.param_locals[i]
        push(mut names, c_name(mut g, lid))
        let t = g.k.locals[lid].ty
        if managed(mut g, t) && !f.decl.params[i].mutable {
            push(mut g.frames[len(g.frames) - 1].items, Item { c: names[i], ty: t })
        }
    }
    for s in f.decl.body.stmts {
        stmt(mut g, s)
    }
    pop_frame(mut g)
    let mut out = [prototype(g.k, g.l, id, names) + " {"]
    for line in g.lines {
        push(mut out, line)
    }
    push(mut out, "}")
    return out
}

fn block(g: mut Gen, b: ast.Block, kind: Str) {
    push_frame(mut g, kind)
    for s in b.stmts {
        stmt(mut g, s)
    }
    pop_frame(mut g)
}

fn stmt(g: mut Gen, s: ast.Stmt) {
    match s.kind {
        ast.StmtKind.Block(b) => {
            open(mut g, "{")
            block(mut g, b, "block")
            close(mut g, "}")
            return
        }
        _ => {}
    }
    emit(mut g, "// line " + strings.from_int(s.line))
    push_frame(mut g, "stmt")
    stmt_body(mut g, s)
    pop_frame(mut g)
}

fn stmt_body(g: mut Gen, s: ast.Stmt) {
    match s.kind {
        ast.StmtKind.ExprStmt(e) => expr(mut g, e)
        ast.StmtKind.Let(_, _, _, v) => {
            let c = consume(mut g, expr(mut g, v))
            declare(mut g, local_of(g, s.id), c)
        }
        ast.StmtKind.Assign(target, v) => assign(mut g, target, v)
        ast.StmtKind.If(cond, then, otherwise) => if_stmt(mut g, cond, then, otherwise)
        ast.StmtKind.For(cond, body) => {
            // Any statements the condition needs must run on every
            // iteration, so the test goes inside the loop.
            open(mut g, "for (;;) {")
            push_frame(mut g, "body")
            match cond {
                Some(e) => {
                    push_frame(mut g, "stmt")
                    let c = expr(mut g, e).c
                    let test = scalar(mut g, types.BOOL(), c)
                    pop_frame(mut g)
                    emit(mut g, "if (!" + test + ") break;")
                }
                None => {}
            }
            for inner in body.stmts {
                stmt(mut g, inner)
            }
            pop_frame(mut g)
            close(mut g, "}")
        }
        ast.StmtKind.ForRange(_, start, end, body) => {
            let from = expr(mut g, start).c
            // The range is fixed when the loop starts.
            let to = scalar(mut g, types.INT(), expr(mut g, end).c)
            let i = new_temp(mut g)
            open(mut g, "for (int64_t " + i + " = " + from + "; " + i + " < " + to + "; " + i + "++) {")
            push_frame(mut g, "body")
            declare(mut g, local_of(g, s.id), i)
            for inner in body.stmts {
                stmt(mut g, inner)
            }
            pop_frame(mut g)
            close(mut g, "}")
        }
        ast.StmtKind.ForEach(_, iterable, body) => for_each(mut g, s, iterable, body)
        ast.StmtKind.Break => {
            release_until(mut g, "body")
            emit(mut g, "break;")
            g.dead = true
        }
        ast.StmtKind.Continue => {
            release_until(mut g, "body")
            emit(mut g, "continue;")
            g.dead = true
        }
        ast.StmtKind.Return(v) => {
            match v {
                None => {
                    release_until(mut g, "")
                    emit(mut g, "return;")
                }
                Some(e) => {
                    let c = consume(mut g, expr(mut g, e))
                    let result = new_temp(mut g)
                    emit(mut g, c_type(g, ty(g, e)) + " " + result + " = " + c + ";")
                    release_until(mut g, "")
                    emit(mut g, "return " + result + ";")
                }
            }
            g.dead = true
        }
        ast.StmtKind.MatchStmt(scrutinee, arms) => match_code(mut g, scrutinee, arms, ArmCode.Statements)
        ast.StmtKind.Block(_) => {}  // handled in stmt
    }
}

fn if_stmt(g: mut Gen, cond: ast.Expr, then: ast.Block, otherwise: ast.Else) {
    let c = expr(mut g, cond).c
    open(mut g, "if (" + c + ") {")
    block(mut g, then, "block")
    match otherwise {
        ast.Else.NoElse => {
            close(mut g, "}")
            return
        }
        _ => {}
    }
    close(mut g, "} else {")
    g.depth = g.depth + 1
    match otherwise {
        ast.Else.ElseIf(s) => {
            // `else if`'s condition may need statements of its own, which
            // must only run when the first condition was false.
            push_frame(mut g, "branch")
            match s.kind {
                ast.StmtKind.If(c2, then2, else2) => if_stmt(mut g, c2, then2, else2)
                _ => {}
            }
            pop_frame(mut g)
        }
        ast.Else.ElseBlock(b) => block(mut g, b, "block")
        ast.Else.NoElse => {}
    }
    close(mut g, "}")
}

// `for x in xs`: the loop keeps its own reference to xs.
fn for_each(g: mut Gen, s: ast.Stmt, iterable: ast.Expr, body: ast.Block) {
    let t = ty(g, iterable)
    let it = new_temp(mut g)
    let c = consume(mut g, expr(mut g, iterable))
    emit(mut g, c_type(g, t) + " " + it + " = " + c + ";")
    own(mut g, it, t)  // released when the for statement ends
    let i = new_temp(mut g)
    let mut length = it + "->len"
    if t == types.STR() {
        length = it + ".len"
    }
    open(mut g, "for (int64_t " + i + " = 0; " + i + " < " + length + "; " + i + "++) {")
    push_frame(mut g, "body")
    let lid = local_of(g, s.id)
    if t == types.STR() {
        declare(mut g, lid, it + ".data[" + i + "]")
    } else {
        let elem = c_type(g, g.k.locals[lid].ty)
        let name = declare(mut g, lid, "((" + elem + " *)" + it + "->data)[" + i + "]")
        emit(mut g, retain(mut g, g.k.locals[lid].ty, name))
    }
    for inner in body.stmts {
        stmt(mut g, inner)
    }
    pop_frame(mut g)
    close(mut g, "}")
}

// ---- Assignment and places ----

fn assign(g: mut Gen, target: ast.Expr, v: ast.Expr) {
    // The new value is worked out first; then the place is changed.
    let c = consume(mut g, expr(mut g, v))
    match target.kind {
        ast.ExprKind.Name(_) => {
            let name = local(mut g, local_of(g, target.id))
            emit(mut g, release(mut g, ty(g, target), name))
            emit(mut g, name + " = " + c + ";")
        }
        ast.ExprKind.Field(obj, field) => {
            let owner = ty(g, obj)
            let base = place(mut g, obj)
            let member = base + ".m_" + field
            if layout.is_boxed(g.l, owner, field, 0) {
                // Never write into a box someone else may share: drop this
                // value's box and give the field a new one.
                let box = layout.box_name(g.l, ty(g, target))
                emit(mut g, box + "_release(" + member + ");")
                emit(mut g, member + " = " + box + "_new(" + c + ");")
            } else {
                emit(mut g, release(mut g, ty(g, target), member))
                emit(mut g, member + " = " + c + ";")
            }
        }
        ast.ExprKind.Index(obj, i) => {
            let container = writable(mut g, obj)
            let ot = ty(g, obj)
            if types.is_map(g.k.table, ot) {
                let key = consume(mut g, expr(mut g, i))
                let k = c_type(g, types.get(g.k.table, ot).args[0])
                let vt = c_type(g, ty(g, target))
                let ka = addr(mut g, k, key)
                let va = addr(mut g, vt, c)
                emit(mut g, "vela_map_set(" + container + ", " + ka + ", " + va + ");")
            } else {
                let index = expr(mut g, i).c
                let elem = c_type(g, ty(g, target))
                let va = addr(mut g, elem, c)
                emit(mut g, "vela_array_set(" + container + ", " + index + ", " + va + ", " + loc_of(g, target) + ");")
            }
        }
        _ => {}
    }
}

// An lvalue for an array or map about to change, made unique first.
fn writable(g: mut Gen, e: ast.Expr) -> Str {
    let p = place(mut g, e)
    let mut kind = "array"
    if types.is_map(g.k.table, ty(g, e)) {
        kind = "map"
    }
    emit(mut g, "vela_" + kind + "_unique(&" + p + ");")
    return p
}

// A C lvalue for a variable, or a path inside one, about to be written
// through; shared boxes and arrays on the way are copied first.
fn place(g: mut Gen, e: ast.Expr) -> Str {
    match e.kind {
        ast.ExprKind.Name(_) => return local(mut g, local_of(g, e.id))
        ast.ExprKind.Field(obj, field) => {
            let base = place(mut g, obj)
            let member = base + ".m_" + field
            if !layout.is_boxed(g.l, ty(g, obj), field, 0) {
                return member
            }
            emit(mut g, layout.box_name(g.l, ty(g, e)) + "_unique(&" + member + ");")
            return member + "->value"
        }
        ast.ExprKind.Index(obj, i) => {
            let container = writable(mut g, obj)
            let ot = ty(g, obj)
            if types.is_map(g.k.table, ot) {
                let key = expr(mut g, i).c
                let k = c_type(g, types.get(g.k.table, ot).args[0])
                let ka = addr(mut g, k, key)
                return "(*(" + c_type(g, ty(g, e)) + " *)vela_map_at(" + container + ", " + ka + ", " + loc_of(g, e) + "))"
            }
            let index = expr(mut g, i).c
            return "(*(" + c_type(g, ty(g, e)) + " *)vela_array_at(" + container + ", " + index + ", " + loc_of(g, e) + "))"
        }
        _ => return ""
    }
}

// ---- Match ----

// An if / else-if chain, one test per arm, in order; the last arm is a
// plain `else`, since the checker proved the arms exhaustive.
fn match_code(g: mut Gen, scrutinee: ast.Expr, arms: [ast.Arm], code: ArmCode) {
    let v = expr(mut g, scrutinee).c
    let t = ty(g, scrutinee)
    for i in 0..len(arms) {
        let a = arms[i]
        let last = i == len(arms) - 1
        g.dead = false  // each arm is reachable, whatever the last one ended with
        if last {
            if i > 0 {
                open(mut g, "} else {")
            } else {
                open(mut g, "{")
            }
        } else {
            let tests = tests(g, a.pattern, v, t)
            let mut cond = strings.builder()
            for j in 0..len(tests) {
                if j > 0 {
                    strings.add(mut cond, " && ")
                }
                strings.add(mut cond, tests[j])
            }
            let mut c = strings.build(cond)
            if c == "" {
                c = "true"
            }
            if i > 0 {
                open(mut g, "} else if (" + c + ") {")
            } else {
                open(mut g, "if (" + c + ") {")
            }
        }
        push_frame(mut g, "arm")
        for bound in bindings(g, a.pattern, v, t) {
            // A binding is a copy of part of the value: it gets a reference of its own.
            let name = declare(mut g, bound.local, bound.path)
            emit(mut g, retain(mut g, g.k.locals[bound.local].ty, name))
        }
        match code {
            ArmCode.Statements => {
                match a.body {
                    ast.ArmBody.Do(s) => {
                        match s.kind {
                            ast.StmtKind.Block(b) => {
                                for inner in b.stmts {
                                    stmt(mut g, inner)
                                }
                            }
                            _ => stmt(mut g, s)
                        }
                    }
                    ast.ArmBody.Value(_) => {}
                }
            }
            ArmCode.StoreIn(result) => {
                match a.body {
                    ast.ArmBody.Value(e) => {
                        let c = consume(mut g, expr(mut g, e))
                        emit(mut g, result + " = " + c + ";")
                    }
                    ast.ArmBody.Do(_) => {}
                }
            }
        }
        pop_frame(mut g)
        g.depth = g.depth - 1
    }
    emit(mut g, "}")
    g.dead = false
}

fn payload(g: Gen, path: Str, enum: Int, vi: Int, i: Int) -> Str {
    let name = types.get(g.k.table, enum).variants[vi].name
    let member = path + ".as.m_" + name + "._" + strings.from_int(i)
    if layout.is_boxed(g.l, enum, name, i) {
        return member + "->value"
    }
    return member
}

fn variant_ref(g: Gen, id: Int) -> [Int] {
    return match g.k.refs[id] {
        checker.Ref.Variant(e, v) => [e, v]
        _ => [0, 0]
    }
}

// C conditions, all of which hold when the value at `path` matches `p`.
fn tests(g: Gen, p: ast.Pattern, path: Str, t: Int) -> [Str] {
    let none: [Str] = []
    match p.kind {
        ast.PatternKind.Wild => return none
        ast.PatternKind.Bind(_) => return none
        ast.PatternKind.Lit(e) => {
            match e.kind {
                ast.ExprKind.BoolLit(b) => {
                    if b {
                        return [path]
                    }
                    return ["!" + path]
                }
                ast.ExprKind.StrLit(s) => {
                    return ["vela_str_eq(" + path + ", VELA_STR(" + c_string(s) + ", " + strings.from_int(len(s)) + "))"]
                }
                ast.ExprKind.IntLit(n) => return [path + " == " + strings.from_int(n)]
                ast.ExprKind.ByteLit(n) => return [path + " == " + strings.from_int(n)]
                _ => return none
            }
        }
        ast.PatternKind.Range(lo, hi) => {
            let mut out: [Str] = []
            let a = literal(lo)
            let b = literal(hi)
            // A test that can never fail (a Byte >= 0) would draw a C warning.
            if !(t == types.BYTE() && a == 0) {
                push(mut out, path + " >= " + strings.from_int(a))
            }
            if !(t == types.BYTE() && b == 255) {
                push(mut out, path + " <= " + strings.from_int(b))
            }
            return out
        }
        ast.PatternKind.Variant(_, _, _, _, args) => {
            let r = variant_ref(g, p.id)
            let enum = r[0]
            let vi = r[1]
            let v = types.get(g.k.table, enum).variants[vi]
            let mut out = [path + ".tag == " + layout.tag(g.l, enum, v.name)]
            for i in 0..len(args) {
                for test in tests(g, args[i], payload(g, path, enum, vi, i), v.payload[i]) {
                    push(mut out, test)
                }
            }
            return out
        }
    }
}

fn literal(e: ast.Expr) -> Int {
    return match e.kind {
        ast.ExprKind.IntLit(n) => n
        ast.ExprKind.ByteLit(n) => n
        _ => 0
    }
}

type Binding = struct {
    local: Int
    path: Str
}

fn bindings(g: Gen, p: ast.Pattern, path: Str, t: Int) -> [Binding] {
    let mut out: [Binding] = []
    match p.kind {
        ast.PatternKind.Bind(_) => push(mut out, Binding { local: local_of(g, p.id), path: path })
        ast.PatternKind.Variant(_, _, _, _, args) => {
            let r = variant_ref(g, p.id)
            let v = types.get(g.k.table, r[0]).variants[r[1]]
            for i in 0..len(args) {
                for b in bindings(g, args[i], payload(g, path, r[0], r[1], i), v.payload[i]) {
                    push(mut out, b)
                }
            }
        }
        _ => {}
    }
    return out
}

// ---- Expressions ----

// Emit code for `e` and return its value: a literal, a variable, a
// temporary, or a field of one of those, so using it has no side effects.
// A call that produces no value has the C expression "".
fn expr(g: mut Gen, e: ast.Expr) -> Value {
    let t = ty(g, e)
    match e.kind {
        ast.ExprKind.IntLit(n) => return value(strings.from_int(n), t)
        ast.ExprKind.ByteLit(n) => return value(strings.from_int(n), t)
        ast.ExprKind.BoolLit(b) => {
            if b {
                return value("true", t)
            }
            return value("false", t)
        }
        ast.ExprKind.StrLit(s) => {
            return Value { c: "VELA_STR(" + c_string(s) + ", " + strings.from_int(len(s)) + ")", ty: t, owned: false,
                           is_static: true }
        }
        ast.ExprKind.UnitLit => return value("0", t)
        ast.ExprKind.Name(_) => {
            match g.k.refs[e.id] {
                checker.Ref.Local(id) => return value(local(mut g, id), t)
                checker.Ref.Variant(enum, vi) => return enum_value(mut g, enum, vi, [])  // `None`
                _ => return no_value()
            }
        }
        ast.ExprKind.Unary(op, operand) => {
            let c = expr(mut g, operand).c
            if op == "-" {
                return value(scalar(mut g, types.INT(), "vela_neg(" + c + ", " + loc_of(g, e) + ")"), t)
            }
            return value(scalar(mut g, types.BOOL(), "!" + c), t)
        }
        ast.ExprKind.Binary(op, l, r) => return binary(mut g, e, op, l, r)
        ast.ExprKind.Call(_, args) => {
            match g.k.refs[e.id] {
                checker.Ref.Variant(enum, vi) => {
                    let mut consumed: [Str] = []
                    for a in args {
                        push(mut consumed, consume(mut g, expr(mut g, a)))
                    }
                    return enum_value(mut g, enum, vi, consumed)
                }
                checker.Ref.Builtin(name) => return builtin(mut g, e, name, args)
                checker.Ref.Function(id) => {
                    // The other arguments first, left to right; then the
                    // places of the mut ones, so nothing evaluated in between
                    // can move them.
                    let mut cs: [Str] = []
                    for a in args {
                        match a.kind {
                            ast.ExprKind.MutArg(_) => push(mut cs, "")
                            _ => push(mut cs, consume(mut g, expr(mut g, a)))
                        }
                    }
                    for i in 0..len(args) {
                        match args[i].kind {
                            ast.ExprKind.MutArg(p) => cs[i] = "&" + place(mut g, p)
                            _ => {}
                        }
                    }
                    let mut b = strings.builder()
                    strings.add(mut b, fn_name(g.k, id) + "(")
                    for i in 0..len(cs) {
                        if i > 0 {
                            strings.add(mut b, ", ")
                        }
                        strings.add(mut b, cs[i])
                    }
                    strings.add_byte(mut b, ')')
                    let call = strings.build(b)
                    if t == types.NOTHING() {
                        emit(mut g, call + ";")
                        return no_value()
                    }
                    return store(mut g, t, call)
                }
                _ => return no_value()
            }
        }
        ast.ExprKind.Field(obj, name) => {
            match g.k.refs[e.id] {
                checker.Ref.Variant(enum, vi) => return enum_value(mut g, enum, vi, [])
                _ => {}
            }
            let c = expr(mut g, obj).c
            let mut member = c + ".m_" + name
            if layout.is_boxed(g.l, ty(g, obj), name, 0) {
                member = member + "->value"
            }
            return value(member, t)
        }
        ast.ExprKind.Index(obj, i) => return index(mut g, e, obj, i)
        ast.ExprKind.Try(inner) => return try_value(mut g, e, inner)
        ast.ExprKind.MutArg(p) => return expr(mut g, p)  // not reached: only in calls
        ast.ExprKind.Slice(obj, lo, hi) => {
            let o = expr(mut g, obj).c
            let a = expr(mut g, lo).c
            let b = expr(mut g, hi).c
            let mut kind = "array"
            if t == types.STR() {
                kind = "str"
            }
            return store(mut g, t, "vela_" + kind + "_slice(" + o + ", " + a + ", " + b + ", " + loc_of(g, e) + ")")
        }
        ast.ExprKind.ArrayLit(elems) => {
            let elem_t = types.get(g.k.table, t).args[0]
            let array = store(mut g, t, "vela_array_new(" + layout.descriptor(g.l, elem_t) + ", " +
                strings.from_int(len(elems)) + ")")
            let elem = c_type(g, elem_t)
            for x in elems {
                let c = consume(mut g, expr(mut g, x))
                let a = addr(mut g, elem, c)
                emit(mut g, "vela_array_push(" + array.c + ", " + a + ");")
            }
            return array
        }
        ast.ExprKind.MapLit(entries) => {
            let ti = types.get(g.k.table, t)
            let m = store(mut g, t, "vela_map_new(" + layout.descriptor(g.l, ti.args[0]) + ", " +
                layout.descriptor(g.l, ti.args[1]) + ")")
            let k = c_type(g, ti.args[0])
            let vt = c_type(g, ti.args[1])
            for en in entries {
                let key = consume(mut g, expr(mut g, en.key))
                let val = consume(mut g, expr(mut g, en.value))
                let ka = addr(mut g, k, key)
                let va = addr(mut g, vt, val)
                emit(mut g, "vela_map_set(" + m.c + ", " + ka + ", " + va + ");")
            }
            return m
        }
        ast.ExprKind.StructLit(_, _, fields) => return struct_value(mut g, t, fields)
        ast.ExprKind.Match(scrutinee, arms) => {
            let result = new_temp(mut g)
            emit(mut g, c_type(g, t) + " " + result + ";")
            match_code(mut g, scrutinee, arms, ArmCode.StoreIn(result))
            return own(mut g, result, t)
        }
    }
}

// `x?`: if x is an Err (or None), return it from the function now,
// releasing everything that is live, exactly as `return` does. Otherwise
// the value inside the Ok (or Some), borrowed from x.
fn try_value(g: mut Gen, e: ast.Expr, inner: ast.Expr) -> Value {
    let v = expr(mut g, inner)
    let t = ty(g, inner)
    let result = g.k.fns[g.current_fn].result
    let ti = types.get(g.k.table, t)
    let mut fail = "None"
    let mut ok = "Some"
    if ti.name == "Result" {
        fail = "Err"
        ok = "Ok"
    }
    let r = c_type(g, result)
    open(mut g, "if (" + v.c + ".tag == " + layout.tag(g.l, t, fail) + ") {")
    let returned = new_temp(mut g)
    if fail == "Err" {
        // The error moves into the function's own Result type; it gets a
        // reference of its own, since x is released below.
        let err = payload(g, v.c, t, types.variant_index(g.k.table, t, "Err"), 0)
        emit(mut g, retain(mut g, ti.args[1], err))
        emit(mut g, r + " " + returned + " = (" + r + "){ .tag = " + layout.tag(g.l, result, "Err") +
            ", .as.m_Err = { ._0 = " + err + " } };")
    } else {
        emit(mut g, r + " " + returned + " = (" + r + "){ .tag = " + layout.tag(g.l, result, "None") + " };")
    }
    release_until(mut g, "")
    emit(mut g, "return " + returned + ";")
    close(mut g, "}")
    return value(payload(g, v.c, t, types.variant_index(g.k.table, t, ok), 0), ty(g, e))
}

// Reading `xs[i]`, `s[i]` or `m[k]`: the element is copied into a
// temporary, borrowed (it still belongs to the container).
fn index(g: mut Gen, e: ast.Expr, obj: ast.Expr, i: ast.Expr) -> Value {
    let o = expr(mut g, obj).c
    let t = ty(g, obj)
    if t == types.STR() {
        let ix = expr(mut g, i).c
        return value(scalar(mut g, types.BYTE(), "vela_str_at(" + o + ", " + ix + ", " + loc_of(g, e) + ")"), types.BYTE())
    }
    let elem = c_type(g, ty(g, e))
    let temp = new_temp(mut g)
    if types.is_map(g.k.table, t) {
        let key = expr(mut g, i).c
        let k = c_type(g, types.get(g.k.table, t).args[0])
        let ka = addr(mut g, k, key)
        emit(mut g, elem + " " + temp + " = *(" + elem + " *)vela_map_at(" + o + ", " + ka + ", " + loc_of(g, e) + ");")
    } else {
        let ix = expr(mut g, i).c
        emit(mut g, elem + " " + temp + " = *(" + elem + " *)vela_array_at(" + o + ", " + ix + ", " + loc_of(g, e) + ");")
    }
    return value(temp, ty(g, e))
}

// `(t_Expr){ .tag = ..., .as.m_Add = { ._0 = ..., ._1 = ... } }`, owned.
// `args` are already consumed.
fn enum_value(g: mut Gen, enum: Int, vi: Int, args: [Str]) -> Value {
    let v = types.get(g.k.table, enum).variants[vi]
    let mut fields = ".tag = " + layout.tag(g.l, enum, v.name)
    if len(args) > 0 {
        let mut values = strings.builder()
        for i in 0..len(args) {
            if i >= len(v.payload) {
                break
            }
            let mut arg = args[i]
            if layout.is_boxed(g.l, enum, v.name, i) {
                arg = layout.box_name(g.l, v.payload[i]) + "_new(" + arg + ")"
            }
            if i > 0 {
                strings.add(mut values, ", ")
            }
            strings.add(mut values, "._" + strings.from_int(i) + " = " + arg)
        }
        fields = fields + ", .as.m_" + v.name + " = { " + strings.build(values) + " }"
    }
    return store(mut g, enum, "(" + c_type(g, enum) + "){ " + fields + " }")
}

fn struct_value(g: mut Gen, t: Int, fields: [ast.FieldInit]) -> Value {
    let mut values: Map[Str, Str] = [:]
    for f in fields {  // in source order: evaluation is left to right
        let mut c = consume(mut g, expr(mut g, f.value))
        if layout.is_boxed(g.l, t, f.name, 0) {
            let ft = types.get(g.k.table, t).fields[types.field_index(g.k.table, t, f.name)].ty
            c = layout.box_name(g.l, ft) + "_new(" + c + ")"
        }
        values[f.name] = c
    }
    let mut inits = strings.builder()
    let decl = types.get(g.k.table, t).fields
    for i in 0..len(decl) {
        if i > 0 {
            strings.add(mut inits, ", ")
        }
        strings.add(mut inits, ".m_" + decl[i].name + " = " + values[decl[i].name])
    }
    return store(mut g, t, "(" + c_type(g, t) + "){ " + strings.build(inits) + " }")
}

fn arith_name(op: Str) -> Str {
    return match op {
        "+" => "add"
        "-" => "sub"
        "*" => "mul"
        "/" => "div"
        _ => "rem"
    }
}

fn binary(g: mut Gen, e: ast.Expr, op: Str, l: ast.Expr, r: ast.Expr) -> Value {
    if op == "&&" || op == "||" {
        // Short-circuit: the right side runs only if it can change the
        // answer, so its code goes inside an `if`, in a frame of its own.
        let result = scalar(mut g, types.BOOL(), expr(mut g, l).c)
        let mut negate = ""
        if op == "||" {
            negate = "!"
        }
        open(mut g, "if (" + negate + result + ") {")
        push_frame(mut g, "branch")
        let right = expr(mut g, r).c
        emit(mut g, result + " = " + right + ";")
        pop_frame(mut g)
        close(mut g, "}")
        return value(result, types.BOOL())
    }
    let left = expr(mut g, l).c
    let right = expr(mut g, r).c
    let operand = ty(g, l)
    if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" {
        if operand == types.STR() {
            return store(mut g, types.STR(), "vela_str_concat(" + left + ", " + right + ")")
        }
        let mut prefix = "vela_"
        if operand == types.BYTE() {
            prefix = "vela_byte_"
        }
        let t = ty(g, e)
        return value(scalar(mut g, t, prefix + arith_name(op) + "(" + left + ", " + right + ", " + loc_of(g, e) + ")"), t)
    }
    if operand == types.STR() && (op == "==" || op == "!=") {
        let mut negate = ""
        if op == "!=" {
            negate = "!"
        }
        return value(scalar(mut g, types.BOOL(), negate + "vela_str_eq(" + left + ", " + right + ")"), types.BOOL())
    }
    if operand == types.STR() {
        return value(scalar(mut g, types.BOOL(), "vela_str_cmp(" + left + ", " + right + ") " + op + " 0"), types.BOOL())
    }
    if types.is_enum(g.k.table, operand) {
        return value(scalar(mut g, types.BOOL(), left + ".tag " + op + " " + right + ".tag"), types.BOOL())
    }
    return value(scalar(mut g, types.BOOL(), left + " " + op + " " + right), types.BOOL())
}

fn print_function(t: Int) -> Str {
    if t == types.BOOL() {
        return "vela_print_bool"
    }
    if t == types.STR() {
        return "vela_print_str"
    }
    return "vela_print_int"  // Int and Byte
}

fn mut_place(e: ast.Expr) -> ast.Expr {
    return match e.kind {
        ast.ExprKind.MutArg(p) => p
        _ => e
    }
}

fn builtin(g: mut Gen, e: ast.Expr, name: Str, args: [ast.Expr]) -> Value {
    let t = ty(g, e)
    if name == "print" || name == "os.eprint" {
        let arg = expr(mut g, args[0])
        let mut func = print_function(arg.ty)
        if name == "os.eprint" {
            func = "vela_eprint" + func[10..len(func)]
        }
        emit(mut g, func + "(" + arg.c + ");")
        return no_value()
    }
    if name == "os.args" || name == "strings.build" || name == "strings.from_int" {
        let mut cs = strings.builder()
        for i in 0..len(args) {
            if i > 0 {
                strings.add(mut cs, ", ")
            }
            strings.add(mut cs, expr(mut g, args[i]).c)
        }
        let func = match name {
            "os.args" => "vela_os_args"
            "strings.build" => "vela_builder_build"
            _ => "vela_from_int"
        }
        return store(mut g, t, func + "(" + strings.build(cs) + ")")
    }
    if name == "os.exit" {
        let code = expr(mut g, args[0]).c
        emit(mut g, "vela_os_exit(" + code + ", " + loc_of(g, e) + ");")
        return no_value()
    }
    if name == "strings.builder" {
        return store(mut g, t, "vela_array_new(&vela_type_byte, 0)")
    }
    if name == "strings.add" || name == "strings.add_byte" || name == "strings.add_int" {
        let v = expr(mut g, args[1]).c  // the value first, then the place, as for any mut argument
        let b = writable(mut g, mut_place(args[0]))
        if name == "strings.add_byte" {
            let a = addr(mut g, "uint8_t", v)
            emit(mut g, "vela_array_push(" + b + ", " + a + ");")
        } else {
            emit(mut g, "vela_builder_" + name[8..len(name)] + "(" + b + ", " + v + ");")
        }
        return no_value()
    }
    if name == "files.read" || name == "files.write" || name == "files.remove" || name == "files.temp_dir" ||
            name == "os.run" {
        return file_call(mut g, e, name, args)
    }
    if name == "os.env" {
        let arg = expr(mut g, args[0]).c
        let text = new_temp(mut g)
        let ok = new_temp(mut g)
        emit(mut g, "vela_str " + text + " = VELA_STR(\"\", 0);")
        emit(mut g, "bool " + ok + " = vela_os_env(" + arg + ", &" + text + ");")
        let opt = c_type(g, t)
        let some = "(" + opt + "){ .tag = " + layout.tag(g.l, t, "Some") + ", .as.m_Some = { ._0 = " + text + " } }"
        let none = "(" + opt + "){ .tag = " + layout.tag(g.l, t, "None") + " }"
        return store(mut g, t, ok + " ? " + some + " : " + none)
    }
    if name == "len" {
        let arg = expr(mut g, args[0])
        let mut length = arg.c + "->len"
        if arg.ty == types.STR() {
            length = arg.c + ".len"
        }
        return value(scalar(mut g, types.INT(), length), types.INT())
    }
    if name == "int" {
        let c = expr(mut g, args[0]).c
        return value(scalar(mut g, types.INT(), "(int64_t)" + c), types.INT())
    }
    if name == "byte" {
        let c = expr(mut g, args[0]).c
        return value(scalar(mut g, types.BYTE(), "vela_to_byte(" + c + ", " + loc_of(g, e) + ")"), types.BYTE())
    }
    if name == "push" {
        let v = consume(mut g, expr(mut g, args[1]))
        let array = writable(mut g, mut_place(args[0]))
        let elem = c_type(g, types.get(g.k.table, ty(g, args[0])).args[0])
        let a = addr(mut g, elem, v)
        emit(mut g, "vela_array_push(" + array + ", " + a + ");")
        return no_value()
    }
    let mt = ty(g, args[0])
    let mti = types.get(g.k.table, mt)
    let k = c_type(g, mti.args[0])
    if name == "maps.remove" {
        let key = expr(mut g, args[1]).c
        let m = writable(mut g, mut_place(args[0]))
        let ka = addr(mut g, k, key)
        emit(mut g, "(void)vela_map_remove(" + m + ", " + ka + ");")
        return no_value()
    }
    let m = expr(mut g, args[0]).c
    if name == "maps.keys" {
        return store(mut g, t, "vela_map_keys(" + m + ")")
    }
    let key = expr(mut g, args[1]).c
    let found = new_temp(mut g)
    let vt = c_type(g, mti.args[1])
    let ka = addr(mut g, k, key)
    emit(mut g, vt + " *" + found + " = vela_map_find(" + m + ", " + ka + ");")
    if name == "maps.has" {
        return value(scalar(mut g, types.BOOL(), found + " != NULL"), types.BOOL())
    }
    // get: Some(a copy of the value), or None.
    let opt = c_type(g, t)
    let result = new_temp(mut g)
    emit(mut g, opt + " " + result + ";")
    open(mut g, "if (" + found + ") {")
    emit(mut g, result + " = (" + opt + "){ .tag = " + layout.tag(g.l, t, "Some") + ", .as.m_Some = { ._0 = *" + found + " } };")
    emit(mut g, retain(mut g, mti.args[1], result + ".as.m_Some._0"))
    close(mut g, "} else {")
    g.depth = g.depth + 1
    emit(mut g, result + " = (" + opt + "){ .tag = " + layout.tag(g.l, t, "None") + " };")
    close(mut g, "}")
    return own(mut g, result, t)
}

// files.read, files.write, files.remove, files.temp_dir and os.run: the
// runtime reports success with a bool and fills in the result or the error
// message; this builds the Result.
fn file_call(g: mut Gen, e: ast.Expr, name: Str, args: [ast.Expr]) -> Value {
    let mut cs: [Str] = []
    for a in args {
        push(mut cs, expr(mut g, a).c)
    }
    let r = ty(g, e)
    let text = new_temp(mut g)  // the contents, or the error message
    let ok = new_temp(mut g)
    emit(mut g, "vela_str " + text + " = VELA_STR(\"\", 0);")
    let mut success = text
    if name == "files.read" {
        emit(mut g, "bool " + ok + " = vela_files_read(" + cs[0] + ", &" + text + ");")
    } else if name == "files.write" {
        emit(mut g, "bool " + ok + " = vela_files_write(" + cs[0] + ", " + cs[1] + ", &" + text + ");")
        success = cs[1] + ".len"
    } else if name == "files.remove" {
        emit(mut g, "bool " + ok + " = vela_files_remove(" + cs[0] + ", &" + text + ");")
        success = "0"
    } else if name == "files.temp_dir" {
        emit(mut g, "bool " + ok + " = vela_files_temp_dir(&" + text + ");")
    } else {
        let code = new_temp(mut g)
        emit(mut g, "int64_t " + code + " = 0;")
        emit(mut g, "bool " + ok + " = vela_os_run(" + cs[0] + ", &" + code + ", &" + text + ");")
        success = code
    }
    let rt = c_type(g, r)
    let ok_value = "(" + rt + "){ .tag = " + layout.tag(g.l, r, "Ok") + ", .as.m_Ok = { ._0 = " + success + " } }"
    let err_value = "(" + rt + "){ .tag = " + layout.tag(g.l, r, "Err") + ", .as.m_Err = { ._0 = " + text + " } }"
    return store(mut g, r, ok + " ? " + ok_value + " : " + err_value)
}
