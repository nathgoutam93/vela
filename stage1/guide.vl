// The guide shares lexer/index metadata and parses the installed std API.
import ast
import checker
import files
import index
import interfaces
import lexer
import modules
import os
import parser
import strings

pub fn reference(root: Str) -> Str uses fs, os {
    let mut out = strings.builder()
    strings.add(mut out, "# Vela language reference\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "Generated by the compiler. Signatures below come from its symbol index and the installed standard library. Read this reference, then use check/test after each edit.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "## Commands\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "`vela check FILE` checks a program or library and its imports without generating code. `vela check --json FILE` emits errors and warnings with stable `code` and `fix` fields. A fix is a list of edits: `file`, UTF-8 byte offsets `start` and `end` (end excluded), replacement `text`, and the `expected` original bytes. Apply a diagnostic's edits together, from right to left, against the exact original source. Empty fixes need a human decision.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "`vela explain CODE` explains a diagnostic. `vela fix FILE` applies available fixes to the file and local imports, rechecking after each pass; it exits 1 if errors remain. `vela fix --dry-run FILE` reports potential changes without writing. Fixes can change effects and mutability: review the diff. Dependencies and std are never rewritten.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "`vela run FILE ARGS...` compiles and runs; `vela build FILE -o EXE` produces an executable; `vela test FILE [WORDS...]` runs matching test blocks including imported modules. `vela fmt -w FILE...` formats in place; `-l` lists unformatted files. `vela query type|def|refs|complete FILE:LINE:COL` answers about names; `vela query symbols FILE` lists declarations. `vela rename FILE:LINE:COL NEW` renames across modules. Positions count bytes from 1. `vela lsp` starts the editor server.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "Builds use C by default; run and test use the native backend on Linux x86-64. `VELA_BACKEND=c|native` overrides this. Native currently targets Linux x86-64. `VELA_CC` chooses gcc/clang; `VELA_CFLAGS` adds C flags. `VELA_ROOT` overrides the runtime/std installation root; otherwise it is found relative to the resolved executable. `VELA_CACHE` selects the compiled runtime cache, or `off` disables it.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "## Syntax and values\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "Files use `.vl`. A program starts at `fn main()` with no parameters or return type. Libraries need no main. Comments begin with `//`. Newlines end statements; a newline after an operator continues the expression. A function's opening `{` belongs with its signature (or its final contract clause). Use parentheses to disambiguate a struct literal in an if/for/match condition. Functions are called as `module.function(value)` or `value.method()` for functions on its type.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "`i8 i16 i32 i64 u8 u16 u32 u64` are fixed-width integers. `Int` aliases i64 and `Byte` aliases u8. Arithmetic and indexing are checked and panic on overflow or an invalid index. Decimal, 0x hex and 0b binary literals accept separators and width suffixes (255u8, 0xffff_ffffu32); unsuffixed literals infer an integer type from context or default to Int. Signed minimum and full-range u64 literals are supported. `Byte` ranges from 0 to 255 and is written `'a'` or `'\\n'`; Different integer types require explicit checked conversion with `i8(x)` through `u64(x)`; legacy int and byte conversions also remain available. `Float` uses 64-bit floating point, with literals such as `1.5`; `float(n)` and `int(x)` convert. `Bool` is `true` or `false`. `Str` is UTF-8 text in double quotes with escapes `\\n \\t \\r \\0 \\\\ \\\"`. `Unit` has the value `()`. There are no implicit conversions between integer types. `ints.checked_add/sub/mul/div/rem/neg` return Option[T]; `ints.wrapping_*` wrap modulo 2^width and `ints.saturating_*` clamp. Import ints first. Division by zero panics except in checked functions, which return None. `ints.to_str` supports every integer type. Bit operations &, |, ^, ~ preserve width; left shifts discard high bits, signed right shifts extend the sign, unsigned right shifts insert zeros. Shift counts must be in 0..width; invalid counts panic.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "`+ - * / %` do arithmetic; `+` also joins two strings. `== != < <= > >=` compare; `&& || !` operate on Bool and short-circuit. Precedence, from tight to loose: calls/fields/index/`?`, unary `- ! ~`, `* / %`, `+ -`, `<< >>`, `&`, `^`, `|`, comparisons, `&&`, `||`. There is no truthiness, ternary operator, increment operator or compound assignment. Write `n = n + 1`.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "Interfaces are structural generic bounds: `pub type Show = interface { fn show(value: Self) -> Str }`; `fn render[T: Show](value: T) -> Str { return value.show() }`. Extend interfaces with `interface: Eq + Show`; qualify imported bounds as `T: views.Show`. Define methods in the receiver type's module with `pub fn Widget.show(value: Widget) -> Str { ... }`. `value.show()` passes the receiver first; `Widget.show(value)` calls the same function. A normal module function taking the receiver first is also eligible. Function-valued fields take precedence. Cross-module calls require pub. Resolution is static; imports cannot add or override methods. Interface signatures have no bodies, contracts, method type parameters or mutable parameters; the first parameter is Self. Concrete fs/os effects are allowed. Interfaces are bounds, not runtime value types. Eq, Ord and Key are ordinary prelude interfaces; primitive implementations are intrinsic. Operators use eq and compare for custom types. Map keys use eq and hash; equal keys must have equal hashes, and implementations must obey comparison laws.\n")
    strings.add(mut out, "```text\n" + interfaces.source() + "```\n\n")
    strings.add(mut out, "`let x = value` infers a type; `let x: Int = 1` annotates it. `let mut x = value` allows reassignment and changes to its fields/elements. Values have copy semantics: assignment, arguments, returns and closure captures copy logically. Arrays/maps/strings share storage until a change, then copy. Changing a copy never changes the original. String elements cannot be assigned. Struct fields use `x.field`.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "`[1, 2]` is an array `[Int]`. Annotate an empty array: `let xs: [Int] = []`. Indexes start at 0. `xs[a..b]` copies an array slice; `s[a..b]` shares immutable string bytes. Both exclude b; strings index to Byte and positions count bytes. `len(s)` counts bytes. `for x in xs` visits elements; `for i in 0..n` excludes n; use an explicit bound for an inclusive loop. In match patterns, `a..=b` includes b. `for condition { ... }` is a while loop; `for { ... }` repeats indefinitely. `break`, `continue`, `return value`, and `return` behave as named. `if condition { ... } else if ... else { ... }` controls statements; use a match expression for conditional values.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "A map is `Map[K, V]`; keys satisfy Key. Write `let mut m: Map[Str, Int] = [:]` or `[\"a\": 1]`. `m[key] = value` inserts/replaces; `m[key]` panics if absent. Use maps.get for optional lookup. `for key in maps.keys(m)` visits keys in insertion order. Maps and arrays are values: pass them with `mut` to change a caller's copy.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "## Functions, mutation and generics\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "`fn f(x: Int) -> Int { return x + 1 }` defines a function; omitting `->` means it returns nothing. Parameter types are required. Functions returning values must return on every path. A parameter is read-only unless declared `x: mut T`. A call must say `f(mut x)`. No two mutable arguments may refer to the same variable or overlapping parts; arguments read while another argument mutates them can also be rejected. Compute a temporary first. Local mutability alone does not make a parameter mutable.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "Function values have types such as `fn(Int) -> Int` and `fn(Str) -> Str uses fs`. Write `fn(x: Int) -> Int { return x * 2 }` or `fn(x) => x * 2`; parameter/result types can be inferred from context. Named user functions are values; built-ins must be wrapped in closures. Captured values are snapshots and cannot be mutated from the closure. Function values have no mut parameters.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "Generics use `fn identity[T](x: T) -> T { return x }` and `type Box[T] = struct { value: T }`. Type arguments are inferred from arguments and expected return types, not written at call sites: `let b: Box[Int] = Box { value: 1 }`. Bounds are `Eq` for equality, `Ord` for ordering, `Key` for map keys/hashable values; combine with `+`. For example `fn greater[T: Ord](a: T, b: T) -> T`. These are built-in bounds; user interfaces are a later milestone.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "## Types, matching and errors\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "`type Point = struct { x: Int, y: Int }` defines a record; construct every field with `Point { x: 1, y: 2 }`. `type Shape = enum { Empty, Circle(Float), Pair(Int, Int) }` defines variants; construct `Shape.Empty` or `Shape.Circle(2.0)`. Payloads are positional. Variants can carry arrays, structs, other enums and recursive values.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "`Option[T]` has `Some(T)` and `None`. `Result[T, E]` has `Ok(T)` and `Err(E)`. They are built in; annotate ambiguous constructors (`let r: Result[Int, Str] = Ok(1)`). A postfix `?` unwraps Some/Ok and returns None/Err from the enclosing function, which must return a compatible Option/Result. It does not throw exceptions. Use explicit matches for deliberate conversion between error types.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "`match value { Some(x) => x, None => 0 }` is an expression; arms must agree in type and cover every case. A statement match may use blocks. `_` matches anything; names bind; variants destructure payloads. Literal and range patterns are supported. Put a fallback last. A bound variable is read-only. A new enum variant requires updating matches.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "## Modules and packages\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "`import text` loads `text.vl` beside the program, otherwise from std or declared dependencies. Call `text.trim(s)`; refer to `geometry.Point`. Imports do not open names. Declarations are private by default; `pub fn` and `pub type` export them. A public function's exposed types must also be public. A module may define `push`, `len`, or other built-in function names; the module's function wins in its own scope, and outside it is qualified. Import cycles and duplicate declarations are errors.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "`vela new NAME` creates a program; `vela new --package NAME` creates a package. A `vela.mod` starts with `package NAME` and names dependencies with `use NAME SOURCE [REF]`. Sources are git repositories or local directories. `vela get` fetches and pins them in `vela.lock`; `vela get -u` updates pins. Builds never fetch. `json` is a separate package, not std: add it with vela get before `import json`.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "## Effects, contracts, tests and concurrency\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "Functions reading files declare `uses fs`; functions using process arguments, environment, subprocesses, stdin, or executable path declare `uses os`. Effects propagate through calls and function values. Main and test blocks may use any effect. Printing and os.write are effect-free. `fn map[T, U](xs: [T], f: fn(T) -> U) -> [U] uses f` means the caller inherits the argument function's effects. An ordinary pure function parameter cannot be called with an effectful function.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "Add contracts after the signature and before its body: `requires n >= 0` and `ensures result >= 0`. Each clause is Bool and is checked at runtime. `result` names a returned value in ensures; mut parameters there hold their return-time values. Contracts must not have effects. Contract violations and assert failures panic; they are not Result errors. A panic exits 101; compiler errors exit 1, bad command lines 2, internal compiler errors 70.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "A top-level `test \"description\" { ... }` uses `assert(condition)`. Fakes isolate effects with `with files = [\"data.txt\": \"contents\"] { ... }`, `with args = [\"program\", \"arg\"] { ... }`, `with env = [\"KEY\": \"value\"] { ... }`, and `with stdin = \"input\\n\" { ... }`. Capture output with `let mut out: [Str] = []` and `with stdout = mut out { ... }`. Fakes are restored on every exit. Tests can live in libraries and are run by vela test. Check formatting and warnings as well as errors.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "`tasks.map(xs, f)` computes results on worker threads and returns them in input order; `tasks.each(xs, f)` returns nothing. They join before returning and propagate f's effects. Captured values are copies; use the returned array to collect results. `tasks.workers()` reports worker count; `VELA_THREADS` chooses it. No shared mutable closure captures or async syntax.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "## Complete examples\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "```vela\n")
    strings.add(mut out, "import strings\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "fn twice(x: Int) -> Int { return x * 2 }\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "fn main() {\n")
    strings.add(mut out, "    let mut xs = [1, 2]\n")
    strings.add(mut out, "    push(mut xs, 3)\n")
    strings.add(mut out, "    for x in xs {\n")
    strings.add(mut out, "        print(strings.from_int(twice(x)))\n")
    strings.add(mut out, "    }\n")
    strings.add(mut out, "}\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "test \"copies and mutation\" {\n")
    strings.add(mut out, "    let a = [1, 2]\n")
    strings.add(mut out, "    let mut b = a\n")
    strings.add(mut out, "    b[0] = 9\n")
    strings.add(mut out, "    assert(a[0] == 1)\n")
    strings.add(mut out, "    assert(b[0] == 9)\n")
    strings.add(mut out, "}\n")
    strings.add(mut out, "```\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "```vela\n")
    strings.add(mut out, "import files\n")
    strings.add(mut out, "import text\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "fn read_count(path: Str) -> Result[Int, Str] uses fs {\n")
    strings.add(mut out, "    let contents = files.read(path)?\n")
    strings.add(mut out, "    return Ok(len(text.lines(contents)))\n")
    strings.add(mut out, "}\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "fn main() {\n")
    strings.add(mut out, "    match read_count(\"data.txt\") {\n")
    strings.add(mut out, "        Ok(n) => print(n)\n")
    strings.add(mut out, "        Err(e) => print(e)\n")
    strings.add(mut out, "    }\n")
    strings.add(mut out, "}\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "test \"fake filesystem\" {\n")
    strings.add(mut out, "    with files = [\"data.txt\": \"one\\ntwo\\n\"] {\n")
    strings.add(mut out, "        match read_count(\"data.txt\") {\n")
    strings.add(mut out, "            Ok(n) => assert(n == 2)\n")
    strings.add(mut out, "            Err(_) => assert(false)\n")
    strings.add(mut out, "        }\n")
    strings.add(mut out, "    }\n")
    strings.add(mut out, "}\n")
    strings.add(mut out, "```\n")
    strings.add(mut out, "\n## Keywords (from the lexer)\n\n")
    for k in lexer.keywords() {
        strings.add(mut out, lexer.kind_name(k) + " ")
    }
    strings.add(mut out, "\n\n## Built-in functions (from the compiler index)\n\n")
    for name in checker.prelude() {
        builtin(mut out, "", name)
    }
    for module in modules.builtin_modules() {
        strings.add(mut out, "\n### import " + module + "\n\n")
        for name in modules.builtin_functions(module) {
            builtin(mut out, module, name)
        }
    }
    for module in ["bytes", "lists", "text"] {
        strings.add(mut out, "\n## import " + module + " (from std/" + module + ".vl)\n\n")
        let path = modules.join(modules.join(root, "std"), module + ".vl")
        match files.read(path) {
            Ok(source) => {
                let tokens = lexer.tokenize(source)
                let parsed = parser.parse(tokens.tokens, 0)
                if len(tokens.errors) > 0 || len(parsed.errors) > 0 {
                    os.eprint("vela: error: cannot generate guide from " + path + " [E6007]")
                    os.exit(1)
                }
                for f in parsed.program.fns {
                    if f.public {
                        strings.add(mut out, "- `" + index.signature(f) + "`\n")
                        for e in f.requires {
                            strings.add(mut out, "  requires `" + ast.expr_text(e) + "`\n")
                        }
                        for e in f.ensures {
                            strings.add(mut out, "  ensures `" + ast.expr_text(e) + "`\n")
                        }
                    }
                }
            }
            Err(e) => {
                os.eprint("vela: error: " + e + " [E6001]")
                os.exit(1)
            }
        }
    }
    return strings.build(out)
}

fn builtin(out: mut strings.Builder, module: Str, name: Str) {
    let mut full = name
    if module != "" {
        full = module + "." + name
    }
    let info = index.builtin_info(full)
    if len(info) == 2 {
        strings.add(mut out, "- `" + full + "`: `" + info[0] + "`. " + info[1] + "\n")
    }
}
