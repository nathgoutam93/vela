// How Vela's types are laid out in C and how their memory is managed: a
// port of stage0/c_layout.py, which explains tagged unions, boxing of
// recursive fields, managed types and the generated retain/release
// functions. Since M10c the C is no longer Stage 0's line for line: share
// functions for threads (M13) and names for packages' modules (M14) are
// Stage 1's alone.
import maps
import strings
import types

pub type Layout = struct {
    table: types.Table
    types: [Int]  // every struct and enum: user types in program order, then Option and Result instances
    element_types: [Int]  // every type held by an array or map
    names: Map[Int, Str]  // C names of structs and enums
    used: Map[Str, Bool]
    tags: Map[Str, Str]  // by "type variant": C names of enum tags
    boxed: Map[Str, Bool]  // by "type slot index": slots stored in a box
    box_types: [Int]  // the types that live in boxes, in order
    managed_cache: Map[Int, Bool]
    compact: Map[Int, Int]  // boxed enums whose empty variant can be NULL
    funcs: [Int]  // function types, which are C function pointer typedefs
}

// The C name of `name` in `module`, with the module's length in front so
// two different pairs never give the same name (see Stage 0). A package's
// own module, `greet.util`, cannot go into C as it is: each part goes in
// with its length, after a 0, which no other name starts with (a name in
// the main module starts with a letter or _, another module's with its
// length, which is never 0): `05greet4util_hello`.
pub fn mangle(module: Str, name: Str) -> Str {
    if module == "" {
        return name
    }
    let mut dot = -1
    for i in 0..len(module) {
        if module[i] == '.' {
            dot = i
        }
    }
    if dot < 0 {
        return strings.from_int(len(module)) + module + "_" + name
    }
    let mut b = strings.builder()
    strings.add_byte(mut b, '0')
    let mut start = 0
    for i in 0..len(module) + 1 {
        if i == len(module) || module[i] == '.' {
            strings.add_int(mut b, i - start)
            strings.add(mut b, module[start..i])
            start = i + 1
        }
    }
    strings.add(mut b, "_" + name)
    return strings.build(b)
}

test "C names of a module's things" {
    assert(mangle("", "main") == "main")
    assert(mangle("lexer", "Token") == "5lexer_Token")
    assert(mangle("greet.util", "hello") == "05greet4util_hello")
}

fn primitive_c(t: Int) -> Str {
    return match t {
        1 => "int64_t"
        2 => "uint8_t"
        3 => "bool"
        4 => "vela_str"
        5 => "vela_unit"
        7 => "double"
        _ => ""
    }
}

fn runtime_descriptor(t: Int) -> Str {
    return match t {
        1 => "&vela_type_int"
        2 => "&vela_type_byte"
        3 => "&vela_type_bool"
        4 => "&vela_type_str"
        5 => "&vela_type_unit"
        7 => "&vela_type_float"
        _ => ""
    }
}

fn is_array_like(table: types.Table, t: Int) -> Bool {
    return t == types.BUILDER() || types.is_array(table, t)
}

pub fn new_layout(table: types.Table, user_types: [Int], element_types: [Int]) -> Layout {
    let mut all = user_types
    for t in table.instances {
        // A type that mentions a type parameter exists only in the checker.
        if !types.is_open(table, t) {
            push(mut all, t)
        }
    }
    let mut l = Layout {
        table: table, types: all, element_types: element_types, names: [:], used: [:], tags: [:], boxed: [:],
        box_types: [], managed_cache: [:], compact: [:], funcs: [],
    }
    for t in all {
        let name = unique(mut l, base_name(l, t))
        l.names[t] = name
    }
    for t in all {
        let ti = types.get(table, t)
        if ti.tag == types.Tag.Enum {
            for v in ti.variants {
                let tag = unique(mut l, l.names[t] + "_" + v.name)
                l.tags[strings.from_int(t) + " " + v.name] = tag
            }
        }
    }
    for t in 0..len(table.types) {
        let ti = types.get(table, t)
        if ti.tag == types.Tag.Func && !ti.open && ti.plain < 0 {  // not one erased to another (M15)
            push(mut l.funcs, t)
        }
    }
    for t in l.funcs {
        let name = unique(mut l, suffix(l, t))
        l.names[t] = name
    }
    find_boxed(mut l)
    for t in all {
        for s in slots(l, t) {
            if is_boxed(l, t, s.name, s.index) && !contains_int(l.box_types, s.ty) {
                push(mut l.box_types, s.ty)
            }
        }
    }
    for t in l.box_types {
        let vi = compact_shape(l, t)
        if vi < 0 {
            continue
        }
        // Struct fields can be passed by mutable address. Keep their boxed
        // enum values addressable; compact payloads are reconstructed views.
        let mut addressable = false
        for outer in l.types {
            let ti = types.get(l.table, outer)
            if ti.tag == types.Tag.Struct {
                for f in ti.fields {
                    if f.ty == t && is_boxed(l, outer, f.name, 0) {
                        addressable = true
                    }
                }
            }
        }
        if !addressable {
            l.compact[t] = vi
        }
    }
    return l
}

fn contains_int(xs: [Int], x: Int) -> Bool {
    for y in xs {
        if y == x {
            return true
        }
    }
    return false
}

// `name`, or `name_2`, `name_3`... if a different type already took it.
fn unique(l: mut Layout, name: Str) -> Str {
    let mut n = 2
    let mut out = name
    for maps.has(l.used, out) {
        out = name + "_" + strings.from_int(n)
        n = n + 1
    }
    l.used[out] = true
    return out
}

fn base_name(l: Layout, t: Int) -> Str {
    let ti = types.get(l.table, t)
    if types.is_builtin_enum(l.table, t) {
        let mut b = strings.builder()
        strings.add(mut b, ti.name)
        for a in ti.args {
            strings.add(mut b, "_" + suffix(l, a))
        }
        return strings.build(b)
    }
    if ti.origin >= 0 {
        return "t_" + suffix(l, t)
    }
    return "t_" + mangle(ti.module, ti.name)
}

// How a type argument reads inside a generated name: Int, Token, Option_Int,
// Pair_Int_Str.
pub fn suffix(l: Layout, t: Int) -> Str {
    let ti = types.get(l.table, t)
    if primitive_c(t) != "" {
        return ti.name
    }
    if types.is_array(l.table, t) {
        return "Array_" + suffix(l, ti.args[0])
    }
    if types.is_map(l.table, t) {
        return "Map_" + suffix(l, ti.args[0]) + "_" + suffix(l, ti.args[1])
    }
    if t == types.BUILDER() {
        return "7strings_Builder"
    }
    if ti.tag == types.Tag.Func {
        // fn_Int_Str__Bool for fn(Int, Str) -> Bool
        let mut b = strings.builder()
        strings.add(mut b, "fn")
        for a in ti.args {
            strings.add(mut b, "_" + suffix(l, a))
        }
        if len(ti.args) == 0 {
            strings.add(mut b, "_void")
        }
        if ti.result >= 0 {
            strings.add(mut b, "__" + suffix(l, ti.result))
        } else {
            strings.add(mut b, "__void")
        }
        return strings.build(b)
    }
    if types.is_builtin_enum(l.table, t) {
        return base_name(l, t)
    }
    let mut b = strings.builder()
    strings.add(mut b, mangle(ti.module, ti.name))
    if ti.origin >= 0 {
        for a in ti.args {
            strings.add(mut b, "_" + suffix(l, a))
        }
    }
    return strings.build(b)
}

pub fn c_type(l: Layout, t: Int) -> Str {
    if t == types.NOTHING() {
        return "void"
    }
    if is_array_like(l.table, t) {
        return "vela_array *"
    }
    if types.is_map(l.table, t) {
        return "vela_map *"
    }
    let p = primitive_c(t)
    if p != "" {
        return p
    }
    return l.names[t]
}

pub fn name_of(l: Layout, t: Int) -> Str {
    return l.names[t]
}

pub fn tag(l: Layout, enum: Int, variant: Str) -> Str {
    return l.tags[strings.from_int(enum) + " " + variant]
}

pub fn box_name(l: Layout, t: Int) -> Str {
    return "box_" + l.names[t]
}

// Exactly one empty and one carrying variant: the empty box is NULL;
// allocated boxes need only the carrying variant's payload, without a tag.
pub fn compact_variant(l: Layout, t: Int) -> Int {
    return match maps.get(l.compact, t) {
        Some(vi) => vi
        None => -1
    }
}

fn compact_shape(l: Layout, t: Int) -> Int {
    let ti = types.get(l.table, t)
    if ti.tag != types.Tag.Enum || len(ti.variants) != 2 {
        return -1
    }
    if len(ti.variants[0].payload) == 0 && len(ti.variants[1].payload) > 0 {
        return 1
    }
    if len(ti.variants[1].payload) == 0 && len(ti.variants[0].payload) > 0 {
        return 0
    }
    return -1
}

pub fn box_value(l: Layout, t: Int, c: Str) -> Str {
    if compact_variant(l, t) >= 0 {
        return box_name(l, t) + "_get(" + c + ")"
    }
    return c + "->value"
}

// ---- Boxing ----

pub type Slot = struct {
    name: Str  // the field, or the variant
    index: Int  // the payload index (0 for a field)
    ty: Int
}

// The places inside `t` that hold other values by value.
pub fn slots(l: Layout, t: Int) -> [Slot] {
    let mut out: [Slot] = []
    let ti = types.get(l.table, t)
    if ti.tag == types.Tag.Struct {
        for f in ti.fields {
            push(mut out, Slot { name: f.name, index: 0, ty: f.ty })
        }
    } else if ti.tag == types.Tag.Enum {
        for v in ti.variants {
            for i in 0..len(v.payload) {
                push(mut out, Slot { name: v.name, index: i, ty: v.payload[i] })
            }
        }
    }
    return out
}

// Whether a value of `outer` holds a `target` by value, at any depth.
fn contains(l: Layout, outer: Int, target: Int) -> Bool {
    let mut seen: Map[Int, Bool] = [:]
    let mut stack = [outer]
    for len(stack) > 0 {
        let t = stack[len(stack) - 1]
        stack = stack[0..len(stack) - 1]
        if t == target {
            return true
        }
        if maps.has(seen, t) {
            continue
        }
        seen[t] = true
        for s in slots(l, t) {
            push(mut stack, s.ty)
        }
    }
    return false
}

fn slot_key(t: Int, name: Str, index: Int) -> Str {
    return strings.from_int(t) + " " + name + " " + strings.from_int(index)
}

// Box every slot of a user type whose type leads back to that type.
fn find_boxed(l: mut Layout) {
    for t in l.types {
        if types.is_builtin_enum(l.table, t) {
            continue
        }
        for s in slots(l, t) {
            if contains(l, s.ty, t) {
                l.boxed[slot_key(t, s.name, s.index)] = true
            }
        }
    }
}

pub fn is_boxed(l: Layout, t: Int, name: Str, index: Int) -> Bool {
    return maps.has(l.boxed, slot_key(t, name, index))
}

// ---- Managed types ----

// Whether values of `t` hold references that must be counted.
pub fn managed(l: mut Layout, t: Int) -> Bool {
    if t == types.NOTHING() || primitive_c(t) != "" && t != types.STR() {
        return false
    }
    if t == types.STR() || is_array_like(l.table, t) || types.is_map(l.table, t) || types.is_func(l.table, t) {
        return true
    }
    match maps.get(l.managed_cache, t) {
        Some(m) => return m
        None => {}
    }
    l.managed_cache[t] = false  // in progress: only boxed slots lead back here
    let mut result = false
    for s in slots(l, t) {
        if is_boxed(l, t, s.name, s.index) || managed(mut l, s.ty) {
            result = true
            break
        }
    }
    l.managed_cache[t] = result
    return result
}

// A C statement retaining the value `c` of type `t`, or "".
pub fn retain(l: mut Layout, t: Int, c: Str) -> Str {
    if !managed(mut l, t) {
        return ""
    }
    if t == types.STR() {
        return "vela_str_retain(" + c + ");"
    }
    if is_array_like(l.table, t) {
        return "vela_array_retain(" + c + ");"
    }
    if types.is_map(l.table, t) {
        return "vela_map_retain(" + c + ");"
    }
    return "rc_retain_" + l.names[t] + "(" + c + ");"
}

pub fn release(l: mut Layout, t: Int, c: Str) -> Str {
    if !managed(mut l, t) {
        return ""
    }
    if t == types.STR() {
        return "vela_str_release(" + c + ");"
    }
    if is_array_like(l.table, t) {
        return "vela_array_release(" + c + ");"
    }
    if types.is_map(l.table, t) {
        return "vela_map_release(" + c + ");"
    }
    return "rc_release_" + l.names[t] + "(" + c + ");"
}

// A C statement marking what the value `c` of type `t` holds as shared
// between threads, or "".
pub fn share(l: mut Layout, t: Int, c: Str) -> Str {
    if !managed(mut l, t) {
        return ""
    }
    if t == types.STR() {
        return "vela_str_share(" + c + ");"
    }
    if is_array_like(l.table, t) {
        return "vela_array_share(" + c + ");"
    }
    if types.is_map(l.table, t) {
        return "vela_map_share(" + c + ");"
    }
    return "rc_share_" + l.names[t] + "(" + c + ");"
}

// A C expression for the vela_type describing `t` to arrays and maps.
pub fn descriptor(l: Layout, t: Int) -> Str {
    let d = runtime_descriptor(t)
    if d != "" {
        return d
    }
    if is_array_like(l.table, t) {
        return "&vela_type_array"
    }
    if types.is_map(l.table, t) {
        return "&vela_type_map"
    }
    return "vt_" + l.names[t] + "()"
}

// ---- Definitions ----

// C declarations for every type, each after the types it contains by
// value, then the functions that manage their memory.
pub fn definitions(l: mut Layout) -> [Str] {
    let mut out: [Str] = []
    for t in l.types {
        push(mut out, "typedef struct " + l.names[t] + " " + l.names[t] + ";")
    }
    for t in l.box_types {
        push(mut out, "typedef struct " + box_name(l, t) + " " + box_name(l, t) + ";")
    }
    // After the struct names, which their parameters may mention: a
    // prototype may have parameters of a struct type not yet defined.
    for t in l.funcs {
        let ti = types.get(l.table, t)
        let mut params = strings.builder()
        strings.add(mut params, "vela_env *")
        for i in 0..len(ti.args) {
            strings.add(mut params, ", " + c_type(l, ti.args[i]))
        }
        // A function value: code, and the environment it gets first (NULL
        // for a named function).
        push(mut out, "typedef struct { " + c_type(l, ti.result) + " (*fn)(" + strings.build(params) + "); vela_env *env; } " +
            l.names[t] + ";")
    }
    let mut done: Map[Int, Bool] = [:]
    for t in l.types {
        define(mut l, t, mut done, mut out)
    }
    for line in memory_functions(mut l) {
        push(mut out, line)
    }
    return out
}

fn define(l: mut Layout, t: Int, done: mut Map[Int, Bool], out: mut [Str]) {
    if maps.has(done, t) || primitive_c(t) != "" || is_array_like(l.table, t) || types.is_map(l.table, t) ||
        types.is_func(l.table, t) {
        return
    }
    done[t] = true
    for s in slots(l, t) {
        if !is_boxed(l, t, s.name, s.index) {
            define(mut l, s.ty, mut done, mut out)
        }
    }
    let name = l.names[t]
    let ti = types.get(l.table, t)
    push(mut out, "")
    if ti.tag == types.Tag.Struct {
        push(mut out, "struct " + name + " {")
        for f in ti.fields {
            push(mut out, "    " + member(l, t, f.name, 0, f.ty, "m_" + f.name) + ";")
        }
        push(mut out, "};")
    } else {
        let mut tags = strings.builder()
        strings.add(mut tags, "enum { ")
        for i in 0..len(ti.variants) {
            if i > 0 {
                strings.add(mut tags, ", ")
            }
            strings.add(mut tags, tag(l, t, ti.variants[i].name))
        }
        strings.add(mut tags, " };")
        push(mut out, strings.build(tags))
        push(mut out, "struct " + name + " {")
        push(mut out, "    int32_t tag;")
        let mut carrying = false
        for v in ti.variants {
            if len(v.payload) > 0 {
                carrying = true
            }
        }
        if carrying {  // C does not allow an empty union
            push(mut out, "    union {")
            for v in ti.variants {
                if len(v.payload) == 0 {
                    continue
                }
                let mut members = strings.builder()
                for i in 0..len(v.payload) {
                    if i > 0 {
                        strings.add_byte(mut members, ' ')
                    }
                    strings.add(mut members, member(l, t, v.name, i, v.payload[i], "_" + strings.from_int(i)) + ";")
                }
                push(mut out, "        struct { " + strings.build(members) + " } m_" + v.name + ";")
            }
            push(mut out, "    } as;")
        }
        push(mut out, "};")
    }
    if contains_int(l.box_types, t) {
        let vi = compact_variant(l, t)
        if vi < 0 {
            push(mut out, "struct " + box_name(l, t) + " { int64_t rc; " + name + " value; };")
        } else {
            let b = box_name(l, t)
            let v = ti.variants[vi]
            push(mut out, "struct " + b + " { int64_t rc;")
            let mut fields = ""
            for i in 0..len(v.payload) {
                let m = "_" + strings.from_int(i)
                push(mut out, "    " + member(l, t, v.name, i, v.payload[i], m) + ";")
                if i > 0 {
                    fields = fields + ", "
                }
                fields = fields + "." + m + " = b->" + m
            }
            push(mut out, "};")
            push(mut out, "static inline VELA_UNUSED " + name + " " + b + "_get(" + b + " *b) {")
            push(mut out, "    if (!b) return (" + name + "){.tag = " + tag(l, t, ti.variants[1 - vi].name) + "};")
            push(mut out, "    return (" + name + "){.tag = " + tag(l, t, v.name) + ", .as.m_" + v.name + " = {" + fields + "}};")
            push(mut out, "}")
        }
    }
}

// A member declaration: `int64_t m_x`, or `box_t_Expr *_0` when boxed.
fn member(l: Layout, t: Int, name: Str, index: Int, slot_type: Int, m: Str) -> Str {
    if is_boxed(l, t, name, index) {
        return box_name(l, slot_type) + " *" + m
    }
    return c_type(l, slot_type) + " " + m
}

// Statements retaining (op "retain"), releasing ("release") or sharing
// ("share") one slot.
fn slot_ops(l: mut Layout, t: Int, name: Str, index: Int, slot_type: Int, c: Str, op: Str) -> [Str] {
    if is_boxed(l, t, name, index) {
        if op == "retain" {
            if compact_variant(l, slot_type) >= 0 {
                return ["if (" + c + ") vela_rc_inc(&" + c + "->rc);"]
            }
            return ["vela_rc_inc(&" + c + "->rc);"]
        }
        return [box_name(l, slot_type) + "_" + op + "(" + c + ");"]
    }
    let mut s = ""
    if op == "retain" {
        s = retain(mut l, slot_type, c)
    } else if op == "release" {
        s = release(mut l, slot_type, c)
    } else {
        s = share(mut l, slot_type, c)
    }
    if s == "" {
        let none: [Str] = []
        return none
    }
    return [s]
}

// rc_retain_T / rc_release_T / rc_share_T for every managed struct and
// enum, box helpers for every boxed type, and descriptors for element types.
fn memory_functions(l: mut Layout) -> [Str] {
    let mut managed_types: [Int] = []
    for t in l.types {
        if managed(mut l, t) {
            push(mut managed_types, t)
        }
    }
    let mut out = [""]
    // Function values count their environment's references.
    for t in l.funcs {
        let n = l.names[t]
        push(mut out, "static inline VELA_UNUSED void rc_retain_" + n + "(" + n + " v) { vela_env_retain(v.env); }")
        push(mut out, "static inline VELA_UNUSED void rc_release_" + n + "(" + n + " v) { vela_env_release(v.env); }")
        push(mut out, "static inline VELA_UNUSED void rc_share_" + n + "(" + n + " v) { vela_env_share(v.env); }")
    }
    for t in managed_types {
        let n = l.names[t]
        push(mut out, "static inline VELA_UNUSED void rc_retain_" + n + "(" + n + " v);")
        push(mut out, "static inline VELA_UNUSED void rc_release_" + n + "(" + n + " v);")
        push(mut out, "static inline VELA_UNUSED void rc_share_" + n + "(" + n + " v);")
    }
    for t in l.box_types {
        let b = box_name(l, t)
        push(mut out, "static inline VELA_UNUSED void " + b + "_release(" + b + " *b);")
        push(mut out, "static inline VELA_UNUSED void " + b + "_share(" + b + " *b);")
    }
    for t in managed_types {
        let n = l.names[t]
        let ti = types.get(l.table, t)
        for op in ["retain", "release", "share"] {
            push(mut out, "static inline VELA_UNUSED void rc_" + op + "_" + n + "(" + n + " v) {")
            if ti.tag == types.Tag.Struct {
                for f in ti.fields {
                    for s in slot_ops(mut l, t, f.name, 0, f.ty, "v.m_" + f.name, op) {
                        push(mut out, "    " + s)
                    }
                }
            } else {
                push(mut out, "    switch (v.tag) {")
                for v in ti.variants {
                    let mut body: [Str] = []
                    for i in 0..len(v.payload) {
                        let path = "v.as.m_" + v.name + "._" + strings.from_int(i)
                        for s in slot_ops(mut l, t, v.name, i, v.payload[i], path, op) {
                            push(mut body, s)
                        }
                    }
                    if len(body) > 0 {
                        let mut line = strings.builder()
                        strings.add(mut line, "    case " + tag(l, t, v.name) + ": ")
                        for i in 0..len(body) {
                            if i > 0 {
                                strings.add_byte(mut line, ' ')
                            }
                            strings.add(mut line, body[i])
                        }
                        strings.add(mut line, " break;")
                        push(mut out, strings.build(line))
                    }
                }
                push(mut out, "    default: break;")
                push(mut out, "    }")
            }
            push(mut out, "}")
        }
    }
    for t in l.box_types {
        let b = box_name(l, t)
        let n = l.names[t]
        if compact_variant(l, t) >= 0 {
            for line in compact_helpers(mut l, t) {
                push(mut out, line)
            }
            continue
        }
        let keep = retain(mut l, t, "copy->value")
        let drop = release(mut l, t, "b->value")
        let mut mark = share(mut l, t, "b->value")
        if mark == "" {
            mark = "(void)0;"
        }
        // A variant without values needs no box of its own: they all share
        // one that is never freed (a count of 0; see vela_rt.h).
        let mut fixed: [Str] = []
        let ti = types.get(l.table, t)
        if ti.tag == types.Tag.Enum {
            for v in ti.variants {
                if len(v.payload) == 0 {
                    let tg = tag(l, t, v.name)
                    push(mut fixed, "    if (value.tag == " + tg + ") { static " + b + " one = {0, {.tag = " + tg +
                        "}}; return &one; }")
                }
            }
        }
        push(mut out, "static inline VELA_UNUSED " + b + " *" + b + "_new(" + n + " value) {")
        for line in fixed {
            push(mut out, line)
        }
        for line in [
            "    " + b + " *b = vela_box_alloc(sizeof(" + b + "));",
            "    b->rc = 1;",
            "    b->value = value;",
            "    return b;",
            "}",
            "static inline VELA_UNUSED void " + b + "_release(" + b + " *b) {",
            "    if (vela_rc_dec(&b->rc)) { " + drop + " vela_box_free(b, sizeof(" + b + ")); }",
            "}",
            "static inline VELA_UNUSED void " + b + "_share(" + b + " *b) {",
            "    if (vela_rc_share(&b->rc)) { " + mark + " }",
            "}",
            "// Copy-on-write: a box about to change gets a copy if anything else shares it.",
            "static inline VELA_UNUSED void " + b + "_unique(" + b + " **b) {",
            "    if (vela_rc_unique(&(*b)->rc)) return;",
            "    " + b + " *copy = " + b + "_new((*b)->value);",
            "    " + keep,
            "    " + b + "_release(*b);",
            "    *b = copy;",
            "}",
        ] {
            push(mut out, line)
        }
    }
    for t in l.element_types {
        if runtime_descriptor(t) != "" || is_array_like(l.table, t) || types.is_map(l.table, t) {
            continue
        }
        let n = l.names[t]
        let mut funcs = "NULL, NULL"
        let mut mark = "NULL"
        if managed(mut l, t) {
            push(mut out, "static inline VELA_UNUSED void vt_retain_" + n + "(void *p) { rc_retain_" + n + "(*(" + n + " *)p); }")
            push(mut out, "static inline VELA_UNUSED void vt_release_" + n + "(void *p) { rc_release_" + n + "(*(" + n + " *)p); }")
            push(mut out, "static inline VELA_UNUSED void vt_share_" + n + "(void *p) { rc_share_" + n + "(*(" + n + " *)p); }")
            funcs = "vt_retain_" + n + ", vt_release_" + n
            mark = "vt_share_" + n
        }
        push(mut out, "static inline VELA_UNUSED const vela_type *vt_" + n + "(void) {")
        push(mut out, "    static const vela_type t = {sizeof(" + n + "), " + funcs + ", NULL, NULL, " + mark + "};")
        push(mut out, "    return &t;")
        push(mut out, "}")
    }
    return out
}

fn compact_helpers(l: mut Layout, t: Int) -> [Str] {
    let b = box_name(l, t)
    let n = l.names[t]
    let vi = compact_variant(l, t)
    let v = types.get(l.table, t).variants[vi]
    let mut out = ["static inline VELA_UNUSED " + b + " *" + b + "_new(" + n + " value) {",
        "    if (value.tag != " + tag(l, t, v.name) + ") return NULL;",
        "    " + b + " *b = vela_box_alloc(sizeof(" + b + "));", "    b->rc = 1;"]
    for i in 0..len(v.payload) {
        let m = "_" + strings.from_int(i)
        push(mut out, "    b->" + m + " = value.as.m_" + v.name + "." + m + ";")
    }
    push(mut out, "    return b;")
    push(mut out, "}")
    let mut tail = -1
    for i in 0..len(v.payload) {
        if v.payload[i] == t && is_boxed(l, t, v.name, i) {
            tail = i
        }
    }
    for op in ["release", "share"] {
        push(mut out, "static inline VELA_UNUSED void " + b + "_" + op + "(" + b + " *b) {")
        let mut check = "vela_rc_dec"
        if op == "share" {
            check = "vela_rc_share"
        }
        if tail >= 0 {
            push(mut out, "    while (b) {")
            push(mut out, "    if (!" + check + "(&b->rc)) return;")
            push(mut out, "    " + b + " *next = b->_" + strings.from_int(tail) + ";")
        } else {
            push(mut out, "    if (!b || !" + check + "(&b->rc)) return;")
        }
        for i in 0..len(v.payload) {
            if i == tail {
                continue
            }
            for line in slot_ops(mut l, t, v.name, i, v.payload[i], "b->_" + strings.from_int(i), op) {
                push(mut out, "    " + line)
            }
        }
        if op == "release" {
            push(mut out, "    vela_box_free(b, sizeof(" + b + "));")
        }
        if tail >= 0 {
            push(mut out, "    b = next;")
            push(mut out, "    }")
        }
        push(mut out, "}")
    }
    push(mut out, "static inline VELA_UNUSED void " + b + "_unique(" + b + " **b) {")
    push(mut out, "    if (!*b || vela_rc_unique(&(*b)->rc)) return;")
    push(mut out, "    " + n + " value = " + b + "_get(*b);")
    push(mut out, "    " + retain(mut l, t, "value"))
    push(mut out, "    " + b + " *copy = " + b + "_new(value);")
    push(mut out, "    " + b + "_release(*b);")
    push(mut out, "    *b = copy;")
    push(mut out, "}")
    return out
}
