// Retained immutable snapshots; mutation of a source array uses copy-on-write.
pub type Slice[T] = struct { storage: [T], start: Int, size: Int }
pub fn of[T](data: [T]) -> Slice[T] { return range(data, 0, len(data)) }
pub fn range[T](data: [T], start: Int, end: Int) -> Slice[T]
    requires start >= 0 && start <= end && end <= len(data) {
    return Slice { storage: data, start: start, size: end - start }
}
pub fn length[T](view: Slice[T]) -> Int { return view.size }
pub fn get[T](view: Slice[T], index: Int) -> T
    requires index >= 0 && index < view.size {
    return view.storage[view.start + index]
}
pub fn sub[T](view: Slice[T], start: Int, end: Int) -> Slice[T]
    requires start >= 0 && start <= end && end <= view.size {
    return Slice { storage: view.storage, start: view.start + start, size: end - start }
}
pub fn to_array[T](view: Slice[T]) -> [T] { return view.storage[view.start..view.start + view.size] }
pub fn text(data: Str, start: Int, end: Int) -> Str { return data[start..end] }

test "views retain a snapshot through mutation and return" {
    let mut data = [1, 2, 3]
    let view = range(data, 1, 3)
    data[1] = 20
    push(mut data, 4)
    assert(view.get(0) == 2 && view.length() == 2)
    assert(view.sub(1, 2).get(0) == 3)
    assert(to_array(view)[0] == 2)
    assert(text("abcdef", 1, 4) == "bcd")
}
