        7 => r"00Ag100Ah000Ai100Aj000Ak100Al000Am100An000Ao100B0000B1100B2E00B3500B8700B:000B;100B<000B=100B>000B?100B@000BA100BB000BC100BD000BE100BF000BG100BH000BI100BJ000BK100BL000BM100BN000BO100BP000BQ100BR000BS100BT000BU100BV000BW100BX000BY100BZ000B[100B\000B]100B^000B_100B`000Ba100Bb000Bc100Bd000Be100Bf000Bg100Bh000Bi100Bj000Bk1"
