// Strict RFC 3629 UTF-8 and Unicode scalar values; general categories,
// properties and case folding from the Unicode Character Database (the
// tables at the end); no normalization.
import strings
pub fn decode(s: Str) -> Result[[u32], Str] {
    let mut out: [u32] = []; let mut i = 0
    for i < len(s) {
        let lead = int(s[i]); let mut count = 1; let mut value = lead; let mut minimum = 0
        if lead >= 194 && lead <= 223 { count = 2; value = lead - 192; minimum = 128 } else if lead >= 224 && lead <= 239 { count = 3; value = lead - 224; minimum = 2048 } else if lead >= 240 && lead <= 244 { count = 4; value = lead - 240; minimum = 65536 } else if lead >= 128 { return Err("invalid UTF-8 lead byte") }
        if count > len(s) - i { return Err("truncated UTF-8") }
        for j in 1..count { let c = int(s[i + j]); if c < 128 || c > 191 { return Err("invalid UTF-8 continuation") }; value = value * 64 + c - 128 }
        if value < minimum || value > 1114111 || (value >= 55296 && value <= 57343) { return Err("invalid Unicode scalar") }
        push(mut out, u32(value)); i = i + count
    }; return Ok(out)
}
pub fn encode(points: [u32]) -> Result[Str, Str] {
    let mut b = strings.builder()
    for p in points {
        let n = int(p); if n > 1114111 || (n >= 55296 && n <= 57343) { return Err("invalid Unicode scalar") }
        if n < 128 { strings.add_byte(mut b, byte(n)) } else if n < 2048 { strings.add_byte(mut b, byte(192 + n / 64)); strings.add_byte(mut b, byte(128 + n % 64)) } else if n < 65536 { strings.add_byte(mut b, byte(224 + n / 4096)); strings.add_byte(mut b, byte(128 + n / 64 % 64)); strings.add_byte(mut b, byte(128 + n % 64)) } else { strings.add_byte(mut b, byte(240 + n / 262144)); strings.add_byte(mut b, byte(128 + n / 4096 % 64)); strings.add_byte(mut b, byte(128 + n / 64 % 64)); strings.add_byte(mut b, byte(128 + n % 64)) }
    }; return Ok(strings.build(b))
}
pub fn valid(s: Str) -> Bool { match decode(s) { Ok(_) => return true, Err(_) => return false } }
pub fn length(s: Str) -> Result[Int, Str] { return Ok(len(decode(s)?)) }
pub fn at(s: Str, index: Int) -> Result[u32, Str] { let xs = decode(s)?; if index < 0 || index >= len(xs) { return Err("code point index out of range") }; return Ok(xs[index]) }
pub fn slice(s: Str, start: Int, end: Int) -> Result[Str, Str] {
    let xs = decode(s)?; if start < 0 || end < start || end > len(xs) { return Err("code point range out of bounds") }; let mut out: [u32] = []; for i in start..end { push(mut out, xs[i]) }; return encode(out)
}

// The general category of a code point, as its two-letter name: "Lu",
// "Nd", ...; "Cn" (unassigned) for one that is not assigned or not a code
// point.
pub fn category(cp: Int) -> Str {
    let i = category_number(cp)
    return category_names()[2 * i..2 * i + 2]
}

// Whether a code point has a property: "Alphabetic", "White_Space",
// "Word" (a word character as UTS #18 defines \w: Alphabetic, a mark, a
// decimal digit, a connector punctuation or Join_Control), or a general
// category or group as `ranges` names them ("Lu", "L", "P", ...). False
// for another name.
pub fn has(cp: Int, name: Str) -> Bool {
    if name == "Word" {
        return in_ranges(WORD(), cp)
    }
    if name == "Alphabetic" {
        return in_ranges(ALPHABETIC(), cp)
    }
    if name == "White_Space" {
        return in_ranges(WHITE_SPACE(), cp)
    }
    let c = category(cp)
    return c == name || len(name) == 1 && c[0] == name[0] || name == "LC" && (c == "Lu" || c == "Ll" || c == "Lt")
}

// The simple case folding of a code point (CaseFolding.txt's C and S
// mappings): the code point itself if it has none.
pub fn simple_fold(cp: Int) -> Int {
    let i = last_from(FOLDS(), cp)
    if i < 0 || cp > field(FOLDS(), i, 4, 4) {
        return cp
    }
    return folded(FOLDS(), i, cp)
}

// Every code point with a simple case folding, and that folding, as
// pairs: [cp, folding, cp, folding, ...].
pub fn simple_folds() -> [Int] {
    let mut out: [Int] = []
    for i in 0..count(FOLDS()) {
        for cp in field(FOLDS(), i, 0, 4)..field(FOLDS(), i, 4, 4) + 1 {
            let f = folded(FOLDS(), i, cp)
            if f != cp {
                push(mut out, cp)
                push(mut out, f)
            }
        }
    }
    return out
}

// The code points of a general category ("Lu"), a group of them ("L",
// "LC" for Lu, Ll and Lt, "M", "N", "P", "S", "Z", "C"), or a property
// ("Alphabetic", "White_Space", "Word"), as sorted inclusive ranges:
// [lo, hi, lo, hi, ...]; [] for another name.
pub fn ranges(name: Str) -> [Int] {
    let mut out: [Int] = []
    let mut t = -1
    if name == "Alphabetic" {
        t = ALPHABETIC()
    } else if name == "White_Space" {
        t = WHITE_SPACE()
    } else if name == "Word" {
        t = WORD()
    }
    if t >= 0 {
        for i in 0..count(t) {
            push(mut out, field(t, i, 0, 4))
            push(mut out, field(t, i, 4, 4))
        }
        return out
    }
    let names = category_names()
    let mut chosen: [Bool] = []
    let mut any = false
    for k in 0..len(names) / 2 {
        let c = names[2 * k..2 * k + 2]
        let yes = c == name || len(name) == 1 && c[0] == name[0] || name == "LC" && (c == "Lu" || c == "Ll" || c == "Lt")
        push(mut chosen, yes)
        any = any || yes
    }
    if !any {
        return out
    }
    let n = count(CATEGORIES())
    for i in 0..n {
        if !chosen[field(CATEGORIES(), i, 4, 1)] {
            continue
        }
        let lo = field(CATEGORIES(), i, 0, 4)
        let mut hi = 0x10FFFF
        if i + 1 < n {
            hi = field(CATEGORIES(), i + 1, 0, 4) - 1
        }
        if len(out) > 0 && out[len(out) - 1] == lo - 1 {
            out[len(out) - 1] = hi  // runs of two categories of the group
        } else {
            push(mut out, lo)
            push(mut out, hi)
        }
    }
    return out
}

// ---- Reading the tables ----
//
// Each table is records of fixed-width base-64 numbers (a digit is the byte
// 48 + its value), sorted by the code point each starts with, in string
// literals of 64 records: static data, so a program that imports this
// module compiles almost as fast as before the tables.

fn CATEGORIES() -> Int {
    return 0
}

fn ALPHABETIC() -> Int {
    return 1
}

fn WHITE_SPACE() -> Int {
    return 2
}

fn WORD() -> Int {
    return 3
}

fn FOLDS() -> Int {
    return 4
}

fn FULL() -> Int {
    return 5
}

fn part(t: Int, k: Int) -> Str {
    return match t {
        0 => category_runs(k)
        1 => alphabetic_ranges(k)
        2 => white_space_ranges(k)
        3 => word_ranges(k)
        4 => fold_runs(k)
        _ => full_folds(k)
    }
}

fn width(t: Int) -> Int {
    return match t {
        0 => 5
        4 => 13
        5 => 16
        _ => 8
    }
}

fn count(t: Int) -> Int {
    return match t {
        0 => category_count()
        1 => alphabetic_count()
        2 => white_space_count()
        3 => word_count()
        4 => fold_count()
        _ => full_count()
    }
}

// The number of `digits` base-64 digits at `offset` in record `i` of table `t`.
fn field(t: Int, i: Int, offset: Int, digits: Int) -> Int {
    return number(part(t, i / 64), i % 64 * width(t) + offset, digits)
}

fn number(p: Str, at: Int, digits: Int) -> Int {
    let mut n = 0
    for k in at..at + digits {
        n = n * 64 + int(p[k]) - 48  // a digit is the byte 48 + its value
    }
    return n
}

// The last record of table `t` starting at or before `cp`, or -1: the last
// part whose first record does, then the record in that part.
fn last_from(t: Int, cp: Int) -> Int {
    let n = count(t)
    let mut lo = 0
    let mut hi = (n + 63) / 64
    for lo < hi {
        let mid = (lo + hi) / 2
        if number(part(t, mid), 0, 4) <= cp {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    let k = lo - 1
    if k < 0 {
        return -1
    }
    let p = part(t, k)
    let w = width(t)
    lo = 1
    hi = len(p) / w
    for lo < hi {
        let mid = (lo + hi) / 2
        if number(p, mid * w, 4) <= cp {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return k * 64 + lo - 1
}

fn in_ranges(t: Int, cp: Int) -> Bool {
    let i = last_from(t, cp)
    return i >= 0 && cp <= field(t, i, 4, 4)
}

fn category_number(cp: Int) -> Int {
    if cp < 0 || cp > 0x10FFFF {
        return 29  // Cn
    }
    if cp < 0x100 {
        return int(latin1_categories()[cp]) - 48
    }
    return field(CATEGORIES(), last_from(CATEGORIES(), cp), 4, 1)
}

// The folding of `cp` by fold run `i`, which holds it.
fn folded(t: Int, i: Int, cp: Int) -> Int {
    let kind = part(t, i / 64)[i % 64 * width(t) + 8]
    if kind == 'e' {
        return cp | 1
    }
    if kind == 'o' {
        return cp + (cp & 1)
    }
    return cp + field(t, i, 9, 4) - 0x800000
}

// The full case folding of a string, for caseless comparison: "Straße" and
// "STRASSE" both fold to "strasse". Bytes that are not UTF-8 stay as they
// are.
pub fn fold(s: Str) -> Str {
    let mut b = strings.builder()
    let mut i = 0
    for i < len(s) {
        let c = int(s[i])
        if c < 0x80 {
            if c >= 0x41 && c <= 0x5A {
                strings.add_byte(mut b, byte(c + 32))
            } else {
                strings.add_byte(mut b, s[i])
            }
            i = i + 1
            continue
        }
        let n = scalar_width(s, i)
        if n == 0 {
            strings.add_byte(mut b, s[i])
            i = i + 1
            continue
        }
        let cp = scalar_at(s, i, n)
        let k = last_from(FULL(), cp)
        if k >= 0 && field(FULL(), k, 0, 4) == cp {
            for j in 1..4 {
                let to = field(FULL(), k, 4 * j, 4)
                if to > 0 {
                    add_scalar(mut b, to)
                }
            }
        } else {
            add_scalar(mut b, simple_fold(cp))
        }
        i = i + n
    }
    return strings.build(b)
}

// The bytes of the UTF-8 scalar value starting at `i`, or 0 if none does.
fn scalar_width(s: Str, i: Int) -> Int {
    let lead = int(s[i])
    let mut n = 0
    let mut lo = 0x80
    let mut hi = 0xBF
    if lead >= 0xC2 && lead <= 0xDF {
        n = 2
    } else if lead >= 0xE0 && lead <= 0xEF {
        n = 3
        if lead == 0xE0 {
            lo = 0xA0  // not overlong
        } else if lead == 0xED {
            hi = 0x9F  // not a surrogate
        }
    } else if lead >= 0xF0 && lead <= 0xF4 {
        n = 4
        if lead == 0xF0 {
            lo = 0x90
        } else if lead == 0xF4 {
            hi = 0x8F
        }
    } else {
        return 0
    }
    if i + n > len(s) {
        return 0
    }
    let second = int(s[i + 1])
    if second < lo || second > hi {
        return 0
    }
    for k in 2..n {
        let c = int(s[i + k])
        if c < 0x80 || c > 0xBF {
            return 0
        }
    }
    return n
}

fn scalar_at(s: Str, i: Int, n: Int) -> Int {
    let mut cp = int(s[i]) & (0x7F >> n)
    for k in 1..n {
        cp = cp << 6 | int(s[i + k]) & 0x3F
    }
    return cp
}

fn add_scalar(b: mut strings.Builder, cp: Int) {
    if cp < 0x80 {
        strings.add_byte(mut b, byte(cp))
    } else if cp < 0x800 {
        strings.add_byte(mut b, byte(0xC0 | cp >> 6))
        strings.add_byte(mut b, byte(0x80 | cp & 0x3F))
    } else if cp < 0x10000 {
        strings.add_byte(mut b, byte(0xE0 | cp >> 12))
        strings.add_byte(mut b, byte(0x80 | cp >> 6 & 0x3F))
        strings.add_byte(mut b, byte(0x80 | cp & 0x3F))
    } else {
        strings.add_byte(mut b, byte(0xF0 | cp >> 18))
        strings.add_byte(mut b, byte(0x80 | cp >> 12 & 0x3F))
        strings.add_byte(mut b, byte(0x80 | cp >> 6 & 0x3F))
        strings.add_byte(mut b, byte(0x80 | cp & 0x3F))
    }
}

test "categories, properties and folding" {
    assert(category(0x41) == "Lu" && category(0x3B1) == "Ll" && category(0x661) == "Nd" && category(0x2028) == "Zl")
    assert(category(0x378) == "Cn" && category(-1) == "Cn" && category(0x110000) == "Cn" && category(0xE000) == "Co")
    assert(has(0x4E00, "Alphabetic") && !has(0x31, "Alphabetic") && has(0x3000, "White_Space") && !has(0x200B, "White_Space"))
    assert(has(0x5F, "Word") && has(0x300, "Word") && has(0x200D, "Word") && !has(0x2D, "Word") && has(0x2014, "P") && !has(0x2B, "P"))
    assert(has(0x41, "Lu") && has(0x41, "LC") && has(0x41, "L") && !has(0x41, "Ll") && !has(0x41, "Nope"))
    assert(simple_fold(0x41) == 0x61 && simple_fold(0x212A) == 0x6B && simple_fold(0x1E9E) == 0xDF && simple_fold(0x100) == 0x101)
    assert(simple_fold(0x101) == 0x101 && simple_fold(0x61) == 0x61)
    assert(fold("Straße") == "strasse" && fold("STRASSE") == "strasse" && fold("ΣΑΣ") == "σασ" && fold("ǅ") == "ǆ")
    let lu = ranges("Lu")
    assert(len(lu) > 1000 && lu[0] == 0x41 && lu[1] == 0x5A && len(ranges("Nope")) == 0)
    assert(unicode_version() == "15.1.0")
}

// ---- Generated by std/tools/unicode_tables.py from the Unicode Character Database: do not edit below ----
// Unicode 15.1.0. Records are fixed-width base-64 numbers (a digit is
// the byte 48 + its value), 64 to a string.

// The version of Unicode the tables below are of.
fn unicode_version() -> Str {
    return "15.1.0"
}

// The general categories, in the order of their numbers in category_runs.
fn category_names() -> Str {
    return "LuLlLtLmLoMnMcMeNdNlNoPcPdPsPePiPfPoSmScSkSoZsZlZpCcCfCsCoCn"
}

// The category numbers of the first 256 code points, one digit each.
fn latin1_categories() -> Str {
    return r"IIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIFAAACAAA=>ABA<AA8888888888AABBBAA00000000000000000000000000=A>D;D11111111111111111111111111=B>BIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIFACCCCEADE4?BJEDEB::D1AAD:4@:::A00000000000000000000000B0000000111111111111111111111111B11111111"
}

// Runs of code points of one category: where each starts, and the
// category's number; the next run starts where it ends.
fn category_runs(k: Int) -> Str {
    return match k {
        0 => r"0000I000PF000QA000TC000UA000X=000Y>000ZA000[B000\A000]<000^A000`8000jA000lB000oA00110001K=001LA001M>001ND001O;001PD001Q1001k=001lB001m>001nB001oI002PF002QA002RC002VE002WA002XD002YE002Z4002[?002\B002]J002^E002_D002`E002aB002b:002dD002e1002fA002hD002i:002j4002k@002l:002oA00300003GB003H0003O1003gB003h100400004110042000431"
        1 => r"004400045100460004710048000491004:0004;1004<0004=1004>0004?1004@0004A1004B0004C1004D0004E1004F0004G1004H0004I1004J0004K1004L0004M1004N0004O1004P0004Q1004R0004S1004T0004U1004V0004W1004X0004Y1004Z0004[1004\0004]1004^0004_1004`0004a1004b0004c1004d0004e1004f0004g1004i0004j1004k0004l1004m0004n1004o00050100510005210053000541"
        2 => r"00550005610057000581005:0005;1005<0005=1005>0005?1005@0005A1005B0005C1005D0005E1005F0005G1005H0005I1005J0005K1005L0005M1005N0005O1005P0005Q1005R0005S1005T0005U1005V0005W1005X0005Y1005Z0005[1005\0005]1005^0005_1005`0005a1005b0005c1005d0005e1005f0005g1005h0005j1005k0005l1005m0005n100610006310064000651006600068100690006<1"
        3 => r"006>0006B1006C0006E1006F0006I1006L0006N1006O0006Q1006R0006S1006T0006U1006V0006X1006Y0006Z1006\0006]1006^0006`1006a0006d1006e0006f1006g0006i1006k4006l0006m100704007400075200761007700078200791007:0007;2007<1007=0007>1007?0007@1007A0007B1007C0007D1007E0007F1007G0007H1007I0007J1007K0007L1007N0007O1007P0007Q1007R0007S1007T0"
        4 => r"007U1007V0007W1007X0007Y1007Z0007[1007\0007]1007^0007_1007a0007b2007c1007d0007e1007f0007i1007j0007k1007l0007m1007n0007o100800008110082000831008400085100860008710088000891008:0008;1008<0008=1008>0008?1008@0008A1008B0008C1008D0008E1008F0008G1008H0008I1008J0008K1008L0008M1008N0008O1008P0008Q1008R0008S1008T0008U1008V0008W1"
        5 => r"008X0008Y1008Z0008[1008\0008]1008^0008_1008`0008a1008b0008c1008j0008l1008m0008o1009100092100930009710098000991009:0009;1009<0009=1009>0009?100:D400:E100:`300;2D00;6300;BD00;P300;UD00;\300;]D00;^300;_D00<0500=`000=a100=b000=c100=d300=eD00=f000=g100=hM00=j300=k100=nA00=o000>0M00>4D00>6000>7A00>8000>;M00><000>=M00>>000>@1"
