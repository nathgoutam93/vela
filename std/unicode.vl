// The ranges of code points with the White_Space property.
fn white_space_ranges(k: Int) -> Str {
    return match k {
        0 => r"0009000=000P000P00250025002P002P01J001J00200020:020X020Y020_020_021O021O03000300"
        _ => ""
    }
}

// The ranges of word characters as UTS #18 defines \w: Alphabetic, a
// mark, a decimal digit, a connector punctuation or Join_Control.
