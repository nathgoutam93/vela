// Synchronous pipe communication, bounded by combined output and elapsed time.
import sysio
import strings
import text
pub type Output = struct { status: Int, stdout: Str, stderr: Str }
pub fn run(args: [Str], input: Str) -> Result[Output, IoError] uses os { return communicate(args, input, 16777216, 30000) }
pub fn communicate(args: [Str], input: Str, limit: Int, timeout_ms: Int) -> Result[Output, IoError] uses os {
    let row = sysio.process(args, input, limit, timeout_ms)?
    match text.parse_int(row[0]) { Some(status) => return Ok(Output { status: status, stdout: row[1], stderr: row[2] }), None => return Err(IoError { kind: IoKind.Invalid, message: "invalid process status" }) }
}
pub fn reply(args: [Str], input: Str, status: Int, stdout: Str, stderr: Str) -> [Str] requires status >= 0 && status <= 255 {
    let mut row = ["ok", input, strings.from_int(status), stdout, stderr]
    for arg in args { push(mut row, arg) }; return row
}
// A process that fails to run with `error`, kind included (M34).
pub fn failure(args: [Str], input: Str, error: IoError) -> [Str] {
    let kind = match error.kind {
        IoKind.NotFound => "0", IoKind.PermissionDenied => "1", IoKind.AlreadyExists => "2", IoKind.Timeout => "3",
        IoKind.Closed => "4", IoKind.Invalid => "5", IoKind.Other => "6",
    }
    let mut row = ["error", input, kind, error.message, ""]
    for arg in args { push(mut row, arg) }; return row
}
