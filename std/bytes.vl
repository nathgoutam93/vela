// The standard module `bytes`: questions about single bytes, for code that
// scans text a byte at a time, such as a lexer. ASCII only: a byte of a
// multi-byte UTF-8 character is never a digit, a letter or a space.
//
// Written in Vela, like the rest of the standard library will be wherever
// it can be. The other standard modules are built into the compiler and
// the C runtime, because Vela cannot express them yet.

pub fn is_digit(c: Byte) -> Bool {
    return c >= '0' && c <= '9'
}

pub fn is_letter(c: Byte) -> Bool {
    return is_lower(c) || is_upper(c)
}

pub fn is_alnum(c: Byte) -> Bool {
    return is_letter(c) || is_digit(c)
}

pub fn is_upper(c: Byte) -> Bool {
    return c >= 'A' && c <= 'Z'
}

pub fn is_lower(c: Byte) -> Bool {
    return c >= 'a' && c <= 'z'
}

// Space, tab, newline and carriage return.
pub fn is_space(c: Byte) -> Bool {
    return c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

pub fn to_lower(c: Byte) -> Byte {
    if is_upper(c) {
        return c + 32
    }
    return c
}

pub fn to_upper(c: Byte) -> Byte {
    if is_lower(c) {
        return c - 32
    }
    return c
}
