import ints
import maps
import strings

type Pair = struct { first: Int, second: Int }
type Box[T] = struct { value: T }
type Tree = enum { Leaf(Int), Branch([Tree]) }
type Choice = enum { Empty, Value(Int) }
type Generic[T] = enum { Put(T), Missing }

fn add(value: mut Int, amount: Int) { value = value + amount }
fn nothing() { return }
fn identity[T](value: T) -> T { return value }
fn apply(f: fn(Int) -> Int, value: Int) -> Int uses f { return f(value) }
fn optional(value: Option[Int]) -> Option[Int] { return Some(value? + 1) }
fn positive(value: Int) -> Result[Int, Str] {
    if value < 0 { return Err("negative") }
    return Ok(value)
}
fn propagated(value: Int) -> Result[Int, Str] { return Ok(positive(value)? + 1) }
fn captured(value: Int) -> fn(Int) -> Int { return fn(n) => value + n }
fn size(tree: Tree) -> Int {
    match tree {
        Tree.Leaf(_) => return 1
        Tree.Branch(children) => {
            let mut total = 0
            for child in children { total = total + size(child) }
            return total
        }
    }
}
fn main() {
    nothing()
    let unit: (Unit) = ()
    assert(unit == ())
    let signed: i8 = -128i8
    let byte_value: Byte = 0xffu8
    let full: u64 = 0xffff_ffff_ffff_ffffu64
    assert(signed == -128i8 && byte_value == 255u8 && full > 9223372036854775807u64)
    assert(i16(signed) == -128i16 && u16(byte_value) == 255u16)
    assert(i32(2) == 2i32 && u32(2) == 2u32 && i64(2) == 2i64 && u64(2) == 2u64)
    assert(int(3.75) == 3 && byte(65) == 'A' && float(3) == 3.0)
    assert(0b1010_0101u8 == 165u8)
    assert((~0u8 & 0x0fu8 | 0x80u8) ^ 1u8 == 142u8)
    assert(1u8 << 7 == 128u8 && -8i8 >> 2 == -2i8)
    assert(255u8 >> 4 == 15u8 && -7 / 3 == -2 && -7 % 3 == -1)
    assert(2 + 3 * 4 == 14 && 4 <= 4 && 5 >= 4 && 2 != 3)
    assert(!false && (true || false))
    assert(false && 1 / 0 == 0 || true)
    assert(true || 1 / 0 == 0)
    assert(1.5e1 / 2.0 == 7.5)
    match ints.checked_add(127i8, 1i8) { None => assert(true), Some(_) => assert(false) }
    assert(ints.wrapping_add(255u8, 1u8) == 0u8)
    assert(ints.saturating_add(127i8, 1i8) == 127i8)
    assert(ints.to_str(full) == "18446744073709551615")
    let text = "é\0\n\t\r\\\""
    assert(len(text) == 8 && text[0] == 195u8 && text[2] == 0u8)
    assert('a' == 97u8 && '\n' == 10u8)
    assert("ab" + "cd" == "abcd" && "a" < "b" && "abc"[1..3] == "bc")
    let original = [1, 2, 3]
    let mut copy = original
    copy[0] = 8
    push(mut copy, 4)
    assert(original[0] == 1 && len(copy) == 4)
    let part = copy[1..3]
    assert(len(part) == 2 && part[0] == 2)
    let mut fixed: [Int; 2] = [1, 2]
    let saved = fixed
    fixed[0] = 9
    let empty: [Byte; 0] = []
    assert(saved[0] == 1 && fixed[0] == 9 && len(empty) == 0)
    let mut record = Pair { second: 2, first: 1 }
    let before = record
    add(mut record.first, 3)
    assert(record.first == 4 && before.first == 1)
    let boxed: Box[Str] = Box { value: identity("box") }
    assert(boxed.value == "box")
    let mut map: Map[Str, Int] = [:]
    map["b"] = 2
    map["a"] = 1
    map["b"] = 3
    assert(maps.keys(map)[0] == "b" && map["b"] == 3)
    let mut map_copy = map
    map_copy["b"] = 99
    assert(map["b"] == 3 && map_copy["b"] == 99)
    match maps.get(map, "missing") { None => assert(true), Some(_) => assert(false) }
    let literal = ["key": 4]
    assert(literal["key"] == 4)
    let mut total = 0
    for i in 0..5 {
        if i == 1 { continue } else if i == 4 { break } else { total = total + i }
    }
    assert(total == 5)
    for total < 7 { total = total + 1 }
    for { total = total + 1; break }
    { let total = 99; assert(total == 99) }
    assert(total == 8)
    assert(-total == -8)
    let range = match total { 0..=7 => false, 8 => true, _ => false }
    assert(range)
    let choice = Choice.Value(4)
    match choice { Choice.Value(n) => assert(n == 4), Choice.Empty => assert(false) }
    let generic: Generic[Str] = Generic.Put("generic")
    match generic { Generic.Put(s) => assert(s == "generic"), Generic.Missing => assert(false) }
    let nested = Some(Choice.Value(3))
    match nested { Some(Choice.Value(n)) => assert(n == 3), _ => assert(false) }
    match optional(Some(4)) { Some(n) => assert(n == 5), None => assert(false) }
    match optional(None) { None => assert(true), Some(_) => assert(false) }
    match propagated(2) { Ok(n) => assert(n == 3), Err(_) => assert(false) }
    match propagated(-1) { Err(e) => assert(e == "negative"), Ok(_) => assert(false) }
    let f = captured(10)
    assert(apply(f, 2) == 12)
    let block = fn(n: Int) -> Int { return n * 2 }
    assert(block(4) == 8)
    assert(size(Tree.Branch([Tree.Leaf(1), Tree.Leaf(2)])) == 2)
    let _ = positive(0)
    let _ = positive(-1)
    assert(strings.from_int(total) == "8")
    print("core ok")
}

test "core compatibility" { assert(identity(42) == 42) }
