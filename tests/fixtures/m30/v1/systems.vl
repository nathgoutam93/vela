import arenas
import buffers
import files
import tasks
import views

fn get[T](result: Result[T, Str]) -> T {
    match result { Ok(value) => return value, Err(_) => { assert(false); for {} } }
}
fn apply[T](f: fn() -> T) -> T uses f { return f() }
fn read() -> Str uses fs { return get(files.read("data")) }
fn main() {
    let mut bytes = buffers.create(8)
    buffers.write_u32_be(mut bytes, 1, 0x12345678u32)
    let snapshot = buffers.view(bytes, 1, 5)
    buffers.set(mut bytes, 1, 0u8)
    assert(snapshot.get(0) == 0x12u8 && buffers.read_u32_be(bytes, 1) == 0x00345678u32)
    let mut values = [1, 2, 3]
    let saved = views.range(values, 0, 2)
    values[0] = 9
    assert(saved.get(0) == 1)
    let copied = tasks.map([1, 2], fn(n) => saved.get(0) + n)
    assert(copied[0] == 2 && copied[1] == 3)
    tasks.each([1, 2], fn(n) { assert(n > 0) })
    let mut arena: arenas.Arena[Str] = arenas.create(2)
    let slot = arenas.alloc(mut arena, "saved")
    let old = arena
    arenas.reset(mut arena)
    assert(arenas.get(old, slot) == "saved")
    print("systems ok")
}
test "effects and nested restoration" {
    with files = ["data": "outer"] {
        assert(apply(read) == "outer")
        with files = ["data": "inner"] { assert(read() == "inner") }
        assert(read() == "outer")
        let values = tasks.map([1, 2], fn(n) => read())
        assert(values[0] == "outer" && values[1] == "outer")
    }
}
