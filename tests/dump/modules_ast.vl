import lexer
import maps

pub type Pair = struct {
    left: lexer.Token
    right: Option[lexer.Token]
}

pub fn first(p: Pair) -> lexer.Kind {
    let t = lexer.Token { kind: lexer.Kind.Plus, text: "+" }
    match p.left.kind {
        lexer.Kind.Num(n) => print(n)
        _ => print(maps.has([1: 2], 1))
    }
    return t.kind
}
