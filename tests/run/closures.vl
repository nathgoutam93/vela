// Closures (M10c): function values that copy the variables they use, when
// they are made. Parameter types can come from the context.
// out: bo ada cy
// out: 15
// out: [2, 4, 6]
// out: 11
// out: hello, vela!
// out: 3
// out: still 10
// out: 30
// out: 2
// out: 6
// out: big
// out: [10, 20]
// out: same
// out: 8
// out: 2
// out: 1
import lists
import maps
import strings

type Counter = struct {
    step: Int
    apply: fn(Int) -> Int
}

fn adder(n: Int) -> fn(Int) -> Int {
    return fn(x) => x + n
}

fn compose(f: fn(Int) -> Int, g: fn(Int) -> Int) -> fn(Int) -> Int {
    return fn(x) => g(f(x))
}

fn show(xs: [Int]) -> Str {
    let parts = lists.map(xs, fn(x) => strings.from_int(x))
    return "[" + lists.fold(parts, "", fn(acc: Str, p: Str) -> Str {
        if acc == "" {
            return p
        }
        return acc + ", " + p
    }) + "]"
}

fn main() {
    let spent: Map[Str, Int] = ["ada": 20, "bo": 50, "cy": 5]
    let names = lists.sort_by(maps.keys(spent), fn(n) => -spent[n])
    print(names[0] + " " + names[1] + " " + names[2])
    let base = 10
    let add5 = adder(5)
    print(add5(base))
    let k = 2
    print(show(lists.map([1, 2, 3], fn(x) => x * k)))
    print(compose(add5, fn(x) => x - 4)(base))
    let greeting = "hello"
    let greet = fn(name: Str) -> Str { return greeting + ", " + name + "!" }
    print(greet("vela"))
    print(len(lists.filter([1, 5, 9, 12], fn(x) => x > base / 2 - 1)))
    // The copy is made when the closure is: a later change is not seen.
    let mut limit = 10
    let at_most = fn(x: Int) => x <= limit
    limit = 0
    if at_most(10) {
        print("still 10")
    }
    let c = Counter { step: 3, apply: fn(x) => x * 3 }
    print(c.apply(base))
    // Closures inside closures copy what the outer one copied.
    let outer = fn(x: Int) -> fn(Int) -> Int {
        return fn(y) => x * y + k - k
    }
    print(outer(1)(2))
    let fs: [fn() -> Int] = [fn() => k * 3, fn() => base]
    print(fs[0]())
    let label = fn(n: Int) -> Str {
        if n > 100 {
            return "big"
        }
        return "small"
    }
    print(label(1000))
    let tens = lists.map([1, 2], fn(n) => n * base)
    print(show(tens))
    // In generic functions: copies of T values.
    let same = constant("same")
    print(same())
    let four = constant(4)
    print(four() + four())
    print(count_where([1, 3, 5], fn(x) => x >= k + 1))
    print(count_where(["a", "bb"], fn(w) => len(w) > 1))
}

fn constant[T](x: T) -> fn() -> T {
    return fn() => x
}

fn count_where[T](xs: [T], keep: fn(T) -> Bool) -> Int {
    return len(lists.filter(xs, fn(x) => keep(x)))
}
