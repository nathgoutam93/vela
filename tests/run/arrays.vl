// Arrays: literals, indexing, assignment, push, len, slicing, for-in,
// arrays of arrays, and [] whose type comes from the context.
// out: 3
// out: 20
// out: 99
// out: 4
// out: 1
// out: 99
// out: 30
// out: 7
// out: 0
// out: 2
// out: 3
// out: 6
fn sum(xs: [Int]) -> Int {
    let mut total = 0
    for x in xs {
        total = total + x
    }
    return total
}

fn main() {
    let mut xs = [10, 20, 30]
    print(len(xs))
    print(xs[1])
    xs[1] = 99
    print(xs[1])
    push(mut xs, 7)
    print(len(xs))
    let empty: [Int] = []
    let mut grid: [[Int]] = [[1, 2], [3], []]
    print(grid[0][0])
    let middle = xs[1..3]
    print(middle[0])
    print(middle[1])
    print(xs[3])
    print(len(grid[2]))
    push(mut grid[2], 5)
    push(mut grid[2], 6)
    print(len(grid[2]))
    grid[1][0] = sum(empty) + 3
    print(grid[1][0])
    print(grid[2][1])
}
