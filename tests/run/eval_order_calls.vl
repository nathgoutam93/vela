// Operands and arguments are evaluated left to right.
// out: 1
// out: 2
// out: 3
// out: 6
// out: 10
// out: 20
// out: 30
// out: 60
fn say(n: Int) -> Int {
    print(n)
    return n
}

fn add3(a: Int, b: Int, c: Int) -> Int {
    return a + b + c
}

fn main() {
    print(say(1) + say(2) + say(3))
    print(add3(say(10), say(20), say(30)))
}
