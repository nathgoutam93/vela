// An array a loop keeps in C locals is still bounds checked (M18).
// out: 3
// err: panic_cached_index.vl:13:23: panic: index out of range
// exit: 101
import strings

fn main() {
    let xs = [1, 2]
    let mut sum = 0
    let mut i = 0
    for i < 5 {
        sum = sum + 1
        sum = sum + xs[i] - xs[i]
        if i == 1 {
            print(strings.from_int(sum + 1))
        }
        i = i + 1
    }
}
