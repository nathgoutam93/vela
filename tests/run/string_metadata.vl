// Cached metadata must respect slices, mutation, evaluation and captures.
// out: string metadata passed
import tasks
import text

fn bytes(s: Str) -> Int {
    let mut sum = 0
    for i in 0..len(s) { sum = sum + int(s[i]) }
    return sum
}
fn replace(s: mut Str) -> Int { s = text.repeat("z", 100); return 0 }
fn mutate(s: mut Str) {
    assert(len(s) == 3 && s[2] == 'c')
    s = text.repeat("q", 17)
    assert(len(s) == 17 && s[16] == 'q')
}
fn main() {
    let whole = text.repeat("abc", 9)
    assert(bytes(whole) == 9 * 294 && bytes(whole[1..5]) == 392)
    assert(bytes("") == 0 && bytes("a\0b") == 195)
    let mut changing = "abc"
    mutate(mut changing)
    assert(bytes(changing) == 17 * 113)
    changing = "abc"
    assert(changing[replace(mut changing)] == 'z' && len(changing) == 100)
    let results = tasks.map([whole[1..5], "", "a\0b"], fn(s) => bytes(s))
    assert(len(results) == 3 && results[0] == 392 && results[1] == 0 && results[2] == 195)
    print("string metadata passed")
}
