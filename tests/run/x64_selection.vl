    assert(int(id(127i8)) == 127)
    assert(int(id(-32768i16)) == -32768)
    assert(int(id(-1i16)) == -1)
    assert(int(id(32767i16)) == 32767)
    assert(int(id(0u16)) == 0)
    assert(int(id(65535u16)) == 65535)
    assert(int(id(0u32)) == 0)
    assert(int(id(2147483648u32)) == 2147483648)
    assert(int(id(4294967295u32)) == 4294967295)
    assert(int(id(-2147483648i32)) == -2147483648)
    assert(int(id(-1i32)) == -1)
    assert(int(id(2147483647i32)) == 2147483647)
    assert(u64(id(0u32)) == 0u64)
    assert(u64(id(255u32)) == 255u64)
    assert(u64(id(4294967295u32)) == 4294967295u64)
    assert(id(0) + 1 == 1)
    assert(id(0) + -1 == -1)
    assert(id(0) + 7 == 7)
    assert(id(0) + -2147483647 == -2147483647)
    assert(id(0) + 2147483647 == 2147483647)
    assert(id(0) * 3 == 0)
    assert(id(0) * 8 == 0)
    assert(id(0) * -6 == 0)
    assert(id(-5) + 1 == -4)
    assert(id(-5) + -1 == -6)
    assert(id(-5) + 7 == 2)
    assert(id(-5) + -2147483647 == -2147483652)
    assert(id(-5) + 2147483647 == 2147483642)
    assert(id(-5) * 3 == -15)
    assert(id(-5) * 8 == -40)
    assert(id(-5) * -6 == 30)
    assert(id(1000000) + 1 == 1000001)
    assert(id(1000000) + -1 == 999999)
    assert(id(1000000) + 7 == 1000007)
    assert(id(1000000) + -2147483647 == -2146483647)
    assert(id(1000000) + 2147483647 == 2148483647)
    assert(id(1000000) * 3 == 3000000)
    assert(id(1000000) * 8 == 8000000)
    assert(id(1000000) * -6 == -6000000)
    assert(id(-9223372036854775807) + 1 == -9223372036854775806)
    assert(id(-9223372036854775807) + -1 == -9223372036854775808)
    assert(id(-9223372036854775807) + 7 == -9223372036854775800)
    assert(id(-9223372036854775807) + 2147483647 == -9223372034707292160)
    assert(mix(id(0xf0f0u64), id(0x0ff0u64)) == 3840u64)
    let r = rounds(id(1000))
    assert(r[0] == 1849944894u32 && r[1] == 4243516660u32 && r[2] == 3800848406u32)
    print("x64 selection passed")
}
