// out: x64 selection passed
// Native x86-64 instruction selection: power-of-two division, constant
// shifts at every width, extensions, rotates and immediates, checked
// against values computed independently of either backend.
import ints

fn id[T](x: T) -> T { return x }
fn rotr(x: u32, n: Int) -> u32 { return (x >> n) | (x << (32 - n)) }

// Commuting operations whose result reuses the second operand's register.
fn mix(a: u64, b: u64) -> u64 {
    let mut x = a
    let mut y = b
    for _ in 0..3 {
        y = x ^ y
        x = y & x
        y = x | y
    }
    return x + y
}

// u32 state whose definitions all keep 32 bits: rotates and truncated
// word operations become single 32-bit instructions on x86-64.
fn rounds(n: Int) -> [u32] {
    let mut a = 0x6a09e667u32
    let mut b = 0xbb67ae85u32
    let mut c = 0x3c6ef372u32
    for i in 0..n {
        let s0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)
        let t = ints.wrapping_add(ints.wrapping_add(b, s0), u32(i))
        let m = ints.wrapping_mul(t, 0x9e3779b1u32)
        let k = (m << 5) ^ ~c
        c = ints.wrapping_sub(b, k)
        b = a | (t & c)
        a = ints.wrapping_add(ints.wrapping_add(m, k), rotr(c, 7))
    }
    return [a, b, c]
}

