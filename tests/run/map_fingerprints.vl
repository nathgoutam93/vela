// out: 1000
// out: 499500
// out: 3000
import maps
import strings

fn main() {
    let mut m: Map[Str, Int] = [:]
    for i in 0..2000 {
        m[strings.from_int(i)] = i
    }
    let copy = m
    for i in 0..2000 {
        if i % 2 == 0 {
            maps.remove(mut m, strings.from_int(i))
        }
    }
    for i in 2000..4000 {
        m[strings.from_int(i)] = i
    }
    let mut sum = 0
    for i in 0..1000 {
        sum = sum + copy[strings.from_int(i)]
        assert(maps.has(m, strings.from_int(2 * i + 1)))
        assert(!maps.has(m, strings.from_int(2 * i)))
    }
    for i in 0..1000 {
        m[strings.from_int(2 * i)] = 0
    }
    let mut next = 0
    for k in maps.keys(m) {
        if next < 1000 {
            assert(k == strings.from_int(2 * next + 1))
        }
        next = next + 1
    }
    print(len(copy) - 1000)
    print(sum)
    print(len(m) - 1000)
}
