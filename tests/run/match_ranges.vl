// A match with many integer or Byte literals and ranges finds the arm by a
// binary search over the values each arm is first to take (TL-107):
// overlapping ranges, both ends of Int, u64 across 2^63, i8 and Byte.
// out: 0 9 9 0 0 6 6 5 5 6 6 5 6 6 1 1 6 6 2 2 6 4 6 3 3 6 6 6 6 8 8 7 8 8 0 0 10 10
// out: 1 1 2 3 3 0 0 6 0 7 7 0 8 0 4 4 4 4 0 0 5 5
// out: 1 1 2 2 3 4 4 5 0 0 6 6 7 0 0 8 8
// out: 4 4 0 1 1 2 2 3 3 2 2 0 5 6 0 7 7
import strings

fn kind(c: Int) -> Int {
    return match c {
        48..=57 => 1
        65..=90 => 2
        97..=122 => 3
        95 => 4
        32 => 5
        9..=13 => 5
        0..=200 => 6
        1000 => 7
        150..=1500 => 8
        -9223372036854775807..=-1000 => 9
        9223372036854775000..=9223372036854775807 => 10
        _ => 0
    }
}

fn wide(n: u64) -> Int {
    return match n {
        0u64..=9u64 => 1
        10u64 => 2
        11u64..=100u64 => 3
        9223372036854775800u64..=9223372036854775815u64 => 4
        18446744073709551600u64..=18446744073709551615u64 => 5
        200u64 => 6
        300u64..=399u64 => 7
        1000u64 => 8
        _ => 0
    }
}

fn small(n: i8) -> Int {
    return match n {
        -128i8..=-100i8 => 1
        -99i8..=-1i8 => 2
        0i8 => 3
        1i8..=9i8 => 4
        10i8 => 5
        20i8..=29i8 => 6
        30i8 => 7
        100i8..=127i8 => 8
        _ => 0
    }
}

fn byte_class(c: Byte) -> Int {
    return match c {
        '0'..='9' => 1
        'a'..='f' => 2
        'A'..='F' => 2
        'g'..='z' => 3
        0..=8 => 4
        '_' => 5
        '-' => 6
        200..=255 => 7
        _ => 0
    }
}

fn sep(out: Str) -> Str {
    if out == "" {
        return ""
    }
    return " "
}

fn main() {
    let mut out = ""
    for c in [-9223372036854775807 - 1, -1001, -1000, -999, -1, 0, 8, 9, 13, 14, 31, 32, 33, 47, 48, 57, 58, 64, 65, 90, 91, 95, 96, 97, 122, 123, 149, 150, 200, 201, 999, 1000, 1001, 1500, 1501, 9223372036854774999, 9223372036854775000, 9223372036854775807] {
        out = out + sep(out) + strings.from_int(kind(c))
    }
    print(out)
    out = ""
    for n in [0u64, 9u64, 10u64, 11u64, 100u64, 101u64, 199u64, 200u64, 299u64, 300u64, 399u64, 400u64, 1000u64, 9223372036854775799u64, 9223372036854775800u64, 9223372036854775807u64, 9223372036854775808u64, 9223372036854775815u64, 9223372036854775816u64, 18446744073709551599u64, 18446744073709551600u64, 18446744073709551615u64] {
        out = out + sep(out) + strings.from_int(wide(n))
    }
    print(out)
    out = ""
    for n in [-128i8, -100i8, -99i8, -1i8, 0i8, 1i8, 9i8, 10i8, 11i8, 19i8, 20i8, 29i8, 30i8, 31i8, 99i8, 100i8, 127i8] {
        out = out + sep(out) + strings.from_int(small(n))
    }
    print(out)
    out = ""
    for c in [byte(0), byte(8), byte(9), '0', '9', 'a', 'f', 'g', 'z', 'A', 'F', 'G', '_', '-', byte(199), byte(200), byte(255)] {
        out = out + sep(out) + strings.from_int(byte_class(c))
    }
    print(out)
}
