// Functions may call functions defined later, and each other.
// out: true
// out: false
// out: true
// out: 3
fn main() {
    print(is_even(10))
    print(is_even(7))
    print(is_odd(7))
    print(gcd(21, 12))
}

fn is_even(n: Int) -> Bool {
    if n == 0 {
        return true
    }
    return is_odd(n - 1)
}

fn is_odd(n: Int) -> Bool {
    if n == 0 {
        return false
    }
    return is_even(n - 1)
}

fn gcd(a: Int, b: Int) -> Int {
    if b == 0 {
        return a
    }
    return gcd(b, a % b)
}
