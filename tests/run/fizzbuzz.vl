// M2 done-when: FizzBuzz from 1 to 30.
// out: 1
// out: 2
// out: Fizz
// out: 4
// out: Buzz
// out: Fizz
// out: 7
// out: 8
// out: Fizz
// out: Buzz
// out: 11
// out: Fizz
// out: 13
// out: 14
// out: FizzBuzz
// out: 16
// out: 17
// out: Fizz
// out: 19
// out: Buzz
// out: Fizz
// out: 22
// out: 23
// out: Fizz
// out: Buzz
// out: 26
// out: Fizz
// out: 28
// out: 29
// out: FizzBuzz
fn main() {
    for i in 1..31 {
        if i % 15 == 0 {
            print("FizzBuzz")
        } else if i % 3 == 0 {
            print("Fizz")
        } else if i % 5 == 0 {
            print("Buzz")
        } else {
            print(i)
        }
    }
}
