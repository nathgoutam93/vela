// Copy-on-write with the check made once per variable (M18): after any
// copy, call, capture or new value, the next write checks again, so a copy
// never sees a later write.
// stage 1 only
// out: 9 2 3 | 9 8 3
// out: 1 2 3 | 7 2 3
// out: 5 | 6
// out: 1 2 | 1 3
// out: 0 1 2 | 10 11 12
// out: 4 4 4
// out: x y | x z
import strings

type Box = struct {
    items: [Int]
}

fn show(xs: [Int]) -> Str {
    let mut b = strings.builder()
    for i in 0..len(xs) {
        if i > 0 {
            strings.add(mut b, " ")
        }
        strings.add(mut b, strings.from_int(xs[i]))
    }
    return strings.build(b)
}

fn keep(xs: [Int]) -> [Int] {
    return xs
}

fn main() {
    // A copy between two writes.
    let mut a = [1, 2, 3]
    a[0] = 9
    let b = a
    a[1] = 8
    print(show(b) + " | " + show(a))
    // A call that keeps a copy, between two writes.
    let mut c = [1, 2, 3]
    c[2] = 3
    let kept = keep(c)
    c[0] = 7
    print(show(kept) + " | " + show(c))
    // A closure captures a copy.
    let mut d = [5]
    d[0] = 5
    let get = fn() => d[0]
    d[0] = 6
    print(strings.from_int(get()) + " | " + strings.from_int(d[0]))
    // Into a struct, then written.
    let mut e = [1, 2]
    e[1] = 2
    let s = Box { items: e }
    e[1] = 3
    print(show(s.items) + " | " + show(e))
    // Copies made inside a loop.
    let mut f = [0, 1, 2]
    let mut snapshots: [[Int]] = []
    for i in 0..3 {
        push(mut snapshots, f)
        f[i] = f[i] + 10
    }
    print(show(snapshots[0]) + " | " + show(f))
    // The variable gets another array between writes.
    let mut g = [1, 1, 1]
    g[0] = 2
    g = [3, 3, 3]
    g[0] = 4
    g[1] = 4
    g[2] = 4
    print(show(g))
    // Strings in the array: the old element is released, the copy keeps its own.
    let mut h = ["x", "y"]
    h[1] = "y"
    let old = h
    h[1] = "z"
    print(old[0] + " " + old[1] + " | " + h[0] + " " + h[1])
}
