// M2 done-when: factorial, recursive and with a loop.
// out: 1
// out: 1
// out: 120
// out: 3628800
// out: 2432902008176640000
// out: 2432902008176640000
fn factorial(n: Int) -> Int {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

fn factorial_loop(n: Int) -> Int {
    let mut result = 1
    for i in 1..n + 1 {
        result = result * i
    }
    return result
}

fn main() {
    print(factorial(0))
    print(factorial(1))
    print(factorial(5))
    print(factorial(10))
    print(factorial(20))
    print(factorial_loop(20))
}
