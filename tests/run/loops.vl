// The three kinds of for, with break and continue.
// out: 0
// out: 1
// out: 2
// out: 10
// out: 1
// out: 3
// out: 5
// out: 7
// out: 4
// out: 0
// out: 1
// out: 0
// out: 2
// out: 3
// out: 3
fn main() {
    // for with a condition
    let mut i = 0
    for i < 3 {
        print(i)
        i = i + 1
    }

    // for with no condition loops until break
    let mut n = 0
    for {
        n = n + 1
        if n == 10 {
            break
        }
    }
    print(n)

    // continue skips to the next iteration, also in a range loop
    for k in 0..8 {
        if k % 2 == 0 {
            continue
        }
        print(k)
    }

    // break leaves only the innermost loop
    let mut count = 0
    for a in 0..2 {
        for b in 0..10 {
            if b == 2 {
                break
            }
            count = count + 1
        }
    }
    print(count)

    // an empty range runs zero times
    for z in 5..2 {
        print(z)
    }

    // the range is fixed when the loop starts
    let mut limit = 2
    for j in 0..limit {
        limit = 100
        print(j)
    }

    // changing a variable in the condition with continue in between
    let mut m = 0
    for m < 4 {
        m = m + 1
        if m == 2 {
            continue
        }
        print(m - 1)
    }
    print(m - 1)
}
