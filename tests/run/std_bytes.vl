// The bytes module, which is written in Vela (std/bytes.vl), over all 256
// byte values.
// out: 10 52 62 26 26 4
// out: HELLO, WORLD 123
// out: hello, world 123
import bytes
import strings

fn main() {
    let mut digits = 0
    let mut letters = 0
    let mut alnum = 0
    let mut upper = 0
    let mut lower = 0
    let mut space = 0
    for i in 0..256 {
        let c = byte(i)
        if bytes.is_digit(c) {
            digits = digits + 1
        }
        if bytes.is_letter(c) {
            letters = letters + 1
        }
        if bytes.is_alnum(c) {
            alnum = alnum + 1
        }
        if bytes.is_upper(c) {
            upper = upper + 1
        }
        if bytes.is_lower(c) {
            lower = lower + 1
        }
        if bytes.is_space(c) {
            space = space + 1
        }
    }
    let mut counts = strings.builder()
    for n in [digits, letters, alnum, upper, lower] {
        strings.add_int(counts, n)
        strings.add_byte(counts, ' ')
    }
    strings.add_int(counts, space)
    print(strings.build(counts))

    let text = "Hello, World 123"
    let mut up = strings.builder()
    let mut down = strings.builder()
    for c in text {
        strings.add_byte(up, bytes.to_upper(c))
        strings.add_byte(down, bytes.to_lower(c))
    }
    print(strings.build(up))
    print(strings.build(down))
}
