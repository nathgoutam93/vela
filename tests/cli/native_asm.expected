    .intel_syntax noprefix
    .text

    .p2align 4
    .type f_count, @function
f_count:
    push rbp
    mov rbp, rsp
    push rbx
    push r12
    push r13
    push r14
    mov r10, rdi
    cmp r10, 0
    jle .L0_0
    jmp .L0_1
.L0_0:
    mov rax, 0
    jmp .LR0
.L0_1:
    sub r10, 1
    cmp r10, 0
    jle .L0_3
    jmp .L0_4
.L0_3:
    xor ebx, ebx
    jmp .L0_6
.L0_4:
    sub r10, 1
    cmp r10, 0
    jle .L0_7
    jmp .L0_8
.L0_7:
    xor r12d, r12d
    jmp .L0_14
.L0_8:
    sub r10, 1
    cmp r10, 0
    jle .L0_10
    jmp .L0_11
.L0_10:
    xor r13d, r13d
    jmp .L0_13
.L0_11:
    sub r10, 1
    mov rdi, r10
    call f_count
    mov r14, rax
    mov r13, r14
    add r13, 1
    jo .LP0_1
.L0_13:
    mov r12, r13
    add r12, 1
    jo .LP0_2
.L0_14:
    mov rbx, r12
    add rbx, 1
    jo .LP0_3
.L0_6:
    add rbx, 1
    jo .LP0_4
    mov rax, rbx
    jmp .LR0
.LR0:
    lea rsp, [rbp - 32]
    pop r14
    pop r13
    pop r12
    pop rbx
    pop rbp
    ret
.LP0_1:
    lea rdi, [rip + .Lc1]
    lea rsi, [rip + .Lmsg_overflow]
    call vela_panic@PLT
.LP0_2:
    lea rdi, [rip + .Lc1]
    lea rsi, [rip + .Lmsg_overflow]
    call vela_panic@PLT
.LP0_3:
    lea rdi, [rip + .Lc1]
    lea rsi, [rip + .Lmsg_overflow]
    call vela_panic@PLT
.LP0_4:
    lea rdi, [rip + .Lc1]
    lea rsi, [rip + .Lmsg_overflow]
    call vela_panic@PLT
    .size f_count, . - f_count

    .p2align 4
    .type f_main, @function
f_main:
    push rbp
    mov rbp, rsp
    mov rdi, 0
    call f_count
    mov r10, rax
    add r10, 1
    jo .LP1_1
    add r10, 1
    jo .LP1_2
    add r10, 1
    jo .LP1_3
    mov rdi, r10
    mov eax, 0
    call vela_print_int@PLT
    jmp .LR1
.LR1:
    mov rsp, rbp
    pop rbp
    ret
.LP1_1:
    lea rdi, [rip + .Lc1]
    lea rsi, [rip + .Lmsg_overflow]
    call vela_panic@PLT
.LP1_2:
    lea rdi, [rip + .Lc1]
    lea rsi, [rip + .Lmsg_overflow]
    call vela_panic@PLT
.LP1_3:
    lea rdi, [rip + .Lc1]
    lea rsi, [rip + .Lmsg_overflow]
    call vela_panic@PLT
    .size f_main, . - f_main

    .p2align 4
    .globl main
    .type main, @function
main:
    push rbp
    mov rbp, rsp
    push rbx
    sub rsp, 8
    mov r10, rdi
    mov rbx, rsi
    mov rdi, r10
    mov rsi, rbx
    mov eax, 0
    call vela_init@PLT
    mov rdi, 1
    call f_count
    mov r10, rax
    add r10, 1
    jo .LP2_1
    add r10, 1
    jo .LP2_2
    mov rdi, r10
    mov eax, 0
    call vela_print_int@PLT
    mov rax, 0
    jmp .LR2
.LR2:
    lea rsp, [rbp - 8]
    pop rbx
    pop rbp
    ret
.LP2_1:
    lea rdi, [rip + .Lc1]
    lea rsi, [rip + .Lmsg_overflow]
    call vela_panic@PLT
.LP2_2:
    lea rdi, [rip + .Lc1]
    lea rsi, [rip + .Lmsg_overflow]
    call vela_panic@PLT
    .size main, . - main

    .section .rodata
.Lmsg_overflow:
    .asciz "integer overflow"
.Lmsg_div0:
    .asciz "division by zero"
.Lmsg_byte:
    .asciz "byte overflow"
.Lmsg_tobyte:
    .asciz "value does not fit in a Byte"
    .p2align 3
.Lc0:
    .asciz "native_asm.vl:10:20"
.Lc1:
    .asciz "native_asm.vl:10:25"

    .section .data.rel.ro,"aw"
    .p2align 3

    .section .note.GNU-stack,"",@progbits
