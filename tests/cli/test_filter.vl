// `vela test FILE WORDS`: only the tests whose names contain a word run,
// and a program with tests needs no main to test them.
// command: test FILE sum
// out: PASS  test_filter.vl: test "sum of two"
// out: PASS  test_filter.vl: test "sum of none"
// out: 2 tests: 2 passed, 0 failed
fn sum(xs: [Int]) -> Int {
    let mut total = 0
    for x in xs {
        total = total + x
    }
    return total
}

test "sum of two" {
    assert(sum([2, 3]) == 5)
}

test "sum of none" {
    let none: [Int] = []
    assert(sum(none) == 0)
}

test "something else" {
    assert(false)
}
