// `with stdin` (M12): the code a test calls reads the given text, a line or
// a count of bytes at a time; an inner `with` has its own, and the outer
// one goes on where it stopped.
// command: test
// out: PASS  fake_stdin.vl: test "lines and bytes"
// out: PASS  fake_stdin.vl: test "nested"
// out: 2 tests: 2 passed, 0 failed
import os
import strings

fn line() -> Str uses os {
    match os.read_line() {
        Some(l) => return l
        None => return "<end>"
    }
}

test "lines and bytes" {
    let mut out = strings.builder()
    with stdin = "one\r\ntwo\n\nlast", stdout = mut out {
        os.write(line() + "," + line() + ",")
        os.write(line() + "," + os.read(2) + "," + line() + "," + line())
    }
    assert(strings.build(out) == "one,two,,la,st,<end>")
    with stdin = "" {
        assert(line() == "<end>" && os.read(4) == "")
    }
}

test "nested" {
    with stdin = "a\nb\n" {
        assert(line() == "a")
        with stdin = "inner\n" {
            assert(line() == "inner" && line() == "<end>")
        }
        assert(line() == "b")
    }
}
