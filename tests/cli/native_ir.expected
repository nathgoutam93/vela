.Lc0:
    .asciz "native_ir.vl:7:14"
.Lc1:
    .asciz "native_ir.vl:13:23"
.Lc2:
    .asciz "fourteen"
.Ls3:
    .quad 0
    .quad .Lc2
    .quad 8

fn f_square(%0)
    %2 = mul.chk .Lc0 %0, %0
    ret %2

fn f_main()
    %0 = const #0
    %1 = move %0
    %2 = const #0
    %3 = const #4
    %5 = move %2
L0:
    branch.cmp ge %5, %3 L2
    %6 = move %5
    %7 = move %1
    %19 = mul.chk .Lc0 %6, %6
    %9 = add.chk .Lc1 %7, %19
    %1 = move %9
    %5 = addi %5 #1
    jump L0
L2:
    %10 = move %1
    %12 = cmpi %10 #4 #10
    branch %12 L6 L4
L6:
    %13 = move %1
    %15 = cmpi %13 #2 #20
    branch %15 L3 L4
L3:
    %16 = sym .Ls3
    ccall vela_print_str (%16 as str) #0
    jump L5
L4:
L5:
    ret

fn main(%0, %1)
    ccall vela_init (%0, %1) #0
    call f_main
    %2 = const #0
    ret %2

