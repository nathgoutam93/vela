// vela query type: what a name is, with its declaration and its comment.
// The position is in a module, shapes.vl, which is checked as part of
// this program.
// stage 1 only
// command: query type FILE:12:32
import shapes

fn main() {
    let all = [shapes.Shape.Circle(1.0), shapes.Shape.Rect(2.0, 3.0)]
    let mut total = 0.0
    for s in all {
        total = total + shapes.area(s)
    }
    print(total)
}
