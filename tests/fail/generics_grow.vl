// Generic functions that call each other with ever bigger types would need
// copies without end; the code generator stops and says where it starts.
// stage 1 only
// err: generics_grow.vl:13:12: error: 'f' is called here with types that grow without end, as generic functions that call each other with bigger types do (f[T] calling g[[T]])
fn f[T](x: T, n: Int) -> Int {
    if n == 0 {
        return 0
    }
    return g([x], n - 1)
}

fn g[T](x: T, n: Int) -> Int {
    return f([x], n)
}

fn main() {
    print(f(1, 3))
}
