import files
import tasks

fn size(path: Str) -> Int uses fs {
    match files.read(path) {
        Ok(t) => return len(t)
        Err(_) => return 0
    }
}

// The effects of the function given to tasks.map are the caller's.
fn sizes(paths: [Str]) -> [Int] {
    return tasks.map(paths, fn(p) => size(p))
}

fn sizes_named(paths: [Str]) -> [Int] {
    return tasks.map(paths, size)
}

// Only a function given straight to tasks.map: one kept in a variable
// could be called anywhere, later.
fn kept(paths: [Str]) -> [Int] uses fs {
    let f = fn(p: Str) => size(p)
    let g = size
    return tasks.map(paths, f)
}

// A closure inside the one given straight to tasks.map is a value again.
fn nested(paths: [Str]) -> [Int] uses fs {
    return tasks.map(paths, fn(p) {
        let later = fn() => size(p)
        return 0
    })
}

fn mistakes() {
    let a = tasks.map([1, 2], fn(n) {
        print(n)
    })
    let b = tasks.map(3, fn(n: Int) => n)
    let c = tasks.map([1], fn(s: Str) => s)
    tasks.each([1, 2])
    let d = tasks.map([], fn(x) => x)
    let e = tasks.each(["x"], fn(s) => len(s))
    let n: Str = tasks.workers()
}

test "no with inside tasks" {
    tasks.each([1], fn(n) {
        with args = ["x"] {
            print(n)
        }
    })
}

fn main() {
    mistakes()
}
