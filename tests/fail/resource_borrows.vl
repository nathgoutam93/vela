type Lock = struct { fd: Int } without Copy
type Holder = struct { lock: Lock, n: Int }
fn open(fd: Int) -> Lock { return Lock { fd: fd } }
fn close(l: take Lock) -> Int { return l.fd }
fn peek(l: Lock) -> Int { return l.fd }
fn keep(l: Lock) -> Lock { return l }
fn store(l: Lock) -> Holder { return Holder { lock: l, n: 0 } }
fn each(xs: [Lock], f: scoped fn(Lock) -> Int) -> Int uses f { return f(xs[0]) }
fn loops(xs: [Lock]) {
    for l in xs { print(close(l)) }
}
fn captured() {
    let a = open(1)
    print(each([open(2)], fn(l: Lock) -> Int { return close(a) }))
    print(each([open(3)], fn(l: Lock) -> Int { return close(l) }))
}
fn matched(o: Option[Lock]) {
    match o { Some(l) => print(close(l)), None => {} }
}
fn parts(h: take Holder, xs: take [Lock]) {
    let l = h.lock
    let x = xs[0]
    match h.lock { Lock { fd } => print(fd) }
    let n = h.n  // a Copy field is copied
    print(n)
}
