import maps

fn grow(xs: mut [Int]) {
    push(mut xs, 1)
}

fn first[T](xs: [T]) -> T {
    return xs[0]
}

fn double(x: Int) -> Int {
    return x * 2
}

fn main() {
    let g = grow
    let h = first
    let k = maps.get
    let f: fn(Str) -> Int = double
    let n = 5
    n(1)
    print(double(1, 2) == double)
    let d = double
    d("x")
    d(mut n)
    print(len)
}
