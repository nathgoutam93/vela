// Mistakes with `?`: on something that is not a Result or an Option, in a
// function that cannot pass the failure on, or with a different error type.
// err: try_errors.vl:20:15: error: '?' returns an Err from 'plain', so 'plain' must return a Result, but it returns Int
// err: try_errors.vl:24:16: error: '?' returns None from 'nothing', so 'nothing' must return an Option, but it returns nothing
// err: try_errors.vl:28:18: error: '?' would return this Result[Int, Str]'s error, which is Str, but 'wrong_error' returns Result[Int, Int]
// err: try_errors.vl:32:20: error: '?' returns an Err from 'mixed', so 'mixed' must return a Result, but it returns Option[Int]
// err: try_errors.vl:36:18: error: '?' returns None from 'mixed_back', so 'mixed_back' must return an Option, but it returns Result[Int, Str]
// err: try_errors.vl:41:16: error: '?' needs a Result or an Option, found Int
// err: try_errors.vl:46:6: error: this value is not used; only a call can stand alone as a statement
// err: try_errors.vl:51:16: error: '?' returns an Err from 'main', so 'main' must return a Result, but it returns nothing
fn r() -> Result[Int, Str] {
    return Ok(1)
}

fn o() -> Option[Int] {
    return Some(1)
}

fn plain() -> Int {
    return r()?
}

fn nothing() {
    let x = o()?
}

fn wrong_error() -> Result[Int, Int] {
    return Ok(r()?)
}

fn mixed() -> Option[Int] {
    return Some(r()?)
}

fn mixed_back() -> Result[Int, Str] {
    return Ok(o()?)
}

fn not_enum() -> Result[Int, Str] {
    let n = 5
    return Ok(n?)
}

fn stands_alone() -> Result[Int, Str] {
    let v = r()
    v?
    return Ok(0)
}

fn main() {
    let t = r()?
}
