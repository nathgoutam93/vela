// Mistakes with effects, contracts and fakes.
// err: effect_errors.vl:20:18: error: 'read' uses fs, through files.read, but does not say so; add `uses fs` after its signature [E3036]
// err: effect_errors.vl:23:28: warning: 'first' says `uses fs` but uses nothing of it [E7008]
// err: effect_errors.vl:30:12: error: effect 'os' is listed twice [E3019]
// err: effect_errors.vl:30:12: error: unknown effect 'net'; the effects are fs (the files module) and os (os.args, os.exit, os.env, os.run, os.output, os.read_line and os.read), or the name of a parameter that is a function, for whatever that function uses [E3015]
// err: effect_errors.vl:35:5: error: 'caller' uses os, through 'leave', but does not say so; add `uses os` after its signature [E3036]
// err: effect_errors.vl:38:11: warning: 'tidy' says `uses os` but uses nothing of it [E7008]
// err: effect_errors.vl:43:14: error: a requires clause must be Bool, found Int [E3093]
// err: effect_errors.vl:48:4: error: 'odd' has a parameter called 'result', which its ensures clauses cannot tell from the value it returns; rename the parameter [E3033]
// err: effect_errors.vl:54:13: error: undefined name 'result' [E3087]
// err: effect_errors.vl:59:5: error: 'with' only works in tests, where it fakes files, args, env, stdin or stdout for the code the test calls [E3038]
// err: effect_errors.vl:65:18: error: 'with files' needs a Map[Str, Str] from paths to contents, found [Str] [E3093]
// err: effect_errors.vl:65:31: error: 'with env' needs a Map[Str, Str] from names to values, found Int [E3093]
// err: effect_errors.vl:65:43: error: 'with stdout' collects what is printed into a strings.Builder variable, written `stdout = mut out` [E3040]
// err: effect_errors.vl:65:46: error: 'with' cannot fake 'net'; it fakes files, args, env, stdin and stdout [E3042]
import files
import os

fn read(path: Str) -> Result[Str, Str] {
    return files.read(path)
}

fn first(path: Str) -> Str uses fs {
    match read(path) {
        Ok(t) => return t
        Err(e) => return e
    }
}

fn leave() uses net, os, os {
    os.exit(1)
}

fn caller() {
    leave()
}

fn tidy() uses os {
    print("nothing to do")
}

fn twice(n: Int) -> Int
    requires n
    ensures result >= n {
    return n * 2
}

fn odd(result: Int) -> Int
    ensures result > 0 {
    return result
}

fn quiet()
    ensures result == 0 {
}

fn main() {
    let f = first
    with args = ["x"] {
        tidy()
    }
}

test "fakes need the right types" {
    with files = ["a"], env = 3, stdout = 1, net = 2 {
    }
}
