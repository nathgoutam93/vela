import files
import lists
import os

fn size(path: Str) -> Int uses fs {
    match files.read(path) {
        Ok(text) => return len(text)
        Err(_) => return 0
    }
}

fn apply(f: fn(Str) -> Int, x: Str) -> Int {
    return f(x)
}

fn apply_any(f: fn(Str) -> Int, x: Str) -> Int uses f {
    return f(x)
}

fn first[T](xs: [T], f: fn(T) -> Int) -> Int {
    return f(xs[0])
}

type Plain = struct {
    f: fn(Str) -> Int
}

// A function that uses fs cannot go where nothing allows it: it would be
// called by code that does not say `uses fs`.
fn launder(p: Str) -> Int {
    let a = apply(size, p)
    let g: fn(Str) -> Int = size
    let s = Plain { f: size }
    let b = first([p], size)
    return a + b
}

fn hand_out() -> fn(Str) -> Int {
    return size
}

// Through `uses f`, the caller uses what it passes.
fn undeclared(p: Str) -> Int {
    return apply_any(size, p) + lists.map([p], size)[0]
}

// Several effects in a parameter's type: the comma before `b: ...` ends them.
fn both(a: fn() uses fs, os, b: Int) uses fs, os {
    a()
}

fn bounded(a: fn() uses fs) uses a {
    a()
}

fn calls_both() uses fs, os {
    both(fn() {
        print(len(os.args()))
    }, 1)
}

// Misuses of `uses`.
fn wrong(f: mut fn(), n: Int, g: fn() uses f) uses f, n, bogus {
}

fn never(f: fn()) uses f {
    print(1)
}

fn in_types(h: fn() uses net) {
}

fn main() {
    let k = apply_any
    let pure = fn(s: Str) => len(s)
    // An array's elements have the first one's type; a written type can
    // allow more.
    let mixed = [pure, size]
    let allowed: [fn(Str) -> Int uses fs] = [pure, size]
}
