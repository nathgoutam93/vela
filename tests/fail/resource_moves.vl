type Lock = struct { fd: Int } without Copy
type Holder = struct { lock: Lock }
fn open(fd: Int) -> Lock { return Lock { fd: fd } }
fn close(l: take Lock) -> Int { return l.fd }
fn peek(l: Lock) -> Int { return l.fd }
fn assigned() {
    let a = open(1)
    let b = a
    print(peek(a))
    print(close(b))
}
fn closed() {
    let a = open(2)
    print(close(a))
    print(peek(a))
}
fn stored() -> Holder {
    let a = open(3)
    let h = Holder { lock: a }
    print(peek(a))
    return h
}
fn on_one_path(c: Bool) {
    let a = open(4)
    if c { print(close(a)) }
    print(peek(a))
}
fn in_a_loop() {
    let a = open(5)
    for i in 0..2 { print(close(a)) }
}
fn reassigned() {
    let mut a = open(6)
    print(close(a))
    a = open(7)
    print(peek(a))  // a holds a new value: no error
    for i in 0..2 {
        print(close(a))
        a = open(8)  // and each iteration gives it one
    }
}
fn by_match(o: take Option[Lock]) {
    match o { Some(l) => print(close(l)), None => {} }
    print(o.is_some())
}
fn main() {}
