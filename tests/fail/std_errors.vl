import files
import os
import strings

fn main() {
    let a = files.read(1)
    let b = files.write("x")
    os.exit("now")
    let c: Str = os.args()
    let built = strings.builder()
    strings.add(mut built, "x")
    let mut d = strings.builder()
    strings.add(mut d, 5)
    strings.add_byte(mut d, 300)
    print(d)
    let e = strings.build("text")
    let f = len(d)
    os.eprint([1])
    let g = strings.Builder
    let h: strings.Nope = 1
    let i = os.missing()
    let x = bytes.is_digit('1')
}
