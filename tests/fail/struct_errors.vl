    let p = Point { x: 1, z: 2 }
    let q = Point { x: 1, x: 2, y: 3 }
    let r = Nope { a: 1 }
    let s = Kind { a: 1 }
    print(p.z)
    let n = 5
    print(n.y)
    print(Kind.A.x)
    p.x = 1
    let mut m = Point { x: 1, y: 2 }
    m.x = true
    print(m == m)
    print(m)
    let t = Point
