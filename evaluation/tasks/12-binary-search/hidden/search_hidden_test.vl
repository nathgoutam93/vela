import search

fn found(xs: [Int], x: Int) -> Bool {
    return match search.find(xs, x) {
        Some(i) => i >= 0 && i < len(xs) && xs[i] == x
        None => false
    }
}

fn missing(xs: [Int], x: Int) -> Bool {
    return match search.find(xs, x) {
        Some(_) => false
        None => true
    }
}

test "find" {
    let xs = [1, 3, 3, 5, 7, 9]
    for x in xs {
        assert(found(xs, x))
    }
    assert(missing(xs, 0) && missing(xs, 4) && missing(xs, 10))
    assert(missing([], 1))
    assert(found([2], 2) && missing([2], 3))
}

test "count_less" {
    let xs = [1, 3, 3, 5, 7, 9]
    assert(search.count_less(xs, 0) == 0)
    assert(search.count_less(xs, 1) == 0)
    assert(search.count_less(xs, 3) == 1)
    assert(search.count_less(xs, 4) == 3)
    assert(search.count_less(xs, 9) == 5)
    assert(search.count_less(xs, 10) == 6)
    assert(search.count_less([], 5) == 0)
}
