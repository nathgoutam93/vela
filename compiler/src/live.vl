// Shared loop-aware live intervals; helpers include ARM backend call expansions.
import ir
import maps
pub type Intervals = struct {
    start: [Int]
    end: [Int]
    defs: [Int]
    def_at: [Int]  // the instruction setting it, when there is one
    first_def: [Int]  // the position it is first set at
    calls: [Int]  // calls[p]: how many calls are at positions before p
    cost: [Float]  // squared weighted uses / interval length: spill priority
}

fn big() -> Int {
    return 1000000000
}

fn is_call(op: ir.Op) -> Bool {
    return op == ir.Op.Call || op == ir.Op.CallInd || op == ir.Op.CCall
}

// Positions: 0 is the entry, where the parameters arrive; instruction i
// is at i + 1.
pub fn intervals(f: ir.Func, helpers: Bool) -> Intervals {
    let n = len(f.classes)
    let mut start: [Int] = []
    let mut end: [Int] = []
    let mut defs: [Int] = []
    let mut def_at: [Int] = []
    let mut first_def: [Int] = []
    let mut first_use: [Int] = []
    for _ in 0..n {
        push(mut start, big())
        push(mut end, -1)
        push(mut defs, 0)
        push(mut def_at, -1)
        push(mut first_def, big())
        push(mut first_use, big())
    }
    for r in f.params {
        start[r] = 0
        end[r] = 0
        first_def[r] = 0
        defs[r] = 2  // never a constant
    }
    let mut cost: [Float] = []; for _ in 0..n { push(mut cost, 0.0) }
    let mut label_at: Map[Int, Int] = [:]
    for i in 0..len(f.insts) {
        if f.insts[i].op == ir.Op.Label {
            label_at[f.insts[i].imm] = i + 1
        }
    }
    let mut edges: [[Int]] = []  // back edges: [the loop's start, the jump back]
    let mut calls: [Int] = [0]
    let mut count = 0
    for i in 0..len(f.insts) {
        let inst = f.insts[i]
        let p = i + 1
        push(mut calls, count)  // calls[p]: the calls before position p
        for u in ir.reads(inst) {
            if p < start[u] {
                start[u] = p
            }
            if p > end[u] {
                end[u] = p
            }
            if p < first_use[u] {
                first_use[u] = p
            }
        }
        if inst.dst >= 0 {
            let d = inst.dst
            if p < start[d] {
                start[d] = p
            }
            if p > end[d] {
                end[d] = p
            }
            if p < first_def[d] {
                first_def[d] = p
            }
            defs[d] = defs[d] + 1
            def_at[d] = i
        }
        if inst.op == ir.Op.Jump || inst.op == ir.Op.Branch || inst.op == ir.Op.BranchCmp {
            let h = label_at[inst.imm]
            if h <= p {
                push(mut edges, [h, p])
            }
            if inst.op == ir.Op.Branch {
                let h2 = label_at[inst.imm2]
                if h2 <= p {
                    push(mut edges, [h2, p])
                }
            }
        }
        let mut clobbers = is_call(inst.op) || (helpers && (inst.op == ir.Op.Copy && inst.imm > 256))
        if helpers && i + 1 < len(f.insts) && f.insts[i + 1].op == ir.Op.Unreachable { clobbers = false }
        if clobbers {
            count = count + 1
        }
    }
    push(mut calls, count)
    push(mut calls, count)
    // Over loops: a value live into a loop, out of it, or from one turn to
    // the next must live through the whole loop.
    let mut changed = len(edges) > 0
    for changed {
        changed = false
        for edge in edges {
            let h = edge[0]
            let p = edge[1]
            for v in 0..n {
                let s = start[v]
                let e = end[v]
                if e < 0 || e < h || s > p {
                    continue
                }
                let carried = first_use[v] < first_def[v] && first_use[v] >= h
                if s < h && e < p || s >= h && e > p && s > h || carried && (s > h || e < p) {
                    if s > h && (e > p || carried) {
                        start[v] = h
                    }
                    if e < p && (s < h || carried) {
                        end[v] = p
                    }
                    if start[v] != s || end[v] != e {
                        changed = true
                    }
                }
            }
        }
    }
    let mut depth_at: [Int] = []; for _ in 0..len(f.insts) + 3 { push(mut depth_at, 0) }
    for edge in edges { depth_at[edge[0]] = depth_at[edge[0]] + 1; depth_at[edge[1] + 1] = depth_at[edge[1] + 1] - 1 }
    let mut depth = 0
    for k in 0..len(f.insts) {
        depth = depth + depth_at[k + 1]
        let mut levels = depth; if levels > 4 { levels = 4 }
        let weight = float(1 << (levels * 3))
        let i = f.insts[k]
        for r in ir.reads(i) { cost[r] = cost[r] + weight }
        if i.dst >= 0 { cost[i.dst] = cost[i.dst] + weight }
    }
    // Balance reuse against occupation: total frequency alone can keep long
    // state intervals at the expense of every short intermediate. Squaring
    // before dividing is equivalent to uses/sqrt(length), without a sqrt.
    for r in 0..n { if end[r] >= start[r] { cost[r] = cost[r] * cost[r] / float(end[r] - start[r] + 1) } }
    return Intervals { start: start, end: end, defs: defs, def_at: def_at, first_def: first_def, calls: calls, cost: cost }
}

// Whether a call is strictly inside the interval of v.
pub fn crosses(iv: Intervals, v: Int) -> Bool {
    let s = iv.start[v]
    let e = iv.end[v]
    if e <= s + 1 {
        return false
    }
    return iv.calls[e] - iv.calls[s + 1] > 0
}

// Lifetime holes (TL-098): stretches of a value's interval where nothing
// reads or sets it and that hold a whole loop deeper than where control
// leaves them, so its register can serve other values there; the value is
// stored once after it is set and loaded again where control comes back. Only a value set once (or a
// parameter) has them: its home stays right without a store at every
// setting. A hole ends at the value's end, or right before a label that is
// not the header of a loop going on past it (a reload there would run at
// every turn), or at an instruction that does not fall through.
// holes[v]: [first, last, ...] positions, in order.
pub fn holes(f: ir.Func, iv: Intervals) -> [[Int]] {
    let n = len(f.classes)
    let count = len(f.insts)
    let mut out: [[Int]] = []
    for _ in 0..n { push(mut out, []) }
    let mut sets: [Int] = []
    for _ in 0..n { push(mut sets, 0) }
    let mut refs: [[Int]] = []
    for _ in 0..n { push(mut refs, []) }
    for r in f.params { push(mut refs[r], 0) }
    let mut label_at: Map[Int, Int] = [:]
    for i in 0..count {
        if f.insts[i].op == ir.Op.Label { label_at[f.insts[i].imm] = i + 1 }
    }
    let mut edges: [[Int]] = []
    let mut header_end: Map[Int, Int] = [:]  // a loop header's position: where its loop's last jump back is
    for i in 0..count {
        let inst = f.insts[i]
        let p = i + 1
        for u in ir.reads(inst) {
            let rs = refs[u]
            if len(rs) == 0 || rs[len(rs) - 1] != p { push(mut refs[u], p) }
        }
        if inst.dst >= 0 {
            sets[inst.dst] = sets[inst.dst] + 1
            let rs = refs[inst.dst]
            if len(rs) == 0 || rs[len(rs) - 1] != p { push(mut refs[inst.dst], p) }
        }
        if inst.op == ir.Op.Jump || inst.op == ir.Op.Branch || inst.op == ir.Op.BranchCmp {
            let mut ts = [inst.imm]
            if inst.op == ir.Op.Branch { push(mut ts, inst.imm2) }
            for t in ts {
                let h = label_at[t]
                if h <= p {
                    push(mut edges, [h, p])
                    if !maps.has(header_end, h) || header_end[h] < p { header_end[h] = p }
                }
            }
        }
    }
    // depth[p]: how many loops position p is in.
    let mut depth: [Int] = []
    for _ in 0..count + 3 { push(mut depth, 0) }
    for edge in edges {
        depth[edge[0]] = depth[edge[0]] + 1
        depth[edge[1] + 1] = depth[edge[1] + 1] - 1
    }
    for q in 1..count + 3 { depth[q] = depth[q] + depth[q - 1] }
    let mut params: Map[Int, Bool] = [:]
    for r in f.params { params[r] = true }
    for v in 0..n {
        let once = sets[v] == 1 && !maps.has(params, v) || sets[v] == 0 && maps.has(params, v)
        let s = iv.start[v]
        let e = iv.end[v]
        if !once || e <= s + 1 || len(refs[v]) == 0 { continue }
        let rs = refs[v]
        let mut found: [Int] = []
        for k in 0..len(rs) {
            let g0 = rs[k] + 1
            let mut g1 = e
            let tail = k + 1 == len(rs)
            if !tail { g1 = rs[k + 1] - 1 }
            if g1 < g0 { continue }
            let mut y = g1
            if !tail {
                // The latest end whose next position is a label that is not
                // a loop header going on past it, or after an instruction
                // that does not fall through.
                y = -1
                let mut q = g1
                for q >= g0 && y < 0 {
                    let op = f.insts[q - 1].op
                    let next = f.insts[q].op  // position q + 1: the instruction after
                    let header = maps.has(header_end, q + 1) && header_end[q + 1] > q
                    if next == ir.Op.Label && !header || op == ir.Op.Jump || op == ir.Op.Ret || op == ir.Op.Unreachable { y = q }
                    q = q - 1
                }
                if y < 0 { continue }
            }
            // It must hold a whole loop deeper than every place control
            // leaves it for the rest of the interval, where the value is
            // reloaded: else a reload runs as often as the hole's code.
            let mut deepest = -1
            for edge in edges {
                if edge[0] >= g0 && edge[1] <= y && depth[edge[0]] > deepest { deepest = depth[edge[0]] }
            }
            let mut exits = 0
            for q in g0..y + 1 {
                for t in jump_labels(f.insts[q - 1]) {
                    let tp = label_at[t]
                    if (tp < g0 || tp > y) && tp >= s && tp <= e && depth[tp] > exits { exits = depth[tp] }
                }
            }
            let last = f.insts[y - 1].op
            if y + 1 <= e && last != ir.Op.Jump && last != ir.Op.Branch && last != ir.Op.Ret && last != ir.Op.Unreachable && depth[y + 1] > exits {
                exits = depth[y + 1]
            }
            if deepest > exits {
                push(mut found, g0)
                push(mut found, y)
            }
        }
        out[v] = found
    }
    return out
}

fn jump_labels(i: ir.Inst) -> [Int] {
    if i.op == ir.Op.Jump || i.op == ir.Op.BranchCmp { return [i.imm] }
    if i.op == ir.Op.Branch { return [i.imm, i.imm2] }
    return []
}
