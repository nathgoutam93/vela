// Shared loop-aware live intervals; helpers include ARM backend call expansions.
import ir
import maps
pub type Intervals = struct {
    start: [Int]
    end: [Int]
    defs: [Int]
    def_at: [Int]  // the instruction setting it, when there is one
    first_def: [Int]  // the position it is first set at
    calls: [Int]  // calls[p]: how many calls are at positions before p
    cost: [Float]  // squared weighted uses / interval length: spill priority
}

fn big() -> Int {
    return 1000000000
}

fn is_call(op: ir.Op) -> Bool {
    return op == ir.Op.Call || op == ir.Op.CallInd || op == ir.Op.CCall
}

// Positions: 0 is the entry, where the parameters arrive; instruction i
// is at i + 1.
pub fn intervals(f: ir.Func, helpers: Bool) -> Intervals {
    let n = len(f.classes)
    let mut start: [Int] = []
    let mut end: [Int] = []
    let mut defs: [Int] = []
    let mut def_at: [Int] = []
    let mut first_def: [Int] = []
    let mut first_use: [Int] = []
    for _ in 0..n {
        push(mut start, big())
        push(mut end, -1)
        push(mut defs, 0)
        push(mut def_at, -1)
        push(mut first_def, big())
        push(mut first_use, big())
    }
    for r in f.params {
        start[r] = 0
        end[r] = 0
        first_def[r] = 0
        defs[r] = 2  // never a constant
    }
    let mut cost: [Float] = []; for _ in 0..n { push(mut cost, 0.0) }
    let mut label_at: Map[Int, Int] = [:]
    for i in 0..len(f.insts) {
        if f.insts[i].op == ir.Op.Label {
            label_at[f.insts[i].imm] = i + 1
        }
    }
    let mut edges: [[Int]] = []  // back edges: [the loop's start, the jump back]
    let mut calls: [Int] = [0]
    let mut count = 0
    for i in 0..len(f.insts) {
        let inst = f.insts[i]
        let p = i + 1
        push(mut calls, count)  // calls[p]: the calls before position p
        for u in ir.reads(inst) {
            if p < start[u] {
                start[u] = p
            }
            if p > end[u] {
                end[u] = p
            }
            if p < first_use[u] {
                first_use[u] = p
            }
        }
        if inst.dst >= 0 {
            let d = inst.dst
            if p < start[d] {
                start[d] = p
            }
            if p > end[d] {
                end[d] = p
            }
            if p < first_def[d] {
                first_def[d] = p
            }
            defs[d] = defs[d] + 1
            def_at[d] = i
        }
        if inst.op == ir.Op.Jump || inst.op == ir.Op.Branch || inst.op == ir.Op.BranchCmp {
            let h = label_at[inst.imm]
            if h <= p {
                push(mut edges, [h, p])
            }
            if inst.op == ir.Op.Branch {
                let h2 = label_at[inst.imm2]
                if h2 <= p {
                    push(mut edges, [h2, p])
                }
            }
        }
        let mut clobbers = is_call(inst.op) || (helpers && (inst.op == ir.Op.Copy && inst.imm > 256))
        if helpers && i + 1 < len(f.insts) && f.insts[i + 1].op == ir.Op.Unreachable { clobbers = false }
        if clobbers {
            count = count + 1
        }
    }
    push(mut calls, count)
    push(mut calls, count)
    // Over loops: a value live into a loop, out of it, or from one turn to
    // the next must live through the whole loop.
    let mut changed = len(edges) > 0
    for changed {
        changed = false
        for edge in edges {
            let h = edge[0]
            let p = edge[1]
            for v in 0..n {
                let s = start[v]
                let e = end[v]
                if e < 0 || e < h || s > p {
                    continue
                }
                let carried = first_use[v] < first_def[v] && first_use[v] >= h
                if s < h && e < p || s >= h && e > p && s > h || carried && (s > h || e < p) {
                    if s > h && (e > p || carried) {
                        start[v] = h
                    }
                    if e < p && (s < h || carried) {
                        end[v] = p
                    }
                    if start[v] != s || end[v] != e {
                        changed = true
                    }
                }
            }
        }
    }
    let mut depth_at: [Int] = []; for _ in 0..len(f.insts) + 3 { push(mut depth_at, 0) }
    for edge in edges { depth_at[edge[0]] = depth_at[edge[0]] + 1; depth_at[edge[1] + 1] = depth_at[edge[1] + 1] - 1 }
    let mut depth = 0
    for k in 0..len(f.insts) {
        depth = depth + depth_at[k + 1]
        let mut levels = depth; if levels > 4 { levels = 4 }
        let weight = float(1 << (levels * 3))
        let i = f.insts[k]
        for r in ir.reads(i) { cost[r] = cost[r] + weight }
        if i.dst >= 0 { cost[i.dst] = cost[i.dst] + weight }
    }
    // Balance reuse against occupation: total frequency alone can keep long
    // state intervals at the expense of every short intermediate. Squaring
    // before dividing is equivalent to uses/sqrt(length), without a sqrt.
    for r in 0..n { if end[r] >= start[r] { cost[r] = cost[r] * cost[r] / float(end[r] - start[r] + 1) } }
    return Intervals { start: start, end: end, defs: defs, def_at: def_at, first_def: first_def, calls: calls, cost: cost }
}

// Whether a call is strictly inside the interval of v.
pub fn crosses(iv: Intervals, v: Int) -> Bool {
    let s = iv.start[v]
    let e = iv.end[v]
    if e <= s + 1 {
        return false
    }
    return iv.calls[e] - iv.calls[s + 1] > 0
}
