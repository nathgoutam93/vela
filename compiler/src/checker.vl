// The type checker: types, names, effects and every error message.
// It reports all of a program's errors in one run, sorted (errors.vl).
//
// Its findings go into
// arrays indexed by node id (ty, refs, breaks), and the checker's state is
// one `mut` value threaded through every function.
//
// A message that names the type found is a Msg (this file predates
// function values, M10b): the text
// before and after where the type goes.
import ast
import errors
import integers
import cffi
import sysops
import interfaces
import lexer
import maps
import match_check
import modules
import parser
import repairs
import strings
import types

pub type Local = struct {
    name: Str
    ty: Int
    kind: Str  // "let", "let mut", "parameter", "mut parameter", "loop variable" or "match binding"
    line: Int
    col: Int
}

pub type FnInfo = struct {
    decl: ast.FnDecl
    module: Int  // index into the program's modules
    params: [Int]  // ERROR where a type name was unknown
    mutable: [Bool]
    result: Int  // types.NOTHING() when it returns nothing
    param_locals: [Int]
    type_params: [Int]  // a generic function's, as Param types
    is_test: Bool  // a `test` block, checked as a function named `test "..."`
    result_local: Int  // `result` in its ensures clauses, or -1
}

// What a name, call, field, pattern or declaration refers to.
pub type Ref = enum {
    NoRef
    Local(Int)
    Function(Int)
    Builtin(Str)  // "print", "maps.get", ...
    Variant(Int, Int)  // the enum's type, the variant's index
    Indirect  // a call through a function value
    Method(Int, Str)  // receiver type and statically dispatched method name
}

// A generic function called or used as a value inside another function, with
// its type arguments, which can mention the caller's type parameters.
type GenericUse = struct {
    caller: Int
    callee: Int
    args: [Int]
    module: Int
    line: Int
    col: Int
}

// A closure, by the node id of its expression.
pub type ClosureInfo = struct {
    params: [Int]  // locals
    captures: [Int]  // locals of the enclosing code it copies, in order of first use
    result: Int  // NOTHING() when it returns nothing
}

// While a closure's body is checked.
type ClosureCtx = struct {
    id: Int  // its node id
    boundary: Int  // its own scopes start here in c.scopes
    captures: [Int]
    result: Int  // -3 until a return says, when it was not written
    // What its body uses (M15), which its type says: whoever calls it uses it.
    effects: [Str]
}

pub type Checked = struct {
    proved_contracts: Map[Int, Bool]  // fresh compiler-only proof annotations; never loaded from a report
    target: Str
    errors: [errors.CompileError]  // sorted
    warnings: [errors.CompileError]  // sorted; they do not stop the program from compiling
    table: types.Table
    modules: [modules.Module]
    fns: [FnInfo]  // every function, in program order
    decls: [Int]  // the type of every type declaration, in program order
    locals: [Local]
    ty: [Int]  // each expression's type, by node id
    refs: [Ref]  // by node id
    breaks: [Bool]  // by node id: whether a `for` loop has a break
    targs: [[Int]]  // by node id: the type arguments of a call to a generic function
    closures: Map[Int, ClosureInfo]  // by node id
    completion: Completion
    escaped: Map[Int, Bool]
    stack: Int  // bytes for main's thread (vela.mod `stack`), or 0 for the system's
}

// What is in scope where the name being completed is (M12b, complete.vl):
// the program is checked with that name written as `name`.
pub type Completion = struct {
    name: Str  // "" when not completing
    module: Int  // where it was met, or -1 if it was not
    visible: [Int]  // the locals in scope there, innermost first, one per name
    type_params: [Str]  // the type parameters in scope there
    object: [ast.Expr]  // `x` when it is `x.name`: its type is in ty
}

type Loop = struct {
    id: Int
    is_for: Bool  // a plain `for`, not `for ... in`
}

type Msg = struct {
    before: Str
    after: Str
}

type BoundUse = struct { module: Int, line: Int, col: Int, owner: Str, param: Int, actual: Int }
type KeyUse = struct { module: Int, line: Int, col: Int, actual: Int }

type Checker = struct {
    target: Str
    library: Bool
    unsafe_depth: Int
    escaped: Map[Int, Bool]
    signatures_done: Bool
    bound_uses: [BoundUse]
    key_uses: [KeyUse]
    last_error: Int  // the reported diagnostic, including a deduplicated one
    errors: [errors.CompileError]
    warnings: [errors.CompileError]
    table: types.Table
    modules: [modules.Module]
    order: [Int]
    current: Int  // the module being checked
    fns: [FnInfo]
    decls: [Int]
    locals: [Local]
    ty: [Int]
    refs: [Ref]
    breaks: [Bool]
    scopes: [Map[Str, Int]]  // local ids, innermost last
    current_fn: Int  // the function being checked
    generic_uses: [GenericUse]  // generic functions called or used as values, for expanding_cycles
    loops: [Loop]
    undefined: [Str]  // unknown names already reported in this function
    targs: [[Int]]
    literal: [Int]  // by node id: 1 for an integer literal expression (is_int_lit), 2 for not, 0 not yet known
    chained: [Bool]  // by node id: a left operand inferred ahead by `chain`, its type in ty
    type_scope: Map[Str, Int]  // the type parameters in scope, by name
    effects_used: Map[Str, Bool]  // by the function being checked
    effects_reported: Map[Str, Bool]  // missing from its `uses`, and already said so
    defining: Int  // the generic type whose fields are being read, or -1
    expected: Int  // the type the context wants for the expression about to be inferred, or -2
    closures: Map[Int, ClosureInfo]
    in_closures: [ClosureCtx]  // the closures being checked, innermost last
    pending: [Int]  // type parameters of a generic call whose arguments are being checked, still unknown
    completion: Completion
}

pub fn check(loaded: modules.Loaded) -> Checked {
    return check_program(loaded, false)
}

// `for_tests`: the program is checked to run its tests, so it need not
// have a main function.
pub fn check_program(loaded: modules.Loaded, for_tests: Bool) -> Checked {
    return check_completing(loaded, for_tests, "")
}

// The program checked as for its tests, noting what is in scope where the
// name `name` is (see Completion).
pub fn check_completing(loaded: modules.Loaded, for_tests: Bool, name: Str) -> Checked {
    return check_target(loaded, for_tests, name, "")
}

pub fn check_target(loaded: modules.Loaded, for_tests: Bool, name: Str, target: Str) -> Checked {
    let mut ty: [Int] = []
    let mut refs: [Ref] = []
    let mut breaks: [Bool] = []
    let mut targs: [[Int]] = []
    let mut literal: [Int] = []
    for _ in 0..loaded.node_count {
        push(mut ty, -2)
        push(mut refs, Ref.NoRef)
        push(mut breaks, false)
        push(mut targs, [])
        push(mut literal, 0)
    }
    let mut c = Checker {
        target: target, library: for_tests, unsafe_depth: 0, escaped: [:], signatures_done: false, bound_uses: [], key_uses: [], last_error: -1,
        errors: [], warnings: [], table: types.new_table(), modules: loaded.modules, order: loaded.order, current: 0,
        fns: [], decls: [], locals: [], ty: ty, refs: refs, breaks: breaks, scopes: [], current_fn: -1, generic_uses: [], loops: [],
        undefined: [], targs: targs, literal: literal, chained: breaks, type_scope: [:], effects_used: [:], effects_reported: [:], closures: [:],
        in_closures: [], pending: [], defining: -1, expected: -2,
        completion: Completion { name: name, module: -1, visible: [], type_params: [], object: [] },
    }
    // A file with main is a program even when only checking or running tests.
    for f in loaded.modules[loaded.order[len(loaded.order) - 1]].program.fns {
        if f.name == "main" {
            c.library = false
        }
    }
    c.warnings = loaded.warnings
    let source = interfaces.source()
    let parsed = parser.parse(lexer.tokenize(source).tokens, loaded.node_count)
    let prelude = modules.Module { name: "<prelude>", package: "std", path: "<prelude>", file: "<prelude>", source: source,
        program: parsed.program, has_program: true, imports: [:], std: [], is_std: true, types: [:], fns: [:] }
    let mut order = [len(c.modules)]
    for m in c.order { push(mut order, m) }
    c.order = order
    push(mut c.modules, prelude)
    program(mut c, for_tests)
    expanding_cycles(mut c)
    validate_fixed(mut c)
    return Checked {
        proved_contracts: [:],
        target: target,
        errors: errors.sorted(c.errors), warnings: errors.sorted(c.warnings), table: c.table, modules: c.modules, fns: c.fns, decls: c.decls,
        locals: c.locals, ty: c.ty, refs: c.refs, breaks: c.breaks, targs: c.targs, closures: c.closures,
        completion: c.completion, escaped: c.escaped, stack: loaded.stack,
    }
}

// ---- Generic instantiation cycles ----

fn note_generic_use(c: mut Checker, e: ast.Expr, callee: Int, args: [Int]) {
    if c.current_fn >= 0 && len(c.fns[c.current_fn].type_params) > 0 {
        push(mut c.generic_uses, GenericUse { caller: c.current_fn, callee: callee, args: args, module: c.current,
            line: e.line, col: e.col })
    }
}

// Generic functions that use each other with type arguments growing around
// a cycle (f[T] using g[[T]], g[U] using f[U]) would need endless copies.
// Each type parameter of each generic function is a node; a use of g inside
// f links each of f's parameters to each of g's that its argument mentions,
// expanding when the argument is bigger than the parameter itself. An
// expanding link inside a strongly connected component never stops growing
// (the expanding-cycle rule of C#'s generics). A function using itself is
// E3145; methods resolved through interfaces are left to monomorphization's
// depth limit (mono.vl), which reports the same error.
fn expanding_cycles(c: mut Checker) {
    if len(c.generic_uses) == 0 {
        return
    }
    let mut first: Map[Int, Int] = [:]  // a function's first node
    let mut n = 0
    for u in c.generic_uses {
        for f in [u.caller, u.callee] {
            if !maps.has(first, f) {
                first[f] = n
                n = n + len(c.fns[f].type_params)
            }
        }
    }
    let mut next: [[Int]] = []
    for _ in 0..n {
        let none: [Int] = []
        push(mut next, none)
    }
    let mut edges: [[Int]] = []  // from, to, the use's index, 1 when expanding
    for k in 0..len(c.generic_uses) {
        let u = c.generic_uses[k]
        let from = c.fns[u.caller].type_params
        for j in 0..len(u.args) {
            for i in 0..len(from) {
                if types.mentions(c.table, u.args[j], from[i]) {
                    let a = first[u.caller] + i
                    let b = first[u.callee] + j
                    push(mut next[a], b)
                    let mut growing = 0
                    if u.args[j] != from[i] {
                        growing = 1
                    }
                    push(mut edges, [a, b, k, growing])
                }
            }
        }
    }
    let component = components(next)
    let mut reported: Map[Int, Bool] = [:]
    let saved = c.current
    for edge in edges {
        let u = c.generic_uses[edge[2]]
        if edge[3] == 1 && component[edge[0]] == component[edge[1]] && u.caller != u.callee && !maps.has(reported, edge[2]) {
            reported[edge[2]] = true
            c.current = u.module
            report(mut c, u.line, u.col, "E7006", "'" + c.fns[u.callee].decl.name + "' is called here with types that grow " +
                "without end, as generic functions that call each other with bigger types do (f[T] calling g[[T]])")
        }
    }
    c.current = saved
}

// Strongly connected components (Tarjan's algorithm, iteratively): each
// node's component number.
fn components(next: [[Int]]) -> [Int] {
    let n = len(next)
    let mut index: [Int] = []
    let mut low: [Int] = []
    let mut on_stack: [Bool] = []
    let mut component: [Int] = []
    for _ in 0..n {
        push(mut index, -1)
        push(mut low, 0)
        push(mut on_stack, false)
        push(mut component, -1)
    }
    let mut stack: [Int] = []
    let mut counter = 0
    let mut found = 0
    for root in 0..n {
        if index[root] >= 0 {
            continue
        }
        // The depth-first path: nodes and how many of their links are done.
        let mut path: [Int] = [root]
        let mut done: [Int] = [0]
        index[root] = counter
        low[root] = counter
        counter = counter + 1
        push(mut stack, root)
        on_stack[root] = true
        for len(path) > 0 {
            let v = path[len(path) - 1]
            let d = done[len(done) - 1]
            if d < len(next[v]) {
                done[len(done) - 1] = d + 1
                let w = next[v][d]
                if index[w] < 0 {
                    index[w] = counter
                    low[w] = counter
                    counter = counter + 1
                    push(mut stack, w)
                    on_stack[w] = true
                    push(mut path, w)
                    push(mut done, 0)
                } else if on_stack[w] && index[w] < low[v] {
                    low[v] = index[w]
                }
                continue
            }
            path = path[0..len(path) - 1]
            done = done[0..len(done) - 1]
            if len(path) > 0 {
                let parent = path[len(path) - 1]
                if low[v] < low[parent] {
                    low[parent] = low[v]
                }
            }
            if low[v] == index[v] {
                for {
                    let w = stack[len(stack) - 1]
                    stack = stack[0..len(stack) - 1]
                    on_stack[w] = false
                    component[w] = found
                    if w == v {
                        break
                    }
                }
                found = found + 1
            }
        }
    }
    return component
}

// ---- Small helpers ----

fn plural(n: Int, word: Str) -> Str {
    if n == 1 {
        return strings.from_int(n) + " " + word
    }
    return strings.from_int(n) + " " + word + "s"
}

fn report(c: mut Checker, line: Int, col: Int, code: Str, message: Str) {
    let e = errors.CompileError { code: code, fix: [],
        path: c.modules[c.current].path, line: line, col: col, message: message, warning: false,
    }
    c.last_error = errors.add(mut c.errors, e)
}

fn warn_at(c: mut Checker, e: ast.Expr, code: Str, message: Str) {
    let w = errors.CompileError { code: code, fix: [],
        path: c.modules[c.current].path, line: e.line, col: e.col, message: message, warning: true,
    }
    errors.add(mut c.warnings, w)
}

fn report_at(c: mut Checker, e: ast.Expr, code: Str, message: Str) {
    report(mut c, e.line, e.col, code, message)
}

fn last_fix(c: mut Checker, edits: [errors.Edit]) {
    if c.last_error >= 0 {
        c.errors[c.last_error].fix = repairs.validated(c.modules[c.current].source, edits)
    }
}

// A type as this module's code writes it.
fn show(c: Checker, t: Int) -> Str {
    return types.show(c.table, t, c.modules[c.current].name)
}

fn msg(before: Str, after: Str) -> Msg {
    return Msg { before: before, after: after }
}

fn say(m: Msg, found: Str) -> Str {
    return m.before + found + m.after
}

fn module_types(c: Checker) -> Map[Str, Int] {
    return c.modules[c.current].types
}

fn module_fns(c: Checker) -> Map[Str, Int] {
    return c.modules[c.current].fns
}

fn is_builtin_variant(name: Str) -> Bool {
    return name == "None" || name == "Some" || name == "Ok" || name == "Err"
}

// Option for None and Some, Result for Ok and Err.
fn variant_family(name: Str) -> Str {
    if name == "None" || name == "Some" {
        return "Option"
    }
    return "Result"
}

pub fn prelude() -> [Str] {
    let mut names = ["print", "len", "push", "int", "byte", "assert", "float"]
    for name in integers.names() { push(mut names, name) }
    return names
}

fn is_prelude(name: Str) -> Bool {
    return integers.type_id(name) >= 0 || name == "print" || name == "len" || name == "push" || name == "int" || name == "byte" || name == "assert" ||
        name == "float"
}

fn set_ty(c: mut Checker, e: ast.Expr, t: Int) {
    c.ty[e.id] = t
}

// ---- Declarations ----

// Each step is done for every module before the next starts: every type
// gets an id, then fields and signatures are worked out, then bodies.
fn program(c: mut Checker, for_tests: Bool) {
    let mut decl_start: [Int] = []
    for m in c.order {
        c.current = m
        push(mut decl_start, len(c.decls))
        declare_types(mut c)
    }
    for k in 0..len(c.order) {
        c.current = c.order[k]
        let decls = c.modules[c.current].program.types
        for i in 0..len(decls) {
            let d = decls[i]
            let t = c.decls[decl_start[k] + i]
            if d.is_interface {
                c.table.types[t].params = [types.param(mut c.table, "Self", [types.interface_name(types.get(c.table, t))], d.line, d.col)]
            } else {
                c.table.types[t].params = make_type_params(mut c, d.params)
            }
        }
    }
    for k in 0..len(c.order) {
        c.current = c.order[k]
        define_types(mut c, decl_start[k])
    }
    types.fill_instances(mut c.table)
    let mut fn_start: [Int] = []
    for m in c.order {
        c.current = m
        push(mut fn_start, len(c.fns))
        signatures(mut c)
    }
    c.signatures_done = true
    validate_interfaces(mut c)
    for use in c.bound_uses {
        c.current = use.module
        check_bounds(mut c, use.line, use.col, use.owner, use.param, use.actual)
    }
    for use in c.key_uses {
        c.current = use.module
        if !key_type(c, use.actual) {
            report(mut c, use.line, use.col, "E3026", key_failure(c, use.actual))
        }
    }
    for k in 0..len(c.order) {
        c.current = c.order[k]
        let program = c.modules[c.current].program
        for i in 0..len(program.fns) + len(program.tests) {
            function(mut c, fn_start[k] + i)
        }
    }
    c.current = c.order[len(c.order) - 1]  // the main module
    match maps.get(module_fns(c), "main") {
        None => {
            if !for_tests {
                report(mut c, 1, 1, "E3001", "the program has no main function; execution starts at fn main()")
            }
        }
        Some(id) => {
            let main = c.fns[id].decl
            let mut has_result = false
            match main.result {
                Some(_) => has_result = true
                None => {}
            }
            if len(main.params) > 0 || has_result {
                report(mut c, main.line, main.col, "E3002", "main must take no parameters and return nothing")
            } else if len(main.type_params) > 0 {
                report(mut c, main.line, main.col, "E3003", "main cannot have type parameters")
            }
        }
    }
}

// Report a top-level name that clashes with an imported module.
fn taken(c: mut Checker, name: Str, line: Int, col: Int, what: Str) -> Bool {
    if maps.has(c.modules[c.current].imports, name) {
        report(mut c, line, col, "E3004", what + " '" + name + "' has the same name as an imported module")
        return true
    }
    return false
}

fn declare_types(c: mut Checker) {
    let m = c.current
    for d in c.modules[m].program.types {
        let id = types.add_user(mut c.table, d.is_struct, d.name, c.modules[m].name, d.public, d.line, d.col)
        if d.is_interface { c.table.types[id].tag = types.Tag.Interface; c.table.types[id].open = true }
        push(mut c.decls, id)
        if types.primitive(d.name) >= 0 || types.generic_arity(d.name) >= 0 || d.is_interface && c.modules[m].name != "<prelude>" && (d.name == "Eq" || d.name == "Ord" || d.name == "Key") {
            report(mut c, d.line, d.col, "E3005", "'" + d.name + "' is a built-in type and cannot be redefined")
        } else if maps.has(module_types(c), d.name) {
            let first = types.get(c.table, module_types(c)[d.name])
            report(mut c, d.line, d.col, "E3006", "type '" + d.name + "' is already defined at " +
                strings.from_int(first.line) + ":" + strings.from_int(first.col))
        } else if !taken(mut c, d.name, d.line, d.col, "type") {
            c.modules[m].types[d.name] = id
        }
    }
}

// The Param types for a declaration's type parameters, checked.
fn make_type_params(c: mut Checker, params: [ast.TypeParam]) -> [Int] {
    let mut out: [Int] = []
    let mut seen: [Str] = []
    for p in params {
        for s in seen {
            if s == p.name {
                report(mut c, p.line, p.col, "E3007", "type parameter '" + p.name + "' is declared twice")
            }
        }
        push(mut seen, p.name)
        if types.primitive(p.name) >= 0 || types.generic_arity(p.name) >= 0 {
            report(mut c, p.line, p.col, "E3008", "type parameter '" + p.name + "' has the name of a built-in type")
        }
        let mut bounds: [Str] = []
        for b in p.bounds { push(mut bounds, resolve_bound(mut c, b, p.line, p.col)) }
        push(mut out, types.param(mut c.table, p.name, bounds, p.line, p.col))
    }
    return out
}

// The type parameters in `ids` by name, for resolving the types that mention them.
fn scope_of(c: Checker, ids: [Int]) -> Map[Str, Int] {
    let mut scope: Map[Str, Int] = [:]
    for t in ids {
        scope[types.get(c.table, t).name] = t
    }
    return scope
}

// Fill in the types' fields and variants.
fn define_types(c: mut Checker, first_decl: Int) {
    let decls = c.modules[c.current].program.types
    for k in 0..len(decls) {
        let d = decls[k]
        let id = c.decls[first_decl + k]
        c.type_scope = scope_of(c, types.get(c.table, id).params)
        c.defining = id
        if d.public && !d.is_interface { public_bounds(mut c, types.get(c.table, id).params, d.line, d.col) }
        if d.is_interface {
            define_interface(mut c, id, d)
            c.type_scope = [:]
            c.defining = -1
            continue
        }
        let mut what = "enum '" + d.name + "'"
        if d.is_struct {
            what = "struct '" + d.name + "'"
        }
        if d.public {
            if d.is_struct {
                for f in d.fields {
                    exposes(mut c, f.ty, what)
                }
            } else {
                for v in d.variants {
                    for t in v.payload {
                        exposes(mut c, t, what)
                    }
                }
            }
        }
        if d.is_struct {
            if len(d.fields) == 0 {
                report(mut c, d.line, d.col, "E3010", "struct '" + d.name + "' needs at least one field")
            }
            for f in d.fields {
                let existing = types.field_index(c.table, id, f.name)
                if existing >= 0 {
                    report(mut c, f.line, f.col, "E3011", "field '" + f.name + "' is already declared in '" + d.name + "'")
                }
                let ft = resolve_type(mut c, f.ty)
                // As with a Python dict: a repeated name keeps its first
                // place and takes the later type.
                if existing >= 0 {
                    c.table.types[id].fields[existing].ty = ft
                } else {
                    push(mut c.table.types[id].fields, types.FieldInfo { name: f.name, ty: ft })
                }
            }
        } else {
            if len(d.variants) == 0 {
                report(mut c, d.line, d.col, "E3012", "enum '" + d.name + "' needs at least one variant")
            }
            for v in d.variants {
                if types.variant_index(c.table, id, v.name) >= 0 {
                    report(mut c, v.line, v.col, "E3013", "variant '" + v.name + "' is already declared in '" + d.name + "'")
                    continue
                }
                let mut payload: [Int] = []
                for t in v.payload {
                    push(mut payload, resolve_type(mut c, t))
                }
                push(mut c.table.types[id].variants, types.Variant { name: v.name, payload: payload })
            }
        }
        c.table.types[id].filled = true
        c.type_scope = [:]
        c.defining = -1
    }
}

// A pub declaration must not mention a private type of its own module.
fn exposes(c: mut Checker, t: ast.TypeName, what: Str) {
    if t.module == "" {
        match maps.get(module_types(c), t.name) {
            Some(id) => {
                if !types.get(c.table, id).public {
                    report(mut c, t.line, t.col, "E3014", "pub " + what + " uses the private type '" + t.name +
                        "'; declare it with 'pub type " + t.name + "'")
                }
            }
            None => {}
        }
    }
    for a in t.args {
        exposes(mut c, a, what)
    }
}

fn signatures(c: mut Checker) {
    let m = c.current
    for f in c.modules[m].program.fns {
        let type_params = make_type_params(mut c, f.type_params)
        if f.public { public_bounds(mut c, type_params, f.line, f.col) }
        c.type_scope = scope_of(c, type_params)
        let mut params: [Int] = []
        let mut mutable: [Bool] = []
        for p in f.params {
            push(mut params, resolve_type(mut c, p.ty))
            push(mut mutable, p.mutable)
        }
        let mut result = types.NOTHING()
        match f.result {
            Some(t) => result = resolve_type(mut c, t)
            None => {}
        }
        c.type_scope = [:]
        for i in 0..len(f.effects) {
            let u = f.effects[i]
            let pi = param_named(f, u)
            if types.concrete_effect(u) {
            } else if pi < 0 {
                report(mut c, f.effects_line, f.effects_col, "E3015", "unknown effect '" + u + "'; the effects are fs (the files module), " +
                    "os (os.args, os.exit, os.env, os.run, os.output, os.read_line and os.read), unsafe (C and raw memory), net (networking), clock (time), or the name of a " +
                        "parameter that is a function, for whatever that function uses")
            } else if !types.is_func(c.table, params[pi]) {
                if params[pi] != types.ERROR() {
                    report(mut c, f.effects_line, f.effects_col, "E3016", "`uses " + u + "` names parameter '" + u + "', which is " +
                        show(c, params[pi]) + ", not a function")
                }
            } else if f.params[pi].mutable {
                report(mut c, f.effects_line, f.effects_col, "E3017", "`uses " + u + "` names a mut parameter; the function could " +
                    "put a function that uses anything in it")
            } else if len(types.effects_of(c.table, params[pi])) > 0 {
                report(mut c, f.effects_line, f.effects_col, "E3018", "`uses " + u + "` lets '" + u + "' use anything, but its " +
                    "type says what it uses; write one or the other")
            } else {
                // Polymorphic in what f uses: `@f` stands for the effects of
                // the function each call passes, which the caller uses.
                let ft = types.get(c.table, params[pi])
                params[pi] = types.func_with(mut c.table, ft.args, ft.result, [types.effect_var(u)])
            }
            for j in 0..i {
                if f.effects[j] == u {
                    report(mut c, f.effects_line, f.effects_col, "E3019", "effect '" + u + "' is listed twice")
                }
            }
        }
        push(mut c.fns, FnInfo {
            decl: f, module: m, params: params, mutable: mutable, result: result, param_locals: [],
            type_params: type_params, is_test: false, result_local: -1,
        })
        let id = len(c.fns) - 1
        validate_foreign(mut c, id)
        if f.public {
            for p in f.params {
                exposes(mut c, p.ty, "function '" + f.name + "'")
            }
            match f.result {
                Some(t) => exposes(mut c, t, "function '" + f.name + "'")
                None => {}
            }
        }
        if is_prelude(f.name) && c.modules[m].name == "" && !c.library {
            report(mut c, f.line, f.col, "E3020", "'" + f.name + "' is a built-in function and cannot be redefined")
        } else if maps.has(module_fns(c), f.name) {
            let first = c.fns[module_fns(c)[f.name]].decl
            report(mut c, f.line, f.col, "E3021", "function '" + f.name + "' is already defined at " +
                strings.from_int(first.line) + ":" + strings.from_int(first.col))
        } else if !taken(mut c, f.name, f.line, f.col, "function") {
            c.modules[m].fns[f.name] = id
        }
        // The body is checked even when the name is rejected.
    }
    // A test is a function with no parameters and no result, which nothing
    // can call: its name is a string.
    let tests = c.modules[m].program.tests
    for i in 0..len(tests) {
        let t = tests[i]
        for j in 0..i {
            if tests[j].name == t.name {
                report(mut c, t.line, t.col, "E3022", "test " + ast.quote(t.name) + " is already defined at " +
                    strings.from_int(tests[j].line) + ":" + strings.from_int(tests[j].col))
                break
            }
        }
        let f = ast.FnDecl {
            name: "test " + ast.quote(t.name), foreign: "", variadic: false, type_params: [], params: [], result: None, effects: [], effects_line: 0,
            effects_col: 0, requires: [], ensures: [], body: t.body, line: t.line, col: t.col, public: false,
        }
        push(mut c.fns, FnInfo {
            decl: f, module: m, params: [], mutable: [], result: types.NOTHING(), param_locals: [], type_params: [],
            is_test: true, result_local: -1,
        })
    }
}

// The index of the parameter called `name`, or -1.
fn param_named(f: ast.FnDecl, name: Str) -> Int {
    for i in 0..len(f.params) {
        if f.params[i].name == name {
            return i
        }
    }
    return -1
}

// The type a TypeName in the source stands for (ERROR if unknown).
fn resolve_type(c: mut Checker, t: ast.TypeName) -> Int {
    if t.module == "sysio" {
        let module = module_in_type(mut c, t.line, t.col, "sysio")
        if module < 0 { return types.ERROR() }
        if t.name == "Handle" && len(t.args) == 0 { return types.HANDLE() }
        report(mut c, t.line, t.col, "E3220", "unknown systems type; use sysio.Handle")
        return types.ERROR()
    }
    if t.module == "c" {
        let module = module_in_type(mut c, t.line, t.col, "c")
        if module < 0 { return types.ERROR() }
        let id = cffi.type_id_for(t.name, c.target)
        if id < 0 || len(t.args) != 0 { report(mut c, t.line, t.col, "E3202", "unknown or parameterized C type c." + t.name); return types.ERROR() }
        return id
    }
    if t.module == "" {
        completing(mut c, t.name, [])
    }
    if t.name == "[;]" { return types.fixed(mut c.table, resolve_type(mut c, t.args[0]), t.length) }
    if t.name == "[]" {
        let elem = resolve_type(mut c, t.args[0])
        return types.array(mut c.table, elem)
    }
    if t.name == "fn" || t.name == "fn->" {
        let mut params: [Int] = []
        let mut result = types.NOTHING()
        for i in 0..len(t.args) {
            let a = resolve_type(mut c, t.args[i])
            if t.name == "fn->" && i == len(t.args) - 1 {
                result = a
            } else {
                push(mut params, a)
            }
        }
        let mut effects: [Str] = []
        for u in t.effects {
            if types.concrete_effect(u) {
                effects = types.union_effects(effects, [u])
            } else {
                report(mut c, t.line, t.col, "E3023", "unknown effect '" + u + "' in a function type; its effects can be fs, os, unsafe, net and clock. " +
                    "For whatever a parameter f uses, write `uses f` after the signature of the function it belongs to")
            }
        }
        return types.func_with(mut c.table, params, result, effects)
    }
    if t.module == "" {
        match maps.get(c.type_scope, t.name) {
            Some(p) => {
                if len(t.args) > 0 {
                    report(mut c, t.line, t.col, "E3024", "type parameter '" + t.name + "' takes no type arguments")
                }
                return p
            }
            None => {}
        }
    }
    let want = types.generic_arity(t.name)
    if want >= 0 {
        if len(t.args) != want {
            let example = match t.name {
                "Option" => "Option[Int]"
                "Result" => "Result[Int, Str]"
                _ => "Map[Str, Int]"
            }
            report(mut c, t.line, t.col, "E3025", t.name + " needs " + plural(want, "type argument") + ", as in " + example)
            return types.ERROR()
        }
        let mut args: [Int] = []
        for a in t.args {
            push(mut args, resolve_type(mut c, a))
        }
        if t.name == "Map" {
            if !c.signatures_done && (types.is_struct(c.table, args[0]) || types.is_enum(c.table, args[0])) {
                let k = t.args[0]
                push(mut c.key_uses, KeyUse { module: c.current, line: k.line, col: k.col, actual: args[0] })
                return types.map(mut c.table, args[0], args[1])
            }
            if !key_type(c, args[0]) && args[0] != types.ERROR() {
                let k = t.args[0]
                report(mut c, k.line, k.col, "E3026", key_failure(c, args[0]))
                return types.ERROR()
            }
            return types.map(mut c.table, args[0], args[1])
        }
        return types.instance(mut c.table, t.name, args)
    }
    let mut known = -1
    if t.module != "" {
        let module = module_in_type(mut c, t.line, t.col, t.module)
        if module < 0 {
            return types.ERROR()
        }
        known = module_type(mut c, t.line, t.col, module, t.name)
        if known < 0 {
            return types.ERROR()
        }
    } else {
        known = types.primitive(t.name)
        if known < 0 {
            match maps.get(module_types(c), t.name) {
                Some(id) => known = id
                None => {}
            }
        }
    }
    if known < 0 {
        report(mut c, t.line, t.col, "E3027", "unknown type '" + t.name + "'")
        return types.ERROR()
    }
    if types.is_interface(c.table, known) {
        report(mut c, t.line, t.col, "E3190", "interface '" + t.name + "' is a bound, not a value type; use a type parameter")
        return types.ERROR()
    }
    if types.is_generic(c.table, known) {
        return generic_type(mut c, t, known)
    }
    if len(t.args) > 0 {
        report(mut c, t.line, t.col, "E3028", "'" + show(c, known) + "' takes no type arguments")
    }
    return known
}

// `Box[Int]`: a generic struct or enum with its type arguments.
fn generic_type(c: mut Checker, t: ast.TypeName, decl: Int) -> Int {
    let params = types.get(c.table, decl).params
    let name = show(c, decl)
    if len(t.args) != len(params) {
        report(mut c, t.line, t.col, "E3029", "'" + name + "' needs " + plural(len(params), "type argument") + ", as in " + name +
            "[" + example_args(len(params)) + "]")
        return types.ERROR()
    }
    let mut args: [Int] = []
    for a in t.args {
        push(mut args, resolve_type(mut c, a))
    }
    if decl == c.defining {
        // Box[T] may hold a Box[T], but not a Box[[T]]: each use would need
        // a bigger type, without end.
        for i in 0..len(args) {
            if args[i] != params[i] && args[i] != types.ERROR() {
                report(mut c, t.line, t.col, "E3030", "'" + name + "' can only contain itself with its own type parameters, as in " +
                    name + "[" + param_names(c, params) + "]")
                return types.ERROR()
            }
        }
    }
    for i in 0..len(args) {
        check_bounds(mut c, t.line, t.col, "'" + name + "'", params[i], args[i])
    }
    return types.instantiate(mut c.table, decl, args)
}

fn example_args(n: Int) -> Str {
    let mut out = "Int"
    for _ in 1..n {
        out = out + ", Int"
    }
    return out
}

fn param_names(c: Checker, params: [Int]) -> Str {
    let mut b = strings.builder()
    for i in 0..len(params) {
        if i > 0 {
            strings.add(mut b, ", ")
        }
        strings.add(mut b, types.get(c.table, params[i]).name)
    }
    return strings.build(b)
}

// Whether `t` can be a map key.
fn key_type(c: Checker, t: Int) -> Bool {
    return satisfies_depth(c, t, "Key", 0)
}

// Whether `t` meets bound `b`.
fn satisfies(c: Checker, t: Int, b: Str) -> Bool {
    return satisfies_depth(c, t, b, 0)
}

// Report each bound of type parameter `p` that `t`, given for it, does not meet.
fn check_bounds(c: mut Checker, line: Int, col: Int, owner: Str, p: Int, t: Int) {
    if !c.signatures_done {
        push(mut c.bound_uses, BoundUse { module: c.current, line: line, col: col, owner: owner, param: p, actual: t })
        return
    }
    let pname = types.get(c.table, p).name
    for b in types.get(c.table, p).bounds {
        if satisfies(c, t, b) {
            continue
        }
        report(mut c, line, col, "E3031", owner + " needs " + pname + ": " + b + ", but here " + pname + " is " + show(c, t) + "; " + failed_obligation(c, t, b, 0))
    }
}

fn new_local(c: mut Checker, name: Str, ty: Int, kind: Str, line: Int, col: Int) -> Int {
    push(mut c.locals, Local { name: name, ty: ty, kind: kind, line: line, col: col })
    return len(c.locals) - 1
}

fn function(c: mut Checker, id: Int) {
    if c.fns[id].decl.foreign != "" { return }
    c.unsafe_depth = 0
    c.current_fn = id
    c.undefined = []
    let f = c.fns[id].decl
    // Parameters and the body's top-level `let`s share one scope.
    let mut scope: Map[Str, Int] = [:]
    let mut locals: [Int] = []
    for i in 0..len(f.params) {
        let p = f.params[i]
        if maps.has(scope, p.name) {
            report(mut c, p.line, p.col, "E3032", "parameter '" + p.name + "' is already declared")
        }
        check_name_allowed(mut c, p.name, p.line, p.col)
        let mut kind = "parameter"
        if p.mutable {
            kind = "mut parameter"
        }
        let local = new_local(mut c, p.name, c.fns[id].params[i], kind, p.line, p.col)
        scope[p.name] = local
        push(mut locals, local)
    }
    c.fns[id].param_locals = locals
    c.scopes = [scope]
    c.type_scope = scope_of(c, c.fns[id].type_params)
    c.effects_used = [:]
    c.effects_reported = [:]
    for r in f.requires {
        check_expr(mut c, r, types.BOOL(), msg("a requires clause must be Bool, found ", ""))
    }
    for s in f.body.stmts {
        stmt(mut c, s)
    }
    if len(f.ensures) > 0 {
        // The ensures clauses see the parameters, and `result`.
        let mut after: Map[Str, Int] = [:]
        if c.fns[id].result != types.NOTHING() {
            if maps.has(scope, "result") {
                report(mut c, f.line, f.col, "E3033", "'" + f.name + "' has a parameter called 'result', which its ensures " +
                    "clauses cannot tell from the value it returns; rename the parameter")
            }
            let r = new_local(mut c, "result", c.fns[id].result, "result", f.line, f.col)
            after["result"] = r
            c.fns[id].result_local = r
        }
        c.scopes = [scope, after]
        for e in f.ensures {
            check_expr(mut c, e, types.BOOL(), msg("an ensures clause must be Bool, found ", ""))
        }
    }
    c.type_scope = [:]
    for u in f.effects {
        let known = types.concrete_effect(u)
        let mut message = ""
        if known && !maps.has(c.effects_used, u) && !c.fns[id].is_test && !is_main(c, id) {
            message = "'" + f.name + "' says `uses " + u + "` but uses nothing of it"
        }
        let pi = param_named(f, u)
        let var = types.effect_var(u)
        if !known && pi >= 0 && types.effects_within([var], types.effects_of(c.table, c.fns[id].params[pi])) &&
            !maps.has(c.effects_used, var) {
            message = "'" + f.name + "' says `uses " + u + "` but never calls " + u + ", nor passes it on"
        }
        if message != "" {
            let w = errors.CompileError { code: "E7008", fix: repairs.validated(c.modules[c.current].source, repairs.unused_effect(c.modules[c.current].source, c.modules[c.current].path, f, u)),
                path: c.modules[c.current].path, line: f.effects_line, col: f.effects_col, message: message, warning: true,
            }
            errors.add(mut c.warnings, w)
        }
    }
    match f.result {
        Some(_) => {
            if !terminates_block(c, f.body) {
                report(mut c, f.body.end_line, f.body.end_col, "E3034", "missing return: '" + f.name + "' returns " +
                    show(c, c.fns[id].result) + ", but the end of its body can be reached")
            }
        }
        None => {}
    }
}

fn is_main(c: Checker, id: Int) -> Bool {
    return c.fns[id].decl.name == "main" && c.modules[c.fns[id].module].name == ""
}

// ---- Effects ----
//
// A function that touches the world says how: `uses fs` for the files
// module, `uses os` for os.args, os.exit, os.env, os.run, os.output,
// os.read_line and os.read. Printing is not an effect, and neither is os.write, which prints. A function must declare what it does itself and what the
// functions it calls declare; main and tests may do anything.

// The effect of a built-in function, or "".
fn effect_of(name: Str) -> Str {
    if len(name) > 6 && name[0..6] == "files." {
        return "fs"
    }
    if name == "os.args" || name == "os.exit" || name == "os.env" || name == "os.run" || name == "os.read_line" ||
        name == "os.read" || name == "os.output" || name == "os.executable" {
        return "os"
    }
    return ""
}

// The function being checked uses `effect`, through the call at `e` to
// `through`. Inside a closure the closure uses it instead: its type says
// so, and code that calls it uses it then (M15).
fn use_effect(c: mut Checker, e: ast.Expr, effect: Str, through: Str) {
    if effect == "unsafe" && c.unsafe_depth > 0 { return }
    let var = types.is_effect_var(effect)
    if !types.concrete_effect(effect) && !var {
        return  // none, or an unknown one, already reported where it is declared
    }
    let n = len(c.in_closures)
    if n > 0 {
        c.in_closures[n - 1].effects = types.union_effects(c.in_closures[n - 1].effects, [effect])
        return
    }
    c.effects_used[effect] = true
    let f = c.fns[c.current_fn]
    if (effect != "unsafe" && (f.is_test || is_main(c, c.current_fn))) || maps.has(c.effects_reported, effect) {
        return
    }
    let mut name = effect
    if var {
        name = effect[1..len(effect)]
    }
    for u in f.decl.effects {
        if u == name {
            return
        }
    }
    c.effects_reported[effect] = true
    if var {
        report_at(mut c, e, "E3035", "'" + f.decl.name + "' uses whatever its parameter " + name + " uses, through " + through +
            ", but does not say so; add `uses " + name + "` after its signature")
        last_fix(mut c, repairs.effect(c.modules[c.current].source, c.modules[c.current].path, f.decl, name))
        return
    }
    report_at(mut c, e, "E3036", "'" + f.decl.name + "' uses " + effect + ", through " + through + ", but does not say so; add `uses " +
        effect + "` after its signature")
    last_fix(mut c, repairs.effect(c.modules[c.current].source, c.modules[c.current].path, f.decl, name))
}

// Whether a value of type `found` can go where `want` is wanted: the same
// type, or a function type that uses no more than `want` says. A type with
// an effect variable (`uses f`) takes a function that uses anything: each
// call says what (M15).
fn fits(c: Checker, found: Int, want: Int) -> Bool {
    if found == want {
        return true
    }
    if found < 0 || want < 0 || !types.is_func(c.table, found) || !types.is_func(c.table, want) ||
        types.plain(c.table, found) != types.plain(c.table, want) {
        return false
    }
    let w = types.effects_of(c.table, want)
    for u in w {
        if types.is_effect_var(u) {
            return true
        }
    }
    return types.effects_within(types.effects_of(c.table, found), w)
}

// After "must be X, found Y" where Y uses more than X allows.
fn effect_hint(c: Checker, found: Int, want: Int) -> Str {
    if found < 0 || want < 0 || !types.is_func(c.table, found) || !types.is_func(c.table, want) ||
        types.plain(c.table, found) != types.plain(c.table, want) {
        return ""
    }
    return "; a function that uses fs, os, net, clock or unsafe goes only where its type says so, or to a parameter its function " +
        "names in `uses`"
}

// The function being checked uses what a call to a function of type `t`
// uses.
fn use_effects_of(c: mut Checker, e: ast.Expr, t: Int, through: Str) {
    for u in types.effects_of(c.table, t) {
        use_effect(mut c, e, u, through)
    }
}

// A call to `f` uses what f says it uses, with `uses p` standing for what
// the function passed as p uses.
fn use_call_effects(c: mut Checker, e: ast.Expr, f: FnInfo, args: [ast.Expr], name: Str) {
    for u in f.decl.effects {
        let pi = param_named(f.decl, u)
        if types.concrete_effect(u) {
            use_effect(mut c, e, u, "'" + name + "'")
        } else if pi >= 0 && pi < len(args) && pi < len(f.params) &&
            types.effects_within([types.effect_var(u)], types.effects_of(c.table, f.params[pi])) {
            use_effects_of(mut c, e, c.ty[args[pi].id], "the function passed to '" + name + "'")
        }
    }
}

// ---- With ----

// `with files = m, args = xs, env = m, stdin = s, stdout = mut out { ... }`: in a test,
// the code the block runs sees these instead of the real ones.
fn with_stmt(c: mut Checker, s: ast.Stmt, items: [ast.WithItem], body: ast.Block) {
    if len(c.in_closures) > 0 {
        report(mut c, s.line, s.col, "E3037", "'with' cannot be used inside a function value; put the function value inside the " +
            "'with' instead")
    } else if !c.fns[c.current_fn].is_test {
        report(mut c, s.line, s.col, "E3038", "'with' only works in tests, where it fakes files, args, env, stdin, stdout, clock, net or processes for the code " +
            "the test calls")
    }
    let text_map = types.map(mut c.table, types.STR(), types.STR())
    let words = types.array(mut c.table, types.STR())
    let mut seen: [Str] = []
    for w in items {
        for name in seen {
            if name == w.name {
                report(mut c, w.line, w.col, "E3039", "'" + w.name + "' is faked twice in this 'with'")
            }
        }
        push(mut seen, w.name)
        if w.name == "clock" {
            check_expr(mut c, w.value, types.array(mut c.table, types.INT()), msg("clock fake needs [wall_ns, monotonic_ns], found ", ""))
        } else if w.name == "net" || w.name == "processes" {
            check_expr(mut c, w.value, types.array(mut c.table, words), msg("network/process fakes need a list of reply/failure fixtures, found ", ""))
        } else if w.name == "files" {
            check_expr(mut c, w.value, text_map, msg("'with files' needs a Map[Str, Str] from paths to contents, found ", ""))
        } else if w.name == "env" {
            check_expr(mut c, w.value, text_map, msg("'with env' needs a Map[Str, Str] from names to values, found ", ""))
        } else if w.name == "args" {
            check_expr(mut c, w.value, words, msg("'with args' needs a [Str], found ", ""))
        } else if w.name == "stdin" {
            check_expr(mut c, w.value, types.STR(), msg("'with stdin' needs the Str to read, found ", ""))
        } else if w.name == "stdout" {
            let mut is_place = false
            match w.value.kind {
                ast.ExprKind.MutArg(_) => is_place = true
                _ => {}
            }
            if !is_place {
                report_at(mut c, w.value, "E3040", "'with stdout' collects what is printed into a strings.Builder variable, " +
                    "written `stdout = mut out`")
                infer(mut c, w.value)
                continue
            }
            let t = mut_argument(mut c, w.value, types.BUILDER(), "'with stdout'")
            if t != types.BUILDER() && t != types.ERROR() {
                report_at(mut c, w.value, "E3041", "'with stdout' needs a strings.Builder to collect what is printed, found " + show(c, t))
            }
        } else {
            report(mut c, w.line, w.col, "E3042", "'with' cannot fake '" + w.name + "'; it fakes files, args, env, stdin, stdout, clock, net and processes")
            infer(mut c, w.value)
        }
    }
    block(mut c, body)
}

// `None`, `Some`, `Ok` and `Err` cannot name variables.
fn check_name_allowed(c: mut Checker, name: Str, line: Int, col: Int) {
    if is_builtin_variant(name) {
        report(mut c, line, col, "E3043", "'" + name + "' is a variant of " + variant_family(name) + " and cannot be used as a name")
    }
}

// ---- Modules ----

// The module `e` names, if it is the name of an imported module and no
// variable shadows it; -1 otherwise.
fn module_named(c: Checker, e: ast.Expr) -> Int {
    match e.kind {
        ast.ExprKind.Name(name) => {
            if lookup_local(c, name) >= 0 {
                return -1
            }
            match maps.get(c.modules[c.current].imports, name) {
                Some(m) => return m
                None => return -1
            }
        }
        _ => return -1
    }
}

// The module before the `.` in a type or struct literal: `lexer.Token`.
fn module_in_type(c: mut Checker, line: Int, col: Int, name: Str) -> Int {
    match maps.get(c.modules[c.current].imports, name) {
        Some(m) => return m
        None => {}
    }
    if maps.has(module_types(c), name) {
        report(mut c, line, col, "E3044", "'" + name + "' is a type, not a module")
    } else {
        report(mut c, line, col, "E3045", "unknown module '" + name + "'; is `import " + name + "` missing?")
        last_fix(mut c, repairs.import_module(c.modules[c.current].source, c.modules[c.current].path, name))
    }
    return -1
}

fn has_std(m: modules.Module, name: Str) -> Bool {
    for f in m.std {
        if f == name {
            return true
        }
    }
    return false
}

// The pub type `module.name`, or -1 once the reason is reported.
fn module_type(c: mut Checker, line: Int, col: Int, module: Int, name: Str) -> Int {
    let m = c.modules[module]
    match maps.get(m.types, name) {
        None => {
            if maps.has(m.fns, name) || has_std(m, name) {
                report(mut c, line, col, "E3046", "'" + m.name + "." + name + "' is a function, not a type")
            } else {
                report(mut c, line, col, "E3047", "module '" + m.name + "' has no type '" + name + "'")
            }
            return -1
        }
        Some(t) => {
            if !types.get(c.table, t).public {
                private(mut c, line, col, module, "type", name)
                return -1
            }
            return t
        }
    }
}

// The pub function `module.name`, or a built-in module's function; NoRef
// once the reason is reported.
fn module_fn(c: mut Checker, line: Int, col: Int, module: Int, name: Str) -> Ref {
    let m = c.modules[module]
    if has_std(m, name) {
        return Ref.Builtin(m.name + "." + name)
    }
    match maps.get(m.fns, name) {
        None => {
            if maps.has(m.types, name) {
                report(mut c, line, col, "E3048", "'" + m.name + "." + name + "' is a type, not a function")
            } else {
                report(mut c, line, col, "E3049", "module '" + m.name + "' has no function '" + name + "'")
            }
            return Ref.NoRef
        }
        Some(f) => {
            if !c.fns[f].decl.public {
                private(mut c, line, col, module, "function", name)
                return Ref.NoRef
            }
            return Ref.Function(f)
        }
    }
}

fn private(c: mut Checker, line: Int, col: Int, module: Int, what: Str, name: Str) {
    let m = c.modules[module]
    report(mut c, line, col, "E3050", what + " '" + name + "' is private to module '" + m.name +
        "'; declare it with 'pub' in " + m.path + " to use it here")
}

// `; it is maps.get` for a name that lives in a built-in module.
fn std_hint(c: Checker, name: Str) -> Str {
    for module in modules.builtin_modules() {
        let fns = modules.builtin_functions(module)
        for f in fns {
            if f == name {
                let hint = "; it is " + module + "." + name
                if maps.has(c.modules[c.current].imports, module) {
                    return hint
                }
                return hint + ", after `import " + module + "`"
            }
        }
    }
    return ""
}

// The name being completed is `name`: note what is in scope, the first time.
fn completing(c: mut Checker, name: Str, object: [ast.Expr]) {
    if name != c.completion.name || c.completion.name == "" || c.completion.module >= 0 {
        return
    }
    c.completion.module = c.current
    c.completion.object = object
    let mut seen: Map[Str, Bool] = [:]
    let mut i = len(c.scopes) - 1
    for i >= 0 {
        for n in maps.keys(c.scopes[i]) {
            if !maps.has(seen, n) {
                seen[n] = true
                push(mut c.completion.visible, c.scopes[i][n])
            }
        }
        i = i - 1
    }
    for n in maps.keys(c.type_scope) {
        push(mut c.completion.type_params, n)
    }
}

// ---- Statements ----

fn push_scope(c: mut Checker, scope: Map[Str, Int]) {
    push(mut c.scopes, scope)
}

fn pop_scope(c: mut Checker) {
    c.scopes = c.scopes[0..len(c.scopes) - 1]
}

fn block(c: mut Checker, b: ast.Block) {
    push_scope(mut c, [:])
    for s in b.stmts {
        stmt(mut c, s)
    }
    pop_scope(mut c)
}

fn stmt(c: mut Checker, s: ast.Stmt) {
    match s.kind {
        ast.StmtKind.Block(b) => block(mut c, b)
        ast.StmtKind.ExprStmt(e) => {
            let mut call = e
            match e.kind {
                ast.ExprKind.Try(inner) => call = inner
                _ => {}
            }
            let mut is_call = false
            match call.kind {
                ast.ExprKind.Call(_, _) => is_call = true
                _ => {}
            }
            if !is_call {
                // `1 + 2` on a line by itself computes a value and throws it away.
                report_at(mut c, e, "E3051", "this value is not used; only a call can stand alone as a statement")
            }
            let result = infer(mut c, e)
            // Inspect the checked type: direct, indirect, generic and method
            // calls obey the same rule. Try propagation is an acknowledgement.
            match e.kind {
                ast.ExprKind.Call(_, _) => {
                    if types.is_builtin_enum(c.table, result) && types.get(c.table, result).name == "Result" {
                        warn_at(mut c, e, "E7009", "discarded Result may contain an error; return, propagate, match or bind it; use let _ = ... for an intentional discard")
                    }
                }
                _ => {}
            }
        }
        ast.StmtKind.Let(name, mutable, annotation, value) => let_stmt(mut c, s, name, mutable, annotation, value)
        ast.StmtKind.Assign(target, value) => assign(mut c, target, value)
        ast.StmtKind.If(cond, then, otherwise) => {
            condition(mut c, cond, "if")
            block(mut c, then)
            match otherwise {
                ast.Else.ElseIf(s2) => stmt(mut c, s2)
                ast.Else.ElseBlock(b) => block(mut c, b)
                ast.Else.NoElse => {}
            }
        }
        ast.StmtKind.For(cond, body) => {
            c.breaks[s.id] = false
            match cond {
                Some(e) => condition(mut c, e, "for")
                None => {}
            }
            loop_body(mut c, s.id, true, body)
        }
        ast.StmtKind.ForRange(name, start, end, body) => {
            for bound in [start, end] {
                check_expr(mut c, bound, types.INT(), msg("a range must be made of Int values, found ", ""))
            }
            check_name_allowed(mut c, name, s.line, s.col)
            let local = new_local(mut c, name, types.INT(), "loop variable", s.line, s.col)
            c.refs[s.id] = Ref.Local(local)
            // The loop variable gets a scope of its own around the body.
            let mut scope: Map[Str, Int] = [:]
            scope[name] = local
            push_scope(mut c, scope)
            loop_body(mut c, s.id, false, body)
            pop_scope(mut c)
        }
        ast.StmtKind.ForEach(name, iterable, body) => {
            let t = value(mut c, iterable)
            let mut elem = types.ERROR()
            if types.sequence(c.table, t) {
                elem = types.get(c.table, t).args[0]
            } else if t == types.STR() {
                elem = types.BYTE()
            } else if types.is_map(c.table, t) {
                report_at(mut c, iterable, "E3052", "a map cannot be looped over directly; loop over maps.keys(m) instead")
            } else if t != types.ERROR() {
                report_at(mut c, iterable, "E3053", "cannot loop over " + show(c, t) +
                    "; 'for ... in' needs an array, a Str or a range")
            }
            check_name_allowed(mut c, name, s.line, s.col)
            let local = new_local(mut c, name, elem, "loop variable", s.line, s.col)
            c.refs[s.id] = Ref.Local(local)
            let mut scope: Map[Str, Int] = [:]
            scope[name] = local
            push_scope(mut c, scope)
            loop_body(mut c, s.id, false, body)
            pop_scope(mut c)
        }
        ast.StmtKind.Break => jump(mut c, s, "break")
        ast.StmtKind.Continue => jump(mut c, s, "continue")
        ast.StmtKind.Return(v) => return_stmt(mut c, s, v)
        ast.StmtKind.MatchStmt(scrutinee, arms) => match_arms(mut c, scrutinee, arms, s.line, s.col, MatchBody.Statements)
        ast.StmtKind.Unsafe(body) => {
            c.unsafe_depth = c.unsafe_depth + 1
            block(mut c, body)
            c.unsafe_depth = c.unsafe_depth - 1
        }
        ast.StmtKind.With(items, body) => with_stmt(mut c, s, items, body)
    }
}

fn jump(c: mut Checker, s: ast.Stmt, word: Str) {
    let n = len(c.loops)
    if n == 0 {
        report(mut c, s.line, s.col, "E3054", "'" + word + "' is only allowed inside a loop")
    } else if word == "break" && c.loops[n - 1].is_for {
        c.breaks[c.loops[n - 1].id] = true
    }
}

fn let_stmt(c: mut Checker, s: ast.Stmt, name: Str, mutable: Bool, annotation: Option[ast.TypeName],
    v: ast.Expr) {
    // The value is checked before the name exists, so in `let x = x + 1`
    // the `x` on the right is an outer `x`.
    let mut ty = types.ERROR()
    match annotation {
        Some(t) => {
            ty = resolve_type(mut c, t)
            check_expr(mut c, v, ty, msg("'" + name + "' is declared as " + show(c, ty) + ", but its value is ", ""))
        }
        None => ty = value(mut c, v)
    }
    check_name_allowed(mut c, name, s.line, s.col)
    let n = len(c.scopes) - 1
    // Repeated immutable acknowledgements use the existing discard spelling.
    // Keep ordinary local ownership/cleanup; only exempt this name check.
    if name != "_" || mutable {
    match maps.get(c.scopes[n], name) {
        Some(first) => {
            let l = c.locals[first]
            report(mut c, s.line, s.col, "E3055", "'" + name + "' is already declared in this block, at " +
                strings.from_int(l.line) + ":" + strings.from_int(l.col))
        }
        None => {}
    }
    }
    let mut kind = "let"
    if mutable {
        kind = "let mut"
    }
    let local = new_local(mut c, name, ty, kind, s.line, s.col)
    c.scopes[n][name] = local
    c.refs[s.id] = Ref.Local(local)
}

fn loop_body(c: mut Checker, id: Int, is_for: Bool, body: ast.Block) {
    push(mut c.loops, Loop { id: id, is_for: is_for })
    block(mut c, body)
    c.loops = c.loops[0..len(c.loops) - 1]
}

fn condition(c: mut Checker, cond: ast.Expr, word: Str) {
    check_expr(mut c, cond, types.BOOL(), msg("the condition of '" + word + "' must be Bool, found ", ""))
}

fn assign(c: mut Checker, target: ast.Expr, v: ast.Expr) {
    match target.kind {
        ast.ExprKind.Name(name) => {
            if maps.has(module_fns(c), name) && lookup_local(c, name) < 0 {
                report_at(mut c, target, "E3056", "cannot assign to function '" + name + "'")
                value(mut c, v)
                return
            }
        }
        _ => {}
    }
    let ty = place(mut c, target, "assign to")
    check_expr(mut c, v, ty, msg("cannot assign ", " to " + describe_target(target) + ", which is " + show(c, ty)))
}

// The expression a field access or index is applied to, if `e` is one.
fn inner_object(e: ast.Expr) -> Option[ast.Expr] {
    return match e.kind {
        ast.ExprKind.Field(obj, _) => Some(obj)
        ast.ExprKind.Index(obj, _) => Some(obj)
        _ => None
    }
}

fn is_field(e: ast.Expr) -> Bool {
    return match e.kind {
        ast.ExprKind.Field(_, _) => true
        _ => false
    }
}

fn is_index(e: ast.Expr) -> Bool {
    return match e.kind {
        ast.ExprKind.Index(_, _) => true
        _ => false
    }
}

// The variable at the start of a path like `p.f[i].g`.
fn root_of(e: ast.Expr) -> ast.Expr {
    let mut root = e
    for {
        match inner_object(root) {
            Some(obj) => root = obj
            None => return root
        }
    }
}

// Check a place about to be changed: a `let mut` variable or mut
// parameter, or a field or element of one. Returns its type.
fn place(c: mut Checker, target: ast.Expr, verb: Str) -> Int {
    let root = root_of(target)
    let mut is_name = false
    match root.kind {
        ast.ExprKind.Name(_) => is_name = true
        _ => {}
    }
    if !is_name {
        report_at(mut c, target, "E3057", "only a variable, or a field or element of one, can be changed")
        infer(mut c, target)
        return types.ERROR()
    }
    let ty = infer(mut c, target)
    if is_field(target) {
        match c.refs[target.id] {
            Ref.Variant(_, _) => {
                report_at(mut c, target, "E3058", "a variant cannot be assigned to")
                return types.ERROR()
            }
            _ => {}
        }
    }
    let mut node = target
    for {
        match inner_object(node) {
            Some(obj) => {
                if is_index(node) && c.ty[obj.id] == types.STR() {
                    report_at(mut c, node, "E3059", "a Str cannot be changed; build a new one instead, for example with +")
                    return types.ERROR()
                }
                node = obj
            }
            None => break
        }
    }
    match c.refs[root.id] {
        Ref.Local(id) => {
            let l = c.locals[id]
            if captured(c, id) {
                report_at(mut c, root, "E3060", "cannot " + verb + " '" + l.name + "' inside a function value: it has its own copy " +
                    "of '" + l.name + "', made when it was created, and changes to the copy would be lost")
                return ty
            }
            let mut part = ""
            if is_field(target) {
                part = "a field of "
            } else if is_index(target) {
                part = "an element of "
            }
            if l.kind == "let" {
                report_at(mut c, root, "E3061", "cannot " + verb + " " + part + "'" + l.name +
                    "', which was declared with 'let'; use 'let mut' to allow changes")
                last_fix(mut c, repairs.mutable_local(c.modules[c.current].source, c.modules[c.current].path, l.line, l.col))
            } else if l.kind == "parameter" {
                report_at(mut c, root, "E3062", "cannot " + verb + " " + part + "parameter '" + l.name + "'; declare it as `" +
                    l.name + ": mut " + show(c, l.ty) + "` to change the caller's value, or copy it into a `let mut`")
            } else if l.kind != "let mut" && l.kind != "mut parameter" {
                report_at(mut c, root, "E3063", "cannot " + verb + " " + part + l.kind + " '" + l.name + "'")
            }
        }
        _ => {}
    }
    return ty
}

fn return_stmt(c: mut Checker, s: ast.Stmt, v: Option[ast.Expr]) {
    let n = len(c.in_closures)
    if n > 0 {
        closure_return(mut c, s, v)
        return
    }
    let f = c.fns[c.current_fn]
    let mut has_result = false
    match f.decl.result {
        Some(_) => has_result = true
        None => {}
    }
    match v {
        None => {
            if has_result {
                report(mut c, s.line, s.col, "E3064", "'" + f.decl.name + "' returns " + show(c, f.result) +
                    ", so 'return' needs a value")
            }
        }
        Some(e) => {
            if !has_result {
                report_at(mut c, e, "E3065", "'" + f.decl.name + "' does not return a value, so 'return' cannot have one")
                infer(mut c, e)
            } else {
                check_expr(mut c, e, f.result, msg("'" + f.decl.name + "' returns " + show(c, f.result) + ", but this is ", ""))
            }
        }
    }
}

// ---- Match ----

// What a match does with its arms' bodies: run them as statements, check
// each against a wanted type, or let the first arm decide the type.
type MatchBody = enum {
    Statements
    Check(Int, Msg)
    Infer
}

fn arm_value(a: ast.Arm) -> ast.Expr {
    match a.body {
        ast.ArmBody.Value(e) => return e
        ast.ArmBody.Do(_) => {}
    }
    return ast.Expr { kind: ast.ExprKind.UnitLit, line: 0, col: 0, id: 0 }  // not reached
}

// Check a match: its patterns, each arm's body, and that the arms cover
// every value without a useless one. Returns the type of a match
// expression whose first arm decides (Infer).
fn match_arms(c: mut Checker, scrutinee: ast.Expr, arms: [ast.Arm], line: Int, col: Int, body: MatchBody) -> Int {
    let t = value(mut c, scrutinee)
    let mut patterns_ok = t != types.ERROR()
    let mut first = -3  // no arm seen yet
    for a in arms {
        let mut bindings: Map[Str, Int] = [:]
        let ok = pattern(mut c, a.pattern, t, mut bindings)
        patterns_ok = patterns_ok && ok
        push_scope(mut c, bindings)
        match body {
            MatchBody.Statements => {
                match a.body {
                    ast.ArmBody.Do(s) => stmt(mut c, s)
                    ast.ArmBody.Value(e) => infer(mut c, e)
                }
            }
            MatchBody.Check(want, m) => check_expr(mut c, arm_value(a), want, m)
            MatchBody.Infer => {
                if first == -3 {
                    first = value(mut c, arm_value(a))
                } else {
                    check_expr(mut c, arm_value(a), first, msg("this arm is ", ", but the first arm is " + show(c, first)))
                }
            }
        }
        pop_scope(mut c)
    }
    if patterns_ok {
        coverage(mut c, arms, t, line, col)
    }
    if first == -3 {
        return types.ERROR()
    }
    return first
}

fn coverage(c: mut Checker, arms: [ast.Arm], t: Int, line: Int, col: Int) {
    let mut rows: [[match_check.SPat]] = []
    for a in arms {
        let row = [simplify(c, a.pattern)]
        match match_check.useful(c.table, rows, row, [t]) {
            None => report(mut c, a.pattern.line, a.pattern.col, "E3066",
                "this arm can never match: the arms above it cover every value it would")
            Some(_) => {}
        }
        push(mut rows, row)
    }
    match match_check.useful(c.table, rows, [match_check.SPat.Wild], [t]) {
        Some(missing) => {
            let example = match_check.render(c.table, missing[0], t, c.modules[c.current].name)
            if example == "_" {
                report(mut c, line, col, "E3067", "match is not exhaustive: add a '_' arm for the " + show(c, t) +
                    " values not listed")
            } else {
                report(mut c, line, col, "E3068", "match is not exhaustive: " + example + " is not covered")
            }
        }
        None => {}
    }
}

// A pattern as the usefulness algorithm sees it.
fn simplify(c: Checker, p: ast.Pattern) -> match_check.SPat {
    match p.kind {
        ast.PatternKind.Wild => return match_check.SPat.Wild
        ast.PatternKind.Bind(_) => return match_check.SPat.Wild
        ast.PatternKind.Lit(e) => {
            match e.kind {
                ast.ExprKind.IntLit(n) => {
                    let value = integers.ordered(n, c.ty[e.id])
                    return match_check.SPat.Ctor(match_check.Key.Interval(value, value), [])
                }
                ast.ExprKind.FixedIntLit(n, _, _) => {
                    let value = integers.ordered(n, c.ty[e.id])
                    return match_check.SPat.Ctor(match_check.Key.Interval(value, value), [])
                }
                ast.ExprKind.ByteLit(n) => return match_check.SPat.Ctor(match_check.Key.Interval(n, n), [])
                ast.ExprKind.BoolLit(b) => return match_check.SPat.Ctor(match_check.Key.Bool(b), [])
                ast.ExprKind.StrLit(s) => return match_check.SPat.Ctor(match_check.Key.Str(s), [])
                _ => return match_check.SPat.Wild
            }
        }
        ast.PatternKind.Range(lo, hi) => {
            return match_check.SPat.Ctor(match_check.Key.Interval(integers.ordered(literal_value(lo), c.ty[lo.id]), integers.ordered(literal_value(hi), c.ty[hi.id])), [])
        }
        ast.PatternKind.Variant(_, _, _, _, args) => {
            let mut subs: [match_check.SPat] = []
            for a in args {
                push(mut subs, simplify(c, a))
            }
            match c.refs[p.id] {
                Ref.Variant(_, v) => return match_check.SPat.Ctor(match_check.Key.Variant(v), subs)
                _ => return match_check.SPat.Wild
            }
        }
    }
}

fn literal_value(e: ast.Expr) -> Int {
    return match e.kind {
        ast.ExprKind.IntLit(n) => n
        ast.ExprKind.FixedIntLit(n, _, _) => n
        ast.ExprKind.ByteLit(n) => n
        _ => 0
    }
}

// Check that pattern `p` can match a value of type `t`, collecting the
// names it binds. Returns false if an error was reported.
fn pattern(c: mut Checker, p: ast.Pattern, t: Int, bindings: mut Map[Str, Int]) -> Bool {
    match p.kind {
        ast.PatternKind.Wild => return true
        ast.PatternKind.Bind(name) => {
            if maps.has(bindings, name) {
                report(mut c, p.line, p.col, "E3069", "'" + name + "' is bound twice in this pattern")
                return false
            }
            let local = new_local(mut c, name, t, "match binding", p.line, p.col)
            bindings[name] = local
            c.refs[p.id] = Ref.Local(local)
            return true
        }
        ast.PatternKind.Lit(e) => return pattern_literal(mut c, e, t, p)
        ast.PatternKind.Range(lo, hi) => {
            let ok = pattern_literal(mut c, lo, t, p) && pattern_literal(mut c, hi, t, p)
            if ok && !types.is_integer(t) && t != types.ERROR() {
                report(mut c, p.line, p.col, "E3070", "a range pattern matches Int or Byte values, but the value being matched is " +
                    show(c, t))
                return false
            }
            if ok && integers.ordered(literal_value(lo), t) > integers.ordered(literal_value(hi), t) {
                report(mut c, p.line, p.col, "E3071", "this range is empty: " + strings.from_int(literal_value(lo)) +
                    " is greater than " + strings.from_int(literal_value(hi)))
                return false
            }
            return ok
        }
        ast.PatternKind.Variant(_, _, _, _, _) => {
            if variant_pattern(mut c, p, t, mut bindings) {
                return true
            }
            // The names inside a broken pattern are still bound, with type
            // ERROR, so their uses in the arm do not each report an error.
            bind_quietly(mut c, p, mut bindings)
            return false
        }
    }
}

fn variant_pattern(c: mut Checker, p: ast.Pattern, t: Int, bindings: mut Map[Str, Int]) -> Bool {
    let mut module = ""
    let mut enum_name = ""
    let mut variant = ""
    let mut parens = false
    let mut args: [ast.Pattern] = []
    match p.kind {
        ast.PatternKind.Variant(m, e, v, has_parens, xs) => {
            module = m
            enum_name = e
            variant = v
            parens = has_parens
            args = xs
        }
        _ => {}
    }
    let mut written = variant
    if enum_name != "" {
        written = enum_name + "." + variant
    }
    let mut enum = -1
    if enum_name == "" {
        let family = variant_family(variant)
        if !(types.is_builtin_enum(c.table, t) && types.get(c.table, t).name == family) {
            if t != types.ERROR() {
                report(mut c, p.line, p.col, "E3072", "pattern " + written + " matches " + family +
                    " values, but the value being matched is " + show(c, t))
            }
            return false
        }
        enum = t
    } else {
        let mut found = -1
        if module != "" {
            let m = module_in_type(mut c, p.line, p.col, module)
            if m < 0 {
                return false
            }
            found = module_type(mut c, p.line, p.col, m, enum_name)
            if found < 0 {
                return false
            }
            written = module + "." + written
        } else {
            match maps.get(module_types(c), enum_name) {
                Some(id) => found = id
                None => {}
            }
        }
        if found < 0 {
            report(mut c, p.line, p.col, "E3073", "unknown type '" + enum_name + "'")
            return false
        }
        if !types.is_enum(c.table, found) {
            report(mut c, p.line, p.col, "E3074", "'" + show(c, found) + "' is a struct, not an enum; match on its fields instead")
            return false
        }
        let instance_of = types.is_generic(c.table, found) && t >= 0 && types.get(c.table, t).origin == found
        if t != found && !instance_of {
            if t != types.ERROR() {
                report(mut c, p.line, p.col, "E3075", "pattern " + written + " matches " + show(c, found) +
                    " values, but the value being matched is " + show(c, t))
            }
            return false
        }
        enum = t
    }
    let vi = types.variant_index(c.table, enum, variant)
    if vi < 0 {
        report(mut c, p.line, p.col, "E3076", "'" + show(c, enum) + "' has no variant '" + variant + "'")
        return false
    }
    c.refs[p.id] = Ref.Variant(enum, vi)
    let payload = types.get(c.table, enum).variants[vi].payload
    let n = len(payload)
    if !parens {
        if n > 0 {
            let mut blanks = "_"
            for _ in 1..n {
                blanks = blanks + ", _"
            }
            let mut them = "them"
            if n == 1 {
                them = "it"
            }
            report(mut c, p.line, p.col, "E3077", written + " carries " + plural(n, "value") + "; write " + written + "(" +
                blanks + ") to ignore " + them)
            return false
        }
        return true
    }
    if n == 0 {
        report(mut c, p.line, p.col, "E3078", written + " carries no values; write it without parentheses")
        return false
    }
    if len(args) != n {
        report(mut c, p.line, p.col, "E3079", written + " carries " + plural(n, "value") + ", but this pattern has " +
            strings.from_int(len(args)))
        return false
    }
    let mut ok = true
    for i in 0..n {
        let sub_ok = pattern(mut c, args[i], payload[i], mut bindings)
        ok = ok && sub_ok
    }
    return ok
}

// A literal in a pattern; an Int literal matching a Byte is a Byte.
fn pattern_literal(c: mut Checker, lit: ast.Expr, t: Int, p: ast.Pattern) -> Bool {
    if types.is_integer(t) {
        match lit.kind {
            ast.ExprKind.IntLit(n) => {
                if !integers.fits(n, t, n < 0) {
                    if t == types.BYTE() { report(mut c, p.line, p.col, "E3080", strings.from_int(n) + " does not fit in a Byte (0 to 255)") } else { report(mut c, p.line, p.col, "E3182", "integer pattern does not fit in " + show(c, t)) }
                    return false
                }
                set_ty(mut c, lit, t)
                return true
            }
            ast.ExprKind.FixedIntLit(n, name, neg) => {
                if name != "" && integers.type_id(name) != t {
                    report(mut c, p.line, p.col, "E3081", "this pattern is " + name + ", but the value being matched is " + show(c, t))
                    return false
                }
                if !integers.fits(n, t, neg) {
                    report(mut c, p.line, p.col, "E3182", "integer pattern does not fit in " + show(c, t))
                    return false
                }
                set_ty(mut c, lit, t)
                return true
            }
            _ => {}
        }
    }
    let lit_t = infer(mut c, lit)
    if t != types.ERROR() && lit_t != t {
        report(mut c, p.line, p.col, "E3081", "this pattern is " + show(c, lit_t) + ", but the value being matched is " + show(c, t))
        return false
    }
    return true
}

// Bind every name in `p` that is not bound yet, with type ERROR.
fn bind_quietly(c: mut Checker, p: ast.Pattern, bindings: mut Map[Str, Int]) {
    match p.kind {
        ast.PatternKind.Bind(name) => {
            if !maps.has(bindings, name) {
                let local = new_local(mut c, name, types.ERROR(), "match binding", p.line, p.col)
                bindings[name] = local
                c.refs[p.id] = Ref.Local(local)
            }
        }
        ast.PatternKind.Variant(_, _, _, _, args) => {
            for sub in args {
                bind_quietly(mut c, sub, mut bindings)
            }
        }
        _ => {}
    }
}

// ---- Expressions ----

fn lookup_local(c: Checker, name: Str) -> Int {
    let mut i = len(c.scopes) - 1
    for i >= 0 {
        match maps.get(c.scopes[i], name) {
            Some(id) => return id
            None => {}
        }
        i = i - 1
    }
    return -1
}

fn was_undefined(c: Checker, name: Str) -> Bool {
    for n in c.undefined {
        if n == name {
            return true
        }
    }
    return false
}

// What a name used as a value refers to; NoRef once the error is reported.
fn resolve(c: mut Checker, e: ast.Expr, name: Str) -> Ref {
    completing(mut c, name, [])
    let local = lookup_local(c, name)
    if local >= 0 {
        return Ref.Local(local)
    }
    match maps.get(module_fns(c), name) {
        Some(f) => return Ref.Function(f)
        None => {}
    }
    if maps.has(c.modules[c.current].imports, name) {
        report_at(mut c, e, "E3082", "'" + name + "' is a module, not a value")
    } else if is_prelude(name) {
        report_at(mut c, e, "E3083", "'" + name + "' is a function; call it as " + name + "(...)")
    } else if name == "None" {
        report_at(mut c, e, "E3084", "cannot tell which Option this None is; give it a type, as in `let x: Option[Int] = None`")
    } else if is_builtin_variant(name) {
        report_at(mut c, e, "E3085", name + " carries a value; write " + name + "(...)")
    } else if maps.has(module_types(c), name) {
        report_at(mut c, e, "E3086", "'" + name + "' is a type, not a value")
    } else if !was_undefined(c, name) {
        // Reported at its first use in each function only.
        push(mut c.undefined, name)
        report_at(mut c, e, "E3087", "undefined name '" + name + "'" + std_hint(c, name))
    }
    return Ref.NoRef
}

// Check that `e` has the type `want`; `m` explains if not.
fn check_expr(c: mut Checker, e: ast.Expr, want: Int, m: Msg) {
    let wants_builtin = types.is_builtin_enum(c.table, want)
    let mut want_name = ""
    if wants_builtin {
        want_name = types.get(c.table, want).name
    }
    match e.kind {
        ast.ExprKind.Name(name) => {
            if name == "None" && lookup_local(c, "None") < 0 {
                // None has no type of its own; the context gives it one.
                if wants_builtin && want_name == "Option" {
                    set_ty(mut c, e, want)
                    c.refs[e.id] = Ref.Variant(want, types.variant_index(c.table, want, "None"))
                } else if want != types.ERROR() {
                    report_at(mut c, e, "E3088", say(m, "None"))
                }
                return
            }
        }
        ast.ExprKind.Call(callee, args) => {
            match callee.kind {
                ast.ExprKind.Name(name) => {
                    if is_builtin_variant(name) {
                        if wants_builtin && want_name == variant_family(name) {
                            construct(mut c, e, args, want, types.variant_index(c.table, want, name), name)
                            return
                        }
                        if name != "Some" || want == types.ERROR() {
                            // Ok(...) and Err(...) cannot be inferred, and a
                            // Some that cannot fit gets one error, not two.
                            for a in args {
                                infer(mut c, a)
                            }
                            if want != types.ERROR() {
                                report_at(mut c, e, "E3089", say(m, name + "(...)"))
                            }
                            return
                        }
                    }
                }
                _ => {}
            }
        }
        ast.ExprKind.FixedIntLit(_, name, _) => {
            if want == types.FLOAT() && name == "" { set_ty(mut c, e, types.FLOAT()); return }
        }
        ast.ExprKind.IntLit(_) => {
            if want == types.FLOAT() {
                set_ty(mut c, e, types.FLOAT())  // a number is an Int unless the context wants a Float
                return
            }
        }
        ast.ExprKind.Unary(op, x) => {
            if op == "-" && want == types.FLOAT() {
                check_expr(mut c, x, types.FLOAT(), m)
                set_ty(mut c, e, types.FLOAT())
                return
            }
        }
        _ => {}
    }
    match e.kind {
        ast.ExprKind.IntLit(n) => {
            if types.is_integer(want) {
                if integers.fits(n, want, n < 0) {
                    set_ty(mut c, e, want)
                } else if want == types.BYTE() {
                    report_at(mut c, e, "E3090", strings.from_int(n) + " does not fit in a Byte (0 to 255)")
                } else {
                    report_at(mut c, e, "E3182", "integer literal does not fit in " + show(c, want))
                }
                return
            }
        }
        ast.ExprKind.ArrayLit(elems) => {
            if types.sequence(c.table, want) || len(elems) == 0 {
                if types.sequence(c.table, want) {
                    if types.is_fixed(c.table, want) && len(elems) != types.get(c.table, want).length { report_at(mut c, e, "E3211", "fixed array literal has the wrong number of elements") }
                    set_ty(mut c, e, want)
                    let elem = types.get(c.table, want).args[0]
                    for x in elems {
                        check_expr(mut c, x, elem, msg("the elements of " + show(c, want) + " are " + show(c, elem) +
                            ", but this is ", ""))
                    }
                } else if want != types.ERROR() {
                    report_at(mut c, e, "E3091", say(m, "an array"))
                }
                return
            }
        }
        ast.ExprKind.MapLit(entries) => {
            if types.is_map(c.table, want) || len(entries) == 0 {
                if types.is_map(c.table, want) {
                    set_ty(mut c, e, want)
                    let k = types.get(c.table, want).args[0]
                    let v = types.get(c.table, want).args[1]
                    for en in entries {
                        check_expr(mut c, en.key, k, msg("the keys of " + show(c, want) + " are " + show(c, k) +
                            ", but this is ", ""))
                        check_expr(mut c, en.value, v, msg("the values of " + show(c, want) + " are " + show(c, v) +
                            ", but this is ", ""))
                    }
                } else if want != types.ERROR() {
                    report_at(mut c, e, "E3092", say(m, "a map"))
                }
                return
            }
        }
        ast.ExprKind.Match(scrutinee, arms) => {
            // Each arm is checked against what the context wants.
            set_ty(mut c, e, want)
            match_arms(mut c, scrutinee, arms, e.line, e.col, MatchBody.Check(want, m))
            return
        }
        _ => {}
    }
    c.expected = want  // for a generic call or value whose type arguments only the context can tell
    let found = value(mut c, e)
    if !fits(c, found, want) && found != types.ERROR() && want != types.ERROR() {
        report_at(mut c, e, "E3093", say(m, show(c, found)) + effect_hint(c, found, want))
    }
}

// Infer the type of an expression that must produce a value.
fn value(c: mut Checker, e: ast.Expr) -> Int {
    let ty = infer(mut c, e)
    if ty == types.NOTHING() {
        let mut callee = e
        match e.kind {
            ast.ExprKind.Call(f, _) => callee = f
            _ => {}
        }
        report_at(mut c, e, "E3094", written(callee) + "(...) does not produce a value")
        return types.ERROR()
    }
    return ty
}

// Work out an expression's type, record it, return it.
fn infer(c: mut Checker, e: ast.Expr) -> Int {
    let expected = c.expected
    c.expected = -2
    if c.chained[e.id] {
        c.chained[e.id] = false
        return c.ty[e.id]
    }
    let t = infer_type(mut c, e, expected)
    set_ty(mut c, e, t)
    return t
}

fn infer_type(c: mut Checker, e: ast.Expr, expected: Int) -> Int {
    match e.kind {
        ast.ExprKind.IntLit(n) => {
            if types.is_integer(expected) {
                if !integers.fits(n, expected, n < 0) { report_at(mut c, e, "E3182", "integer literal does not fit in " + show(c, expected)) }
                return expected
            }
            if expected == types.FLOAT() { return expected }
            return types.INT()
        }
        ast.ExprKind.FixedIntLit(n, name, neg) => {
            if expected == types.FLOAT() && name == "" { return types.FLOAT() }
            let mut t = types.INT()
            if types.is_integer(expected) { t = expected }
            if name != "" { t = integers.type_id(name) }
            if !integers.fits(n, t, neg) {
                if t == types.INT() && name == "" && !neg {
                    report_at(mut c, e, "E1005", "integer literal " + integers.unsigned_text(n) + " does not fit in Int (max 9223372036854775807)")
                } else {
                    report_at(mut c, e, "E3182", "integer literal does not fit in " + show(c, t))
                }
            }
            return t
        }
        ast.ExprKind.FloatLit(_) => return types.FLOAT()
        ast.ExprKind.ByteLit(_) => return types.BYTE()
        ast.ExprKind.BoolLit(_) => return types.BOOL()
        ast.ExprKind.StrLit(_) => return types.STR()
        ast.ExprKind.UnitLit => return types.UNIT()
        ast.ExprKind.Closure(params, result, body, _) => return closure(mut c, e, params, result, body, expected)
        ast.ExprKind.Name(name) => {
            match resolve(mut c, e, name) {
                Ref.Local(id) => {
                    c.refs[e.id] = Ref.Local(id)
                    capture(mut c, id)
                    return c.locals[id].ty
                }
                Ref.Function(id) => return fn_value(mut c, e, id, name, expected)
                _ => return types.ERROR()
            }
        }
        ast.ExprKind.Unary(op, operand) => {
            if (op == "-" || op == "~") && types.is_integer(expected) { c.expected = expected }
            let ty = value(mut c, operand)
            if op == "-" && (types.is_integer(ty) || ty == types.FLOAT()) { return ty }
            if op == "~" && types.is_integer(ty) { return ty }
            let mut want = types.BOOL()
            if op == "-" || op == "~" { want = types.INT() }
            if ty != want && ty != types.ERROR() {
                report_at(mut c, e, "E3095", "operator '" + op + "' needs " + show(c, want) + ", found " + show(c, ty))
            }
            return want
        }
        ast.ExprKind.Binary(op, l, r) => return binary(mut c, e, op, l, r, expected)
        ast.ExprKind.Call(callee, args) => {
            let t = call(mut c, e, callee, args, expected)
            stale_copies(mut c, args)
            return t
        }
        ast.ExprKind.Field(obj, name) => return field(mut c, e, obj, name, expected)
        ast.ExprKind.StructLit(module, name, fields) => return struct_lit(mut c, e, module, name, fields, expected)
        ast.ExprKind.Match(scrutinee, arms) => return match_arms(mut c, scrutinee, arms, e.line, e.col, MatchBody.Infer)
        ast.ExprKind.Index(obj, i) => return index(mut c, e, obj, i)
        ast.ExprKind.Try(inner) => return try_expr(mut c, e, inner)
        ast.ExprKind.MutArg(p) => {
            report_at(mut c, e, "E3096", "`mut` only goes before an argument for a mut parameter")
            return infer(mut c, p)
        }
        ast.ExprKind.Slice(obj, lo, hi) => return slice(mut c, e, obj, lo, hi)
        ast.ExprKind.ArrayLit(elems) => return array_lit(mut c, e, elems)
        ast.ExprKind.MapLit(entries) => return map_lit(mut c, e, entries)
    }
}

// Whether `e` is made only of unsuffixed integer literals, such as 2 * -3,
// which take their type from the context. Remembered, since each operator
// of a long chain asks it of the rest of the chain.
fn is_int_lit(c: mut Checker, e: ast.Expr) -> Bool {
    if c.literal[e.id] != 0 {
        return c.literal[e.id] == 1
    }
    let yes = match e.kind {
        ast.ExprKind.IntLit(_) => true
        ast.ExprKind.FixedIntLit(_, name, _) => name == ""
        ast.ExprKind.Unary(op, x) => (op == "-" || op == "~") && is_int_lit(mut c, x)
        ast.ExprKind.Binary(op, l, r) => (is_arithmetic(op) || is_bitwise(op)) && is_int_lit(mut c, l) && is_int_lit(mut c, r)
        _ => false
    }
    c.literal[e.id] = 2
    if yes {
        c.literal[e.id] = 1
    }
    return yes
}

// a + b + c + ... nests to the left, as ((a + b) + c) + ..., and checking
// it by recursion takes stack in proportion to its length: a few thousand
// terms of generated code overflowed it. A left operand that is not made
// of literals is inferred with no expected type (`operands`, `binary`), so
// the chain's left operands are inferred beforehand from the innermost
// out, each finding its own left operand done: the same order, types and
// diagnostics, with the stack of one operator.
fn chain(c: mut Checker, l: ast.Expr) {
    let mut spine: [ast.Expr] = []
    let mut x = l
    for {
        match x.kind {
            ast.ExprKind.Binary(_, inner, _) => {
                if c.chained[x.id] {
                    break
                }
                push(mut spine, x)
                x = inner
            }
            _ => break
        }
    }
    if len(spine) < 2 {
        return
    }
    // Literal parts sit at the bottom of the spine, and take their type
    // from the context: leave them to the operator above. Asked from the
    // bottom up, so that is_int_lit never walks the whole spine.
    let mut top = len(spine)
    for k in 0..len(spine) {
        let i = len(spine) - 1 - k
        if is_int_lit(mut c, spine[i]) {
            top = i
        }
    }
    let saved = c.expected
    for k in 0..top {
        let i = top - 1 - k
        c.expected = -2
        let _ = value(mut c, spine[i])
        c.chained[spine[i].id] = true
    }
    c.expected = saved
}

// The operands' types. A literal number next to a Byte is a Byte.
fn operands(c: mut Checker, l: ast.Expr, r: ast.Expr, expected: Int) -> [Int] {
    if (types.is_integer(expected) || expected == types.FLOAT()) && is_int_lit(mut c, l) && is_int_lit(mut c, r) {
        check_expr(mut c, l, expected, msg("expected " + show(c, expected) + ", found ", ""))
        check_expr(mut c, r, expected, msg("expected " + show(c, expected) + ", found ", ""))
        return [expected, expected]
    }
    if is_int_lit(mut c, l) && !is_int_lit(mut c, r) {
        let right = value(mut c, r)
        return [literal_like(mut c, l, right), right]
    }
    let left = value(mut c, l)
    if is_int_lit(mut c, r) {
        return [left, literal_like(mut c, r, left)]
    }
    return [left, value(mut c, r)]
}

fn literal_like(c: mut Checker, lit: ast.Expr, other: Int) -> Int {
    if other == types.FLOAT() {
        check_expr(mut c, lit, types.FLOAT(), msg("expected Float, found ", ""))
        return types.FLOAT()
    }
    if types.is_integer(other) {
        check_expr(mut c, lit, other, msg("", ""))
        return other
    }
    return value(mut c, lit)
}

fn is_arithmetic(op: Str) -> Bool {
    return op == "+" || op == "-" || op == "*" || op == "/" || op == "%"
}

fn is_ordering(op: Str) -> Bool {
    return op == "<" || op == "<=" || op == ">" || op == ">="
}

// Whether `==` works on values of `t`.
fn comparable(c: Checker, t: Int) -> Bool {
    let ti = types.get(c.table, t)
    if ti.tag == types.Tag.Prim || types.has_bound(c.table, t, "Eq") {
        return true
    }
    return satisfies_depth(c, t, "Eq", 0)
}

fn is_bitwise(op: Str) -> Bool { return op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" }

fn binary(c: mut Checker, e: ast.Expr, op: Str, l: ast.Expr, r: ast.Expr, expected: Int) -> Int {
    chain(mut c, l)
    if op == "<<" || op == ">>" {
        if types.is_integer(expected) && is_int_lit(mut c, l) { c.expected = expected }
        let left = value(mut c, l)
        let right = value(mut c, r)
        if (!types.is_integer(left) || !types.is_integer(right)) && left != types.ERROR() && right != types.ERROR() {
            report_at(mut c, e, "E3183", "bit operations need integer operands")
        }
        return left
    }
    let ops = operands(mut c, l, r, expected)
    let left = ops[0]
    let right = ops[1]
    let mut result = types.BOOL()
    if is_arithmetic(op) || is_bitwise(op) {
        result = types.INT()
        if types.is_integer(left) || left == types.FLOAT() || left == types.STR() && op == "+" {
            result = left
        }
    }
    if left == types.ERROR() || right == types.ERROR() {
        return result  // the operand's error is already reported
    }
    let int = types.INT()
    let byte = types.BYTE()
    if is_bitwise(op) {
        if !types.is_integer(left) || left != right { report_at(mut c, e, "E3183", "bit operations need integers of the same type") }
    } else if op == "==" || op == "!=" {
        if left != right {
            report_at(mut c, e, "E3097", "cannot compare " + show(c, left) + " with " + show(c, right))
        } else if !comparable(c, left) && types.is_param(c.table, left) {
            report_at(mut c, e, "E3098", show(c, left) + " values cannot be compared with '" + op + "'; declare the type parameter as `" +
                show(c, left) + ": Eq`")
        } else if !comparable(c, left) {
            report_at(mut c, e, "E3099", show(c, left) + " values cannot be compared with '" + op +
                "'; use match, or compare their fields")
        }
    } else if op == "&&" || op == "||" {
        if left != types.BOOL() || right != types.BOOL() {
            report_at(mut c, e, "E3100", "operator '" + op + "' needs Bool operands, found " + show(c, left) + " and " + show(c, right))
        }
    } else if op == "+" && (left == types.STR() || right == types.STR()) {
        if left != right {
            report_at(mut c, e, "E3101", "operator '+' joins two Strs, found " + show(c, left) + " and " + show(c, right))
        }
    } else if is_ordering(op) && left == types.STR() && right == types.STR() {
        // Strs are ordered byte by byte
    } else if is_ordering(op) && left == right && satisfies(c, left, "Ord") {
        // a type parameter bound by Ord
    } else if left == types.FLOAT() && right == types.FLOAT() {
        if op == "%" {
            report_at(mut c, e, "E3102", "operator '%' needs Int operands; a Float has no remainder")
        }
    } else if (left == types.FLOAT() || right == types.FLOAT()) && (types.is_integer(left) || left == types.FLOAT()) &&
        (types.is_integer(right) || right == types.FLOAT()) {
        report_at(mut c, e, "E3103", "operator '" + op + "' needs two Floats or two Ints, found " + show(c, left) + " and " +
            show(c, right) + "; convert with float() or int()")
    } else if left != right || !types.is_integer(left) {
        if types.is_integer(left) && types.is_integer(right) && left != right &&
            !((left == int && right == byte) || (left == byte && right == int)) {
            report_at(mut c, e, "E3185", "operator '" + op + "' requires matching integer types; convert explicitly")
            return result
        }
        let both_numbers = (left == int || left == byte) && (right == int || right == byte)
        if (left == byte || right == byte) && both_numbers {
            report_at(mut c, e, "E3104", "operator '" + op + "' needs two Bytes or two Ints, found " + show(c, left) + " and " +
                show(c, right) + "; convert with int() or byte()")
        } else if is_ordering(op) && left == right && types.is_param(c.table, left) {
            report_at(mut c, e, "E3105", "operator '" + op + "' needs values that can be ordered; declare the type parameter as `" +
                show(c, left) + ": Ord`")
        } else if is_ordering(op) {
            report_at(mut c, e, "E3106", "operator '" + op + "' needs matching integers, Floats or Strs, found " + show(c, left) +
                " and " + show(c, right))
        } else {
            report_at(mut c, e, "E3107", "operator '" + op + "' needs Int operands, found " + show(c, left) + " and " + show(c, right))
        }
    }
    if left == right && (op == "==" || op == "!=" || is_ordering(op)) {
        let mut bound = "Eq"
        let mut method_name = "eq"
        if is_ordering(op) { bound = "Ord"; method_name = "compare" }
        if !intrinsic(c.table, left, bound) && satisfies(c, left, bound) {
            c.refs[e.id] = Ref.Method(left, method_name)
        }
    }
    // The result type is known even when the operands were wrong.
    return result
}

fn index(c: mut Checker, e: ast.Expr, obj: ast.Expr, i: ast.Expr) -> Int {
    let t = value(mut c, obj)
    if types.sequence(c.table, t) || t == types.STR() {
        check_expr(mut c, i, types.INT(), msg("an index must be Int, found ", ""))
        if t == types.STR() {
            return types.BYTE()
        }
        return types.get(c.table, t).args[0]
    }
    if types.is_map(c.table, t) {
        let k = types.get(c.table, t).args[0]
        check_expr(mut c, i, k, msg("the keys of " + show(c, t) + " are " + show(c, k) + ", but this is ", ""))
        return types.get(c.table, t).args[1]
    }
    if t != types.ERROR() {
        report_at(mut c, e, "E3108", show(c, t) + " cannot be indexed; only arrays, Strs and maps can")
    }
    infer(mut c, i)
    return types.ERROR()
}

// `x?`: the value inside an Ok or Some, or the function returns the Err or
// None at once.
fn try_expr(c: mut Checker, e: ast.Expr, inner: ast.Expr) -> Int {
    let t = value(mut c, inner)
    if t == types.ERROR() {
        return types.ERROR()
    }
    if !types.is_builtin_enum(c.table, t) {
        report_at(mut c, e, "E3109", "'?' needs a Result or an Option, found " + show(c, t))
        return types.ERROR()
    }
    let f = c.fns[c.current_fn]
    let mut result = f.result
    let mut name = f.decl.name
    let n = len(c.in_closures)
    if n > 0 {
        result = c.in_closures[n - 1].result
        name = "this function value"
        if result == -3 {
            result = types.ERROR()
            report_at(mut c, e, "E3110", "'?' in a function value needs its result type written, as in fn(x: Str) -> Result[Int, Str] { ... }")
        }
    }
    let mut returns = "returns nothing"
    if result != types.NOTHING() {
        returns = "returns " + show(c, result)
    }
    let ti = types.get(c.table, t)
    let kind = ti.name  // "Result" or "Option"
    if result == types.ERROR() {
        // the unknown result type is already reported
    } else if !(types.is_builtin_enum(c.table, result) && types.get(c.table, result).name == kind) {
        let mut passes = "None"
        let mut must = "an Option"
        if kind == "Result" {
            passes = "an Err"
            must = "a Result"
        }
        report_at(mut c, e, "E3111", "'?' returns " + passes + " from '" + name + "', so '" + name + "' must return " + must +
            ", but it " + returns)
    } else if kind == "Result" {
        let theirs = types.get(c.table, result).args[1]
        let ours = ti.args[1]
        if theirs != ours && theirs != types.ERROR() && ours != types.ERROR() {
            report_at(mut c, e, "E3112", "'?' would return this " + show(c, t) + "'s error, which is " + show(c, ours) +
                ", but '" + name + "' returns " + show(c, result))
        }
    }
    return ti.args[0]
}

fn slice(c: mut Checker, e: ast.Expr, obj: ast.Expr, lo: ast.Expr, hi: ast.Expr) -> Int {
    let t = value(mut c, obj)
    for bound in [lo, hi] {
        check_expr(mut c, bound, types.INT(), msg("the bounds of a slice must be Int, found ", ""))
    }
    if types.is_array(c.table, t) || t == types.STR() || t == types.ERROR() {
        return t
    }
    report_at(mut c, e, "E3113", show(c, t) + " cannot be sliced; only arrays and Strs can")
    return types.ERROR()
}

fn array_lit(c: mut Checker, e: ast.Expr, elems: [ast.Expr]) -> Int {
    if len(elems) == 0 {
        report_at(mut c, e, "E3114", "cannot tell what this [] holds; give it a type, as in `let xs: [Int] = []`")
        return types.ERROR()
    }
    let first = value(mut c, elems[0])
    for x in elems[1..len(elems)] {
        check_expr(mut c, x, first, msg("the elements of an array must all be " + show(c, first) + ", but this is ", ""))
    }
    return types.array(mut c.table, first)
}

fn map_lit(c: mut Checker, e: ast.Expr, entries: [ast.MapEntry]) -> Int {
    if len(entries) == 0 {
        report_at(mut c, e, "E3115", "cannot tell what this [:] holds; give it a type, as in `let m: Map[Str, Int] = [:]`")
        return types.ERROR()
    }
    let mut k = value(mut c, entries[0].key)
    let v = value(mut c, entries[0].value)
    if !key_type(c, k) && k != types.ERROR() {
        report_at(mut c, entries[0].key, "E3116", key_failure(c, k))
        k = types.ERROR()
    }
    for en in entries[1..len(entries)] {
        check_expr(mut c, en.key, k, msg("the keys of this map are " + show(c, k) + ", but this is ", ""))
        check_expr(mut c, en.value, v, msg("the values of this map are " + show(c, v) + ", but this is ", ""))
    }
    return types.map(mut c.table, k, v)
}

// The enum `e` names: an enum type no variable shadows (`TokenKind.Plus`),
// or a pub enum of an imported module (`lexer.TokenKind.Plus`). -1 if `e`
// names none; ERROR when `e` is `module.Name` but Name is no pub type there.
fn enum_named(c: mut Checker, e: ast.Expr) -> Int {
    match e.kind {
        ast.ExprKind.Name(name) => {
            if lookup_local(c, name) < 0 {
                match maps.get(module_types(c), name) {
                    Some(t) => {
                        if types.is_enum(c.table, t) {
                            return t
                        }
                    }
                    None => {}
                }
            }
        }
        ast.ExprKind.Field(obj, name) => {
            let module = module_named(c, obj)
            if module >= 0 {
                let t = module_type(mut c, e.line, e.col, module, name)
                if t < 0 {
                    return types.ERROR()
                }
                if types.is_enum(c.table, t) {
                    return t
                }
            }
        }
        _ => {}
    }
    return -1
}

fn field(c: mut Checker, e: ast.Expr, obj: ast.Expr, name: Str, expected: Int) -> Int {
    completing(mut c, name, [obj])
    let module = module_named(c, obj)
    if module >= 0 {
        // `lexer.next` or `lexer.Token` as a value: say which it is.
        let m = c.modules[module]
        if maps.has(m.types, name) {
            report_at(mut c, e, "E3117", "'" + m.name + "." + name + "' is a type, not a value")
        } else if has_std(m, name) {
            report_at(mut c, e, "E3118", "'" + m.name + "." + name + "' is a built-in function, which cannot be used as a value; " +
                "wrap it in a function of your own")
        } else if maps.has(m.fns, name) {
            match module_fn(mut c, e.line, e.col, module, name) {
                Ref.Function(id) => return fn_value(mut c, e, id, m.name + "." + name, expected)
                _ => return types.ERROR()
            }
        } else {
            report_at(mut c, e, "E3119", "module '" + m.name + "' has no '" + name + "'")
        }
        return types.ERROR()
    }
    let enum = enum_named(mut c, obj)
    if enum == types.ERROR() {
        return types.ERROR()
    }
    if enum >= 0 {
        let vi = types.variant_index(c.table, enum, name)
        if vi < 0 {
            report_at(mut c, e, "E3120", "'" + show(c, enum) + "' has no variant '" + name + "'")
            return types.ERROR()
        }
        let n = len(types.get(c.table, enum).variants[vi].payload)
        if n > 0 {
            report_at(mut c, e, "E3121", show(c, enum) + "." + name + " carries " + plural(n, "value") + "; write " +
                show(c, enum) + "." + name + "(...)")
            return types.ERROR()
        }
        if types.is_generic(c.table, enum) {
            // `Tree.Leaf` says nothing about T: the context must.
            if expected >= 0 && types.get(c.table, expected).origin == enum && known_type(c, expected) {
                c.refs[e.id] = Ref.Variant(expected, vi)
                return expected
            }
            report_at(mut c, e, "E3122", "cannot tell which " + show(c, enum) + " this " + show(c, enum) + "." + name +
                " is; give it a type, as in `let x: " + show(c, enum) + "[" +
                    example_args(len(types.get(c.table, enum).params)) + "] = " + show(c, enum) + "." + name + "`")
            return types.ERROR()
        }
        c.refs[e.id] = Ref.Variant(enum, vi)
        return enum
    }
    let t = value(mut c, obj)
    if t == types.ERROR() {
        return types.ERROR()
    }
    if types.is_fixed(c.table, t) { report_at(mut c, e, "E3212", "fixed arrays expose elements through indexing"); return types.ERROR() }
    if !types.is_struct(c.table, t) {
        let mut hint = ""
        if types.is_enum(c.table, t) {
            hint = "; use match to look inside it"
        }
        report_at(mut c, e, "E3123", show(c, t) + " has no fields" + hint)
        return types.ERROR()
    }
    let fi = types.field_index(c.table, t, name)
    if fi < 0 {
        report_at(mut c, e, "E3124", "'" + show(c, t) + "' has no field '" + name + "'")
        return types.ERROR()
    }
    return types.get(c.table, t).fields[fi].ty
}

fn struct_lit(c: mut Checker, e: ast.Expr, module: Str, name: Str, fields: [ast.FieldInit], expected: Int) -> Int {
    let mut written = name
    if module != "" {
        written = module + "." + name
    }
    let mut t = -1
    if module != "" {
        let m = module_in_type(mut c, e.line, e.col, module)
        if m >= 0 {
            t = module_type(mut c, e.line, e.col, m, name)
        }
        if t < 0 {
            t = types.ERROR()
        }
    } else {
        match maps.get(module_types(c), name) {
            Some(id) => t = id
            None => {}
        }
    }
    if t < 0 || !types.is_struct(c.table, t) {
        if t < 0 {
            report_at(mut c, e, "E3125", "unknown type '" + name + "'")
        } else if types.is_interface(c.table, t) {
            report_at(mut c, e, "E3190", "interface '" + written + "' is a bound, not a value constructor")
        } else if t != types.ERROR() {
            report_at(mut c, e, "E3126", "'" + written + "' is an enum; build its values with " + written + ".Variant")
        }
        for f in fields {
            infer(mut c, f.value)
        }
        return types.ERROR()
    }
    if types.is_generic(c.table, t) {
        return generic_struct_lit(mut c, e, t, fields, expected)
    }
    let mut seen: [Str] = []
    for f in fields {
        let fi = types.field_index(c.table, t, f.name)
        let mut twice = false
        for s in seen {
            if s == f.name {
                twice = true
            }
        }
        if twice || fi < 0 {
            if twice {
                report(mut c, f.line, f.col, "E3127", "field '" + f.name + "' is given twice")
            } else {
                report(mut c, f.line, f.col, "E3128", "'" + show(c, t) + "' has no field '" + f.name + "'")
            }
            infer(mut c, f.value)
            continue
        }
        push(mut seen, f.name)
        let want = types.get(c.table, t).fields[fi].ty
        check_expr(mut c, f.value, want, msg("field '" + f.name + "' of '" + show(c, t) + "' is " + show(c, want) +
            ", but this is ", ""))
    }
    let mut missing: [Str] = []
    for fd in types.get(c.table, t).fields {
        let mut given = false
        for s in seen {
            if s == fd.name {
                given = true
            }
        }
        if !given {
            push(mut missing, fd.name)
        }
    }
    if len(missing) > 0 {
        let mut names = strings.builder()
        for i in 0..len(missing) {
            if i > 0 {
                strings.add(mut names, ", ")
            }
            strings.add(mut names, "'" + missing[i] + "'")
        }
        let mut word = "fields"
        if len(missing) == 1 {
            word = "field"
        }
        report_at(mut c, e, "E3129", "missing " + word + " " + strings.build(names) + " in this '" + show(c, t) + "' value")
    }
    return t
}

// `Box { value: 1 }`: the type arguments come from the fields' values, or
// else from the context.
fn generic_struct_lit(c: mut Checker, e: ast.Expr, decl: Int, fields: [ast.FieldInit], expected: Int) -> Int {
    let name = show(c, decl)
    let mut seen: [Str] = []
    let mut values: [ast.Expr] = []
    let mut wants: [Int] = []
    let mut labels: [Str] = []
    for f in fields {
        let fi = types.field_index(c.table, decl, f.name)
        let mut twice = false
        for s in seen {
            if s == f.name {
                twice = true
            }
        }
        if twice || fi < 0 {
            if twice {
                report(mut c, f.line, f.col, "E3130", "field '" + f.name + "' is given twice")
            } else {
                report(mut c, f.line, f.col, "E3131", "'" + name + "' has no field '" + f.name + "'")
            }
            infer(mut c, f.value)
            continue
        }
        push(mut seen, f.name)
        push(mut values, f.value)
        push(mut wants, types.get(c.table, decl).fields[fi].ty)
        push(mut labels, "field '" + f.name + "' of '" + name + "'")
    }
    let params = types.get(c.table, decl).params
    let mut mutable: [Bool] = []
    for _ in values {
        push(mut mutable, false)
    }
    // What is being built is the context's business first: in
    // `let b: Box[Int] = Box { value: "s" }` the field is wrong, not the Box.
    let mut known = unknown(len(params))
    from_context(mut c, decl, expected, mut known)
    let mut bound = infer_args(mut c, params, wants, values, mutable, labels, known)
    if !all_known(mut c, e, params, mut bound, "in this '" + name + "' value", "; give it a type, as in `let x: " +
        name + "[" + example_args(len(params)) + "] = " + name + " { ... }`") {
        return types.ERROR()
    }
    for i in 0..len(params) {
        check_bounds(mut c, e.line, e.col, "'" + name + "'", params[i], bound[i])
    }
    let t = types.instantiate(mut c.table, decl, bound)
    let mut missing: [Str] = []
    for fd in types.get(c.table, t).fields {
        let mut given = false
        for s in seen {
            if s == fd.name {
                given = true
            }
        }
        if !given {
            push(mut missing, "'" + fd.name + "'")
        }
    }
    if len(missing) > 0 {
        let mut word = "fields "
        if len(missing) == 1 {
            word = "field "
        }
        report_at(mut c, e, "E3132", "missing " + word + join(missing) + " in this '" + show(c, t) + "' value")
    }
    return t
}

fn join(words: [Str]) -> Str {
    let mut b = strings.builder()
    for i in 0..len(words) {
        if i > 0 {
            strings.add(mut b, ", ")
        }
        strings.add(mut b, words[i])
    }
    return strings.build(b)
}

// ---- Type arguments ----

// The index of `t` in `params`, or -1.
fn param_index(params: [Int], t: Int) -> Int {
    for i in 0..len(params) {
        if params[i] == t {
            return i
        }
    }
    return -1
}

// Whether `t` mentions any of `params`.
fn mentions(c: Checker, t: Int, params: [Int]) -> Bool {
    if t < 0 || !types.is_open(c.table, t) {
        return false
    }
    if param_index(params, t) >= 0 {
        return true
    }
    for a in types.get(c.table, t).args {
        if mentions(c, a, params) {
            return true
        }
    }
    return mentions(c, types.get(c.table, t).result, params)
}

// `t` with the type arguments found so far put in.
fn partial(c: mut Checker, t: Int, params: [Int], bound: [Int]) -> Int {
    let mut ps: [Int] = []
    let mut args: [Int] = []
    for i in 0..len(params) {
        if bound[i] >= 0 {
            push(mut ps, params[i])
            push(mut args, bound[i])
        }
    }
    return types.subst(mut c.table, t, ps, args)
}

// Match the type `pattern`, which mentions `params`, against `actual`,
// recording what each parameter must be. False if they cannot match.
fn unify(c: Checker, pattern: Int, actual: Int, params: [Int], bound: mut [Int]) -> Bool {
    if actual == types.ERROR() || pattern == types.ERROR() {
        return true
    }
    let i = param_index(params, pattern)
    if i >= 0 {
        if bound[i] < 0 || fits(c, bound[i], actual) {
            bound[i] = actual  // the same, or a function type that allows more
            return true
        }
        return fits(c, actual, bound[i])
    }
    if !mentions(c, pattern, params) {
        return fits(c, actual, pattern)
    }
    let p = types.get(c.table, pattern)
    let a = types.get(c.table, actual)
    if p.tag != a.tag || p.origin != a.origin || p.name != a.name || len(p.args) != len(a.args) {
        return false
    }
    for k in 0..len(p.args) {
        if !unify(c, p.args[k], a.args[k], params, mut bound) {
            return false
        }
    }
    if p.result < 0 || a.result < 0 {
        return p.result == a.result
    }
    return unify(c, p.result, a.result, params, mut bound)
}

// A value whose type the context gives: in `f([])`, the [] is checked once
// the other arguments have told what its element type is.
fn needs_context(c: Checker, e: ast.Expr) -> Bool {
    match e.kind {
        ast.ExprKind.Closure(params, _, _, _) => {
            for p in params {
                match p.ty {
                    None => return true
                    Some(_) => {}
                }
            }
            return false
        }
        ast.ExprKind.Field(obj, _) => {
            // `Tree.Leaf`, a variant of a generic enum
            match obj.kind {
                ast.ExprKind.Name(n) => {
                    if lookup_local(c, n) >= 0 {
                        return false
                    }
                    match maps.get(module_types(c), n) {
                        Some(t) => return types.is_generic(c.table, t)
                        None => return false
                    }
                }
                _ => return false
            }
        }
        ast.ExprKind.ArrayLit(xs) => return len(xs) == 0
        ast.ExprKind.MapLit(xs) => return len(xs) == 0
        ast.ExprKind.Name(n) => return n == "None"
        ast.ExprKind.Call(callee, _) => {
            match callee.kind {
                ast.ExprKind.Name(n) => return n == "Ok" || n == "Err"
                _ => return false
            }
        }
        _ => return false
    }
}

// Check the values given for a generic's parameters (a call's arguments, a
// struct's fields, a variant's values), working out the type arguments as
// it goes. `wants` are the declared types, which mention `params`; `known`
// is what each parameter is already known to be, or -1. Returns what each
// must be, or -1 where nothing said.
fn infer_args(c: mut Checker, params: [Int], wants: [Int], args: [ast.Expr], mutable: [Bool], labels: [Str],
    known: [Int]) -> [Int] {
    let mut bound = known
    for pass in 0..2 {
        for i in 0..len(args) {
            let arg = args[i]
            if i >= len(wants) {
                if pass == 0 {
                    infer(mut c, arg)
                }
                continue
            }
            let deferred = needs_context(c, arg) && mentions(c, wants[i], params)
            if deferred != (pass == 1) {
                continue
            }
            let want = partial(mut c, wants[i], params, bound)
            if mutable[i] {
                let t = mut_argument(mut c, arg, types.NOTHING(), labels[i])
                if !unify(c, want, t, params, mut bound) {
                    report_at(mut c, arg, "E3133", labels[i] + " must be " + show(c, want) + ", found " + show(c, t))
                }
                continue
            }
            let mut value_e = arg
            match arg.kind {
                ast.ExprKind.MutArg(inner) => {
                    report_at(mut c, arg, "E3134", labels[i] + " is not a mut parameter; remove `mut`")
                    last_fix(mut c, repairs.remove_mut(c.modules[c.current].source, c.modules[c.current].path, arg.line, arg.col))
                    value_e = inner
                }
                _ => {}
            }
            if !mentions(c, want, params) {
                check_expr(mut c, value_e, want, msg(labels[i] + " must be " + show(c, want) + ", found ", ""))
                continue
            }
            // A closure takes what is known of its type from here; the
            // parameters still unknown it works out itself.
            let saved = c.pending
            c.pending = params
            c.expected = want
            let t = value(mut c, value_e)
            c.pending = saved
            if !unify(c, want, t, params, mut bound) {
                report_at(mut c, value_e, "E3135", labels[i] + " must be " + show(c, want) + ", found " + show(c, t))
            } else {
                // Unifying passes over effects; they must fit too.
                let full = partial(mut c, wants[i], params, bound)
                if !mentions(c, full, params) && !fits(c, t, full) && t != types.ERROR() {
                    report_at(mut c, value_e, "E3136", labels[i] + " must be " + show(c, full) + ", found " + show(c, t) +
                        effect_hint(c, t, full))
                }
            }
        }
    }
    return bound
}

fn unknown(n: Int) -> [Int] {
    let mut out: [Int] = []
    for _ in 0..n {
        push(mut out, -1)
    }
    return out
}

// When the context wants an instance of generic type `decl`, its type
// arguments say what the parameters still unknown are.
fn from_context(c: mut Checker, decl: Int, expected: Int, bound: mut [Int]) {
    if expected < 0 || types.get(c.table, expected).origin != decl || !known_type(c, expected) {
        return
    }
    let args = types.get(c.table, expected).args
    for i in 0..len(bound) {
        if bound[i] < 0 {
            bound[i] = args[i]
        }
    }
}

// `t` with the unknown parameters taken as Int, for an example in a message.
fn example_type(c: mut Checker, t: Int, params: [Int], bound: [Int]) -> Int {
    let mut filled: [Int] = []
    for b in bound {
        if b < 0 {
            push(mut filled, types.INT())
        } else {
            push(mut filled, b)
        }
    }
    return partial(mut c, t, params, filled)
}

// Report the type parameters nothing told the type of, and make them
// ERROR. True if all are known.
fn all_known(c: mut Checker, e: ast.Expr, params: [Int], bound: mut [Int], where: Str, hint: Str) -> Bool {
    let mut ok = true
    for i in 0..len(params) {
        if bound[i] < 0 {
            if ok {
                report_at(mut c, e, "E3137", "cannot tell what " + types.get(c.table, params[i]).name + " is " + where + hint)
            }
            bound[i] = types.ERROR()
            ok = false
        } else if bound[i] == types.ERROR() {
            ok = false
        }
    }
    return ok
}

// ---- Copies made before a change ----
//
// Arguments are values, evaluated left to right, and a `mut` argument's
// place last of all. So in `unify(c, types.instantiate(mut c.table, ...))`
// the first argument is a copy of `c` made before the second changes
// c.table, and in `f(c, mut c.x)` the call changes c.x through a pointer
// while its first argument still has the old c. Both are almost always
// mistakes, and both are warned about. Only an argument that is itself the
// variable, or a path into it, counts: in `report(mut c, show(c, t))` the
// copy of c is used up making a message before the call changes c. And
// reading a part of what changes, as in `push(mut xs, xs[0])`, is what
// anyone means.

// A variable, or a path of fields and elements ("[]") into one.
type Path = struct {
    local: Int
    parts: [Str]
}

fn path_of(c: Checker, e: ast.Expr) -> Option[Path] {
    match e.kind {
        ast.ExprKind.Name(_) => {
            match c.refs[e.id] {
                Ref.Local(l) => return Some(Path { local: l, parts: [] })
                _ => return None
            }
        }
        ast.ExprKind.Field(obj, name) => {
            match c.refs[e.id] {
                Ref.Variant(_, _) => return None
                Ref.Function(_) => return None
                _ => {}
            }
            let mut p = path_of(c, obj)?
            push(mut p.parts, name)
            return Some(p)
        }
        ast.ExprKind.Index(obj, _) => {
            let mut p = path_of(c, obj)?
            push(mut p.parts, "[]")
            return Some(p)
        }
        _ => return None
    }
}

fn path_text(c: Checker, p: Path) -> Str {
    let mut b = strings.builder()
    strings.add(mut b, c.locals[p.local].name)
    for part in p.parts {
        if part == "[]" {
            strings.add(mut b, "[...]")
        } else {
            strings.add(mut b, "." + part)
        }
    }
    return strings.build(b)
}

// Whether a copy of `read` holds the place `changed`.
fn covers(read: Path, changed: Path) -> Bool {
    if read.local != changed.local || len(read.parts) > len(changed.parts) {
        return false
    }
    for i in 0..len(read.parts) {
        if read.parts[i] != changed.parts[i] {
            return false
        }
    }
    return true
}

// The places `e` reads, and those it changes through `mut` arguments of
// calls inside it.
fn accesses(c: Checker, e: ast.Expr, reads: mut [Path], changes: mut [Path]) {
    match e.kind {
        ast.ExprKind.MutArg(p) => {
            match path_of(c, p) {
                Some(path) => push(mut changes, path)
                None => {}
            }
            return
        }
        ast.ExprKind.Name(_) => {}
        ast.ExprKind.Field(_, _) => {}
        ast.ExprKind.Index(_, i) => accesses(c, i, mut reads, mut changes)
        _ => {}
    }
    match path_of(c, e) {
        Some(path) => {
            push(mut reads, path)
            return
        }
        None => {}
    }
    let mut parts: [ast.Expr] = []
    match e.kind {
        ast.ExprKind.Unary(_, x) => parts = [x]
        ast.ExprKind.Binary(_, l, r) => parts = [l, r]
        ast.ExprKind.Call(callee, args) => {
            parts = args
            push(mut parts, callee)
        }
        ast.ExprKind.Field(obj, _) => parts = [obj]
        ast.ExprKind.Index(obj, _) => parts = [obj]
        ast.ExprKind.Try(x) => parts = [x]
        ast.ExprKind.Slice(obj, lo, hi) => parts = [obj, lo, hi]
        ast.ExprKind.ArrayLit(xs) => parts = xs
        ast.ExprKind.MapLit(entries) => {
            for en in entries {
                push(mut parts, en.key)
                push(mut parts, en.value)
            }
        }
        ast.ExprKind.StructLit(_, _, fields) => {
            for f in fields {
                push(mut parts, f.value)
            }
        }
        ast.ExprKind.Match(scrutinee, _) => parts = [scrutinee]
        _ => {}
    }
    for x in parts {
        accesses(c, x, mut reads, mut changes)
    }
}

// Warn about an argument that is a copy of something a later argument, or
// the call itself through a `mut` argument, changes.
fn stale_copies(c: mut Checker, args: [ast.Expr]) {
    if len(args) < 2 {
        return
    }
    let mut reads: [[Path]] = []
    let mut changes: [[Path]] = []  // by nested calls, while the argument is worked out
    let mut direct: [Option[Path]] = []  // by the call, through the argument
    for a in args {
        let mut r: [Path] = []
        let mut w: [Path] = []
        let mut d: Option[Path] = None
        match a.kind {
            ast.ExprKind.MutArg(p) => d = path_of(c, p)
            _ => {
                let mut nested_reads: [Path] = []
                accesses(c, a, mut nested_reads, mut w)
                match path_of(c, a) {
                    Some(p) => push(mut r, p)
                    None => {}
                }
            }
        }
        push(mut reads, r)
        push(mut changes, w)
        push(mut direct, d)
    }
    for i in 0..len(args) {
        for read in reads[i] {
            for j in 0..len(args) {
                if j == i {
                    continue
                }
                let what = "argument " + strings.from_int(i + 1) + " is a copy of '" + path_text(c, read) + "'"
                match direct[j] {
                    Some(changed) => {
                        if covers(read, changed) {
                            warn_at(mut c, args[i], "E3138", what + ", but the call changes '" + path_text(c, changed) +
                                "' through `mut` in argument " + strings.from_int(j + 1) +
                                    ", and the copy will not show it; pass only the part the call needs")
                            return
                        }
                    }
                    None => {}
                }
                if j > i {
                    for changed in changes[j] {
                        if covers(read, changed) {
                            warn_at(mut c, args[i], "E3139", what + " made before argument " + strings.from_int(j + 1) + " changes '" +
                                path_text(c, changed) + "' through `mut`, so it has the old value; make the change " +
                                    "in a statement before this call")
                            return
                        }
                    }
                }
            }
        }
    }
}

// ---- Calls ----

fn call(c: mut Checker, e: ast.Expr, callee: ast.Expr, args: [ast.Expr], expected: Int) -> Int {
    let target = call_target(mut c, callee)
    match target {
        Ref.Method(t, name) => return method_call(mut c, e, callee, args, t, name, expected)
        Ref.NoRef => {
            for a in args {
                infer(mut c, a)  // still look for errors inside the arguments
            }
            return types.ERROR()
        }
        Ref.Builtin(name) => {
            if name == "Some" {
                // Some(x) is an Option of whatever x is. None, Ok and Err get
                // their types from a context instead; see check().
                if len(args) != 1 {
                    arity(mut c, e, "Some", 1, len(args))
                    for a in args {
                        infer(mut c, a)
                    }
                    return types.ERROR()
                }
                let t = types.option(mut c.table, value(mut c, args[0]))
                if types.is_enum(c.table, t) {
                    c.refs[e.id] = Ref.Variant(t, types.variant_index(c.table, t, "Some"))
                }
                return t
            }
            if is_builtin_variant(name) {  // Ok, Err or None with no context
                for a in args {
                    infer(mut c, a)
                }
                report_at(mut c, e, "E3140", "cannot tell which Result this " + name + "(...) is; give it a type, as in " +
                    "`let r: Result[Int, Str] = " + name + "(...)`")
                return types.ERROR()
            }
            c.refs[e.id] = Ref.Builtin(name)
            use_effect(mut c, e, effect_of(name), name)
            if name == "tasks.map" || name == "tasks.each" {
                return tasks_call(mut c, e, name, args)
            }
            return builtin(mut c, e, name, args, written(callee), expected)
        }
        Ref.Variant(enum, vi) => {
            if types.is_generic(c.table, enum) {
                return generic_variant(mut c, e, args, enum, vi, expected)
            }
            construct(mut c, e, args, enum, vi, show(c, enum) + "." + types.get(c.table, enum).variants[vi].name)
            return enum
        }
        Ref.Function(id) => return known_call(mut c, e, id, written(callee), args, expected)
        Ref.Local(id) => {
            set_ty(mut c, callee, c.locals[id].ty)
            c.refs[callee.id] = Ref.Local(id)
            return indirect_call(mut c, e, c.locals[id].ty, args, "'" + c.locals[id].name + "'")
        }
        Ref.Indirect => return indirect_call(mut c, e, c.ty[callee.id], args, "a function value")
    }
}

// An argument the call may change: written `mut place`, where the place
// may change. Returns its type.
fn mut_argument(c: mut Checker, arg: ast.Expr, want: Int, what: Str) -> Int {
    match arg.kind {
        ast.ExprKind.MutArg(p) => {
            let t = place(mut c, p, "change")
            set_ty(mut c, arg, t)
            if want != types.NOTHING() && t != want && t != types.ERROR() && want != types.ERROR() {
                report_at(mut c, p, "E3142", what + " must be " + show(c, want) + ", found " + show(c, t))
            }
            return t
        }
        _ => {
            report_at(mut c, arg, "E3143", what + " is changed by the call; write `mut` before it")
            match arg.kind {
                ast.ExprKind.Name(_) => last_fix(mut c, repairs.mut_argument(c.modules[c.current].source, c.modules[c.current].path, arg))
                ast.ExprKind.Field(_, _) => last_fix(mut c, repairs.mut_argument(c.modules[c.current].source, c.modules[c.current].path, arg))
                ast.ExprKind.Index(_, _) => last_fix(mut c, repairs.mut_argument(c.modules[c.current].source, c.modules[c.current].path, arg))
                _ => {}
            }
            let t = infer(mut c, arg)
            if t == types.NOTHING() {
                return types.ERROR()
            }
            return t
        }
    }
}

// No two `mut` arguments of one call may belong to the same variable.
fn exclusive(c: mut Checker, args: [ast.Expr]) {
    let mut seen: [Str] = []
    for a in args {
        match a.kind {
            ast.ExprKind.MutArg(p) => {
                let root = root_of(p)
                match root.kind {
                    ast.ExprKind.Name(name) => {
                        for s in seen {
                            if s == name {
                                report_at(mut c, a, "E3144", "'" + name + "' is passed as mut twice in this call")
                            }
                        }
                        push(mut seen, name)
                    }
                    _ => {}
                }
            }
            _ => {}
        }
    }
}

// A call to a generic function: its type arguments are worked out from the
// arguments, or else from the type the context wants, and recorded for the
// code generator, which makes a copy of the function for each set.
fn generic_call(c: mut Checker, e: ast.Expr, id: Int, name: Str, args: [ast.Expr], expected: Int) -> Int {
    let f = c.fns[id]
    arity(mut c, e, name, len(f.params), len(args))
    let mut labels: [Str] = []
    for i in 0..len(args) {
        push(mut labels, "argument " + strings.from_int(i + 1) + " of '" + name + "'")
    }
    let tp = f.type_params
    let mut bound = infer_args(mut c, tp, f.params, args, f.mutable, labels, unknown(len(tp)))
    exclusive(mut c, args)
    if expected >= 0 && f.result >= 0 {
        unify(c, f.result, expected, tp, mut bound)
    }
    // (Made before the call below: an argument list sees `c` as it was
    // before any `mut` argument in it changes it.)
    let mut hint = "; pass arguments whose types tell"
    if f.result >= 0 {
        let example = example_type(mut c, f.result, tp, bound)
        hint = "; give the result a type, as in `let x: " + show(c, example) + " = " + name + "(...)`"
    }
    let mut ok = all_known(mut c, e, tp, mut bound, "in this call to '" + name + "'", hint)
    if ok {
        for i in 0..len(tp) {
            check_bounds(mut c, e.line, e.col, "'" + name + "'", tp[i], bound[i])
        }
    }
    if ok {
        note_generic_use(mut c, e, id, bound)
    }
    if id == c.current_fn && ok {
        // f[T] calling f[[T]], which calls f[[[T]]]...: there would be no end
        // to the copies.
        for i in 0..len(tp) {
            if bound[i] != tp[i] {
                report_at(mut c, e, "E3145", "'" + name + "' calls itself with " + show(c, bound[i]) + " for " +
                    types.get(c.table, tp[i]).name + "; a generic function can only call itself with its own type parameters")
                ok = false
                break
            }
        }
    }
    c.targs[e.id] = bound
    let result = partial(mut c, f.result, tp, bound)
    return result
}

// `Tree.Node(1, left, right)`: a variant of a generic enum.
fn generic_variant(c: mut Checker, e: ast.Expr, args: [ast.Expr], decl: Int, vi: Int, expected: Int) -> Int {
    let v = types.get(c.table, decl).variants[vi]
    let written = show(c, decl) + "." + v.name
    let params = types.get(c.table, decl).params
    if len(v.payload) == 0 {
        report_at(mut c, e, "E3146", written + " carries no values; write it without parentheses")
    } else if len(args) != len(v.payload) {
        report_at(mut c, e, "E3147", written + " carries " + plural(len(v.payload), "value") + ", got " + strings.from_int(len(args)))
    }
    let mut labels: [Str] = []
    let mut mutable: [Bool] = []
    for i in 0..len(args) {
        push(mut labels, "value " + strings.from_int(i + 1) + " of " + written)
        push(mut mutable, false)
    }
    let mut known = unknown(len(params))
    from_context(mut c, decl, expected, mut known)
    let mut bound = infer_args(mut c, params, v.payload, args, mutable, labels, known)
    if !all_known(mut c, e, params, mut bound, "in this " + written + "(...)", "; give it a type, as in `let x: " +
        show(c, decl) + "[" + example_args(len(params)) + "] = " + written + "(...)`") {
        return types.ERROR()
    }
    for i in 0..len(params) {
        check_bounds(mut c, e.line, e.col, "'" + show(c, decl) + "'", params[i], bound[i])
    }
    let t = types.instantiate(mut c.table, decl, bound)
    c.refs[e.id] = Ref.Variant(t, vi)
    return t
}

// A call that builds an enum value: `Expr.Add(a, b)`, `Some(x)`.
fn construct(c: mut Checker, e: ast.Expr, args: [ast.Expr], enum: Int, vi: Int, written: Str) {
    c.refs[e.id] = Ref.Variant(enum, vi)
    set_ty(mut c, e, enum)
    let payload = types.get(c.table, enum).variants[vi].payload
    if len(payload) == 0 {
        report_at(mut c, e, "E3148", written + " carries no values; write it without parentheses")
    } else if len(args) != len(payload) {
        report_at(mut c, e, "E3149", written + " carries " + plural(len(payload), "value") + ", got " + strings.from_int(len(args)))
    }
    for i in 0..len(args) {
        if i >= len(payload) {
            infer(mut c, args[i])
            continue
        }
        let want = payload[i]
        check_expr(mut c, args[i], want, msg("value " + strings.from_int(i + 1) + " of " + written + " must be " +
            show(c, want) + ", found ", ""))
    }
}

// What a call calls: a function, a built-in function or variant (by name),
// an enum's variant, or NoRef once the reason is reported.
fn call_target(c: mut Checker, callee: ast.Expr) -> Ref {
    match callee.kind {
        ast.ExprKind.Field(obj, name) => {
            completing(mut c, name, [obj])
            let module = module_named(c, obj)
            if module >= 0 {
                return module_fn(mut c, callee.line, callee.col, module, name)
            }
            let owner = named_receiver(mut c, obj)
            if owner >= 0 {
                let ti = types.get(c.table, owner)
                for m in 0..len(c.modules) {
                    if c.modules[m].name == ti.module && maps.has(c.modules[m].fns, ti.name + "." + name) {
                        if m == c.current { return Ref.Function(c.modules[m].fns[ti.name + "." + name]) }
                        return module_fn(mut c, callee.line, callee.col, m, ti.name + "." + name)
                    }
                }
            }
            let enum = enum_named(mut c, obj)
            if enum == types.ERROR() {
                return Ref.NoRef
            }
            if enum >= 0 {
                let vi = types.variant_index(c.table, enum, name)
                if vi < 0 {
                    report_at(mut c, callee, "E3150", "'" + show(c, enum) + "' has no variant '" + name + "'")
                    return Ref.NoRef
                }
                return Ref.Variant(enum, vi)
            }
            match obj.kind {
                ast.ExprKind.Name(m) => {
                    if lookup_local(c, m) < 0 && !maps.has(module_types(c), m) {
                        // Vela has no methods, so `x.f(...)` can only call into a module.
                        report_at(mut c, obj, "E3151", "unknown module '" + m + "'; is `import " + m + "` missing?")
                        last_fix(mut c, repairs.import_module(c.modules[c.current].source, c.modules[c.current].path, m))
                        return Ref.NoRef
                    }
                }
                _ => {}
            }
            let receiver = value(mut c, obj)
            if receiver == types.ERROR() { return Ref.NoRef }
            if types.is_struct(c.table, receiver) {
                let field = types.field_index(c.table, receiver, name)
                if field >= 0 {
                    let ft = types.get(c.table, receiver).fields[field].ty
                    let method = lookup_method(c.table, c.fns, c.modules, receiver, name)
                    if types.is_func(c.table, ft) || method.fn_id < 0 { return callee_value(mut c, callee) }
                }
            }
            return Ref.Method(receiver, name)
        }
        ast.ExprKind.Name(name) => {
            completing(mut c, name, [])
            let local = lookup_local(c, name)
            if local >= 0 {
                if types.is_func(c.table, c.locals[local].ty) {
                    capture(mut c, local)
                    return Ref.Local(local)  // a call through a function value
                }
                if c.locals[local].ty != types.ERROR() {
                    report_at(mut c, callee, "E3152", "'" + name + "' is a variable of type " + show(c, c.locals[local].ty) +
                        ", not a function")
                }
                return Ref.NoRef
            }
            match maps.get(module_fns(c), name) {
                Some(f) => return Ref.Function(f)
                None => {}
            }
            if is_prelude(name) || is_builtin_variant(name) {
                return Ref.Builtin(name)
            }
            if maps.has(c.modules[c.current].imports, name) {
                report_at(mut c, callee, "E3153", "'" + name + "' is a module; call its functions as " + name + ".name(...)")
                return Ref.NoRef
            }
            if maps.has(module_types(c), name) {
                report_at(mut c, callee, "E3154", "'" + name + "' is a type; build a value with " + name + " { ... }")
                return Ref.NoRef
            }
            if !was_undefined(c, name) {  // first use in this function only
                push(mut c.undefined, name)
                report_at(mut c, callee, "E3155", "undefined function '" + name + "'" + std_hint(c, name))
            }
            return Ref.NoRef
        }
        _ => return callee_value(mut c, callee)
    }
}

// A callee that is an expression, not a name: `p.on_click(...)`,
// `handlers[0](...)`. It can be called if it is a function value.
fn callee_value(c: mut Checker, callee: ast.Expr) -> Ref {
    let t = value(mut c, callee)
    if types.is_func(c.table, t) {
        return Ref.Indirect
    }
    if t != types.ERROR() {
        report_at(mut c, callee, "E3156", "only a function can be called, and this is " + show(c, t))
    }
    return Ref.NoRef
}

// ---- Closures ----

// Whether local `id` belongs to code outside the innermost closure being
// checked: a capture.
fn captured(c: Checker, id: Int) -> Bool {
    let n = len(c.in_closures)
    if n == 0 {
        return false
    }
    for i in c.in_closures[n - 1].boundary..len(c.scopes) {
        for name in maps.keys(c.scopes[i]) {
            if c.scopes[i][name] == id {
                return false
            }
        }
    }
    return true
}

// Record that each closure being checked whose scopes do not hold local
// `id` captures it: an inner closure's capture is one of its outer
// closure's too.
fn capture(c: mut Checker, id: Int) {
    for k in 0..len(c.in_closures) {
        let mut inside = false
        for i in c.in_closures[k].boundary..len(c.scopes) {
            for name in maps.keys(c.scopes[i]) {
                if c.scopes[i][name] == id {
                    inside = true
                }
            }
        }
        if inside {
            continue
        }
        let mut seen = false
        for x in c.in_closures[k].captures {
            if x == id {
                seen = true
            }
        }
        if !seen {
            push(mut c.in_closures[k].captures, id)
        }
    }
}

// Whether `t` can be used for a closure's parameter or result: it says
// nothing about a type parameter still being worked out.
fn known_type(c: Checker, t: Int) -> Bool {
    return t >= 0 && !mentions(c, t, c.pending)
}

// `fn(x: Int) -> Int { ... }` or `fn(x) => x + 1`: a function value that
// copies the variables it uses from around it.
fn closure(c: mut Checker, e: ast.Expr, params: [ast.ClosureParam], result: Option[ast.TypeName], body: ast.Block,
    expected: Int) -> Int {
    let mut want_params: [Int] = []
    let mut want_result = -3
    if expected >= 0 && types.is_func(c.table, expected) && len(types.get(c.table, expected).args) == len(params) {
        want_params = types.get(c.table, expected).args
        if known_type(c, types.get(c.table, expected).result) || types.get(c.table, expected).result == types.NOTHING() {
            want_result = types.get(c.table, expected).result
        }
    }
    let mut scope: Map[Str, Int] = [:]
    let mut locals: [Int] = []
    let mut param_types: [Int] = []
    for i in 0..len(params) {
        let p = params[i]
        let mut t = types.ERROR()
        match p.ty {
            Some(tn) => t = resolve_type(mut c, tn)
            None => {
                if i < len(want_params) && known_type(c, want_params[i]) {
                    t = want_params[i]
                } else {
                    report(mut c, p.line, p.col, "E3157", "cannot tell the type of parameter '" + p.name + "'; write it, as in fn(" +
                        p.name + ": Int) => ...")
                }
            }
        }
        if maps.has(scope, p.name) {
            report(mut c, p.line, p.col, "E3158", "parameter '" + p.name + "' is already declared")
        }
        check_name_allowed(mut c, p.name, p.line, p.col)
        let local = new_local(mut c, p.name, t, "parameter", p.line, p.col)
        scope[p.name] = local
        push(mut locals, local)
        push(mut param_types, t)
    }
    let mut res = want_result
    match result {
        Some(tn) => res = resolve_type(mut c, tn)
        None => {}
    }
    let saved_unsafe = c.unsafe_depth
    c.unsafe_depth = 0
    push(mut c.in_closures, ClosureCtx { id: e.id, boundary: len(c.scopes), captures: [], result: res, effects: [] })
    push_scope(mut c, scope)
    let saved_loops = c.loops
    c.loops = []  // break and continue cannot leave a function value
    for s in body.stmts {
        stmt(mut c, s)
    }
    c.loops = saved_loops
    c.unsafe_depth = saved_unsafe
    pop_scope(mut c)
    let ctx = c.in_closures[len(c.in_closures) - 1]
    c.in_closures = c.in_closures[0..len(c.in_closures) - 1]
    let mut final = ctx.result
    if final == -3 {
        final = types.NOTHING()  // no return said otherwise
    }
    if final != types.NOTHING() && final != types.ERROR() && !terminates_block(c, body) {
        report(mut c, body.end_line, body.end_col, "E3159", "missing return: this function value returns " + show(c, final) +
            ", but the end of its body can be reached")
    }
    c.closures[e.id] = ClosureInfo { params: locals, captures: ctx.captures, result: final }
    return types.func_with(mut c.table, param_types, final, ctx.effects)
}

// `return` inside a closure: against its result type, or deciding it.
fn closure_return(c: mut Checker, s: ast.Stmt, v: Option[ast.Expr]) {
    let n = len(c.in_closures)
    let want = c.in_closures[n - 1].result
    match v {
        None => {
            if want == -3 {
                c.in_closures[n - 1].result = types.NOTHING()
            } else if want != types.NOTHING() && want != types.ERROR() {
                report(mut c, s.line, s.col, "E3160", "this function value returns " + show(c, want) + ", so 'return' needs a value")
            }
        }
        Some(e) => {
            if want == -3 {
                c.in_closures[n - 1].result = value(mut c, e)
            } else if want == types.NOTHING() {
                report_at(mut c, e, "E3161", "this function value does not return a value, so 'return' cannot have one")
                infer(mut c, e)
            } else {
                check_expr(mut c, e, want, msg("this function value returns " + show(c, want) + ", but this is ", ""))
            }
        }
    }
}

// `tasks.map(xs, f)` and `tasks.each(xs, f)`: f on every element of xs, on
// several threads. They are typed as generic functions would be,
// `map[T, R](xs: [T], f: fn(T) -> R) -> [R]` and `each[T](xs: [T], f: fn(T))`:
// xs first, which says what T is, then f, so that a closure gets its
// parameter's type from xs and its result type from its body. What the
// function argument uses, the caller uses.
fn tasks_call(c: mut Checker, e: ast.Expr, name: Str, args: [ast.Expr]) -> Int {
    let is_map = name == "tasks.map"
    let mut nothing = types.NOTHING()
    if is_map {
        nothing = types.ERROR()
    }
    if !arity(mut c, e, name, 2, len(args)) {
        for a in args {
            infer(mut c, a)
        }
        return nothing
    }
    let mut elem = types.ERROR()
    let xs = value(mut c, args[0])
    if types.is_array(c.table, xs) {
        elem = types.get(c.table, xs).args[0]
    } else if xs != types.ERROR() {
        report_at(mut c, args[0], "E3162", "argument 1 of '" + name + "' must be an array, found " + show(c, xs))
    }
    // The function, against fn(T) -> R where R is still to be found.
    let mut result = types.NOTHING()
    let saved_pending = c.pending
    if is_map {
        result = types.param(mut c.table, "R", [], e.line, e.col)
        c.pending = [result]
    }
    c.expected = types.func(mut c.table, [elem], result)
    let f = value(mut c, args[1])
    c.pending = saved_pending
    if f == types.ERROR() {
        return nothing
    }
    use_effects_of(mut c, e, f, "the function given to " + name)
    let ft = types.get(c.table, f)
    let mut takes_elem = types.is_func(c.table, f) && len(ft.args) == 1
    if takes_elem && elem != types.ERROR() && ft.args[0] != types.ERROR() && ft.args[0] != elem {
        takes_elem = false
    }
    if !takes_elem {
        let mut what = "a function taking one value"
        if elem != types.ERROR() {
            what = "a function taking one " + show(c, elem)
        }
        report_at(mut c, args[1], "E3163", "argument 2 of '" + name + "' must be " + what + ", found " + show(c, f))
        return nothing
    }
    if !is_map {
        if ft.result != types.NOTHING() {
            report_at(mut c, args[1], "E3164", "the function given to tasks.each returns " + show(c, ft.result) +
                ", which would be lost; use tasks.map to collect the results")
        }
        return types.NOTHING()
    }
    if ft.result == types.NOTHING() {
        report_at(mut c, args[1], "E3165", "the function given to tasks.map returns nothing, so there are no results to collect; " +
            "use tasks.each")
        return types.ERROR()
    }
    return types.array(mut c.table, ft.result)
}

// A named function used as a value: `lists.map(xs, double)`. A generic one
// takes its type arguments from the function type the context wants.
fn fn_value(c: mut Checker, e: ast.Expr, id: Int, name: Str, expected: Int) -> Int {
    let f = c.fns[id]
    if f.decl.foreign != "" { report_at(mut c, e, "E3205", "an extern function is not a Vela function value; wrap the call in a Vela function"); return types.ERROR() }
    for m in f.mutable {
        if m {
            report_at(mut c, e, "E3166", "'" + name + "' has a mut parameter, so it cannot be used as a value")
            return types.ERROR()
        }
    }
    // Its type says what it uses (M15).
    let mut effects: [Str] = []
    for u in f.decl.effects {
        if types.concrete_effect(u) {
            effects = types.union_effects(effects, [u])
        } else if param_named(f.decl, u) >= 0 {
            report_at(mut c, e, "E3167", "'" + name + "' uses whatever its parameter " + u + " uses, so it cannot be used as a " +
                "value; call it from a closure instead")
            return types.ERROR()
        }
    }
    c.refs[e.id] = Ref.Function(id)
    let tp = f.type_params
    let mut bound = unknown(len(tp))
    if len(tp) > 0 && expected >= 0 && types.is_func(c.table, expected) && known_type(c, expected) {
        let pattern = types.func(mut c.table, f.params, f.result)
        unify(c, pattern, expected, tp, mut bound)
    }
    if len(tp) > 0 {
        let example = example_type(mut c, types.func(mut c.table, f.params, f.result), tp, bound)
        if !all_known(mut c, e, tp, mut bound, "in '" + name + "' used as a value", "; give it a type, as in `let f: " +
            show(c, example) + " = " + name + "`") {
            return types.ERROR()
        }
        for i in 0..len(tp) {
            check_bounds(mut c, e.line, e.col, "'" + name + "'", tp[i], bound[i])
        }
        c.targs[e.id] = bound
        note_generic_use(mut c, e, id, bound)
    }
    let mut params: [Int] = []
    for p in f.params {
        push(mut params, partial(mut c, p, tp, bound))
    }
    let result = partial(mut c, f.result, tp, bound)
    return types.func_with(mut c.table, params, result, effects)
}

// A call through a function value of type `t`.
fn indirect_call(c: mut Checker, e: ast.Expr, t: Int, args: [ast.Expr], through: Str) -> Int {
    let ft = types.get(c.table, t)
    c.refs[e.id] = Ref.Indirect
    use_effects_of(mut c, e, t, through)
    arity(mut c, e, "this function", len(ft.args), len(args))
    for i in 0..len(args) {
        let arg = args[i]
        if i >= len(ft.args) {
            infer(mut c, arg)
            continue
        }
        let want = ft.args[i]
        let m = msg("argument " + strings.from_int(i + 1) + " must be " + show(c, want) + ", found ", "")
        match arg.kind {
            ast.ExprKind.MutArg(p) => {
                report_at(mut c, arg, "E3168", "a function value has no mut parameters; remove `mut`")
                last_fix(mut c, repairs.remove_mut(c.modules[c.current].source, c.modules[c.current].path, arg.line, arg.col))
                check_expr(mut c, p, want, m)
            }
            _ => check_expr(mut c, arg, want, m)
        }
    }
    return ft.result
}

fn arity(c: mut Checker, e: ast.Expr, name: Str, expected: Int, got: Int) -> Bool {
    if got != expected {
        report_at(mut c, e, "E3169", name + " expects " + plural(expected, "argument") + ", got " + strings.from_int(got))
        return false
    }
    return true
}

fn is_printable(t: Int) -> Bool {
    return types.is_integer(t) || t == types.BOOL() || t == types.STR() || t == types.FLOAT()
}

// The built-in functions whose types do not depend on their arguments.
// Their types are made only when they are called, as in Stage 0.
fn has_signature(name: Str) -> Bool {
    return len(name) > 6 && name[0..6] == "files." || name == "os.args" || name == "os.exit" ||
        name == "os.run" || name == "os.env" || name == "os.read_line" || name == "os.read" || name == "os.write" ||
        name == "os.output" || name == "os.executable" ||
        name == "tasks.workers" || name == "math.sqrt" ||
        len(name) > 8 && name[0..8] == "strings."
}

fn signature(c: mut Checker, name: Str) -> [Int] {
    // The parameter types, then the result type last.
    let s = types.STR()
    let b = types.BUILDER()
    let nothing = types.NOTHING()
    if name == "files.read" {
        return [s, types.result(mut c.table, s, s)]
    }
    if name == "files.write" {
        return [s, s, types.result(mut c.table, types.INT(), s)]
    }
    if name == "files.remove" {
        return [s, types.result(mut c.table, types.UNIT(), s)]
    }
    if name == "files.temp_dir" {
        return [types.result(mut c.table, s, s)]
    }
    if name == "os.args" {
        return [types.array(mut c.table, s)]
    }
    if name == "os.run" {
        let command = types.array(mut c.table, s)  // made before the Result, as in Stage 0
        return [command, types.result(mut c.table, types.INT(), s)]
    }
    if name == "os.output" {
        let command = types.array(mut c.table, s)
        return [command, types.result(mut c.table, s, s)]
    }
    if name == "os.env" {
        return [s, types.option(mut c.table, s)]
    }
    if name == "os.read_line" {
        return [types.option(mut c.table, s)]
    }
    if name == "strings.parse_float" {
        return [s, types.option(mut c.table, types.FLOAT())]
    }
    return match name {
        "os.executable" => [s]
        "os.exit" => [types.INT(), nothing]
        "os.read" => [types.INT(), s]
        "tasks.workers" => [types.INT()]
        "math.sqrt" => [types.FLOAT(), types.FLOAT()]
        "os.write" => [s, nothing]
        "strings.builder" => [b]
        "strings.add" => [b, s, nothing]
        "strings.add_byte" => [b, types.BYTE(), nothing]
        "strings.add_int" => [b, types.INT(), nothing]
        "strings.build" => [b, s]
        "strings.from_float" => [types.FLOAT(), s]
        _ => [types.INT(), s]  // strings.from_int
    }
}

fn integer_builtin(c: mut Checker, e: ast.Expr, name: Str, args: [ast.Expr], expected: Int) -> Int {
    let target = integers.type_id(name)
    let mut short = name
    if target < 0 { short = name[5..len(name)] }
    let op = integers.function_op(short)
    let mut count = 2
    if target >= 0 || short == "to_str" || op == 5 { count = 1 }
    if !arity(mut c, e, name, count, len(args)) {
        for a in args { infer(mut c, a) }
        if target >= 0 { return target }
        return types.ERROR()
    }
    let mut context = target
    if target < 0 && types.is_integer(expected) { context = expected }
    if target < 0 && types.is_builtin_enum(c.table, expected) && types.get(c.table, expected).name == "Option" {
        context = types.get(c.table, expected).args[0]
    }
    if types.is_integer(context) && is_int_lit(mut c, args[0]) { c.expected = context }
    let t = value(mut c, args[0])
    if !types.is_integer(t) && t != types.ERROR() {
        report_at(mut c, args[0], "E3184", "integer conversion and arithmetic functions require an integer")
    }
    if target >= 0 { return target }
    if short == "to_str" { return types.STR() }
    if count == 2 { check_expr(mut c, args[1], t, msg("integer operands must have the same type, found ", "")) }
    if integers.mode(short) == 1 { return types.option(mut c.table, t) }
    return t
}

// A call to a built-in function, written as `written`: one of the
// prelude's (`len`) or of a built-in module's (`maps.get`, named by `name`).
fn builtin(c: mut Checker, e: ast.Expr, name: Str, args: [ast.Expr], written: Str, expected: Int) -> Int {
    if len(name) > 6 && (name[0..6] == "sysio." || name[0..6] == "clock.") { return system_builtin(mut c, e, name[6..len(name)], args) }
    if len(name) > 7 && name[0..7] == "memory." { return memory_builtin(mut c, e, name[7..len(name)], args, expected) }
    if len(name) > 2 && name[0..2] == "c." { return c_builtin(mut c, e, name[2..len(name)], args, expected) }
    if integers.type_id(name) >= 0 || len(name) > 5 && name[0..5] == "ints." {
        return integer_builtin(mut c, e, name, args, expected)
    }
    if has_signature(name) {
        return fixed_builtin(mut c, e, name, args, written)
    }
    let mut want = 2
    if name == "print" || name == "os.eprint" || name == "len" || name == "int" || name == "byte" || name == "maps.keys" ||
        name == "assert" || name == "float" {
        want = 1
    }
    if !arity(mut c, e, written, want, len(args)) {
        for a in args {
            infer(mut c, a)
        }
        return match name {
            "print" => types.NOTHING()
            "assert" => types.NOTHING()
            "float" => types.FLOAT()
            "os.eprint" => types.NOTHING()
            "push" => types.NOTHING()
            "maps.remove" => types.NOTHING()
            "len" => types.INT()
            "int" => types.INT()
            "byte" => types.BYTE()
            "maps.has" => types.BOOL()
            _ => types.ERROR()
        }
    }
    if name == "print" || name == "os.eprint" {
        let t = value(mut c, args[0])
        if !is_printable(t) && t != types.ERROR() {
            report_at(mut c, args[0], "E3170", written + " takes an integer, Float, Bool or Str, not " + show(c, t))
        }
        return types.NOTHING()
    }
    if name == "assert" {
        check_expr(mut c, args[0], types.BOOL(), msg("assert takes a Bool, found ", ""))
        return types.NOTHING()
    }
    if name == "len" {
        let t = value(mut c, args[0])
        if !(t == types.STR() || types.sequence(c.table, t) || types.is_map(c.table, t) || t == types.ERROR()) {
            report_at(mut c, args[0], "E3171", "len takes a Str, an array or a map, not " + show(c, t))
        }
        return types.INT()
    }
    if name == "int" {
        let t = value(mut c, args[0])
        if !types.is_integer(t) && t != types.FLOAT() && t != types.ERROR() {
            report_at(mut c, args[0], "E3172", "int takes an integer or a Float, found " + show(c, t))
        }
        return types.INT()
    }
    if name == "float" {
        let t = value(mut c, args[0])
        if !types.is_integer(t) && t != types.ERROR() { report_at(mut c, args[0], "E3093", "float takes an Int, found " + show(c, t)) }
        return types.FLOAT()
    }
    if name == "byte" {
        let t = value(mut c, args[0])
        if !types.is_integer(t) && t != types.ERROR() { report_at(mut c, args[0], "E3093", "byte takes an Int, found " + show(c, t)) }
        return types.BYTE()
    }
    if name == "push" {
        let t = mut_argument(mut c, args[0], types.NOTHING(), "argument 1 of 'push'")
        if types.is_array(c.table, t) {
            let elem = types.get(c.table, t).args[0]
            check_expr(mut c, args[1], elem, msg("the elements of " + show(c, t) + " are " + show(c, elem) + ", but this is ", ""))
        } else {
            if t != types.ERROR() {
                report_at(mut c, args[0], "E3173", "push needs an array, not " + show(c, t))
            }
            infer(mut c, args[1])
        }
        return types.NOTHING()
    }
    // maps.has, maps.get, maps.remove and maps.keys take a map.
    let mut t = types.ERROR()
    if name == "maps.remove" {
        t = mut_argument(mut c, args[0], types.NOTHING(), "argument 1 of '" + written + "'")
    } else {
        t = value(mut c, args[0])
    }
    if !types.is_map(c.table, t) {
        if t != types.ERROR() {
            report_at(mut c, args[0], "E3174", written + " needs a map, not " + show(c, t))
        }
        for a in args[1..len(args)] {
            infer(mut c, a)
        }
        if name == "maps.has" {
            return types.BOOL()
        }
        if name == "maps.remove" {
            return types.NOTHING()
        }
        return types.ERROR()
    }
    let key = types.get(c.table, t).args[0]
    if name == "maps.keys" {
        return types.array(mut c.table, key)
    }
    check_expr(mut c, args[1], key, msg("the keys of " + show(c, t) + " are " + show(c, key) + ", but this is ", ""))
    if name == "maps.has" {
        return types.BOOL()
    }
    if name == "maps.get" {
        return types.option(mut c.table, types.get(c.table, t).args[1])
    }
    return types.NOTHING()
}

fn changes_first(name: Str) -> Bool {
    return name == "strings.add" || name == "strings.add_byte" || name == "strings.add_int"
}

fn fixed_builtin(c: mut Checker, e: ast.Expr, name: Str, args: [ast.Expr], written: Str) -> Int {
    let sig = signature(mut c, name)
    let n = len(sig) - 1
    let result = sig[n]
    if !arity(mut c, e, written, n, len(args)) {
        for a in args {
            infer(mut c, a)
        }
        return result
    }
    for i in 0..n {
        let want = sig[i]
        if i == 0 && changes_first(name) {
            mut_argument(mut c, args[i], want, "argument 1 of '" + written + "'")
        } else {
            check_expr(mut c, args[i], want, msg("argument " + strings.from_int(i + 1) + " of '" + written + "' must be " +
                show(c, want) + ", found ", ""))
        }
    }
    return result
}

// A callee as written: `f`, `lexer.next`, `Expr.Add`.
fn written(callee: ast.Expr) -> Str {
    return match callee.kind {
        ast.ExprKind.Field(obj, name) => written(obj) + "." + name
        ast.ExprKind.Name(name) => name
        _ => "this"
    }
}

// `'x'` or `'p.pos.x'`, for messages about assignments.
fn describe_target(target: ast.Expr) -> Str {
    let mut parts: [Str] = []
    let mut node = target
    for {
        match node.kind {
            ast.ExprKind.Field(obj, name) => {
                push(mut parts, name)
                node = obj
            }
            _ => break
        }
    }
    match node.kind {
        ast.ExprKind.Name(name) => push(mut parts, name)
        _ => {}
    }
    let mut b = strings.builder()
    strings.add_byte(mut b, '\'')
    let mut i = len(parts) - 1
    for i >= 0 {
        strings.add(mut b, parts[i])
        if i > 0 {
            strings.add_byte(mut b, '.')
        }
        i = i - 1
    }
    strings.add_byte(mut b, '\'')
    return strings.build(b)
}

// ---- Terminating statements (Go's rule; see Stage 0) ----

fn terminates_block(c: Checker, b: ast.Block) -> Bool {
    let n = len(b.stmts)
    return n > 0 && terminates(c, b.stmts[n - 1])
}

fn terminates(c: Checker, s: ast.Stmt) -> Bool {
    match s.kind {
        ast.StmtKind.Return(_) => return true
        ast.StmtKind.ExprStmt(e) => {
            match e.kind {
                ast.ExprKind.Call(_, _) => {
                    match c.refs[e.id] {
                        Ref.Builtin(name) => return name == "os.exit"  // it never comes back
                        _ => return false
                    }
                }
                _ => return false
            }
        }
        ast.StmtKind.Block(b) => return terminates_block(c, b)
        ast.StmtKind.If(_, then, otherwise) => {
            match otherwise {
                ast.Else.NoElse => return false
                ast.Else.ElseBlock(b) => return terminates_block(c, then) && terminates_block(c, b)
                ast.Else.ElseIf(s2) => return terminates_block(c, then) && terminates(c, s2)
            }
        }
        ast.StmtKind.For(cond, _) => {
            match cond {
                Some(_) => return false
                None => return !c.breaks[s.id]
            }
        }
        ast.StmtKind.MatchStmt(_, arms) => {
            // Exactly one arm runs, so the match terminates when every arm does.
            if len(arms) == 0 {
                return false
            }
            for a in arms {
                match a.body {
                    ast.ArmBody.Do(body) => {
                        if !terminates(c, body) {
                            return false
                        }
                    }
                    ast.ArmBody.Value(_) => return false
                }
            }
            return true
        }
        ast.StmtKind.Unsafe(body) => return terminates_block(c, body)
        ast.StmtKind.With(_, body) => return terminates_block(c, body)
        _ => return false
    }
}

// ---- Erasure (M15) ----

// The program as the code generators see it: every type without its
// effects (types.erase_all), which only the checker needs.
pub fn erased(k: Checked) -> Checked {
    let mut any = false
    for ti in k.table.types {
        if len(ti.effects) > 0 {
            any = true
            break
        }
    }
    if !any {
        return k
    }
    let mut out = k
    let er = types.erase_all(mut out.table)
    for i in 0..len(out.ty) {
        out.ty[i] = erase_id(er, out.ty[i])
    }
    for i in 0..len(out.fns) {
        for j in 0..len(out.fns[i].params) {
            out.fns[i].params[j] = erase_id(er, out.fns[i].params[j])
        }
        out.fns[i].result = erase_id(er, out.fns[i].result)
    }
    for i in 0..len(out.locals) {
        out.locals[i].ty = erase_id(er, out.locals[i].ty)
    }
    for i in 0..len(out.targs) {
        for j in 0..len(out.targs[i]) {
            out.targs[i][j] = erase_id(er, out.targs[i][j])
        }
    }
    for i in 0..len(out.refs) {
        match out.refs[i] {
            Ref.Variant(t, vi) => out.refs[i] = Ref.Variant(erase_id(er, t), vi)
            _ => {}
        }
    }
    for id in maps.keys(out.closures) {
        let mut info = out.closures[id]
        info.result = erase_id(er, info.result)
        out.closures[id] = info
    }
    return out
}

fn erase_id(er: [Int], t: Int) -> Int {
    if t >= 0 && t < len(er) {
        return er[t]
    }
    return t
}

// ---- Interfaces and coherent method lookup (M20) ----

fn resolve_bound(c: mut Checker, name: Str, line: Int, col: Int) -> Str {
    let mut id = -1
    let mut dot = -1
    for i in 0..len(name) { if name[i] == '.' { dot = i } }
    if dot >= 0 {
        let module = module_in_type(mut c, line, col, name[0..dot])
        if module >= 0 { id = module_type(mut c, line, col, module, name[dot + 1..len(name)]) }
    } else {
        match maps.get(module_types(c), name) { Some(t) => id = t, None => {} }
        if !types.is_interface(c.table, id) {
            for t in c.decls {
                let ti = types.get(c.table, t)
                if ti.module == "<prelude>" && ti.name == name { id = t }
            }
        }
    }
    if !types.is_interface(c.table, id) {
        report(mut c, line, col, "E3009", "unknown interface bound '" + name + "'")
        return name
    }
    return types.interface_name(types.get(c.table, id))
}

fn define_interface(c: mut Checker, id: Int, d: ast.TypeDecl) {
    if len(d.params) > 0 { report(mut c, d.line, d.col, "E3191", "interfaces use Self, not type parameters") }
    for parent in d.parents { push(mut c.table.types[id].bounds, resolve_bound(mut c, parent, d.line, d.col)) }
    let self = types.get(c.table, id).params[0]
    for method in d.methods {
        if method.variadic { report(mut c, method.line, method.col, "E3200", "only extern declarations may be variadic") }
        if len(method.type_params) > 0 || len(method.requires) > 0 || len(method.ensures) > 0 {
            report(mut c, method.line, method.col, "E3191", "interface signatures cannot have type parameters, bodies or contracts")
        }
        let mut params: [Int] = []
        for p in method.params {
            if p.mutable { report(mut c, p.line, p.col, "E3191", "interface parameters are immutable values") }
            push(mut params, resolve_type(mut c, p.ty))
            if d.public { exposes(mut c, p.ty, "interface '" + d.name + "'") }
        }
        if len(params) == 0 || params[0] != self {
            report(mut c, method.line, method.col, "E3191", "an interface method's first parameter must be Self")
        }
        let mut result = types.NOTHING()
        match method.result { Some(t) => { result = resolve_type(mut c, t); if d.public { exposes(mut c, t, "interface '" + d.name + "'") } }, None => {} }
        for effect in method.effects {
            if !types.concrete_effect(effect) { report(mut c, method.line, method.col, "E3191", "interface effects must be fs, os, unsafe, net or clock") }
        }
        if types.field_index(c.table, id, method.name) >= 0 {
            report(mut c, method.line, method.col, "E3192", "duplicate interface method '" + method.name + "'")
        }
        let ft = types.func_with(mut c.table, params, result, method.effects)
        push(mut c.table.types[id].fields, types.FieldInfo { name: method.name, ty: ft })
    }
    c.table.types[id].filled = true
}

fn interface_fields(table: types.Table, id: Int, depth: Int) -> [types.FieldInfo] {
    let mut out: [types.FieldInfo] = []
    let mut queue = [id]
    let mut seen: Map[Int, Bool] = [:]
    let mut i = 0
    for i < len(queue) {
        let current = queue[i]
        i = i + 1
        if current < 0 || maps.has(seen, current) { continue }
        seen[current] = true
        for field in table.types[current].fields { push(mut out, field) }
        for parent in table.types[current].bounds { push(mut queue, types.interface_id(table, parent)) }
    }
    return out
}

fn interface_signature(c: mut Checker, t: Int, name: Str) -> Int {
    let mut found = -1
    for bound in types.get(c.table, t).bounds {
        let id = types.interface_id(c.table, bound)
        for field in interface_fields(c.table, id, 0) {
            if field.name != name { continue }
            // Each inherited method has the Self of its declaring interface.
            let signature = replace_self(mut c.table, field.ty, t)
            if found >= 0 && found != signature { return -2 }
            found = signature
        }
    }
    return found
}

fn replace_self(table: mut types.Table, ft: Int, t: Int) -> Int {
    let mut params: [Int] = []
    let mut args: [Int] = []
    for i in 0..len(table.types) {
        let ti = table.types[i]
        if ti.tag == types.Tag.Interface && len(ti.params) == 1 { push(mut params, ti.params[0]); push(mut args, t) }
    }
    return types.subst(mut table, ft, params, args)
}

pub type Dispatch = struct { fn_id: Int, args: [Int] }

fn method_unify(table: types.Table, pattern: Int, actual: Int, params: [Int], bound: mut [Int]) -> Bool {
    for i in 0..len(params) {
        if pattern == params[i] {
            if bound[i] < 0 { bound[i] = actual }
            return bound[i] == actual
        }
    }
    if pattern == actual { return true }
    if pattern < 0 || actual < 0 { return false }
    let p = types.get(table, pattern)
    let a = types.get(table, actual)
    if p.tag != a.tag || p.origin != a.origin || p.name != a.name || p.module != a.module || len(p.args) != len(a.args) { return false }
    for i in 0..len(p.args) { if !method_unify(table, p.args[i], a.args[i], params, mut bound) { return false } }
    if len(p.args) == 0 { return false }
    return p.result == a.result || method_unify(table, p.result, a.result, params, mut bound)
}

fn lookup_method(table: types.Table, fns: [FnInfo], mods: [modules.Module], t: Int, name: Str) -> Dispatch {
    let empty = Dispatch { fn_id: -1, args: [] }
    if t < 0 { return empty }
    let ti = types.get(table, t)
    if ti.tag != types.Tag.Struct && ti.tag != types.Tag.Enum { return empty }
    let qualified = ti.name + "." + name
    for pass in 0..2 {
        for id in 0..len(fns) {
            let f = fns[id]
            if len(f.params) == 0 { continue }
            let owner = types.get(table, f.params[0]).module
            if owner != ti.module || mods[f.module].name != ti.module { continue }
            if pass == 0 && f.decl.name != qualified || pass == 1 && f.decl.name != name { continue }
            let mut args = unknown(len(f.type_params))
            if !method_unify(table, f.params[0], t, f.type_params, mut args) { continue }
            return Dispatch { fn_id: id, args: args }
        }
    }
    return empty
}

pub fn method(k: Checked, t: Int, name: Str) -> Dispatch { return lookup_method(k.table, k.fns, k.modules, t, name) }

fn intrinsic(table: types.Table, t: Int, bound: Str) -> Bool {
    if bound == "Eq" {
        let ti = types.get(table, t)
        return ti.tag == types.Tag.Prim || ti.tag == types.Tag.Enum && len(ti.args) == 0 && types.c_like(table, t)
    }
    if bound == "Ord" { return types.is_integer(t) || t == types.FLOAT() || t == types.STR() }
    return bound == "Key" && types.is_map_key(t)
}

fn satisfies_depth(c: Checker, t: Int, bound: Str, depth: Int) -> Bool {
    if t == types.ERROR() || types.has_bound(c.table, t, bound) || intrinsic(c.table, t, bound) { return true }
    if types.is_param(c.table, t) || depth > 32 { return false }
    let id = types.interface_id(c.table, bound)
    if id < 0 { return false }
    let ti = types.get(c.table, id)
    let mut table = c.table
    for parent in ti.bounds { if !satisfies_depth(c, t, parent, depth + 1) { return false } }
    for field in ti.fields {
        let dispatch = lookup_method(table, c.fns, c.modules, t, field.name)
        if dispatch.fn_id < 0 {
            let primitive_bound = intrinsic_bound(field.name)
            if primitive_bound == "" || !intrinsic(table, t, primitive_bound) { return false }
            let core = types.interface_id(table, primitive_bound)
            let actual = replace_self(mut table, types.get(table, core).fields[0].ty, t)
            let want = replace_self(mut table, field.ty, t)
            if types.plain(table, actual) != types.plain(table, want) || !types.effects_within(types.effects_of(table, actual), types.effects_of(table, want)) { return false }
            continue
        }
        let f = c.fns[dispatch.fn_id]
        for arg in dispatch.args { if arg < 0 { return false } }
        if !f.decl.public && c.modules[f.module].name != types.get(table, id).module && c.current != f.module { return false }
        for i in 0..len(f.type_params) {
            for need in types.get(table, f.type_params[i]).bounds {
                if !satisfies_depth(c, dispatch.args[i], need, depth + 1) { return false }
            }
        }
        for mutable in f.mutable { if mutable { return false } }
        let want = replace_self(mut table, field.ty, t)
        let actual = types.func_with(mut table, f.params, f.result, f.decl.effects)
        let concrete = types.subst(mut table, actual, f.type_params, dispatch.args)
        // Pure implementations can satisfy signatures permitting effects.
        let a = types.get(table, concrete)
        let b = types.get(table, want)
        if types.plain(table, concrete) != types.plain(table, want) || !types.effects_within(a.effects, b.effects) { return false }
    }
    return true
}

fn key_failure(c: Checker, t: Int) -> Str {
    return "Map key " + show(c, t) + " does not implement Key; " + failed_obligation(c, t, "Key", 0)
}

// Explain only a rejected bound. Keep successful conformance checks allocation
// free of diagnostic text, and use the same lookup/substitution/effect rules.
fn failed_obligation(c: Checker, t: Int, bound: Str, depth: Int) -> Str {
    if types.is_param(c.table, t) { return "type parameter " + show(c, t) + " lacks bound " + bound }
    if depth > 32 { return "interface obligation depth exceeded for " + bound }
    let id = types.interface_id(c.table, bound)
    if id < 0 { return "unknown interface " + bound }
    let ti = types.get(c.table, id)
    for parent in ti.bounds {
        if !satisfies_depth(c, t, parent, depth + 1) {
            return bound + " requires " + parent + ": " + failed_obligation(c, t, parent, depth + 1)
        }
    }
    let mut table = c.table
    let viewpoint = c.modules[c.current].name
    for field in ti.fields {
        let want = replace_self(mut table, field.ty, t)
        let expected = bound + "." + field.name + ": expected " + types.show(table, want, viewpoint)
        let dispatch = lookup_method(table, c.fns, c.modules, t, field.name)
        if dispatch.fn_id < 0 {
            let primitive_bound = intrinsic_bound(field.name)
            if primitive_bound == "" || !intrinsic(table, t, primitive_bound) { return expected + "; method is missing" }
            let core = types.interface_id(table, primitive_bound)
            let actual = replace_self(mut table, types.get(table, core).fields[0].ty, t)
            if types.plain(table, actual) != types.plain(table, want) || !types.effects_within(types.effects_of(table, actual), types.effects_of(table, want)) {
                return expected + "; found intrinsic " + types.show(table, actual, viewpoint)
            }
            continue
        }
        let f = c.fns[dispatch.fn_id]
        for arg in dispatch.args { if arg < 0 { return expected + "; method type arguments cannot be inferred" } }
        if !f.decl.public && c.modules[f.module].name != ti.module && c.current != f.module { return expected + "; method is private" }
        for i in 0..len(f.type_params) {
            for need in types.get(table, f.type_params[i]).bounds {
                if !satisfies_depth(c, dispatch.args[i], need, depth + 1) {
                    return expected + "; method needs " + need + ": " + failed_obligation(c, dispatch.args[i], need, depth + 1)
                }
            }
        }
        let actual = types.func_with(mut table, f.params, f.result, f.decl.effects)
        let concrete = types.subst(mut table, actual, f.type_params, dispatch.args)
        let found = "; found " + types.show(table, concrete, viewpoint)
        for mutable in f.mutable { if mutable { return expected + found + " with a mutable parameter" } }
        if types.plain(table, concrete) != types.plain(table, want) || !types.effects_within(types.effects_of(table, concrete), types.effects_of(table, want)) {
            return expected + found
        }
    }
    return "unsatisfied interface " + bound
}

fn validate_interfaces(c: mut Checker) {
    for f in c.fns {
        if f.is_test { continue }
        c.current = f.module
        let name = f.decl.name
        for i in 0..len(name) {
            if name[i] != '.' { continue }
            let owner = name[0..i]
            if len(f.params) == 0 {
                report(mut c, f.decl.line, f.decl.col, "E3196", "a qualified method needs a receiver parameter")
                continue
            }
            let ti = types.get(c.table, f.params[0])
            if ti.name != owner || ti.module != c.modules[f.module].name || (!types.is_struct(c.table, f.params[0]) && !types.is_enum(c.table, f.params[0])) || f.mutable[0] {
                report(mut c, f.decl.line, f.decl.col, "E3196", "a qualified method must take its local receiver type as an immutable first parameter")
            }
            if types.is_enum(c.table, f.params[0]) && types.variant_index(c.table, f.params[0], name[i + 1..len(name)]) >= 0 {
                report(mut c, f.decl.line, f.decl.col, "E3196", "a method cannot have the name of an enum variant")
            }
        }
    }
    for id in c.decls {
        if !types.is_interface(c.table, id) { continue }
        let ti = types.get(c.table, id)
        for m in 0..len(c.modules) { if c.modules[m].name == ti.module { c.current = m } }
        let mut methods: Map[Str, Int] = [:]
        for field in interface_fields(c.table, id, 0) {
            let signature = replace_self(mut c.table, field.ty, ti.params[0])
            match maps.get(methods, field.name) {
                Some(previous) => {
                    if previous != signature { report(mut c, ti.line, ti.col, "E3192", "conflicting inherited signatures for method '" + field.name + "'") }
                }
                None => methods[field.name] = signature
            }
        }
        for parent in ti.bounds {
            let parent_id = types.interface_id(c.table, parent)
            if ti.public && parent_id >= 0 && !types.get(c.table, parent_id).public {
                report(mut c, ti.line, ti.col, "E3195", "a public interface cannot extend a private interface")
            }
            if types.bound_includes(c.table, parent, types.interface_name(ti), 0) {
                report(mut c, ti.line, ti.col, "E3193", "interface inheritance cycle involving '" + ti.name + "'")
            }
        }
    }
}

fn known_call(c: mut Checker, e: ast.Expr, id: Int, name: Str, args: [ast.Expr], expected: Int) -> Int {
    let f = c.fns[id]
    c.refs[e.id] = Ref.Function(id)
    if len(f.type_params) > 0 {
        let t = generic_call(mut c, e, id, name, args, expected)
        use_call_effects(mut c, e, f, args, name)
        return t
    }
    if f.decl.variadic {
        if len(args) < len(f.params) { arity(mut c, e, name, len(f.params), len(args)) }
    } else { arity(mut c, e, name, len(f.params), len(args)) }
    for i in 0..len(args) {
        let arg = args[i]
        let n = strings.from_int(i + 1)
        if i >= len(f.params) {
            let actual = value(mut c, arg)
            if f.decl.variadic && !c_scalar(actual) { report_at(mut c, arg, "E3203", "a C variadic argument must be a C-compatible scalar") }
            continue
        }
        let want = f.params[i]
        if f.mutable[i] {
            mut_argument(mut c, arg, want, "argument " + n + " of '" + name + "'")
        } else {
            let m = msg("argument " + n + " of '" + name + "' must be " + show(c, want) + ", found ", "")
            match arg.kind {
                ast.ExprKind.MutArg(p) => {
                    report_at(mut c, arg, "E3141", "argument " + n + " of '" + name + "' is not a mut parameter; remove `mut`")
                    last_fix(mut c, repairs.remove_mut(c.modules[c.current].source, c.modules[c.current].path, arg.line, arg.col))
                    check_expr(mut c, p, want, m)
                }
                _ => check_expr(mut c, arg, want, m)
            }
        }
    }
    exclusive(mut c, args)
    use_call_effects(mut c, e, f, args, name)
    // Even after an argument error, the call has the declared result type.
    return f.result
}

fn method_call(c: mut Checker, e: ast.Expr, callee: ast.Expr, args: [ast.Expr], t: Int, name: Str, expected: Int) -> Int {
    let mut all: [ast.Expr] = []
    match callee.kind { ast.ExprKind.Field(obj, _) => push(mut all, obj), _ => {} }
    for arg in args { push(mut all, arg) }
    let mut result = types.ERROR()
    if types.is_param(c.table, t) {
        let signature = interface_signature(mut c, t, name)
        if signature < 0 { report_at(mut c, e, "E3194", "missing or ambiguous interface method '" + name + "'"); return result }
        result = indirect_call(mut c, e, signature, all, "method '" + name + "'")
    } else {
        let dispatch = lookup_method(c.table, c.fns, c.modules, t, name)
        if dispatch.fn_id >= 0 {
            let f = c.fns[dispatch.fn_id]
            if f.module != c.current && !f.decl.public {
                report_at(mut c, e, "E3195", "method '" + name + "' is private to its type's module")
            }
            result = known_call(mut c, e, dispatch.fn_id, name, all, expected)
        } else {
            let bound = intrinsic_bound(name)
            if bound == "" || !intrinsic(c.table, t, bound) {
                report_at(mut c, e, "E3194", "no method '" + name + "' on " + show(c, t))
                for arg in args { infer(mut c, arg) }
                return result
            }
            let id = types.interface_id(c.table, bound)
            let signature = replace_self(mut c.table, types.get(c.table, id).fields[0].ty, t)
            result = indirect_call(mut c, e, signature, all, "method '" + name + "'")
        }
    }
    c.refs[e.id] = Ref.Method(t, name)
    return result
}

fn intrinsic_bound(name: Str) -> Str {
    return match name { "eq" => "Eq", "compare" => "Ord", "hash" => "Key", _ => "" }
}

fn named_receiver(c: mut Checker, e: ast.Expr) -> Int {
    match e.kind {
        ast.ExprKind.Name(name) => {
            if lookup_local(c, name) < 0 {
                match maps.get(module_types(c), name) { Some(t) => return t, None => {} }
            }
        }
        ast.ExprKind.Field(obj, name) => {
            let m = module_named(c, obj)
            if m >= 0 && maps.has(c.modules[m].types, name) { return module_type(mut c, e.line, e.col, m, name) }
        }
        _ => {}
    }
    return -1
}

pub fn method_args(e: ast.Expr, args: [ast.Expr]) -> [ast.Expr] {
    let mut out: [ast.Expr] = []
    match e.kind {
        ast.ExprKind.Call(callee, _) => {
            match callee.kind { ast.ExprKind.Field(obj, _) => push(mut out, obj), _ => {} }
        }
        _ => {}
    }
    for arg in args { push(mut out, arg) }
    return out
}

pub fn method_names(k: Checked, t: Int, module: Int) -> [Str] {
    let mut out: [Str] = []
    let mut seen: Map[Str, Bool] = [:]
    if t < 0 { return out }
    if types.is_param(k.table, t) {
        for bound in types.get(k.table, t).bounds {
            for field in interface_fields(k.table, types.interface_id(k.table, bound), 0) {
                if !maps.has(seen, field.name) { seen[field.name] = true; push(mut out, field.name) }
            }
        }
    } else {
        for id in 0..len(k.fns) {
            let f = k.fns[id]
            if f.module != module && !f.decl.public { continue }
            let mut name = f.decl.name
            for i in 0..len(name) { if name[i] == '.' { name = name[i + 1..len(name)]; break } }
            if maps.has(seen, name) { continue }
            if method(k, t, name).fn_id == id { seen[name] = true; push(mut out, name) }
        }
        for name in ["eq", "compare", "hash"] {
            if intrinsic(k.table, t, intrinsic_bound(name)) && !maps.has(seen, name) { push(mut out, name) }
        }
    }
    return out
}

fn public_bounds(c: mut Checker, params: [Int], line: Int, col: Int) {
    for param in params {
        for bound in types.get(c.table, param).bounds {
            let id = types.interface_id(c.table, bound)
            if id >= 0 && !types.get(c.table, id).public { report(mut c, line, col, "E3195", "a public declaration cannot require a private interface") }
        }
    }
}

// ---- C ABI declarations and raw operations (M21) ----
pub fn c_scalar(t: Int) -> Bool {
    return types.is_integer(t) || t == types.FLOAT() || t == types.BOOL() || cffi.pointer(t)
}

fn validate_foreign(c: mut Checker, id: Int) {
    let f = c.fns[id]
    if f.decl.foreign == "" {
        if f.decl.variadic { report(mut c, f.decl.line, f.decl.col, "E3200", "only extern declarations may be variadic") }
        return
    }
    let d = f.decl
    if !cffi.symbol(d.foreign) || d.name == "main" || len(d.type_params) > 0 || len(d.requires) > 0 || len(d.ensures) > 0 {
        report(mut c, d.line, d.col, "E3200", "an extern needs a C symbol and a monomorphic signature without contracts; use a Vela wrapper")
    }
    let mut unsafe = false
    for effect in d.effects { if effect == "unsafe" { unsafe = true } }
    if !unsafe {
        report(mut c, d.line, d.col, "E3201", "every extern declaration must say uses unsafe")
        last_fix(mut c, repairs.effect(c.modules[c.current].source, c.modules[c.current].path, d, "unsafe"))
    }
    for i in 0..len(f.params) {
        if !c_scalar(f.params[i]) && f.params[i] != types.ERROR() {
            report(mut c, d.params[i].line, d.params[i].col, "E3203", "a C parameter must be a scalar or raw pointer; pass aggregates through c.Ptr")
        }
    }
    if f.result != types.NOTHING() && f.result != types.ERROR() && !c_scalar(f.result) {
        report(mut c, d.line, d.col, "E3203", "a C result must be a scalar or raw pointer; return aggregates through a pointer")
    }
    if d.variadic && len(d.params) == 0 { report(mut c, d.line, d.col, "E3200", "a C variadic declaration needs a fixed parameter before ...") }
}

fn c_builtin(c: mut Checker, e: ast.Expr, name: Str, args: [ast.Expr], expected: Int) -> Int {
    if cffi.hazardous(name) { use_effect(mut c, e, "unsafe", "c." + name) }
    let ptr = cffi.PTR()
    let mut count = 1
    if name == "null" || name == "null_fn" { count = 0 }
    if name == "bytes" || name == "store" || name == "offset" || name == "store_float32" { count = 2 }
    if !arity(mut c, e, "c." + name, count, len(args)) {
        for arg in args { infer(mut c, arg) }
        return types.ERROR()
    }
    if name == "null" { return ptr }
    if name == "null_fn" { return cffi.FN() }
    if name == "addr" {
        match args[0].kind {
            ast.ExprKind.MutArg(place) => {
                let t = infer(mut c, place)
                if !c_scalar(t) { report_at(mut c, place, "E3203", "c.addr needs a mutable scalar place") }
                mut_argument(mut c, args[0], t, "c.addr")
                match path_of(c, place) { Some(path) => c.escaped[path.local] = true, None => {} }
            }
            _ => { infer(mut c, args[0]); report_at(mut c, args[0], "E3204", "write c.addr(mut value) for a scalar address") }
        }
        return ptr
    }
    if name == "callback" {
        match call_target(mut c, args[0]) {
            Ref.Function(id) => {
                let f = c.fns[id]
                if len(f.type_params) > 0 || f.decl.variadic || f.result != types.NOTHING() && !c_scalar(f.result) {
                    report_at(mut c, args[0], "E3205", "c.callback needs a monomorphic C-compatible top-level function")
                }
                for i in 0..len(f.params) {
                    if !c_scalar(f.params[i]) || f.mutable[i] { report_at(mut c, args[0], "E3205", "a callback parameter must be an immutable C-compatible scalar") }
                }
                let mut effects: [Str] = []
                for effect in f.decl.effects { if types.concrete_effect(effect) { push(mut effects, effect); use_effect(mut c, e, effect, "callback '" + f.decl.name + "'") } }
                c.refs[args[0].id] = Ref.Function(id)
                c.ty[args[0].id] = types.func_with(mut c.table, f.params, f.result, effects)
            }
            _ => report_at(mut c, args[0], "E3205", "c.callback accepts a top-level function, not a closure or function variable")
        }
        return cffi.FN()
    }
    if name == "is_null" || name == "address" {
        let t = value(mut c, args[0])
        if !cffi.pointer(t) && t != types.ERROR() { report_at(mut c, args[0], "E3203", "c." + name + " needs c.Ptr or c.Fn") }
        if name == "is_null" { return types.BOOL() }
        return 13
    }
    if name == "from_address" {
        check_expr(mut c, args[0], 13, msg("c.from_address needs u64, found ", ""))
        return ptr
    }
    if name == "float32" {
        check_expr(mut c, args[0], types.FLOAT(), msg("c.float32 needs Float, found ", ""))
        return types.FLOAT()
    }
    if name == "data" {
        let t = value(mut c, args[0])
        if t != types.STR() && !types.is_array(c.table, t) && t != types.ERROR() { report_at(mut c, args[0], "E3203", "c.data needs Str or a growable array") }
        return ptr
    }
    if name == "cstr" {
        check_expr(mut c, args[0], types.STR(), msg("c." + name + " needs Str, found ", ""))
        return ptr
    }
    if name == "alloc" {
        check_expr(mut c, args[0], types.INT(), msg("c.alloc needs an Int size, found ", ""))
        return ptr
    }
    check_expr(mut c, args[0], ptr, msg("c." + name + " needs c.Ptr, found ", ""))
    if name == "bytes" || name == "offset" {
        check_expr(mut c, args[1], types.INT(), msg("c." + name + " needs an Int count, found ", ""))
        if name == "bytes" { return types.STR() }
        return ptr
    }
    if name == "string" { return types.STR() }
    if name == "load_float32" { return types.FLOAT() }
    if name == "load" {
        if !c_scalar(expected) { report_at(mut c, e, "E3204", "give c.load a scalar result type, as in let n: c.Int = c.load(ptr)"); return types.ERROR() }
        return expected
    }
    if name == "store_float32" { check_expr(mut c, args[1], types.FLOAT(), msg("c.store_float32 needs Float, found ", "")); return types.NOTHING() }
    if name == "store" {
        let t = value(mut c, args[1])
        if !c_scalar(t) && t != types.ERROR() { report_at(mut c, args[1], "E3203", "c.store needs a C-compatible scalar value") }
    }
    return types.NOTHING()
}

fn memory_builtin(c: mut Checker, e: ast.Expr, name: Str, args: [ast.Expr], expected: Int) -> Int {
    let mut count = 1
    if name == "fill" || name == "truncate" || name == "signed" { count = 2 }
    if name == "read" { count = 4 }
    if name == "write" { count = 5 }
    if !arity(mut c, e, "memory." + name, count, len(args)) { for arg in args { infer(mut c, arg) }; return types.ERROR() }
    if name == "reserve" || name == "fill" {
        check_expr(mut c, args[0], types.INT(), msg("capacity must be Int, found ", ""))
        if name == "reserve" {
            if !types.is_array(c.table, expected) { report_at(mut c, e, "E3213", "give memory.reserve a growable array result type"); return types.ERROR() }
            return expected
        }
        let mut elem = types.ERROR()
        if types.is_array(c.table, expected) { elem = types.get(c.table, expected).args[0]; check_expr(mut c, args[1], elem, msg("fill element type mismatch: ", "")) } else { elem = value(mut c, args[1]) }
        return types.array(mut c.table, elem)
    }
    if name == "bits" { check_expr(mut c, args[0], types.INT(), msg("memory.bits needs Int, found ", "")); return 13 }
    if name == "signed" { check_expr(mut c, args[0], 13, msg("memory.signed needs u64, found ", "")); check_expr(mut c, args[1], types.INT(), msg("bit width must be Int, found ", "")); return types.INT() }
    if name == "from_str" { check_expr(mut c, args[0], types.STR(), msg("memory.from_str needs Str, found ", "")); return types.array(mut c.table, types.BYTE()) }
    let mut place = args[0]
    if name == "truncate" || name == "write" { match place.kind { ast.ExprKind.MutArg(p) => place = p, _ => {} } }
    let actual = value(mut c, place)
    let mut elem = types.ERROR()
    if types.is_array(c.table, actual) { elem = types.get(c.table, actual).args[0] }
    if name == "truncate" || name == "write" { mut_argument(mut c, args[0], actual, "memory." + name) }
    if name == "truncate" {
        if !types.is_array(c.table, actual) && actual != types.ERROR() { report_at(mut c, args[0], "E3213", "memory.truncate needs a growable array") }
        check_expr(mut c, args[1], types.INT(), msg("new length must be Int, found ", ""))
        return types.NOTHING()
    }
    if elem != types.BYTE() && !(name == "read" && actual == types.STR()) && actual != types.ERROR() { report_at(mut c, args[0], "E3213", "byte storage must be [u8], or Str for a read") }
    if name == "to_str" { return types.STR() }
    check_expr(mut c, args[1], types.INT(), msg("byte offset must be Int, found ", ""))
    check_expr(mut c, args[2], types.INT(), msg("byte width must be Int, found ", ""))
    check_expr(mut c, args[3], types.BOOL(), msg("byte order must be Bool, found ", ""))
    if name == "write" { check_expr(mut c, args[4], 13, msg("stored bits must be u64, found ", "")); return types.NOTHING() }
    return 13
}

fn validate_fixed(c: mut Checker) {
    for id in c.table.instances {
        if !types.is_fixed(c.table, id) || types.is_open(c.table, id) || types.get(c.table, id).length == 0 { continue }
        let elem = types.get(c.table, id).args[0]
        let mut queue = [elem]
        let mut seen: Map[Int, Bool] = [:]
        let mut i = 0
        for i < len(queue) {
            let t = queue[i]; i = i + 1
            if t == id {
                let info = types.get(c.table, elem)
                let mut module = 0
                for m in 0..len(c.modules) { if c.modules[m].name == info.module { module = m } }
                c.current = module
                report(mut c, info.line, info.col, "E3212", "a fixed array cannot participate in a recursive by-value layout")
                break
            }
            if maps.has(seen, t) { continue }
            seen[t] = true
            let info = types.get(c.table, t)
            if info.tag == types.Tag.Struct { for field in info.fields { push(mut queue, field.ty) } }
            if info.tag == types.Tag.Enum { for variant in info.variants { for value in variant.payload { push(mut queue, value) } } }
        }
    }
}

fn system_type(c: mut Checker, tag: Int) -> Int {
    return match tag { 1 => types.INT(), 2 => types.STR(), 3 => types.BOOL(), 4 => types.HANDLE(), 5 => types.array(mut c.table, types.STR()), _ => types.UNIT() }
}
fn system_builtin(c: mut Checker, e: ast.Expr, name: Str, args: [ast.Expr]) -> Int {
    use_effect(mut c, e, sysops.effect(name), name)
    let ps = sysops.params(name)
    if !arity(mut c, e, name, len(ps), len(args)) { for arg in args { infer(mut c, arg) }; return types.ERROR() }
    for i in 0..len(args) { check_expr(mut c, args[i], system_type(mut c, ps[i]), msg("systems argument must be " + sysops.type_text(ps[i]) + ", found ", "")) }
    return types.result(mut c.table, system_type(mut c, sysops.result(name)), types.STR())
}
