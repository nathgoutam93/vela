// Vela's types. Rather than an object for each
// type, a type is a number, its index in a Table, so types compare
// with == like any Int.
//
// The built-in types have fixed numbers (ERROR, INT, ...). User structs and
// enums are added as their declarations are read. Option, Result, array
// and map types are interned: asked for the same arguments twice, the
// table gives back the same number. The table remembers the order in which
// they were first asked for, because the C code generator defines them in
// that order, and its output must not depend on anything else.
//
// Generics (M10a). A type parameter, the `T` of `fn first[T]` or `type
// Pair[A, B]`, is a type of its own (tag Param). A generic struct or enum is
// declared once, with its parameters in `params`; each use with arguments,
// `Pair[Int, Str]`, is an instance: a struct or enum of its own, interned
// like Option, whose `origin` is the declaration and whose fields or
// variants are the declaration's with the arguments put in. A type that
// mentions a parameter anywhere is "open"; only closed types reach C.
import maps
import integers
import strings

pub type Tag = enum {
    Error
    Prim  // Int, Byte, Bool, Str, Unit
    Std  // strings.Builder
    Array
    Map
    Struct
    Enum  // a user enum, or Option / Result (which have args)
    Param  // a type parameter
    Func  // a function type, fn(Int) -> Str: its parameter types in args
    Interface  // compile-time signatures in fields, Self in params, parents in bounds
}

pub type Variant = struct {
    name: Str
    payload: [Int]
}

pub type FieldInfo = struct {
    name: Str
    ty: Int
}

pub type TypeInfo = struct {
    tag: Tag
    length: Int  // fixed arrays, otherwise -1
    name: Str  // "Int", the user's name, "Option" or "Result"
    module: Str  // the module a user type is declared in; "" for the main one
    public: Bool
    line: Int
    col: Int
    args: [Int]  // Option[T]: [T]; Result[T, E]: [T, E]; [T]: [T]; Map[K, V]: [K, V]
    fields: [FieldInfo]  // a struct's, in declaration order
    variants: [Variant]  // an enum's, in order: the index is the C tag
    params: [Int]  // a generic declaration's type parameters
    bounds: [Str]  // a type parameter's bounds: "Eq", "Ord", "Key"
    origin: Int  // an instance's generic declaration; -1 for anything else
    open: Bool  // mentions a type parameter
    filled: Bool  // a generic declaration: its fields or variants are known; an instance: they are put in
    result: Int  // a function type's result type; NOTHING() when it returns nothing
    // A function type's effects (M15), sorted: "fs", "os", or "@f" for
    // whatever the parameter f of the function being checked uses.
    effects: [Str]
    plain: Int  // for a function type with effects, the same type without them; -1 otherwise
}

pub type Table = struct {
    types: [TypeInfo]
    index: Map[Str, Int]  // interned types by a key such as "Option 4"
    instances: [Int]  // Option, Result and generic instances, in the order first asked for
    arrays: [Int]  // the element type of each array type, likewise
    maps: [Int]  // key and value of each map type, likewise, two per map
}

pub fn ERROR() -> Int {
    return 0
}

pub fn INT() -> Int {
    return 1
}

pub fn BYTE() -> Int {
    return 2
}

pub fn BOOL() -> Int {
    return 3
}

pub fn STR() -> Int {
    return 4
}

pub fn UNIT() -> Int {
    return 5
}

pub fn BUILDER() -> Int {
    return 6
}

pub fn FLOAT() -> Int {
    return 7
}

// The "type" of a call that returns nothing.
pub fn NOTHING() -> Int {
    return -1
}

fn info(tag: Tag, name: Str) -> TypeInfo {
    return TypeInfo {
        tag: tag, length: -1, name: name, module: "", public: true, line: 0, col: 0, args: [], fields: [], variants: [],
        params: [], bounds: [], origin: -1, open: false, filled: false, result: -1, effects: [], plain: -1,
    }
}

pub fn new_table() -> Table {
    let mut t = Table { types: [], index: [:], instances: [], arrays: [], maps: [] }
    push(mut t.types, info(Tag.Error, "<error>"))
    for name in ["Int", "Byte", "Bool", "Str", "Unit"] {
        push(mut t.types, info(Tag.Prim, name))
    }
    let mut builder = info(Tag.Std, "Builder")
    builder.module = "strings"
    push(mut t.types, builder)
    push(mut t.types, info(Tag.Prim, "Float"))
    for name in ["i8", "i16", "i32", "u16", "u32", "u64"] {
        push(mut t.types, info(Tag.Prim, name))
    }
    push(mut t.types, info(Tag.Prim, "c.Ptr"))
    push(mut t.types, info(Tag.Prim, "c.Fn"))
    let mut handle = info(Tag.Std, "Handle")
    handle.module = "sysio"
    push(mut t.types, handle)
    return t
}

pub fn HANDLE() -> Int { return 16 }

pub fn is_integer(t: Int) -> Bool { return integers.width(t) > 0 }
pub fn integer_width(t: Int) -> Int { return integers.width(t) }
pub fn integer_signed(t: Int) -> Bool { return integers.signed(t) }

// The built-in types by name, or -1.
pub fn primitive(name: Str) -> Int {
    let fixed = integers.type_id(name)
    if fixed >= 0 { return fixed }
    return match name {
        "Int" => INT()
        "Byte" => BYTE()
        "Bool" => BOOL()
        "Str" => STR()
        "Unit" => UNIT()
        "Float" => FLOAT()
        _ => -1
    }
}

// The built-in generic types and how many type arguments each takes, or -1.
pub fn generic_arity(name: Str) -> Int {
    return match name {
        "Option" => 1
        "Result" => 2
        "Map" => 2
        _ => -1
    }
}

pub fn is_map_key(t: Int) -> Bool {
    return is_integer(t) || t == BOOL() || t == STR()
}

// A new user struct or enum; its fields or variants are filled in later.
pub fn add_user(table: mut Table, is_struct: Bool, name: Str, module: Str, public: Bool, line: Int,
    col: Int) -> Int {
    let mut t = info(Tag.Enum, name)
    if is_struct {
        t.tag = Tag.Struct
    }
    t.module = module
    t.public = public
    t.line = line
    t.col = col
    push(mut table.types, t)
    return len(table.types) - 1
}

fn key(name: Str, args: [Int]) -> Str {
    let mut b = strings.builder()
    strings.add(mut b, name)
    for a in args {
        strings.add_byte(mut b, ' ')
        strings.add_int(mut b, a)
    }
    return strings.build(b)
}

pub fn array(table: mut Table, elem: Int) -> Int {
    if elem == ERROR() {
        return ERROR()
    }
    let k = key("[]", [elem])
    match maps.get(table.index, k) {
        Some(t) => return t
        None => {}
    }
    let mut t = info(Tag.Array, "[]")
    t.args = [elem]
    t.open = table.types[elem].open
    push(mut table.types, t)
    let id = len(table.types) - 1
    table.index[k] = id
    push(mut table.arrays, elem)
    return id
}

// Fixed arrays use the normal inline struct layout and ownership machinery.
pub fn is_fixed(table: Table, t: Int) -> Bool { return t >= 0 && table.types[t].module == "@fixed" }
pub fn sequence(table: Table, t: Int) -> Bool { return is_array(table, t) || is_fixed(table, t) }
pub fn fixed(table: mut Table, elem: Int, length: Int) -> Int {
    if elem == ERROR() { return ERROR() }
    let k = key("fixed " + strings.from_int(length), [elem])
    match maps.get(table.index, k) { Some(t) => return t, None => {} }
    let mut t = info(Tag.Struct, "Fixed" + strings.from_int(length))
    t.module = "@fixed"
    t.length = length
    t.args = [elem]
    t.open = table.types[elem].open
    t.filled = true
    for i in 0..length { push(mut t.fields, FieldInfo { name: "_" + strings.from_int(i), ty: elem }) }
    if length == 0 { push(mut t.fields, FieldInfo { name: "_empty", ty: UNIT() }) }
    push(mut table.types, t)
    let id = len(table.types) - 1
    table.index[k] = id
    push(mut table.instances, id)
    return id
}

pub fn map(table: mut Table, k: Int, v: Int) -> Int {
    if k == ERROR() || v == ERROR() {
        return ERROR()
    }
    let name = key("Map", [k, v])
    match maps.get(table.index, name) {
        Some(t) => return t
        None => {}
    }
    let mut t = info(Tag.Map, "Map")
    t.args = [k, v]
    t.open = table.types[k].open || table.types[v].open
    push(mut table.types, t)
    let id = len(table.types) - 1
    table.index[name] = id
    push(mut table.maps, k)
    push(mut table.maps, v)
    return id
}

// `fn(params) -> result`, interned; `result` is NOTHING() for a function
// that returns nothing.
pub fn func(table: mut Table, params: [Int], result: Int) -> Int {
    return func_with(mut table, params, result, [])
}

fn func_key(params: [Int], result: Int, effects: [Str]) -> Str {
    let mut k = key("fn " + strings.from_int(result), params)
    if len(effects) > 0 {
        k = k + " uses"
        for e in effects {
            k = k + " " + e
        }
    }
    return k
}

// `fn(params) -> result uses effects` (M15): `effects` sorted, without
// repeats. Effects are the checker's alone: the same type without them,
// `plain`, is what the code generators lay out.
pub fn func_with(table: mut Table, params: [Int], result: Int, effects: [Str]) -> Int {
    if len(effects) > 0 {
        let k = func_key(params, result, effects)
        match maps.get(table.index, k) {
            Some(t) => return t
            None => {}
        }
        let base = func(mut table, params, result)
        let mut t = table.types[base]
        t.effects = effects
        t.plain = base
        push(mut table.types, t)
        let id = len(table.types) - 1
        table.index[k] = id
        return id
    }
    for p in params {
        if p == ERROR() {
            return ERROR()
        }
    }
    if result == ERROR() {
        return ERROR()
    }
    let k = func_key(params, result, [])
    match maps.get(table.index, k) {
        Some(t) => return t
        None => {}
    }
    let mut t = info(Tag.Func, "fn")
    t.args = params
    t.result = result
    t.open = any_open(table, params) || result >= 0 && table.types[result].open
    push(mut table.types, t)
    let id = len(table.types) - 1
    table.index[k] = id
    return id
}

pub fn is_func(table: Table, t: Int) -> Bool {
    return t >= 0 && table.types[t].tag == Tag.Func
}

// The effects of a function type; none for any other type.
pub fn effects_of(table: Table, t: Int) -> [Str] {
    if t < 0 {
        return []
    }
    return table.types[t].effects
}

// A function type without its effects; any other type as it is.
pub fn plain(table: Table, t: Int) -> Int {
    if t >= 0 && table.types[t].plain >= 0 {
        return table.types[t].plain
    }
    return t
}

// The effect that stands for what the parameter `name` uses.
pub fn effect_var(name: Str) -> Str {
    return "@" + name
}

pub fn is_effect_var(e: Str) -> Bool {
    return len(e) > 0 && e[0] == '@'
}

// The effects of both, sorted, without repeats.
pub fn union_effects(a: [Str], b: [Str]) -> [Str] {
    let mut out = a
    for e in b {
        let mut have = false
        for x in out {
            if x == e {
                have = true
            }
        }
        if !have {
            // Insertion in order.
            let mut i = len(out)
            push(mut out, e)
            for i > 0 && out[i - 1] > e {
                out[i] = out[i - 1]
                i = i - 1
            }
            out[i] = e
        }
    }
    return out
}

// Whether every effect of `a` is one of `b`'s.
pub fn effects_within(a: [Str], b: [Str]) -> Bool {
    for e in a {
        let mut found = false
        for x in b {
            if x == e {
                found = true
            }
        }
        if !found {
            return false
        }
    }
    return true
}

pub fn option(table: mut Table, t: Int) -> Int {
    return instance(mut table, "Option", [t])
}

pub fn result(table: mut Table, t: Int, e: Int) -> Int {
    return instance(mut table, "Result", [t, e])
}

pub fn instance(table: mut Table, name: Str, args: [Int]) -> Int {
    for a in args {
        if a == ERROR() {
            return ERROR()
        }
    }
    let k = key(name, args)
    match maps.get(table.index, k) {
        Some(t) => return t
        None => {}
    }
    let mut t = info(Tag.Enum, name)
    t.args = args
    t.open = any_open(table, args)
    t.filled = true
    if name == "Option" {
        t.variants = [Variant { name: "None", payload: [] }, Variant { name: "Some", payload: [args[0]] }]
    } else {
        t.variants = [Variant { name: "Ok", payload: [args[0]] }, Variant { name: "Err", payload: [args[1]] }]
    }
    push(mut table.types, t)
    let id = len(table.types) - 1
    table.index[k] = id
    push(mut table.instances, id)
    return id
}

pub fn get(table: Table, t: Int) -> TypeInfo {
    return table.types[t]
}

pub fn is_enum(table: Table, t: Int) -> Bool {
    return t >= 0 && table.types[t].tag == Tag.Enum
}

pub fn is_struct(table: Table, t: Int) -> Bool {
    return t >= 0 && table.types[t].tag == Tag.Struct
}

pub fn is_array(table: Table, t: Int) -> Bool {
    return t >= 0 && table.types[t].tag == Tag.Array
}

pub fn is_map(table: Table, t: Int) -> Bool {
    return t >= 0 && table.types[t].tag == Tag.Map
}

// Option and Result, which have type arguments and are not instances of a
// user's generic enum.
pub fn is_builtin_enum(table: Table, t: Int) -> Bool {
    return is_enum(table, t) && len(table.types[t].args) > 0 && table.types[t].origin < 0
}

pub fn is_param(table: Table, t: Int) -> Bool {
    return t >= 0 && table.types[t].tag == Tag.Param
}

pub fn is_open(table: Table, t: Int) -> Bool {
    return t >= 0 && table.types[t].open
}

pub fn is_generic(table: Table, t: Int) -> Bool {
    return t >= 0 && len(table.types[t].params) > 0
}

fn any_open(table: Table, ts: [Int]) -> Bool {
    for t in ts {
        if table.types[t].open {
            return true
        }
    }
    return false
}

// Whether `t` is `p` or is built from it (`[p]`, `Map[Str, p]`, `fn(p) -> Int`).
pub fn mentions(table: Table, t: Int, p: Int) -> Bool {
    if t == p {
        return true
    }
    if t < 0 {
        return false
    }
    if table.types[t].result >= 0 && mentions(table, table.types[t].result, p) {
        return true
    }
    for a in table.types[t].args {
        if mentions(table, a, p) {
            return true
        }
    }
    return false
}

// How deeply `t` nests: 1 for Int, 2 for [Int], 3 for Option[[Int]].
pub fn depth(table: Table, t: Int) -> Int {
    let mut deepest = 0
    if table.types[t].result >= 0 {
        deepest = depth(table, table.types[t].result)
    }
    for a in table.types[t].args {
        let d = depth(table, a)
        if d > deepest {
            deepest = d
        }
    }
    return deepest + 1
}

// A new type parameter.
pub fn param(table: mut Table, name: Str, bounds: [Str], line: Int, col: Int) -> Int {
    let mut t = info(Tag.Param, name)
    t.bounds = bounds
    t.line = line
    t.col = col
    t.open = true
    push(mut table.types, t)
    return len(table.types) - 1
}

pub fn has_bound(table: Table, t: Int, bound: Str) -> Bool {
    if !is_param(table, t) {
        return false
    }
    for b in table.types[t].bounds {
        if bound_includes(table, b, bound, 0) {
            return true
        }
    }
    return false
}

pub fn interface_id(table: Table, name: Str) -> Int {
    for i in 0..len(table.types) {
        let ti = table.types[i]
        if ti.tag == Tag.Interface && interface_name(ti) == name { return i }
    }
    return -1
}

pub fn interface_name(ti: TypeInfo) -> Str {
    if ti.module == "" || ti.module == "<prelude>" { return ti.name }
    return ti.module + "." + ti.name
}

pub fn bound_includes(table: Table, actual: Str, want: Str, depth: Int) -> Bool {
    let mut queue = [actual]
    let mut seen: Map[Str, Bool] = [:]
    let mut i = 0
    for i < len(queue) {
        let name = queue[i]
        i = i + 1
        if name == want { return true }
        if maps.has(seen, name) { continue }
        seen[name] = true
        let id = interface_id(table, name)
        if id >= 0 { for parent in table.types[id].bounds { push(mut queue, parent) } }
    }
    return false
}

pub fn is_interface(table: Table, t: Int) -> Bool {
    return t >= 0 && table.types[t].tag == Tag.Interface
}

// `decl[args]`, a generic struct or enum with its parameters filled in.
pub fn instantiate(table: mut Table, decl: Int, args: [Int]) -> Int {
    for a in args {
        if a == ERROR() {
            return ERROR()
        }
    }
    let k = key("inst " + strings.from_int(decl), args)
    match maps.get(table.index, k) {
        Some(t) => return t
        None => {}
    }
    let d = table.types[decl]
    let mut t = info(d.tag, d.name)
    t.module = d.module
    t.public = d.public
    t.line = d.line
    t.col = d.col
    t.args = args
    t.origin = decl
    t.open = any_open(table, args)
    push(mut table.types, t)
    let id = len(table.types) - 1
    table.index[k] = id
    push(mut table.instances, id)
    if d.filled {
        fill(mut table, id)
    }
    return id
}

// Put an instance's arguments into its declaration's fields or variants.
fn fill(table: mut Table, inst: Int) {
    let decl = table.types[inst].origin
    let params = table.types[decl].params
    let args = table.types[inst].args
    table.types[inst].filled = true  // before the fields, which may lead back here
    let mut fields: [FieldInfo] = []
    for f in table.types[decl].fields {
        push(mut fields, FieldInfo { name: f.name, ty: subst(mut table, f.ty, params, args) })
    }
    let mut variants: [Variant] = []
    for v in table.types[decl].variants {
        let mut payload: [Int] = []
        for p in v.payload {
            push(mut payload, subst(mut table, p, params, args))
        }
        push(mut variants, Variant { name: v.name, payload: payload })
    }
    table.types[inst].fields = fields
    table.types[inst].variants = variants
}

// Fill in the instances made before their declarations' fields were known.
pub fn fill_instances(table: mut Table) {
    let mut i = 0
    for i < len(table.instances) {
        let t = table.instances[i]
        let o = table.types[t].origin
        if o >= 0 && !table.types[t].filled && table.types[o].filled {
            fill(mut table, t)
        }
        i = i + 1
    }
}

// `subst` for a type that already exists, without a mutable table: for the
// code generator, after every type the program needs has been made.
pub fn find_subst(table: Table, t: Int, params: [Int], args: [Int]) -> Int {
    if t < 0 || !table.types[t].open || len(params) == 0 {
        return t
    }
    let ti = table.types[t]
    if ti.tag == Tag.Param {
        for i in 0..len(params) {
            if params[i] == t {
                return args[i]
            }
        }
        return t
    }
    let mut new_args: [Int] = []
    for a in ti.args {
        push(mut new_args, find_subst(table, a, params, args))
    }
    if is_fixed(table, t) { return table.index[key("fixed " + strings.from_int(ti.length), new_args)] }
    if ti.tag == Tag.Array {
        return table.index[key("[]", new_args)]
    }
    if ti.tag == Tag.Func {
        let r = find_subst(table, ti.result, params, args)
        return table.index[func_key(new_args, r, ti.effects)]
    }
    if ti.origin >= 0 {
        return table.index[key("inst " + strings.from_int(ti.origin), new_args)]
    }
    return table.index[key(ti.name, new_args)]  // Map, Option, Result
}

// `t` with each of `params` replaced by the matching one of `args`.
pub fn subst(table: mut Table, t: Int, params: [Int], args: [Int]) -> Int {
    if t < 0 || !table.types[t].open {
        return t
    }
    let ti = table.types[t]
    if ti.tag == Tag.Param {
        for i in 0..len(params) {
            if params[i] == t {
                return args[i]
            }
        }
        return t
    }
    let mut new_args: [Int] = []
    for a in ti.args {
        push(mut new_args, subst(mut table, a, params, args))
    }
    if is_fixed(table, t) { return fixed(mut table, new_args[0], ti.length) }
    if ti.tag == Tag.Array {
        return array(mut table, new_args[0])
    }
    if ti.tag == Tag.Map {
        return map(mut table, new_args[0], new_args[1])
    }
    if ti.tag == Tag.Func {
        let r = subst(mut table, ti.result, params, args)
        return func_with(mut table, new_args, r, ti.effects)
    }
    if ti.origin >= 0 {
        return instantiate(mut table, ti.origin, new_args)
    }
    return instance(mut table, ti.name, new_args)
}

// ---- Erasure (M15) ----
//
// Effects are the checker's alone. Before code is made, every type gets a
// form without them, interned like any other: fn() uses fs becomes fn(),
// [fn() uses fs] becomes [fn()], and a struct's fields and an enum's
// payloads are rewritten the same way. Each type erased to another has
// that one as its `plain`, and the lists of instances, arrays and maps the
// code generators define keep only the erased types.

// Erase every type in the table; returns the erased form of each type
// there was before, by number.
pub fn erase_all(table: mut Table) -> [Int] {
    let n = len(table.types)
    let mut memo: Map[Int, Int] = [:]
    for t in 0..n {
        erase(mut table, mut memo, t)
    }
    // The fields and payloads, of the types made on the way too.
    let mut t = 0
    for t < len(table.types) {
        let ti = table.types[t]
        if ti.tag == Tag.Struct || ti.tag == Tag.Enum {
            let mut fields: [FieldInfo] = []
            for f in ti.fields {
                push(mut fields, FieldInfo { name: f.name, ty: erase(mut table, mut memo, f.ty) })
            }
            let mut variants: [Variant] = []
            for v in ti.variants {
                let mut payload: [Int] = []
                for x in v.payload {
                    push(mut payload, erase(mut table, mut memo, x))
                }
                push(mut variants, Variant { name: v.name, payload: payload })
            }
            table.types[t].fields = fields
            table.types[t].variants = variants
        }
        t = t + 1
    }
    let mut instances: [Int] = []
    for i in table.instances {
        if table.types[i].plain < 0 {
            push(mut instances, i)
        }
    }
    table.instances = instances
    let mut arrays: [Int] = []
    for e in table.arrays {
        if e < 0 || table.types[e].plain < 0 {
            push(mut arrays, e)
        }
    }
    table.arrays = arrays
    let mut kv: [Int] = []
    for i in 0..len(table.maps) / 2 {
        let k = table.maps[2 * i]
        let v = table.maps[2 * i + 1]
        if table.types[k].plain < 0 && (v < 0 || table.types[v].plain < 0) {
            push(mut kv, k)
            push(mut kv, v)
        }
    }
    table.maps = kv
    let mut out: [Int] = []
    for i in 0..n {
        push(mut out, memo[i])
    }
    return out
}

fn erase(table: mut Table, memo: mut Map[Int, Int], t: Int) -> Int {
    if t < 0 {
        return t
    }
    match maps.get(memo, t) {
        Some(e) => return e
        None => {}
    }
    let ti = table.types[t]
    let mut e = t
    if ti.tag == Tag.Func || len(ti.args) > 0 {
        let mut args: [Int] = []
        let mut changed = len(ti.effects) > 0
        for a in ti.args {
            let x = erase(mut table, mut memo, a)
            changed = changed || x != a
            push(mut args, x)
        }
        let r = erase(mut table, mut memo, ti.result)
        changed = changed || r != ti.result
        if changed {
            if ti.tag == Tag.Func {
                e = func(mut table, args, r)
            } else if is_fixed(table, t) {
                e = fixed(mut table, args[0], ti.length)
            } else if ti.tag == Tag.Array {
                e = array(mut table, args[0])
            } else if ti.tag == Tag.Map {
                e = map(mut table, args[0], args[1])
            } else if ti.origin >= 0 {
                e = instantiate(mut table, ti.origin, args)
            } else {
                e = instance(mut table, ti.name, args)
            }
        }
    }
    memo[t] = e
    if e != t {
        table.types[t].plain = e
    }
    return e
}

// The index of the variant called `name`, or -1.
pub fn variant_index(table: Table, t: Int, name: Str) -> Int {
    return named_index(table.types[t].variants, name)
}

// The index of the field called `name`, or -1.
pub fn field_index(table: Table, t: Int, name: Str) -> Int {
    return named_index(table.types[t].fields, name)
}

// No variant carries data, so values compare by variant alone.
pub fn c_like(table: Table, t: Int) -> Bool {
    for v in table.types[t].variants {
        if len(v.payload) > 0 {
            return false
        }
    }
    return true
}

// A type as written in the source, seen from module `viewpoint`: a type
// from another module has that module's name in front.
pub fn show(table: Table, t: Int, viewpoint: Str) -> Str {
    if is_fixed(table, t) { return "[" + show(table, table.types[t].args[0], viewpoint) + "; " + strings.from_int(table.types[t].length) + "]" }
    let ti = table.types[t]
    return match ti.tag {
        Tag.Error => "<error>"
        Tag.Prim => ti.name
        Tag.Std => ti.module + "." + ti.name
        Tag.Array => "[" + show(table, ti.args[0], viewpoint) + "]"
        Tag.Map => "Map[" + show(table, ti.args[0], viewpoint) + ", " + show(table, ti.args[1], viewpoint) + "]"
        Tag.Struct => show_enum(table, ti, viewpoint)
        Tag.Enum => show_enum(table, ti, viewpoint)
        Tag.Interface => interface_name(ti)
        Tag.Param => ti.name
        Tag.Func => show_func(table, ti, viewpoint)
    }
}

fn show_func(table: Table, ti: TypeInfo, viewpoint: Str) -> Str {
    let mut b = strings.builder()
    strings.add(mut b, "fn(")
    for i in 0..len(ti.args) {
        if i > 0 {
            strings.add(mut b, ", ")
        }
        strings.add(mut b, show(table, ti.args[i], viewpoint))
    }
    strings.add_byte(mut b, ')')
    if ti.result >= 0 {
        strings.add(mut b, " -> " + show(table, ti.result, viewpoint))
    }
    for i in 0..len(ti.effects) {
        if i == 0 {
            strings.add(mut b, " uses ")
        } else {
            strings.add(mut b, ", ")
        }
        let e = ti.effects[i]
        if is_effect_var(e) {
            strings.add(mut b, e[1..len(e)])
        } else {
            strings.add(mut b, e)
        }
    }
    return strings.build(b)
}

fn show_enum(table: Table, ti: TypeInfo, viewpoint: Str) -> Str {
    if len(ti.args) == 0 {
        return qualified(ti.module, ti.name, viewpoint)
    }
    let mut b = strings.builder()
    if ti.origin >= 0 {
        strings.add(mut b, qualified(ti.module, ti.name, viewpoint))
    } else {
        strings.add(mut b, ti.name)
    }
    strings.add_byte(mut b, '[')
    for i in 0..len(ti.args) {
        if i > 0 {
            strings.add(mut b, ", ")
        }
        strings.add(mut b, show(table, ti.args[i], viewpoint))
    }
    strings.add_byte(mut b, ']')
    return strings.build(b)
}

fn qualified(module: Str, name: Str, viewpoint: Str) -> Str {
    if module != "" && module != viewpoint {
        return module + "." + name
    }
    return name
}

test "substitution makes closed types" {
    let mut t = new_table()
    let p = param(mut t, "T", [], 1, 1)
    let xs = array(mut t, p)
    let opt = option(mut t, xs)
    assert(is_open(t, xs) && is_open(t, opt))
    let ints = subst(mut t, opt, [p], [INT()])
    assert(!is_open(t, ints))
    assert(ints == option(mut t, array(mut t, INT())))
    assert(show(t, ints, "") == "Option[[Int]]")
    assert(find_subst(t, opt, [p], [INT()]) == ints)
}

test "function types with effects" {
    let mut t = new_table()
    let plain_fn = func(mut t, [STR()], INT())
    let reads = func_with(mut t, [STR()], INT(), ["fs"])
    assert(reads != plain_fn && plain(t, reads) == plain_fn && plain(t, plain_fn) == plain_fn)
    assert(func_with(mut t, [STR()], INT(), ["fs"]) == reads)
    let poly = func_with(mut t, [], NOTHING(), ["@f", "fs"])
    assert(show(t, poly, "") == "fn() uses f, fs")
    let both = union_effects(["os"], ["fs", "os"])
    assert(len(both) == 2 && both[0] == "fs" && effects_within(["fs"], both) && !effects_within(["fs"], ["os"]))
}

test "instances of a generic type are interned and filled" {
    let mut t = new_table()
    let decl = add_user(mut t, true, "Box", "", true, 1, 1)
    let p = param(mut t, "T", [], 1, 5)
    t.types[decl].params = [p]
    push(mut t.types[decl].fields, FieldInfo { name: "value", ty: p })
    t.types[decl].filled = true
    let a = instantiate(mut t, decl, [STR()])
    assert(a == instantiate(mut t, decl, [STR()]))
    assert(a != instantiate(mut t, decl, [INT()]))
    assert(get(t, a).fields[0].ty == STR())
    assert(show(t, a, "") == "Box[Str]")
}

// One lookup algorithm for the compiler's named metadata. The interfaces are
// checked and monomorphized by the same path available to user programs.
pub type Named = interface { fn label(value: Self) -> Str }
pub fn FieldInfo.label(value: FieldInfo) -> Str { return value.name }
pub fn Variant.label(value: Variant) -> Str { return value.name }

fn named_index[T: Named](values: [T], name: Str) -> Int {
    for i in 0..len(values) { if values[i].label() == name { return i } }
    return -1
}

// Descriptors for array elements and map values must not acquire unrelated
// methods merely because they happen to be named hash/eq.
pub fn used_as_key(table: Table, t: Int) -> Bool {
    for i in 0..len(table.maps) { if i % 2 == 0 && table.maps[i] == t { return true } }
    return false
}

// Concrete effects, shared by declarations and function/interface signatures.
pub fn concrete_effect(name: Str) -> Bool { return name == "fs" || name == "os" || name == "unsafe" || name == "clock" || name == "net" }
