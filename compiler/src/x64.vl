// The x86-64 backend (M11): IR (ir.vl) as assembly for the GNU assembler,
// in Intel syntax, for Linux and the System V calling convention.
//
// Registers are allocated by linear scan (Poletto and Sarkar, 1999): each
// IR register lives from its first appearance to its last, as positions
// in the list of instructions, stretched over the loops it is live
// across; going through these intervals in order of their start, each
// takes a free machine register, or the register of the interval that
// ends last, which then lives on the stack instead (is spilled).
//
// - An interval with a call inside it takes a callee-saved register (rbx,
//   r12 to r15), which calls keep; one without may also take r10. A Float
//   takes xmm8 to xmm14 when no call is inside it, and the stack when one
//   is: C keeps no xmm register across calls. A call that does not return
//   (a failed check's report) is not counted as inside an interval.
// - rax, rdx and r11 are scratch registers, and rcx carries shift counts
//   and arguments. rdi, rsi, r8 and r9 carry arguments, and also hold a value
//   that no call reads and whose interval has no returning call or long copy
//   inside it (arg_eligible), so moving arguments into place never
//   overwrites a value still needed. xmm15 is the Float scratch register.
// - A register set once to a constant, a slot's address or a symbol's is
//   not kept anywhere: each use writes the constant or the address itself
//   (rematerialization), and a slot's address becomes [rbp - n].
//
// The frame: rbp, the callee-saved registers used, then the IR's slots
// and the spilled values, then the arguments of calls that go on the
// stack, with rsp a multiple of 16 at every call.
import bits
import debug_info
import ir
import live
import lists
import maps
import strings

// Where an IR register's value is.
type Loc = struct {
    kind: Int  // 0 a machine register, 1 spilled to [rbp - off], 2 the constant off, 3 slot at [rbp - off], 4 the symbol's address, 5 nowhere
    reg: Str
    off: Int
    sym: Str
}

fn nowhere() -> Loc {
    return Loc { kind: 5, reg: "", off: 0, sym: "" }
}

// One function's assembly, as it is written.
type Out = struct {
    lines: [Str]
    fid: Int  // which function, for its labels
    locs: [Loc]
    classes: [Int]
    stubs: [Str]  // the panics, after the function's code
    stub_count: Int
    labels: Int  // local labels made for expansions
    doubles: Map[Str, Str]  // the label of each Float constant, shared by the file
    files: Map[Str, Int]
    saved: [Str]  // callee-saved registers pushed
}

pub fn program(p: ir.Program) -> Str {
    let mut b = strings.builder()
    strings.add(mut b, "    .intel_syntax noprefix\n    .text\n")
    let files = debug_info.files(p); strings.add(mut b, debug_info.header(p, false))
    let mut doubles: Map[Str, Str] = [:]
    for i in 0..len(p.funcs) {
        let lines = function(p.funcs[i], i, mut doubles, files)
        for l in lines {
            strings.add(mut b, l)
            strings.add_byte(mut b, '\n')
        }
    }
    if len(files) > 0 { strings.add(mut b, ".LVDend:\n") }
    strings.add(mut b, "\n    .section .rodata\n")
    strings.add(mut b, ".Lmsg_overflow:\n    .asciz \"integer overflow\"\n")
    strings.add(mut b, ".Lmsg_div0:\n    .asciz \"division by zero\"\n")
    strings.add(mut b, ".Lmsg_byte:\n    .asciz \"byte overflow\"\n")
    strings.add(mut b, ".Lmsg_tobyte:\n    .asciz \"value does not fit in a Byte\"\n")
    strings.add(mut b, "    .p2align 3\n")
    for text in maps.keys(doubles) {
        strings.add(mut b, doubles[text] + ":\n    .double " + text + "\n")
    }
    for d in p.data {
        if !d.relocated {
            data(mut b, d)
        }
    }
    strings.add(mut b, "\n    .section .data.rel.ro,\"aw\"\n    .p2align 3\n")
    for d in p.data {
        if d.relocated {
            data(mut b, d)
        }
    }
    strings.add(mut b, debug_info.dwarf(p, false))
    strings.add(mut b, "\n    .section .note.GNU-stack,\"\",@progbits\n")
    return strings.build(b)
}

fn data(b: mut strings.Builder, d: ir.Data) {
    strings.add(mut b, d.label + ":\n")
    for l in d.lines {
        strings.add(mut b, "    " + l + "\n")
    }
}

// ---- Intervals ----

fn is_call(op: ir.Op) -> Bool { return op == ir.Op.Call || op == ir.Op.CallInd || op == ir.Op.CCall }

// ---- Allocation ----

// Whether an instruction may give its result the register of its operand a.
fn shares_operand(op: ir.Op) -> Bool {
    return match op {
        ir.Op.Move => true
        ir.Op.Load => true
        ir.Op.FLoad => true
        ir.Op.Add => true
        ir.Op.AddImm => true
        ir.Op.Sub => true
        ir.Op.Mul => true
        ir.Op.MulImm => true
        ir.Op.AddChk => true
        ir.Op.SubChk => true
        ir.Op.MulChk => true
        ir.Op.DivChk => true
        ir.Op.RemChk => true
        ir.Op.NegChk => true
        ir.Op.ByteChk => true
        ir.Op.ToByte => true
        ir.Op.Cmp => true
        ir.Op.CmpImm => true
        ir.Op.Not => true
        ir.Op.FAdd => true
        ir.Op.FSub => true
        ir.Op.FMul => true
        ir.Op.FDiv => true
        ir.Op.FTo32 => true
        ir.Op.FFrom32 => true
        ir.Op.FNeg => true
        ir.Op.Sext32 => true
        _ => false
    }
}

fn is_callee_saved(r: Str) -> Bool {
    return r == "rbx" || r == "r12" || r == "r13" || r == "r14" || r == "r15"
}

fn is_arg_reg(r: Str) -> Bool {
    return r == "rdi" || r == "rsi" || r == "r8" || r == "r9"
}

// Which values may live in rdi, rsi, r8 or r9. A call writes these one by
// one while it reads its arguments, and the entry reads the parameters from
// them, so a value qualifies only when no call reads it, it is not a
// parameter, and nothing inside its interval writes them: no call that
// returns, and no copy long enough to use rep movsb.
fn arg_eligible(f: ir.Func, iv: live.Intervals) -> [Bool] {
    let n = len(f.classes)
    let mut ok: [Bool] = []
    for v in 0..n {
        push(mut ok, iv.start[v] > 0 && f.classes[v] != ir.FLOAT())
    }
    // writes[k]: how many arg-register writers are among instructions before
    // k. Instruction k is at position k + 1 (live.vl).
    let mut writes: [Int] = []
    let mut count = 0
    for k in 0..len(f.insts) {
        let i = f.insts[k]
        push(mut writes, count)
        if is_call(i.op) {
            for r in ir.reads(i) {
                ok[r] = false
            }
            if !(k + 1 < len(f.insts) && f.insts[k + 1].op == ir.Op.Unreachable) {
                count = count + 1
            }
        }
        if i.op == ir.Op.Copy && i.imm > 256 {
            count = count + 1
        }
    }
    push(mut writes, count)
    for v in 0..n {
        // Positions s..e are instructions s - 1 to e - 1.
        let s = iv.start[v]
        let e = iv.end[v]
        if ok[v] && e >= s && writes[e] - writes[s - 1] > 0 {
            ok[v] = false
        }
    }
    return ok
}

fn allocate(f: ir.Func) -> [Loc] {
    let n = len(f.classes)
    // Calls that do not return (a failed check's report) keep no value alive,
    // so they do not force values into callee-saved registers.
    let iv = live.intervals(f, true)
    let eligible = arg_eligible(f, iv)
    let mut locs: [Loc] = []
    for _ in 0..n {
        push(mut locs, nowhere())
    }
    // Constants and addresses, set once: written where they are used.
    let mut candidates: [Int] = []
    for v in 0..n {
        if iv.end[v] < 0 {
            continue
        }
        if iv.defs[v] == 1 && iv.def_at[v] >= 0 {
            let d = f.insts[iv.def_at[v]]
            if d.op == ir.Op.Const {
                locs[v] = Loc { kind: 2, reg: "", off: d.imm, sym: "" }
                continue
            }
            if d.op == ir.Op.SlotAddr {
                locs[v] = Loc { kind: 3, reg: "", off: d.imm, sym: "" }  // the slot's number, for now
                continue
            }
            if d.op == ir.Op.SymAddr {
                locs[v] = Loc { kind: 4, reg: "", off: 0, sym: d.sym }
                continue
            }
        }
        push(mut candidates, v)
    }
    let mut starts: [Int] = []
    for v in candidates {
        push(mut starts, iv.start[v])
    }
    let order = lists.order(starts)
    let mut free_caller = ["r10"]
    let mut free_args = ["r9", "r8", "rsi", "rdi"]
    let mut free_callee = ["r15", "r14", "r13", "r12", "rbx"]
    let mut free_float = ["xmm14", "xmm13", "xmm12", "xmm11", "xmm10", "xmm9", "xmm8"]
    let mut active: [Int] = []
    for k in order {
        let v = candidates[k]
        // Free the registers of intervals that ended.
        let mut still: [Int] = []
        for a in active {
            if iv.end[a] < iv.start[v] {
                let r = locs[a].reg
                if f.classes[a] == ir.FLOAT() {
                    push(mut free_float, r)
                } else if is_arg_reg(r) {
                    push(mut free_args, r)
                } else if is_callee_saved(r) {
                    push(mut free_callee, r)
                } else {
                    push(mut free_caller, r)
                }
            } else {
                push(mut still, a)
            }
        }
        active = still
        let cross = live.crosses(iv, v)
        let mut got = ""
        // The register of the operand the instruction setting v reads,
        // when the operand's interval ends there: no move is needed.
        let fd = iv.first_def[v]
        if fd == iv.start[v] && fd >= 1 && !(f.classes[v] == ir.FLOAT() && cross) {
            let d = f.insts[fd - 1]
            if d.dst == v && d.a >= 0 && shares_operand(d.op) {
                let a = d.a
                if locs[a].kind == 0 && iv.end[a] == fd && f.classes[a] == f.classes[v] &&
                    (!cross || is_callee_saved(locs[a].reg)) && (eligible[v] || !is_arg_reg(locs[a].reg)) {
                    got = locs[a].reg
                    let mut kept: [Int] = []
                    for x in active {
                        if x != a {
                            push(mut kept, x)
                        }
                    }
                    active = kept
                }
            }
        }
        if got != "" {
            // taken over from the operand
        } else if f.classes[v] == ir.FLOAT() {
            if !cross && len(free_float) > 0 {
                got = free_float[len(free_float) - 1]
                free_float = free_float[0..len(free_float) - 1]
            }
        } else if eligible[v] && len(free_args) > 0 {
            got = free_args[len(free_args) - 1]
            free_args = free_args[0..len(free_args) - 1]
        } else if !cross && len(free_caller) > 0 {
            got = free_caller[len(free_caller) - 1]
            free_caller = free_caller[0..len(free_caller) - 1]
        } else if len(free_callee) > 0 {
            got = free_callee[len(free_callee) - 1]
            free_callee = free_callee[0..len(free_callee) - 1]
        }
        if got == "" && !(f.classes[v] == ir.FLOAT() && cross) {
            // Take the register of the cheapest interval to spill (loop-weighted
            // uses over length, live.vl), if it is cheaper than this one; ties go
            // to the interval that ends last. Spilling the longest interval
            // instead would evict a hot loop's state before its temporaries.
            let mut victim = -1
            for a in active {
                if f.classes[a] != f.classes[v] || cross && !is_callee_saved(locs[a].reg) || !eligible[v] && is_arg_reg(locs[a].reg) {
                    continue
                }
                if victim < 0 || iv.cost[a] < iv.cost[victim] || iv.cost[a] == iv.cost[victim] && iv.end[a] > iv.end[victim] {
                    victim = a
                }
            }
            if victim >= 0 && (iv.cost[victim] < iv.cost[v] || iv.cost[victim] == iv.cost[v] && iv.end[victim] > iv.end[v]) {
                got = locs[victim].reg
                locs[victim] = Loc { kind: 1, reg: "", off: 0, sym: "" }
                let mut kept: [Int] = []
                for a in active {
                    if a != victim {
                        push(mut kept, a)
                    }
                }
                active = kept
            }
        }
        if got == "" {
            locs[v] = Loc { kind: 1, reg: "", off: 0, sym: "" }
        } else {
            locs[v] = Loc { kind: 0, reg: got, off: 0, sym: "" }
            push(mut active, v)
        }
    }
    return locs
}

// ---- Registers' names ----

fn low8(r: Str) -> Str {
    return match r {
        "rax" => "al"
        "rbx" => "bl"
        "rcx" => "cl"
        "rdx" => "dl"
        "rsi" => "sil"
        "rdi" => "dil"
        _ => r + "b"
    }
}

fn low32(r: Str) -> Str {
    return match r {
        "rax" => "eax"
        "rbx" => "ebx"
        "rcx" => "ecx"
        "rdx" => "edx"
        "rsi" => "esi"
        "rdi" => "edi"
        _ => r + "d"
    }
}

fn low16(r: Str) -> Str {
    return match r {
        "rax" => "ax", "rbx" => "bx", "rcx" => "cx", "rdx" => "dx", "rsi" => "si", "rdi" => "di", _ => r + "w",
    }
}

fn sized(r: Str, size: Int) -> Str {
    if size == 2 { return low16(r) }
    if size == 1 {
        return low8(r)
    }
    if size == 4 {
        return low32(r)
    }
    return r
}

fn ptr_word(size: Int) -> Str {
    if size == 2 { return "word ptr " }
    if size == 1 {
        return "byte ptr "
    }
    if size == 4 {
        return "dword ptr "
    }
    return "qword ptr "
}

fn int_arg(i: Int) -> Str {
    return match i {
        0 => "rdi"
        1 => "rsi"
        2 => "rdx"
        3 => "rcx"
        4 => "r8"
        _ => "r9"
    }
}

fn fits32(n: Int) -> Bool {
    return n >= -2147483648 && n <= 2147483647
}

fn num(n: Int) -> Str {
    return strings.from_int(n)
}

// ---- One function ----

fn emit(o: mut Out, line: Str) {
    push(mut o.lines, "    " + line)
}

fn local_label(o: mut Out) -> Str {
    o.labels = o.labels + 1
    return ".LX" + num(o.fid) + "_" + num(o.labels)
}

fn ir_label(o: Out, n: Int) -> Str {
    return ".L" + num(o.fid) + "_" + num(n)
}

fn frame_ref(off: Int) -> Str {
    return "[rbp - " + num(off) + "]"
}

// An operand for reading the integer register v: a machine register, a
// stack slot, or a small constant; or, for an address or a big constant,
// `scratch` after setting it.
fn src(o: mut Out, v: Int, scratch: Str) -> Str {
    let l = o.locs[v]
    if l.kind == 0 {
        return l.reg
    }
    if l.kind == 1 {
        return "qword ptr " + frame_ref(l.off)
    }
    if l.kind == 2 {
        if fits32(l.off) {
            return num(l.off)
        }
        emit(mut o, "movabs " + scratch + ", " + num(l.off))
        return scratch
    }
    if l.kind == 3 {
        emit(mut o, "lea " + scratch + ", " + frame_ref(l.off))
        return scratch
    }
    if l.kind == 4 {
        emit(mut o, "lea " + scratch + ", [rip + " + l.sym + "]")
        return scratch
    }
    emit(mut o, "xor " + low32(scratch) + ", " + low32(scratch))  // never set: not reached
    return scratch
}

// v in a machine register: its own, or `scratch`.
fn in_reg(o: mut Out, v: Int, scratch: Str) -> Str {
    let l = o.locs[v]
    if l.kind == 0 {
        return l.reg
    }
    let s = src(mut o, v, scratch)
    if s != scratch {
        emit(mut o, "mov " + scratch + ", " + s)
    }
    return scratch
}

// Where an instruction computes its integer result: the result's own
// register, or rax when it is spilled.
fn result_reg(o: Out, v: Int) -> Str {
    if o.locs[v].kind == 0 {
        return o.locs[v].reg
    }
    return "rax"
}

// Set the integer register v from the machine register `r`.
fn set(o: mut Out, v: Int, r: Str) {
    let l = o.locs[v]
    if l.kind == 0 {
        if l.reg != r {
            emit(mut o, "mov " + l.reg + ", " + r)
        }
    } else if l.kind == 1 {
        emit(mut o, "mov qword ptr " + frame_ref(l.off) + ", " + r)
    }
}

// A Float operand: an xmm register, or a stack slot.
// Where a Float result is computed: its own register, or the scratch.
fn fresult(o: Out, v: Int) -> Str {
    if o.locs[v].kind == 0 {
        return o.locs[v].reg
    }
    return "xmm15"
}

fn fsrc(o: Out, v: Int) -> Str {
    let l = o.locs[v]
    if l.kind == 0 {
        return l.reg
    }
    return "qword ptr " + frame_ref(l.off)
}

fn fin_reg(o: mut Out, v: Int, scratch: Str) -> Str {
    let l = o.locs[v]
    if l.kind == 0 {
        return l.reg
    }
    emit(mut o, "movsd " + scratch + ", " + fsrc(o, v))
    return scratch
}

fn fset(o: mut Out, v: Int, r: Str) {
    let l = o.locs[v]
    if l.kind == 0 {
        if l.reg != r {
            emit(mut o, "movapd " + l.reg + ", " + r)
        }
    } else if l.kind == 1 {
        emit(mut o, "movsd qword ptr " + frame_ref(l.off) + ", " + r)
    }
}

// The memory at base + off, with base in `scratch` if it must be loaded.
fn mem(o: mut Out, base: Int, off: Int, size: Int, scratch: Str) -> Str {
    let l = o.locs[base]
    if l.kind == 3 {
        return ptr_word(size) + frame_ref(l.off - off)
    }
    if l.kind == 4 {
        return ptr_word(size) + "[rip + " + l.sym + " + " + num(off) + "]"
    }
    let r = in_reg(mut o, base, scratch)
    if off == 0 {
        return ptr_word(size) + "[" + r + "]"
    }
    if off < 0 {
        return ptr_word(size) + "[" + r + " - " + num(0 - off) + "]"
    }
    return ptr_word(size) + "[" + r + " + " + num(off) + "]"
}

// A panic at the Vela position `loc` (a C string's label) with a message
// of the runtime's: the label to jump to for it.
fn panic_stub(o: mut Out, loc: Str, message: Str) -> Str {
    o.stub_count = o.stub_count + 1
    let name = ".LP" + num(o.fid) + "_" + num(o.stub_count)
    push(mut o.stubs, name + ":")
    push(mut o.stubs, "    lea rdi, [rip + " + loc + "]")
    push(mut o.stubs, "    lea rsi, [rip + " + message + "]")
    push(mut o.stubs, "    call vela_panic@PLT")
    return name
}

fn double_label(o: mut Out, text: Str) -> Str {
    match maps.get(o.doubles, text) {
        Some(l) => return l
        None => {}
    }
    let name = ".LD" + num(len(maps.keys(o.doubles)))
    o.doubles[text] = name
    return name
}

// The bytes a call's arguments take on the stack.
fn stack_bytes(f: ir.Func, i: ir.Inst) -> Int {
    let mut ni = 0
    let mut nf = 0
    if i.op == ir.Op.CCall && i.imm == ir.RET_STR() {
        ni = 1
    }
    let mut bytes = 0
    for k in 0..len(i.args) {
        let mut kind = ir.KIND_INT()
        if i.op == ir.Op.CCall {
            kind = i.kinds[k]
        } else if f.classes[i.args[k]] == ir.FLOAT() {
            kind = ir.KIND_FLOAT()
        }
        if kind == ir.KIND_STR() {
            bytes = bytes + 24
        } else if kind == ir.KIND_FLOAT() || kind == ir.KIND_FLOAT32() {
            if nf < 8 {
                nf = nf + 1
            } else {
                bytes = bytes + 8
            }
        } else if ni < 6 {
            ni = ni + 1
        } else {
            bytes = bytes + 8
        }
    }
    return bytes
}

fn function(f: ir.Func, fid: Int, doubles: mut Map[Str, Str], files: Map[Str, Int]) -> [Str] {
    let mut locs = allocate(f)
    let mut saved: [Str] = []
    for r in ["rbx", "r12", "r13", "r14", "r15"] {
        for l in locs {
            if l.kind == 0 && l.reg == r {
                push(mut saved, r)
                break
            }
        }
    }
    // The frame, below the saved registers.
    let mut at = 8 * len(saved)
    let mut slot_off: [Int] = []
    for s in 0..len(f.slot_sizes) {
        at = align_up(at + f.slot_sizes[s], f.slot_aligns[s])
        push(mut slot_off, at)
    }
    for v in 0..len(locs) {
        if locs[v].kind == 1 {
            at = at + 8
            locs[v].off = at
        } else if locs[v].kind == 3 {
            locs[v].off = slot_off[locs[v].off]
        }
    }
    let mut out_bytes = 0
    for i in f.insts {
        if is_call(i.op) {
            let b = stack_bytes(f, i)
            if b > out_bytes {
                out_bytes = b
            }
        }
    }
    let total = align_up(at + out_bytes, 16)
    let mut o = Out {
        lines: [], fid: fid, locs: locs, classes: f.classes, stubs: [], stub_count: 0, labels: 0, doubles: doubles, saved: saved, files: files,
    }
    push(mut o.lines, "")
    push(mut o.lines, "    .p2align 4")
    if f.public {
        push(mut o.lines, "    .globl " + f.name)
    }
    push(mut o.lines, "    .type " + f.name + ", @function")
    push(mut o.lines, f.name + ":")
    let debug = len(files) > 0
    if debug { emit(mut o, ".loc 1 0 0"); emit(mut o, ".cfi_startproc") }
    emit(mut o, "push rbp")
    if debug { emit(mut o, ".cfi_def_cfa_offset 16"); emit(mut o, ".cfi_offset rbp, -16") }
    emit(mut o, "mov rbp, rsp")
    if debug { emit(mut o, ".cfi_def_cfa_register rbp") }
    for k in 0..len(saved) {
        emit(mut o, "push " + saved[k])
        if debug { emit(mut o, ".cfi_offset " + saved[k] + ", -" + num(24+k*8)) }
    }
    if total - 8 * len(saved) > 0 {
        emit(mut o, "sub rsp, " + num(total - 8 * len(saved)))
    }
    // The parameters, from where the convention puts them.
    let mut ni = 0
    let mut nf = 0
    let mut stack = 16
    for p in f.params {
        if f.classes[p] == ir.FLOAT() {
            if nf < 8 {
                fset(mut o, p, "xmm" + num(nf))
                nf = nf + 1
            } else {
                emit(mut o, "movsd xmm15, qword ptr [rbp + " + num(stack) + "]")
                fset(mut o, p, "xmm15")
                stack = stack + 8
            }
        } else if ni < 6 {
            set(mut o, p, int_arg(ni))
            ni = ni + 1
        } else {
            emit(mut o, "mov rax, qword ptr [rbp + " + num(stack) + "]")
            set(mut o, p, "rax")
            stack = stack + 8
        }
    }
    let mut reads: [Int] = []
    for _ in 0..len(f.classes) {
        push(mut reads, 0)
    }
    for i in f.insts {
        for r in ir.reads(i) {
            reads[r] = reads[r] + 1
        }
    }
    let known = bits.u32(f)
    // Blocks that only leave the function go after its epilogue, so the
    // paths that continue fall through instead of jumping around them.
    let order = layout(f)
    body(mut o, f, order.main, order.skips, reads, known)
    let main_lines = o.lines
    o.lines = []
    body(mut o, f, order.cold, order.skips, reads, known)
    let cold_lines = o.lines
    o.lines = main_lines
    push(mut o.lines, ".LR" + num(fid) + ":")
    if debug { emit(mut o, ".cfi_remember_state") }
    if len(saved) > 0 {
        emit(mut o, "lea rsp, [rbp - " + num(8 * len(saved)) + "]")
    } else {
        emit(mut o, "mov rsp, rbp")
    }
    let mut i = len(saved) - 1
    for i >= 0 {
        emit(mut o, "pop " + saved[i])
        i = i - 1
    }
    emit(mut o, "pop rbp")
    if debug { emit(mut o, ".cfi_def_cfa rsp, 8"); emit(mut o, ".cfi_restore rbp") }
    emit(mut o, "ret")
    if debug { emit(mut o, ".cfi_restore_state") }
    for line in cold_lines {
        push(mut o.lines, line)
    }
    for s in o.stubs {
        push(mut o.lines, s)
    }
    if debug { emit(mut o, ".cfi_endproc"); push(mut o.lines, ".LVD" + num(fid) + "end:") }
    // Its size, so that profilers and debuggers can tell where it ends.
    push(mut o.lines, "    .size " + f.name + ", . - " + f.name)
    for key in maps.keys(o.doubles) {
        doubles[key] = o.doubles[key]
    }
    return o.lines
}

fn align_up(n: Int, a: Int) -> Int {
    return (n + a - 1) / a * a
}

fn cond_suffix(code: Int) -> Str {
    return match code {
        0 => "e"
        1 => "ne"
        2 => "l"
        3 => "le"
        4 => "g"
        _ => "ge"
    }
}

fn branch_suffix(c: Str) -> Str {
    return match c {
        "eq" => "e"
        "ne" => "ne"
        "lt" => "l"
        "le" => "le"
        "gt" => "g"
        "ge" => "ge"
        "ult" => "b"
        "ugt" => "a"
        "ule" => "be"
        _ => "ae"
    }
}

// `next` is the label right after this instruction, or -1: a jump there
// is left out.
fn instruction(o: mut Out, f: ir.Func, i: ir.Inst, next: Int) {
    let op = i.op
    if op == ir.Op.Source { emit(mut o, ".loc " + num(o.files[i.sym]) + " " + num(i.imm) + " " + num(i.imm2)); return }
    if op == ir.Op.Label {
        push(mut o.lines, ir_label(o, i.imm) + ":")
        return
    }
    if op == ir.Op.Const {
        if o.locs[i.dst].kind == 0 || o.locs[i.dst].kind == 1 {
            if fits32(i.imm) {
                if o.locs[i.dst].kind == 0 {
                    if i.imm == 0 {
                        emit(mut o, "xor " + low32(o.locs[i.dst].reg) + ", " + low32(o.locs[i.dst].reg))
                    } else {
                        emit(mut o, "mov " + o.locs[i.dst].reg + ", " + num(i.imm))
                    }
                } else {
                    emit(mut o, "mov qword ptr " + frame_ref(o.locs[i.dst].off) + ", " + num(i.imm))
                }
            } else {
                emit(mut o, "movabs rax, " + num(i.imm))
                set(mut o, i.dst, "rax")
            }
        }
        return
    }
    if op == ir.Op.SlotAddr || op == ir.Op.SymAddr {
        let l = o.locs[i.dst]
        if l.kind == 0 || l.kind == 1 {
            if op == ir.Op.SymAddr {
                emit(mut o, "lea rax, [rip + " + i.sym + "]")
            } else {
                emit(mut o, "lea rax, " + frame_ref(slot_offset(f, o, i.imm)))
            }
            set(mut o, i.dst, "rax")
        }
        return
    }
    if op == ir.Op.FConst {
        let l = double_label(mut o, i.sym)
        let mut d = "xmm15"
        if o.locs[i.dst].kind == 0 {
            d = o.locs[i.dst].reg
        }
        emit(mut o, "movsd " + d + ", qword ptr [rip + " + l + "]")
        fset(mut o, i.dst, d)
        return
    }
    if op == ir.Op.Move {
        if o.classes[i.dst] == ir.FLOAT() {
            fset(mut o, i.dst, fin_reg(mut o, i.a, "xmm15"))
        } else {
            let l = o.locs[i.dst]
            if l.kind == 0 {
                let s = src(mut o, i.a, "rax")
                if s != l.reg {
                    emit(mut o, "mov " + l.reg + ", " + s)
                }
            } else {
                set(mut o, i.dst, in_reg(mut o, i.a, "rax"))
            }
        }
        return
    }
    if op == ir.Op.Load {
        let m = mem(mut o, i.a, i.imm, i.imm2, "r11")
        let mut d = "rax"
        if o.locs[i.dst].kind == 0 {
            d = o.locs[i.dst].reg
        }
        if i.imm2 == 1 || i.imm2 == 2 {
            emit(mut o, "movzx " + low32(d) + ", " + m)
        } else if i.imm2 == 4 {
            emit(mut o, "movsxd " + d + ", " + m)
        } else {
            emit(mut o, "mov " + d + ", " + m)
        }
        set(mut o, i.dst, d)
        return
    }
    if op == ir.Op.Store {
        let l = o.locs[i.b]
        let mut v = ""
        if l.kind == 2 && fits32(l.off) {
            v = num(l.off)
        } else {
            v = sized(in_reg(mut o, i.b, "rax"), i.imm2)
        }
        emit(mut o, "mov " + mem(mut o, i.a, i.imm, i.imm2, "r11") + ", " + v)
        return
    }
    if op == ir.Op.FLoad {
        let d = fresult(o, i.dst)
        emit(mut o, "movsd " + d + ", " + mem(mut o, i.a, i.imm, 8, "r11"))
        fset(mut o, i.dst, d)
        return
    }
    if op == ir.Op.FStore {
        let v = fin_reg(mut o, i.b, "xmm15")
        emit(mut o, "movsd " + mem(mut o, i.a, i.imm, 8, "r11") + ", " + v)
        return
    }
    if op == ir.Op.Copy {
        copy(mut o, i.a, i.b, i.imm)
        return
    }
    if op == ir.Op.Add && o.locs[i.dst].kind == 0 && o.locs[i.a].kind == 0 && o.locs[i.b].kind == 0 {
        // Three registers: in place when the result shares one (addition
        // commutes), else one lea instead of a mov and an add (an address
        // such as base + i * 56).
        let d = o.locs[i.dst].reg
        let ra = o.locs[i.a].reg
        let rb = o.locs[i.b].reg
        if d == ra {
            emit(mut o, "add " + d + ", " + rb)
        } else if d == rb {
            emit(mut o, "add " + d + ", " + ra)
        } else {
            emit(mut o, "lea " + d + ", [" + ra + " + " + rb + "]")
        }
        return
    }
    if op == ir.Op.Add || op == ir.Op.Sub || op == ir.Op.Mul || op == ir.Op.AddChk || op == ir.Op.SubChk || op == ir.Op.MulChk {
        // In the result's own register when it has one that b is not in.
        let mut d = "rax"
        let l = o.locs[i.dst]
        if l.kind == 0 && !(o.locs[i.b].kind == 0 && o.locs[i.b].reg == l.reg && i.b != i.a) {
            d = l.reg
        }
        let a = src(mut o, i.a, d)
        if a != d {
            emit(mut o, "mov " + d + ", " + a)
        }
        let b = src(mut o, i.b, "r11")
        let name = match op {
            ir.Op.Add => "add"
            ir.Op.AddChk => "add"
            ir.Op.Sub => "sub"
            ir.Op.SubChk => "sub"
            _ => "imul"
        }
        emit(mut o, name + " " + d + ", " + b)
        if op == ir.Op.AddChk || op == ir.Op.SubChk || op == ir.Op.MulChk {
            emit(mut o, "jo " + panic_stub(mut o, i.sym, ".Lmsg_overflow"))
        }
        set(mut o, i.dst, d)
        return
    }
    if op == ir.Op.AddImm || op == ir.Op.MulImm {
        if op == ir.Op.AddImm && o.locs[i.dst].kind == 0 && o.locs[i.a].kind == 0 && o.locs[i.dst].reg == o.locs[i.a].reg &&
            fits32(i.imm) {
            emit(mut o, "add " + o.locs[i.dst].reg + ", " + num(i.imm))
            return
        }
        if fits32(i.imm) && i.imm != -2147483648 {
            let d = result_reg(o, i.dst)
            let a = in_reg(mut o, i.a, d)
            if op == ir.Op.MulImm {
                emit(mut o, "imul " + d + ", " + a + ", " + num(i.imm))
            } else if i.imm < 0 {
                emit(mut o, "lea " + d + ", [" + a + " - " + num(0 - i.imm) + "]")
            } else {
                emit(mut o, "lea " + d + ", [" + a + " + " + num(i.imm) + "]")
            }
            set(mut o, i.dst, d)
            return
        }
        emit(mut o, "mov rax, " + src(mut o, i.a, "rax"))
        emit(mut o, "movabs r11, " + num(i.imm))
        if op == ir.Op.AddImm {
            emit(mut o, "add rax, r11")
        } else {
            emit(mut o, "imul rax, r11")
        }
        set(mut o, i.dst, "rax")
        return
    }
    if (op == ir.Op.Div || op == ir.Op.Rem || op == ir.Op.DivChk || op == ir.Op.RemChk) && o.locs[i.b].kind == 2 &&
        o.locs[i.b].off > 0 && (o.locs[i.b].off & (o.locs[i.b].off - 1)) == 0 {
        // By a positive power of two, as arm64.vl does: it is neither 0 nor -1,
        // so nothing can fail. Truncating toward zero adds 2^k - 1 to a
        // negative a before the arithmetic shift.
        let mut shift = 0
        let mut x = o.locs[i.b].off
        for x > 1 {
            x = x >> 1
            shift = shift + 1
        }
        let rem = op == ir.Op.Rem || op == ir.Op.RemChk
        if shift == 0 {
            if rem {
                emit(mut o, "xor eax, eax")
            } else {
                emit(mut o, "mov rax, " + src(mut o, i.a, "rax"))
            }
            set(mut o, i.dst, "rax")
            return
        }
        let a = in_reg(mut o, i.a, "rax")
        emit(mut o, "mov r11, " + a)
        if shift == 1 {
            emit(mut o, "shr r11, 63")
        } else {
            emit(mut o, "sar r11, 63")
            emit(mut o, "shr r11, " + num(64 - shift))
        }
        emit(mut o, "add r11, " + a)
        emit(mut o, "sar r11, " + num(shift))
        if rem {
            emit(mut o, "shl r11, " + num(shift))
            if a != "rax" {
                emit(mut o, "mov rax, " + a)
            }
            emit(mut o, "sub rax, r11")
            set(mut o, i.dst, "rax")
        } else {
            set(mut o, i.dst, "r11")
        }
        return
    }
    if op == ir.Op.DivChk || op == ir.Op.RemChk {
        let b = in_reg(mut o, i.b, "r11")
        if b != "r11" {
            emit(mut o, "mov r11, " + b)
        }
        emit(mut o, "test r11, r11")
        emit(mut o, "jz " + panic_stub(mut o, i.sym, ".Lmsg_div0"))
        emit(mut o, "mov rax, " + src(mut o, i.a, "rax"))
        let minus = local_label(mut o)
        let done = local_label(mut o)
        emit(mut o, "cmp r11, -1")
        emit(mut o, "je " + minus)
        emit(mut o, "cqo")
        emit(mut o, "idiv r11")
        if op == ir.Op.RemChk {
            emit(mut o, "mov rax, rdx")
        }
        emit(mut o, "jmp " + done)
        push(mut o.lines, minus + ":")
        if op == ir.Op.DivChk {
            // a / -1 is -a, which overflows for the smallest Int.
            emit(mut o, "neg rax")
            emit(mut o, "jo " + panic_stub(mut o, i.sym, ".Lmsg_overflow"))
        } else {
            emit(mut o, "xor eax, eax")
        }
        push(mut o.lines, done + ":")
        set(mut o, i.dst, "rax")
        return
    }
    if op == ir.Op.NegChk {
        emit(mut o, "mov rax, " + src(mut o, i.a, "rax"))
        emit(mut o, "neg rax")
        emit(mut o, "jo " + panic_stub(mut o, i.sym, ".Lmsg_overflow"))
        set(mut o, i.dst, "rax")
        return
    }
    if op == ir.Op.ByteChk || op == ir.Op.ToByte {
        emit(mut o, "mov rax, " + src(mut o, i.a, "rax"))
        emit(mut o, "cmp rax, 255")
        let mut message = ".Lmsg_byte"
        if op == ir.Op.ToByte {
            message = ".Lmsg_tobyte"
        }
        emit(mut o, "ja " + panic_stub(mut o, i.sym, message))
        set(mut o, i.dst, "rax")
        return
    }
    if op == ir.Op.Cmp || op == ir.Op.CmpImm {
        let a = in_reg(mut o, i.a, "rax")
        if op == ir.Op.Cmp {
            emit(mut o, "cmp " + a + ", " + src(mut o, i.b, "r11"))
        } else if fits32(i.imm2) {
            emit(mut o, "cmp " + a + ", " + num(i.imm2))
        } else {
            emit(mut o, "movabs r11, " + num(i.imm2))
            emit(mut o, "cmp " + a + ", r11")
        }
        emit(mut o, "set" + cond_suffix(i.imm) + " al")
        emit(mut o, "movzx eax, al")
        set(mut o, i.dst, "rax")
        return
    }
    if op == ir.Op.FCmp {
        let a = fin_reg(mut o, i.a, "xmm15")
        let b = fsrc(o, i.b)
        let c = i.imm
        if c == 0 || c == 1 {
            emit(mut o, "ucomisd " + a + ", " + b)
            if c == 0 {
                emit(mut o, "sete al")
                emit(mut o, "setnp r11b")
                emit(mut o, "and al, r11b")
            } else {
                emit(mut o, "setne al")
                emit(mut o, "setp r11b")
                emit(mut o, "or al, r11b")
            }
        } else if c == 4 || c == 5 {
            emit(mut o, "ucomisd " + a + ", " + b)
            if c == 4 {
                emit(mut o, "seta al")
            } else {
                emit(mut o, "setae al")
            }
        } else {
            // a < b is b > a: false when either is NaN.
            let bb = fin_reg(mut o, i.b, "xmm15")
            emit(mut o, "ucomisd " + bb + ", " + fsrc(o, i.a))
            if c == 2 {
                emit(mut o, "seta al")
            } else {
                emit(mut o, "setae al")
            }
        }
        emit(mut o, "movzx eax, al")
        set(mut o, i.dst, "rax")
        return
    }
    if op == ir.Op.Not {
        emit(mut o, "mov rax, " + src(mut o, i.a, "rax"))
        emit(mut o, "xor rax, 1")
        set(mut o, i.dst, "rax")
        return
    }
    if op == ir.Op.FAdd || op == ir.Op.FSub || op == ir.Op.FMul || op == ir.Op.FDiv {
        let name = match op {
            ir.Op.FAdd => "addsd"
            ir.Op.FSub => "subsd"
            ir.Op.FMul => "mulsd"
            _ => "divsd"
        }
        let mut d = "xmm15"
        let l = o.locs[i.dst]
        if l.kind == 0 && !(o.locs[i.b].kind == 0 && o.locs[i.b].reg == l.reg && i.b != i.a) {
            d = l.reg
        }
        let la = o.locs[i.a]
        if la.kind == 0 {
            if la.reg != d {
                emit(mut o, "movapd " + d + ", " + la.reg)
            }
        } else {
            emit(mut o, "movsd " + d + ", " + fsrc(o, i.a))
        }
        emit(mut o, name + " " + d + ", " + fsrc(o, i.b))
        fset(mut o, i.dst, d)
        return
    }
    if op == ir.Op.FTo32 || op == ir.Op.FFrom32 {
        let mut instruction = "cvtsd2ss"
        if op == ir.Op.FFrom32 { instruction = "cvtss2sd" }
        let mut source = fsrc(o, i.a)
        if op == ir.Op.FFrom32 && len(source) >= 9 && source[0..9] == "qword ptr" { source = "dword ptr" + source[9..len(source)] }
        emit(mut o, instruction + " xmm15, " + source)
        fset(mut o, i.dst, "xmm15")
        return
    }
    if op == ir.Op.FSqrt {
        let d = fresult(o, i.dst)
        emit(mut o, "sqrtsd " + d + ", " + fsrc(o, i.a))
        fset(mut o, i.dst, d)
        return
    }
    if op == ir.Op.FNeg {
        emit(mut o, "movq rax, " + fin_reg(mut o, i.a, "xmm15"))
        emit(mut o, "btc rax, 63")
        emit(mut o, "movq xmm15, rax")
        fset(mut o, i.dst, "xmm15")
        return
    }
    if op == ir.Op.IntToFloat {
        emit(mut o, "pxor xmm15, xmm15")
        emit(mut o, "cvtsi2sd xmm15, " + in_reg(mut o, i.a, "rax"))
        fset(mut o, i.dst, "xmm15")
        return
    }
    if op == ir.Op.Extend {
        // From the low i.imm bits of a, zero- or (i.imm2 != 0) sign-extended.
        let a = in_reg(mut o, i.a, "rax")
        let d = result_reg(o, i.dst)
        if i.imm >= 64 {
            if a != d {
                emit(mut o, "mov " + d + ", " + a)
            }
        } else if i.imm == 32 && i.imm2 == 0 {
            emit(mut o, "mov " + low32(d) + ", " + low32(a))  // writing 32 bits clears the upper half
        } else if i.imm2 == 0 {
            emit(mut o, "movzx " + low32(d) + ", " + sized(a, i.imm / 8))
        } else if i.imm == 32 {
            emit(mut o, "movsxd " + d + ", " + low32(a))
        } else {
            emit(mut o, "movsx " + d + ", " + sized(a, i.imm / 8))
        }
        set(mut o, i.dst, d)
        return
    }
    if op == ir.Op.Inv {
        let d = result_reg(o, i.dst)
        let a = src(mut o, i.a, d)
        if a != d {
            emit(mut o, "mov " + d + ", " + a)
        }
        emit(mut o, "not " + d)
        set(mut o, i.dst, d)
        return
    }
    if op == ir.Op.And || op == ir.Op.Or || op == ir.Op.Xor {
        let name = match op { ir.Op.And => "and", ir.Op.Or => "or", _ => "xor" }
        let l = o.locs[i.dst]
        // These commute: when the result's register already holds b, combine a into it.
        if l.kind == 0 && o.locs[i.b].kind == 0 && o.locs[i.b].reg == l.reg && i.b != i.a {
            emit(mut o, name + " " + l.reg + ", " + src(mut o, i.a, "r11"))
            return
        }
        let d = result_reg(o, i.dst)
        let a = src(mut o, i.a, d)
        if a != d {
            emit(mut o, "mov " + d + ", " + a)
        }
        emit(mut o, name + " " + d + ", " + src(mut o, i.b, "r11"))
        set(mut o, i.dst, d)
        return
    }
    if op == ir.Op.Shl || op == ir.Op.Shr || op == ir.Op.Sar {
        let name = match op { ir.Op.Shl => "shl", ir.Op.Shr => "shr", _ => "sar" }
        let count = o.locs[i.b]
        let mut by = "cl"
        if count.kind == 2 && count.off >= 0 && count.off < 64 {
            by = num(count.off)
        } else {
            // Before a is placed: the result's register may be b's.
            emit(mut o, "mov rcx, " + src(mut o, i.b, "rcx"))
        }
        let d = result_reg(o, i.dst)
        let a = src(mut o, i.a, d)
        if a != d {
            emit(mut o, "mov " + d + ", " + a)
        }
        emit(mut o, name + " " + d + ", " + by)
        set(mut o, i.dst, d)
        return
    }
    if op == ir.Op.Div || op == ir.Op.Rem {
        let b = in_reg(mut o, i.b, "r11"); if b != "r11" { emit(mut o, "mov r11, " + b) }; emit(mut o, "mov rax, " + src(mut o, i.a, "rax")); emit(mut o, "cqo"); emit(mut o, "idiv r11"); if op == ir.Op.Rem { emit(mut o, "mov rax, rdx") }; set(mut o, i.dst, "rax"); return
    }
    if op == ir.Op.Sext32 {
        let a = in_reg(mut o, i.a, "rax")
        emit(mut o, "movsxd rax, " + low32(a))
        set(mut o, i.dst, "rax")
        return
    }
    if op == ir.Op.Jump {
        if i.imm != next {
            emit(mut o, "jmp " + ir_label(o, i.imm))
        }
        return
    }
    if op == ir.Op.Branch {
        let l = o.locs[i.a]
        if l.kind == 2 {
            if l.off != 0 && i.imm != next {
                emit(mut o, "jmp " + ir_label(o, i.imm))
            } else if l.off == 0 && i.imm2 != next {
                emit(mut o, "jmp " + ir_label(o, i.imm2))
            }
            return
        }
        let a = in_reg(mut o, i.a, "rax")
        emit(mut o, "test " + a + ", " + a)
        if i.imm2 == next {
            emit(mut o, "jnz " + ir_label(o, i.imm))
        } else if i.imm == next {
            emit(mut o, "jz " + ir_label(o, i.imm2))
        } else {
            emit(mut o, "jnz " + ir_label(o, i.imm))
            emit(mut o, "jmp " + ir_label(o, i.imm2))
        }
        return
    }
    if op == ir.Op.BranchCmp {
        compare(mut o, i)
        emit(mut o, "j" + branch_suffix(i.sym) + " " + ir_label(o, i.imm))
        return
    }
    if op == ir.Op.Ret {
        if i.a >= 0 {
            if o.classes[i.a] == ir.FLOAT() {
                let r = fin_reg(mut o, i.a, "xmm0")
                if r != "xmm0" {
                    emit(mut o, "movapd xmm0, " + r)
                }
            } else {
                emit(mut o, "mov rax, " + src(mut o, i.a, "rax"))
            }
        }
        emit(mut o, "jmp .LR" + num(o.fid))
        return
    }
    if is_call(op) {
        call(mut o, f, i)
        return
    }
    if op == ir.Op.RcInc {
        let r = in_reg(mut o, i.a, "r11")
        let slow = local_label(mut o)
        let done = local_label(mut o)
        emit(mut o, "mov rax, qword ptr [" + r + "]")
        emit(mut o, "test rax, rax")
        emit(mut o, "je " + done)  // immortal zero counts stay unchanged
        emit(mut o, "jl " + slow)
        emit(mut o, "inc rax")
        emit(mut o, "mov qword ptr [" + r + "], rax")
        emit(mut o, "jmp " + done)
        push(mut o.lines, slow + ":")
        // Shared between threads: atomically, one more (the count is -n).
        emit(mut o, "lock dec qword ptr [" + r + "]")
        push(mut o.lines, done + ":")
        return
    }
    if op == ir.Op.RcDec {
        let r = in_reg(mut o, i.a, "r11")
        let slow = local_label(mut o)
        let done = local_label(mut o)
        emit(mut o, "mov rax, qword ptr [" + r + "]")
        emit(mut o, "test rax, rax")
        emit(mut o, "je " + done)  // immortal zero counts stay unchanged
        emit(mut o, "jl " + slow)
        emit(mut o, "dec rax")
        emit(mut o, "mov qword ptr [" + r + "], rax")
        emit(mut o, "sete al")
        emit(mut o, "jmp " + done)
        push(mut o.lines, slow + ":")
        emit(mut o, "mov rax, 1")
        emit(mut o, "lock xadd qword ptr [" + r + "], rax")
        emit(mut o, "cmp rax, -1")
        emit(mut o, "sete al")
        push(mut o.lines, done + ":")
        emit(mut o, "movzx eax, al")
        set(mut o, i.dst, "rax")
        return
    }
    if op == ir.Op.Unreachable {
        emit(mut o, "ud2")
        return
    }
}

// A 32-bit operand for v: a register's low half, its spill slot's low
// dword, or a small constant; `scratch` holds anything else.
fn operand32(o: mut Out, v: Int, scratch: Str) -> Str {
    let l = o.locs[v]
    if l.kind == 2 && fits32(l.off) {
        return num(l.off)
    }
    if l.kind == 1 {
        return "dword ptr " + frame_ref(l.off)
    }
    return low32(in_reg(mut o, v, scratch))
}

// A wrapping word operation whose only reader truncates it to 32 bits, as
// one 32-bit instruction: its low half depends only on its operands' low
// halves, and writing a 32-bit register clears the upper half (arm64.vl).
fn narrow(o: mut Out, i: ir.Inst, e: ir.Inst) -> Bool {
    if e.op != ir.Op.Extend || e.a != i.dst || e.imm != 32 || e.imm2 != 0 {
        return false
    }
    let op = i.op
    let mut name = match op {
        ir.Op.Add => "add", ir.Op.Sub => "sub", ir.Op.Mul => "imul", ir.Op.And => "and", ir.Op.Or => "or", ir.Op.Xor => "xor",
        ir.Op.Inv => "not", _ => "",
    }
    let mut count = -1
    if op == ir.Op.Shl && o.locs[i.b].kind == 2 && o.locs[i.b].off >= 0 && o.locs[i.b].off < 32 {
        name = "shl"
        count = o.locs[i.b].off
    }
    if name == "" {
        return false
    }
    let d = result_reg(o, e.dst)
    if op == ir.Op.Inv || count >= 0 {
        let a = operand32(mut o, i.a, "r11")
        if a != low32(d) {
            emit(mut o, "mov " + low32(d) + ", " + a)
        }
        if count >= 0 {
            emit(mut o, "shl " + low32(d) + ", " + num(count))
        } else {
            emit(mut o, "not " + low32(d))
        }
        set(mut o, e.dst, d)
        return true
    }
    let lb = o.locs[i.b]
    if lb.kind == 0 && lb.reg == d && i.b != i.a {
        // The result's register holds b: combine a into it, or for sub work in rax.
        if op != ir.Op.Sub {
            let mut a = operand32(mut o, i.a, "r11")
            if op == ir.Op.Mul && o.locs[i.a].kind == 2 {
                a = low32(in_reg(mut o, i.a, "r11"))
            }
            emit(mut o, name + " " + low32(d) + ", " + a)
            set(mut o, e.dst, d)
            return true
        }
        emit(mut o, "mov eax, " + operand32(mut o, i.a, "rax"))
        emit(mut o, "sub eax, " + low32(d))
        set(mut o, e.dst, "rax")
        return true
    }
    let a = operand32(mut o, i.a, "r11")
    if a != low32(d) {
        emit(mut o, "mov " + low32(d) + ", " + a)
    }
    let mut b = operand32(mut o, i.b, "r11")
    if op == ir.Op.Mul && lb.kind == 2 {
        b = low32(in_reg(mut o, i.b, "r11"))  // imul has no two-operand immediate form
    }
    emit(mut o, name + " " + low32(d) + ", " + b)
    set(mut o, e.dst, d)
    return true
}

// (x >> n) | u32(x << (32 - n)) for x known to fit in 32 bits, its parts
// read nowhere else and written consecutively: one 32-bit rotate. Returns
// how many instructions it covers, or 0 (arm64.vl matches the same shape).
fn rotate(o: mut Out, f: ir.Func, at: Int, reads: [Int], known: [Bool]) -> Int {
    let i = f.insts[at]
    if i.op != ir.Op.Shr || !known[i.a] || o.locs[i.b].kind != 2 || reads[i.dst] != 1 {
        return 0
    }
    let n = o.locs[i.b].off
    if n < 1 || n > 31 {
        return 0
    }
    // Constants between them are written where they are used: no code.
    let mut k = at + 1
    for k < len(f.insts) && f.insts[k].op == ir.Op.Const && o.locs[f.insts[k].dst].kind == 2 {
        k = k + 1
    }
    if k + 2 >= len(f.insts) {
        return 0
    }
    let l = f.insts[k]
    let e = f.insts[k + 1]
    let r = f.insts[k + 2]
    if l.op != ir.Op.Shl || l.a != i.a || o.locs[l.b].kind != 2 || o.locs[l.b].off != 32 - n || reads[l.dst] != 1 {
        return 0
    }
    if e.op != ir.Op.Extend || e.a != l.dst || e.imm != 32 || e.imm2 != 0 || reads[e.dst] != 1 {
        return 0
    }
    if r.op != ir.Op.Or || !(r.a == i.dst && r.b == e.dst || r.b == i.dst && r.a == e.dst) {
        return 0
    }
    let d = result_reg(o, r.dst)
    let x = operand32(mut o, i.a, "r11")
    if x != low32(d) {
        emit(mut o, "mov " + low32(d) + ", " + x)
    }
    emit(mut o, "ror " + low32(d) + ", " + num(n))
    set(mut o, r.dst, d)
    return k + 3 - at
}

// Instruction indexes in the order they are written. In `cold`, -k - 2
// stands for the label of the block the branch at k skips (cold_id).
type Layout = struct {
    main: [Int]
    cold: [Int]
    skips: Map[Int, Bool]  // branches whose fall-through block is cold
}

// The label number of the cold block the branch at k skips: above every
// IR label, so ir_label and the branch emitters take it as they are.
fn cold_id(k: Int) -> Int {
    return 1099511627776 + k
}

// The index after a straight-line run from `from` that ends by returning
// or being unreachable, or -1.
fn leaving_run(f: ir.Func, from: Int) -> Int {
    let mut j = from
    for j < len(f.insts) {
        let op = f.insts[j].op
        if op == ir.Op.Ret || op == ir.Op.Unreachable {
            return j + 1
        }
        if op == ir.Op.Label || op == ir.Op.Jump || op == ir.Op.Branch || op == ir.Op.BranchCmp {
            return -1
        }
        j = j + 1
    }
    return -1
}

// A cold block is straight-line code that ends by returning or by being
// unreachable: an early return or a failure, usually leaving a loop. It
// either starts at a label nothing falls into (the instruction before it
// never continues), or is what a BranchCmp falls into when its target is
// the label right after the block; that branch then jumps to the block on
// the opposite condition. Every value keeps one location for its whole
// interval, so where its code is written does not change what it reads.
fn layout(f: ir.Func) -> Layout {
    let n = len(f.insts)
    let mut main: [Int] = []
    let mut cold: [Int] = []
    let mut skips: Map[Int, Bool] = [:]
    let mut k = 0
    for k < n {
        let i = f.insts[k]
        if i.op == ir.Op.Label && k > 0 && leaves(f.insts[k - 1].op) {
            let end = leaving_run(f, k + 1)
            if end > 0 {
                for c in k..end {
                    push(mut cold, c)
                }
                k = end
                continue
            }
        }
        push(mut main, k)
        // A Branch falls to the label right after it, its false target.
        let mut from = -1
        if i.op == ir.Op.BranchCmp {
            from = k + 1
        } else if i.op == ir.Op.Branch && k + 1 < n && f.insts[k + 1].op == ir.Op.Label && f.insts[k + 1].imm == i.imm2 {
            from = k + 2
        }
        if from > 0 {
            let end = leaving_run(f, from)
            if end > k + 1 && end < n && f.insts[end].op == ir.Op.Label && f.insts[end].imm == i.imm {
                skips[k] = true
                push(mut cold, -k - 2)
                for c in k + 1..end {
                    push(mut cold, c)
                }
                // The branch now falls into its target, whatever precedes
                // that label in f: it stays in place.
                push(mut main, end)
                k = end + 1
                continue
            }
        }
        k = k + 1
    }
    return Layout { main: main, cold: cold, skips: skips }
}

fn leaves(op: ir.Op) -> Bool {
    return op == ir.Op.Jump || op == ir.Op.Ret || op == ir.Op.Unreachable
}

// The label written right after position p of `seq`, or -1.
fn label_after(f: ir.Func, seq: [Int], p: Int) -> Int {
    if p + 1 < len(seq) && seq[p + 1] >= 0 && f.insts[seq[p + 1]].op == ir.Op.Label {
        return f.insts[seq[p + 1]].imm
    }
    return -1
}

// The instructions at seq's indexes, in order. Peepholes cover instructions
// adjacent in both f and seq: a cold block's label follows an instruction
// that no peephole starts with.
fn body(o: mut Out, f: ir.Func, seq: [Int], skips: Map[Int, Bool], reads: [Int], known: [Bool]) {
    let mut p = 0
    for p < len(seq) {
        let k = seq[p]
        if k < 0 {
            push(mut o.lines, ir_label(o, cold_id(-k - 2)) + ":")
            p = p + 1
            continue
        }
        let i = f.insts[k]
        if i.op == ir.Op.BranchCmp && maps.has(skips, k) {
            compare(mut o, i)
            emit(mut o, "j" + negated(branch_suffix(i.sym)) + " " + ir_label(o, cold_id(k)))
            p = p + 1
            continue
        }
        if i.op == ir.Op.Branch && maps.has(skips, k) {
            // Its true target is written next; false goes to the cold block.
            let mut b = i
            b.imm2 = cold_id(k)
            instruction(mut o, f, b, i.imm)
            p = p + 1
            continue
        }
        let folded = indexed(mut o, f, seq, p, reads)
        if folded > 0 {
            p = p + folded
            continue
        }
        if i.op == ir.Op.Load && i.imm2 == 4 && reads[i.dst] == 1 && p + 1 < len(seq) && seq[p + 1] == k + 1 &&
            zero32(f.insts[k + 1], i.dst) {
            let e = f.insts[k + 1]
            let d = result_reg(o, e.dst)
            emit(mut o, "mov " + low32(d) + ", " + mem(mut o, i.a, i.imm, 4, "r11"))
            set(mut o, e.dst, d)
            p = p + 2
            continue
        }
        if i.op == ir.Op.FLoad && reads[i.dst] == 1 && p + 1 < len(seq) && seq[p + 1] == k + 1 &&
            float_operand(mut o, i, f.insts[k + 1]) {
            p = p + 2
            continue
        }
        let rotating = rotate(mut o, f, k, reads, known)
        if rotating > 0 {
            p = p + rotating
            continue
        }
        if i.dst >= 0 && reads[i.dst] == 1 && k + 1 < len(f.insts) && narrow(mut o, i, f.insts[k + 1]) {
            p = p + 2
            continue
        }
        // A comparison only a branch right after it reads: one cmp and jump.
        if k + 1 < len(f.insts) && fusable(i) && f.insts[k + 1].op == ir.Op.Branch && f.insts[k + 1].a == i.dst &&
            reads[i.dst] == 1 {
            let mut b = f.insts[k + 1]
            let mut next = label_after(f, seq, p + 1)
            if maps.has(skips, k + 1) {
                b.imm2 = cold_id(k + 1)
                next = b.imm
            }
            fused(mut o, i, b, next)
            p = p + 2
            continue
        }
        // A compare and branch, then a jump, then the branch's own target:
        // one jump on the opposite condition.
        if i.op == ir.Op.BranchCmp && p + 1 < len(seq) && seq[p + 1] == k + 1 && f.insts[k + 1].op == ir.Op.Jump &&
            label_after(f, seq, p + 1) == i.imm && f.insts[k + 1].imm != i.imm {
            compare(mut o, i)
            emit(mut o, "j" + negated(branch_suffix(i.sym)) + " " + ir_label(o, f.insts[k + 1].imm))
            p = p + 2
            continue
        }
        instruction(mut o, f, i, label_after(f, seq, p))
        p = p + 1
    }
}

// A Float load only the arithmetic right after it reads: the arithmetic
// reads the memory itself (subsd xmm1, qword ptr [rax + 8]). Addition and
// multiplication take the loaded value on either side.
fn float_operand(o: mut Out, load: ir.Inst, e: ir.Inst) -> Bool {
    if !(e.op == ir.Op.FAdd || e.op == ir.Op.FSub || e.op == ir.Op.FMul || e.op == ir.Op.FDiv) || e.a == e.b {
        return false
    }
    let mut other = e.a
    if e.b != load.dst {
        if e.a != load.dst || e.op == ir.Op.FSub || e.op == ir.Op.FDiv {
            return false
        }
        other = e.b
    }
    let name = match e.op {
        ir.Op.FAdd => "addsd"
        ir.Op.FSub => "subsd"
        ir.Op.FMul => "mulsd"
        _ => "divsd"
    }
    let d = fresult(o, e.dst)
    let lo = o.locs[other]
    if lo.kind == 0 {
        if lo.reg != d {
            emit(mut o, "movapd " + d + ", " + lo.reg)
        }
    } else {
        emit(mut o, "movsd " + d + ", " + fsrc(o, other))
    }
    emit(mut o, name + " " + d + ", " + mem(mut o, load.a, load.imm, 8, "r11"))
    fset(mut o, e.dst, d)
    return true
}

// Whether e zero-extends the low 32 bits of v.
fn zero32(e: ir.Inst, v: Int) -> Bool {
    return e.op == ir.Op.Extend && e.a == v && e.imm == 32 && e.imm2 == 0
}

// base + index * scale, then a load or store through it, with the product
// and the address read nowhere else: one scaled-index memory operand.
// Returns how many positions of seq it covers, or 0.
fn indexed(o: mut Out, f: ir.Func, seq: [Int], p: Int, reads: [Int]) -> Int {
    let k = seq[p]
    if p + 2 >= len(seq) || seq[p + 1] != k + 1 || seq[p + 2] != k + 2 {
        return 0
    }
    let m = f.insts[k]
    let a = f.insts[k + 1]
    let u = f.insts[k + 2]
    if m.op != ir.Op.MulImm || !(m.imm == 1 || m.imm == 2 || m.imm == 4 || m.imm == 8) || reads[m.dst] != 1 {
        return 0
    }
    if a.op != ir.Op.Add || reads[a.dst] != 1 || a.a == a.b || !(a.a == m.dst || a.b == m.dst) {
        return 0
    }
    let memory = u.op == ir.Op.Load || u.op == ir.Op.Store || u.op == ir.Op.FLoad || u.op == ir.Op.FStore
    if !memory || u.a != a.dst || !fits32(u.imm) {
        return 0
    }
    let mut base = a.a
    if base == m.dst {
        base = a.b
    }
    let mut size = u.imm2
    if u.op == ir.Op.FLoad || u.op == ir.Op.FStore {
        size = 8
    }
    let mut disp = ""
    if u.imm > 0 {
        disp = " + " + num(u.imm)
    } else if u.imm < 0 {
        disp = " - " + num(0 - u.imm)
    }
    let operand = ptr_word(size) + "[" + in_reg(mut o, base, "r11") + " + " + in_reg(mut o, m.a, "rdx") + "*" + num(m.imm) + disp + "]"
    if u.op == ir.Op.FLoad {
        let mut d = "xmm15"
        if o.locs[u.dst].kind == 0 {
            d = o.locs[u.dst].reg
        }
        emit(mut o, "movsd " + d + ", " + operand)
        fset(mut o, u.dst, d)
        return 3
    }
    if u.op == ir.Op.FStore {
        emit(mut o, "movsd " + operand + ", " + fin_reg(mut o, u.b, "xmm15"))
        return 3
    }
    if u.op == ir.Op.Store {
        let l = o.locs[u.b]
        let mut v = ""
        if l.kind == 2 && fits32(l.off) {
            v = num(l.off)
        } else {
            v = sized(in_reg(mut o, u.b, "rax"), size)
        }
        emit(mut o, "mov " + operand + ", " + v)
        return 3
    }
    // A u32 element read once and zero-extended: a 32-bit load clears the rest.
    if size == 4 && reads[u.dst] == 1 && p + 3 < len(seq) && seq[p + 3] == k + 3 && zero32(f.insts[k + 3], u.dst) {
        let e = f.insts[k + 3]
        let d = result_reg(o, e.dst)
        emit(mut o, "mov " + low32(d) + ", " + operand)
        set(mut o, e.dst, d)
        return 4
    }
    let d = result_reg(o, u.dst)
    if size == 1 || size == 2 {
        emit(mut o, "movzx " + low32(d) + ", " + operand)
    } else if size == 4 {
        emit(mut o, "movsxd " + d + ", " + operand)
    } else {
        emit(mut o, "mov " + d + ", " + operand)
    }
    set(mut o, u.dst, d)
    return 3
}

fn fusable(i: ir.Inst) -> Bool {
    if i.op == ir.Op.Cmp || i.op == ir.Op.CmpImm {
        return true
    }
    // For Floats only the comparisons whose jump is false for NaN.
    return i.op == ir.Op.FCmp && i.imm >= 2
}

fn negated(cc: Str) -> Str {
    return match cc {
        "e" => "ne"
        "ne" => "e"
        "l" => "ge"
        "ge" => "l"
        "le" => "g"
        "g" => "le"
        "a" => "be"
        "ae" => "b"
        "be" => "a"
        _ => "ae"
    }
}

// The comparison c and the branch b on it, as a compare and a jump.
fn fused(o: mut Out, c: ir.Inst, b: ir.Inst, next: Int) {
    let mut cc = ""
    if c.op == ir.Op.FCmp {
        if c.imm >= 4 {
            emit(mut o, "ucomisd " + fin_reg(mut o, c.a, "xmm15") + ", " + fsrc(o, c.b))
        } else {
            emit(mut o, "ucomisd " + fin_reg(mut o, c.b, "xmm15") + ", " + fsrc(o, c.a))
        }
        if c.imm == 2 || c.imm == 4 {
            cc = "a"
        } else {
            cc = "ae"
        }
    } else {
        let a = in_reg(mut o, c.a, "rax")
        if c.op == ir.Op.Cmp {
            let lb = o.locs[c.b]
            if lb.kind == 2 && fits32(lb.off) {
                emit(mut o, "cmp " + a + ", " + num(lb.off))
            } else {
                emit(mut o, "cmp " + a + ", " + src(mut o, c.b, "r11"))
            }
        } else if fits32(c.imm2) {
            emit(mut o, "cmp " + a + ", " + num(c.imm2))
        } else {
            emit(mut o, "movabs r11, " + num(c.imm2))
            emit(mut o, "cmp " + a + ", r11")
        }
        cc = cond_suffix(c.imm)
    }
    if b.imm2 == next {
        emit(mut o, "j" + cc + " " + ir_label(o, b.imm))
    } else if b.imm == next {
        emit(mut o, "j" + negated(cc) + " " + ir_label(o, b.imm2))
    } else {
        emit(mut o, "j" + cc + " " + ir_label(o, b.imm))
        emit(mut o, "jmp " + ir_label(o, b.imm2))
    }
}

// The cmp of a BranchCmp.
fn compare(o: mut Out, i: ir.Inst) {
    let a = in_reg(mut o, i.a, "rax")
    let lb = o.locs[i.b]
    if lb.kind == 2 && fits32(lb.off) {
        emit(mut o, "cmp " + a + ", " + num(lb.off))
    } else {
        emit(mut o, "cmp " + a + ", " + src(mut o, i.b, "r11"))
    }
}

fn slot_offset(f: ir.Func, o: Out, slot: Int) -> Int {
    let mut at = 8 * len(o.saved)
    for s in 0..slot + 1 {
        at = align_up(at + f.slot_sizes[s], f.slot_aligns[s])
    }
    return at
}

// size bytes from the address in register b to the one in register a.
fn copy(o: mut Out, a: Int, b: Int, size: Int) {
    if size > 256 {
        let d = src(mut o, a, "rdi")
        if d != "rdi" {
            emit(mut o, "mov rdi, " + d)
        }
        let s = src(mut o, b, "rsi")
        if s != "rsi" {
            emit(mut o, "mov rsi, " + s)
        }
        emit(mut o, "mov ecx, " + num(size))
        emit(mut o, "rep movsb")
        return
    }
    let mut at = 0
    for at + 8 <= size {
        emit(mut o, "mov rax, " + mem(mut o, b, at, 8, "r11"))
        emit(mut o, "mov " + mem(mut o, a, at, 8, "rdx") + ", rax")
        at = at + 8
    }
    if at + 4 <= size {
        emit(mut o, "mov eax, " + mem(mut o, b, at, 4, "r11"))
        emit(mut o, "mov " + mem(mut o, a, at, 4, "rdx") + ", eax")
        at = at + 4
    }
    for at < size {
        emit(mut o, "movzx eax, " + mem(mut o, b, at, 1, "r11"))
        emit(mut o, "mov " + mem(mut o, a, at, 1, "rdx") + ", al")
        at = at + 1
    }
}

// A call: the arguments where the convention wants them, then the call,
// then the result where the IR wants it.
fn call(o: mut Out, f: ir.Func, i: ir.Inst) {
    let mut ni = 0
    let mut nf = 0
    let mut stack = 0
    let ccall = i.op == ir.Op.CCall
    if ccall && i.imm == ir.RET_STR() {
        let d = src(mut o, i.a, "rdi")
        if d != "rdi" {
            emit(mut o, "mov rdi, " + d)
        }
        ni = 1
    }
    for k in 0..len(i.args) {
        let v = i.args[k]
        let mut kind = ir.KIND_INT()
        if ccall {
            kind = i.kinds[k]
        } else if f.classes[v] == ir.FLOAT() {
            kind = ir.KIND_FLOAT()
        }
        if kind == ir.KIND_STR() {
            // A vela_str by value: its 24 bytes on the stack.
            for w in 0..3 {
                emit(mut o, "mov rax, " + mem(mut o, v, 8 * w, 8, "r11"))
                emit(mut o, "mov qword ptr [rsp + " + num(stack + 8 * w) + "], rax")
            }
            stack = stack + 24
        } else if kind == ir.KIND_FLOAT() || kind == ir.KIND_FLOAT32() {
            if nf < 8 {
                let s = fsrc(o, v)
                if kind == ir.KIND_FLOAT32() { emit(mut o, "cvtsd2ss xmm" + num(nf) + ", " + s) } else { emit(mut o, "movsd xmm" + num(nf) + ", " + s) }
                nf = nf + 1
            } else {
                if kind == ir.KIND_FLOAT32() {
                    emit(mut o, "cvtsd2ss xmm15, " + fsrc(o, v))
                    emit(mut o, "movss dword ptr [rsp + " + num(stack) + "], xmm15")
                } else {
                    emit(mut o, "movsd xmm15, " + fsrc(o, v))
                    emit(mut o, "movsd qword ptr [rsp + " + num(stack) + "], xmm15")
                }
                stack = stack + 8
            }
        } else if ni < 6 {
            let r = int_arg(ni)
            let s = src(mut o, v, r)
            if s != r {
                emit(mut o, "mov " + r + ", " + s)
            }
            ni = ni + 1
        } else {
            emit(mut o, "mov rax, " + src(mut o, v, "rax"))
            emit(mut o, "mov qword ptr [rsp + " + num(stack) + "], rax")
            stack = stack + 8
        }
    }
    if i.op == ir.Op.CallInd {
        emit(mut o, "mov r11, " + src(mut o, i.a, "r11"))
        emit(mut o, "call r11")
    } else if ccall {
        emit(mut o, "mov eax, " + num(nf))  // SysV variadic vector-register count
        emit(mut o, "call " + i.sym + "@PLT")
    } else {
        emit(mut o, "call " + i.sym)
    }
    if i.dst < 0 {
        return
    }
    if o.classes[i.dst] == ir.FLOAT() {
        if ccall && i.imm == ir.RET_FLOAT32() { emit(mut o, "cvtss2sd xmm0, xmm0") }
        fset(mut o, i.dst, "xmm0")
        return
    }
    if ccall && i.imm == ir.RET_BOOL() {
        emit(mut o, "movzx eax, al")
    }
    set(mut o, i.dst, "rax")
}
