// The parser: tokens in, a syntax tree out, with error recovery: one
// syntax error per statement, and parsing goes on after it.
//
// A syntax error is not an exception caught where the parser
// recovers. Here a function that can fail returns a Result, `?` passes the
// error up, and the recovery points (block, program) match on it. The
// parser's state is a `mut` parameter, so after an error it is exactly
// where the error left it.
import ast
import errors
import lexer
import integers
import strings

type Parser = struct {
    tokens: [lexer.Token]
    i: Int
    errors: [errors.CompileError]
    // How many `(` and `{` the current statement has opened and not yet
    // closed, for recovery.
    open_parens: Int
    open_braces: Int
    // True in the head of an `if`, `for` or `match`, where a `{` after a
    // name opens the body, not a struct literal.
    no_struct: Bool
    next_id: Int
}

pub type Parsed = struct {
    program: ast.Program  // as far as it could be parsed
    errors: [errors.CompileError]  // sorted
    next_id: Int  // the first id not used, for the next file
}

// `first_id` is the first node id to hand out; a program's files are parsed
// one after another, and ids are unique in the whole program.
pub fn parse(tokens: [lexer.Token], first_id: Int) -> Parsed {
    let mut p = Parser {
        tokens: tokens, i: 0, errors: [], open_parens: 0, open_braces: 0, no_struct: false, next_id: first_id,
    }
    let program = program(mut p)
    return Parsed { program: program, errors: errors.sorted(p.errors), next_id: p.next_id }
}

// ---- Binding powers (see Stage 0) ----

// The left binding power of an infix operator, or -1.
fn left_power(k: lexer.Kind) -> Int {
    return match k {
        lexer.Kind.OrOr => 2
        lexer.Kind.AndAnd => 4
        lexer.Kind.EqEq => 6
        lexer.Kind.NotEq => 6
        lexer.Kind.Lt => 6
        lexer.Kind.LtEq => 6
        lexer.Kind.Gt => 6
        lexer.Kind.GtEq => 6
        lexer.Kind.Pipe => 7
        lexer.Kind.Caret => 8
        lexer.Kind.Amp => 9
        lexer.Kind.Shl => 10
        lexer.Kind.Shr => 10
        lexer.Kind.Plus => 12
        lexer.Kind.Minus => 12
        lexer.Kind.Star => 20
        lexer.Kind.Slash => 20
        lexer.Kind.Percent => 20
        _ => -1
    }
}

fn is_comparison(k: lexer.Kind) -> Bool {
    return left_power(k) == 6
}

fn starts_expression(k: lexer.Kind) -> Bool {
    return match k {
        lexer.Kind.Int => true
        lexer.Kind.Float => true
        lexer.Kind.Bool => true
        lexer.Kind.Str => true
        lexer.Kind.Interp => true
        lexer.Kind.Byte => true
        lexer.Kind.LBracket => true
        lexer.Kind.Ident => true
        lexer.Kind.Minus => true
        lexer.Kind.Bang => true
        lexer.Kind.Tilde => true
        lexer.Kind.LParen => true
        lexer.Kind.Match => true
        lexer.Kind.If => true
        lexer.Kind.Fn => true
        _ => false
    }
}

// Unary `-` and `!`: `-a * b` is `(-a) * b`. Calls, fields, indexing and
// `?` bind tighter still (40).
fn prefix_power() -> Int {
    return 30
}

fn postfix_power() -> Int {
    return 40
}

// ---- Tokens ----

fn peek(p: Parser, ahead: Int) -> lexer.Token {
    let mut i = p.i + ahead
    if i > len(p.tokens) - 1 {
        i = len(p.tokens) - 1
    }
    return p.tokens[i]
}

fn advance(p: mut Parser) -> lexer.Token {
    let tok = p.tokens[p.i]
    if tok.kind != lexer.Kind.Eof {
        p.i = p.i + 1
    }
    if tok.kind == lexer.Kind.LParen {
        p.open_parens = p.open_parens + 1
    } else if tok.kind == lexer.Kind.RParen {
        p.open_parens = max0(p.open_parens - 1)
    } else if tok.kind == lexer.Kind.LBrace {
        p.open_braces = p.open_braces + 1
    } else if tok.kind == lexer.Kind.RBrace {
        p.open_braces = max0(p.open_braces - 1)
    }
    return tok
}

fn max0(n: Int) -> Int {
    if n < 0 {
        return 0
    }
    return n
}

fn error(tok: lexer.Token, code: Str, message: Str) -> errors.CompileError {
    return errors.at(tok.line, tok.col, code, message)
}

fn found(tok: lexer.Token) -> Str {
    return ", found " + lexer.describe(tok)
}

fn expect(p: mut Parser, kind: lexer.Kind, context: Str) -> Result[lexer.Token, errors.CompileError] {
    let tok = peek(p, 0)
    if tok.kind != kind {
        return Err(error(tok, "E2001", "expected '" + lexer.kind_name(kind) + "' " + context + found(tok)))
    }
    return Ok(advance(mut p))
}

fn expect_name(p: mut Parser, context: Str) -> Result[lexer.Token, errors.CompileError] {
    let tok = peek(p, 0)
    if tok.kind != lexer.Kind.Ident {
        return Err(error(tok, "E2002", "expected a name " + context + found(tok)))
    }
    return Ok(advance(mut p))
}

fn id(p: mut Parser) -> Int {
    p.next_id = p.next_id + 1
    return p.next_id - 1
}

fn expr(p: mut Parser, kind: ast.ExprKind, line: Int, col: Int) -> ast.Expr {
    return ast.Expr { kind: kind, line: line, col: col, id: id(mut p) }
}

fn stmt(p: mut Parser, kind: ast.StmtKind, line: Int, col: Int) -> ast.Stmt {
    return ast.Stmt { kind: kind, line: line, col: col, id: id(mut p) }
}

fn pattern_node(p: mut Parser, kind: ast.PatternKind, line: Int, col: Int) -> ast.Pattern {
    return ast.Pattern { kind: kind, line: line, col: col, id: id(mut p) }
}

// The items of a `{ ... }` list are separated by commas or newlines. Before
// each item: an error at the end of the file.
fn list_not_ended(p: Parser, what: Str) -> Result[Unit, errors.CompileError] {
    if peek(p, 0).kind == lexer.Kind.Eof {
        return Err(error(peek(p, 0), "E2003", "expected '}' to close the " + what + ", found end of file"))
    }
    return Ok(())
}

// After each item: a separator, or the closing `}`.
fn list_separator(p: mut Parser, what: Str) -> Result[Unit, errors.CompileError] {
    let tok = peek(p, 0)
    if tok.kind == lexer.Kind.Comma || tok.kind == lexer.Kind.Semi {
        advance(mut p)
    } else if tok.kind != lexer.Kind.RBrace {
        return Err(error(tok, "E2004", "expected ',' or a new line in the " + what + found(tok)))
    }
    return Ok(())
}

// ---- Declarations ----

fn program(p: mut Parser) -> ast.Program {
    let mut imports: [ast.Import] = []
    let mut types: [ast.TypeDecl] = []
    let mut fns: [ast.FnDecl] = []
    let mut tests: [ast.TestDecl] = []
    for peek(p, 0).kind != lexer.Kind.Eof {
        if peek(p, 0).kind == lexer.Kind.Semi {
            advance(mut p)
            continue
        }
        let start = p.i
        p.open_parens = 0
        p.open_braces = 0
        match declaration(mut p, mut imports, mut types, mut fns, mut tests) {
            Ok(_) => {}
            Err(e) => {
                errors.add(mut p.errors, e)
                skip_declaration(mut p, start)
            }
        }
    }
    return ast.Program { imports: imports, types: types, fns: fns, tests: tests }
}

fn declaration(p: mut Parser, imports: mut [ast.Import], types: mut [ast.TypeDecl], fns: mut [ast.FnDecl],
    tests: mut [ast.TestDecl]) -> Result[Unit, errors.CompileError] {
    let mut tok = peek(p, 0)
    if tok.kind == lexer.Kind.Import {
        advance(mut p)
        if len(types) > 0 || len(fns) > 0 || len(tests) > 0 {
            // Go's rule: the imports are all at the top.
            return Err(error(tok, "E2005", "imports must come before all declarations"))
        }
        let name = expect_name(mut p, "of a module after 'import'")?
        push(mut imports, ast.Import { name: name.text, line: name.line, col: name.col })
        end_of_item(mut p, "import")?
        return Ok(())
    }
    if tok.kind == lexer.Kind.Test {
        advance(mut p)
        let name = peek(p, 0)
        if name.kind != lexer.Kind.Str {
            return Err(error(name, "E2006", "expected the test's name, a string, after 'test'" + found(name)))
        }
        advance(mut p)
        let body = block(mut p, "to start the body of test " + name.text)?
        push(mut tests, ast.TestDecl { name: name.value, body: body, line: tok.line, col: tok.col })
        end_of_item(mut p, "test")?
        return Ok(())
    }
    let public = tok.kind == lexer.Kind.Pub
    if public {
        advance(mut p)
        tok = peek(p, 0)
    }
    if tok.kind == lexer.Kind.Ident && tok.text == "extern" {
        advance(mut p)
        if peek(p, 0).kind != lexer.Kind.Fn { return Err(error(peek(p, 0), "E2001", "expected fn after extern")) }
        let mut f = fn_decl_in(mut p, false)?
        f.public = public
        f.foreign = f.name
        if peek(p, 0).kind == lexer.Kind.Eq {
            advance(mut p)
            let symbol = expect(mut p, lexer.Kind.Str, "for the C symbol after '='")?
            if symbol.value == "" { return Err(error(symbol, "E3200", "a C symbol cannot be empty")) }
            f.foreign = symbol.value
        }
        f.body.end_line = peek(p, 0).line
        f.body.end_col = peek(p, 0).col
        push(mut fns, f)
    } else if tok.kind == lexer.Kind.Ident && tok.text == "const" {
        advance(mut p)
        let name = expect_name(mut p, "after 'const'")?
        let mut annotation: Option[ast.TypeName] = None
        if peek(p, 0).kind == lexer.Kind.Colon { advance(mut p); annotation = Some(type_name(mut p)?) }
        expect(mut p, lexer.Kind.Eq, "after the constant name and optional type")?
        let value = expression(mut p, 0)?
        let end = p.tokens[p.i - 1]
        let returned = stmt(mut p, ast.StmtKind.Return(Some(value)), name.line, name.col)
        push(mut fns, ast.FnDecl { constant: true, name: name.text, foreign: "", variadic: false, type_params: [],
            params: [], result: annotation, effects: [], effects_line: 0, effects_col: 0, requires: [], ensures: [],
            body: ast.Block { stmts: [returned], end_line: end.line, end_col: end.col + len(end.text) - 1 }, line: name.line, col: name.col, public: public })
    } else if tok.kind == lexer.Kind.Fn {
        let mut f = fn_decl(mut p)?
        f.public = public
        push(mut fns, f)
    } else if tok.kind == lexer.Kind.Type {
        let mut t = type_decl(mut p)?
        t.public = public
        push(mut types, t)
    } else if public {
        advance(mut p)  // so recovery does not stop at it, if it is `import`
        return Err(error(tok, "E2007", "expected 'fn', 'type' or 'const' after 'pub'" + found(tok)))
    } else {
        return Err(error(tok, "E2008", "expected 'fn', 'type' or 'const'" + found(tok) + "; only functions, types and constants " +
            "can be declared at the top level, and statements go inside functions"))
    }
    end_of_item(mut p, "declaration")?
    return Ok(())
}

// After an error at the top level, skip to the next declaration. Braces
// are counted, so a keyword inside a skipped body does not count.
fn skip_declaration(p: mut Parser, start: Int) {
    let mut braces = 0
    for peek(p, 0).kind != lexer.Kind.Eof {
        let k = peek(p, 0).kind
        let starts = k == lexer.Kind.Fn || k == lexer.Kind.Type || k == lexer.Kind.Pub || k == lexer.Kind.Import ||
            k == lexer.Kind.Test || k == lexer.Kind.Ident && peek(p, 0).text == "const" || k == lexer.Kind.Ident && peek(p, 0).text == "extern"
        if starts && braces == 0 && p.i > start {
            return
        }
        if k == lexer.Kind.LBrace {
            braces = braces + 1
        } else if k == lexer.Kind.RBrace {
            braces = max0(braces - 1)
        }
        advance(mut p)
    }
}

fn end_of_item(p: mut Parser, what: Str) -> Result[Unit, errors.CompileError] {
    let tok = peek(p, 0)
    if tok.kind == lexer.Kind.Semi {
        advance(mut p)
    } else if tok.kind != lexer.Kind.Eof && tok.kind != lexer.Kind.RBrace {
        return Err(error(tok, "E2009", "expected newline or ';' after " + what + found(tok)))
    }
    return Ok(())
}

fn fn_decl(p: mut Parser) -> Result[ast.FnDecl, errors.CompileError] {
    return fn_decl_in(mut p, true)
}

fn fn_decl_in(p: mut Parser, with_body: Bool) -> Result[ast.FnDecl, errors.CompileError] {
    advance(mut p)  // "fn"
    let mut name = expect_name(mut p, "after 'fn'")?
    if with_body && peek(p, 0).kind == lexer.Kind.Dot {
        advance(mut p)
        let method = expect_name(mut p, "after the receiver type and '.'")?
        name.text = name.text + "." + method.text
    }
    let type_params = type_params(mut p, name.text)?
    expect(mut p, lexer.Kind.LParen, "after the function name")?
    let mut params: [ast.Param] = []
    let mut variadic = false
    for peek(p, 0).kind != lexer.Kind.RParen {
        if !with_body && peek(p, 0).kind == lexer.Kind.DotDot {
            advance(mut p)
            expect(mut p, lexer.Kind.Dot, "to complete ...")?
            variadic = true
            break
        }
        let pname = expect_name(mut p, "for a parameter")?
        expect(mut p, lexer.Kind.Colon, "and a type after parameter '" + pname.text + "'")?
        let mutable = peek(p, 0).kind == lexer.Kind.Mut
        if mutable {
            advance(mut p)
        }
        // `f: scoped fn(T)` (M33): the function may call f but not keep it.
        let mut scoped = false
        let word = peek(p, 0)
        if word.kind == lexer.Kind.Ident && word.text == "scoped" && peek(p, 1).kind == lexer.Kind.Fn {
            if mutable {
                push(mut p.errors, error(word, "E2034", "a parameter cannot be both `mut` and `scoped`; a scoped function is only called"))
            }
            advance(mut p)
            scoped = !mutable
        }
        let t = type_name(mut p)?
        push(mut params, ast.Param { name: pname.text, ty: t, line: pname.line, col: pname.col, mutable: mutable, scoped: scoped })
        if peek(p, 0).kind != lexer.Kind.Comma {
            break
        }
        advance(mut p)
    }
    let tok = peek(p, 0)
    if tok.kind != lexer.Kind.RParen {
        return Err(error(tok, "E2010", "expected ',' or ')' in parameter list" + found(tok)))
    }
    advance(mut p)
    let mut result: Option[ast.TypeName] = None
    if peek(p, 0).kind == lexer.Kind.Arrow {
        advance(mut p)
        result = Some(type_name_in(mut p, false)?)
    }
    // `uses fs, os`, then `requires ...` and `ensures ...`, each of which
    // may start a new line.
    let mut effects: [Str] = []
    let mut effects_line = 0
    let mut effects_col = 0
    clause_line(mut p)
    if peek(p, 0).kind == lexer.Kind.Uses {
        let u = advance(mut p)
        effects_line = u.line
        effects_col = u.col
        for {
            let effect = expect_name(mut p, "for an effect after 'uses' (fs or os)")?
            push(mut effects, effect.text)
            if peek(p, 0).kind != lexer.Kind.Comma {
                break
            }
            advance(mut p)
        }
    }
    let mut requires: [ast.Expr] = []
    let mut ensures: [ast.Expr] = []
    for {
        clause_line(mut p)
        let tok = peek(p, 0)
        if tok.kind != lexer.Kind.Ident || tok.text != "requires" && tok.text != "ensures" {
            break
        }
        advance(mut p)
        let cond = head_expression(mut p)?
        if tok.text == "requires" {
            push(mut requires, cond)
        } else {
            push(mut ensures, cond)
        }
    }
    let mut body = ast.Block { stmts: [], end_line: name.line, end_col: name.col }
    if with_body { body = block(mut p, "to start the body of '" + name.text + "'")? }
    return Ok(ast.FnDecl {
        constant: false,
        name: name.text, foreign: "", variadic: variadic, type_params: type_params, params: params, result: result, effects: effects, effects_line: effects_line,
        effects_col: effects_col, requires: requires, ensures: ensures, body: body, line: name.line, col: name.col,
        public: false,
    })
}

fn type_decl(p: mut Parser) -> Result[ast.TypeDecl, errors.CompileError] {
    advance(mut p)  // "type"
    let name = expect_name(mut p, "after 'type'")?
    let params = type_params(mut p, name.text)?
    expect(mut p, lexer.Kind.Eq, "after 'type " + name.text + "'")?
    let kind = peek(p, 0)
    let mut decl = ast.TypeDecl {
        name: name.text, params: params, is_struct: true, is_interface: false, parents: [], methods: [], fields: [], variants: [], line: name.line, col: name.col,
        public: false, without: [],
    }
    if kind.kind == lexer.Kind.Ident && kind.text == "interface" {
        advance(mut p)
        decl.is_struct = false
        decl.is_interface = true
        if peek(p, 0).kind == lexer.Kind.Colon {
            advance(mut p)
            for {
                push(mut decl.parents, bound_name(mut p)?)
                if peek(p, 0).kind != lexer.Kind.Plus { break }
                advance(mut p)
            }
        }
        expect(mut p, lexer.Kind.LBrace, "after 'interface'")?
        for peek(p, 0).kind != lexer.Kind.RBrace {
            list_not_ended(p, "interface")?
            expect(mut p, lexer.Kind.Fn, "for an interface method")?
            p.i = p.i - 1
            push(mut decl.methods, fn_decl_in(mut p, false)?)
            list_separator(mut p, "interface")?
        }
        advance(mut p)
        return Ok(decl)
    }
    if kind.kind == lexer.Kind.Ident && kind.text == "struct" {
        advance(mut p)
        expect(mut p, lexer.Kind.LBrace, "after 'struct'")?
        for peek(p, 0).kind != lexer.Kind.RBrace {
            list_not_ended(p, "struct")?
            let fname = expect_name(mut p, "for a field")?
            expect(mut p, lexer.Kind.Colon, "and a type after field '" + fname.text + "'")?
            let t = type_name(mut p)?
            push(mut decl.fields, ast.FieldDecl { name: fname.text, ty: t, line: fname.line, col: fname.col })
            list_separator(mut p, "struct")?
        }
        advance(mut p)
        decl.without = without(mut p)?
        return Ok(decl)
    }
    if kind.kind == lexer.Kind.Ident && kind.text == "enum" {
        advance(mut p)
        expect(mut p, lexer.Kind.LBrace, "after 'enum'")?
        decl.is_struct = false
        for peek(p, 0).kind != lexer.Kind.RBrace {
            list_not_ended(p, "enum")?
            push(mut decl.variants, variant_decl(mut p)?)
            list_separator(mut p, "enum")?
        }
        advance(mut p)
        decl.without = without(mut p)?
        return Ok(decl)
    }
    return Err(error(kind, "E2011", "expected 'struct', 'enum' or 'interface' after 'type " + name.text + " ='" + found(kind)))
}

// `without Eq, Show` after a struct or enum body (M32): the interfaces it
// does not derive. `without Eq` also leaves out Ord and Key, which extend Eq.
fn without(p: mut Parser) -> Result[[Str], errors.CompileError] {
    let mut out: [Str] = []
    let t = peek(p, 0)
    if t.kind != lexer.Kind.Ident || t.text != "without" { return Ok(out) }
    advance(mut p)
    for {
        let name = peek(p, 0)
        if name.kind != lexer.Kind.Ident || name.text != "Eq" && name.text != "Ord" && name.text != "Key" && name.text != "Show" {
            return Err(error(name, "E2033", "expected Eq, Ord, Key or Show after 'without'" + found(name)))
        }
        for done in out {
            if done == name.text { return Err(error(name, "E2033", "'" + name.text + "' is listed twice after 'without'")) }
        }
        advance(mut p)
        push(mut out, name.text)
        if peek(p, 0).kind != lexer.Kind.Comma { break }
        advance(mut p)
    }
    return Ok(out)
}

// Skip the line end before `uses`, `requires` or `ensures` on a line of its
// own, which the newline rule ended with a `;`.
fn clause_line(p: mut Parser) {
    let t = peek(p, 0)
    if t.kind != lexer.Kind.Semi || t.text != "\n" {
        return
    }
    let next = peek(p, 1)
    if next.kind == lexer.Kind.Uses || next.kind == lexer.Kind.Ident && (next.text == "requires" || next.text == "ensures") {
        advance(mut p)
    }
}

// `[T, U: Ord]` after a function's or a type's name, or nothing.
fn type_params(p: mut Parser, owner: Str) -> Result[[ast.TypeParam], errors.CompileError] {
    let mut out: [ast.TypeParam] = []
    if peek(p, 0).kind != lexer.Kind.LBracket {
        return Ok(out)
    }
    advance(mut p)
    for {
        let name = expect_name(mut p, "for a type parameter of '" + owner + "'")?
        let mut bounds: [Str] = []
        if peek(p, 0).kind == lexer.Kind.Colon {
            advance(mut p)
            for {
                push(mut bounds, bound_name(mut p)?)
                if peek(p, 0).kind != lexer.Kind.Plus {
                    break
                }
                advance(mut p)
            }
        }
        push(mut out, ast.TypeParam { name: name.text, bounds: bounds, line: name.line, col: name.col })
        if peek(p, 0).kind != lexer.Kind.Comma {
            break
        }
        advance(mut p)
    }
    expect(mut p, lexer.Kind.RBracket, "after the type parameters of '" + owner + "'")?
    return Ok(out)
}

fn bound_name(p: mut Parser) -> Result[Str, errors.CompileError] {
    let first = expect_name(mut p, "for an interface bound")?
    let mut name = first.text
    if peek(p, 0).kind == lexer.Kind.Dot {
        advance(mut p)
        name = name + "." + expect_name(mut p, "after the module name in an interface bound")?.text
    }
    return Ok(name)
}

fn variant_decl(p: mut Parser) -> Result[ast.VariantDecl, errors.CompileError] {
    let name = expect_name(mut p, "for a variant")?
    let mut payload: [ast.TypeName] = []
    if peek(p, 0).kind == lexer.Kind.LParen {
        advance(mut p)
        for peek(p, 0).kind != lexer.Kind.RParen {
            push(mut payload, type_name(mut p)?)
            if peek(p, 0).kind != lexer.Kind.Comma {
                break
            }
            advance(mut p)
        }
        expect(mut p, lexer.Kind.RParen, "after the types of variant '" + name.text + "'")?
    }
    return Ok(ast.VariantDecl { name: name.text, payload: payload, line: name.line, col: name.col })
}

fn type_name(p: mut Parser) -> Result[ast.TypeName, errors.CompileError] {
    return type_name_in(mut p, true)
}

// A type; `uses` after a function type belongs to the type unless
// `with_uses` is false, as in a declaration's result type, where `uses`
// belongs to the declaration: `fn make() -> (fn() uses fs)` says otherwise.
fn type_name_in(p: mut Parser, with_uses: Bool) -> Result[ast.TypeName, errors.CompileError] {
    if peek(p, 0).kind == lexer.Kind.LParen {
        advance(mut p)
        let inner = type_name(mut p)?
        expect(mut p, lexer.Kind.RParen, "after a type in parentheses")?
        return Ok(inner)
    }
    if peek(p, 0).kind == lexer.Kind.Fn {
        // `fn(Int, Str) -> Bool`: the parameter types, then the result type
        // if there is one ("fn->" says there is, and it comes last).
        let open = advance(mut p)
        expect(mut p, lexer.Kind.LParen, "after 'fn' in a function type")?
        let mut args: [ast.TypeName] = []
        for peek(p, 0).kind != lexer.Kind.RParen {
            push(mut args, type_name(mut p)?)
            if peek(p, 0).kind != lexer.Kind.Comma {
                break
            }
            advance(mut p)
        }
        expect(mut p, lexer.Kind.RParen, "after the parameter types of a function type")?
        let mut name = "fn"
        if peek(p, 0).kind == lexer.Kind.Arrow {
            advance(mut p)
            push(mut args, type_name_in(mut p, with_uses)?)
            name = "fn->"
        }
        let mut effects: [Str] = []
        if with_uses && peek(p, 0).kind == lexer.Kind.Uses {
            advance(mut p)
            for {
                let effect = expect_name(mut p, "for an effect after 'uses' (fs, os or a parameter's name)")?
                push(mut effects, effect.text)
                if !more_effects(p) {
                    break
                }
                advance(mut p)
            }
        }
        return Ok(ast.TypeName { length: -1, name: name, args: args, line: open.line, col: open.col, module: "", effects: effects })
    }
    if peek(p, 0).kind == lexer.Kind.LBracket {
        let open = advance(mut p)
        let elem = type_name(mut p)?
        let mut length = -1
        let mut name = "[]"
        if peek(p, 0).kind == lexer.Kind.Semi && peek(p, 0).text == ";" {
            advance(mut p)
            let count = expect(mut p, lexer.Kind.Int, "for a fixed array length")?
            let parsed = integers.literal(count.text)
            if !parsed.valid || parsed.overflow || parsed.suffix != "" || parsed.bits < 0 || parsed.bits > 4096 {
                return Err(error(count, "E3210", "a fixed array length must be an integer literal from 0 to 4096"))
            }
            length = parsed.bits
            name = "[;]"
        }
        expect(mut p, lexer.Kind.RBracket, "after the element type of an array type")?
        return Ok(ast.TypeName { length: length, name: name, args: [elem], line: open.line, col: open.col, module: "", effects: [] })
    }
    let start = expect_name(mut p, "for a type")?
    let mut tok = start
    let mut module = ""
    if peek(p, 0).kind == lexer.Kind.Dot {
        advance(mut p)
        module = tok.text
        tok = expect_name(mut p, "for a type after '" + module + ".'")?
    }
    let mut args: [ast.TypeName] = []
    if peek(p, 0).kind == lexer.Kind.LBracket {
        advance(mut p)
        for {
            push(mut args, type_name(mut p)?)
            if peek(p, 0).kind != lexer.Kind.Comma {
                break
            }
            advance(mut p)
        }
        expect(mut p, lexer.Kind.RBracket, "after the type arguments of '" + tok.text + "'")?
    }
    return Ok(ast.TypeName { length: -1, name: tok.text, args: args, line: start.line, col: start.col, module: module, effects: [] })
}

// Whether the comma ahead goes on with a function type's effects: `uses fs,
// os` in a list of parameters or types, where a comma could also start the
// next one. An effect is a name in lower case on its own; a parameter
// (`g: ...`), a module's type (`json.Value`), a generic one (`Box[T]`) and a
// type in upper case are not.
fn more_effects(p: Parser) -> Bool {
    if peek(p, 0).kind != lexer.Kind.Comma {
        return false
    }
    let name = peek(p, 1)
    if name.kind != lexer.Kind.Ident || len(name.text) == 0 || name.text[0] < 'a' || name.text[0] > 'z' {
        return false
    }
    let after = peek(p, 2).kind
    return after != lexer.Kind.Colon && after != lexer.Kind.Dot && after != lexer.Kind.LBracket
}

// ---- Statements ----

fn block(p: mut Parser, context: Str) -> Result[ast.Block, errors.CompileError] {
    expect(mut p, lexer.Kind.LBrace, context)?
    // The block's statements count brackets from zero; the statement the
    // block belongs to gets its counts back afterwards.
    let saved_parens = p.open_parens
    let saved_braces = p.open_braces - 1
    let mut stmts: [ast.Stmt] = []
    for peek(p, 0).kind != lexer.Kind.RBrace {
        let tok = peek(p, 0)
        if tok.kind == lexer.Kind.Eof {
            // Every enclosing block hits this too; the error list keeps one
            // copy. If a statement already failed here, that error says it all.
            if !errors.has_error_at(p.errors, tok.line, tok.col) {
                errors.add(mut p.errors, error(tok, "E2012", "expected '}' to close the block, found end of file"))
            }
            p.open_parens = saved_parens
            p.open_braces = saved_braces
            return Ok(ast.Block { stmts: stmts, end_line: tok.line, end_col: tok.col })
        }
        if tok.kind == lexer.Kind.Semi {
            advance(mut p)
            continue
        }
        p.open_parens = 0
        p.open_braces = 0
        match statement_item(mut p, mut stmts) {
            Ok(_) => {}
            Err(e) => {
                errors.add(mut p.errors, e)
                skip_statement(mut p)
            }
        }
    }
    let close = advance(mut p)
    p.open_parens = saved_parens
    p.open_braces = saved_braces
    return Ok(ast.Block { stmts: stmts, end_line: close.line, end_col: close.col })
}

// A statement and what ends it; the statement is kept even when its end is wrong.
fn statement_item(p: mut Parser, stmts: mut [ast.Stmt]) -> Result[Unit, errors.CompileError] {
    if peek(p, 0).kind == lexer.Kind.Let && is_pattern_let(p) {
        for s in let_pattern(mut p)? {
            push(mut stmts, s)
        }
    } else {
        push(mut stmts, statement(mut p)?)
    }
    end_of_item(mut p, "statement")?
    return Ok(())
}

// ---- `let PATTERN = value else { ... }` (M31) ----

// Whether the `let` here names a pattern, not one variable.
fn is_pattern_let(p: Parser) -> Bool {
    let mut i = 1
    if peek(p, 1).kind == lexer.Kind.Mut {
        i = 2
    }
    if peek(p, i).kind != lexer.Kind.Ident {
        return false
    }
    let next = peek(p, i + 1).kind
    return next == lexer.Kind.LParen || next == lexer.Kind.Dot || next == lexer.Kind.LBrace
}

// The statements a pattern `let` stands for. The value goes into a hidden
// local; a match of it runs the `else` block (which must leave) when the
// pattern does not match; then each name the pattern binds is a `let` of a
// one-arm match that takes that part out:
//     let 0sN = value
//     match 0sN { PATTERN => {}, _ => ELSE }
//     let x = match 0sN { PATTERN => x }
// Without `else`, the pattern must match every value.
fn let_pattern(p: mut Parser) -> Result[[ast.Stmt], errors.CompileError] {
    let tok = advance(mut p)  // "let"
    if peek(p, 0).kind == lexer.Kind.Mut {
        return Err(error(peek(p, 0), "E2032", "a `let` with a pattern binds read-only names; copy one into a `let mut` after it"))
    }
    let pat = pattern(mut p)?
    let mut annotation: Option[ast.TypeName] = None
    if peek(p, 0).kind == lexer.Kind.Colon {
        advance(mut p)
        annotation = Some(type_name(mut p)?)
    }
    expect(mut p, lexer.Kind.Eq, "after the pattern")?
    let value = expression(mut p, 0)?
    let hidden = "0s" + strings.from_int(p.next_id)
    let mut out = [stmt(mut p, ast.StmtKind.Let(hidden, false, annotation, value), tok.line, tok.col)]
    let mut arms = [ast.Arm {
        pattern: copy_pattern(mut p, pat, ""), guard: None, sugar: "let",
        body: ast.ArmBody.Do(stmt(mut p, ast.StmtKind.Block(ast.Block { stmts: [], end_line: tok.line, end_col: tok.col }), tok.line, tok.col)),
        line: tok.line, col: tok.col,
    }]
    if peek(p, 0).kind == lexer.Kind.Else {
        let else_tok = advance(mut p)
        let b = block(mut p, "after 'else'")?
        push(mut arms, ast.Arm {
            pattern: pattern_node(mut p, ast.PatternKind.Wild, else_tok.line, else_tok.col), guard: None, sugar: "let",
            body: ast.ArmBody.Do(stmt(mut p, ast.StmtKind.Block(b), else_tok.line, else_tok.col)),
            line: else_tok.line, col: else_tok.col,
        })
    }
    let scrutinee = expr(mut p, ast.ExprKind.Name(hidden), pat.line, pat.col)
    push(mut out, stmt(mut p, ast.StmtKind.MatchStmt(scrutinee, arms), pat.line, pat.col))
    for bound in bound_names(pat) {
        let mut name = ""
        match bound.kind {
            ast.PatternKind.Bind(n) => name = n
            _ => {}
        }
        let one = copy_pattern(mut p, pat, name)
        let named = expr(mut p, ast.ExprKind.Name(name), bound.line, bound.col)
        let arm = ast.Arm { pattern: one, guard: None, sugar: "let-bind", body: ast.ArmBody.Value(named), line: bound.line, col: bound.col }
        let from = expr(mut p, ast.ExprKind.Name(hidden), bound.line, bound.col)
        let taken = expr(mut p, ast.ExprKind.Match(from, [arm]), bound.line, bound.col)
        push(mut out, stmt(mut p, ast.StmtKind.Let(name, false, None, taken), bound.line, bound.col))
    }
    return Ok(out)
}

// The names a pattern binds, in source order, where each is bound.
fn bound_names(pat: ast.Pattern) -> [ast.Pattern] {
    let mut out: [ast.Pattern] = []
    match pat.kind {
        ast.PatternKind.Bind(_) => push(mut out, pat)
        ast.PatternKind.Variant(_, _, _, _, args) => {
            for a in args {
                for b in bound_names(a) {
                    push(mut out, b)
                }
            }
        }
        ast.PatternKind.Struct(_, _, fields, _) => {
            for f in fields {
                for b in bound_names(f.pattern) {
                    push(mut out, b)
                }
            }
        }
        ast.PatternKind.Or(alternatives) => {
            for a in alternatives {
                for b in bound_names(a) {
                    push(mut out, b)
                }
            }
        }
        _ => {}
    }
    return out
}

// A copy of a pattern with new ids, binding only `keep` ("" for none):
// other names become `_`.
fn copy_pattern(p: mut Parser, pat: ast.Pattern, keep: Str) -> ast.Pattern {
    let mut kind = pat.kind
    match pat.kind {
        ast.PatternKind.Bind(name) => {
            if name != keep {
                kind = ast.PatternKind.Wild
            }
        }
        ast.PatternKind.Lit(e) => kind = ast.PatternKind.Lit(expr(mut p, e.kind, e.line, e.col))
        ast.PatternKind.Range(lo, hi) => {
            kind = ast.PatternKind.Range(expr(mut p, lo.kind, lo.line, lo.col), expr(mut p, hi.kind, hi.line, hi.col))
        }
        ast.PatternKind.Variant(module, enum, variant, parens, args) => {
            let mut copies: [ast.Pattern] = []
            for a in args {
                push(mut copies, copy_pattern(mut p, a, keep))
            }
            kind = ast.PatternKind.Variant(module, enum, variant, parens, copies)
        }
        ast.PatternKind.Struct(module, name, fields, rest) => {
            let mut copies: [ast.FieldPattern] = []
            for f in fields {
                push(mut copies, ast.FieldPattern { name: f.name, pattern: copy_pattern(mut p, f.pattern, keep), line: f.line, col: f.col })
            }
            kind = ast.PatternKind.Struct(module, name, copies, rest)
        }
        ast.PatternKind.Or(alternatives) => {
            let mut copies: [ast.Pattern] = []
            for a in alternatives {
                push(mut copies, copy_pattern(mut p, a, keep))
            }
            kind = ast.PatternKind.Or(copies)
        }
        ast.PatternKind.Wild => {}
    }
    return pattern_node(mut p, kind, pat.line, pat.col)
}

// After an error in a statement, skip to just after the next `;` outside
// any brackets, or to just before the `}` that closes the current block.
fn skip_statement(p: mut Parser) {
    let mut parens = p.open_parens
    let mut braces = p.open_braces
    for {
        let tok = peek(p, 0)
        if tok.kind == lexer.Kind.Eof || tok.kind == lexer.Kind.RBrace && braces == 0 {
            return
        }
        advance(mut p)
        if tok.kind == lexer.Kind.LParen {
            parens = parens + 1
        } else if tok.kind == lexer.Kind.RParen {
            parens = max0(parens - 1)
        } else if tok.kind == lexer.Kind.LBrace {
            braces = braces + 1
        } else if tok.kind == lexer.Kind.RBrace {
            braces = braces - 1
        } else if tok.kind == lexer.Kind.Semi && parens == 0 && braces == 0 {
            return
        }
    }
}

fn statement(p: mut Parser) -> Result[ast.Stmt, errors.CompileError] {
    let tok = peek(p, 0)
    let k = tok.kind
    if k == lexer.Kind.Ident && tok.text == "unsafe" && peek(p, 1).kind == lexer.Kind.LBrace {
        advance(mut p)
        return Ok(stmt(mut p, ast.StmtKind.Unsafe(block(mut p, "after unsafe")?), tok.line, tok.col))
    }
    if k == lexer.Kind.Let {
        return let_stmt(mut p)
    }
    if k == lexer.Kind.If {
        return if_stmt(mut p)
    }
    if k == lexer.Kind.For {
        return for_stmt(mut p)
    }
    if k == lexer.Kind.Match {
        advance(mut p)
        let scrutinee = head_expression(mut p)?
        expect(mut p, lexer.Kind.LBrace, "after the value being matched")?
        let arms = arms(mut p, true)?
        return Ok(stmt(mut p, ast.StmtKind.MatchStmt(scrutinee, arms), tok.line, tok.col))
    }
    if k == lexer.Kind.LBrace {
        let b = block(mut p, "")?
        return Ok(stmt(mut p, ast.StmtKind.Block(b), tok.line, tok.col))
    }
    if k == lexer.Kind.With {
        return with_stmt(mut p)
    }
    if k == lexer.Kind.Import {
        return Err(error(tok, "E2013", "imports go at the top of the file, before all declarations"))
    }
    if k == lexer.Kind.Else {
        // The newline rule put a `;` after the `}`, ending the `if`.
        return Err(error(tok, "E2014", "'else' must be on the same line as the '}' before it"))
    }
    return simple_statement(mut p)
}

// A statement that fits in a match arm: return, break, continue, a call,
// or an assignment.
fn simple_statement(p: mut Parser) -> Result[ast.Stmt, errors.CompileError] {
    let tok = peek(p, 0)
    if tok.kind == lexer.Kind.Break {
        advance(mut p)
        return Ok(stmt(mut p, ast.StmtKind.Break, tok.line, tok.col))
    }
    if tok.kind == lexer.Kind.Continue {
        advance(mut p)
        return Ok(stmt(mut p, ast.StmtKind.Continue, tok.line, tok.col))
    }
    if tok.kind == lexer.Kind.Return {
        advance(mut p)
        let next = peek(p, 0).kind
        let mut value: Option[ast.Expr] = None
        if next != lexer.Kind.Semi && next != lexer.Kind.RBrace && next != lexer.Kind.Comma {
            value = Some(expression(mut p, 0)?)
        }
        return Ok(stmt(mut p, ast.StmtKind.Return(value), tok.line, tok.col))
    }
    let e = expression(mut p, 0)?
    if peek(p, 0).kind == lexer.Kind.Eq {
        let eq = advance(mut p)
        let value = expression(mut p, 0)?
        return Ok(stmt(mut p, ast.StmtKind.Assign(e, value), eq.line, eq.col))
    }
    if peek(p, 0).kind == lexer.Kind.AssignOp {
        let op = advance(mut p)
        if !is_place(e) {
            return Err(error(op, "E2029", "'" + op.text + "' changes a place: a variable, a field or an index, such as `total " + op.text + " x`"))
        }
        let value = expression(mut p, 0)?
        return Ok(compound(mut p, e, op, value))
    }
    return Ok(stmt(mut p, ast.StmtKind.ExprStmt(e), e.line, e.col))
}

// ---- Compound assignment (M31) ----

// `place op= value` is `place = place op value`, except that each index in
// the place is evaluated once, before the value: into a hidden local, whose
// name starts with a digit so no source name can refer to it.
fn compound(p: mut Parser, place: ast.Expr, op: lexer.Token, value: ast.Expr) -> ast.Stmt {
    let mut lets: [ast.Stmt] = []
    let target = hoist_indexes(mut p, place, mut lets)
    let read = copy_place(mut p, target)
    let operator = op.text[0..len(op.text) - 1]
    let combined = expr(mut p, ast.ExprKind.Binary(operator, read, value), op.line, op.col)
    let assign = stmt(mut p, ast.StmtKind.Assign(target, combined), op.line, op.col)
    if len(lets) == 0 {
        return assign
    }
    push(mut lets, assign)
    let b = ast.Block { stmts: lets, end_line: op.line, end_col: op.col }
    return stmt(mut p, ast.StmtKind.Block(b), place.line, place.col)
}

// A name, or fields and indexes of one: what `op=` can change.
fn is_place(e: ast.Expr) -> Bool {
    return match e.kind {
        ast.ExprKind.Name(_) => true
        ast.ExprKind.Field(obj, _) => is_place(obj)
        ast.ExprKind.Index(obj, _) => is_place(obj)
        _ => false
    }
}

fn is_literal(e: ast.Expr) -> Bool {
    return match e.kind {
        ast.ExprKind.IntLit(_) => true
        ast.ExprKind.FixedIntLit(_, _, _) => true
        ast.ExprKind.ByteLit(_) => true
        ast.ExprKind.BoolLit(_) => true
        ast.ExprKind.StrLit(_) => true
        _ => false
    }
}

// The place with each index that is not a literal replaced by a hidden
// local, in source order; their `let`s are added to `lets`.
fn hoist_indexes(p: mut Parser, e: ast.Expr, lets: mut [ast.Stmt]) -> ast.Expr {
    match e.kind {
        ast.ExprKind.Field(obj, name) => {
            let inner = hoist_indexes(mut p, obj, mut lets)
            return expr(mut p, ast.ExprKind.Field(inner, name), e.line, e.col)
        }
        ast.ExprKind.Index(obj, i) => {
            let inner = hoist_indexes(mut p, obj, mut lets)
            let mut index = i
            if !is_literal(i) {
                let name = hidden_name(p)
                push(mut lets, stmt(mut p, ast.StmtKind.Let(name, false, None, i), i.line, i.col))
                index = expr(mut p, ast.ExprKind.Name(name), i.line, i.col)
            }
            return expr(mut p, ast.ExprKind.Index(inner, index), e.line, e.col)
        }
        _ => return e
    }
}

// A copy, with new ids, of a place hoist_indexes made: names, fields, and
// indexes that are names or literals.
fn copy_place(p: mut Parser, e: ast.Expr) -> ast.Expr {
    let kind = match e.kind {
        ast.ExprKind.Field(obj, name) => ast.ExprKind.Field(copy_place(mut p, obj), name)
        ast.ExprKind.Index(obj, i) => ast.ExprKind.Index(copy_place(mut p, obj), copy_place(mut p, i))
        _ => e.kind
    }
    return expr(mut p, kind, e.line, e.col)
}

// A local name no source can write: names start with a letter or `_`.
fn hidden_name(p: Parser) -> Str {
    return "0t" + strings.from_int(p.next_id)
}

// `with files = m, stdout = mut out { ... }`
fn with_stmt(p: mut Parser) -> Result[ast.Stmt, errors.CompileError] {
    let tok = advance(mut p)  // "with"
    let mut items: [ast.WithItem] = []
    for {
        let name = expect_name(mut p, "of what to fake after 'with' (files, args, env or stdout)")?
        expect(mut p, lexer.Kind.Eq, "after '" + name.text + "' in 'with'")?
        let mut value = ast.Expr { kind: ast.ExprKind.UnitLit, line: 0, col: 0, id: 0 }
        if peek(p, 0).kind == lexer.Kind.Mut {
            let m = advance(mut p)
            let place = head_expression(mut p)?
            value = expr(mut p, ast.ExprKind.MutArg(place), m.line, m.col)
        } else {
            value = head_expression(mut p)?
        }
        push(mut items, ast.WithItem { name: name.text, value: value, line: name.line, col: name.col })
        if peek(p, 0).kind != lexer.Kind.Comma {
            break
        }
        advance(mut p)
    }
    let body = block(mut p, "after what 'with' fakes")?
    return Ok(stmt(mut p, ast.StmtKind.With(items, body), tok.line, tok.col))
}

fn let_stmt(p: mut Parser) -> Result[ast.Stmt, errors.CompileError] {
    advance(mut p)  // "let"
    let mutable = peek(p, 0).kind == lexer.Kind.Mut
    if mutable {
        advance(mut p)
    }
    let mut after = "after 'let'"
    if mutable {
        after = "after 'let mut'"
    }
    let name = expect_name(mut p, after)?
    let mut annotation: Option[ast.TypeName] = None
    if peek(p, 0).kind == lexer.Kind.Colon {
        advance(mut p)
        annotation = Some(type_name(mut p)?)
    }
    let mut written = "let "
    if mutable {
        written = "let mut "
    }
    expect(mut p, lexer.Kind.Eq, "after '" + written + name.text + "'")?
    let value = expression(mut p, 0)?
    return Ok(stmt(mut p, ast.StmtKind.Let(name.text, mutable, annotation, value), name.line, name.col))
}

fn if_stmt(p: mut Parser) -> Result[ast.Stmt, errors.CompileError] {
    let tok = advance(mut p)  // "if"
    let cond = head_expression(mut p)?
    let then = block(mut p, "after the 'if' condition")?
    let mut otherwise = ast.Else.NoElse
    if peek(p, 0).kind == lexer.Kind.Else {
        advance(mut p)
        if peek(p, 0).kind == lexer.Kind.If {
            otherwise = ast.Else.ElseIf(if_stmt(mut p)?)
        } else {
            otherwise = ast.Else.ElseBlock(block(mut p, "or 'if' after 'else'")?)
        }
    }
    return Ok(stmt(mut p, ast.StmtKind.If(cond, then, otherwise), tok.line, tok.col))
}

fn for_stmt(p: mut Parser) -> Result[ast.Stmt, errors.CompileError] {
    let tok = advance(mut p)  // "for"
    if peek(p, 0).kind == lexer.Kind.LBrace {
        let body = block(mut p, "")?
        return Ok(stmt(mut p, ast.StmtKind.For(None, body), tok.line, tok.col))
    }
    if peek(p, 0).kind == lexer.Kind.Ident && peek(p, 1).kind == lexer.Kind.In {
        let name = advance(mut p)
        advance(mut p)  // "in"
        let start = head_expression(mut p)?
        if peek(p, 0).kind != lexer.Kind.DotDot {
            let body = block(mut p, "after the value being looped over")?
            return Ok(stmt(mut p, ast.StmtKind.ForEach(name.text, start, body), name.line, name.col))
        }
        advance(mut p)  // ".."
        let end = head_expression(mut p)?
        let body = block(mut p, "after the range")?
        return Ok(stmt(mut p, ast.StmtKind.ForRange(name.text, start, end, body), name.line, name.col))
    }
    let cond = head_expression(mut p)?
    let body = block(mut p, "after the 'for' condition")?
    return Ok(stmt(mut p, ast.StmtKind.For(Some(cond), body), tok.line, tok.col))
}

// ---- Match arms and patterns ----

// The arms of a match, after its `{`.
fn arms(p: mut Parser, is_stmt: Bool) -> Result[[ast.Arm], errors.CompileError] {
    let mut out: [ast.Arm] = []
    for peek(p, 0).kind != lexer.Kind.RBrace {
        list_not_ended(p, "match")?
        push(mut out, arm(mut p, is_stmt)?)
        list_separator(mut p, "match")?
    }
    advance(mut p)
    return Ok(out)
}

fn arm(p: mut Parser, is_stmt: Bool) -> Result[ast.Arm, errors.CompileError] {
    let pat = pattern(mut p)?
    let mut guard: Option[ast.Expr] = None
    if peek(p, 0).kind == lexer.Kind.If {
        advance(mut p)
        guard = Some(nested_expression(mut p)?)
    }
    let arrow = expect(mut p, lexer.Kind.FatArrow, "after the pattern")?
    if !is_stmt {
        if peek(p, 0).kind == lexer.Kind.LBrace {
            let body = value_block(mut p)?
            return Ok(ast.Arm { pattern: pat, guard: guard, sugar: "", body: body, line: arrow.line, col: arrow.col })
        }
        let value = nested_expression(mut p)?
        return Ok(ast.Arm { pattern: pat, guard: guard, sugar: "", body: ast.ArmBody.Value(value), line: arrow.line, col: arrow.col })
    }
    let body = arm_statement(mut p)?
    return Ok(ast.Arm { pattern: pat, guard: guard, sugar: "", body: ast.ArmBody.Do(body), line: arrow.line, col: arrow.col })
}

// `{ statements; value }` in a match expression's arm (M31): the value is
// the last statement, when it is an expression.
fn value_block(p: mut Parser) -> Result[ast.ArmBody, errors.CompileError] {
    let b = block(mut p, "")?
    return Ok(block_body(mut p, b))
}

// A match statement's arm: a block, a nested match statement, or a simple statement.
fn arm_statement(p: mut Parser) -> Result[ast.Stmt, errors.CompileError] {
    let next = peek(p, 0)
    if next.kind == lexer.Kind.LBrace {
        let b = block(mut p, "")?
        return Ok(stmt(mut p, ast.StmtKind.Block(b), next.line, next.col))
    }
    if next.kind == lexer.Kind.Match {
        return statement(mut p)
    }
    return simple_statement(mut p)
}

fn is_builtin_variant(name: Str) -> Bool {
    return name == "None" || name == "Some" || name == "Ok" || name == "Err"
}

// `Name { x, y: pattern, .. }` (M31), at its `{`.
fn struct_pattern(p: mut Parser, start: lexer.Token, module: Str, name: lexer.Token) -> Result[ast.Pattern, errors.CompileError] {
    advance(mut p)  // "{"
    let mut written = name.text
    if module != "" {
        written = module + "." + name.text
    }
    let what = "'" + written + "' pattern"
    let mut fields: [ast.FieldPattern] = []
    let mut rest = false
    for peek(p, 0).kind != lexer.Kind.RBrace {
        list_not_ended(p, what)?
        if peek(p, 0).kind == lexer.Kind.DotDot {
            advance(mut p)
            rest = true
            if peek(p, 0).kind == lexer.Kind.Comma || peek(p, 0).kind == lexer.Kind.Semi {
                advance(mut p)
            }
            if peek(p, 0).kind != lexer.Kind.RBrace {
                return Err(error(peek(p, 0), "E2031", "'..' ends a struct pattern, after the fields it names" + found(peek(p, 0))))
            }
            break
        }
        let fname = expect_name(mut p, "for a field")?
        let mut sub = pattern_node(mut p, ast.PatternKind.Bind(fname.text), fname.line, fname.col)
        if peek(p, 0).kind == lexer.Kind.Colon {
            advance(mut p)
            sub = pattern(mut p)?
        }
        push(mut fields, ast.FieldPattern { name: fname.text, pattern: sub, line: fname.line, col: fname.col })
        list_separator(mut p, what)?
    }
    advance(mut p)  // "}"
    return Ok(pattern_node(mut p, ast.PatternKind.Struct(module, name.text, fields, rest), start.line, start.col))
}

// A pattern, or alternatives `A | B` (M31).
fn pattern(p: mut Parser) -> Result[ast.Pattern, errors.CompileError] {
    let first = single_pattern(mut p)?
    if peek(p, 0).kind != lexer.Kind.Pipe {
        return Ok(first)
    }
    let mut alternatives = [first]
    for peek(p, 0).kind == lexer.Kind.Pipe {
        advance(mut p)
        push(mut alternatives, single_pattern(mut p)?)
    }
    return Ok(pattern_node(mut p, ast.PatternKind.Or(alternatives), first.line, first.col))
}

fn single_pattern(p: mut Parser) -> Result[ast.Pattern, errors.CompileError] {
    let tok = peek(p, 0)
    let k = tok.kind
    if k == lexer.Kind.Int || k == lexer.Kind.Byte || k == lexer.Kind.Minus && peek(p, 1).kind == lexer.Kind.Int {
        let lo = number_literal(mut p)?
        if peek(p, 0).kind == lexer.Kind.DotDot {
            return Err(error(peek(p, 0), "E2015", "a range in a pattern includes its end: write ..= instead of .."))
        }
        if peek(p, 0).kind != lexer.Kind.DotDotEq {
            return Ok(pattern_node(mut p, ast.PatternKind.Lit(lo), tok.line, tok.col))
        }
        advance(mut p)
        let next = peek(p, 0).kind
        if next != lexer.Kind.Int && next != lexer.Kind.Byte && next != lexer.Kind.Minus {
            return Err(error(peek(p, 0), "E2016", "expected the end of the range" + found(peek(p, 0))))
        }
        let hi = number_literal(mut p)?
        return Ok(pattern_node(mut p, ast.PatternKind.Range(lo, hi), tok.line, tok.col))
    }
    if k == lexer.Kind.Bool {
        advance(mut p)
        let lit = expr(mut p, ast.ExprKind.BoolLit(tok.text == "true"), tok.line, tok.col)
        return Ok(pattern_node(mut p, ast.PatternKind.Lit(lit), tok.line, tok.col))
    }
    if k == lexer.Kind.Str {
        advance(mut p)
        let lit = expr(mut p, ast.ExprKind.StrLit(tok.value), tok.line, tok.col)
        return Ok(pattern_node(mut p, ast.PatternKind.Lit(lit), tok.line, tok.col))
    }
    if k != lexer.Kind.Ident {
        return Err(error(tok, "E2017", "expected a pattern" + found(tok)))
    }
    advance(mut p)
    if tok.text == "_" {
        return Ok(pattern_node(mut p, ast.PatternKind.Wild, tok.line, tok.col))
    }
    let mut module = ""
    let mut enum = ""
    let mut variant = tok
    if peek(p, 0).kind == lexer.Kind.Dot {
        advance(mut p)
        enum = tok.text
        variant = expect_name(mut p, "for a variant after '.'")?
        if peek(p, 0).kind == lexer.Kind.LBrace {  // module.Struct { ... }
            return struct_pattern(mut p, tok, enum, variant)
        }
        if peek(p, 0).kind == lexer.Kind.Dot {  // module.Enum.Variant
            advance(mut p)
            module = enum
            enum = variant.text
            variant = expect_name(mut p, "for a variant after '.'")?
        }
    } else if !is_builtin_variant(tok.text) {
        if peek(p, 0).kind == lexer.Kind.LBrace {  // Struct { ... }
            return struct_pattern(mut p, tok, "", tok)
        }
        return Ok(pattern_node(mut p, ast.PatternKind.Bind(tok.text), tok.line, tok.col))
    }
    let mut parens = false
    let mut args: [ast.Pattern] = []
    if peek(p, 0).kind == lexer.Kind.LParen {
        advance(mut p)
        parens = true
        for peek(p, 0).kind != lexer.Kind.RParen {
            push(mut args, pattern(mut p)?)
            if peek(p, 0).kind != lexer.Kind.Comma {
                break
            }
            advance(mut p)
        }
        expect(mut p, lexer.Kind.RParen, "after the patterns of '" + variant.text + "'")?
    }
    let kind = ast.PatternKind.Variant(module, enum, variant.text, parens, args)
    return Ok(pattern_node(mut p, kind, tok.line, tok.col))
}

fn integer_expr(p: mut Parser, tok: lexer.Token, negative: Bool, line: Int, col: Int) -> Result[ast.Expr, errors.CompileError] {
    let number = integers.literal(tok.text)
    let mut bits = number.bits
    if negative {
        if bits < 0 && bits != integers.min(1) {
            return Err(error(tok, "E3181", "negative literal is below the i64 minimum"))
        }
        if bits >= 0 { bits = -bits }
    }
    if number.suffix == "" && (bits >= 0 || negative) {
        return Ok(expr(mut p, ast.ExprKind.IntLit(bits), line, col))
    }
    return Ok(expr(mut p, ast.ExprKind.FixedIntLit(bits, number.suffix, negative), line, col))
}

// An Int literal (possibly negative) or a Byte literal, in a pattern.
fn number_literal(p: mut Parser) -> Result[ast.Expr, errors.CompileError] {
    let tok = advance(mut p)
    if tok.kind == lexer.Kind.Byte {
        return Ok(expr(mut p, ast.ExprKind.ByteLit(int(tok.value[0])), tok.line, tok.col))
    }
    if tok.kind == lexer.Kind.Minus {
        let num = advance(mut p)
        if num.kind != lexer.Kind.Int {
            return Err(error(num, "E2018", "expected a number after '-'" + found(num)))
        }
        return integer_expr(mut p, num, true, tok.line, tok.col)
    }
    return integer_expr(mut p, tok, false, tok.line, tok.col)
}

// ---- Expressions ----

// The expression before the `{` of an if, for or match body, where struct
// literals need parentheses.
fn head_expression(p: mut Parser) -> Result[ast.Expr, errors.CompileError] {
    let saved = p.no_struct
    p.no_struct = true
    let e = expression(mut p, 0)
    p.no_struct = saved
    return e
}

// An expression inside brackets, where struct literals are fine again.
fn nested_expression(p: mut Parser) -> Result[ast.Expr, errors.CompileError] {
    let saved = p.no_struct
    p.no_struct = false
    let e = expression(mut p, 0)
    p.no_struct = saved
    return e
}

// An expression whose operators all bind at least `min_bp` tightly.
fn expression(p: mut Parser, min_bp: Int) -> Result[ast.Expr, errors.CompileError] {
    let mut left = prefix(mut p)?
    let mut after_comparison = false
    for {
        let tok = peek(p, 0)
        let k = tok.kind
        let postfix = postfix_power() >= min_bp
        if k == lexer.Kind.LParen && postfix {
            left = call(mut p, left)?
        } else if k == lexer.Kind.Dot && postfix {
            advance(mut p)
            let name = expect_name(mut p, "after '.'")?
            left = expr(mut p, ast.ExprKind.Field(left, name.text), name.line, name.col)
        } else if k == lexer.Kind.LBracket && postfix {
            left = index(mut p, left)?
        } else if k == lexer.Kind.Question && postfix {
            advance(mut p)
            left = expr(mut p, ast.ExprKind.Try(left), tok.line, tok.col)
        } else if left_power(k) >= 0 && left_power(k) >= min_bp {
            if is_comparison(k) && after_comparison {
                return Err(error(tok, "E2019", "comparisons cannot be chained; use && to combine them, as in a < b && b < c"))
            }
            advance(mut p)
            let right = expression(mut p, left_power(k) + 1)?
            left = expr(mut p, ast.ExprKind.Binary(lexer.kind_name(k), left, right), tok.line, tok.col)
            after_comparison = is_comparison(k)
        } else {
            return Ok(left)
        }
    }
}

// The start of an expression: a literal, a name, a struct literal, a match,
// `-x`, `!x`, `()` or `( ... )`.
fn prefix(p: mut Parser) -> Result[ast.Expr, errors.CompileError] {
    let tok = peek(p, 0)
    if !starts_expression(tok.kind) {
        // Not consumed: in `return 1 +` before a `}`, the `}` still has to
        // close the block.
        return Err(error(tok, "E2020", "expected expression" + found(tok)))
    }
    advance(mut p)
    let k = tok.kind
    if k == lexer.Kind.Int {
        return integer_expr(mut p, tok, false, tok.line, tok.col)
    }
    if k == lexer.Kind.Float {
        return Ok(expr(mut p, ast.ExprKind.FloatLit(tok.text), tok.line, tok.col))
    }
    if k == lexer.Kind.Bool {
        return Ok(expr(mut p, ast.ExprKind.BoolLit(tok.text == "true"), tok.line, tok.col))
    }
    if k == lexer.Kind.Str {
        return Ok(expr(mut p, ast.ExprKind.StrLit(tok.value), tok.line, tok.col))
    }
    if k == lexer.Kind.Interp {
        return interpolated(mut p, tok)
    }
    if k == lexer.Kind.Byte {
        return Ok(expr(mut p, ast.ExprKind.ByteLit(int(tok.value[0])), tok.line, tok.col))
    }
    if k == lexer.Kind.LBracket {
        return collection_lit(mut p, tok)
    }
    if k == lexer.Kind.Ident {
        if peek(p, 0).kind == lexer.Kind.LBrace && !p.no_struct {
            return struct_lit(mut p, tok, "", tok)
        }
        if peek(p, 0).kind == lexer.Kind.Dot && peek(p, 1).kind == lexer.Kind.Ident &&
            peek(p, 2).kind == lexer.Kind.LBrace && !p.no_struct {
            advance(mut p)  // "."
            let name = advance(mut p)
            return struct_lit(mut p, tok, tok.text, name)
        }
        return Ok(expr(mut p, ast.ExprKind.Name(tok.text), tok.line, tok.col))
    }
    if k == lexer.Kind.Minus && peek(p, 0).kind == lexer.Kind.Int {
        let number = advance(mut p)
        return integer_expr(mut p, number, true, tok.line, tok.col)
    }
    if k == lexer.Kind.Minus || k == lexer.Kind.Bang || k == lexer.Kind.Tilde {
        let operand = expression(mut p, prefix_power())?
        return Ok(expr(mut p, ast.ExprKind.Unary(lexer.kind_name(k), operand), tok.line, tok.col))
    }
    if k == lexer.Kind.LParen && peek(p, 0).kind == lexer.Kind.RParen {
        advance(mut p)
        return Ok(expr(mut p, ast.ExprKind.UnitLit, tok.line, tok.col))
    }
    if k == lexer.Kind.Fn {
        return closure(mut p, tok)
    }
    if k == lexer.Kind.LParen {
        let inner = nested_expression(mut p)?
        let close = peek(p, 0)
        if close.kind != lexer.Kind.RParen {
            return Err(error(close, "E2021", "expected ')' to match '(' at " + strings.from_int(tok.line) + ":" +
                strings.from_int(tok.col) + found(close)))
        }
        advance(mut p)
        return Ok(inner)  // parentheses only group; they leave no node behind
    }
    if k == lexer.Kind.If {
        return if_expression(mut p, tok)
    }
    // `match`
    let scrutinee = head_expression(mut p)?
    expect(mut p, lexer.Kind.LBrace, "after the value being matched")?
    let arms = arms(mut p, false)?
    return Ok(expr(mut p, ast.ExprKind.Match(scrutinee, arms), tok.line, tok.col))
}

// ---- Values from control flow (M31) ----

// `if c { ... } else { ... }` as a value, after its `if`: a match of the
// condition, `true => then, false => else`, whose arms are the blocks'
// values. An `if` with a value needs an `else`.
fn if_expression(p: mut Parser, tok: lexer.Token) -> Result[ast.Expr, errors.CompileError] {
    let cond = head_expression(mut p)?
    let then = block(mut p, "after the 'if' condition")?
    if peek(p, 0).kind != lexer.Kind.Else {
        return Err(error(peek(p, 0), "E2030", "an 'if' that gives a value needs an 'else' for when its condition is false" +
            found(peek(p, 0))))
    }
    let else_tok = advance(mut p)
    let mut otherwise = ast.ArmBody.Value(cond)  // replaced below
    if peek(p, 0).kind == lexer.Kind.If {
        let inner = advance(mut p)
        otherwise = ast.ArmBody.Value(if_expression(mut p, inner)?)
    } else {
        otherwise = block_body(mut p, block(mut p, "or 'if' after 'else'")?)
    }
    return Ok(if_match(mut p, cond, block_body(mut p, then), otherwise, tok, else_tok))
}

fn if_match(p: mut Parser, cond: ast.Expr, then: ast.ArmBody, otherwise: ast.ArmBody, tok: lexer.Token, else_tok: lexer.Token) -> ast.Expr {
    let yes_lit = expr(mut p, ast.ExprKind.BoolLit(true), cond.line, cond.col)
    let yes = pattern_node(mut p, ast.PatternKind.Lit(yes_lit), cond.line, cond.col)
    let no_lit = expr(mut p, ast.ExprKind.BoolLit(false), else_tok.line, else_tok.col)
    let no = pattern_node(mut p, ast.PatternKind.Lit(no_lit), else_tok.line, else_tok.col)
    let arms = [
        ast.Arm { pattern: yes, guard: None, sugar: "if", body: then, line: tok.line, col: tok.col },
        ast.Arm { pattern: no, guard: None, sugar: "if", body: otherwise, line: else_tok.line, col: else_tok.col },
    ]
    return expr(mut p, ast.ExprKind.Match(cond, arms), tok.line, tok.col)
}

// A block as an arm's value: its last statement, when that is an
// expression, or an `if` or `match` statement with values in its branches.
fn block_body(p: mut Parser, b: ast.Block) -> ast.ArmBody {
    let n = len(b.stmts)
    if n > 0 {
        match trailing_value(mut p, b.stmts[n - 1]) {
            Some(e) => {
                let rest = ast.Block { stmts: b.stmts[0..n - 1], end_line: b.end_line, end_col: b.end_col }
                return ast.ArmBody.Valued(rest, Some(e))
            }
            None => {}
        }
    }
    return ast.ArmBody.Valued(b, None)
}

fn has_value(body: ast.ArmBody) -> Bool {
    match body {
        ast.ArmBody.Valued(_, value) => {
            match value {
                Some(_) => return true
                None => return false
            }
        }
        _ => return true
    }
}

// The value of a block's last statement, if it has one. An `if` with an
// `else` or a match statement becomes the value form of itself, unless no
// branch has a value: then the block leaves in every branch.
fn trailing_value(p: mut Parser, s: ast.Stmt) -> Option[ast.Expr] {
    match s.kind {
        ast.StmtKind.ExprStmt(e) => return Some(e)
        ast.StmtKind.If(cond, then, otherwise) => {
            let yes = block_body(mut p, then)
            let mut no = yes
            match otherwise {
                ast.Else.NoElse => return None
                ast.Else.ElseBlock(b) => no = block_body(mut p, b)
                ast.Else.ElseIf(inner) => {
                    match trailing_value(mut p, inner) {
                        Some(e) => no = ast.ArmBody.Value(e)
                        None => no = ast.ArmBody.Valued(ast.Block { stmts: [inner], end_line: inner.line, end_col: inner.col }, None)
                    }
                }
            }
            if !has_value(yes) && !has_value(no) {
                return None
            }
            let tok = lexer.Token { kind: lexer.Kind.If, text: "if", line: s.line, col: s.col, value: "" }
            let else_tok = lexer.Token { kind: lexer.Kind.Else, text: "else", line: then.end_line, col: then.end_col, value: "" }
            return Some(if_match(mut p, cond, yes, no, tok, else_tok))
        }
        ast.StmtKind.MatchStmt(scrutinee, arms) => {
            let mut out: [ast.Arm] = []
            let mut any = false
            for a in arms {
                let mut body = a.body
                match a.body {
                    ast.ArmBody.Do(st) => {
                        match st.kind {
                            ast.StmtKind.Block(b) => body = block_body(mut p, b)
                            _ => {
                                match trailing_value(mut p, st) {
                                    Some(e) => body = ast.ArmBody.Value(e)
                                    None => body = ast.ArmBody.Valued(ast.Block { stmts: [st], end_line: st.line, end_col: st.col }, None)
                                }
                            }
                        }
                    }
                    _ => {}
                }
                any = any || has_value(body)
                push(mut out, ast.Arm { pattern: a.pattern, guard: a.guard, sugar: a.sugar, body: body, line: a.line, col: a.col })
            }
            if !any {
                return None
            }
            return Some(expr(mut p, ast.ExprKind.Match(scrutinee, out), s.line, s.col))
        }
        _ => return None
    }
}

// Parse the source retained by the lexer for `f"..."`. Each hole is parsed
// by the ordinary expression parser, so calls, fields, operators and nested
// braces have the same grammar as elsewhere.
fn interpolated(p: mut Parser, tok: lexer.Token) -> Result[ast.Expr, errors.CompileError] {
    let mut parts: [ast.InterpolationPart] = []
    let mut text = ""
    let mut seg_start = 0  // where `text` starts in the literal's source
    let mut at = 0
    for at < len(tok.value) {
        let c = tok.value[at]
        if c == '\\' && at + 1 < len(tok.value) {
            let mut end = at + 2
            if tok.value[at + 1] == 'u' && end < len(tok.value) && tok.value[end] == '{' {
                end = end + 1
                for end < len(tok.value) && tok.value[end] != '}' { end = end + 1 }
                if end < len(tok.value) { end = end + 1 }
            }
            text = text + tok.value[at..end]
            at = end
            continue
        }
        if c == '{' && at + 1 < len(tok.value) && tok.value[at + 1] == '{' {
            text = text + "{"; at = at + 2; continue
        }
        if c == '}' && at + 1 < len(tok.value) && tok.value[at + 1] == '}' {
            text = text + "}"; at = at + 2; continue
        }
        if c == '}' {
            return Err(errors.at(tok.line, tok.col + 2 + at, "E2028", "a '}' in an interpolated string is written '}}'"))
        }
        if c != '{' {
            text = text + tok.value[at..at + 1]; at = at + 1; continue
        }
        if text != "" { push(mut parts, ast.InterpolationPart.Text(decoded_part(text, tok.value[seg_start..at], seg_start, tok)?)); text = "" }
        let open = at
        at = at + 1
        let start = at
        at = lexer.interpolation_hole_end(tok.value, start)
        if at >= len(tok.value) || tok.value[at] != '}' { return Err(errors.at(tok.line, tok.col + 2 + open, "E2026", "interpolated string expression is missing '}'")) }
        let source = tok.value[start..at]
        let mut lexed = lexer.tokenize(source)
        if len(lexed.errors) > 0 { return Err(errors.at(tok.line, tok.col + 2 + start + lexed.errors[0].col - 1, lexed.errors[0].code, lexed.errors[0].message)) }
        for i in 0..len(lexed.tokens) { lexed.tokens[i].line = tok.line; lexed.tokens[i].col = lexed.tokens[i].col + tok.col + 2 + start - 1 }
        let mut inner = Parser { tokens: lexed.tokens, i: 0, errors: [], open_parens: 0, open_braces: 0, no_struct: false, next_id: p.next_id }
        let parsed = expression(mut inner, 0)
        for diagnostic in inner.errors { push(mut p.errors, at_hole_end(diagnostic)) }
        let mut value = ast.Expr { id: 0, kind: ast.ExprKind.UnitLit, line: 0, col: 0 }
        match parsed {
            Ok(v) => value = v
            Err(e) => return Err(at_hole_end(e))
        }
        if peek(inner, 0).kind == lexer.Kind.Semi { advance(mut inner) }
        if peek(inner, 0).kind != lexer.Kind.Eof { return Err(error(peek(inner, 0), "E2027", "expected '}' after interpolated expression")) }
        p.next_id = inner.next_id
        push(mut parts, ast.InterpolationPart.Hole(value))
        at = at + 1
        seg_start = at
    }
    if text != "" { push(mut parts, ast.InterpolationPart.Text(decoded_part(text, tok.value[seg_start..len(tok.value)], seg_start, tok)?)) }
    if len(parts) == 0 { push(mut parts, ast.InterpolationPart.Text("")) }
    return Ok(expr(mut p, ast.ExprKind.Interpolate(parts), tok.line, tok.col))
}

// The text of a literal segment: `source` with `{{` and `}}` already made
// single braces, decoded as a string's body. An escape error is placed where
// it is in `raw`, the segment as written, which starts `raw_start` bytes into
// the literal's body: braces do not move escapes, so the raw text's error
// column is the right one.
fn decoded_part(source: Str, raw: Str, raw_start: Int, tok: lexer.Token) -> Result[Str, errors.CompileError] {
    let lexed = lexer.tokenize("\"" + source + "\"")
    if len(lexed.errors) > 0 {
        let mut col = tok.col
        let again = lexer.tokenize("\"" + raw + "\"")
        if len(again.errors) > 0 {
            col = tok.col + 2 + raw_start + again.errors[0].col - 2
        }
        return Err(errors.at(tok.line, col, lexed.errors[0].code, lexed.errors[0].message))
    }
    return Ok(lexed.tokens[0].value)
}

// A hole is parsed on its own tokens: its end is the '}' closing it, not
// the end of a file.
fn at_hole_end(e: errors.CompileError) -> errors.CompileError {
    let mut out = e
    let tail = "found end of file"
    let n = len(tail)
    if len(out.message) >= n && out.message[len(out.message) - n..len(out.message)] == tail {
        out.message = out.message[0..len(out.message) - n] + "found '}'"
    }
    return out
}

// `fn(x: Int, y) -> Int { ... }` or `fn(x) => x + 1`, after the `fn`.
fn closure(p: mut Parser, start: lexer.Token) -> Result[ast.Expr, errors.CompileError] {
    expect(mut p, lexer.Kind.LParen, "after 'fn' in a function value")?
    let mut params: [ast.ClosureParam] = []
    for peek(p, 0).kind != lexer.Kind.RParen {
        let name = expect_name(mut p, "for a parameter")?
        let mut ty: Option[ast.TypeName] = None
        if peek(p, 0).kind == lexer.Kind.Colon {
            advance(mut p)
            ty = Some(type_name(mut p)?)
        }
        push(mut params, ast.ClosureParam { name: name.text, ty: ty, line: name.line, col: name.col })
        if peek(p, 0).kind != lexer.Kind.Comma {
            break
        }
        advance(mut p)
    }
    expect(mut p, lexer.Kind.RParen, "after the parameters of a function value")?
    let mut result: Option[ast.TypeName] = None
    if peek(p, 0).kind == lexer.Kind.Arrow {
        advance(mut p)
        result = Some(type_name(mut p)?)
    }
    if peek(p, 0).kind == lexer.Kind.FatArrow {
        let arrow = advance(mut p)
        let value = nested_expression(mut p)?
        let ret = stmt(mut p, ast.StmtKind.Return(Some(value)), arrow.line, arrow.col)
        let body = ast.Block { stmts: [ret], end_line: arrow.line, end_col: arrow.col }
        return Ok(expr(mut p, ast.ExprKind.Closure(params, result, body, true), start.line, start.col))
    }
    let saved = p.no_struct
    p.no_struct = false
    let body = block(mut p, "or '=>' to start the body of a function value")
    p.no_struct = saved
    return Ok(expr(mut p, ast.ExprKind.Closure(params, result, body?, false), start.line, start.col))
}

// `obj[i]` or `obj[a..b]`, after `obj`.
fn index(p: mut Parser, obj: ast.Expr) -> Result[ast.Expr, errors.CompileError] {
    let open = advance(mut p)  // "["
    let first = nested_expression(mut p)?
    if peek(p, 0).kind == lexer.Kind.DotDot {
        advance(mut p)
        let end = nested_expression(mut p)?
        expect(mut p, lexer.Kind.RBracket, "after the slice")?
        return Ok(expr(mut p, ast.ExprKind.Slice(obj, first, end), open.line, open.col))
    }
    expect(mut p, lexer.Kind.RBracket, "after the index")?
    return Ok(expr(mut p, ast.ExprKind.Index(obj, first), open.line, open.col))
}

// An array `[a, b]` or a map `[k: v, ...]`, after its `[`.
fn collection_lit(p: mut Parser, open: lexer.Token) -> Result[ast.Expr, errors.CompileError] {
    if peek(p, 0).kind == lexer.Kind.Colon && peek(p, 1).kind == lexer.Kind.RBracket {
        advance(mut p)
        advance(mut p)
        return Ok(expr(mut p, ast.ExprKind.MapLit([]), open.line, open.col))
    }
    let mut elems: [ast.Expr] = []
    let mut entries: [ast.MapEntry] = []
    for peek(p, 0).kind != lexer.Kind.RBracket {
        if peek(p, 0).kind == lexer.Kind.Eof {
            return Err(error(peek(p, 0), "E2022", "expected ']' to close the list, found end of file"))
        }
        let item = nested_expression(mut p)?
        if peek(p, 0).kind == lexer.Kind.Colon && len(elems) == 0 {
            advance(mut p)
            let value = nested_expression(mut p)?
            push(mut entries, ast.MapEntry { key: item, value: value })
        } else if len(entries) > 0 {
            return Err(error(peek(p, 0), "E2023", "expected ':' and a value after this key" + found(peek(p, 0))))
        } else {
            push(mut elems, item)
        }
        let tok = peek(p, 0)
        if tok.kind == lexer.Kind.Comma || tok.kind == lexer.Kind.Semi {
            advance(mut p)
        } else if tok.kind != lexer.Kind.RBracket {
            return Err(error(tok, "E2024", "expected ',' or ']' in the list" + found(tok)))
        }
    }
    advance(mut p)
    if len(entries) > 0 {
        return Ok(expr(mut p, ast.ExprKind.MapLit(entries), open.line, open.col))
    }
    return Ok(expr(mut p, ast.ExprKind.ArrayLit(elems), open.line, open.col))
}

// `Name { ... }` or `module.Name { ... }`, from the `{` on. `module` is "" or
// the module's name, and `start` the literal's first token, where it is
// reported.
fn struct_lit(p: mut Parser, start: lexer.Token, module: Str,
    name: lexer.Token) -> Result[ast.Expr, errors.CompileError] {
    advance(mut p)  // "{"
    let mut written = name.text
    if module != "" {
        written = module + "." + name.text
    }
    let what = "'" + written + "' value"
    let mut fields: [ast.FieldInit] = []
    for peek(p, 0).kind != lexer.Kind.RBrace {
        list_not_ended(p, what)?
        let fname = expect_name(mut p, "for a field")?
        expect(mut p, lexer.Kind.Colon, "after field '" + fname.text + "'")?
        let value = nested_expression(mut p)?
        push(mut fields, ast.FieldInit { name: fname.text, value: value, line: fname.line, col: fname.col })
        list_separator(mut p, what)?
    }
    advance(mut p)
    return Ok(expr(mut p, ast.ExprKind.StructLit(module, name.text, fields), start.line, start.col))
}

fn call(p: mut Parser, callee: ast.Expr) -> Result[ast.Expr, errors.CompileError] {
    advance(mut p)  // the "("
    let mut args: [ast.Expr] = []
    for peek(p, 0).kind != lexer.Kind.RParen {
        if peek(p, 0).kind == lexer.Kind.Mut {
            let m = advance(mut p)
            let place = nested_expression(mut p)?
            push(mut args, expr(mut p, ast.ExprKind.MutArg(place), m.line, m.col))
        } else {
            push(mut args, nested_expression(mut p)?)
        }
        if peek(p, 0).kind != lexer.Kind.Comma {
            break
        }
        advance(mut p)
    }
    let tok = peek(p, 0)
    if tok.kind != lexer.Kind.RParen {
        return Err(error(tok, "E2025", "expected ',' or ')' in argument list" + found(tok)))
    }
    advance(mut p)
    return Ok(expr(mut p, ast.ExprKind.Call(callee, args), callee.line, callee.col))
}
