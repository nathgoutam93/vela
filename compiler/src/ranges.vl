// Integer ranges for the C backend. Saturating interval arithmetic keeps
// overflow checks unless the complete result is strictly inside Int.
//
// Parameters use whole-program invariants: every entry argument, assignment
// to a mutable parameter, and mutable call result contributes. Functions
// used as values have unrestricted inputs. Growing invariants widen to Int.
//
// A separate flow walk records operation and element-access proofs. Branches
// refine intervals, loop back edges reach a fixed point with widening, and
// break/continue edges participate in that invariant. Symbolic bounds such
// as i <= len(xs)-1 are invalidated by reassignment and mutable calls.
// Unknown values and effects retain their runtime checks.
import ast
import checker
import integers
import maps
import strings
import types

pub type Range = struct {
    lo: Int
    hi: Int
}

pub fn max_int() -> Int ensures result == 9223372036854775807 {
    return 9223372036854775807
}

pub fn min_int() -> Int {
    return 0 - 9223372036854775807 - 1
}

// The longest a string, an array or a map can be: 2^48 (vela_rt.c checks).
pub fn max_len() -> Int ensures result == 281474976710656 {
    return 281474976710656
}

pub fn full() -> Range {
    return Range { lo: min_int(), hi: max_int() }
}

// Whether an operation whose result has this range cannot have overflowed:
// neither end reached a limit.
pub fn fits(r: Range) -> Bool {
    return r.lo > min_int() && r.hi < max_int()
}

fn sat_add(a: Int, b: Int) -> Int {
    if b > 0 && a > max_int() - b {
        return max_int()
    }
    if b < 0 && a < min_int() - b {
        return min_int()
    }
    return a + b
}

fn sat_sub(a: Int, b: Int) -> Int {
    if b == min_int() {
        if a >= 0 {
            return max_int()
        }
        return a - b
    }
    return sat_add(a, 0 - b)
}

fn sat_mul(a: Int, b: Int) -> Int {
    if a == 0 || b == 0 {
        return 0
    }
    if a > 0 && b > 0 && a > max_int() / b {
        return max_int()
    }
    if a < 0 && b < 0 && a < max_int() / b {
        return max_int()
    }
    if a > 0 && b < 0 && b < min_int() / a {
        return min_int()
    }
    if a < 0 && b > 0 && a < min_int() / b {
        return min_int()
    }
    return a * b
}

fn smallest(xs: [Int]) -> Int {
    let mut m = xs[0]
    for x in xs {
        if x < m {
            m = x
        }
    }
    return m
}

fn largest(xs: [Int]) -> Int {
    let mut m = xs[0]
    for x in xs {
        if x > m {
            m = x
        }
    }
    return m
}

fn add(x: Range, y: Range) -> Range {
    return Range { lo: sat_add(x.lo, y.lo), hi: sat_add(x.hi, y.hi) }
}

fn sub(x: Range, y: Range) -> Range {
    return Range { lo: sat_sub(x.lo, y.hi), hi: sat_sub(x.hi, y.lo) }
}

fn mul(x: Range, y: Range) -> Range {
    let c = [sat_mul(x.lo, y.lo), sat_mul(x.lo, y.hi), sat_mul(x.hi, y.lo), sat_mul(x.hi, y.hi)]
    return Range { lo: smallest(c), hi: largest(c) }
}

// Division truncates toward zero; for a divisor of one sign, the ends of
// the result are among the four corners.
fn div(x: Range, y: Range) -> Range {
    if y.lo > 0 {
        let c = [x.lo / y.lo, x.lo / y.hi, x.hi / y.lo, x.hi / y.hi]
        return Range { lo: smallest(c), hi: largest(c) }
    }
    return full()
}

fn rem(x: Range, y: Range) -> Range {
    if y.lo > 0 {
        if x.lo >= 0 {
            let mut hi = y.hi - 1
            if x.hi < hi {
                hi = x.hi
            }
            return Range { lo: 0, hi: hi }
        }
        return Range { lo: 1 - y.hi, hi: y.hi - 1 }
    }
    return full()
}

fn neg(x: Range) -> Range {
    if x.lo == min_int() {
        return full()
    }
    return Range { lo: 0 - x.hi, hi: 0 - x.lo }
}

// What is known while code is generated or analyzed: the ranges of Int
// locals, by local id, and of each function's parameters, by function id
// (an empty list: none known).
pub type Env = struct {
    locals: Map[Int, Range]
    params: [[Range]]
    proven: Map[Int, Bool]  // operations proved safe by flow analysis
    safe: Map[Int, Bool]  // proven element accesses
    limits: Map[Int, Limit]
    values: Map[Int, Range]  // point-specific facts, optionally collected for native lowering
}

pub fn new_env(params: [[Range]]) -> Env {
    return Env { locals: [:], params: params, proven: [:], safe: [:], limits: [:], values: [:] }
}

fn is_int(k: checker.Checked, e: ast.Expr) -> Bool {
    return e.id < len(k.ty) && ranged_type(k.ty[e.id])
}

// The range of an Int expression; full() for anything not known.
fn ranged_type(t: Int) -> Bool {
    return types.is_integer(t) && t != 13
}

fn clip(r: Range, t: Int) -> Range {
    if !ranged_type(t) { return r }
    let mut out = r
    if out.lo < integers.min(t) { out.lo = integers.min(t) }
    if out.hi > integers.max(t) { out.hi = integers.max(t) }
    return out
}

fn fits_type(r: Range, t: Int) -> Bool {
    if t == types.INT() { return fits(r) }
    return ranged_type(t) && r.lo >= integers.min(t) && r.hi <= integers.max(t)
}

pub fn of(k: checker.Checked, env: Env, e: ast.Expr) -> Range {
    let r = of_inner(k, env, e)
    if is_int(k, e) { return clip(r, k.ty[e.id]) }
    return r
}

fn of_inner(k: checker.Checked, env: Env, e: ast.Expr) -> Range {
    match e.kind {
        ast.ExprKind.FixedIntLit(n, _, _) => {
            if is_int(k, e) { return Range { lo: n, hi: n } }
            return full()
        }
        ast.ExprKind.IntLit(n) => {
            if is_int(k, e) {
                return Range { lo: n, hi: n }
            }
            return full()
        }
        ast.ExprKind.Name(_) => {
            match k.refs[e.id] {
                checker.Ref.Local(id) => {
                    if maps.has(k.escaped, id) { return full() }
                    match maps.get(env.locals, id) {
                        Some(r) => return r
                        None => return full()
                    }
                }
                _ => return full()
            }
        }
        ast.ExprKind.Unary(op, x) => {
            if op == "-" && is_int(k, e) {
                let a = of(k, env, x)
                if is_empty(a) {
                    return a
                }
                return neg(a)
            }
            return full()
        }
        ast.ExprKind.Binary(op, l, r) => {
            if !is_int(k, e) || !is_int(k, l) {
                return full()
            }
            let a = of(k, env, l)
            let b = of(k, env, r)
            if is_empty(a) || is_empty(b) {
                return empty()  // code that cannot run, as far as is known yet
            }
            // A result that may have overflowed is checked, so it is an Int:
            // the saturated ends are its range.
            return match op {
                "+" => add(a, b)
                "-" => sub(a, b)
                "*" => mul(a, b)
                "/" => div(a, b)
                "%" => rem(a, b)
                _ => full()
            }
        }
        ast.ExprKind.Call(_, args) => {
            match k.refs[e.id] {
                checker.Ref.Builtin(name) => {
                    if name == "len" {
                        return Range { lo: 0, hi: max_len() }
                    }
                    if integers.type_id(name) >= 0 && len(args) == 1 && is_int(k, e) {
                        if is_int(k, args[0]) { return of(k, env, args[0]) }
                        return full()
                    }
                    if name == "int" && len(args) == 1 && args[0].id < len(k.ty) && k.ty[args[0].id] == types.BYTE() {
                        return Range { lo: 0, hi: 255 }
                    }
                    return full()
                }
                _ => return full()
            }
        }
        _ => return full()
    }
}

// Whether the Int operation `e` (a Binary or a unary minus) cannot fail:
// no overflow, no division by zero. Its C can then be plain C arithmetic.
pub fn cannot_fail(k: checker.Checked, env: Env, e: ast.Expr) -> Bool {
    match maps.get(env.proven, e.id) {
        Some(safe) => return safe
        None => {}
    }
    match e.kind {
        ast.ExprKind.Binary(op, l, r) => {
            if !is_int(k, e) || !is_int(k, l) {
                return false
            }
            if op == "+" || op == "-" || op == "*" {
                return fits_type(of_inner(k, env, e), k.ty[e.id])
            }
            if op == "/" || op == "%" {
                // A positive divisor: never zero, and never the -1 that
                // overflows the smallest Int.
                return of(k, env, r).lo > 0
            }
            return false
        }
        ast.ExprKind.Unary(op, x) => {
            return op == "-" && is_int(k, e) && fits_type(neg(of(k, env, x)), k.ty[e.id])
        }
        _ => return false
    }
}

// The range of `for i in a..b`'s variable.
pub fn loop_range(k: checker.Checked, env: Env, a: ast.Expr, b: ast.Expr) -> Range {
    return Range { lo: of(k, env, a).lo, hi: sat_sub(of(k, env, b).hi, 1) }
}

// ---- Parameters, from every call ----
//
// A function's parameter can have any value its callers pass. The whole
// program is known, so for a function that is only ever called (never
// used as a value, which could be called from anywhere), the ranges of
// its parameters are the union of what its calls pass. They depend on the
// callers' own parameters, so the program is walked again until nothing
// changes; a parameter still growing after a few walks (a recursive call
// that counts down, say) can be any Int.

fn empty() -> Range {
    return Range { lo: 1, hi: 0 }  // nothing seen yet
}

fn is_empty(r: Range) -> Bool {
    return r.lo > r.hi
}

fn join(a: Range, b: Range) -> Range {
    if is_empty(a) {
        return b
    }
    if is_empty(b) {
        return a
    }
    let mut lo = a.lo
    if b.lo < lo {
        lo = b.lo
    }
    let mut hi = a.hi
    if b.hi > hi {
        hi = b.hi
    }
    return Range { lo: lo, hi: hi }
}

type Walk = struct {
    k: checker.Checked
    env: Env
    passed: [Passed]  // what the calls in the function being walked pass
    as_value: Map[Int, Bool]  // functions used as values
    proven: Map[Int, Bool]
    safe: Map[Int, Bool]
    record: Bool
    detailed: Bool
    dead: Bool
    edges: [Env]
    last: Range
    fn_id: Int
    values: Map[Int, Range]
    collect_values: Bool
}

// A call passing an Int in the range r as parameter i of function callee.
type Passed = struct {
    callee: Int
    i: Int
    r: Range
}

// Start from "nothing passed yet" and grow: an empty range for every
// parameter. A parameter still changing after a few rounds is widened to
// any Int, so each changes only a few times and the rounds end; if they
// did not, nothing would be known.
pub fn analyze(k: checker.Checked) -> [[Range]] {
    let mut known: [[Range]] = []
    for f in k.fns {
        let mut ps: [Range] = []
        for _ in f.params {
            push(mut ps, empty())
        }
        push(mut known, ps)
    }
    // What the calls in each function pass. A round walks again only the
    // functions whose parameters' ranges changed in the round before: the
    // others pass what they passed.
    let mut passed: [[Passed]] = []
    let mut dirty: [Bool] = []
    for _ in k.fns {
        push(mut passed, [])
        push(mut dirty, true)
    }
    let mut as_value: Map[Int, Bool] = [:]
    let mut settled = false
    for round in 0..64 {
        let mut w = Walk { k: k, env: new_env(known), passed: [], as_value: as_value, proven: [:], safe: [:], record: false, detailed: false, dead: false, edges: [], last: full(), fn_id: -1, values: [:], collect_values: false }
        for id in 0..len(k.fns) {
            if dirty[id] {
                w.passed = []
                walk_fn(mut w, id)
                passed[id] = w.passed
            }
        }
        as_value = w.as_value
        let mut seen: [[Range]] = []
        for f in k.fns {
            let mut ps: [Range] = []
            for _ in f.params {
                push(mut ps, empty())
            }
            push(mut seen, ps)
        }
        for calls in passed {
            for c in calls {
                seen[c.callee][c.i] = join(seen[c.callee][c.i], c.r)
            }
        }
        let mut next: [[Range]] = []
        let mut changed = false
        for id in 0..len(k.fns) {
            let f = k.fns[id]
            let mut ps: [Range] = []
            dirty[id] = false
            for i in 0..len(f.params) {
                let old = known[id][i]
                let mut r = seen[id][i]
                if !tracked(k, as_value, id, i) || old.lo == min_int() && old.hi == max_int() {
                    r = full()  // given up on stays given up on, or the rounds never end
                }
                if old.lo != r.lo || old.hi != r.hi {
                    changed = true
                    dirty[id] = true
                    if round >= 4 {
                        r = full()  // still growing: give up on it
                    }
                }
                push(mut ps, r)
            }
            push(mut next, ps)
        }
        // Mutable call results depend on the callee's invariant as well
        // as the caller's input ranges. Revisit callers of changed callees.
        let changed_fns = dirty
        for caller in 0..len(passed) {
            for c in passed[caller] {
                if changed_fns[c.callee] && w.k.fns[c.callee].mutable[c.i] {
                    dirty[caller] = true
                }
            }
        }
        known = next
        if !changed {
            settled = true
            break
        }
    }
    // A function nothing calls has parameters nothing is known about.
    let mut out: [[Range]] = []
    for id in 0..len(k.fns) {
        let mut ps: [Range] = []
        for r in known[id] {
            if settled && !is_empty(r) {
                push(mut ps, r)
            } else {
                push(mut ps, full())
            }
        }
        push(mut out, ps)
    }
    return out
}

// Whether an Int parameter has a whole-program invariant. Mutable
// parameters include assignments and mutable call results as well as entry
// arguments; a function used as a value has unrestricted inputs.
fn tracked(k: checker.Checked, as_value: Map[Int, Bool], id: Int, i: Int) -> Bool {
    let f = k.fns[id]
    return f.decl.foreign == "" && !maps.has(as_value, id) && ranged_type(f.params[i])
}

fn walk_fn(w: mut Walk, id: Int) {
    let f = w.k.fns[id]
    w.fn_id = id
    enter(mut w, id)
    for e in f.decl.requires {
        walk_expr(mut w, e)
    }
    walk_block(mut w, f.decl.body)
    // The ensures clauses run at every return, not only after the last
    // statement: a mut parameter may hold anything it is ever given there,
    // which is its whole-function range, as at entry.
    enter(mut w, id)
    for e in f.decl.ensures {
        walk_expr(mut w, e)
    }
}

// The facts at a function's entry: its parameters' ranges, nothing else.
fn enter(w: mut Walk, id: Int) {
    let f = w.k.fns[id]
    w.env.locals = [:]
    w.env.limits = [:]
    w.dead = false
    for i in 0..len(f.params) {
        if i < len(f.param_locals) && i < len(w.env.params[id]) && tracked(w.k, w.as_value, id, i) {
            w.env.locals[f.param_locals[i]] = w.env.params[id][i]
        }
    }
}

fn walk_block(w: mut Walk, b: ast.Block) {
    for s in b.stmts {
        if w.dead {
            break
        }
        walk_stmt(mut w, s)
    }
}

fn local_of(k: checker.Checked, id: Int) -> Int {
    return match k.refs[id] {
        checker.Ref.Local(l) => l
        _ => -1
    }
}

// A symbolic upper bound: local <= len(container) + offset. Only direct
// local containers participate; reassignment and mutable calls invalidate it.
pub type Limit = struct {
    container: Int
    offset: Int
}

fn limit(k: checker.Checked, env: Env, e: ast.Expr) -> Option[Limit] {
    // Reconstructing a bound from syntax is valid only when evaluation
    // cannot change the lengths or locals read earlier in the expression.
    if !stable(e) {
        return None
    }
    return stable_limit(k, env, e)
}

// limit for a stable `e`, whose parts are then stable too.
fn stable_limit(k: checker.Checked, env: Env, e: ast.Expr) -> Option[Limit] {
    match e.kind {
        ast.ExprKind.Name(_) => {
            let local = local_of(k, e.id)
            if maps.has(k.escaped, local) { return None }
            return maps.get(env.limits, local)
        }
        ast.ExprKind.Call(_, args) => {
            match k.refs[e.id] {
                checker.Ref.Builtin(name) => {
                    if name == "len" && len(args) == 1 {
                        let l = local_of(k, args[0].id)
                        if l >= 0 {
                            return Some(Limit { container: l, offset: 0 })
                        }
                    }
                }
                _ => {}
            }
        }
        ast.ExprKind.Binary(op, x, y) => {
            let r = of(k, env, y)
            if r.lo == r.hi && (op == "+" || op == "-") && cannot_fail(k, env, e) {
                match stable_limit(k, env, x) {
                    Some(l) => {
                        let mut offset = sat_add(l.offset, r.lo)
                        if op == "-" {
                            offset = sat_sub(l.offset, r.lo)
                        }
                        return Some(Limit { container: l.container, offset: offset })
                    }
                    None => {}
                }
            }
        }
        _ => {}
    }
    return None
}

fn exact_limit(k: checker.Checked, env: Env, e: ast.Expr) -> Option[Limit] {
    match e.kind {
        ast.ExprKind.Call(_, _) => return limit(k, env, e)
        ast.ExprKind.Binary(_, x, _) => {
            match exact_limit(k, env, x) {
                Some(_) => return limit(k, env, e)
                None => return None
            }
        }
        _ => return None
    }
}

fn invalidate(env: mut Env, l: Int) {
    if l < 0 {
        return
    }
    // Only real changes write: an Env is often shared with a saved copy
    // (an if's state before its branches), and a write copies it.
    if maps.has(env.locals, l) {
        maps.remove(mut env.locals, l)
    }
    if len(env.limits) == 0 {
        return
    }
    if maps.has(env.limits, l) {
        maps.remove(mut env.limits, l)
    }
    for id in maps.keys(env.limits) {
        if env.limits[id].container == l {
            maps.remove(mut env.limits, id)
        }
    }
}

fn set_local(w: mut Walk, l: Int, e: ast.Expr) {
    if l < 0 {
        return
    }
    let mut r = w.last
    if !w.detailed {
        // Parameter inference works out ranges only where they are used.
        r = full()
        if is_int(w.k, e) && stable(e) {
            r = of(w.k, w.env, e)
        }
    }
    let bound = limit(w.k, w.env, e)
    invalidate(mut w.env, l)
    if ranged_type(w.k.locals[l].ty) {
        let f = w.k.fns[w.fn_id]
        for i in 0..len(f.param_locals) {
            if f.param_locals[i] == l && f.mutable[i] {
                push(mut w.passed, Passed { callee: w.fn_id, i: i, r: r })
            }
        }
        w.env.locals[l] = r
        match bound {
            Some(b) => w.env.limits[l] = b
            None => {}
        }
    }
}

fn merge(a: Env, b: Env) -> Env {
    let mut out = a
    for l in maps.keys(a.locals) {
        match maps.get(b.locals, l) {
            Some(r) => {
                let old = a.locals[l]
                let next = join(old, r)
                if old.lo != next.lo || old.hi != next.hi {
                    out.locals[l] = next
                }
            }
            None => maps.remove(mut out.locals, l)
        }
    }
    for l in maps.keys(a.limits) {
        match maps.get(b.limits, l) {
            Some(r) => {
                let old = a.limits[l]
                if old.container != r.container {
                    maps.remove(mut out.limits, l)
                } else if r.offset > old.offset {
                    out.limits[l] = r
                }
            }
            None => maps.remove(mut out.limits, l)
        }
    }
    return out
}

fn same(a: Env, b: Env) -> Bool {
    if len(a.locals) != len(b.locals) || len(a.limits) != len(b.limits) {
        return false
    }
    for l in maps.keys(a.locals) {
        if !maps.has(b.locals, l) || a.locals[l].lo != b.locals[l].lo || a.locals[l].hi != b.locals[l].hi {
            return false
        }
    }
    for l in maps.keys(a.limits) {
        if !maps.has(b.limits, l) || a.limits[l].container != b.limits[l].container || a.limits[l].offset != b.limits[l].offset {
            return false
        }
    }
    return true
}

fn narrow(w: mut Walk, e: ast.Expr, r: Range) {
    let l = local_of(w.k, e.id)
    if l < 0 || !is_int(w.k, e) {
        return
    }
    let old = of(w.k, w.env, e)
    let mut out = old
    if r.lo > old.lo {
        out.lo = r.lo
    }
    if r.hi < old.hi {
        out.hi = r.hi
    }
    if out.lo != old.lo || out.hi != old.hi {
        w.env.locals[l] = out  // only a change writes, as in invalidate
    }
}

fn comparison(w: mut Walk, op: Str, x: ast.Expr, y: ast.Expr) {
    let a = of(w.k, w.env, x)
    let b = of(w.k, w.env, y)
    let l = local_of(w.k, x.id)
    if op == "<" || op == "<=" {
        let mut offset = 0
        if op == "<" {
            offset = -1
        }
        narrow(mut w, x, Range { lo: min_int(), hi: sat_add(b.hi, offset) })
        narrow(mut w, y, Range { lo: sat_sub(a.lo, offset), hi: max_int() })
        if l >= 0 && is_int(w.k, x) {
            match limit(w.k, w.env, y) {
                Some(bound) => w.env.limits[l] = Limit { container: bound.container, offset: sat_add(bound.offset, offset) }
                None => {}
            }
        }
    } else if op == "==" {
        narrow(mut w, x, b)
        narrow(mut w, y, a)
        if l >= 0 && is_int(w.k, x) {
            match limit(w.k, w.env, y) {
                Some(bound) => w.env.limits[l] = bound
                None => {}
            }
        }
    } else if op == "!=" {
        if b.lo == b.hi {
            if a.lo == b.lo {
                narrow(mut w, x, Range { lo: sat_add(a.lo, 1), hi: max_int() })
            } else if a.hi == b.hi {
                narrow(mut w, x, Range { lo: min_int(), hi: sat_sub(a.hi, 1) })
            }
        }
        if l >= 0 {
            match limit(w.k, w.env, x) {
                Some(left) => {
                    match exact_limit(w.k, w.env, y) {
                        Some(right) => {
                            if left.container == right.container && left.offset == right.offset {
                                w.env.limits[l] = Limit { container: left.container, offset: sat_sub(left.offset, 1) }
                            }
                        }
                        None => {}
                    }
                }
                None => {}
            }
        }
    }
}

// Refinement uses source expressions after their evaluation. A mutable
// argument could have changed a tested value, so such conditions give no
// additional facts (including their enclosing short-circuit expression).
fn stable(e: ast.Expr) -> Bool {
    return !ast.has_mut(e)
}

fn stable_args(args: [ast.Expr]) -> Bool {
    for a in args {
        if !stable(a) {
            return false
        }
    }
    return true
}

fn refine(w: mut Walk, e: ast.Expr, truth: Bool) {
    if stable(e) {
        refine_stable(mut w, e, truth)
    }
}

// refine for a stable `e`, whose parts are then stable too: asking again at
// each level made a long a && b && c ... cubic.
fn refine_stable(w: mut Walk, e: ast.Expr, truth: Bool) {
    match e.kind {
        ast.ExprKind.Unary(op, x) => {
            if op == "!" {
                refine_stable(mut w, x, !truth)
            }
        }
        ast.ExprKind.Binary(op, x, y) => {
            if op == "&&" && truth || op == "||" && !truth {
                refine_stable(mut w, x, truth)
                refine_stable(mut w, y, truth)
                return
            }
            let mut cmp = op
            if !truth {
                cmp = match op {
                    "<" => ">="
                    "<=" => ">"
                    ">" => "<="
                    ">=" => "<"
                    "==" => "!="
                    "!=" => "=="
                    _ => ""
                }
            }
            if cmp == ">" {
                comparison(mut w, "<", y, x)
            } else if cmp == ">=" {
                comparison(mut w, "<=", y, x)
            } else {
                comparison(mut w, cmp, x, y)
            }
        }
        _ => {}
    }
}

// Find a loop invariant before recording any expression facts. Back edges
// include break/continue paths conservatively. Growing endpoints widen to
// the Int limits; the final walk must use a stable invariant.
fn walk_loop(w: mut Walk, c: Option[ast.Expr], body: ast.Block, var: Int, r: Range) {
    if !w.detailed {
        // Parameter inference needs a sound bound on call arguments, not
        // point-specific local invariants. Mutable locals can be arbitrary
        // on a back edge. Mut parameters already have a whole-function
        // invariant, including every assignment and mutable call result.
        for l in maps.keys(w.env.locals) {
            if w.k.locals[l].kind == "let mut" {
                maps.remove(mut w.env.locals, l)
            }
        }
        let f = w.k.fns[w.fn_id]
        for i in 0..len(f.params) {
            if f.mutable[i] && ranged_type(f.params[i]) {
                w.env.locals[f.param_locals[i]] = w.env.params[w.fn_id][i]
            }
        }
        w.env.limits = [:]
        if var >= 0 {
            w.env.locals[var] = r
        }
        let before = w.env
        let edges = w.edges
        w.edges = []
        match c {
            Some(e) => {
                walk_expr(mut w, e)
                refine(mut w, e, true)
            }
            None => {}
        }
        walk_block(mut w, body)
        let mut after = merge(before, w.env)
        for edge in w.edges {
            after = merge(after, edge)
        }
        w.env = after
        w.edges = edges
        w.dead = false
        return
    }
    if !w.record {
        // Inside an outer loop's search for its invariant. Running this
        // loop's own search on every round of the outer one would cost
        // rounds^depth; the outer search needs only what can still be true
        // after this loop, and anything this loop does not change still
        // is. Its own search runs once, in the walk that records.
        forget_changed(mut w, c, body)
        w.dead = false
        return
    }
    let record = w.record
    w.record = false
    let mut head = w.env
    let edges = w.edges
    w.edges = []
    for round in 0..8 {
        w.env = head
        w.dead = false
        if var >= 0 {
            w.env.locals[var] = r
        }
        match c {
            Some(e) => {
                walk_expr(mut w, e)
                refine(mut w, e, true)
            }
            None => {}
        }
        walk_block(mut w, body)
        let mut next = merge(head, w.env)
        for edge in w.edges {
            next = merge(next, edge)
        }
        w.edges = []
        if round >= 2 {
            for l in maps.keys(next.locals) {
                let old = head.locals[l]
                let mut nr = next.locals[l]
                if nr.lo < old.lo {
                    nr.lo = min_int()
                }
                if nr.hi > old.hi {
                    nr.hi = max_int()
                }
                next.locals[l] = nr
            }
        }
        if same(head, next) {
            head = next
            break
        }
        head = next
        if round == 7 {
            head.locals = [:]
            head.limits = [:]
        }
    }
    w.env = head
    w.dead = false
    w.record = record
    if var >= 0 {
        w.env.locals[var] = r
    }
    match c {
        Some(e) => {
            walk_expr(mut w, e)
            refine(mut w, e, true)
        }
        None => {}
    }
    walk_block(mut w, body)
    w.env = head
    w.edges = edges
    w.dead = false
}

// Forget what a loop can change: the variables it assigns or passes as
// `mut`, and the bounds relative to them. A mut parameter keeps its
// whole-function range.
fn forget_changed(w: mut Walk, c: Option[ast.Expr], body: ast.Block) {
    let mut changed: Map[Int, Bool] = [:]
    match c {
        Some(e) => changed_expr(w.k, e, mut changed)
        None => {}
    }
    changed_block(w.k, body, mut changed)
    let f = w.k.fns[w.fn_id]
    for l in maps.keys(changed) {
        invalidate(mut w.env, l)
        for i in 0..len(f.param_locals) {
            if f.param_locals[i] == l && f.mutable[i] && ranged_type(f.params[i]) && i < len(w.env.params[w.fn_id]) {
                w.env.locals[l] = w.env.params[w.fn_id][i]
            }
        }
    }
}

fn changed_block(k: checker.Checked, b: ast.Block, out: mut Map[Int, Bool]) {
    for st in b.stmts {
        changed_stmt(k, st, mut out)
    }
}

fn changed_stmt(k: checker.Checked, st: ast.Stmt, out: mut Map[Int, Bool]) {
    match st.kind {
        ast.StmtKind.Block(b) => changed_block(k, b, mut out)
        ast.StmtKind.ExprStmt(e) => changed_expr(k, e, mut out)
        ast.StmtKind.Let(_, _, _, v) => changed_expr(k, v, mut out)
        ast.StmtKind.Assign(t, v) => {
            changed_expr(k, v, mut out)
            changed_expr(k, t, mut out)
            match t.kind {
                ast.ExprKind.Name(_) => {
                    let l = local_of(k, t.id)
                    if l >= 0 {
                        out[l] = true
                    }
                }
                _ => {}  // an element or a field: no variable's value or length changes
            }
        }
        ast.StmtKind.If(c, b, e) => {
            changed_expr(k, c, mut out)
            changed_block(k, b, mut out)
            match e {
                ast.Else.NoElse => {}
                ast.Else.ElseBlock(eb) => changed_block(k, eb, mut out)
                ast.Else.ElseIf(inner) => changed_stmt(k, inner, mut out)
            }
        }
        ast.StmtKind.For(c, b) => {
            match c {
                Some(e) => changed_expr(k, e, mut out)
                None => {}
            }
            changed_block(k, b, mut out)
        }
        ast.StmtKind.ForRange(_, a, b, body) => {
            changed_expr(k, a, mut out)
            changed_expr(k, b, mut out)
            changed_block(k, body, mut out)
        }
        ast.StmtKind.ForEach(_, xs, body) => {
            changed_expr(k, xs, mut out)
            changed_block(k, body, mut out)
        }
        ast.StmtKind.Return(v) => {
            match v {
                Some(e) => changed_expr(k, e, mut out)
                None => {}
            }
        }
        ast.StmtKind.MatchStmt(x, arms) => {
            changed_expr(k, x, mut out)
            changed_arms(k, arms, mut out)
        }
        ast.StmtKind.Unsafe(b) => changed_block(k, b, mut out)
        ast.StmtKind.With(items, b) => {
            for item in items {
                changed_expr(k, item.value, mut out)
            }
            changed_block(k, b, mut out)
        }
        _ => {}
    }
}

fn changed_arms(k: checker.Checked, arms: [ast.Arm], out: mut Map[Int, Bool]) {
    for a in arms {
        match a.body {
            ast.ArmBody.Value(v) => changed_expr(k, v, mut out)
            ast.ArmBody.Do(st) => changed_stmt(k, st, mut out)
        }
    }
}

// The variables passed as `mut` in `e`. A closure's body runs elsewhere
// and cannot change the variables it captured.
fn changed_expr(k: checker.Checked, e: ast.Expr, out: mut Map[Int, Bool]) {
    if !ast.has_mut(e) {
        match e.kind {
            ast.ExprKind.Match(_, _) => {}  // an arm may be a statement
            _ => return
        }
    }
    match e.kind {
        ast.ExprKind.MutArg(x) => {
            let l = local_of(k, x.id)
            if l >= 0 {
                out[l] = true
            }
            changed_expr(k, x, mut out)
        }
        ast.ExprKind.Unary(_, x) => changed_expr(k, x, mut out)
        ast.ExprKind.Binary(_, a, b) => {
            changed_expr(k, a, mut out)
            changed_expr(k, b, mut out)
        }
        ast.ExprKind.Call(f, args) => {
            changed_expr(k, f, mut out)
            for a in args {
                changed_expr(k, a, mut out)
            }
        }
        ast.ExprKind.Field(x, _) => changed_expr(k, x, mut out)
        ast.ExprKind.Index(a, b) => {
            changed_expr(k, a, mut out)
            changed_expr(k, b, mut out)
        }
        ast.ExprKind.Try(x) => changed_expr(k, x, mut out)
        ast.ExprKind.Slice(a, b, c) => {
            changed_expr(k, a, mut out)
            changed_expr(k, b, mut out)
            changed_expr(k, c, mut out)
        }
        ast.ExprKind.ArrayLit(xs) => {
            for x in xs {
                changed_expr(k, x, mut out)
            }
        }
        ast.ExprKind.MapLit(entries) => {
            for en in entries {
                changed_expr(k, en.key, mut out)
                changed_expr(k, en.value, mut out)
            }
        }
        ast.ExprKind.StructLit(_, _, fields) => {
            for f in fields {
                changed_expr(k, f.value, mut out)
            }
        }
        ast.ExprKind.Match(x, arms) => {
            changed_expr(k, x, mut out)
            changed_arms(k, arms, mut out)
        }
        _ => {}
    }
}

fn walk_stmt(w: mut Walk, s: ast.Stmt) {
    match s.kind {
        ast.StmtKind.Block(b) => walk_block(mut w, b)
        ast.StmtKind.ExprStmt(e) => walk_expr(mut w, e)
        ast.StmtKind.Let(_, _, _, v) => {
            walk_expr(mut w, v)
            set_local(mut w, local_of(w.k, s.id), v)
        }
        ast.StmtKind.Assign(t, v) => {
            walk_expr(mut w, v)
            let result = w.last
            walk_expr(mut w, t)
            w.last = result
            set_local(mut w, local_of(w.k, t.id), v)
        }
        ast.StmtKind.If(c, b, e) => {
            walk_expr(mut w, c)
            let before = w.env
            refine(mut w, c, true)
            walk_block(mut w, b)
            let yes = w.env
            let yes_dead = w.dead
            w.env = before
            w.dead = false
            refine(mut w, c, false)
            match e {
                ast.Else.NoElse => {}
                ast.Else.ElseBlock(eb) => walk_block(mut w, eb)
                ast.Else.ElseIf(st) => walk_stmt(mut w, st)
            }
            if w.dead {
                w.env = yes
            } else if !yes_dead {
                w.env = merge(yes, w.env)
            }
            w.dead = yes_dead && w.dead
        }
        ast.StmtKind.For(c, b) => walk_loop(mut w, c, b, -1, full())
        ast.StmtKind.ForRange(_, a, b, body) => {
            walk_expr(mut w, a)
            walk_expr(mut w, b)
            let l = local_of(w.k, s.id)
            let r = loop_range(w.k, w.env, a, b)
            match limit(w.k, w.env, b) {
                Some(bound) => w.env.limits[l] = Limit { container: bound.container, offset: sat_sub(bound.offset, 1) }
                None => {}
            }
            walk_loop(mut w, None, body, l, r)
        }
        ast.StmtKind.ForEach(_, xs, body) => {
            walk_expr(mut w, xs)
            walk_loop(mut w, None, body, -1, full())
        }
        ast.StmtKind.Return(v) => {
            match v {
                Some(x) => walk_expr(mut w, x)
                None => {}
            }
            w.dead = true
        }
        ast.StmtKind.Break => {
            push(mut w.edges, w.env)
            w.dead = true
        }
        ast.StmtKind.Continue => {
            push(mut w.edges, w.env)
            w.dead = true
        }
        ast.StmtKind.MatchStmt(x, arms) => {
            walk_expr(mut w, x)
            walk_arms(mut w, arms)
        }
        ast.StmtKind.Unsafe(b) => walk_block(mut w, b)
        ast.StmtKind.With(items, b) => {
            for it in items {
                walk_expr(mut w, it.value)
            }
            walk_block(mut w, b)
        }
    }
}

fn walk_arms(w: mut Walk, arms: [ast.Arm]) {
    let before = w.env
    let mut after = before
    let mut first = true
    for a in arms {
        w.env = before
        w.dead = false
        match a.body {
            ast.ArmBody.Value(v) => walk_expr(mut w, v)
            ast.ArmBody.Do(st) => walk_stmt(mut w, st)
        }
        if !w.dead {
            if first {
                after = w.env
                first = false
            } else {
                after = merge(after, w.env)
            }
        }
    }
    w.env = after
    w.dead = first
}

// Point-specific facts for one function, shared by all generic copies.
pub fn function_env(k: checker.Checked, params: [[Range]], id: Int) -> Env { return function_env_mode(k, params, id, false) }
pub fn native_env(k: checker.Checked, params: [[Range]], id: Int) -> Env { return function_env_mode(k, params, id, true) }
fn function_env_mode(k: checker.Checked, params: [[Range]], id: Int, values: Bool) -> Env {
    let mut w = Walk { k: k, env: new_env(params), passed: [], as_value: [:], proven: [:], safe: [:], record: true, detailed: true, dead: false, edges: [], last: full(), fn_id: -1, values: [:], collect_values: values }
    walk_fn(mut w, id)
    let mut env = new_env(params)
    env.proven = w.proven
    env.safe = w.safe
    env.values = w.values
    return env
}

// A function named where it is not called: a value, callable from anywhere.
fn note_value(w: mut Walk, e: ast.Expr) {
    match w.k.refs[e.id] {
        checker.Ref.Function(id) => w.as_value[id] = true
        _ => {}
    }
}

fn walk_call(w: mut Walk, e: ast.Expr, callee: ast.Expr, args: [ast.Expr]) {
    match w.k.refs[e.id] {
        checker.Ref.Function(_) => {}
        _ => walk_expr(mut w, callee)
    }
    match callee.kind {
        ast.ExprKind.Field(obj, _) => walk_expr(mut w, obj)
        _ => {}
    }
    let mut callee_id = -1
    let mut params: [Int] = []
    let mut mutable: [Bool] = []
    match w.k.refs[e.id] {
        checker.Ref.Function(id) => {
            callee_id = id
            params = w.k.fns[id].params
            mutable = w.k.fns[id].mutable
        }
        _ => {}
    }
    let steady = stable_args(args) && stable(callee)
    for i in 0..len(args) {
        walk_expr(mut w, args[i])
        if callee_id >= 0 && i < len(params) && ranged_type(params[i]) && !mutable[i] {
            let mut passed = full()
            if steady {
                passed = w.last
                if !w.detailed {
                    passed = of(w.k, w.env, args[i])
                }
            }
            push(mut w.passed, Passed { callee: callee_id, i: i, r: passed })
        }
    }
    for i in 0..len(args) {
        match args[i].kind {
            ast.ExprKind.MutArg(x) => {
                let l = local_of(w.k, x.id)
                let entry = of(w.k, w.env, x)
                invalidate(mut w.env, l)
                let mut result = full()
                match w.k.refs[e.id] {
                    checker.Ref.Function(id) => {
                        if i < len(w.env.params[id]) && is_int(w.k, x) {
                            push(mut w.passed, Passed { callee: id, i: i, r: entry })
                            result = w.env.params[id][i]
                            if l >= 0 {
                                w.env.locals[l] = result
                            }
                        }
                    }
                    _ => {}
                }
                let f = w.k.fns[w.fn_id]
                for j in 0..len(f.param_locals) {
                    if f.param_locals[j] == l && f.mutable[j] {
                        push(mut w.passed, Passed { callee: w.fn_id, i: j, r: result })
                    }
                }
            }
            _ => {}
        }
    }
}

// Parameter inference visits every function in several rounds. It needs
// ranges only for initializers, assignments and call arguments; computing
// an interval for every intermediate expression repeats that work.
fn parameter_expr(w: mut Walk, e: ast.Expr) {
    match e.kind {
        ast.ExprKind.Name(_) => note_value(mut w, e)
        ast.ExprKind.Unary(_, x) => parameter_expr(mut w, x)
        ast.ExprKind.Binary(_, x, y) => {
            parameter_expr(mut w, x)
            parameter_expr(mut w, y)
        }
        ast.ExprKind.Call(callee, args) => walk_call(mut w, e, callee, args)
        ast.ExprKind.Field(x, _) => {
            note_value(mut w, e)
            parameter_expr(mut w, x)
        }
        ast.ExprKind.Index(x, i) => {
            parameter_expr(mut w, x)
            parameter_expr(mut w, i)
        }
        ast.ExprKind.Try(x) => parameter_expr(mut w, x)
        ast.ExprKind.MutArg(x) => parameter_expr(mut w, x)
        ast.ExprKind.Slice(x, lo, hi) => {
            parameter_expr(mut w, x)
            parameter_expr(mut w, lo)
            parameter_expr(mut w, hi)
        }
        ast.ExprKind.ArrayLit(xs) => {
            for x in xs {
                parameter_expr(mut w, x)
            }
        }
        ast.ExprKind.MapLit(entries) => {
            for en in entries {
                parameter_expr(mut w, en.key)
                parameter_expr(mut w, en.value)
            }
        }
        ast.ExprKind.StructLit(_, _, fields) => {
            for f in fields {
                parameter_expr(mut w, f.value)
            }
        }
        ast.ExprKind.Match(x, arms) => {
            parameter_expr(mut w, x)
            walk_arms(mut w, arms)
        }
        ast.ExprKind.Closure(_, _, body, _) => {
            let before = w.env
            w.env = new_env(w.env.params)
            walk_block(mut w, body)
            w.env = before
            w.dead = false
        }
        _ => {}
    }
}

fn walk_expr(w: mut Walk, e: ast.Expr) {
    if !w.detailed {
        parameter_expr(mut w, e)
        w.last = full()  // set_local and walk_call work out the ranges they need
        return
    }
    let mut result = full()
    match e.kind {
        ast.ExprKind.IntLit(_) => result = of(w.k, w.env, e)
        ast.ExprKind.FixedIntLit(_, _, _) => result = of(w.k, w.env, e)
        ast.ExprKind.Name(_) => {
            result = of(w.k, w.env, e)
            note_value(mut w, e)
        }
        ast.ExprKind.Unary(op, x) => {
            walk_expr(mut w, x)
            if op == "-" && is_int(w.k, e) {
                if w.record {
                    w.proven[e.id] = fits_type(neg(w.last), w.k.ty[e.id])
                }
                result = neg(w.last)
            }
        }
        ast.ExprKind.Binary(op, l, r) => {
            walk_expr(mut w, l)
            let left = w.last
            if op == "&&" || op == "||" {
                let before = w.env
                refine(mut w, l, op == "&&")
                walk_expr(mut w, r)
                w.env = merge(before, w.env)
            } else {
                walk_expr(mut w, r)
                if is_int(w.k, e) && is_int(w.k, l) {
                    let right = w.last
                    if is_empty(left) || is_empty(right) {
                        result = empty()
                    } else {
                        result = match op {
                            "+" => add(left, right)
                            "-" => sub(left, right)
                            "*" => mul(left, right)
                            "/" => div(left, right)
                            "%" => rem(left, right)
                            _ => full()
                        }
                    }
                    if !stable(e) {
                        result = full()
                    }
                    if w.record && (op == "+" || op == "-" || op == "*" || op == "/" || op == "%") {
                        let mut safe = fits_type(result, w.k.ty[e.id])
                        if op == "/" || op == "%" {
                            safe = right.lo > 0 && stable(e)
                        }
                        w.proven[e.id] = safe
                    }
                }
            }
        }
        ast.ExprKind.Call(callee, args) => {
            result = of(w.k, w.env, e)
            walk_call(mut w, e, callee, args)
        }
        ast.ExprKind.Field(obj, _) => {
            note_value(mut w, e)
            walk_expr(mut w, obj)
        }
        ast.ExprKind.Index(obj, i) => {
            if w.record && !types.is_map(w.k.table, w.k.ty[obj.id]) {
                let mut safe = false
                match limit(w.k, w.env, i) {
                    Some(bound) => safe = bound.container == local_of(w.k, obj.id) && bound.offset < 0 && of(w.k, w.env, i).lo >= 0 && stable(i) && stable(obj)
                    None => {}
                }
                if maps.has(w.safe, e.id) {
                    safe = safe && w.safe[e.id]
                }
                w.safe[e.id] = safe
            }
            walk_expr(mut w, obj)
            walk_expr(mut w, i)
            // A successful checked access is itself a guard. Subsequent
            // accesses and arithmetic may use its facts until invalidated.
            if !types.is_map(w.k.table, w.k.ty[obj.id]) && stable(obj) && stable(i) {
                let l = local_of(w.k, i.id)
                let container = local_of(w.k, obj.id)
                if l >= 0 && is_int(w.k, i) {
                    narrow(mut w, i, Range { lo: 0, hi: max_len() - 1 })
                    if container >= 0 {
                        w.env.limits[l] = Limit { container: container, offset: -1 }
                    }
                }
            }
        }
        ast.ExprKind.Try(x) => walk_expr(mut w, x)
        ast.ExprKind.MutArg(x) => {
            walk_expr(mut w, x)
            result = w.last
        }
        ast.ExprKind.Slice(x, lo, hi) => {
            walk_expr(mut w, x)
            walk_expr(mut w, lo)
            walk_expr(mut w, hi)
        }
        ast.ExprKind.ArrayLit(xs) => {
            for x in xs {
                walk_expr(mut w, x)
            }
        }
        ast.ExprKind.MapLit(entries) => {
            for en in entries {
                walk_expr(mut w, en.key)
                walk_expr(mut w, en.value)
            }
        }
        ast.ExprKind.StructLit(_, _, fields) => {
            for fi in fields {
                walk_expr(mut w, fi.value)
            }
        }
        ast.ExprKind.Match(x, arms) => {
            walk_expr(mut w, x)
            walk_arms(mut w, arms)
        }
        ast.ExprKind.Closure(_, _, body, _) => {
            let before = w.env
            w.env = new_env(w.env.params)
            walk_block(mut w, body)
            w.env = before
            w.dead = false
        }
        _ => {}
    }
    if is_int(w.k, e) { result = clip(result, w.k.ty[e.id]) }
    if w.record && w.collect_values && is_int(w.k, e) {
        if maps.has(w.values, e.id) { w.values[e.id] = join(w.values[e.id], result) } else { w.values[e.id] = result }
    }
    w.last = result
}

test "ranges of operations" {
    let r = add(Range { lo: 0, hi: max_len() }, Range { lo: 1, hi: 1 })
    assert(fits(r) && r.lo == 1 && r.hi == max_len() + 1)
    assert(!fits(mul(Range { lo: 0, hi: max_len() }, Range { lo: 0, hi: max_len() })))
    let half = div(Range { lo: 0, hi: max_int() }, Range { lo: 2, hi: 2 })
    assert(half.hi == max_int() / 2 && fits(add(half, Range { lo: 0, hi: max_len() })))
    assert(!fits(add(full(), Range { lo: 1, hi: 1 })))
    assert(sat_mul(min_int(), -1) == max_int() && sat_sub(0, min_int()) == max_int())
    let m = rem(Range { lo: 0, hi: 100 }, Range { lo: 7, hi: 7 })
    assert(m.lo == 0 && m.hi == 6)
    assert(strings.from_int(neg(Range { lo: 1, hi: 5 }).lo) == "-5")
}

test "integer domains constrain proofs to the result width" {
    assert(fits_type(Range { lo: -128, hi: 127 }, 8))
    assert(!fits_type(Range { lo: -128, hi: 128 }, 8))
    assert(!fits_type(Range { lo: -1, hi: 255 }, types.BYTE()))
    assert(fits_type(Range { lo: 0, hi: 4294967295 }, 12))
    assert(!fits_type(Range { lo: 0, hi: 4294967296 }, 12))
    assert(!fits_type(Range { lo: 0, hi: 1 }, 13))
    assert(clip(full(), 8).lo == -128 && clip(full(), 8).hi == 127)
}
