// Optimizing the IR (M11b), between lower.vl and x64.vl.
//
// - Inlining. A call to a small function becomes a copy of its body,
//   with its registers, slots and labels renumbered: the function's
//   parameters are set from the arguments, and each return sets the
//   call's result and jumps to after the call. Small means at most
//   inline_limit() instructions; recursive bodies have a smaller limit
//   and a separate per-caller expansion budget. The functions
//   lowering writes for memory (rc_retain_T, box helpers) are mostly
//   such, and so are accessors and the many one-line functions of a
//   program. Two rounds, so that what an inlined body calls can be
//   inlined too, each copying the bodies as the round before left them.
// - Copy propagation. A register set once, by a move from another set
//   once, is replaced by that other everywhere, and the move goes.
// - Folding. A comparison of two constants is a constant, and a branch
//   on a constant is a jump.
// - Jump threading. A jump to a label followed only by a jump goes
//   straight to where that one goes.
// - Dead code. An instruction with no effect whose result nobody reads
//   goes, and so does code no jump can reach.
import ir
import maps
import strings
import ints
import promote

fn inline_limit() -> Int {
    return 80
}

pub fn optimize(p: ir.Program) -> ir.Program {
    return optimize_with(p, inline_limit(), 2)
}

// With functions of at most `limit` instructions inlined, `rounds` times.
pub fn optimize_with(p: ir.Program, limit: Int, rounds: Int) -> ir.Program {
    let mut funcs = p.funcs
    let mut index: Map[Str, Int] = [:]
    for i in 0..len(funcs) {
        index[funcs[i].name] = i
    }
    for _ in 0..rounds {
        let before = funcs
        let mut small: Map[Str, Bool] = [:]
        let mut recursive: Map[Str, Bool] = [:]
        for f in before {
            let self_call = calls(f, f.name)
            // A bounded expansion of small recursive bodies exposes their
            // base cases without raising the general inlining threshold.
            if len(f.insts) <= limit && (!self_call || len(f.insts) <= 40) && !f.public {
                small[f.name] = true
                if self_call { recursive[f.name] = true }
            }
        }
        for i in 0..len(funcs) {
            funcs[i] = simplify(inline_calls(funcs[i], before, index, small, recursive))
        }
    }
    for i in 0..len(funcs) {
        let kept = loop_fields(funcs[i])
        if len(kept.classes) != len(funcs[i].classes) { funcs[i] = simplify(kept) }
        funcs[i] = compact_slots(forward_destinations(hoist_floats(rotate_loops(build_in_place(funcs[i])))))
    }
    return ir.Program { funcs: funcs, data: p.data }
}

fn calls(f: ir.Func, name: Str) -> Bool {
    for i in f.insts {
        if i.op == ir.Op.Call && i.sym == name {
            return true
        }
    }
    return false
}

// ---- Inlining ----

fn inline_calls(f: ir.Func, all: [ir.Func], index: Map[Str, Int], small: Map[Str, Bool], recursive: Map[Str, Bool]) -> ir.Func {
    let mut out = f
    out.insts = []
    let mut recursive_budget = 160
    for i in f.insts {
        if i.op != ir.Op.Call || !maps.has(small, i.sym) {
            push(mut out.insts, i)
            continue
        }
        let g = all[index[i.sym]]
        if maps.has(recursive, i.sym) {
            if len(g.insts) > recursive_budget { push(mut out.insts, i); continue }
            recursive_budget = recursive_budget - len(g.insts)
        }
        let regs = len(out.classes)
        for c in g.classes {
            push(mut out.classes, c)
        }
        let slots = len(out.slot_sizes)
        for s in 0..len(g.slot_sizes) {
            push(mut out.slot_sizes, g.slot_sizes[s])
            push(mut out.slot_aligns, g.slot_aligns[s])
        }
        let labels = out.labels
        out.labels = out.labels + g.labels + 1
        let end = out.labels - 1
        for k in 0..len(g.params) {
            push(mut out.insts, ir.inst(ir.Op.Move, g.params[k] + regs, i.args[k], -1, 0))
        }
        for gi in g.insts {
            if gi.op == ir.Op.Ret {
                if i.dst >= 0 && gi.a >= 0 {
                    push(mut out.insts, ir.inst(ir.Op.Move, i.dst, gi.a + regs, -1, 0))
                }
                push(mut out.insts, ir.inst(ir.Op.Jump, -1, -1, -1, end))
                continue
            }
            push(mut out.insts, renumbered(gi, regs, slots, labels))
        }
        push(mut out.insts, ir.inst(ir.Op.Label, -1, -1, -1, end))
    }
    return out
}

fn renumbered(i: ir.Inst, regs: Int, slots: Int, labels: Int) -> ir.Inst {
    let mut o = i
    if o.dst >= 0 {
        o.dst = o.dst + regs
    }
    if o.a >= 0 {
        o.a = o.a + regs
    }
    if o.b >= 0 {
        o.b = o.b + regs
    }
    if len(o.args) > 0 {
        let mut args: [Int] = []
        for a in o.args {
            push(mut args, a + regs)
        }
        o.args = args
    }
    if o.op == ir.Op.Label || o.op == ir.Op.Jump || o.op == ir.Op.Branch || o.op == ir.Op.BranchCmp {
        o.imm = o.imm + labels
    }
    if o.op == ir.Op.Branch {
        o.imm2 = o.imm2 + labels
    }
    if o.op == ir.Op.SlotAddr {
        o.imm = o.imm + slots
    }
    return o
}

// ---- Simplifying ----

// Instructions with no effect but their result.
fn pure(op: ir.Op) -> Bool {
    return match op {
        ir.Op.Const => true
        ir.Op.FConst => true
        ir.Op.Move => true
        ir.Op.SlotAddr => true
        ir.Op.SymAddr => true
        ir.Op.Load => true
        ir.Op.FLoad => true
        ir.Op.Add => true
        ir.Op.AddImm => true
        ir.Op.Sub => true
        ir.Op.Mul => true
        ir.Op.MulImm => true
        ir.Op.Cmp => true
        ir.Op.CmpImm => true
        ir.Op.FCmp => true
        ir.Op.Not => true
        ir.Op.FAdd => true
        ir.Op.FSub => true
        ir.Op.FMul => true
        ir.Op.FDiv => true
        ir.Op.FTo32 => true
        ir.Op.FFrom32 => true
        ir.Op.FNeg => true
        ir.Op.FSqrt => true
        ir.Op.IntToFloat => true
        ir.Op.And => true
        ir.Op.Or => true
        ir.Op.Xor => true
        ir.Op.Inv => true
        ir.Op.Shl => true
        ir.Op.Shr => true
        ir.Op.Sar => true
        ir.Op.Extend => true
        ir.Op.Div => true
        ir.Op.Rem => true
        ir.Op.Sext32 => true
        _ => false
    }
}

fn holds(cond: Int, a: Int, b: Int) -> Bool {
    return match cond {
        0 => a == b
        1 => a != b
        2 => a < b
        3 => a <= b
        4 => a > b
        _ => a >= b
    }
}

fn branch_holds(cond: Str, a: Int, b: Int) -> Bool {
    return match cond {
        "eq" => a == b
        "ne" => a != b
        "lt" => a < b
        "le" => a <= b
        "gt" => a > b
        "ge" => a >= b
        "ult" => (a >= 0 && b < 0) || ((a < 0) == (b < 0) && a < b)
        "ugt" => (a < 0 && b >= 0) || ((a < 0) == (b < 0) && a > b)
        "ule" => (a >= 0 && b < 0) || ((a < 0) == (b < 0) && a <= b)
        _ => !((a >= 0 && b < 0) || ((a < 0) == (b < 0) && a < b))
    }
}

fn simplify(f: ir.Func) -> ir.Func {
    let mut out = f
    for _ in 0..4 {
        let before = len(out.insts)
        out = propagate(out)
        out = local_copies(out)
        out = scalar_copy(out)
        out = promote.function(out)
        out = reuse(out)
        out = known_branches(out)
        out = fold(out)
        out = fuse_branches(out)
        out = drop_dead(out)
        out = thread_jumps(out)
        out = drop_unreachable(out)
        if len(out.insts) == before {
            break
        }
    }
    return out
}

// Compute directly into a following move's destination when the private
// result has no other readers. This removes false overlap with loop-carried
// variables before allocation. Keep it after simplification: value numbering
// must still see the original single-definition results while it runs.
fn forward_destinations(f: ir.Func) -> ir.Func {
    let defs = def_counts(f); let mut readers: [Int] = []
    for _ in f.classes { push(mut readers, 0) }
    for i in f.insts { for r in ir.reads(i) { readers[r] = readers[r] + 1 } }
    let mut out = f; out.insts = []; let mut at = 0
    for at < len(f.insts) {
        let mut i = f.insts[at]
        if i.dst >= 0 && defs[i.dst] == 1 && readers[i.dst] == 1 && at + 1 < len(f.insts) && (pure(i.op) || i.op == ir.Op.AddChk || i.op == ir.Op.SubChk || i.op == ir.Op.MulChk || i.op == ir.Op.DivChk || i.op == ir.Op.RemChk) {
            let next = f.insts[at + 1]
            if next.op == ir.Op.Move && next.a == i.dst && next.dst != i.dst && f.classes[next.dst] == f.classes[i.dst] {
                i.dst = next.dst; push(mut out.insts, i); at = at + 2; continue
            }
        }
        push(mut out.insts, i); at = at + 1
    }
    return out
}

// A private temporary copied only to read one field need not materialize
// the rest of the aggregate. Keep the read at the copy's original point:
// there can be no intervening store, call, or change to the source address.
fn scalar_copy(f: ir.Func) -> ir.Func {
    let defs = def_counts(f); let mut counts: [Int] = []; let mut addresses: [Int] = []
    let mut slots: Map[Int, Int] = [:]
    for _ in f.classes { push(mut counts, 0) }
    for _ in f.slot_sizes { push(mut addresses, 0) }
    for i in f.insts {
        for r in ir.reads(i) { counts[r] = counts[r] + 1 }
        if i.op == ir.Op.SlotAddr { slots[i.dst] = i.imm; addresses[i.imm] = addresses[i.imm] + 1 }
    }
    let mut out = f; out.insts = []; let mut at = 0
    for at < len(f.insts) {
        let i = f.insts[at]
        if i.op == ir.Op.Copy && maps.has(slots, i.a) && defs[i.a] == 1 && counts[i.a] == 2 && addresses[slots[i.a]] == 1 && at + 1 < len(f.insts) {
            let mut after = at + 1
            for after < len(f.insts) && (f.insts[after].op == ir.Op.SlotAddr || f.insts[after].op == ir.Op.SymAddr || f.insts[after].op == ir.Op.Const || f.insts[after].op == ir.Op.FConst) {
                if f.insts[after].dst == i.b { break }; after = after + 1
            }
            if after >= len(f.insts) { push(mut out.insts, i); at = at + 1; continue }
            let mut next = f.insts[after]; let mut size = next.imm2; if next.op == ir.Op.FLoad { size = 8 }
            if next.op == ir.Op.Copy && next.b == i.a && next.imm == i.imm {
                for between in at + 1..after { push(mut out.insts, f.insts[between]) }
                next.b = i.b; push(mut out.insts, next); at = after + 1; continue
            }
            if (next.op == ir.Op.Load || next.op == ir.Op.FLoad) && next.a == i.a && next.imm >= 0 && size > 0 && next.imm <= i.imm - size {
                for between in at + 1..after { push(mut out.insts, f.insts[between]) }
                next.a = i.b; push(mut out.insts, next); at = after + 1; continue
            }
        }
        push(mut out.insts, i); at = at + 1
    }
    return out
}

// A snapshot can use its source register until that source is assigned.
// Keep the original move: later reads after an assignment or a control-flow
// boundary still need the frozen value. Dead-code removal drops it only when
// every read was safely replaced. Representatives always point one hop to a
// register that currently represents itself.
fn local_copies(f: ir.Func) -> ir.Func {
    let mut rep: [Int] = []; for r in 0..len(f.classes) { push(mut rep, r) }
    let mut active: [Int] = []; let mut out = f; out.insts = []
    for original in f.insts {
        if original.op == ir.Op.Label { for r in active { rep[r] = r }; active = [] }
        let i = renamed(original, rep)
        if i.op == ir.Op.Move && i.dst == i.a { continue }
        if i.dst >= 0 {
            let d = i.dst; let mut kept: [Int] = []
            for r in active {
                if rep[r] == d || r == d { rep[r] = r } else { push(mut kept, r) }
            }; active = kept; rep[d] = d
            if i.op == ir.Op.Move && i.a != d { rep[d] = i.a; push(mut active, d) }
        }
        push(mut out.insts, i)
        if ir.ends_block(i.op) || i.op == ir.Op.BranchCmp { for r in active { rep[r] = r }; active = [] }
    }
    return out
}

// Value numbering within a basic block. Immutable register expressions can
// survive writes; memory reads cannot. Clear both tables at control-flow
// boundaries, and all load facts at every possible memory mutation.
// Block-local value numbering: a pure instruction computing what an earlier
// one in the block computed reuses its result. Its operands may be
// registers defined more than once, such as a loop variable: what read one
// is forgotten where it is defined again (`readers`), so x[j]'s address is
// worked out once per iteration, not at every field.
fn ways_to(ways: Map[Int, Int], label: Int) -> Int {
    return match maps.get(ways, label) {
        Some(n) => n
        None => 0
    }
}

// Loads stay known past a label reached from one place only, when that place
// comes first: the fall-through into it, or a jump earlier in the function.
// Everything before that place has run. Where forward paths join, the loads
// every way in agrees on stay known (`arrive`). Other values are worked out again
// in each block: keeping them lengthens registers' lives, and in loops short
// of registers (sha256) the spills cost more than the work saved.
// A store forgets the loads it could change: those through another pointer,
// which may point to the same memory, and those overlapping it. A later
// word load of the word just stored is the stored value.
fn reuse(f: ir.Func) -> ir.Func {
    let defs = def_counts(f); let mut values: Map[Str, Int] = [:]; let mut loads: Map[Str, Int] = [:]
    let mut readers: Map[Int, [Str]] = [:]  // multiply defined register: the keys reading it
    let mut rep: [Int] = []; for r in 0..len(f.classes) { push(mut rep, r) }
    let mut ways: Map[Int, Int] = [:]  // label: how many places go to it
    for k in 0..len(f.insts) {
        let i = f.insts[k]
        for t in targets(i) { ways[t] = ways_to(ways, t) + 1 }
        if i.op == ir.Op.Label && k > 0 && !ir.ends_block(f.insts[k - 1].op) { ways[i.imm] = ways_to(ways, i.imm) + 1 }
    }
    let mut saved_loads: Map[Int, Map[Str, Int]] = [:]; let mut saved_readers: Map[Int, Map[Int, [Str]]] = [:]
    let mut spans: Map[Str, [Int]] = [:]  // load key: pointer, offset, size
    let mut arrivals: Map[Int, Int] = [:]  // label: ways in seen so far
    let mut falls = false  // whether the previous instruction goes on to this one
    let mut out = f; out.insts = []
    for original in f.insts {
        let i = renamed(original, rep)
        if i.op == ir.Op.Label {
            let n = ways_to(ways, i.imm)
            if n == 1 && !falls && maps.has(saved_loads, i.imm) {
                loads = saved_loads[i.imm]; readers = saved_readers[i.imm]
            } else if n > 1 {
                // Where paths join: the loads every way in agrees on, once
                // every way in has been seen (not a loop's jump back).
                if falls { arrive(mut saved_loads, mut arrivals, i.imm, loads, spans, defs) }
                if ways_to(arrivals, i.imm) == n { loads = saved_loads[i.imm] } else { loads = [:] }
                readers = [:]
            } else if !falls {
                loads = [:]; readers = [:]
            }
        }
        if i.op == ir.Op.Label || i.op == ir.Op.BranchCmp {
            values = [:]
        }
        for t in targets(i) {
            if ways_to(ways, t) == 1 { saved_loads[t] = loads; saved_readers[t] = readers } else { arrive(mut saved_loads, mut arrivals, t, loads, spans, defs) }
        }
        falls = !ir.ends_block(i.op)
        if ir.ends_block(i.op) { values = [:]; loads = [:]; readers = [:] }
        let reading = i.op == ir.Op.Load || i.op == ir.Op.FLoad
        if i.op == ir.Op.Call || i.op == ir.Op.CallInd || i.op == ir.Op.CCall || i.op == ir.Op.Copy || i.op == ir.Op.RcInc || i.op == ir.Op.RcDec { loads = [:] }
        if i.op == ir.Op.Store || i.op == ir.Op.FStore {
            let mut width = 8
            if i.op == ir.Op.Store { width = i.imm2 }
            let mut kept: Map[Str, Int] = [:]
            for key in maps.keys(loads) {
                let at = spans[key]
                if at[0] == i.a && (at[1] + at[2] <= i.imm || i.imm + width <= at[1]) { kept[key] = loads[key] }
            }
            loads = kept
            if i.op == ir.Op.Store && width == 8 && defs[i.a] == 1 && defs[i.b] == 1 {
                let key = "load:" + strings.from_int(i.a) + ":-1:" + strings.from_int(i.imm) + ":8:"
                loads[key] = i.b
                spans[key] = [i.a, i.imm, 8]
            }
        }
        let candidate = i.dst >= 0 && pure(i.op) && defs[i.dst] == 1
        if candidate {
            let key = ir.op_name(i.op) + ":" + strings.from_int(i.a) + ":" + strings.from_int(i.b) + ":" + strings.from_int(i.imm) + ":" + strings.from_int(i.imm2) + ":" + i.sym
            let mut previous = -1
            if reading { match maps.get(loads, key) { Some(v) => previous = v, None => {} } } else { match maps.get(values, key) { Some(v) => previous = v, None => {} } }
            if previous >= 0 { rep[i.dst] = previous; continue }
            if reading {
                loads[key] = i.dst
                let mut size = 8
                if i.op == ir.Op.Load { size = i.imm2 }
                spans[key] = [i.a, i.imm, size]
            } else { values[key] = i.dst }
            for r in ir.reads(i) {
                if defs[r] != 1 {
                    let mut keys: [Str] = []
                    match maps.get(readers, r) { Some(ks) => keys = ks, None => {} }
                    push(mut keys, key)
                    readers[r] = keys
                }
            }
        }
        // A register defined again: nothing computed from its old value holds.
        if i.dst >= 0 && defs[i.dst] != 1 {
            match maps.get(readers, i.dst) {
                Some(keys) => {
                    for key in keys {
                        if maps.has(values, key) { maps.remove(mut values, key) }
                        if maps.has(loads, key) { maps.remove(mut loads, key) }
                    }
                    maps.remove(mut readers, i.dst)
                }
                None => {}
            }
        }
        push(mut out.insts, i)
    }
    return out
}

// One more way into `label` with `loads` known: keep the loads every way
// so far agrees on. Loads through a register set more than once are not
// kept, as which value it holds may differ by way.
fn arrive(saved: mut Map[Int, Map[Str, Int]], arrivals: mut Map[Int, Int], label: Int, loads: Map[Str, Int], spans: Map[Str, [Int]], defs: [Int]) {
    let first = ways_to(arrivals, label) == 0
    let mut have: Map[Str, Int] = [:]
    if !first { have = saved[label] }
    let mut out: Map[Str, Int] = [:]
    for key in maps.keys(loads) {
        if defs[spans[key][0]] != 1 { continue }
        if first || maps.has(have, key) && have[key] == loads[key] { out[key] = loads[key] }
    }
    saved[label] = out
    arrivals[label] = ways_to(arrivals, label) + 1
}

// A result in memory is built where the caller wants it. A return copies
// it there from a slot (`copy sret, slot`). When everything else done with
// the slot is in the same block and only writes it (stores into it or at an
// offset from it, a runtime call writing its Str result there, a call given
// it as its own result's place), that is done to the result's address
// instead, and the copy goes. The caller's slot is fresh (call_result): no
// argument or other memory the function can reach points into it, so
// nothing can see it written a little earlier. Nothing in the block may use
// the result's address otherwise.
fn build_in_place(f: ir.Func) -> ir.Func {
    if f.sret < 0 || len(f.abi) > 0 {
        return f  // a C callback's caller is not call_result
    }
    let defs = def_counts(f)
    let mut readers: [Int] = []
    for _ in f.classes { push(mut readers, 0) }
    for i in f.insts {
        for r in ir.reads(i) { readers[r] = readers[r] + 1 }
    }
    let mut out = f
    let mut moved: Map[Int, Bool] = [:]  // slot address registers now unused
    let mut k = len(f.insts) - 1
    for k >= 0 {
        let c = out.insts[k]
        let s = c.b
        if c.op == ir.Op.Copy && c.a == f.sret && s >= 0 && defs[s] == 1 && slot_of(out, s) >= 0 && c.imm == out.slot_sizes[slot_of(out, s)] {
            let mut start = k
            for start > 0 && !boundary(out.insts[start - 1]) {
                start = start - 1
            }
            // The slot's address and addresses into it, and their uses here.
            let mut derived: Map[Int, Bool] = [:]
            derived[s] = true
            let mut seen = 1  // the copy
            let mut ok = true
            for x in start..k {
                let i = out.insts[x]
                for r in ir.reads(i) {
                    if r == f.sret {
                        ok = false
                    }
                    if !maps.has(derived, r) {
                        continue
                    }
                    seen = seen + 1
                    let write = (i.op == ir.Op.Store || i.op == ir.Op.FStore || i.op == ir.Op.Copy) && r == i.a && !maps.has(derived, i.b)
                    let offset = i.op == ir.Op.AddImm && r == i.a && defs[i.dst] == 1
                    let runtime = i.op == ir.Op.CCall && r == i.a && !reads_any(i.args, derived)
                    let result = i.op == ir.Op.Call && len(i.args) > 0 && i.args[0] == r && !reads_any(i.args[1..len(i.args)], derived)
                    if offset {
                        derived[i.dst] = true
                    }
                    if !(write || offset || runtime || result) {
                        ok = false
                    }
                }
            }
            let mut total = 0
            for d in maps.keys(derived) {
                total = total + readers[d]
            }
            if ok && total == seen {
                for x in start..k {
                    let i = out.insts[x]
                    if i.op != ir.Op.Call && i.a == s && i.op != ir.Op.SlotAddr {
                        out.insts[x].a = f.sret
                    } else if i.op == ir.Op.Call && len(i.args) > 0 && i.args[0] == s {
                        out.insts[x].args[0] = f.sret
                    }
                }
                out.insts[k] = ir.inst(ir.Op.Label, -1, -1, -1, -1)  // removed below
                moved[s] = true
            }
        }
        k = k - 1
    }
    if len(moved) == 0 {
        return f
    }
    let mut insts: [ir.Inst] = []
    for i in out.insts {
        let gone = i.op == ir.Op.Label && i.imm == -1 || i.op == ir.Op.SlotAddr && maps.has(moved, i.dst)
        if !gone { push(mut insts, i) }
    }
    out.insts = insts
    return out
}

fn boundary(i: ir.Inst) -> Bool {
    return i.op == ir.Op.Label || ir.ends_block(i.op) || i.op == ir.Op.BranchCmp
}

fn reads_any(regs: [Int], set: Map[Int, Bool]) -> Bool {
    for r in regs {
        if maps.has(set, r) { return true }
    }
    return false
}

// The slot a register set once holds the address of, or -1.
fn slot_of(f: ir.Func, r: Int) -> Int {
    for i in f.insts {
        if i.dst == r && i.op == ir.Op.SlotAddr { return i.imm }
    }
    return -1
}

// The labels an instruction can go to.
fn targets(i: ir.Inst) -> [Int] {
    if i.op == ir.Op.Jump || i.op == ir.Op.BranchCmp { return [i.imm] }
    if i.op == ir.Op.Branch { return [i.imm, i.imm2] }
    return []
}

// A field read through a pointer in a loop is read once, before the loop,
// and kept in a register, when nothing else in the loop can change it:
// `r.pos < len(r.text) && r.text[r.pos] >= '0'` scanning a `mut Reader`
// otherwise loads r.pos, r.text's length and its data again at every use.
// The loop must be innermost, entered only by falling into its header, and
// make no calls except to panic (those end their path). It may write memory
// only with stores through one pointer, and then only that pointer's fields
// are kept: another could point to the same memory. A field the loop stores
// is a whole word; the store stays, so memory is current after the loop, and
// also sets the register. Reading a field before the loop must not fault
// where the loop would not have: the header, which runs whenever the loop
// is entered, reads through the same pointer at that offset or beyond.
fn loop_fields(f: ir.Func) -> ir.Func {
    let mut out = f
    let mut changed = true
    for changed {
        changed = false
        let g = out
        let mut label_at: Map[Int, Int] = [:]
        for k in 0..len(g.insts) {
            if g.insts[k].op == ir.Op.Label { label_at[g.insts[k].imm] = k }
        }
        let defs = def_counts(g)
        let mut defined: [Int] = []  // where each register set once is set; -1 for parameters
        for _ in g.classes { push(mut defined, -1) }
        for k in 0..len(g.insts) {
            if g.insts[k].dst >= 0 { defined[g.insts[k].dst] = k }
        }
        let mut k = len(g.insts) - 1
        for k >= 0 && !changed {
            let mut header = -1
            for t in targets(g.insts[k]) {
                if maps.has(label_at, t) && label_at[t] <= k { header = label_at[t] }
            }
            if header >= 0 { changed = promote_loop(g, mut out, label_at, defs, defined, header, k) }
            k = k - 1
        }
    }
    return out
}

// The loop from the label at `h` to the jump back at `e`; true if `out` is
// `f` with fields kept in registers.
fn promote_loop(f: ir.Func, out: mut ir.Func, label_at: Map[Int, Int], defs: [Int], defined: [Int], h: Int, e: Int) -> Bool {
    if h > 0 && ir.ends_block(f.insts[h - 1].op) { return false }  // entered by a jump; at 0, by the call
    let head = f.insts[h].imm
    for k in 0..len(f.insts) {
        for t in targets(f.insts[k]) {
            if !maps.has(label_at, t) { continue }
            let at = label_at[t]
            if at >= h && at <= e && (k < h || k > e) { return false }  // into the loop
            if k >= h && k <= e && at <= k && t != head { return false }  // an inner loop
        }
    }
    let mut writer = -1
    for k in h..e + 1 {
        let i = f.insts[k]
        if i.op == ir.Op.Call || i.op == ir.Op.CallInd || i.op == ir.Op.Copy || i.op == ir.Op.RcInc || i.op == ir.Op.RcDec { return false }
        if i.op == ir.Op.CCall && (k + 1 > e || f.insts[k + 1].op != ir.Op.Unreachable) { return false }
        if i.op == ir.Op.Store || i.op == ir.Op.FStore {
            if writer >= 0 && writer != i.a { return false }
            writer = i.a
        }
    }
    // How far each pointer is read in the header, which every entry runs.
    let mut reach: Map[Int, Int] = [:]
    let mut k = h + 1
    for k <= e && !ir.ends_block(f.insts[k].op) && f.insts[k].op != ir.Op.BranchCmp && f.insts[k].op != ir.Op.Label {
        let i = f.insts[k]
        if (i.op == ir.Op.Load || i.op == ir.Op.FLoad) && i.imm >= 0 {
            if !maps.has(reach, i.a) || reach[i.a] < i.imm { reach[i.a] = i.imm }
        }
        k = k + 1
    }
    // Fields: "pointer:offset:size:float", with the register keeping them.
    let mut kept: Map[Str, Int] = [:]
    let mut written: Map[Str, Bool] = [:]
    let mut order: [Str] = []
    for k in h..e + 1 {
        let i = f.insts[k]
        if i.op != ir.Op.Load && i.op != ir.Op.FLoad { continue }
        let p = i.a
        if defs[p] != 1 || (defined[p] >= h && defined[p] <= e) || i.imm < 0 { continue }
        if writer >= 0 && writer != p { continue }
        if !maps.has(reach, p) || i.imm > reach[p] { continue }
        let float = i.op == ir.Op.FLoad
        let mut size = 8
        if !float { size = i.imm2 }
        let key = field_key(p, i.imm, size, float)
        if maps.has(kept, key) { continue }
        // The loop's stores to this pointer: none may overlap the field
        // unless it is the same whole-word field.
        let mut ok = true
        let mut stored = false
        for x in f.insts[h..e + 1] {
            if (x.op != ir.Op.Store && x.op != ir.Op.FStore) || x.a != p { continue }
            let mut width = 8
            if x.op == ir.Op.Store { width = x.imm2 }
            if x.imm + width <= i.imm || i.imm + size <= x.imm { continue }
            if x.imm == i.imm && width == 8 && size == 8 && (x.op == ir.Op.FStore) == float { stored = true } else { ok = false }
        }
        if !ok { continue }
        let mut class = ir.INT()
        if float { class = ir.FLOAT() }
        kept[key] = ir.reg(mut out, class)
        written[key] = stored
        push(mut order, key)
    }
    if len(order) == 0 { return false }
    // Registers a kept field was loaded into, when the loop never stores it.
    let mut rep: [Int] = []
    for r in 0..len(out.classes) { push(mut rep, r) }
    let mut insts: [ir.Inst] = []
    for k in 0..len(f.insts) {
        let i = f.insts[k]
        if k == h {
            for key in order {
                let mut load = first_load(f, h, e, key)
                load.dst = kept[key]
                push(mut insts, load)
            }
        }
        if k >= h && k <= e && (i.op == ir.Op.Load || i.op == ir.Op.FLoad) {
            let mut size = 8
            if i.op == ir.Op.Load { size = i.imm2 }
            let key = field_key(i.a, i.imm, size, i.op == ir.Op.FLoad)
            if maps.has(kept, key) {
                if written[key] || defs[i.dst] != 1 { push(mut insts, ir.inst(ir.Op.Move, i.dst, kept[key], -1, 0)) } else { rep[i.dst] = kept[key] }
                continue
            }
        }
        push(mut insts, i)
        if k >= h && k <= e && (i.op == ir.Op.Store || i.op == ir.Op.FStore) {
            let key = field_key(i.a, i.imm, 8, i.op == ir.Op.FStore)
            if maps.has(kept, key) && (i.op == ir.Op.FStore || i.imm2 == 8) {
                push(mut insts, ir.inst(ir.Op.Move, kept[key], i.b, -1, 0))
            }
        }
    }
    out.insts = []
    for i in insts { push(mut out.insts, renamed(i, rep)) }
    return true
}

fn field_key(p: Int, offset: Int, size: Int, float: Bool) -> Str {
    let mut kind = "i"
    if float { kind = "f" }
    return strings.from_int(p) + ":" + strings.from_int(offset) + ":" + strings.from_int(size) + ":" + kind
}

// The loop's first load of a field, to repeat before the loop.
fn first_load(f: ir.Func, h: Int, e: Int, key: Str) -> ir.Inst {
    for i in f.insts[h..e + 1] {
        if i.op != ir.Op.Load && i.op != ir.Op.FLoad { continue }
        let mut size = 8
        if i.op == ir.Op.Load { size = i.imm2 }
        if field_key(i.a, i.imm, size, i.op == ir.Op.FLoad) == key { return i }
    }
    return f.insts[h]  // not reached: every key comes from such a load
}

// A test already decided on the way here is not made again: after
// `branch.cmp ult i, n` has gone to its label, `i <u n` holds there, so the
// same bounds check on `xs[i]` read a second time always passes. A test
// leaves its condition known on the way it goes and the opposite one on the
// other; a label keeps what is known on its one way in, or what every way in
// agrees on when they all come before it (not a loop's jump back). Only
// integer registers set once take part, so a fact cannot outlive its
// values (and a failed Float test does not make the opposite true: NaN).
fn known_branches(f: ir.Func) -> ir.Func {
    let defs = def_counts(f)
    let mut ways: Map[Int, Int] = [:]
    for k in 0..len(f.insts) {
        let i = f.insts[k]
        for t in targets(i) { ways[t] = ways_to(ways, t) + 1 }
        if i.op == ir.Op.Label && k > 0 && !ir.ends_block(f.insts[k - 1].op) { ways[i.imm] = ways_to(ways, i.imm) + 1 }
    }
    let mut facts: Map[Str, Bool] = [:]
    let mut saved: Map[Int, Map[Str, Bool]] = [:]
    let mut arrivals: Map[Int, Int] = [:]
    let mut falls = false
    let mut changed = false
    let mut out = f
    out.insts = []
    for i in f.insts {
        if i.op == ir.Op.Label {
            let n = ways_to(ways, i.imm)
            if falls { meet(mut saved, mut arrivals, i.imm, facts) }
            if ways_to(arrivals, i.imm) == n && n > 0 { facts = saved[i.imm] } else { facts = [:] }
        }
        if i.op == ir.Op.BranchCmp && i.a >= 0 && i.b >= 0 && defs[i.a] == 1 && defs[i.b] == 1 && inverse(i.sym) != "" &&
            f.classes[i.a] != ir.FLOAT() && f.classes[i.b] != ir.FLOAT() {
            let holds = fact(i.sym, i.a, i.b)
            let fails = fact(inverse(i.sym), i.a, i.b)
            if maps.has(facts, holds) {
                changed = true
                let jump = ir.inst(ir.Op.Jump, -1, -1, -1, i.imm)
                meet(mut saved, mut arrivals, i.imm, facts)
                push(mut out.insts, jump)
                falls = false
                continue
            }
            if maps.has(facts, fails) {
                changed = true
                continue  // never taken
            }
            let mut taken = facts
            learn(mut taken, i.sym, i.a, i.b)
            meet(mut saved, mut arrivals, i.imm, taken)
            learn(mut facts, inverse(i.sym), i.a, i.b)
            push(mut out.insts, i)
            falls = true
            continue
        }
        for t in targets(i) { meet(mut saved, mut arrivals, t, facts) }
        falls = !ir.ends_block(i.op)
        push(mut out.insts, i)
    }
    if !changed { return f }
    return out
}

// The fact that `a cond b`, written one way for each pair of equivalent
// conditions: a > b is b < a.
fn fact(cond: Str, a: Int, b: Int) -> Str {
    let mut c = cond
    let mut x = a
    let mut y = b
    if c == "gt" || c == "ge" || c == "ugt" || c == "uge" {
        c = match c { "gt" => "lt", "ge" => "le", "ugt" => "ult", _ => "ule" }
        x = b
        y = a
    }
    if (c == "eq" || c == "ne") && b < a {
        x = b
        y = a
    }
    return c + ":" + strings.from_int(x) + ":" + strings.from_int(y)
}

// Know that `a cond b`, and what follows from it directly.
fn learn(facts: mut Map[Str, Bool], cond: Str, a: Int, b: Int) {
    facts[fact(cond, a, b)] = true
    let also = match cond {
        "lt" => ["le", "ne"], "gt" => ["ge", "ne"], "ult" => ["ule", "ne"], "ugt" => ["uge", "ne"], "eq" => ["le", "ge", "ule", "uge"], _ => [],
    }
    for c in also { facts[fact(c, a, b)] = true }
}

// One more way into `label`, with `facts` known on it: keep what every way so
// far agrees on.
fn meet(saved: mut Map[Int, Map[Str, Bool]], arrivals: mut Map[Int, Int], label: Int, facts: Map[Str, Bool]) {
    if ways_to(arrivals, label) == 0 {
        saved[label] = facts
    } else {
        let have = saved[label]
        let mut both: Map[Str, Bool] = [:]
        for key in maps.keys(facts) {
            if maps.has(have, key) { both[key] = true }
        }
        saved[label] = both
    }
    arrivals[label] = ways_to(arrivals, label) + 1
}

// A loop jumps back to its header, which tests and leaves:
//     H: branch.cmp ge i, n, E    ...body...    jump H    E:
// The jump back can make the test itself, to a label after the header's:
//     H: branch.cmp ge i, n, E    B: ...body...    branch.cmp lt i, n, B    jump E    E:
// so a turn takes one branch, not a jump and a branch (the jump to the label
// right after it is not written). Only integer tests: the opposite of a
// Float comparison is not one when NaN is involved.
fn rotate_loops(f: ir.Func) -> ir.Func {
    let mut label_at: Map[Int, Int] = [:]
    for k in 0..len(f.insts) {
        if f.insts[k].op == ir.Op.Label { label_at[f.insts[k].imm] = k }
    }
    let mut out = f
    let mut body: Map[Int, Int] = [:]  // header label: the label after its test
    let mut insts: [ir.Inst] = []
    for k in 0..len(f.insts) {
        let i = f.insts[k]
        let mut rotated = false
        if i.op == ir.Op.Jump && maps.has(label_at, i.imm) && label_at[i.imm] < k && label_at[i.imm] + 1 < len(f.insts) {
            let check = f.insts[label_at[i.imm] + 1]
            let opposite = inverse(check.sym)
            if check.op == ir.Op.BranchCmp && opposite != "" && check.a >= 0 && check.b >= 0 &&
                f.classes[check.a] != ir.FLOAT() && f.classes[check.b] != ir.FLOAT() {
                if !maps.has(body, i.imm) { body[i.imm] = ir.label(mut out) }
                let mut back = check
                back.sym = opposite
                back.imm = body[i.imm]
                push(mut insts, back)
                push(mut insts, ir.inst(ir.Op.Jump, -1, -1, -1, check.imm))
                rotated = true
            }
        }
        if !rotated { push(mut insts, i) }
    }
    if len(body) == 0 { return f }
    // The new labels, right after their headers' tests.
    out.insts = []
    for k in 0..len(insts) {
        push(mut out.insts, insts[k])
        if k > 0 && insts[k - 1].op == ir.Op.Label && maps.has(body, insts[k - 1].imm) && insts[k].op == ir.Op.BranchCmp {
            push(mut out.insts, ir.inst(ir.Op.Label, -1, -1, -1, body[insts[k - 1].imm]))
        }
    }
    return out
}

// The opposite integer condition, or "".
fn inverse(cond: Str) -> Str {
    return match cond {
        "eq" => "ne", "ne" => "eq", "lt" => "ge", "ge" => "lt", "le" => "gt", "gt" => "le",
        "ult" => "uge", "uge" => "ult", "ule" => "ugt", "ugt" => "ule", _ => "",
    }
}

fn compact_slots(f: ir.Func) -> ir.Func {
    let mut used: Map[Int, Bool] = [:]; for i in f.insts { if i.op == ir.Op.SlotAddr { used[i.imm] = true } }
    let mut slots: Map[Int, Int] = [:]; let mut out = f; out.slot_sizes = []; out.slot_aligns = []
    for s in 0..len(f.slot_sizes) { if maps.has(used, s) { slots[s] = len(out.slot_sizes); push(mut out.slot_sizes, f.slot_sizes[s]); push(mut out.slot_aligns, f.slot_aligns[s]) } }
    out.insts = []; for original in f.insts { let mut i = original; if i.op == ir.Op.SlotAddr { i.imm = slots[i.imm] }; push(mut out.insts, i) }
    return out
}

fn hoist_floats(f: ir.Func) -> ir.Func {
    let defs = def_counts(f); let mut constants: Map[Str, Int] = [:]; let mut rep: [Int] = []
    for r in 0..len(f.classes) { push(mut rep, r) }
    let mut out = f; out.insts = []
    for i in f.insts { if i.op == ir.Op.FConst && defs[i.dst] == 1 {
        match maps.get(constants, i.sym) { Some(v) => rep[i.dst] = v, None => { constants[i.sym] = i.dst; push(mut out.insts, i) } }
    } }
    for i in f.insts { if i.op != ir.Op.FConst || defs[i.dst] != 1 { push(mut out.insts, renamed(i, rep)) } }
    return out
}

fn fuse_branches(f: ir.Func) -> ir.Func {
    let mut counts: [Int] = []; for _ in f.classes { push(mut counts, 0) }
    for i in f.insts { for r in ir.reads(i) { counts[r] = counts[r] + 1 } }
    let mut out = f; out.insts = []; let mut at = 0
    for at < len(f.insts) {
        let i = f.insts[at]
        if (i.op == ir.Op.Cmp || i.op == ir.Op.CmpImm) && counts[i.dst] == 1 && at + 1 < len(f.insts) {
            let next = f.insts[at + 1]
            if next.op == ir.Op.Branch && next.a == i.dst {
                let mut b = i.b
                if i.op == ir.Op.CmpImm { b = ir.reg(mut out, ir.INT()); push(mut out.insts, ir.inst(ir.Op.Const, b, -1, -1, i.imm2)) }
                let mut branch = ir.inst(ir.Op.BranchCmp, -1, i.a, b, next.imm)
                branch.sym = match i.imm { 0 => "eq", 1 => "ne", 2 => "lt", 3 => "le", 4 => "gt", _ => "ge" }
                push(mut out.insts, branch); push(mut out.insts, ir.inst(ir.Op.Jump, -1, -1, -1, next.imm2)); at = at + 2; continue
            }
        }
        push(mut out.insts, i); at = at + 1
    }
    return out
}

// How many times each register is set: parameters count once.
fn def_counts(f: ir.Func) -> [Int] {
    let mut defs: [Int] = []
    for _ in 0..len(f.classes) {
        push(mut defs, 0)
    }
    for p in f.params {
        defs[p] = defs[p] + 1
    }
    for i in f.insts {
        if i.dst >= 0 {
            defs[i.dst] = defs[i.dst] + 1
        }
    }
    return defs
}

fn propagate(f: ir.Func) -> ir.Func {
    let defs = def_counts(f)
    let mut rep: [Int] = []
    for r in 0..len(f.classes) {
        push(mut rep, r)
    }
    let mut any = false
    for i in f.insts {
        if i.op == ir.Op.Move && defs[i.dst] == 1 && defs[i.a] == 1 && f.classes[i.dst] == f.classes[i.a] {
            rep[i.dst] = i.a
            any = true
        }
    }
    if !any {
        return f
    }
    // Chains: a move of a move.
    for r in 0..len(rep) {
        let mut x = rep[r]
        for rep[x] != x {
            x = rep[x]
        }
        rep[r] = x
    }
    let mut out = f
    out.insts = []
    for i in f.insts {
        if i.op == ir.Op.Move && rep[i.dst] != i.dst {
            continue
        }
        push(mut out.insts, renamed(i, rep))
    }
    return out
}

// `i` reading rep[r] for each register r it reads.
fn renamed(i: ir.Inst, rep: [Int]) -> ir.Inst {
    let mut o = i
    let reads_a = i.a >= 0 && i.op != ir.Op.Label && i.op != ir.Op.Const && i.op != ir.Op.FConst && i.op != ir.Op.SlotAddr &&
        i.op != ir.Op.SymAddr && i.op != ir.Op.Jump
    if reads_a {
        o.a = rep[i.a]
    }
    if i.b >= 0 {
        o.b = rep[i.b]
    }
    if len(i.args) > 0 {
        let mut args: [Int] = []
        for a in i.args {
            push(mut args, rep[a])
        }
        o.args = args
    }
    return o
}

fn fold(f: ir.Func) -> ir.Func {
    let defs = def_counts(f)
    let mut known: Map[Int, Int] = [:]  // registers set once to a constant
    for i in f.insts {
        if i.op == ir.Op.Const && defs[i.dst] == 1 {
            known[i.dst] = i.imm
        }
    }
    let mut out = f
    out.insts = []
    for i in f.insts {
        let mut o = i
        let ak = maps.has(known, i.a); let bk = maps.has(known, i.b)
        let mut a = 2; let mut b = 2; if ak { a = known[i.a] }; if bk { b = known[i.b] }
        let add = i.op == ir.Op.Add || i.op == ir.Op.AddChk
        let sub = i.op == ir.Op.Sub || i.op == ir.Op.SubChk
        let mul = i.op == ir.Op.Mul || i.op == ir.Op.MulChk
        let div = i.op == ir.Op.Div || i.op == ir.Op.DivChk
        let rem = i.op == ir.Op.Rem || i.op == ir.Op.RemChk
        if (sub && i.a == i.b) || (mul && ((ak && a == 0) || (bk && b == 0))) || (rem && bk && b == 1) || (i.op == ir.Op.And && ((ak && a == 0) || (bk && b == 0))) {
            o = ir.inst(ir.Op.Const, i.dst, -1, -1, 0)
        } else if ((add || sub || i.op == ir.Op.Or || i.op == ir.Op.Xor || i.op == ir.Op.Shl || i.op == ir.Op.Shr || i.op == ir.Op.Sar) && bk && b == 0) || ((mul || div) && bk && b == 1) || (i.op == ir.Op.And && bk && b == -1) {
            o = ir.inst(ir.Op.Move, i.dst, i.a, -1, 0)
        } else if (add && ak && a == 0) || (mul && ak && a == 1) || (i.op == ir.Op.And && ak && a == -1) {
            o = ir.inst(ir.Op.Move, i.dst, i.b, -1, 0)
        }
        if i.dst >= 0 && defs[i.dst] == 1 && maps.has(known, i.a) {
            let a = known[i.a]; let mut n = a; let mut folded = true
            if i.op == ir.Op.AddImm { n = ints.wrapping_add(a, i.imm) } else if i.op == ir.Op.MulImm { n = ints.wrapping_mul(a, i.imm) } else if i.op == ir.Op.Inv { n = ~a } else if i.op == ir.Op.Extend {
                if i.imm < 64 { let mask = (1 << i.imm) - 1; n = a & mask; if i.imm2 != 0 { let sign = 1 << (i.imm - 1); n = (n ^ sign) - sign } }
            } else if (i.op == ir.Op.ToByte || i.op == ir.Op.ByteChk) && a >= 0 && a <= 255 {
                n = a
            } else if maps.has(known, i.b) {
                let b = known[i.b]
                if i.op == ir.Op.Add { n = ints.wrapping_add(a, b) } else if i.op == ir.Op.Sub { n = ints.wrapping_sub(a, b) } else if i.op == ir.Op.Mul { n = ints.wrapping_mul(a, b) } else if i.op == ir.Op.And { n = a & b } else if i.op == ir.Op.Or { n = a | b } else if i.op == ir.Op.Xor { n = a ^ b } else if i.op == ir.Op.Shl && b >= 0 && b < 64 { n = a << b } else if i.op == ir.Op.Sar && b >= 0 && b < 64 { n = a >> b } else { folded = false }
            } else { folded = false }
            if folded { o = ir.inst(ir.Op.Const, i.dst, -1, -1, n); known[i.dst] = n }
        }
        if i.op == ir.Op.Cmp && maps.has(known, i.a) && maps.has(known, i.b) {
            o = ir.inst(ir.Op.Const, i.dst, -1, -1, bool_int(holds(i.imm, known[i.a], known[i.b])))
        } else if i.op == ir.Op.CmpImm && maps.has(known, i.a) {
            o = ir.inst(ir.Op.Const, i.dst, -1, -1, bool_int(holds(i.imm, known[i.a], i.imm2)))
        } else if i.op == ir.Op.Cmp && maps.has(known, i.b) {
            // Against a constant: the immediate form, which needs no register.
            o = ir.inst(ir.Op.CmpImm, i.dst, i.a, -1, i.imm)
            o.imm2 = known[i.b]
        } else if i.op == ir.Op.Branch && maps.has(known, i.a) {
            if known[i.a] != 0 {
                o = ir.inst(ir.Op.Jump, -1, -1, -1, i.imm)
            } else {
                o = ir.inst(ir.Op.Jump, -1, -1, -1, i.imm2)
            }
        } else if i.op == ir.Op.BranchCmp && maps.has(known, i.a) && maps.has(known, i.b) {
            if branch_holds(i.sym, known[i.a], known[i.b]) {
                o = ir.inst(ir.Op.Jump, -1, -1, -1, i.imm)
            } else {
                continue
            }
        }
        push(mut out.insts, o)
    }
    return out
}

fn bool_int(b: Bool) -> Int {
    if b {
        return 1
    }
    return 0
}

fn drop_dead(f: ir.Func) -> ir.Func {
    let mut out = f
    for _ in 0..4 {
        let mut used: [Int] = []
        for _ in 0..len(out.classes) {
            push(mut used, 0)
        }
        for i in out.insts {
            for r in ir.reads(i) {
                used[r] = used[r] + 1
            }
        }
        let mut kept: [ir.Inst] = []
        let mut dropped = false
        for i in out.insts {
            if i.dst >= 0 && pure(i.op) && used[i.dst] == 0 {
                dropped = true
                continue
            }
            push(mut kept, i)
        }
        out.insts = kept
        if !dropped {
            break
        }
    }
    return out
}

fn thread_jumps(f: ir.Func) -> ir.Func {
    // Labels followed by a jump: where that jump goes.
    let mut to: Map[Int, Int] = [:]
    for k in 0..len(f.insts) - 1 {
        if f.insts[k].op == ir.Op.Label && f.insts[k + 1].op == ir.Op.Jump && f.insts[k + 1].imm != f.insts[k].imm {
            to[f.insts[k].imm] = f.insts[k + 1].imm
        }
    }
    if len(maps.keys(to)) == 0 {
        return f
    }
    let mut out = f
    out.insts = []
    for i in f.insts {
        let mut o = i
        if i.op == ir.Op.Jump || i.op == ir.Op.Branch || i.op == ir.Op.BranchCmp {
            o.imm = final_label(to, i.imm)
        }
        if i.op == ir.Op.Branch {
            o.imm2 = final_label(to, i.imm2)
        }
        push(mut out.insts, o)
    }
    return out
}

// Following jumps to jumps, a few at most (they may go round in a loop).
fn final_label(to: Map[Int, Int], l: Int) -> Int {
    let mut x = l
    for _ in 0..8 {
        match maps.get(to, x) {
            Some(y) => x = y
            None => return x
        }
    }
    return x
}

// After a jump, a return or code that never returns, nothing runs until a
// label something jumps to.
fn drop_unreachable(f: ir.Func) -> ir.Func {
    let mut target: Map[Int, Bool] = [:]
    for i in f.insts {
        if i.op == ir.Op.Jump || i.op == ir.Op.Branch || i.op == ir.Op.BranchCmp {
            target[i.imm] = true
        }
        if i.op == ir.Op.Branch {
            target[i.imm2] = true
        }
    }
    let mut out = f
    out.insts = []
    let mut live = true
    for k in 0..len(f.insts) {
        let i = f.insts[k]
        if i.op == ir.Op.Label {
            if maps.has(target, i.imm) {
                live = true
            } else if !live {
                continue
            }
            // A label nothing jumps to, reached by falling through, stays out.
            if !maps.has(target, i.imm) {
                continue
            }
        }
        if !live {
            continue
        }
        // A jump to the label right after it.
        if i.op == ir.Op.Jump && k + 1 < len(f.insts) && f.insts[k + 1].op == ir.Op.Label && f.insts[k + 1].imm == i.imm {
            continue
        }
        push(mut out.insts, i)
        if ir.ends_block(i.op) {
            live = false
        }
    }
    return out
}

// ---- Tests ----

fn small_program() -> ir.Program {
    // id(x) = x; main calls it and compares the result with 3.
    let mut id = ir.new_func("f_id", ir.INT())
    let x = ir.param(mut id, ir.INT())
    let y = ir.reg(mut id, ir.INT())
    ir.add(mut id, ir.inst(ir.Op.Move, y, x, -1, 0))
    ir.add(mut id, ir.inst(ir.Op.Ret, -1, y, -1, 0))
    let mut m = ir.new_func("f_main", -1)
    let three = ir.reg(mut m, ir.INT())
    ir.add(mut m, ir.inst(ir.Op.Const, three, -1, -1, 3))
    let r = ir.reg(mut m, ir.INT())
    let mut c = ir.inst(ir.Op.Call, r, -1, -1, 0)
    c.sym = "f_id"
    c.args = [three]
    ir.add(mut m, c)
    let same = ir.reg(mut m, ir.INT())
    ir.add(mut m, ir.inst(ir.Op.Cmp, same, r, three, 0))
    let yes = ir.label(mut m)
    let no = ir.label(mut m)
    let mut b = ir.inst(ir.Op.Branch, -1, same, -1, yes)
    b.imm2 = no
    ir.add(mut m, b)
    ir.add(mut m, ir.inst(ir.Op.Label, -1, -1, -1, yes))
    ir.add(mut m, ir.inst(ir.Op.Ret, -1, -1, -1, 0))
    ir.add(mut m, ir.inst(ir.Op.Label, -1, -1, -1, no))
    ir.add(mut m, ir.inst(ir.Op.Unreachable, -1, -1, -1, 0))
    return ir.Program { funcs: [id, m], data: [] }
}

test "inlining, then folding what it shows" {
    let p = optimize(small_program())
    let m = p.funcs[1]
    // id(3) == 3 is known once id is inlined: what is left is the return.
    for i in m.insts {
        assert(i.op != ir.Op.Call && i.op != ir.Op.Cmp && i.op != ir.Op.Unreachable)
    }
    assert(m.insts[len(m.insts) - 1].op == ir.Op.Ret)
}

test "unsigned comparisons of constants" {
    assert(branch_holds("ult", 1, 2) && !branch_holds("ult", -1, 2) && branch_holds("ult", 2, -1))
    assert(branch_holds("uge", -1, 2) && !branch_holds("uge", 1, 2))
}

test "unsigned branches compare both high-bit values correctly" {
    assert(branch_holds("ult", -2, -1))
    assert(!branch_holds("ult", -1, -2))
    assert(branch_holds("ugt", -1, -2))
    assert(!branch_holds("ugt", 1, -1))
    assert(branch_holds("ule", -1, -1))
    assert(!branch_holds("uge", -2, -1))
}
