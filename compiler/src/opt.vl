// Optimizing the IR (M11b), between lower.vl and x64.vl.
//
// - Inlining. A call to a small function becomes a copy of its body,
//   with its registers, slots and labels renumbered: the function's
//   parameters are set from the arguments, and each return sets the
//   call's result and jumps to after the call. Small means at most
//   inline_limit() instructions; recursive bodies have a smaller limit
//   and a separate per-caller expansion budget. The functions
//   lowering writes for memory (rc_retain_T, box helpers) are mostly
//   such, and so are accessors and the many one-line functions of a
//   program. Two rounds, so that what an inlined body calls can be
//   inlined too, each copying the bodies as the round before left them.
// - Copy propagation. A register set once, by a move from another set
//   once, is replaced by that other everywhere, and the move goes.
// - Folding. A comparison of two constants is a constant, and a branch
//   on a constant is a jump.
// - Jump threading. A jump to a label followed only by a jump goes
//   straight to where that one goes.
// - Dead code. An instruction with no effect whose result nobody reads
//   goes, and so does code no jump can reach.
import ir
import maps
import strings
import ints
import promote

fn inline_limit() -> Int {
    return 80
}

pub fn optimize(p: ir.Program) -> ir.Program {
    return optimize_with(p, inline_limit(), 2)
}

// With functions of at most `limit` instructions inlined, `rounds` times.
pub fn optimize_with(p: ir.Program, limit: Int, rounds: Int) -> ir.Program {
    let mut funcs = p.funcs
    let mut index: Map[Str, Int] = [:]
    for i in 0..len(funcs) {
        index[funcs[i].name] = i
    }
    for _ in 0..rounds {
        let before = funcs
        let mut small: Map[Str, Bool] = [:]
        let mut recursive: Map[Str, Bool] = [:]
        for f in before {
            let self_call = calls(f, f.name)
            // A bounded expansion of small recursive bodies exposes their
            // base cases without raising the general inlining threshold.
            if len(f.insts) <= limit && (!self_call || len(f.insts) <= 40) && !f.public {
                small[f.name] = true
                if self_call { recursive[f.name] = true }
            }
        }
        for i in 0..len(funcs) {
            funcs[i] = simplify(inline_calls(funcs[i], before, index, small, recursive))
        }
    }
    for i in 0..len(funcs) { funcs[i] = compact_slots(forward_destinations(hoist_floats(rotate_loops(funcs[i])))) }
    return ir.Program { funcs: funcs, data: p.data }
}

fn calls(f: ir.Func, name: Str) -> Bool {
    for i in f.insts {
        if i.op == ir.Op.Call && i.sym == name {
            return true
        }
    }
    return false
}

// ---- Inlining ----

fn inline_calls(f: ir.Func, all: [ir.Func], index: Map[Str, Int], small: Map[Str, Bool], recursive: Map[Str, Bool]) -> ir.Func {
    let mut out = f
    out.insts = []
    let mut recursive_budget = 160
    for i in f.insts {
        if i.op != ir.Op.Call || !maps.has(small, i.sym) {
            push(mut out.insts, i)
            continue
        }
        let g = all[index[i.sym]]
        if maps.has(recursive, i.sym) {
            if len(g.insts) > recursive_budget { push(mut out.insts, i); continue }
            recursive_budget = recursive_budget - len(g.insts)
        }
        let regs = len(out.classes)
        for c in g.classes {
            push(mut out.classes, c)
        }
        let slots = len(out.slot_sizes)
        for s in 0..len(g.slot_sizes) {
            push(mut out.slot_sizes, g.slot_sizes[s])
            push(mut out.slot_aligns, g.slot_aligns[s])
        }
        let labels = out.labels
        out.labels = out.labels + g.labels + 1
        let end = out.labels - 1
        for k in 0..len(g.params) {
            push(mut out.insts, ir.inst(ir.Op.Move, g.params[k] + regs, i.args[k], -1, 0))
        }
        for gi in g.insts {
            if gi.op == ir.Op.Ret {
                if i.dst >= 0 && gi.a >= 0 {
                    push(mut out.insts, ir.inst(ir.Op.Move, i.dst, gi.a + regs, -1, 0))
                }
                push(mut out.insts, ir.inst(ir.Op.Jump, -1, -1, -1, end))
                continue
            }
            push(mut out.insts, renumbered(gi, regs, slots, labels))
        }
        push(mut out.insts, ir.inst(ir.Op.Label, -1, -1, -1, end))
    }
    return out
}

fn renumbered(i: ir.Inst, regs: Int, slots: Int, labels: Int) -> ir.Inst {
    let mut o = i
    if o.dst >= 0 {
        o.dst = o.dst + regs
    }
    if o.a >= 0 {
        o.a = o.a + regs
    }
    if o.b >= 0 {
        o.b = o.b + regs
    }
    if len(o.args) > 0 {
        let mut args: [Int] = []
        for a in o.args {
            push(mut args, a + regs)
        }
        o.args = args
    }
    if o.op == ir.Op.Label || o.op == ir.Op.Jump || o.op == ir.Op.Branch || o.op == ir.Op.BranchCmp {
        o.imm = o.imm + labels
    }
    if o.op == ir.Op.Branch {
        o.imm2 = o.imm2 + labels
    }
    if o.op == ir.Op.SlotAddr {
        o.imm = o.imm + slots
    }
    return o
}

// ---- Simplifying ----

// Instructions with no effect but their result.
fn pure(op: ir.Op) -> Bool {
    return match op {
        ir.Op.Const => true
        ir.Op.FConst => true
        ir.Op.Move => true
        ir.Op.SlotAddr => true
        ir.Op.SymAddr => true
        ir.Op.Load => true
        ir.Op.FLoad => true
        ir.Op.Add => true
        ir.Op.AddImm => true
        ir.Op.Sub => true
        ir.Op.Mul => true
        ir.Op.MulImm => true
        ir.Op.Cmp => true
        ir.Op.CmpImm => true
        ir.Op.FCmp => true
        ir.Op.Not => true
        ir.Op.FAdd => true
        ir.Op.FSub => true
        ir.Op.FMul => true
        ir.Op.FDiv => true
        ir.Op.FTo32 => true
        ir.Op.FFrom32 => true
        ir.Op.FNeg => true
        ir.Op.FSqrt => true
        ir.Op.IntToFloat => true
        ir.Op.And => true
        ir.Op.Or => true
        ir.Op.Xor => true
        ir.Op.Inv => true
        ir.Op.Shl => true
        ir.Op.Shr => true
        ir.Op.Sar => true
        ir.Op.Extend => true
        ir.Op.Div => true
        ir.Op.Rem => true
        ir.Op.Sext32 => true
        _ => false
    }
}

fn holds(cond: Int, a: Int, b: Int) -> Bool {
    return match cond {
        0 => a == b
        1 => a != b
        2 => a < b
        3 => a <= b
        4 => a > b
        _ => a >= b
    }
}

fn branch_holds(cond: Str, a: Int, b: Int) -> Bool {
    return match cond {
        "eq" => a == b
        "ne" => a != b
        "lt" => a < b
        "le" => a <= b
        "gt" => a > b
        "ge" => a >= b
        "ult" => (a >= 0 && b < 0) || ((a < 0) == (b < 0) && a < b)
        "ugt" => (a < 0 && b >= 0) || ((a < 0) == (b < 0) && a > b)
        "ule" => (a >= 0 && b < 0) || ((a < 0) == (b < 0) && a <= b)
        _ => !((a >= 0 && b < 0) || ((a < 0) == (b < 0) && a < b))
    }
}

fn simplify(f: ir.Func) -> ir.Func {
    let mut out = f
    for _ in 0..4 {
        let before = len(out.insts)
        out = propagate(out)
        out = local_copies(out)
        out = scalar_copy(out)
        out = promote.function(out)
        out = reuse(out)
        out = fold(out)
        out = fuse_branches(out)
        out = drop_dead(out)
        out = thread_jumps(out)
        out = drop_unreachable(out)
        if len(out.insts) == before {
            break
        }
    }
    return out
}

// Compute directly into a following move's destination when the private
// result has no other readers. This removes false overlap with loop-carried
// variables before allocation. Keep it after simplification: value numbering
// must still see the original single-definition results while it runs.
fn forward_destinations(f: ir.Func) -> ir.Func {
    let defs = def_counts(f); let mut readers: [Int] = []
    for _ in f.classes { push(mut readers, 0) }
    for i in f.insts { for r in ir.reads(i) { readers[r] = readers[r] + 1 } }
    let mut out = f; out.insts = []; let mut at = 0
    for at < len(f.insts) {
        let mut i = f.insts[at]
        if i.dst >= 0 && defs[i.dst] == 1 && readers[i.dst] == 1 && at + 1 < len(f.insts) && (pure(i.op) || i.op == ir.Op.AddChk || i.op == ir.Op.SubChk || i.op == ir.Op.MulChk || i.op == ir.Op.DivChk || i.op == ir.Op.RemChk) {
            let next = f.insts[at + 1]
            if next.op == ir.Op.Move && next.a == i.dst && next.dst != i.dst && f.classes[next.dst] == f.classes[i.dst] {
                i.dst = next.dst; push(mut out.insts, i); at = at + 2; continue
            }
        }
        push(mut out.insts, i); at = at + 1
    }
    return out
}

// A private temporary copied only to read one field need not materialize
// the rest of the aggregate. Keep the read at the copy's original point:
// there can be no intervening store, call, or change to the source address.
fn scalar_copy(f: ir.Func) -> ir.Func {
    let defs = def_counts(f); let mut counts: [Int] = []; let mut addresses: [Int] = []
    let mut slots: Map[Int, Int] = [:]
    for _ in f.classes { push(mut counts, 0) }
    for _ in f.slot_sizes { push(mut addresses, 0) }
    for i in f.insts {
        for r in ir.reads(i) { counts[r] = counts[r] + 1 }
        if i.op == ir.Op.SlotAddr { slots[i.dst] = i.imm; addresses[i.imm] = addresses[i.imm] + 1 }
    }
    let mut out = f; out.insts = []; let mut at = 0
    for at < len(f.insts) {
        let i = f.insts[at]
        if i.op == ir.Op.Copy && maps.has(slots, i.a) && defs[i.a] == 1 && counts[i.a] == 2 && addresses[slots[i.a]] == 1 && at + 1 < len(f.insts) {
            let mut after = at + 1
            for after < len(f.insts) && (f.insts[after].op == ir.Op.SlotAddr || f.insts[after].op == ir.Op.SymAddr || f.insts[after].op == ir.Op.Const || f.insts[after].op == ir.Op.FConst) {
                if f.insts[after].dst == i.b { break }; after = after + 1
            }
            if after >= len(f.insts) { push(mut out.insts, i); at = at + 1; continue }
            let mut next = f.insts[after]; let mut size = next.imm2; if next.op == ir.Op.FLoad { size = 8 }
            if next.op == ir.Op.Copy && next.b == i.a && next.imm == i.imm {
                for between in at + 1..after { push(mut out.insts, f.insts[between]) }
                next.b = i.b; push(mut out.insts, next); at = after + 1; continue
            }
            if (next.op == ir.Op.Load || next.op == ir.Op.FLoad) && next.a == i.a && next.imm >= 0 && size > 0 && next.imm <= i.imm - size {
                for between in at + 1..after { push(mut out.insts, f.insts[between]) }
                next.a = i.b; push(mut out.insts, next); at = after + 1; continue
            }
        }
        push(mut out.insts, i); at = at + 1
    }
    return out
}

// A snapshot can use its source register until that source is assigned.
// Keep the original move: later reads after an assignment or a control-flow
// boundary still need the frozen value. Dead-code removal drops it only when
// every read was safely replaced. Representatives always point one hop to a
// register that currently represents itself.
fn local_copies(f: ir.Func) -> ir.Func {
    let mut rep: [Int] = []; for r in 0..len(f.classes) { push(mut rep, r) }
    let mut active: [Int] = []; let mut out = f; out.insts = []
    for original in f.insts {
        if original.op == ir.Op.Label { for r in active { rep[r] = r }; active = [] }
        let i = renamed(original, rep)
        if i.op == ir.Op.Move && i.dst == i.a { continue }
        if i.dst >= 0 {
            let d = i.dst; let mut kept: [Int] = []
            for r in active {
                if rep[r] == d || r == d { rep[r] = r } else { push(mut kept, r) }
            }; active = kept; rep[d] = d
            if i.op == ir.Op.Move && i.a != d { rep[d] = i.a; push(mut active, d) }
        }
        push(mut out.insts, i)
        if ir.ends_block(i.op) || i.op == ir.Op.BranchCmp { for r in active { rep[r] = r }; active = [] }
    }
    return out
}

// Value numbering within a basic block. Immutable register expressions can
// survive writes; memory reads cannot. Clear both tables at control-flow
// boundaries, and all load facts at every possible memory mutation.
// Block-local value numbering: a pure instruction computing what an earlier
// one in the block computed reuses its result. Its operands may be
// registers defined more than once, such as a loop variable: what read one
// is forgotten where it is defined again (`readers`), so x[j]'s address is
// worked out once per iteration, not at every field.
fn reuse(f: ir.Func) -> ir.Func {
    let defs = def_counts(f); let mut values: Map[Str, Int] = [:]; let mut loads: Map[Str, Int] = [:]
    let mut readers: Map[Int, [Str]] = [:]  // multiply defined register: the keys reading it
    let mut rep: [Int] = []; for r in 0..len(f.classes) { push(mut rep, r) }
    let mut out = f; out.insts = []
    for original in f.insts {
        let i = renamed(original, rep)
        if i.op == ir.Op.Label || ir.ends_block(i.op) || i.op == ir.Op.BranchCmp { values = [:]; loads = [:]; readers = [:] }
        let reading = i.op == ir.Op.Load || i.op == ir.Op.FLoad
        if i.op == ir.Op.Call || i.op == ir.Op.CallInd || i.op == ir.Op.CCall || i.op == ir.Op.Store || i.op == ir.Op.FStore || i.op == ir.Op.Copy || i.op == ir.Op.RcInc || i.op == ir.Op.RcDec { loads = [:] }
        let candidate = i.dst >= 0 && pure(i.op) && defs[i.dst] == 1
        if candidate {
            let key = ir.op_name(i.op) + ":" + strings.from_int(i.a) + ":" + strings.from_int(i.b) + ":" + strings.from_int(i.imm) + ":" + strings.from_int(i.imm2) + ":" + i.sym
            let mut previous = -1
            if reading { match maps.get(loads, key) { Some(v) => previous = v, None => {} } } else { match maps.get(values, key) { Some(v) => previous = v, None => {} } }
            if previous >= 0 { rep[i.dst] = previous; continue }
            if reading { loads[key] = i.dst } else { values[key] = i.dst }
            for r in ir.reads(i) {
                if defs[r] != 1 {
                    let mut keys: [Str] = []
                    match maps.get(readers, r) { Some(ks) => keys = ks, None => {} }
                    push(mut keys, key)
                    readers[r] = keys
                }
            }
        }
        // A register defined again: nothing computed from its old value holds.
        if i.dst >= 0 && defs[i.dst] != 1 {
            match maps.get(readers, i.dst) {
                Some(keys) => {
                    for key in keys {
                        if maps.has(values, key) { maps.remove(mut values, key) }
                        if maps.has(loads, key) { maps.remove(mut loads, key) }
                    }
                    maps.remove(mut readers, i.dst)
                }
                None => {}
            }
        }
        push(mut out.insts, i)
    }
    return out
}

// A loop jumps back to its header, which tests and leaves:
//     H: branch.cmp ge i, n, E    ...body...    jump H    E:
// The jump back can make the test itself, to a label after the header's:
//     H: branch.cmp ge i, n, E    B: ...body...    branch.cmp lt i, n, B    jump E    E:
// so a turn takes one branch, not a jump and a branch (the jump to the label
// right after it is not written). Only integer tests: the opposite of a
// Float comparison is not one when NaN is involved.
fn rotate_loops(f: ir.Func) -> ir.Func {
    let mut label_at: Map[Int, Int] = [:]
    for k in 0..len(f.insts) {
        if f.insts[k].op == ir.Op.Label { label_at[f.insts[k].imm] = k }
    }
    let mut out = f
    let mut body: Map[Int, Int] = [:]  // header label: the label after its test
    let mut insts: [ir.Inst] = []
    for k in 0..len(f.insts) {
        let i = f.insts[k]
        let mut rotated = false
        if i.op == ir.Op.Jump && maps.has(label_at, i.imm) && label_at[i.imm] < k && label_at[i.imm] + 1 < len(f.insts) {
            let check = f.insts[label_at[i.imm] + 1]
            let opposite = inverse(check.sym)
            if check.op == ir.Op.BranchCmp && opposite != "" && check.a >= 0 && check.b >= 0 &&
                f.classes[check.a] != ir.FLOAT() && f.classes[check.b] != ir.FLOAT() {
                if !maps.has(body, i.imm) { body[i.imm] = ir.label(mut out) }
                let mut back = check
                back.sym = opposite
                back.imm = body[i.imm]
                push(mut insts, back)
                push(mut insts, ir.inst(ir.Op.Jump, -1, -1, -1, check.imm))
                rotated = true
            }
        }
        if !rotated { push(mut insts, i) }
    }
    if len(body) == 0 { return f }
    // The new labels, right after their headers' tests.
    out.insts = []
    for k in 0..len(insts) {
        push(mut out.insts, insts[k])
        if k > 0 && insts[k - 1].op == ir.Op.Label && maps.has(body, insts[k - 1].imm) && insts[k].op == ir.Op.BranchCmp {
            push(mut out.insts, ir.inst(ir.Op.Label, -1, -1, -1, body[insts[k - 1].imm]))
        }
    }
    return out
}

// The opposite integer condition, or "".
fn inverse(cond: Str) -> Str {
    return match cond {
        "eq" => "ne", "ne" => "eq", "lt" => "ge", "ge" => "lt", "le" => "gt", "gt" => "le",
        "ult" => "uge", "uge" => "ult", "ule" => "ugt", "ugt" => "ule", _ => "",
    }
}

fn compact_slots(f: ir.Func) -> ir.Func {
    let mut used: Map[Int, Bool] = [:]; for i in f.insts { if i.op == ir.Op.SlotAddr { used[i.imm] = true } }
    let mut slots: Map[Int, Int] = [:]; let mut out = f; out.slot_sizes = []; out.slot_aligns = []
    for s in 0..len(f.slot_sizes) { if maps.has(used, s) { slots[s] = len(out.slot_sizes); push(mut out.slot_sizes, f.slot_sizes[s]); push(mut out.slot_aligns, f.slot_aligns[s]) } }
    out.insts = []; for original in f.insts { let mut i = original; if i.op == ir.Op.SlotAddr { i.imm = slots[i.imm] }; push(mut out.insts, i) }
    return out
}

fn hoist_floats(f: ir.Func) -> ir.Func {
    let defs = def_counts(f); let mut constants: Map[Str, Int] = [:]; let mut rep: [Int] = []
    for r in 0..len(f.classes) { push(mut rep, r) }
    let mut out = f; out.insts = []
    for i in f.insts { if i.op == ir.Op.FConst && defs[i.dst] == 1 {
        match maps.get(constants, i.sym) { Some(v) => rep[i.dst] = v, None => { constants[i.sym] = i.dst; push(mut out.insts, i) } }
    } }
    for i in f.insts { if i.op != ir.Op.FConst || defs[i.dst] != 1 { push(mut out.insts, renamed(i, rep)) } }
    return out
}

fn fuse_branches(f: ir.Func) -> ir.Func {
    let mut counts: [Int] = []; for _ in f.classes { push(mut counts, 0) }
    for i in f.insts { for r in ir.reads(i) { counts[r] = counts[r] + 1 } }
    let mut out = f; out.insts = []; let mut at = 0
    for at < len(f.insts) {
        let i = f.insts[at]
        if (i.op == ir.Op.Cmp || i.op == ir.Op.CmpImm) && counts[i.dst] == 1 && at + 1 < len(f.insts) {
            let next = f.insts[at + 1]
            if next.op == ir.Op.Branch && next.a == i.dst {
                let mut b = i.b
                if i.op == ir.Op.CmpImm { b = ir.reg(mut out, ir.INT()); push(mut out.insts, ir.inst(ir.Op.Const, b, -1, -1, i.imm2)) }
                let mut branch = ir.inst(ir.Op.BranchCmp, -1, i.a, b, next.imm)
                branch.sym = match i.imm { 0 => "eq", 1 => "ne", 2 => "lt", 3 => "le", 4 => "gt", _ => "ge" }
                push(mut out.insts, branch); push(mut out.insts, ir.inst(ir.Op.Jump, -1, -1, -1, next.imm2)); at = at + 2; continue
            }
        }
        push(mut out.insts, i); at = at + 1
    }
    return out
}

// How many times each register is set: parameters count once.
fn def_counts(f: ir.Func) -> [Int] {
    let mut defs: [Int] = []
    for _ in 0..len(f.classes) {
        push(mut defs, 0)
    }
    for p in f.params {
        defs[p] = defs[p] + 1
    }
    for i in f.insts {
        if i.dst >= 0 {
            defs[i.dst] = defs[i.dst] + 1
        }
    }
    return defs
}

fn propagate(f: ir.Func) -> ir.Func {
    let defs = def_counts(f)
    let mut rep: [Int] = []
    for r in 0..len(f.classes) {
        push(mut rep, r)
    }
    let mut any = false
    for i in f.insts {
        if i.op == ir.Op.Move && defs[i.dst] == 1 && defs[i.a] == 1 && f.classes[i.dst] == f.classes[i.a] {
            rep[i.dst] = i.a
            any = true
        }
    }
    if !any {
        return f
    }
    // Chains: a move of a move.
    for r in 0..len(rep) {
        let mut x = rep[r]
        for rep[x] != x {
            x = rep[x]
        }
        rep[r] = x
    }
    let mut out = f
    out.insts = []
    for i in f.insts {
        if i.op == ir.Op.Move && rep[i.dst] != i.dst {
            continue
        }
        push(mut out.insts, renamed(i, rep))
    }
    return out
}

// `i` reading rep[r] for each register r it reads.
fn renamed(i: ir.Inst, rep: [Int]) -> ir.Inst {
    let mut o = i
    let reads_a = i.a >= 0 && i.op != ir.Op.Label && i.op != ir.Op.Const && i.op != ir.Op.FConst && i.op != ir.Op.SlotAddr &&
        i.op != ir.Op.SymAddr && i.op != ir.Op.Jump
    if reads_a {
        o.a = rep[i.a]
    }
    if i.b >= 0 {
        o.b = rep[i.b]
    }
    if len(i.args) > 0 {
        let mut args: [Int] = []
        for a in i.args {
            push(mut args, rep[a])
        }
        o.args = args
    }
    return o
}

fn fold(f: ir.Func) -> ir.Func {
    let defs = def_counts(f)
    let mut known: Map[Int, Int] = [:]  // registers set once to a constant
    for i in f.insts {
        if i.op == ir.Op.Const && defs[i.dst] == 1 {
            known[i.dst] = i.imm
        }
    }
    let mut out = f
    out.insts = []
    for i in f.insts {
        let mut o = i
        let ak = maps.has(known, i.a); let bk = maps.has(known, i.b)
        let mut a = 2; let mut b = 2; if ak { a = known[i.a] }; if bk { b = known[i.b] }
        let add = i.op == ir.Op.Add || i.op == ir.Op.AddChk
        let sub = i.op == ir.Op.Sub || i.op == ir.Op.SubChk
        let mul = i.op == ir.Op.Mul || i.op == ir.Op.MulChk
        let div = i.op == ir.Op.Div || i.op == ir.Op.DivChk
        let rem = i.op == ir.Op.Rem || i.op == ir.Op.RemChk
        if (sub && i.a == i.b) || (mul && ((ak && a == 0) || (bk && b == 0))) || (rem && bk && b == 1) || (i.op == ir.Op.And && ((ak && a == 0) || (bk && b == 0))) {
            o = ir.inst(ir.Op.Const, i.dst, -1, -1, 0)
        } else if ((add || sub || i.op == ir.Op.Or || i.op == ir.Op.Xor || i.op == ir.Op.Shl || i.op == ir.Op.Shr || i.op == ir.Op.Sar) && bk && b == 0) || ((mul || div) && bk && b == 1) || (i.op == ir.Op.And && bk && b == -1) {
            o = ir.inst(ir.Op.Move, i.dst, i.a, -1, 0)
        } else if (add && ak && a == 0) || (mul && ak && a == 1) || (i.op == ir.Op.And && ak && a == -1) {
            o = ir.inst(ir.Op.Move, i.dst, i.b, -1, 0)
        }
        if i.dst >= 0 && defs[i.dst] == 1 && maps.has(known, i.a) {
            let a = known[i.a]; let mut n = a; let mut folded = true
            if i.op == ir.Op.AddImm { n = ints.wrapping_add(a, i.imm) } else if i.op == ir.Op.MulImm { n = ints.wrapping_mul(a, i.imm) } else if i.op == ir.Op.Inv { n = ~a } else if i.op == ir.Op.Extend {
                if i.imm < 64 { let mask = (1 << i.imm) - 1; n = a & mask; if i.imm2 != 0 { let sign = 1 << (i.imm - 1); n = (n ^ sign) - sign } }
            } else if maps.has(known, i.b) {
                let b = known[i.b]
                if i.op == ir.Op.Add { n = ints.wrapping_add(a, b) } else if i.op == ir.Op.Sub { n = ints.wrapping_sub(a, b) } else if i.op == ir.Op.Mul { n = ints.wrapping_mul(a, b) } else if i.op == ir.Op.And { n = a & b } else if i.op == ir.Op.Or { n = a | b } else if i.op == ir.Op.Xor { n = a ^ b } else if i.op == ir.Op.Shl && b >= 0 && b < 64 { n = a << b } else if i.op == ir.Op.Sar && b >= 0 && b < 64 { n = a >> b } else { folded = false }
            } else { folded = false }
            if folded { o = ir.inst(ir.Op.Const, i.dst, -1, -1, n); known[i.dst] = n }
        }
        if i.op == ir.Op.Cmp && maps.has(known, i.a) && maps.has(known, i.b) {
            o = ir.inst(ir.Op.Const, i.dst, -1, -1, bool_int(holds(i.imm, known[i.a], known[i.b])))
        } else if i.op == ir.Op.CmpImm && maps.has(known, i.a) {
            o = ir.inst(ir.Op.Const, i.dst, -1, -1, bool_int(holds(i.imm, known[i.a], i.imm2)))
        } else if i.op == ir.Op.Cmp && maps.has(known, i.b) {
            // Against a constant: the immediate form, which needs no register.
            o = ir.inst(ir.Op.CmpImm, i.dst, i.a, -1, i.imm)
            o.imm2 = known[i.b]
        } else if i.op == ir.Op.Branch && maps.has(known, i.a) {
            if known[i.a] != 0 {
                o = ir.inst(ir.Op.Jump, -1, -1, -1, i.imm)
            } else {
                o = ir.inst(ir.Op.Jump, -1, -1, -1, i.imm2)
            }
        } else if i.op == ir.Op.BranchCmp && maps.has(known, i.a) && maps.has(known, i.b) {
            if branch_holds(i.sym, known[i.a], known[i.b]) {
                o = ir.inst(ir.Op.Jump, -1, -1, -1, i.imm)
            } else {
                continue
            }
        }
        push(mut out.insts, o)
    }
    return out
}

fn bool_int(b: Bool) -> Int {
    if b {
        return 1
    }
    return 0
}

fn drop_dead(f: ir.Func) -> ir.Func {
    let mut out = f
    for _ in 0..4 {
        let mut used: [Int] = []
        for _ in 0..len(out.classes) {
            push(mut used, 0)
        }
        for i in out.insts {
            for r in ir.reads(i) {
                used[r] = used[r] + 1
            }
        }
        let mut kept: [ir.Inst] = []
        let mut dropped = false
        for i in out.insts {
            if i.dst >= 0 && pure(i.op) && used[i.dst] == 0 {
                dropped = true
                continue
            }
            push(mut kept, i)
        }
        out.insts = kept
        if !dropped {
            break
        }
    }
    return out
}

fn thread_jumps(f: ir.Func) -> ir.Func {
    // Labels followed by a jump: where that jump goes.
    let mut to: Map[Int, Int] = [:]
    for k in 0..len(f.insts) - 1 {
        if f.insts[k].op == ir.Op.Label && f.insts[k + 1].op == ir.Op.Jump && f.insts[k + 1].imm != f.insts[k].imm {
            to[f.insts[k].imm] = f.insts[k + 1].imm
        }
    }
    if len(maps.keys(to)) == 0 {
        return f
    }
    let mut out = f
    out.insts = []
    for i in f.insts {
        let mut o = i
        if i.op == ir.Op.Jump || i.op == ir.Op.Branch || i.op == ir.Op.BranchCmp {
            o.imm = final_label(to, i.imm)
        }
        if i.op == ir.Op.Branch {
            o.imm2 = final_label(to, i.imm2)
        }
        push(mut out.insts, o)
    }
    return out
}

// Following jumps to jumps, a few at most (they may go round in a loop).
fn final_label(to: Map[Int, Int], l: Int) -> Int {
    let mut x = l
    for _ in 0..8 {
        match maps.get(to, x) {
            Some(y) => x = y
            None => return x
        }
    }
    return x
}

// After a jump, a return or code that never returns, nothing runs until a
// label something jumps to.
fn drop_unreachable(f: ir.Func) -> ir.Func {
    let mut target: Map[Int, Bool] = [:]
    for i in f.insts {
        if i.op == ir.Op.Jump || i.op == ir.Op.Branch || i.op == ir.Op.BranchCmp {
            target[i.imm] = true
        }
        if i.op == ir.Op.Branch {
            target[i.imm2] = true
        }
    }
    let mut out = f
    out.insts = []
    let mut live = true
    for k in 0..len(f.insts) {
        let i = f.insts[k]
        if i.op == ir.Op.Label {
            if maps.has(target, i.imm) {
                live = true
            } else if !live {
                continue
            }
            // A label nothing jumps to, reached by falling through, stays out.
            if !maps.has(target, i.imm) {
                continue
            }
        }
        if !live {
            continue
        }
        // A jump to the label right after it.
        if i.op == ir.Op.Jump && k + 1 < len(f.insts) && f.insts[k + 1].op == ir.Op.Label && f.insts[k + 1].imm == i.imm {
            continue
        }
        push(mut out.insts, i)
        if ir.ends_block(i.op) {
            live = false
        }
    }
    return out
}

// ---- Tests ----

fn small_program() -> ir.Program {
    // id(x) = x; main calls it and compares the result with 3.
    let mut id = ir.new_func("f_id", ir.INT())
    let x = ir.param(mut id, ir.INT())
    let y = ir.reg(mut id, ir.INT())
    ir.add(mut id, ir.inst(ir.Op.Move, y, x, -1, 0))
    ir.add(mut id, ir.inst(ir.Op.Ret, -1, y, -1, 0))
    let mut m = ir.new_func("f_main", -1)
    let three = ir.reg(mut m, ir.INT())
    ir.add(mut m, ir.inst(ir.Op.Const, three, -1, -1, 3))
    let r = ir.reg(mut m, ir.INT())
    let mut c = ir.inst(ir.Op.Call, r, -1, -1, 0)
    c.sym = "f_id"
    c.args = [three]
    ir.add(mut m, c)
    let same = ir.reg(mut m, ir.INT())
    ir.add(mut m, ir.inst(ir.Op.Cmp, same, r, three, 0))
    let yes = ir.label(mut m)
    let no = ir.label(mut m)
    let mut b = ir.inst(ir.Op.Branch, -1, same, -1, yes)
    b.imm2 = no
    ir.add(mut m, b)
    ir.add(mut m, ir.inst(ir.Op.Label, -1, -1, -1, yes))
    ir.add(mut m, ir.inst(ir.Op.Ret, -1, -1, -1, 0))
    ir.add(mut m, ir.inst(ir.Op.Label, -1, -1, -1, no))
    ir.add(mut m, ir.inst(ir.Op.Unreachable, -1, -1, -1, 0))
    return ir.Program { funcs: [id, m], data: [] }
}

test "inlining, then folding what it shows" {
    let p = optimize(small_program())
    let m = p.funcs[1]
    // id(3) == 3 is known once id is inlined: what is left is the return.
    for i in m.insts {
        assert(i.op != ir.Op.Call && i.op != ir.Op.Cmp && i.op != ir.Op.Unreachable)
    }
    assert(m.insts[len(m.insts) - 1].op == ir.Op.Ret)
}

test "unsigned comparisons of constants" {
    assert(branch_holds("ult", 1, 2) && !branch_holds("ult", -1, 2) && branch_holds("ult", 2, -1))
    assert(branch_holds("uge", -1, 2) && !branch_holds("uge", 1, 2))
}

test "unsigned branches compare both high-bit values correctly" {
    assert(branch_holds("ult", -2, -1))
    assert(!branch_holds("ult", -1, -2))
    assert(branch_holds("ugt", -1, -2))
    assert(!branch_holds("ugt", 1, -1))
    assert(branch_holds("ule", -1, -1))
    assert(!branch_holds("uge", -2, -1))
}
