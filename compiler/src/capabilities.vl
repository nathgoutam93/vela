// Driver policy parsing and conservative unsafe admission, before compilation.
import call_graph
import checker
import json
import os
import packages
import strings
import text
import integers
pub type Options = struct { allow: [Str], deny: [Str], rest: [Str], coverage: Str, debug: Bool, properties: Bool, as_json: Bool, report: Str, cases: Int, seed: Int, size: Int, shrinks: Int, timeout: Int, budget: Int }
pub fn parse(args: [Str], testing: Bool) -> Options uses os {
    let mut allow: [Str] = []; let mut deny: [Str] = []; let mut coverage = ""; let mut debug = false; let mut properties = false; let mut as_json = false; let mut report = ""; let mut cases = 32; let mut seed = 1; let mut size = 8; let mut shrinks = 16; let mut timeout = 1000; let mut budget = 30000; let mut extended = false; let mut i = 0
    for i < len(args) {
        let option = args[i]; if option == "--" { i = i + 1; break }
        if option == "--properties" { if !testing { fail("--properties is available on test") }; properties = true; i = i + 1; continue }
        if option == "--json" { if !testing { fail("--json requires test --properties") }; as_json = true; extended = true; i = i + 1; continue }
        if option == "--report" || option == "--cases" || option == "--seed" || option == "--size" || option == "--shrinks" || option == "--timeout" || option == "--budget" {
            if !testing || i + 1 >= len(args) { fail("invalid property option " + option) }; let value = args[i + 1]; i = i + 2; extended = true
            if option == "--report" { report = value; continue }
            if option == "--seed" { let parsed = integers.literal(value + "u64"); if !parsed.valid || parsed.overflow { fail("invalid u64 property seed") }; seed = parsed.bits; continue }
            let mut n = 0; match text.parse_int(value) { Some(v) => n = v, None => fail("invalid property budget") }
            if n < 0 { fail("property budgets must be nonnegative") }
            if option == "--cases" { if n < 1 || n > 256 { fail("--cases must be 1..256") }; cases = n }
            if option == "--size" { if n > 32 { fail("--size must be 0..32") }; size = n }
            if option == "--shrinks" { if n > 64 { fail("--shrinks must be 0..64") }; shrinks = n }
            if option == "--timeout" { if n < 1 || n > 10000 { fail("--timeout must be 1..10000 milliseconds") }; timeout = n }
            if option == "--budget" { if n < 1 || n > 60000 { fail("--budget must be 1..60000 milliseconds") }; budget = n }
            continue
        }
        if option == "--debug" { debug = true; i = i + 1; continue }
        if option != "--allow" && option != "--deny" && option != "--coverage" { break }
        if i + 1 >= len(args) { fail("missing value after " + option) }; let value = args[i + 1]; i = i + 2
        if option == "--coverage" { if !testing || coverage != "" || value == "" { fail("--coverage REPORT is available once on test") }; coverage = value; continue }
        if !valid(value, option == "--allow") { fail("invalid capability '" + value + "'; use fs[:PATH], os, net, clock or unsafe") }
        if option == "--allow" { push(mut allow, value) } else { push(mut deny, value) }
    }
    if i >= len(args) { fail("missing source file") }
    if extended && !properties { fail("property reporting/budgets require --properties") }
    if properties && coverage != "" { fail("run --coverage and --properties separately; measured coverage and generated case reports have different identities") }
    return Options { allow: allow, deny: deny, rest: args[i..len(args)], coverage: coverage, debug: debug, properties: properties, as_json: as_json, report: report, cases: cases, seed: seed, size: size, shrinks: shrinks, timeout: timeout, budget: budget }
}
fn valid(value: Str, allow: Bool) -> Bool {
    if value == "fs" || value == "os" || value == "net" || value == "clock" || value == "unsafe" { return true }
    return allow && text.starts_with(value, "fs:") && len(value) > 3
}
pub fn fail(message: Str) uses os { os.eprint("vela: " + message + " [E6010]"); os.exit(1) }
pub fn unsafe_allowed(options: Options) -> Bool {
    let mut allowed = false; for value in options.allow { if value == "unsafe" { allowed = true } }; for value in options.deny { if value == "unsafe" { allowed = false } }; return allowed
}
pub fn admit(k: checker.Checked, options: Options, libraries: [Str], testing: Bool) uses os {
    if unsafe_allowed(options) { return }
    let g = call_graph.build(k)
    for i in 0..len(k.fns) { if !testing && k.fns[i].is_test { continue }; if g.unsafe[i] { fail("unsafe code in '" + k.fns[i].decl.name + "' requires --allow unsafe (including audited wrappers)") } }
    // Foreign constructors can execute before any Vela function is entered.
    if len(libraries) > 0 { fail("linked C libraries require --allow unsafe") }
}
