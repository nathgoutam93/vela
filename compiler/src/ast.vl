// The syntax tree and its `vela ast` dump.
//
// The checker's findings are not written onto the nodes: Vela
// values cannot be changed through a shared tree, so instead every
// expression, statement and pattern gets a number, `id`, unique in its
// program, and the checker keeps what it finds in arrays indexed by it.
//
// A missing part is "" for a
// missing name (a module, an enum) and Option for a missing node.
import strings
import integers

pub type TypeName = struct {
    // "[]" for an array type [T], with T as its one argument; "fn" for a
    // function type, with its parameter types as arguments, or "fn->" when
    // it has a result type, which is the last argument
    name: Str
    length: Int  // fixed arrays: >= 0; other types: -1
    args: [TypeName]
    line: Int
    col: Int
    module: Str  // `lexer` in `lexer.Token`, or ""
    // A function type's effects as written after `uses`: `fs`, `os`, or the
    // name of a function-typed parameter (M15).
    effects: [Str]
}

pub type Expr = struct {
    kind: ExprKind
    line: Int
    col: Int
    id: Int
}

pub type ExprKind = enum {
    IntLit(Int)
    FixedIntLit(Int, Str, Bool)  // bit pattern, optional type suffix, written negative
    FloatLit(Str)  // as written: 1.5, 2e10
    ByteLit(Int)
    BoolLit(Bool)
    StrLit(Str)
    Interpolate([InterpolationPart])
    UnitLit
    Name(Str)
    Unary(Str, Expr)  // "-" or "!"
    Binary(Str, Expr, Expr)
    Call(Expr, [Expr])
    Field(Expr, Str)
    Index(Expr, Expr)
    Try(Expr)
    MutArg(Expr)
    Slice(Expr, Expr, Expr)
    ArrayLit([Expr])
    MapLit([MapEntry])
    StructLit(Str, Str, [FieldInit])  // module or "", type name, fields
    Match(Expr, [Arm])
    // `fn(x: Int) -> Int { ... }` or `fn(x) => x * 2`: the parameters, the
    // result type if written, the body (for `=>`, one return of the
    // expression), and whether it was written with `=>`
    Closure([ClosureParam], Option[TypeName], Block, Bool)
}

pub type InterpolationPart = enum {
    Text(Str)
    Hole(Expr)
}

pub type ClosureParam = struct {
    name: Str
    ty: Option[TypeName]  // None when the context tells it
    line: Int
    col: Int
}

pub type MapEntry = struct {
    key: Expr
    value: Expr
}

pub type FieldInit = struct {
    name: Str
    value: Expr
    line: Int
    col: Int
}

pub type Pattern = struct {
    kind: PatternKind
    line: Int
    col: Int
    id: Int
}

pub type PatternKind = enum {
    Wild
    Bind(Str)
    Lit(Expr)
    Range(Expr, Expr)
    // module or "", enum or "" (for Some, None, Ok, Err), variant,
    // whether it has parentheses, and the patterns inside them
    Variant(Str, Str, Str, Bool, [Pattern])
}

pub type Arm = struct {
    pattern: Pattern
    body: ArmBody
    line: Int  // the `=>`
    col: Int
}

pub type ArmBody = enum {
    Value(Expr)  // in a match expression
    Do(Stmt)  // in a match statement: a block or a statement
}

pub type Stmt = struct {
    kind: StmtKind
    line: Int
    col: Int
    id: Int
}

pub type StmtKind = enum {
    Block(Block)
    ExprStmt(Expr)
    Let(Str, Bool, Option[TypeName], Expr)  // name, mutable, annotation, value
    Assign(Expr, Expr)
    If(Expr, Block, Else)
    For(Option[Expr], Block)
    ForRange(Str, Expr, Expr, Block)
    ForEach(Str, Expr, Block)
    Break
    Continue
    Return(Option[Expr])
    MatchStmt(Expr, [Arm])
    Unsafe(Block)
    With([WithItem], Block)  // in a test: fakes for the block
}

// `files = [...]` in `with files = [...], args = [...] { ... }`.
pub type WithItem = struct {
    name: Str
    value: Expr
    line: Int
    col: Int
}

pub type Else = enum {
    NoElse
    ElseBlock(Block)
    ElseIf(Stmt)  // an If
}

pub type Block = struct {
    stmts: [Stmt]
    end_line: Int  // the closing `}`, where "missing return" is reported
    end_col: Int
}

pub type Param = struct {
    name: Str
    ty: TypeName
    line: Int
    col: Int
    mutable: Bool
}

// `T` or `T: Ord + Key` in `fn f[T](...)` or `type Box[T] = ...`.
pub type TypeParam = struct {
    name: Str
    bounds: [Str]
    line: Int
    col: Int
}

pub type FnDecl = struct {
    name: Str
    foreign: Str  // C symbol, or empty for a Vela function
    variadic: Bool
    type_params: [TypeParam]
    params: [Param]
    result: Option[TypeName]
    effects: [Str]  // what it declares it uses: `uses fs, os`
    effects_line: Int  // where `uses` is, or 0
    effects_col: Int
    requires: [Expr]  // contracts: checked when it is called
    ensures: [Expr]  // and when it returns, where `result` is what it returns
    body: Block
    line: Int
    col: Int
    public: Bool
}

pub type FieldDecl = struct {
    name: Str
    ty: TypeName
    line: Int
    col: Int
}

pub type VariantDecl = struct {
    name: Str
    payload: [TypeName]
    line: Int
    col: Int
}

// A struct (fields) or an enum (variants).
pub type TypeDecl = struct {
    name: Str
    params: [TypeParam]
    is_struct: Bool
    is_interface: Bool
    parents: [Str]
    methods: [FnDecl]
    fields: [FieldDecl]
    variants: [VariantDecl]
    line: Int
    col: Int
    public: Bool
}

pub type Import = struct {
    name: Str
    line: Int
    col: Int
}

// `test "name" { ... }`: run by `vela test`, left out of programs.
pub type TestDecl = struct {
    name: Str
    body: Block
    line: Int
    col: Int
}

pub type Program = struct {
    imports: [Import]
    types: [TypeDecl]
    fns: [FnDecl]
    tests: [TestDecl]
}

// Whether `e` has a `mut` argument in it, which may change variables.
pub fn has_mut(e: Expr) -> Bool {
    return match e.kind {
        ExprKind.MutArg(_) => true
        ExprKind.Unary(_, x) => has_mut(x)
        ExprKind.Binary(_, a, b) => has_mut(a) || has_mut(b)
        ExprKind.Call(f, args) => has_mut(f) || any_mut(args)
        ExprKind.Field(x, _) => has_mut(x)
        ExprKind.Index(a, b) => has_mut(a) || has_mut(b)
        ExprKind.Try(x) => has_mut(x)
        ExprKind.Slice(a, b, c) => has_mut(a) || has_mut(b) || has_mut(c)
        ExprKind.ArrayLit(xs) => any_mut(xs)
        ExprKind.MapLit(entries) => entries_mut(entries)
        ExprKind.StructLit(_, _, fields) => fields_mut(fields)
        ExprKind.Match(x, arms) => has_mut(x) || arms_mut(arms)
        _ => false  // a closure's body does not run here
    }
}

fn any_mut(es: [Expr]) -> Bool {
    for e in es {
        if has_mut(e) {
            return true
        }
    }
    return false
}

fn entries_mut(entries: [MapEntry]) -> Bool {
    for en in entries {
        if has_mut(en.key) || has_mut(en.value) {
            return true
        }
    }
    return false
}

fn fields_mut(fields: [FieldInit]) -> Bool {
    for f in fields {
        if has_mut(f.value) {
            return true
        }
    }
    return false
}

fn arms_mut(arms: [Arm]) -> Bool {
    for a in arms {
        match a.body {
            ArmBody.Value(e) => {
                if has_mut(e) {
                    return true
                }
            }
            ArmBody.Do(_) => return true
        }
    }
    return false
}

// ---- `vela ast` ----
//
// An S-expression, rendered as in Stage 0: a list stays on one line unless
// it contains a non-empty block; then its children go on their own lines,
// indented two spaces, after any leading one-line children (a block's
// statements always go on their own lines).

type Sx = enum {
    Atom(Str)
    List([Sx])
    Block([Sx])  // its first item is the atom "block"
}

fn atom(s: Str) -> Sx {
    return Sx.Atom(s)
}

fn list(items: [Sx]) -> Sx {
    return Sx.List(items)
}

pub fn dump(program: Program) -> Str {
    let mut items: [Sx] = []
    for i in program.imports {
        push(mut items, list([atom("import"), atom(i.name)]))
    }
    for t in program.types {
        push(mut items, sx_type_decl(t))
    }
    for f in program.fns {
        push(mut items, sx_fn(f))
    }
    for t in program.tests {
        push(mut items, list([atom("test"), atom(quote(t.name)), sx_block(t.body)]))
    }
    let mut b = strings.builder()
    for x in items {
        for line in render(x) {
            strings.add(mut b, line)
            strings.add_byte(mut b, '\n')
        }
    }
    return strings.build(b)
}

fn qualified(module: Str, name: Str) -> Str {
    if module == "" {
        return name
    }
    return module + "." + name
}

pub fn type_text(t: TypeName) -> Str {
    if t.name == "[;]" { return "[" + type_text(t.args[0]) + "; " + strings.from_int(t.length) + "]" }
    if t.name == "[]" {
        return "[" + type_text(t.args[0]) + "]"
    }
    if t.name == "fn" || t.name == "fn->" {
        let mut n = len(t.args)
        if t.name == "fn->" {
            n = n - 1
        }
        let mut b = strings.builder()
        strings.add(mut b, "fn(")
        for i in 0..n {
            if i > 0 {
                strings.add(mut b, ", ")
            }
            strings.add(mut b, type_text(t.args[i]))
        }
        strings.add_byte(mut b, ')')
        if t.name == "fn->" {
            strings.add(mut b, " -> " + type_text(t.args[n]))
        }
        for i in 0..len(t.effects) {
            if i == 0 {
                strings.add(mut b, " uses ")
            } else {
                strings.add(mut b, ", ")
            }
            strings.add(mut b, t.effects[i])
        }
        return strings.build(b)
    }
    let name = qualified(t.module, t.name)
    if len(t.args) == 0 {
        return name
    }
    let mut b = strings.builder()
    strings.add(mut b, name)
    strings.add_byte(mut b, '[')
    for i in 0..len(t.args) {
        if i > 0 {
            strings.add(mut b, ", ")
        }
        strings.add(mut b, type_text(t.args[i]))
    }
    strings.add_byte(mut b, ']')
    return strings.build(b)
}

fn sx_type_decl(d: TypeDecl) -> Sx {
    let mut items: [Sx] = []
    if d.public {
        push(mut items, atom("pub"))
    }
    if d.is_interface {
        push(mut items, atom("interface"))
        push(mut items, atom(d.name))
        for parent in d.parents { push(mut items, atom(parent)) }
        for method in d.methods { push(mut items, sx_fn(method)) }
    } else if d.is_struct {
        push(mut items, atom("struct"))
        push(mut items, atom(d.name))
        add_type_params(mut items, d.params)
        for f in d.fields {
            push(mut items, list([atom(f.name), atom(type_text(f.ty))]))
        }
    } else {
        push(mut items, atom("enum"))
        push(mut items, atom(d.name))
        add_type_params(mut items, d.params)
        for v in d.variants {
            let mut parts = [atom(v.name)]
            for t in v.payload {
                push(mut parts, atom(type_text(t)))
            }
            push(mut items, list(parts))
        }
    }
    return list(items)
}

// `[T: Ord, U]` as one atom, when there are type parameters.
fn add_type_params(items: mut [Sx], params: [TypeParam]) {
    if len(params) == 0 {
        return
    }
    push(mut items, atom(type_params_text(params)))
}

pub fn type_params_text(params: [TypeParam]) -> Str {
    let mut b = strings.builder()
    strings.add_byte(mut b, '[')
    for i in 0..len(params) {
        if i > 0 {
            strings.add(mut b, ", ")
        }
        strings.add(mut b, params[i].name)
        for j in 0..len(params[i].bounds) {
            if j == 0 {
                strings.add(mut b, ": ")
            } else {
                strings.add(mut b, " + ")
            }
            strings.add(mut b, params[i].bounds[j])
        }
    }
    strings.add_byte(mut b, ']')
    return strings.build(b)
}

fn sx_fn(f: FnDecl) -> Sx {
    let mut params: [Sx] = []
    for p in f.params {
        let mut parts = [atom(p.name)]
        if p.mutable {
            push(mut parts, atom("mut"))
        }
        push(mut parts, atom(type_text(p.ty)))
        push(mut params, list(parts))
    }
    let mut items: [Sx] = []
    if f.public {
        push(mut items, atom("pub"))
    }
    if f.foreign != "" { push(mut items, atom("extern")) }
    push(mut items, atom("fn"))
    push(mut items, atom(f.name))
    add_type_params(mut items, f.type_params)
    if f.variadic { push(mut params, atom("...")) }
    push(mut items, list(params))
    match f.result {
        Some(t) => push(mut items, atom(type_text(t)))
        None => {}
    }
    if len(f.effects) > 0 {
        let mut u = [atom("uses")]
        for e in f.effects {
            push(mut u, atom(e))
        }
        push(mut items, list(u))
    }
    for r in f.requires {
        push(mut items, list([atom("requires"), sx_expr(r)]))
    }
    for r in f.ensures {
        push(mut items, list([atom("ensures"), sx_expr(r)]))
    }
    if f.foreign == "" { push(mut items, sx_block(f.body)) } else { push(mut items, list([atom("symbol"), atom(quote(f.foreign))])) }
    return list(items)
}

fn sx_block(b: Block) -> Sx {
    let mut items = [atom("block")]
    for s in b.stmts {
        push(mut items, sx_stmt(s))
    }
    return Sx.Block(items)
}

fn sx_stmt(s: Stmt) -> Sx {
    match s.kind {
        StmtKind.Block(b) => return sx_block(b)
        StmtKind.ExprStmt(e) => return sx_expr(e)
        StmtKind.Let(name, mutable, annotation, value) => {
            let mut items = [atom("let"), atom(name)]
            if mutable {
                items[0] = atom("let mut")
            }
            match annotation {
                Some(t) => push(mut items, atom(type_text(t)))
                None => {}
            }
            push(mut items, sx_expr(value))
            return list(items)
        }
        StmtKind.Assign(target, value) => return list([atom("="), sx_expr(target), sx_expr(value)])
        StmtKind.If(cond, then, otherwise) => {
            let mut items = [atom("if"), sx_expr(cond), sx_block(then)]
            match otherwise {
                Else.NoElse => {}
                Else.ElseBlock(b) => push(mut items, sx_block(b))
                Else.ElseIf(s2) => push(mut items, sx_stmt(s2))
            }
            return list(items)
        }
        StmtKind.For(cond, body) => {
            let mut items = [atom("for")]
            match cond {
                Some(c) => push(mut items, sx_expr(c))
                None => {}
            }
            push(mut items, sx_block(body))
            return list(items)
        }
        StmtKind.ForRange(name, start, end, body) => {
            return list([atom("for"), atom(name), list([atom(".."), sx_expr(start), sx_expr(end)]), sx_block(body)])
        }
        StmtKind.ForEach(name, iterable, body) => {
            return list([atom("for"), atom(name), list([atom("in"), sx_expr(iterable)]), sx_block(body)])
        }
        StmtKind.Break => return list([atom("break")])
        StmtKind.Continue => return list([atom("continue")])
        StmtKind.Return(value) => {
            match value {
                Some(v) => return list([atom("return"), sx_expr(v)])
                None => return list([atom("return")])
            }
        }
        StmtKind.MatchStmt(scrutinee, arms) => return sx_match(scrutinee, arms)
        StmtKind.Unsafe(body) => return list([atom("unsafe"), sx_block(body)])
        StmtKind.With(items, body) => {
            let mut out = [atom("with")]
            for w in items {
                push(mut out, list([atom(w.name), sx_expr(w.value)]))
            }
            push(mut out, sx_block(body))
            return list(out)
        }
    }
}

fn sx_match(scrutinee: Expr, arms: [Arm]) -> Sx {
    let mut items = [atom("match"), sx_expr(scrutinee)]
    for a in arms {
        let body = match a.body {
            ArmBody.Value(e) => sx_expr(e)
            ArmBody.Do(s) => sx_stmt(s)
        }
        push(mut items, list([atom("=>"), sx_pattern(a.pattern), body]))
    }
    return list(items)
}

fn sx_pattern(p: Pattern) -> Sx {
    match p.kind {
        PatternKind.Wild => return atom("_")
        PatternKind.Bind(name) => return atom(name)
        PatternKind.Lit(e) => return sx_expr(e)
        PatternKind.Range(lo, hi) => return list([atom("..="), sx_expr(lo), sx_expr(hi)])
        PatternKind.Variant(module, enum, variant, parens, args) => {
            let mut name = variant
            if enum != "" {
                name = enum + "." + variant
            }
            name = qualified(module, name)
            if !parens {
                return atom(name)
            }
            let mut items = [atom(name)]
            for x in args {
                push(mut items, sx_pattern(x))
            }
            return list(items)
        }
    }
}

fn sx_exprs(head: Sx, xs: [Expr]) -> Sx {
    let mut items = [head]
    for x in xs {
        push(mut items, sx_expr(x))
    }
    return list(items)
}

fn sx_expr(e: Expr) -> Sx {
    match e.kind {
        ExprKind.IntLit(n) => return atom(strings.from_int(n))
        ExprKind.FixedIntLit(n, name, neg) => return atom(integers.spelling(n, name, neg))
        ExprKind.FloatLit(text) => return atom(text)
        ExprKind.ByteLit(n) => return atom(quote_byte(n))
        ExprKind.BoolLit(b) => {
            if b {
                return atom("true")
            }
            return atom("false")
        }
        ExprKind.StrLit(s) => return atom(quote(s))
        ExprKind.Interpolate(_) => return atom(expr_text(e))
        ExprKind.UnitLit => return atom("()")
        ExprKind.Name(name) => return atom(name)
        ExprKind.Unary(op, x) => return list([atom(op), sx_expr(x)])
        ExprKind.Binary(op, l, r) => return list([atom(op), sx_expr(l), sx_expr(r)])
        ExprKind.Call(callee, args) => {
            let mut items = [atom("call"), sx_expr(callee)]
            for a in args {
                push(mut items, sx_expr(a))
            }
            return list(items)
        }
        ExprKind.Field(obj, name) => return list([atom("."), sx_expr(obj), atom(name)])
        ExprKind.Index(obj, i) => return list([atom("[]"), sx_expr(obj), sx_expr(i)])
        ExprKind.Try(x) => return list([atom("?"), sx_expr(x)])
        ExprKind.MutArg(x) => return list([atom("mut"), sx_expr(x)])
        ExprKind.Slice(obj, lo, hi) => return list([atom("[..]"), sx_expr(obj), sx_expr(lo), sx_expr(hi)])
        ExprKind.ArrayLit(xs) => return sx_exprs(atom("array"), xs)
        ExprKind.MapLit(entries) => {
            let mut items = [atom("map")]
            for en in entries {
                push(mut items, list([sx_expr(en.key), sx_expr(en.value)]))
            }
            return list(items)
        }
        ExprKind.StructLit(module, name, fields) => {
            let mut items = [atom("struct"), atom(qualified(module, name))]
            for f in fields {
                push(mut items, list([atom(f.name), sx_expr(f.value)]))
            }
            return list(items)
        }
        ExprKind.Match(scrutinee, arms) => return sx_match(scrutinee, arms)
        ExprKind.Closure(params, result, body, short) => {
            let mut ps: [Sx] = []
            for p in params {
                match p.ty {
                    Some(t) => push(mut ps, list([atom(p.name), atom(type_text(t))]))
                    None => push(mut ps, list([atom(p.name)]))
                }
            }
            let mut items = [atom("fn"), list(ps)]
            match result {
                Some(t) => push(mut items, atom(type_text(t)))
                None => {}
            }
            if short {
                match body.stmts[0].kind {
                    StmtKind.Return(v) => {
                        match v {
                            Some(x) => push(mut items, list([atom("=>"), sx_expr(x)]))
                            None => {}
                        }
                    }
                    _ => {}
                }
                return list(items)
            }
            push(mut items, sx_block(body))
            return list(items)
        }
    }
}

// A string literal as Vela source would spell it.
pub fn quote(value: Str) -> Str {
    let mut b = strings.builder()
    strings.add_byte(mut b, '"')
    for c in value {
        let escaped = unescape(c)
        if escaped == "" {
            strings.add_byte(mut b, c)
        } else {
            strings.add(mut b, escaped)
        }
    }
    strings.add_byte(mut b, '"')
    return strings.build(b)
}

fn unescape(c: Byte) -> Str {
    return match c {
        '\n' => "\\n"
        '\t' => "\\t"
        '\r' => "\\r"
        '\0' => "\\0"
        '\\' => "\\\\"
        '"' => "\\\""
        _ => ""
    }
}

// A byte literal as Vela source would spell it: 'a', '\n', '\''. A byte no
// literal spells is written as its number, which a Byte context accepts.
pub fn quote_byte(value: Int) -> Str {
    if value == 39 {
        return "'\\''"
    }
    let c = byte(value)
    let escaped = unescape(c)
    if escaped != "" && c != '"' {
        return "'" + escaped + "'"
    }
    if value >= 32 && value < 127 {
        let mut b = strings.builder()
        strings.add_byte(mut b, '\'')
        strings.add_byte(mut b, c)
        strings.add_byte(mut b, '\'')
        return strings.build(b)
    }
    return strings.from_int(value)
}

fn is_block(x: Sx) -> Bool {
    return match x {
        Sx.Block(_) => true
        _ => false
    }
}

// The items of a list or block; an atom has none.
fn items_of(x: Sx) -> [Sx] {
    let none: [Sx] = []
    return match x {
        Sx.Atom(_) => none
        Sx.List(items) => items
        Sx.Block(items) => items
    }
}

fn multiline(x: Sx) -> Bool {
    let items = items_of(x)
    if is_block(x) && len(items) > 1 {
        return true
    }
    for c in items {
        if multiline(c) {
            return true
        }
    }
    return false
}

fn render(x: Sx) -> [Str] {
    match x {
        Sx.Atom(s) => return [s]
        _ => {}
    }
    let items = items_of(x)
    if !multiline(x) {
        let mut b = strings.builder()
        strings.add_byte(mut b, '(')
        for i in 0..len(items) {
            if i > 0 {
                strings.add_byte(mut b, ' ')
            }
            strings.add(mut b, render(items[i])[0])
        }
        strings.add_byte(mut b, ')')
        return [strings.build(b)]
    }
    let mut lines = ["(" + render(items[0])[0]]
    let mut i = 1
    for i < len(items) && !multiline(items[i]) && !is_block(x) {
        lines[0] = lines[0] + " " + render(items[i])[0]
        i = i + 1
    }
    for child in items[i..len(items)] {
        for line in render(child) {
            push(mut lines, "  " + line)
        }
    }
    let last = len(lines) - 1
    lines[last] = lines[last] + ")"
    return lines
}

// ---- Expressions as source text ----
//
// For messages that quote the program: `assert` prints its condition when it
// fails. Parentheses leave no node behind, so they are put back where the
// precedence needs them.

// How tightly an expression binds, as the parser counts it.
fn power(e: Expr) -> Int {
    return match e.kind {
        ExprKind.Binary(op, _, _) => op_power(op)
        ExprKind.Unary(_, _) => 30
        ExprKind.MutArg(_) => 0
        ExprKind.Closure(_, _, _, _) => 0
        _ => 40
    }
}

fn op_power(op: Str) -> Int {
    return match op {
        "||" => 2
        "&&" => 4
        "|" => 7
        "^" => 8
        "&" => 9
        "<<" => 10
        ">>" => 10
        "+" => 12
        "-" => 12
        "*" => 20
        "/" => 20
        "%" => 20
        _ => 6  // comparisons
    }
}

// `e`, in parentheses if it binds less tightly than `need`.
fn operand(e: Expr, need: Int) -> Str {
    if power(e) < need {
        return "(" + expr_text(e) + ")"
    }
    return expr_text(e)
}

fn texts(es: [Expr]) -> Str {
    let mut b = strings.builder()
    for i in 0..len(es) {
        if i > 0 {
            strings.add(mut b, ", ")
        }
        strings.add(mut b, expr_text(es[i]))
    }
    return strings.build(b)
}

pub fn expr_text(e: Expr) -> Str {
    match e.kind {
        ExprKind.IntLit(n) => return strings.from_int(n)
        ExprKind.FixedIntLit(n, name, neg) => return integers.spelling(n, name, neg)
        ExprKind.FloatLit(text) => return text
        ExprKind.ByteLit(n) => return quote_byte(n)
        ExprKind.BoolLit(b) => {
            if b {
                return "true"
            }
            return "false"
        }
        ExprKind.StrLit(s) => return quote(s)
        ExprKind.Interpolate(parts) => {
            let mut b = strings.builder()
            strings.add(mut b, "f\"")
            for part in parts {
                match part {
                    InterpolationPart.Text(s) => {
                        for c in s {
                            if c == '{' {
                                strings.add(mut b, "{{")
                            } else if c == '}' {
                                strings.add(mut b, "}}")
                            } else {
                                let escaped = unescape(c)
                                if escaped == "" { strings.add_byte(mut b, c) } else { strings.add(mut b, escaped) }
                            }
                        }
                    }
                    InterpolationPart.Hole(x) => strings.add(mut b, "{" + expr_text(x) + "}")
                }
            }
            strings.add_byte(mut b, '"')
            return strings.build(b)
        }
        ExprKind.UnitLit => return "()"
        ExprKind.Name(name) => return name
        ExprKind.Unary(op, x) => return op + operand(x, 30)
        ExprKind.Binary(op, l, r) => {
            let p = op_power(op)
            let mut left_need = p
            if p == 6 {
                left_need = 7  // comparisons do not chain
            }
            return operand(l, left_need) + " " + op + " " + operand(r, p + 1)
        }
        ExprKind.Call(callee, args) => return operand(callee, 40) + "(" + texts(args) + ")"
        ExprKind.Field(obj, name) => return operand(obj, 40) + "." + name
        ExprKind.Index(obj, i) => return operand(obj, 40) + "[" + expr_text(i) + "]"
        ExprKind.Try(x) => return operand(x, 40) + "?"
        ExprKind.MutArg(x) => return "mut " + expr_text(x)
        ExprKind.Slice(obj, lo, hi) => return operand(obj, 40) + "[" + expr_text(lo) + ".." + expr_text(hi) + "]"
        ExprKind.ArrayLit(xs) => return "[" + texts(xs) + "]"
        ExprKind.MapLit(entries) => {
            if len(entries) == 0 {
                return "[:]"
            }
            let mut b = strings.builder()
            strings.add_byte(mut b, '[')
            for i in 0..len(entries) {
                if i > 0 {
                    strings.add(mut b, ", ")
                }
                strings.add(mut b, expr_text(entries[i].key) + ": " + expr_text(entries[i].value))
            }
            strings.add_byte(mut b, ']')
            return strings.build(b)
        }
        ExprKind.StructLit(module, name, fields) => {
            let mut b = strings.builder()
            strings.add(mut b, qualified(module, name) + " {")
            for i in 0..len(fields) {
                if i > 0 {
                    strings.add_byte(mut b, ',')
                }
                strings.add(mut b, " " + fields[i].name + ": " + expr_text(fields[i].value))
            }
            if len(fields) > 0 {
                strings.add_byte(mut b, ' ')
            }
            strings.add_byte(mut b, '}')
            return strings.build(b)
        }
        ExprKind.Match(scrutinee, _) => return "match " + expr_text(scrutinee) + " { ... }"
        ExprKind.Closure(params, _, _, _) => {
            let mut names: [Str] = []
            for p in params {
                push(mut names, p.name)
            }
            let mut b = strings.builder()
            strings.add(mut b, "fn(")
            for i in 0..len(names) {
                if i > 0 {
                    strings.add(mut b, ", ")
                }
                strings.add(mut b, names[i])
            }
            strings.add(mut b, ") ...")
            return strings.build(b)
        }
    }
}
