// The guide shares lexer/index metadata and parses the installed std API.
import ast
import checker
import files
import index
import interfaces
import lexer
import maps
import modules
import os
import parser
import strings

// The compact reference `vela guide` prints: the language, commands and
// prelude. `vela guide --all` (M31) adds every built-in and std module's
// signatures, so the compact one stays within its reading budget.
pub fn reference(root: Str) -> Str uses fs, os {
    return generate(root, false)
}

pub fn reference_all(root: Str) -> Str uses fs, os {
    return generate(root, true)
}

fn generate(root: Str, all: Bool) -> Str uses fs, os {
    let mut out = strings.builder()
    strings.add(mut out, "# Vela language reference\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "From compiler metadata.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "## Commands\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "`vela check FILE` checks modules/imports; `check --json` emits stable `code`/`fix`. Edits: `file`, UTF-8 byte `start`/`end` (end excluded), replacement `text`, original `expected`. Apply each diagnostic's edits together, right to left. Empty fixes need review.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "`vela explain CODE` explains. `vela fix FILE` edits/rechecks local code; exit 1 means errors remain. `fix --dry-run` previews. Review effects/mutability; dependencies/std stay unchanged.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "`vela run FILE ARGS...` runs; `vela build FILE -o EXE` builds; `vela test FILE [WORDS...]` runs matching local/imported tests. `vela fmt -w FILE...` formats; `-l` lists unformatted files. `vela query type|def|refs|complete FILE:LINE:COL` queries names; `vela query symbols FILE` lists declarations; `vela query unsafe FILE` audits wrappers/indirect/deferred unsafe paths; unknown targets are flagged. `query summary FILE`: API/effects/contracts; `query impact FILE[:LINE:COL]`: conservative dependents; `query coverage TARGET` gives possible tests, or measured entries with `--report REPORT` after `vela test --coverage REPORT FILE`. `vela rename FILE:LINE:COL NEW` renames across modules. Positions are 1-based bytes. `vela lsp` serves editors.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "Build uses C; run/test use native on Linux x86-64/macOS ARM64; `VELA_BACKEND=c|native` overrides. build accepts `--target aarch64-apple-darwin|x86_64-unknown-linux-gnu|x86_64-w64-windows-gnu|wasm32-wasi`; asm supports the first two. `VELA_CC`: C driver; `VELA_TARGET_CC`: explicit-target override (supports zig). `VELA_SYSROOT` and `VELA_CFLAGS` configure it. `VELA_ROOT`: runtime/std. `VELA_CACHE=off`: disable caches. `VELA_INCREMENTAL=1`: object reuse; `VELA_BUILD_REPORT=FILE`: cache JSON.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "build/run/test/asm accept `--debug`: source maps and Vela panic stacks. `VELA_PANIC=json` selects JSON failures. `vela profile [--json REPORT] FILE ARGS...` reports elapsed ns per function/category with instrumentation; workers overlap; needs clock.\n\n")
    strings.add(mut out, "Run/test/profile flags before FILE: `--allow unsafe`, `--allow fs:PATH`, `--deny EFFECT`. Unsafe needs allow; standalone builds unrestricted. Deny wins; fs roots narrow access. Unsupported policies fail closed. macOS deny-net forbids unsafe/subprocesses; restricted C needs Linux.\n\n")
    strings.add(mut out, "E7009: handle discarded Result or acknowledge with repeatable `let _ = call()`; fix never inserts it. `vela verify [--solver z3] [--reuse REPORT] [--build EXE] [--target TARGET] FILE` reports proved/refuted/unknown (exit 0/1/3); unknown checks stay. Evidence binds sources/target/compiler and is rechecked. `vela test --properties [--cases N] [--seed U64] [--size N] [--shrinks N] FILE` runs bounded contract samples, not proofs or ordinary test blocks. Both accept --json, --report REPORT, --timeout MS, --budget MS. Unsupported/effectful domains stay unknown; normal tests/coverage run separately. property.Generator: sample(Self,u64,Int)->u64; shrink(Self,u64)->[u64].\n\n")
    strings.add(mut out, "## Syntax and values\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "Files use `.vl`; entry is `fn main()` with no arguments/result. Libraries need no main. Comments use `//`. Newlines end statements except after an operator. Put `{` on the signature/final-contract line. Parenthesize struct literals in if/for/match conditions. Calls use `module.function(value)` or `value.method()`.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "`i8 i16 i32 i64 u8 u16 u32 u64` are fixed-width integers; Int=i64, Byte=u8 (0..255). Arithmetic/indexing panic on overflow/invalid indexes. Decimal, 0x hex and 0b binary literals allow separators/suffixes (255u8, 0xffff_ffffu32); unsuffixed integers infer context or Int. Signed minima/full u64 are supported. Byte literals: 'a', '\\n'. Width changes require explicit checked i8(x)..u64(x); int/byte remain aliases. Float is binary64 (1.5); float(n)/int(x) convert. Bool: true/false. Str is bytes with UTF-8 source literals and escapes \\n \\t \\r \\0 \\\\ \\\" \\u{e9}; raw r\"\\d+\", r#\"..\"# skip escapes. Unit: (). Import ints: checked_add/sub/mul/div/rem/neg return Option[T]; wrapping_* wrap modulo 2^width; saturating_* clamp. Division by zero panics except checked operations return None. ints.to_str covers all widths. &, |, ^, ~ preserve width. Left shifts discard high bits; signed right shifts sign-extend, unsigned zero-extend. Counts must be in 0..width or panic.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "`+ - * / %` do arithmetic; `+` also joins two strings. `== != < <= > >=` compare; `&& || !` operate on Bool and short-circuit. Precedence, from tight to loose: calls/fields/index/`?`, unary `- ! ~`, `* / %`, `+ -`, `<< >>`, `&`, `^`, `|`, comparisons, `&&`, `||`. There is no truthiness, ternary or increment operator. `n += 1` (also -= *= /= %= &= |= ^= <<= >>=) is `n = n + 1`; a place's indexes are evaluated once.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "Interfaces are structural generic bounds: `pub type Named = interface { fn name(value: Self) -> Str }`; `fn label[T: Named](value: T) -> Str { return value.name() }`. Extend interfaces with `interface: Eq + Named`; qualify imported bounds as `T: views.Named`. Define methods in the receiver type's module with `pub fn Widget.name(value: Widget) -> Str { ... }`. `value.name()` passes the receiver first; `Widget.name(value)` calls the same function. A normal module function taking the receiver first is also eligible. Function-valued fields take precedence. Cross-module calls require pub. Resolution is static; imports cannot add or override methods. Interface signatures have no bodies, contracts, method type parameters or mutable parameters; the first parameter is Self. Concrete fs/os/net/clock/unsafe effects are allowed. Interfaces are bounds, not runtime value types. Eq, Ord, Key and Show are ordinary prelude interfaces; primitive implementations are intrinsic. Operators use eq and compare for custom types. Map keys use eq and hash; equal keys must have equal hashes, and implementations must obey comparison laws.\n")
    strings.add(mut out, "Structs and enums derive Eq, Ord, Key and Show from their fields and payloads, as Option, Result and `[T]` do (maps: Eq and Show): `p == q`, `p < q` (fields, then variants, in declaration order; None < Some, Ok < Err), map keys, and `print(p)` or `f\"{p}\"` writing `Point { x: 1, y: 2 }`, a Str inside a value quoted. A method of the type's own replaces the derived one; `type Handle = struct { fd: Int } without Eq, Show` leaves interfaces out (`without Eq` also Ord and Key). A type that defines eq must define compare and hash. Option and Result have `is_some`/`is_none`, `is_ok`/`is_err`, `unwrap_or(default)`, `map(f)`, `and_then(f)`, `ok_or(error)` and `map_err(f)`; no method panics. In `r == Ok(1)` or `o != None` the constructor takes the other operand's type.\n")
    strings.add(mut out, "```text\n" + interfaces.source() + "```\n\n")
    strings.add(mut out, "`let x = value` infers a type; `let x: Int = 1` annotates it. `let mut x = value` allows reassignment and changes to its fields/elements. Values have copy semantics: assignment, arguments, returns and closure captures copy logically. Arrays/maps/strings share storage until a change, then copy. Changing a copy never changes the original. String elements cannot be assigned. Struct fields use `x.field`.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "`[1, 2]` is an array `[Int]`. Annotate an empty array: `let xs: [Int] = []`. Indexes start at 0. `xs[a..b]` copies an array slice; `s[a..b]` shares immutable string bytes. Both exclude b; strings index to Byte and positions count bytes. `len(s)` counts bytes. `for x in xs` visits elements; `for i in 0..n` excludes n; use an explicit bound for an inclusive loop. In match patterns, `a..=b` includes b. `for condition { ... }` is a while loop; `for { ... }` repeats indefinitely. `if condition { ... } else if ... else { ... }` controls statements; as a value, `if c { a } else { b }` needs else. A value block's value is its last expression.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "A map is `Map[K, V]`; keys satisfy Key. Write `let mut m: Map[Str, Int] = [:]` or `[\"a\": 1]`. `m[key] = value` inserts/replaces; `m[key]` panics if absent. Use maps.get for optional lookup. `for key in maps.keys(m)` visits keys in insertion order. Maps and arrays are values: pass them with `mut` to change a caller's copy.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "## Functions, mutation and generics\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "`fn f(x: Int) -> Int { return x + 1 }` defines a function; omitting `->` means it returns nothing. Parameter types are required. Functions returning values must return on every path. Read-only parameters become mutable with `x: mut T`; callers write `f(mut x)`. Mutable arguments cannot overlap each other or concurrent reads; compute temporaries first. Mutable locals do not imply mutable parameters.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "Function values have types such as `fn(Int) -> Int` and `fn(Str) -> Str uses fs`. Write `fn(x: Int) -> Int { return x * 2 }` or `fn(x) => x * 2`; parameter/result types can be inferred from context. Named functions are values; wrap built-ins in closures. Captures are immutable snapshots. Function values have no mut parameters.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "Generics use `fn identity[T](x: T) -> T { return x }` and `type Box[T] = struct { value: T }`. Type arguments are inferred from arguments and expected return types, not written at call sites: `let b: Box[Int] = Box { value: 1 }`. Bounds are `Eq` for equality, `Ord` for ordering, `Key` for map keys/hashable values; combine with `+`. For example `fn greater[T: Ord](a: T, b: T) -> T`. User-defined interfaces are also bounds.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "## Types, matching and errors\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "`type Point = struct { x: Int, y: Int }` defines a record; construct every field with `Point { x: 1, y: 2 }`. `type Shape = enum { Empty, Circle(Float), Pair(Int, Int) }` defines variants; construct `Shape.Empty` or `Shape.Circle(2.0)`. Payloads are positional. Variants can carry arrays, structs, other enums and recursive values.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "`Option[T]` has `Some(T)` and `None`. `Result[T, E]` has `Ok(T)` and `Err(E)`. They are built in; annotate ambiguous constructors (`let r: Result[Int, Str] = Ok(1)`). A postfix `?` unwraps Some/Ok and returns None/Err from the enclosing function, which must return a compatible Option/Result. It does not throw exceptions. Use explicit matches for deliberate conversion between error types.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "`match value { Some(x) => x, None => 0 }` is an expression; arms must agree in type and cover every case. A statement match may use blocks. `_` matches anything; names bind; variants destructure payloads. Literal and range patterns are supported. `A | B` alternatives bind no names. `Point { x, y: 0 }` names every field, or ends with `..`. `p if cond =>` guards an arm; guarded arms do not count toward covering. Block arms: `=> { let y = f(x); y + 1 }`. Put a fallback last. A bound variable is read-only. A new enum variant requires updating matches. `let Some(v) = o else { return }` binds or leaves; `let Point { x, y } = p` destructures.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "## Modules and packages\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "`import text` loads local `text.vl`, otherwise std/dependencies. Use `text.trim(s)` or `geometry.Point`; names stay qualified. Private by default; `pub fn`/`pub type`/`pub const` export. Public APIs need public types. Local functions win over built-ins. No import cycles or duplicate declarations.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "`vela new NAME` creates a program; `vela new --package NAME` creates a package. A `vela.mod` starts with `package NAME` and names dependencies with `use NAME SOURCE [REF]` (git/local). `stack 1G` enlarges main's stack. `vela get` fetches/pins in vela.lock; `get -u` updates. Builds never fetch. `json` is a package, not std: `vela get` it before `import json`.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "`const NAME[: T] = expr`: immutable module value, initialized once on first read across tasks. Literals/references/operators only; no calls, mutation or cycles. Copy into `let mut` to change.\n\n")
    strings.add(mut out, "## Memory control\n\n")
    strings.add(mut out, "`[T; N]` is a fixed-size inline value (N a literal in 0..4096), initialized from exactly N elements: `let mut pair: [Int; 2] = [1, 2]`. Copying it copies its elements logically; managed fields retain their owners. Indexing, mutation, len and iteration are checked. push is only for growable arrays. Fixed arrays cannot have recursive by-value layouts. Nonrecursive structs in growable arrays are already inline. There is no implicit growable-array conversion.\n\n")
    strings.add(mut out, "`import views` provides Slice[T] read snapshots. views.of/range retain array storage; get/length/sub/to_array access or copy them. views.text uses the existing Str view. Views can outlive a source variable and be returned or captured by tasks. Source mutation copies shared storage, preserving the view. `import buffers` provides Bytes, create/from_array/from_str/to_str, get/set/length/view, and signed/unsigned fixed-width reads/writes with le/be byte order. Width reads allow unaligned offsets and check the whole access. Raw Str-to-byte and byte-to-Str conversions copy; views do not.\n\n")
    strings.add(mut out, "`import arenas` provides Arena[T] contiguous reusable storage and positional Slot[T] handles. create reserves capacity, alloc appends, get/set check index and generation, reset drops values and advances the generation, invalidating old slots. Arena copies keep ordinary snapshots; later writes/reset use copy-on-write. Slots are relative positions, never raw pointers: use them with the intended arena snapshot. Managed elements are released on reset/drop; there is no manual free.\n\n")
    strings.add(mut out, "```vela\nimport buffers\nimport views\nimport arenas\nfn main() {\n    let pair: [Int; 2] = [1, 2]\n    print(pair[1])\n    let mut bytes = buffers.create(8)\n    buffers.write_u32_be(mut bytes, 1, 0x12345678u32)\n    let saved = buffers.view(bytes, 1, 5)\n    buffers.set(mut bytes, 1, 0u8)\n    assert(saved.get(0) == 0x12u8)\n    let mut arena: arenas.Arena[Str] = arenas.create(4)\n    let slot = arenas.alloc(mut arena, \"value\")\n    assert(arenas.get(arena, slot) == \"value\")\n    arenas.reset(mut arena)\n}\n```\n\n")
    strings.add(mut out, "## Calling C\n\n")
    strings.add(mut out, "`import c`: Int/UInt i32/u32; Short/UShort i16/u16; LongLong/ULongLong i64/u64; Char/SChar i8; UChar u8; Bool Bool; Double Float. Long/ULong follow C (32 bits on Windows/WASI, 64 on Linux/macOS); Size/SSize follow target pointers (32 on WASI, 64 elsewhere). c.Float uses binary32 at extern/callback boundaries and binary64 storage. c.Ptr/c.Fn are nominal non-owning target-sized pointers. WASI tasks are sequential; processes/sockets return unsupported errors.\n\n")
    strings.add(mut out, "Declare `extern fn name(args...) -> scalar uses unsafe`, optionally `= \"C_symbol\"`. Omit the result for C void; mut scalar parameters pass pointers. c.Float mut parameters use a binary32 temporary with copy-back. End variadic declarations with `...` after a fixed parameter; extra scalar arguments receive C default promotions. Put system libraries in vela.mod as `link z` or `link sqlite3`; `link ./libexample.a` resolves relative to the manifest. Dependencies contribute libraries too. Aggregates by value, capturing callbacks, generic externs and contracts need a wrapper.\n\n")
    strings.add(mut out, "An `unsafe { ... }` statement discharges only unsafe; other effects propagate. Check bounds, signatures, ownership, lifetimes and cleanup inside a safe wrapper. A deferred closure must declare or contain its own unsafe operations. c.data is a read-only borrow valid while its Str owner is alive and unchanged. c.cstr allocates a NUL-terminated copy (embedded NUL panics); free it. c.string/c.bytes return owned copies. c.load takes its scalar type from context; unaligned scalar loads/stores are supported. Offsets count bytes. Raw pointers carry no automatic owner or bounds. c.callback creates a C ABI thunk for a monomorphic top-level scalar function; C must obey its signature. Other C effects must also be declared honestly; Vela fakes do not intercept C.\n\n")
    strings.add(mut out, "```vela\nimport c\nextern fn strlen(text: c.Ptr) -> c.Size uses unsafe\nfn length(text: Str) -> Int {\n    unsafe {\n        let pointer = c.cstr(text)\n        let size = strlen(pointer)\n        c.free(pointer)\n        return int(size)\n    }\n}\nfn main() { print(length(\"hello\")) }\n```\n\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "## Effects, contracts, tests and concurrency\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "Effects fs/os/net/clock cover files/processes/networking/time and propagate through calls/function values. Main/tests allow these; unsafe needs declaration/block. Printing/os.write are effect-free. `fn map[T, U](xs: [T], f: fn(T) -> U) -> [U] uses f` means the caller inherits the argument function's effects. A pure function parameter rejects effectful arguments.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "Contracts follow signatures: `requires n >= 0`, `ensures result >= 0`. Clauses are Bool; unproved checks and observable calls/effects stay at runtime. In ensures, `result` is the return value and mut parameters hold final values. Failed contracts/assertions panic (101), outside Result. Compiler errors exit 1, bad CLI arguments 2, compiler defects 70.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "Top-level `test \"description\" { ... }` uses assert(condition). Assert Results with `assert(r == Ok(2))`. Fakes: `with files = [\"data.txt\": \"contents\"] { ... }`, `with args = [\"program\", \"arg\"]`, `with env = [\"KEY\": \"value\"]`, `with stdin = \"input\\n\"`. Capture with `let mut out = strings.builder()` then `with stdout = mut out`. Other fakes: `with clock = [wall_ns, mono_ns]`, `with net = [net.reply(host, port, expected_write, response)]`, `with processes = [processes.reply(args, input, status, stdout, stderr)]`. Rows consumed once; unmatched/unconsumed rows panic. Socket copies alias; close rejects new calls; final release closes; active calls finish/time out. unicode validates UTF-8/scalars; io returns next state; http: plaintext HTTP/1.1 GET. Socket waits time out; DNS uses host resolution. Exits restore fakes; test runs library tests.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "`tasks.map(xs, f)` returns results in input order; `tasks.each(xs, f)` returns nothing. Both join and propagate f's effects. Captures copy. `tasks.workers()` reports the count; `VELA_THREADS` sets it. No shared mutable captures or async syntax.\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "## Complete examples\n")
    strings.add(mut out, "\n")
    strings.add(mut out, "```vela\nfn twice(x: Int) -> Int { return x * 2 }\nfn main() {\n    for x in [1, 2, 3] { print(twice(x)) }\n}\ntest \"copies\" {\n    let a = [1, 2]\n    let mut b = a\n    b[0] = 9\n    assert(a[0] == 1 && b[0] == 9)\n}\n```\n\n```vela\nimport files\nimport text\nfn read_count(path: Str) -> Result[Int, Str] uses fs {\n    return Ok(len(text.lines(files.read(path)?)))\n}\nfn main() {\n    match read_count(\"data.txt\") { Ok(n) => print(n), Err(e) => print(e) }\n}\ntest \"fake filesystem\" {\n    with files = [\"data.txt\": \"one\\ntwo\\n\"] {\n        match read_count(\"data.txt\") { Ok(n) => assert(n == 2), Err(_) => assert(false) }\n    }\n    with files = [:] {\n        match read_count(\"missing\") { Ok(_) => assert(false), Err(e) => assert(len(e) > 0) }\n    }\n}\n```\n")
    strings.add(mut out, "\n## Keywords (from the lexer)\n\n")
    for k in lexer.keywords() {
        strings.add(mut out, lexer.kind_name(k) + " ")
    }
    strings.add(mut out, "\n\n## Built-in functions (from the compiler index)\n\n```text\n")
    for name in checker.prelude() {
        builtin(mut out, "", name)
    }
    strings.add(mut out, "```\n")
    if !all {
        strings.add(mut out, "\nModule signatures: `vela guide --all` lists every built-in and std module's functions; " +
            "`vela query summary FILE` gives a module's API.\n")
        return strings.build(out)
    }
    for module in modules.builtin_modules() {
        strings.add(mut out, "\n### import " + module + "\n\n```text\n")
        for name in modules.builtin_functions(module) {
            builtin(mut out, module, name)
        }
        strings.add(mut out, "```\n")
    }
    strings.add(mut out, "\nEach `import NAME` below is std/NAME.vl.\n")
    for module in modules.std_modules() {
        strings.add(mut out, "\n## import " + module + "\n\n```text\n")
        let path = modules.join(modules.join(root, "std"), module + ".vl")
        match files.read(path) {
            Ok(source) => {
                let tokens = lexer.tokenize(source)
                let parsed = parser.parse(tokens.tokens, 0)
                if len(tokens.errors) > 0 || len(parsed.errors) > 0 {
                    os.eprint("vela: error: cannot generate guide from " + path + " [E6007]")
                    os.exit(1)
                }
                let mut public: [ast.FnDecl] = []
                for f in parsed.program.fns {
                    if f.public {
                        push(mut public, f)
                    }
                }
                signatures(mut out, public)
            }
            Err(e) => {
                os.eprint("vela: error: " + e + " [E6001]")
                os.exit(1)
            }
        }
        strings.add(mut out, "```\n")
    }
    return strings.build(out)
}

fn builtin(out: mut strings.Builder, module: Str, name: Str) {
    let mut full = name
    if module != "" {
        full = module + "." + name
    }
    let info = index.builtin_info(full)
    if len(info) == 2 {
        strings.add(mut out, info[0] + "\n")
    }
}

// The signatures of a module's public functions, with their contracts. A
// family of four or more without contracts, the same but for integer widths
// and `_le`/`_be` (buffers.read_u8_le ... read_i64_be), shows one member
// and the pattern of the rest.
fn signatures(out: mut strings.Builder, fns: [ast.FnDecl]) {
    let mut keys: [Str] = []
    let mut sigs: [Str] = []
    let mut counts: Map[Str, Int] = [:]
    for f in fns {
        let sig = index.signature(f)
        let mut key = ""
        if len(f.requires) == 0 && len(f.ensures) == 0 {
            key = pattern(sig)
        }
        push(mut sigs, sig)
        push(mut keys, key)
        if key != "" {
            match maps.get(counts, key) {
                Some(n) => counts[key] = n + 1
                None => counts[key] = 1
            }
        }
    }
    let mut done: Map[Str, Bool] = [:]
    for i in 0..len(fns) {
        let key = keys[i]
        if key != "" && counts[key] >= 4 && key != sigs[i] {
            if maps.has(done, key) {
                continue
            }
            done[key] = true
            let mut shown = sigs[i]
            let mut widths: [Str] = []
            let mut orders: [Str] = []
            for j in i..len(fns) {
                if keys[j] == key {
                    if contains(sigs[j], "u32") && !contains(shown, "u32") {
                        shown = sigs[j]
                    }
                    for w in width_words(fns[j].name) {
                        add_new(mut widths, w)
                    }
                    let n = fns[j].name
                    if len(n) > 3 && (n[len(n) - 3..len(n)] == "_le" || n[len(n) - 3..len(n)] == "_be") {
                        add_new(mut orders, n[len(n) - 2..len(n)])
                    }
                }
            }
            strings.add(mut out, shown + "\n")
            let mut note = "  likewise " + key[7..len(key)] + ", W: " + spaced(widths)
            if len(orders) > 0 {
                note = note + "; E: " + spaced(orders)
            }
            strings.add(mut out, note + "\n")
            continue
        }
        strings.add(mut out, sigs[i] + "\n")
        for e in fns[i].requires {
            strings.add(mut out, "  requires " + ast.expr_text(e) + "\n")
        }
        for e in fns[i].ensures {
            strings.add(mut out, "  ensures " + ast.expr_text(e) + "\n")
        }
    }
}

// A signature with each integer width word (`u8` ... `i64`, alone or as a
// part of a name between underscores) made W, and a `_le` or `_be` ending a
// name made `_E`.
fn pattern(sig: Str) -> Str {
    let mut b = strings.builder()
    let mut i = 0
    for i < len(sig) {
        if !word_byte(sig[i]) {
            strings.add_byte(mut b, sig[i])
            i = i + 1
            continue
        }
        let start = i
        for i < len(sig) && word_byte(sig[i]) {
            i = i + 1
        }
        let parts = split_underscores(sig[start..i])
        for k in 0..len(parts) {
            if k > 0 {
                strings.add_byte(mut b, '_')
            }
            if is_width(parts[k]) {
                strings.add_byte(mut b, 'W')
            } else if k == len(parts) - 1 && k > 0 && (parts[k] == "le" || parts[k] == "be") {
                strings.add_byte(mut b, 'E')
            } else {
                strings.add(mut b, parts[k])
            }
        }
    }
    return strings.build(b)
}

fn word_byte(c: Byte) -> Bool {
    return c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '_'
}

fn split_underscores(s: Str) -> [Str] {
    let mut out: [Str] = []
    let mut start = 0
    for i in 0..len(s) + 1 {
        if i == len(s) || s[i] == '_' {
            push(mut out, s[start..i])
            start = i + 1
        }
    }
    return out
}

fn is_width(w: Str) -> Bool {
    return w == "u8" || w == "i8" || w == "u16" || w == "i16" || w == "u32" || w == "i32" || w == "u64" || w == "i64"
}

fn width_words(name: Str) -> [Str] {
    let mut out: [Str] = []
    for part in split_underscores(name) {
        if is_width(part) {
            push(mut out, part)
        }
    }
    return out
}

fn add_new(xs: mut [Str], x: Str) {
    for y in xs {
        if y == x {
            return
        }
    }
    push(mut xs, x)
}

fn spaced(xs: [Str]) -> Str {
    let mut out = ""
    for k in 0..len(xs) {
        if k > 0 {
            out = out + " "
        }
        out = out + xs[k]
    }
    return out
}

fn contains(s: Str, part: Str) -> Bool {
    if len(part) > len(s) {
        return false
    }
    for i in 0..len(s) - len(part) + 1 {
        if s[i..i + len(part)] == part {
            return true
        }
    }
    return false
}
