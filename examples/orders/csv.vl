// Just enough CSV for orders.csv: fields split at commas, no quoting.
import lists
import text

// The lines of `text`, without their line endings; blank lines are left out.
pub fn lines(s: Str) -> [Str] {
    return lists.filter(text.lines(s), fn(line) => text.trim(line) != "")
}

pub fn fields(line: Str) -> [Str] {
    return lists.map(text.split(line, ","), text.trim)
}

// A whole number of decimal digits, with no sign.
pub fn number(s: Str) -> Option[Int] {
    if text.starts_with(s, "-") {
        return None
    }
    return text.parse_int(s)
}

test "lines drop endings and blanks" {
    let ls = lines("a\r\n\nb\n")
    assert(len(ls) == 2 && ls[0] == "a" && ls[1] == "b")
}

test "fields are trimmed" {
    let f = fields("1, ada ,,x")
    assert(len(f) == 4 && f[1] == "ada" && f[2] == "")
}

test "numbers" {
    match number("1250") {
        Some(n) => assert(n == 1250)
        None => assert(false)
    }
    for bad in ["12a", "-5", ""] {
        match number(bad) {
            Some(_) => assert(false)
            None => {}
        }
    }
}
