// The report: totals per customer, ranked, as aligned text.
// stage 1 only
import lists
import maps
import orders
import strings
import text

// A thing with the number it is ranked by.
pub type Ranked[T] = struct {
    item: T
    score: Int
}

// The `n` items with the highest scores, highest first; equal scores keep
// their order.
pub fn top[T](items: [T], score: fn(T) -> Int, n: Int) -> [Ranked[T]]
    requires n >= 0
    ensures len(result) <= n {
    let best = lists.take(lists.sort_by(items, fn(x) => -score(x)), n)
    return lists.map(best, fn(x) => Ranked { item: x, score: score(x) })
}

// What each customer spent, by customer, in the order they first appear.
pub fn spending(all: [orders.Order]) -> Map[Str, Int] {
    let mut out: Map[Str, Int] = [:]
    for o in all {
        match maps.get(out, o.customer) {
            Some(t) => out[o.customer] = t + orders.total(o)
            None => out[o.customer] = orders.total(o)
        }
    }
    return out
}

// 1234 cents as "12.34".
pub fn money(cents: Int) -> Str
    requires cents >= 0 {
    let mut rest = strings.from_int(cents % 100)
    if len(rest) == 1 {
        rest = "0" + rest
    }
    return strings.from_int(cents / 100) + "." + rest
}

pub fn lines(all: [orders.Order], n: Int) -> [Str] {
    let revenue = lists.sum(lists.map(all, orders.total))
    let mut out = ["orders:  " + strings.from_int(len(all)), "revenue: " + money(revenue)]
    match lists.max(lists.map(all, orders.total)) {
        Some(_) => {
            let biggest = lists.reverse(lists.sort_by(all, orders.total))[0]
            push(mut out, "largest: #" + strings.from_int(biggest.id) + " " + biggest.customer + " " + money(orders.total(biggest)))
        }
        None => {}
    }
    push(mut out, "top customers:")
    let spent = spending(all)
    for r in top(maps.keys(spent), fn(name) => spent[name], n) {
        push(mut out, "  " + text.pad_right(r.item, 8) + text.pad_left(money(r.score), 9))
    }
    return out
}

test "money has two decimals" {
    assert(money(1234) == "12.34")
    assert(money(5) == "0.05")
    assert(money(100) == "1.00")
}

test "top keeps the highest, in order" {
    let scores: Map[Str, Int] = ["a": 5, "b": 9, "c": 5, "d": 1]
    let ranked = top(["a", "b", "c", "d"], fn(k) => scores[k], 3)
    assert(len(ranked) == 3)
    assert(ranked[0].item == "b" && ranked[1].item == "a" && ranked[2].item == "c")
    assert(ranked[0].score == 9)
}
