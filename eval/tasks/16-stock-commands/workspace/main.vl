// The stock keeper:
//
//     vela run main.vl FILE list
//     vela run main.vl FILE add NAME N
import maps
import os
import store
import text

fn fail(message: Str, code: Int) uses os {
    os.eprint(message)
    os.exit(code)
}

fn count(s: Str) -> Int uses os {
    match text.parse_int(s) {
        Some(n) => {
            if n > 0 {
                return n
            }
        }
        None => {}
    }
    fail("not a positive number: " + s, 2)
    return 0
}

fn main() {
    let args = os.args()
    if len(args) < 3 {
        fail("usage: main.vl FILE list|add NAME N", 2)
    }
    let path = args[1]
    let mut m: Map[Str, Int] = [:]
    match store.read(path) {
        Ok(s) => m = s
        Err(e) => fail(e, 1)
    }
    let command = args[2]
    if command == "list" {
        os.write(store.render(m))
    } else if command == "add" && len(args) == 5 {
        let n = count(args[4])
        match maps.get(m, args[3]) {
            Some(have) => m[args[3]] = have + n
            None => m[args[3]] = n
        }
        match store.write(path, m) {
            Ok(_) => {}
            Err(e) => fail(e, 1)
        }
    } else {
        fail("usage: main.vl FILE list|add NAME N", 2)
    }
}
