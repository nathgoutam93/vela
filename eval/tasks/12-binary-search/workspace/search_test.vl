import search

fn at(o: Option[Int], i: Int) -> Bool {
    return match o {
        Some(v) => v == i
        None => i < 0
    }
}

test "find" {
    assert(at(search.find([1, 3, 5, 7], 5), 2))
    assert(at(search.find([1, 3, 5, 7], 4), -1))
    assert(at(search.find([], 4), -1))
}

test "count_less" {
    assert(search.count_less([1, 3, 5, 7], 5) == 2)
    assert(search.count_less([1, 3, 5, 7], 100) == 4)
}
