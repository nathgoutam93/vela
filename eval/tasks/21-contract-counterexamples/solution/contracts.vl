pub fn next(x: u8) -> u8
    requires x < 255u8
    ensures result > x {
    return x + 1u8
}

pub fn magnitude(x: i32) -> i32
    requires x > -2147483648i32
    ensures result >= 0i32 {
    if x < 0i32 {
        return -x
    }
    return x
}

pub fn clamp(x: Int, limit: Int) -> Int
    requires limit >= 0 && limit <= 1000
    ensures result >= 0 && result <= limit {
    if x < 0 {
        return 0
    }
    if x > limit {
        return limit
    }
    return x
}
