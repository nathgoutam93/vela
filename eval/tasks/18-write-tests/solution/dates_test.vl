import dates

fn days(o: Option[Int], n: Int) -> Bool {
    return match o {
        Some(v) => v == n
        None => n < 0
    }
}

test "leap years" {
    assert(dates.is_leap(2024))
    assert(!dates.is_leap(2023))
    assert(!dates.is_leap(1900))
    assert(dates.is_leap(2000))
}

test "days in a month" {
    assert(days(dates.days_in_month(2023, 1), 31))
    assert(days(dates.days_in_month(2023, 2), 28))
    assert(days(dates.days_in_month(2024, 2), 29))
    assert(days(dates.days_in_month(2023, 4), 30))
    assert(days(dates.days_in_month(2023, 12), 31))
    assert(days(dates.days_in_month(2023, 0), -1))
    assert(days(dates.days_in_month(2023, 13), -1))
}

test "day of the year" {
    assert(days(dates.day_of_year(2023, 1, 1), 1))
    assert(days(dates.day_of_year(2023, 3, 1), 60))
    assert(days(dates.day_of_year(2024, 3, 1), 61))
    assert(days(dates.day_of_year(2023, 12, 31), 365))
    assert(days(dates.day_of_year(2023, 2, 29), -1))
    assert(days(dates.day_of_year(2023, 1, 0), -1))
    assert(days(dates.day_of_year(2023, 13, 1), -1))
}
