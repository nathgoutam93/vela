// spectral-norm: the largest eigenvalue of an infinite matrix, by the power
// method (the Benchmarks Game's spectral-norm). Floats, arrays and calls.
//
//     vela run bench/spectralnorm/main.vl N
import math
import os
import strings

fn eval_a(i: Int, j: Int) -> Float {
    return 1.0 / float((i + j) * (i + j + 1) / 2 + i + 1)
}

fn times(v: [Float], out: mut [Float]) {
    let n = len(v)
    for i in 0..n {
        let mut sum = 0.0
        for j in 0..n {
            sum = sum + eval_a(i, j) * v[j]
        }
        out[i] = sum
    }
}

fn times_transposed(v: [Float], out: mut [Float]) {
    let n = len(v)
    for i in 0..n {
        let mut sum = 0.0
        for j in 0..n {
            sum = sum + eval_a(j, i) * v[j]
        }
        out[i] = sum
    }
}

fn times_ata(v: [Float], out: mut [Float], tmp: mut [Float]) {
    times(v, mut tmp)
    times_transposed(tmp, mut out)
}

fn fixed9(x: Float) -> Str {
    let mut a = x
    let mut sign = ""
    if x < 0.0 {
        a = 0.0 - x
        sign = "-"
    }
    let scaled = int(a * 1000000000.0 + 0.5)
    let frac = strings.from_int(scaled % 1000000000)
    let mut b = strings.builder()
    strings.add(mut b, sign + strings.from_int(scaled / 1000000000) + ".")
    for _ in len(frac)..9 {
        strings.add(mut b, "0")
    }
    strings.add(mut b, frac)
    return strings.build(b)
}

fn arg(i: Int, default: Int) -> Int uses os {
    let a = os.args()
    if len(a) <= i {
        return default
    }
    match strings.parse_float(a[i]) {
        Some(x) => return int(x)
        None => return default
    }
}

fn filled(n: Int, x: Float) -> [Float] {
    let mut out: [Float] = []
    for _ in 0..n {
        push(mut out, x)
    }
    return out
}

fn main() {
    let n = arg(1, 100)
    let mut u = filled(n, 1.0)
    let mut v = filled(n, 0.0)
    let mut tmp = filled(n, 0.0)
    for _ in 0..10 {
        times_ata(u, mut v, mut tmp)
        times_ata(v, mut u, mut tmp)
    }
    let mut vbv = 0.0
    let mut vv = 0.0
    for i in 0..n {
        vbv = vbv + u[i] * v[i]
        vv = vv + v[i] * v[i]
    }
    print(fixed9(math.sqrt(vbv / vv)))
}
