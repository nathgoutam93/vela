// binary-trees: build and walk many binary trees (the Benchmarks Game's
// binary-trees, one thread). Allocation, a recursive enum, reference counts.
//
//     vela run bench/binarytrees/main.vl N
import os
import strings

type Tree = enum {
    Leaf
    Node(Tree, Tree)
}

fn make(depth: Int) -> Tree {
    if depth == 0 {
        return Tree.Node(Tree.Leaf, Tree.Leaf)
    }
    return Tree.Node(make(depth - 1), make(depth - 1))
}

// How many nodes.
fn check(t: Tree) -> Int {
    return match t {
        Tree.Leaf => 0
        Tree.Node(l, r) => 1 + check(l) + check(r)
    }
}

fn pow2(n: Int) -> Int {
    let mut p = 1
    for _ in 0..n {
        p = p * 2
    }
    return p
}

fn arg(i: Int, default: Int) -> Int uses os {
    let a = os.args()
    if len(a) <= i {
        return default
    }
    match strings.parse_float(a[i]) {
        Some(x) => return int(x)
        None => return default
    }
}

fn main() {
    let n = arg(1, 10)
    let min_depth = 4
    let mut max_depth = n
    if min_depth + 2 > n {
        max_depth = min_depth + 2
    }
    let stretch = max_depth + 1
    print("stretch tree of depth " + strings.from_int(stretch) + " check: " + strings.from_int(check(make(stretch))))
    let long_lived = make(max_depth)
    let mut depth = min_depth
    for depth <= max_depth {
        let iterations = pow2(max_depth - depth + min_depth)
        let mut sum = 0
        for _ in 0..iterations {
            sum = sum + check(make(depth))
        }
        print(strings.from_int(iterations) + " trees of depth " + strings.from_int(depth) + " check: " + strings.from_int(sum))
        depth = depth + 2
    }
    print("long lived tree of depth " + strings.from_int(max_depth) + " check: " + strings.from_int(check(long_lived)))
}
