// mandelbrot: how many points of an N×N grid stay in the Mandelbrot set
// for 50 steps. A tight Float loop, one thread (examples/mandelbrot draws
// the picture on every core).
//
//     vela run bench/mandelbrot/main.vl N
// stage 1 only
import os
import strings

fn arg(i: Int, default: Int) -> Int uses os {
    let a = os.args()
    if len(a) <= i {
        return default
    }
    match strings.parse_float(a[i]) {
        Some(x) => return int(x)
        None => return default
    }
}

fn main() {
    let n = arg(1, 200)
    let size = float(n)
    let mut count = 0
    for y in 0..n {
        let ci = 2.0 * float(y) / size - 1.0
        for x in 0..n {
            let cr = 2.0 * float(x) / size - 1.5
            let mut zr = 0.0
            let mut zi = 0.0
            let mut inside = true
            let mut i = 0
            for i < 50 {
                let tr = zr * zr - zi * zi + cr
                let ti = 2.0 * zr * zi + ci
                zr = tr
                zi = ti
                if zr * zr + zi * zi > 4.0 {
                    inside = false
                    break
                }
                i = i + 1
            }
            if inside {
                count = count + 1
            }
        }
    }
    print(strings.from_int(count))
}
