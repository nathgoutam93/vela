// The text a named character reference such as "amp" stands for, or "".
pub fn entity(name: Str) -> Str {
    if len(name) == 0 {
        return ""
    }
    return match name[0] {
        'A' => entity_A(name)
        'B' => entity_B(name)
        'C' => entity_C(name)
        'D' => entity_D(name)
        'E' => entity_E(name)
        'F' => entity_F(name)
        'G' => entity_G(name)
        'H' => entity_H(name)
        'I' => entity_I(name)
        'J' => entity_J(name)
        'K' => entity_K(name)
        'L' => entity_L(name)
        'M' => entity_M(name)
        'N' => entity_N(name)
        'O' => entity_O(name)
        'P' => entity_P(name)
        'Q' => entity_Q(name)
        'R' => entity_R(name)
        'S' => entity_S(name)
        'T' => entity_T(name)
        'U' => entity_U(name)
        'V' => entity_V(name)
        'W' => entity_W(name)
        'X' => entity_X(name)
        'Y' => entity_Y(name)
        'Z' => entity_Z(name)
        'a' => entity_a(name)
        'b' => entity_b(name)
        'c' => entity_c(name)
        'd' => entity_d(name)
        'e' => entity_e(name)
        'f' => entity_f(name)
        'g' => entity_g(name)
        'h' => entity_h(name)
        'i' => entity_i(name)
        'j' => entity_j(name)
        'k' => entity_k(name)
        'l' => entity_l(name)
        'm' => entity_m(name)
        'n' => entity_n(name)
        'o' => entity_o(name)
        'p' => entity_p(name)
        'q' => entity_q(name)
        'r' => entity_r(name)
        's' => entity_s(name)
        't' => entity_t(name)
        'u' => entity_u(name)
        'v' => entity_v(name)
        'w' => entity_w(name)
        'x' => entity_x(name)
        'y' => entity_y(name)
        'z' => entity_z(name)
        _ => ""
    }
}

fn entity_A(name: Str) -> Str {
    return match len(name) {
        3 => match name {
            "AMP" => "&"
            "Acy" => "А"
            "Afr" => "𝔄"
            "And" => "⩓"
            _ => ""
        }
        4 => match name {
            "Aopf" => "𝔸"
            "Ascr" => "𝒜"
            "Auml" => "Ä"
            _ => ""
        }
        5 => match name {
            "AElig" => "Æ"
            "Acirc" => "Â"
            "Alpha" => "Α"
            "Amacr" => "Ā"
            "Aogon" => "Ą"
            "Aring" => "Å"
            _ => ""
        }
        6 => match name {
            "Aacute" => "Á"
            "Abreve" => "Ă"
            "Agrave" => "À"
            "Assign" => "≔"
            "Atilde" => "Ã"
            _ => ""
        }
        13 => match name {
            "ApplyFunction" => "⁡"
            _ => ""
        }
        _ => ""
    }
}

