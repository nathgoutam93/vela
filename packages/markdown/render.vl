// HTML output, as commonmark.js writes it: block tags on lines of their
// own, text escaped, raw HTML as it was. A tight list's paragraphs have no
// <p>. Inside an image, tags are left out so the alt text is plain.
import nodes
import strings

type Out = struct {
    b: strings.Builder
    last: Byte
    plain: Int  // images entered: tags are not written
}

pub fn html(d: nodes.Doc) -> Str {
    let mut o = Out { b: strings.builder(), last: '\n', plain: 0 }
    // Walk the tree without recursion: each container is entered, then its
    // children, then left.
    let mut n = 0
    let mut entering = true
    for {
        let leaf = node(mut o, d, n, entering)
        if entering && !leaf && d.nodes[n].first >= 0 {
            n = d.nodes[n].first
            continue
        }
        if entering && !leaf {
            let _ = node(mut o, d, n, false)
        }
        if n == 0 {
            break
        }
        if d.nodes[n].next >= 0 {
            n = d.nodes[n].next
            entering = true
        } else {
            n = d.nodes[n].parent
            entering = false
            let _ = node(mut o, d, n, false)
            for n != 0 && d.nodes[n].next < 0 {
                n = d.nodes[n].parent
                let _ = node(mut o, d, n, false)
            }
            if n == 0 {
                break
            }
            n = d.nodes[n].next
            entering = true
        }
    }
    return strings.build(o.b)
}

fn lit(o: mut Out, s: Str) {
    if len(s) > 0 {
        strings.add(mut o.b, s)
        o.last = s[len(s) - 1]
    }
}

fn cr(o: mut Out) {
    if o.last != '\n' {
        lit(mut o, "\n")
    }
}

fn tag(o: mut Out, s: Str) {
    if o.plain == 0 {
        lit(mut o, s)
    }
}

pub fn escape(s: Str) -> Str {
    for c in s {
        if c == '&' || c == '<' || c == '>' || c == '"' {
            let mut b = strings.builder()
            escape_to(mut b, s)
            return strings.build(b)
        }
    }
    return s
}

// Text written escaped, without making it a Str first. Its last byte stands
// for the output's: an escaped one ends in ';', and only '\n' matters.
fn escaped(o: mut Out, s: Str) {
    if len(s) > 0 {
        escape_to(mut o.b, s)
        o.last = s[len(s) - 1]
    }
}

// Adds `s` to `b` with &, <, > and " escaped, in runs between them.
fn escape_to(b: mut strings.Builder, s: Str) {
    let mut start = 0
    for i in 0..len(s) {
        let c = s[i]
        if c == '&' || c == '<' || c == '>' || c == '"' {
            strings.add(mut b, s[start..i])
            if c == '&' {
                strings.add(mut b, "&amp;")
            } else if c == '<' {
                strings.add(mut b, "&lt;")
            } else if c == '>' {
                strings.add(mut b, "&gt;")
            } else {
                strings.add(mut b, "&quot;")
            }
            start = i + 1
        }
    }
    strings.add(mut b, s[start..len(s)])
}

fn heading_tag(level: Int, entering: Bool) -> Str {
    if entering {
        return match level {
            1 => "<h1>"
            2 => "<h2>"
            3 => "<h3>"
            4 => "<h4>"
            5 => "<h5>"
            _ => "<h6>"
        }
    }
    return match level {
        1 => "</h1>"
        2 => "</h2>"
        3 => "</h3>"
        4 => "</h4>"
        5 => "</h5>"
        _ => "</h6>"
    }
}

// Writes the node, entering or leaving it; true for a leaf, which is only
// entered.
fn node(o: mut Out, d: nodes.Doc, n: Int, entering: Bool) -> Bool {
    let x = d.nodes[n]
    let k = x.kind
    if k == nodes.Kind.Text {
        escaped(mut o, x.literal)
        return true
    }
    if k == nodes.Kind.Softbreak {
        lit(mut o, "\n")
        return true
    }
    if k == nodes.Kind.Linebreak {
        tag(mut o, "<br />")
        cr(mut o)
        return true
    }
    if k == nodes.Kind.Code {
        tag(mut o, "<code>")
        escaped(mut o, x.literal)
        tag(mut o, "</code>")
        return true
    }
    if k == nodes.Kind.HtmlInline {
        lit(mut o, x.literal)
        return true
    }
    if k == nodes.Kind.HtmlBlock {
        cr(mut o)
        lit(mut o, x.literal)
        cr(mut o)
        return true
    }
    if k == nodes.Kind.ThematicBreak {
        cr(mut o)
        tag(mut o, "<hr />")
        cr(mut o)
        return true
    }
    if k == nodes.Kind.CodeBlock {
        cr(mut o)
        let mut word = d.data[x.data].info
        for i in 0..len(word) {
            if word[i] == ' ' || word[i] == '\t' || word[i] == '\n' {
                word = word[0..i]
                break
            }
        }
        if word == "" {
            tag(mut o, "<pre><code>")
        } else {
            tag(mut o, "<pre><code class=\"language-" + escape(word) + "\">")
        }
        escaped(mut o, x.literal)
        tag(mut o, "</code></pre>")
        cr(mut o)
        return true
    }
    if k == nodes.Kind.Emph {
        if entering { tag(mut o, "<em>") } else { tag(mut o, "</em>") }
        return false
    }
    if k == nodes.Kind.Strong {
        if entering { tag(mut o, "<strong>") } else { tag(mut o, "</strong>") }
        return false
    }
    if k == nodes.Kind.Link {
        if entering {
            let y = d.links[x.data]
            let mut open = "<a href=\"" + escape(y.destination) + "\""
            if y.title != "" {
                open = open + " title=\"" + escape(y.title) + "\""
            }
            tag(mut o, open + ">")
        } else {
            tag(mut o, "</a>")
        }
        return false
    }
    if k == nodes.Kind.Image {
        if entering {
            if o.plain == 0 {
                lit(mut o, "<img src=\"" + escape(d.links[x.data].destination) + "\" alt=\"")
            }
            o.plain = o.plain + 1
        } else {
            o.plain = o.plain - 1
            if o.plain == 0 {
                let title = d.links[x.data].title
                if title != "" {
                    lit(mut o, "\" title=\"" + escape(title))
                }
                lit(mut o, "\" />")
            }
        }
        return false
    }
    if k == nodes.Kind.Paragraph {
        let parent = x.parent
        if parent >= 0 {
            let grandparent = d.nodes[parent].parent
            if grandparent >= 0 && d.nodes[grandparent].kind == nodes.Kind.List && d.data[d.nodes[grandparent].data].list.tight {
                return false
            }
        }
        if entering {
            cr(mut o)
            tag(mut o, "<p>")
        } else {
            tag(mut o, "</p>")
            cr(mut o)
        }
        return false
    }
    if k == nodes.Kind.Heading {
        if entering {
            cr(mut o)
            tag(mut o, heading_tag(d.data[x.data].level, true))
        } else {
            tag(mut o, heading_tag(d.data[x.data].level, false))
            cr(mut o)
        }
        return false
    }
    if k == nodes.Kind.BlockQuote {
        if entering {
            cr(mut o)
            tag(mut o, "<blockquote>")
            cr(mut o)
        } else {
            cr(mut o)
            tag(mut o, "</blockquote>")
            cr(mut o)
        }
        return false
    }
    if k == nodes.Kind.List {
        let list = d.data[x.data].list
        if entering {
            cr(mut o)
            if !list.ordered {
                tag(mut o, "<ul>")
            } else if list.start != 1 {
                tag(mut o, "<ol start=\"" + strings.from_int(list.start) + "\">")
            } else {
                tag(mut o, "<ol>")
            }
            cr(mut o)
        } else {
            cr(mut o)
            if list.ordered {
                tag(mut o, "</ol>")
            } else {
                tag(mut o, "</ul>")
            }
            cr(mut o)
        }
        return false
    }
    if k == nodes.Kind.Item {
        if entering {
            tag(mut o, "<li>")
        } else {
            tag(mut o, "</li>")
            cr(mut o)
        }
        return false
    }
    return false  // the document
}
