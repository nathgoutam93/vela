// Regular expressions that run in time linear in the text, whatever the
// pattern: `compile` turns a pattern into a program, and a Pike VM runs it
// over the text's code points, every possible match at once, so no pattern
// can make a search take exponential time. On texts of 256 bytes and more,
// a lazy DFA built from the program during the search finds each match's
// bounds a code point at a time, and the VM runs only over the match, for
// its groups; a pattern needing more than a few thousand states runs on the
// VM alone. The syntax is RE2's and Rust's,
// without backreferences or lookaround, which no linear-time engine can
// offer. Matches are leftmost-first, as Perl, Python and Rust report them.
//
//     let re = regex.must(r"(?P<key>\w+)=(?P<value>\d+)")
//     match regex.captures(re, "x=12") { Some(c) => ..., None => ... }
//
// Supported: literals; `.`; classes `[a-z]`, `[^...]`, `[[:alpha:]]`;
// `\d \w \s` and their negations; Unicode properties `\pL`, `\p{Lu}`...
// (general categories and their groups by short or long name, `gc=...`,
// Any, ASCII, Assigned, Alphabetic, White_Space) and `\P`, `\p{^...}`;
// `\b \B ^ $ \A \z`, `\< \>` and `\b{start}`, `\b{end}`, `\b{start-half}`,
// `\b{end-half}`; groups `(...)`, `(?:...)`, `(?P<name>...)`,
// `(?<name>...)`; `|`; `* + ? {n} {n,} {n,m}` and their lazy forms; flags
// `(?imsuUxR)` and `(?i:...)`; escapes `\n \t \r \f \v \a \e \0`, `\xHH`,
// `\x{H...}`. As in Rust, Unicode mode (`u`) is on: `\d` is Nd, `\w` a
// word character as UTS #18 defines it, `\s` White_Space, `\b` between
// those, and `(?i)` Unicode's simple case folding; `(?-u)` makes them
// ASCII's. `.` and classes match any code point. POSIX classes are ASCII.
import lists
import maps
import strings
import unicode

pub type Regex = struct {
    pattern: Str
    // The program, an instruction per index: its op, its operands, and a
    // class's ranges.
    ops: [Int]
    xs: [Int]
    ys: [Int]
    sets: [[Int]]
    // The pattern reversed, as a program without captures, which finds where
    // a match starts from where it ends.
    rops: [Int]
    rxs: [Int]
    rys: [Int]
    rsets: [[Int]]
    looks: Bool  // the pattern has assertions
    uword: Bool  // and of them, Unicode word boundaries
    cuts: [Int]  // where code points past ASCII change the pattern's literals and classes they are in
    groups: Int  // capture groups, the whole match included
    names: [Str]  // each group's name, "" for none
    first: [Bool]  // the bytes a match can start with; empty when any can
    prefix: Str  // bytes every match starts with
    anchored: Bool  // every match starts at the start of the text
}

// A match: where it starts and ends in the text, as byte offsets.
pub type Match = struct {
    start: Int
    end: Int
}

// ---- Searching ----

// The pattern compiled, or a message saying what is wrong with it.
pub fn compile(pattern: Str) -> Result[Regex, Str] {
    let mut p = Parser { text: pattern, pos: 0, error: "", groups: 1, names: [""], flags: Flags { i: false, unicode: true, m: false, s: false, u: false, x: false, r: false }, depth: 0 }
    let tree = alternation(mut p)
    if p.error == "" && p.pos < len(pattern) {
        fail(mut p, "unmatched ')'")
    }
    if p.error != "" {
        return Err(p.error)
    }
    let mut c = Compiler { program: [], error: "", reverse: false }
    emit(mut c, Inst { op: SAVE(), a: 0, b: 0, ranges: [] })
    gen(mut c, tree)
    emit(mut c, Inst { op: SAVE(), a: 1, b: 0, ranges: [] })
    emit(mut c, Inst { op: MATCH(), a: 0, b: 0, ranges: [] })
    if c.error != "" {
        return Err(c.error)
    }
    let mut r = Compiler { program: [], error: "", reverse: true }
    gen(mut r, tree)
    emit(mut r, Inst { op: MATCH(), a: 0, b: 0, ranges: [] })
    if r.error != "" {
        return Err(r.error)
    }
    let mut re = Regex { pattern: pattern, ops: [], xs: [], ys: [], sets: [], rops: [], rxs: [], rys: [], rsets: [], looks: false, uword: false, cuts: [], groups: p.groups, names: p.names,
        first: first_bytes(c.program), prefix: literal_prefix(c.program), anchored: starts_anchored(c.program) }
    for i in c.program {
        push(mut re.ops, i.op)
        push(mut re.xs, i.a)
        push(mut re.ys, i.b)
        push(mut re.sets, i.ranges)
        if i.op == LOOK() {
            re.looks = true
            re.uword = re.uword || i.a >= 12
        }
    }
    re.cuts = cuts_of(c.program, re.uword)
    for i in r.program {
        push(mut re.rops, i.op)
        push(mut re.rxs, i.a)
        push(mut re.rys, i.b)
        push(mut re.rsets, i.ranges)
    }
    return Ok(re)
}

// The pattern compiled; a panic if it is not a valid one, for patterns
// written in the program.
pub fn must(pattern: Str) -> Regex {
    match compile(pattern) {
        Ok(re) => return re
        Err(e) => {
            assert(e == "")
            return Regex { pattern: "", ops: [], xs: [], ys: [], sets: [], rops: [], rxs: [], rys: [], rsets: [], looks: false, uword: false, cuts: [], groups: 0, names: [], first: [], prefix: "",
                anchored: false }
        }
    }
}

pub fn is_match(re: Regex, text: Str) -> Bool {
    let mut c = cache(re)
    return len(find_one(re, mut c, text, 0, len(text), false, 2)) > 0
}

// The leftmost match.
pub fn find(re: Regex, text: Str) -> Option[Match] {
    return find_at(re, text, 0)
}

// The leftmost match starting at `start` or after it.
pub fn find_at(re: Regex, text: Str, start: Int) -> Option[Match] {
    let mut c = cache(re)
    let slots = find_one(re, mut c, text, start, len(text), false, 2)
    if len(slots) == 0 {
        return None
    }
    return Some(Match { start: slots[0], end: slots[1] })
}

// Every match, left to right, not overlapping, as Rust's regex finds them
// (see all_slots).
pub fn find_all(re: Regex, text: Str) -> [Match] {
    let mut out: [Match] = []
    for slots in all_slots(re, text, 0, len(text), false, -1, 2) {
        push(mut out, Match { start: slots[0], end: slots[1] })
    }
    return out
}

// The groups of the leftmost match, the whole match first: each a start
// and an end, or -1 and -1 for a group that took no part in it.
pub fn captures(re: Regex, text: Str) -> Option[[Match]] {
    let mut c = cache(re)
    let slots = find_one(re, mut c, text, 0, len(text), false, re.groups * 2)
    if len(slots) == 0 {
        return None
    }
    return Some(groups_of(slots))
}

// Every match's groups, as `captures` gives them.
pub fn captures_all(re: Regex, text: Str) -> [[Match]] {
    let mut out: [[Match]] = []
    for slots in all_slots(re, text, 0, len(text), false, -1, re.groups * 2) {
        push(mut out, groups_of(slots))
    }
    return out
}

// The text of a group of a match, by number; "" if it took no part.
pub fn group_text(text: Str, groups: [Match], n: Int) -> Str {
    if n < 0 || n >= len(groups) || groups[n].start < 0 {
        return ""
    }
    return text[groups[n].start..groups[n].end]
}

// A named group's number, or -1.
pub fn group_index(re: Regex, name: Str) -> Int {
    for i in 0..len(re.names) {
        if re.names[i] == name && name != "" {
            return i
        }
    }
    return -1
}

// The text with every match replaced. In the replacement, $1 or ${1} is a
// group's text, ${name} a named group's, and $$ a dollar sign.
pub fn replace_all(re: Regex, text: Str, replacement: Str) -> Str {
    let mut b = strings.builder()
    let mut last = 0
    let mut width = 2
    for c in replacement {
        if c == '$' {
            width = re.groups * 2  // the replacement may name a group
        }
    }
    for slots in all_slots(re, text, 0, len(text), false, -1, width) {
        strings.add(mut b, text[last..slots[0]])
        expand(mut b, re, text, slots, replacement)
        last = slots[1]
    }
    strings.add(mut b, text[last..len(text)])
    return strings.build(b)
}

// The text between the matches.
pub fn split(re: Regex, text: Str) -> [Str] {
    let mut out: [Str] = []
    let mut last = 0
    for slots in all_slots(re, text, 0, len(text), false, -1, 2) {
        push(mut out, text[last..slots[0]])
        last = slots[1]
    }
    push(mut out, text[last..len(text)])
    return out
}

// Matches of the text between `start` and `end`, up to `limit` of them
// (-1 for all), each as its groups' slots: start and end of group 0, then
// of group 1, and so on, -1 for a group not taking part. Anchored, each
// match must start where the search for it starts. The text outside the
// bounds still decides what `^`, `$` and `\b` see.
pub fn search_all(re: Regex, text: Str, start: Int, end: Int, anchored: Bool, limit: Int) -> [[Int]] {
    return all_slots(re, text, start, end, anchored, limit, re.groups * 2)
}

fn groups_of(slots: [Int]) -> [Match] {
    let mut out: [Match] = []
    for g in 0..len(slots) / 2 {
        push(mut out, Match { start: slots[2 * g], end: slots[2 * g + 1] })
    }
    return out
}

// Matches as Rust's regex iterates them: after an empty match where the
// previous one ended, the search goes on a byte further; and an empty match
// inside a code point's bytes is not one (anchored, the search stops).
fn all_slots(re: Regex, text: Str, start: Int, end: Int, anchored: Bool, limit: Int, width: Int) -> [[Int]] {
    let mut out: [[Int]] = []
    let mut c = cache(re)
    let mut at = start
    let mut last_end = -1
    for limit < 0 || len(out) < limit {
        let mut slots = find_one(re, mut c, text, at, end, anchored, width)
        if len(slots) == 0 {
            break
        }
        if slots[0] == slots[1] && slots[1] == last_end {
            if at >= end {
                break
            }
            slots = find_one(re, mut c, text, at + 1, end, anchored, width)
            if len(slots) == 0 {
                break
            }
        }
        push(mut out, slots)
        last_end = slots[1]
        at = slots[1]
    }
    return out
}

// The first match from `at`, with `width` capture slots (2: the whole
// match only, which spares copying the groups' slots).
fn find_one(re: Regex, c: mut Cache, text: Str, at: Int, end: Int, anchored: Bool, width: Int) -> [Int] {
    let mut start = at
    for start <= end {
        let slots = search(re, mut c, text, start, end, anchored, width)
        if len(slots) == 0 || slots[0] != slots[1] || boundary(text, slots[0]) {
            return slots
        }
        if anchored {
            break
        }
        start = slots[0] + 1
    }
    return []
}

// Whether a code point starts at byte `at` (or the text ends there).
fn boundary(text: Str, at: Int) -> Bool {
    return at <= 0 || at >= len(text) || int(text[at]) & 0xC0 != 0x80
}

fn expand(b: mut strings.Builder, re: Regex, text: Str, slots: [Int], r: Str) {
    let mut i = 0
    for i < len(r) {
        let c = r[i]
        if c != '$' || i + 1 >= len(r) {
            strings.add_byte(mut b, c)
            i = i + 1
            continue
        }
        if r[i + 1] == '$' {
            strings.add_byte(mut b, '$')
            i = i + 2
            continue
        }
        let mut name = ""
        let mut j = i + 1
        if r[j] == '{' {
            let close = index_from(r, '}', j)
            if close < 0 {
                strings.add_byte(mut b, c)
                i = i + 1
                continue
            }
            name = r[j + 1..close]
            j = close + 1
        } else {
            for j < len(r) && word_byte(r[j]) {
                j = j + 1
            }
            name = r[i + 1..j]
        }
        if name == "" {
            strings.add_byte(mut b, c)
            i = i + 1
            continue
        }
        let mut g = number(name)
        if g < 0 {
            g = group_index(re, name)
        }
        if g >= 0 && 2 * g + 1 < len(slots) && slots[2 * g] >= 0 {
            strings.add(mut b, text[slots[2 * g]..slots[2 * g + 1]])
        }
        i = j
    }
}

fn index_from(s: Str, c: Byte, from: Int) -> Int {
    for i in from..len(s) {
        if s[i] == c {
            return i
        }
    }
    return -1
}

// The decimal number `s` is, or -1.
fn number(s: Str) -> Int {
    if len(s) == 0 || len(s) > 9 {
        return -1
    }
    let mut n = 0
    for c in s {
        if c < '0' || c > '9' {
            return -1
        }
        n = n * 10 + int(c) - int('0')
    }
    return n
}

// ---- Parsing ----

type Flags = struct {
    i: Bool  // letters match either case
    unicode: Bool  // (u, on by default) \d \w \s \b and case folding are Unicode's, not ASCII's
    m: Bool  // ^ and $ match at line ends too
    s: Bool  // . matches \n too
    u: Bool  // (U) repetitions are lazy unless marked with ?
    x: Bool  // spaces and # comments in the pattern are ignored
    r: Bool  // (R) \r\n ends a line: ^ and $ with m, and what . leaves out
}

// The pattern as a tree. A class is its ranges, sorted and not touching:
// [lo, hi, lo, hi, ...].
type Node = enum {
    Empty
    Lit(Int)
    Class([Int])
    Look(Int)  // an assertion: START, END, ...
    Group(Int, [Node])  // a capture group's number and its one node
    Concat([Node])
    Alt([Node])
    Repeat([Node], Int, Int, Bool)  // its one node, at least, at most (-1: no limit), greedy
}

type Parser = struct {
    text: Str
    pos: Int
    error: Str
    groups: Int
    names: [Str]
    flags: Flags
    depth: Int
}

fn max_depth() -> Int {
    return 200
}

fn fail(p: mut Parser, message: Str) {
    if p.error == "" {
        p.error = "regex error at offset " + strings.from_int(p.pos) + ": " + message
    }
}

fn more(p: Parser) -> Bool {
    return p.pos < len(p.text)
}

fn peek(p: Parser) -> Byte {
    if p.pos < len(p.text) {
        return p.text[p.pos]
    }
    return byte(0)
}

// With the x flag, spaces and comments between pieces of the pattern.
fn skip_ignored(p: mut Parser) {
    if !p.flags.x {
        return
    }
    for more(p) {
        let c = p.text[p.pos]
        if c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == byte(12) {
            p.pos = p.pos + 1
        } else if c == '#' {
            for more(p) && p.text[p.pos] != '\n' {
                p.pos = p.pos + 1
            }
        } else {
            return
        }
    }
}

fn alternation(p: mut Parser) -> Node {
    let mut branches = [concatenation(mut p)]
    for p.error == "" && peek(p) == '|' {
        p.pos = p.pos + 1
        push(mut branches, concatenation(mut p))
    }
    if len(branches) == 1 {
        return branches[0]
    }
    return Node.Alt(branches)
}

fn concatenation(p: mut Parser) -> Node {
    let mut items: [Node] = []
    for p.error == "" {
        skip_ignored(mut p)
        if !more(p) || peek(p) == '|' || peek(p) == ')' {
            break
        }
        let atom = atom_node(mut p)
        if p.error != "" {
            break
        }
        push(mut items, repetition(mut p, atom))
    }
    if len(items) == 0 {
        return Node.Empty
    }
    if len(items) == 1 {
        return items[0]
    }
    return Node.Concat(items)
}

fn repetition(p: mut Parser, atom: Node) -> Node {
    let mut node = atom
    for p.error == "" {
        skip_ignored(mut p)
        let c = peek(p)
        let mut min = 0
        let mut max = -1
        if c == '*' {
            p.pos = p.pos + 1
        } else if c == '+' {
            min = 1
            p.pos = p.pos + 1
        } else if c == '?' {
            max = 1
            p.pos = p.pos + 1
        } else if c == '{' && counted(p) {
            let bounds = counts(mut p)
            if p.error != "" {
                return node
            }
            min = bounds[0]
            max = bounds[1]
        } else {
            return node
        }
        match node {
            Node.Concat(items) => {
                if len(items) == 0 {
                    fail(mut p, "a repetition of flags")
                    return node
                }
            }
            _ => {}
        }
        let mut greedy = true
        if peek(p) == '?' {
            greedy = false
            p.pos = p.pos + 1
        }
        if p.flags.u {
            greedy = !greedy
        }
        node = Node.Repeat([node], min, max, greedy)
    }
    return node
}

// Whether a `{` starts a counted repetition: {n}, {n,} or {n,m}.
fn counted(p: Parser) -> Bool {
    let mut i = p.pos + 1
    let mut digits = 0
    for i < len(p.text) && p.text[i] >= '0' && p.text[i] <= '9' {
        i = i + 1
        digits = digits + 1
    }
    return digits > 0 && i < len(p.text) && (p.text[i] == '}' || p.text[i] == ',')
}

fn counts(p: mut Parser) -> [Int] {
    p.pos = p.pos + 1
    let min = decimal(mut p)
    let mut max = min
    if peek(p) == ',' {
        p.pos = p.pos + 1
        if peek(p) == '}' {
            max = -1
        } else {
            max = decimal(mut p)
        }
    }
    if peek(p) != '}' {
        fail(mut p, "a counted repetition without its '}'")
        return [0, 0]
    }
    p.pos = p.pos + 1
    if min > 100000 || max > 100000 {
        fail(mut p, "a repetition count above 100000")
    } else if max >= 0 && max < min {
        fail(mut p, "a repetition {n,m} with m below n")
    }
    return [min, max]
}

fn decimal(p: mut Parser) -> Int {
    let start = p.pos
    let mut n = 0
    for more(p) && peek(p) >= '0' && peek(p) <= '9' {
        if n < 100000 {
            n = n * 10 + int(peek(p)) - int('0')
        }
        p.pos = p.pos + 1
    }
    if p.pos == start {
        fail(mut p, "expected a number")
    }
    return n
}

fn atom_node(p: mut Parser) -> Node {
    let c = peek(p)
    if c == '(' {
        return group(mut p)
    }
    if c == '[' {
        return Node.Class(class(mut p))
    }
    if c == '.' {
        p.pos = p.pos + 1
        if p.flags.s {
            return Node.Class([0, 0x10FFFF])
        }
        if p.flags.r {
            return Node.Class([0, 9, 11, 12, 14, 0x10FFFF])
        }
        return Node.Class([0, 9, 11, 0x10FFFF])
    }
    if c == '^' {
        p.pos = p.pos + 1
        if p.flags.m && p.flags.r {
            return Node.Look(CRLF_START())
        }
        if p.flags.m {
            return Node.Look(LINE_START())
        }
        return Node.Look(TEXT_START())
    }
    if c == '$' {
        p.pos = p.pos + 1
        if p.flags.m && p.flags.r {
            return Node.Look(CRLF_END())
        }
        if p.flags.m {
            return Node.Look(LINE_END())
        }
        return Node.Look(TEXT_END())
    }
    if c == '\\' {
        return escape(mut p)
    }
    if c == '*' || c == '+' || c == '?' {
        fail(mut p, "a repetition of nothing")
        return Node.Empty
    }
    if c == ')' {
        fail(mut p, "unmatched ')'")
        return Node.Empty
    }
    let d = decode(p.text, p.pos)
    p.pos = p.pos + d[1]
    return literal(p.flags, d[0])
}

fn literal(flags: Flags, cp: Int) -> Node {
    if flags.i {
        let folded = fold(flags, [cp, cp])
        if len(folded) > 2 || folded[0] != cp {
            return Node.Class(folded)
        }
    }
    return Node.Lit(cp)
}

fn is_ascii_letter(c: Int) -> Bool {
    return c >= int('a') && c <= int('z') || c >= int('A') && c <= int('Z')
}

fn group(p: mut Parser) -> Node {
    let open = p.pos
    p.pos = p.pos + 1
    p.depth = p.depth + 1
    if p.depth > max_depth() {
        fail(mut p, "groups nested more than " + strings.from_int(max_depth()) + " deep")
        return Node.Empty
    }
    let outer = p.flags
    let mut capture = true
    let mut name = ""
    if peek(p) == '?' {
        p.pos = p.pos + 1
        capture = false
        if peek(p) == 'P' && p.pos + 1 < len(p.text) && p.text[p.pos + 1] == '<' || peek(p) == '<' {
            if peek(p) == 'P' {
                p.pos = p.pos + 1
            }
            p.pos = p.pos + 1
            let start = p.pos
            for more(p) && peek(p) != '>' {
                p.pos = p.pos + 1
            }
            name = p.text[start..p.pos]
            if !more(p) || !valid_name(name) {
                fail(mut p, "a group name must be letters, digits and _, not starting with a digit")
                return Node.Empty
            }
            for n in p.names {
                if n == name {
                    fail(mut p, "the group name " + name + " is used twice")
                    return Node.Empty
                }
            }
            p.pos = p.pos + 1
            capture = true
        } else {
            // Flags, for the rest of the enclosing group or for this one.
            let mut on = true
            let mut any = false
            for more(p) && peek(p) != ')' && peek(p) != ':' {
                let f = peek(p)
                if f == '-' {
                    if !on {
                        fail(mut p, "a second '-' in flags")
                        return Node.Empty
                    }
                    on = false
                } else if f == 'i' {
                    p.flags.i = on
                } else if f == 'm' {
                    p.flags.m = on
                } else if f == 's' {
                    p.flags.s = on
                } else if f == 'U' {
                    p.flags.u = on
                } else if f == 'x' {
                    p.flags.x = on
                } else if f == 'R' {
                    p.flags.r = on
                } else if f == 'u' {
                    p.flags.unicode = on
                } else {
                    fail(mut p, "an unknown flag or group syntax (lookaround and backreferences are not supported)")
                    return Node.Empty
                }
                any = true
                p.pos = p.pos + 1
            }
            if !more(p) {
                fail(mut p, "a group without its ')'")
                return Node.Empty
            }
            if peek(p) == ')' {
                if !any || !on && p.text[p.pos - 1] == '-' {
                    fail(mut p, "empty flags")
                    return Node.Empty
                }
                p.pos = p.pos + 1
                p.depth = p.depth - 1
                return Node.Concat([])  // the flags stay set; nothing to match, and nothing to repeat
            }
            p.pos = p.pos + 1  // ':'
        }
    }
    let mut index = -1
    if capture {
        index = p.groups
        p.groups = p.groups + 1
        push(mut p.names, name)
    }
    let inner = alternation(mut p)
    if p.error != "" {
        return Node.Empty
    }
    if peek(p) != ')' {
        p.pos = open
        fail(mut p, "a group without its ')'")
        return Node.Empty
    }
    p.pos = p.pos + 1
    p.depth = p.depth - 1
    p.flags = outer
    if capture {
        return Node.Group(index, [inner])
    }
    return inner
}

fn valid_name(s: Str) -> Bool {
    if len(s) == 0 || s[0] >= '0' && s[0] <= '9' {
        return false
    }
    for c in s {
        if !word_byte(c) {
            return false
        }
    }
    return true
}

fn word_byte(c: Byte) -> Bool {
    return c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '_'
}

// An escape outside a class.
fn escape(p: mut Parser) -> Node {
    if p.pos + 1 >= len(p.text) {
        fail(mut p, "a '\\' at the end of the pattern")
        return Node.Empty
    }
    let c = p.text[p.pos + 1]
    if c == '<' || c == '>' {
        p.pos = p.pos + 2
        if c == '<' {
            return Node.Look(word_look(p.flags, WORD_START()))
        }
        return Node.Look(word_look(p.flags, WORD_END()))
    }
    if c == 'b' && p.pos + 2 < len(p.text) && p.text[p.pos + 2] == '{' {
        let close = index_from(p.text, '}', p.pos)
        if close > 0 {
            let kind = match p.text[p.pos + 3..close] {
                "start" => WORD_START()
                "end" => WORD_END()
                "start-half" => WORD_START_HALF()
                "end-half" => WORD_END_HALF()
                _ => -1
            }
            if kind >= 0 {
                p.pos = close + 1
                return Node.Look(word_look(p.flags, kind))
            }
        }
        fail(mut p, "an unknown word boundary \\b{...}")
        return Node.Empty
    }
    if c == 'b' || c == 'B' || c == 'A' || c == 'z' {
        p.pos = p.pos + 2
        return Node.Look(match c {
            'b' => word_look(p.flags, WORD())
            'B' => word_look(p.flags, NOT_WORD())
            'A' => TEXT_START()
            _ => TEXT_END()
        })
    }
    if c == 'p' || c == 'P' {
        return Node.Class(fold(p.flags, property(mut p)))
    }
    let named = class_escape(p.flags, c)
    if len(named) > 0 {
        p.pos = p.pos + 2
        return Node.Class(named)
    }
    let cp = escaped_char(mut p)
    return literal(p.flags, cp)
}

// A word assertion of the ASCII kind given, or its Unicode kind in Unicode
// mode.
fn word_look(flags: Flags, kind: Int) -> Int {
    if flags.unicode {
        return kind + 8
    }
    return kind
}

// \d \w \s and their negations, as ranges; none for another letter. In
// Unicode mode, decimal digits (Nd), word characters (UTS #18) and
// White_Space; otherwise ASCII's.
fn class_escape(flags: Flags, c: Byte) -> [Int] {
    if flags.unicode {
        return match c {
            'd' => unicode.ranges("Nd")
            'D' => negate(unicode.ranges("Nd"))
            'w' => unicode.ranges("Word")
            'W' => negate(unicode.ranges("Word"))
            's' => unicode.ranges("White_Space")
            'S' => negate(unicode.ranges("White_Space"))
            _ => []
        }
    }
    return match c {
        'd' => [48, 57]
        'D' => negate([48, 57])
        'w' => [48, 57, 65, 90, 95, 95, 97, 122]
        'W' => negate([48, 57, 65, 90, 95, 95, 97, 122])
        's' => [9, 13, 32, 32]
        'S' => negate([9, 13, 32, 32])
        _ => []
    }
}

// An escape that stands for one character, from its backslash.
fn escaped_char(p: mut Parser) -> Int {
    let c = p.text[p.pos + 1]
    p.pos = p.pos + 2
    let simple = match c {
        'n' => 10
        't' => 9
        'r' => 13
        'f' => 12
        'v' => 11
        'a' => 7
        'e' => 27
        '0' => 0
        _ => -1
    }
    if simple >= 0 {
        return simple
    }
    if c == 'x' {
        if peek(p) == '{' {
            let close = index_from(p.text, '}', p.pos)
            if close < 0 {
                fail(mut p, "\\x{ without its '}'")
                return 0
            }
            let v = hex(p.text[p.pos + 1..close])
            p.pos = close + 1
            if v < 0 || v > 0x10FFFF || v >= 0xD800 && v <= 0xDFFF {
                fail(mut p, "\\x{...} must be a Unicode scalar value in hexadecimal")
                return 0
            }
            return v
        }
        if p.pos + 2 > len(p.text) {
            fail(mut p, "\\x needs two hexadecimal digits")
            return 0
        }
        let v = hex(p.text[p.pos..p.pos + 2])
        if v < 0 {
            fail(mut p, "\\x needs two hexadecimal digits")
            return 0
        }
        p.pos = p.pos + 2
        return v
    }
    if c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' {
        p.pos = p.pos - 2
        fail(mut p, "an escape this syntax does not have: \\" + p.text[p.pos + 1..p.pos + 2])
        return 0
    }
    // Any other escaped character stands for itself: \. \* \\ \- ...
    let d = decode(p.text, p.pos - 1)
    p.pos = p.pos - 1 + d[1]
    return d[0]
}

fn hex(s: Str) -> Int {
    if len(s) == 0 || len(s) > 8 {
        return -1
    }
    let mut v = 0
    for c in s {
        let mut d = -1
        if c >= '0' && c <= '9' {
            d = int(c) - int('0')
        } else if c >= 'a' && c <= 'f' {
            d = int(c) - int('a') + 10
        } else if c >= 'A' && c <= 'F' {
            d = int(c) - int('A') + 10
        }
        if d < 0 {
            return -1
        }
        v = v * 16 + d
    }
    return v
}

// [...]: its ranges, normalized.
fn class(p: mut Parser) -> [Int] {
    let open = p.pos
    p.pos = p.pos + 1
    let mut negated = false
    if peek(p) == '^' {
        negated = true
        p.pos = p.pos + 1
    }
    let mut ranges: [Int] = []
    let mut first = true
    for p.error == "" {
        if !more(p) {
            p.pos = open
            fail(mut p, "a class without its ']'")
            return []
        }
        let c = peek(p)
        if c == ']' && !first {
            p.pos = p.pos + 1
            break
        }
        first = false
        if c == '[' && p.pos + 1 < len(p.text) && p.text[p.pos + 1] == ':' {
            let named = posix_class(mut p)
            for r in named {
                push(mut ranges, r)
            }
            continue
        }
        if c == '[' {
            fail(mut p, "a nested class or class operation (not supported)")
            return []
        }
        let lo = class_item(mut p)
        if p.error != "" {
            return []
        }
        if lo[0] == -1 {
            for r in lo[1..len(lo)] {
                push(mut ranges, r)
            }
            continue
        }
        if peek(p) == '-' && p.pos + 1 < len(p.text) && p.text[p.pos + 1] != ']' {
            p.pos = p.pos + 1
            let hi = class_item(mut p)
            if p.error != "" {
                return []
            }
            if hi[0] == -1 {
                fail(mut p, "a range ending in a class")
                return []
            }
            if hi[1] < lo[1] {
                fail(mut p, "a range whose end is before its start")
                return []
            }
            push(mut ranges, lo[1])
            push(mut ranges, hi[1])
        } else {
            push(mut ranges, lo[1])
            push(mut ranges, lo[1])
        }
    }
    // Case folding comes before negation: (?i)[^x] matches neither x nor X.
    let mut out = fold(p.flags, normalize(ranges))
    if negated {
        out = negate(out)
    }
    return out
}

// One item of a class: [0, code point], or [-1, ranges...] for \d, \w...
fn class_item(p: mut Parser) -> [Int] {
    let c = peek(p)
    if c == '\\' {
        if p.pos + 1 >= len(p.text) {
            fail(mut p, "a '\\' at the end of the pattern")
            return [0, 0]
        }
        let mut named = class_escape(p.flags, p.text[p.pos + 1])
        if p.text[p.pos + 1] == 'p' || p.text[p.pos + 1] == 'P' {
            named = property(mut p)
            if p.error != "" {
                return [0, 0]
            }
            let mut out = [-1]
            for r in named {
                push(mut out, r)
            }
            return out
        }
        if len(named) > 0 {
            p.pos = p.pos + 2
            let mut out = [-1]
            for r in named {
                push(mut out, r)
            }
            return out
        }
        let e = p.text[p.pos + 1]
        if e == 'b' {
            p.pos = p.pos + 2
            return [0, 8]  // backspace, inside a class
        }
        return [0, escaped_char(mut p)]
    }
    let d = decode(p.text, p.pos)
    p.pos = p.pos + d[1]
    return [0, d[0]]
}

fn posix_class(p: mut Parser) -> [Int] {
    let close = index_from(p.text, ']', p.pos)
    if close < 0 || p.text[close - 1] != ':' {
        fail(mut p, "a malformed [:name:] class")
        return []
    }
    let mut name = p.text[p.pos + 2..close - 1]
    let mut negated = false
    if len(name) > 0 && name[0] == '^' {
        negated = true
        name = name[1..len(name)]
    }
    let ranges = match name {
        "alnum" => [48, 57, 65, 90, 97, 122]
        "alpha" => [65, 90, 97, 122]
        "ascii" => [0, 127]
        "blank" => [9, 9, 32, 32]
        "cntrl" => [0, 31, 127, 127]
        "digit" => [48, 57]
        "graph" => [33, 126]
        "lower" => [97, 122]
        "print" => [32, 126]
        "punct" => [33, 47, 58, 64, 91, 96, 123, 126]
        "space" => [9, 13, 32, 32]
        "upper" => [65, 90]
        "word" => [48, 57, 65, 90, 95, 95, 97, 122]
        "xdigit" => [48, 57, 65, 70, 97, 102]
        _ => []
    }
    if len(ranges) == 0 {
        fail(mut p, "an unknown class [:" + name + ":]")
        return []
    }
    p.pos = close + 1
    if negated {
        return negate(ranges)
    }
    return ranges
}

// Ranges sorted, with overlapping and touching ones merged.
fn normalize(ranges: [Int]) -> [Int] {
    let n = len(ranges) / 2
    let mut order: [Int] = []
    for i in 0..n {
        push(mut order, i)
    }
    // Insertion sort by start: classes are small.
    for i in 1..n {
        let x = order[i]
        let mut j = i - 1
        for j >= 0 && ranges[2 * order[j]] > ranges[2 * x] {
            order[j + 1] = order[j]
            j = j - 1
        }
        order[j + 1] = x
    }
    let mut out: [Int] = []
    for k in order {
        let lo = ranges[2 * k]
        let hi = ranges[2 * k + 1]
        let m = len(out)
        if m > 0 && lo <= out[m - 1] + 1 {
            if hi > out[m - 1] {
                out[m - 1] = hi
            }
        } else {
            push(mut out, lo)
            push(mut out, hi)
        }
    }
    return out
}

fn negate(ranges: [Int]) -> [Int] {
    let mut out: [Int] = []
    let mut next = 0
    for k in 0..len(ranges) / 2 {
        if ranges[2 * k] > next {
            push(mut out, next)
            push(mut out, ranges[2 * k] - 1)
        }
        next = ranges[2 * k + 1] + 1
    }
    if next <= 0x10FFFF {
        push(mut out, next)
        push(mut out, 0x10FFFF)
    }
    return out
}

// With the i flag, a class takes the other case of every ASCII letter in it.
fn fold(flags: Flags, ranges: [Int]) -> [Int] {
    if !flags.i {
        return ranges
    }
    if flags.unicode {
        return fold_unicode(ranges)
    }
    let mut out = ranges
    for k in 0..len(ranges) / 2 {
        let lo = ranges[2 * k]
        let hi = ranges[2 * k + 1]
        let a = max(lo, int('a'))
        let b = min(hi, int('z'))
        if a <= b {
            push(mut out, a - 32)
            push(mut out, b - 32)
        }
        let c = max(lo, int('A'))
        let d = min(hi, int('Z'))
        if c <= d {
            push(mut out, c + 32)
            push(mut out, d + 32)
        }
    }
    return normalize(out)
}

// The ranges with every code point added that has the same simple case
// folding as one of them (Unicode's simple case folding, as Rust's and
// RE2's (?i) use): those folding to what folds from the ranges, and those
// it folds to.
fn fold_unicode(ranges: [Int]) -> [Int] {
    let pairs = unicode.simple_folds()
    let mut targets: [Int] = []
    for k in 0..len(pairs) / 2 {
        if in_class(ranges, pairs[2 * k]) || in_class(ranges, pairs[2 * k + 1]) {
            push(mut targets, pairs[2 * k + 1])
        }
    }
    if len(targets) == 0 {
        return ranges
    }
    targets = lists.sort(targets)
    let mut out = ranges
    for k in 0..len(pairs) / 2 {
        if sorted_has(targets, pairs[2 * k + 1]) {
            push(mut out, pairs[2 * k])
            push(mut out, pairs[2 * k])
            push(mut out, pairs[2 * k + 1])
            push(mut out, pairs[2 * k + 1])
        }
    }
    return normalize(out)
}

fn sorted_has(xs: [Int], x: Int) -> Bool {
    let mut lo = 0
    let mut hi = len(xs)
    for lo < hi {
        let mid = (lo + hi) / 2
        if xs[mid] < x {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return lo < len(xs) && xs[lo] == x
}

// A Unicode property class after its backslash: \pL, \p{Greek}... with
// \P or \p{^...} for its negation. General categories by short or long
// name (Lu, Uppercase_Letter, L, Letter, gc=Lu, ...), and Any, ASCII,
// Assigned, Alphabetic and White_Space; names are matched ignoring case,
// spaces, '_' and '-', as UTS #18 recommends.
fn property(p: mut Parser) -> [Int] {
    let negated = p.text[p.pos + 1] == 'P'
    p.pos = p.pos + 2
    if !p.flags.unicode {
        fail(mut p, "a Unicode property class in ASCII mode (?-u)")
        return [0, 0]
    }
    let mut name = ""
    if more(p) && peek(p) == '{' {
        let close = index_from(p.text, '}', p.pos)
        if close < 0 {
            fail(mut p, "a Unicode property class without its '}'")
            return [0, 0]
        }
        name = p.text[p.pos + 1..close]
        p.pos = close + 1
    } else if more(p) {
        name = p.text[p.pos..p.pos + 1]
        p.pos = p.pos + 1
    }
    let mut neg = negated
    if len(name) > 0 && name[0] == '^' {
        neg = !neg
        name = name[1..len(name)]
    }
    let ranges = property_ranges(loose(name))
    if len(ranges) == 0 {
        fail(mut p, "an unknown or unsupported Unicode property: " + name)
        return [0, 0]
    }
    if neg {
        return negate(ranges)
    }
    return ranges
}

// A property name as UAX #44 matches them loosely: lower case, without
// spaces, '_' or '-'.
fn loose(name: Str) -> Str {
    let mut b = strings.builder()
    for c in name {
        if c >= 'A' && c <= 'Z' {
            strings.add_byte(mut b, c + 32)
        } else if c != ' ' && c != '_' && c != '-' {
            strings.add_byte(mut b, c)
        }
    }
    return strings.build(b)
}

fn property_ranges(name: Str) -> [Int] {
    let eq = index_from(name, '=', 0)
    let colon = index_from(name, ':', 0)
    let mut split = eq
    if split < 0 {
        split = colon
    }
    if split >= 0 {
        let key = name[0..split]
        if key != "gc" && key != "generalcategory" {
            return []
        }
        return category_ranges(name[split + 1..len(name)])
    }
    return match name {
        "any" => [0, 0x10FFFF]
        "ascii" => [0, 0x7F]
        "assigned" => negate(unicode.ranges("Cn"))
        "alphabetic" => unicode.ranges("Alphabetic")
        "alpha" => unicode.ranges("Alphabetic")
        "whitespace" => unicode.ranges("White_Space")
        "wspace" => unicode.ranges("White_Space")
        "space" => unicode.ranges("White_Space")
        _ => category_ranges(name)
    }
}

// A general category or group by its short or long name, loosely matched.
fn category_ranges(name: Str) -> [Int] {
    let short = match name {
        "lu" => "Lu"
        "uppercaseletter" => "Lu"
        "ll" => "Ll"
        "lowercaseletter" => "Ll"
        "lt" => "Lt"
        "titlecaseletter" => "Lt"
        "lc" => "LC"
        "casedletter" => "LC"
        "lm" => "Lm"
        "modifierletter" => "Lm"
        "lo" => "Lo"
        "otherletter" => "Lo"
        "l" => "L"
        "letter" => "L"
        "mn" => "Mn"
        "nonspacingmark" => "Mn"
        "mc" => "Mc"
        "spacingmark" => "Mc"
        "me" => "Me"
        "enclosingmark" => "Me"
        "m" => "M"
        "mark" => "M"
        "combiningmark" => "M"
        "nd" => "Nd"
        "decimalnumber" => "Nd"
        "digit" => "Nd"
        "nl" => "Nl"
        "letternumber" => "Nl"
        "no" => "No"
        "othernumber" => "No"
        "n" => "N"
        "number" => "N"
        "pc" => "Pc"
        "connectorpunctuation" => "Pc"
        "pd" => "Pd"
        "dashpunctuation" => "Pd"
        "ps" => "Ps"
        "openpunctuation" => "Ps"
        "pe" => "Pe"
        "closepunctuation" => "Pe"
        "pi" => "Pi"
        "initialpunctuation" => "Pi"
        "pf" => "Pf"
        "finalpunctuation" => "Pf"
        "po" => "Po"
        "otherpunctuation" => "Po"
        "p" => "P"
        "punctuation" => "P"
        "punct" => "P"
        "sm" => "Sm"
        "mathsymbol" => "Sm"
        "sc" => "Sc"
        "currencysymbol" => "Sc"
        "sk" => "Sk"
        "modifiersymbol" => "Sk"
        "so" => "So"
        "othersymbol" => "So"
        "s" => "S"
        "symbol" => "S"
        "zs" => "Zs"
        "spaceseparator" => "Zs"
        "zl" => "Zl"
        "lineseparator" => "Zl"
        "zp" => "Zp"
        "paragraphseparator" => "Zp"
        "z" => "Z"
        "separator" => "Z"
        "cc" => "Cc"
        "control" => "Cc"
        "cntrl" => "Cc"
        "cf" => "Cf"
        "format" => "Cf"
        "cs" => "Cs"
        "surrogate" => "Cs"
        "co" => "Co"
        "privateuse" => "Co"
        "cn" => "Cn"
        "unassigned" => "Cn"
        "c" => "C"
        "other" => "C"
        _ => ""
    }
    if short == "" {
        return []
    }
    return unicode.ranges(short)
}

fn max(a: Int, b: Int) -> Int {
    if a > b {
        return a
    }
    return b
}

fn min(a: Int, b: Int) -> Int {
    if a < b {
        return a
    }
    return b
}

// The code point at byte `at`, and its length in bytes: [-1, 1] for a byte
// that does not start a valid UTF-8 sequence, which nothing matches.
fn decode(s: Str, at: Int) -> [Int] {
    let cp = code_point(s, at)
    return [cp, cp_width(cp)]
}

// The code point at byte `at`, or -1 if a code point does not start there.
fn code_point(s: Str, at: Int) -> Int {
    let c = int(s[at])
    if c < 0x80 {
        return c
    }
    let mut need = 0
    let mut cp = 0
    let mut least = 0
    if c >= 0xC2 && c <= 0xDF {
        need = 1
        cp = c & 0x1F
        least = 0x80
    } else if c >= 0xE0 && c <= 0xEF {
        need = 2
        cp = c & 0x0F
        least = 0x800
    } else if c >= 0xF0 && c <= 0xF4 {
        need = 3
        cp = c & 0x07
        least = 0x10000
    } else {
        return -1
    }
    if at + need >= len(s) {
        return -1
    }
    for k in 1..need + 1 {
        let x = int(s[at + k])
        if x & 0xC0 != 0x80 {
            return -1
        }
        cp = cp << 6 | x & 0x3F
    }
    if cp < least || cp > 0x10FFFF || cp >= 0xD800 && cp <= 0xDFFF {
        return -1
    }
    return cp
}

// The bytes of a code point (1 for -1, the byte that is not one).
fn cp_width(cp: Int) -> Int {
    if cp < 0x80 {
        return 1
    }
    if cp < 0x800 {
        return 2
    }
    if cp < 0x10000 {
        return 3
    }
    return 4
}

fn width_at(s: Str, at: Int) -> Int {
    if at >= len(s) {
        return 1
    }
    return decode(s, at)[1]
}

// ---- Compiling ----

fn CHAR() -> Int {
    return 0
}

fn CLASS() -> Int {
    return 1
}

fn SPLIT() -> Int {
    return 2
}

fn JUMP() -> Int {
    return 3
}

fn SAVE() -> Int {
    return 4
}

fn LOOK() -> Int {
    return 5
}

fn MATCH() -> Int {
    return 6
}

fn TEXT_START() -> Int {
    return 0
}

fn TEXT_END() -> Int {
    return 1
}

fn LINE_START() -> Int {
    return 2
}

fn LINE_END() -> Int {
    return 3
}

fn WORD() -> Int {
    return 4
}

fn NOT_WORD() -> Int {
    return 5
}

fn WORD_START() -> Int {
    return 6
}

fn WORD_END() -> Int {
    return 7
}

fn WORD_START_HALF() -> Int {
    return 8
}

fn WORD_END_HALF() -> Int {
    return 9
}

fn CRLF_START() -> Int {
    return 10
}

fn CRLF_END() -> Int {
    return 11
}

// One instruction: CHAR a; CLASS ranges; SPLIT to a, then b (a first);
// JUMP to a; SAVE slot a; LOOK assertion a; MATCH.
type Inst = struct {
    op: Int
    a: Int
    b: Int
    ranges: [Int]
}

type Compiler = struct {
    program: [Inst]
    error: Str
    reverse: Bool  // the pattern backwards, without captures
}

// Programs past this size are refused, so a pattern like (a{1000}){1000}
// cannot take the memory of millions of instructions.
fn max_program() -> Int {
    return 200000
}

fn emit(c: mut Compiler, i: Inst) -> Int {
    if len(c.program) >= max_program() {
        if c.error == "" {
            c.error = "regex error: the pattern compiles to more than " + strings.from_int(max_program()) + " instructions"
        }
        return len(c.program) - 1
    }
    push(mut c.program, i)
    return len(c.program) - 1
}

fn gen(c: mut Compiler, n: Node) {
    if c.error != "" {
        return
    }
    match n {
        Node.Empty => {}
        Node.Lit(cp) => {
            let _ = emit(mut c, Inst { op: CHAR(), a: cp, b: 0, ranges: [] })
        }
        Node.Class(ranges) => {
            if len(ranges) == 2 && ranges[0] == ranges[1] {
                let _ = emit(mut c, Inst { op: CHAR(), a: ranges[0], b: 0, ranges: [] })
            } else {
                let _ = emit(mut c, Inst { op: CLASS(), a: 0, b: 0, ranges: ranges })
            }
        }
        Node.Look(kind) => {
            let _ = emit(mut c, Inst { op: LOOK(), a: kind, b: 0, ranges: [] })
        }
        Node.Group(index, inner) => {
            if c.reverse {
                gen(mut c, inner[0])
                return
            }
            let _ = emit(mut c, Inst { op: SAVE(), a: 2 * index, b: 0, ranges: [] })
            gen(mut c, inner[0])
            let _ = emit(mut c, Inst { op: SAVE(), a: 2 * index + 1, b: 0, ranges: [] })
        }
        Node.Concat(items) => {
            for k in 0..len(items) {
                if c.reverse {
                    gen(mut c, items[len(items) - 1 - k])
                } else {
                    gen(mut c, items[k])
                }
            }
        }
        Node.Alt(branches) => {
            // split L1, next; L1: a; jump end; next: split L2, ...
            let mut jumps: [Int] = []
            for k in 0..len(branches) {
                if k < len(branches) - 1 {
                    let split = emit(mut c, Inst { op: SPLIT(), a: 0, b: 0, ranges: [] })
                    c.program[split].a = len(c.program)
                    gen(mut c, branches[k])
                    push(mut jumps, emit(mut c, Inst { op: JUMP(), a: 0, b: 0, ranges: [] }))
                    c.program[split].b = len(c.program)
                } else {
                    gen(mut c, branches[k])
                }
                if c.error != "" {
                    return
                }
            }
            for j in jumps {
                c.program[j].a = len(c.program)
            }
        }
        Node.Repeat(inner, lo, hi, greedy) => {
            if hi < 0 {
                // e* is (e+)?, and e+ is `L: e; split L, out`, so an
                // iteration that matches the empty string still sets its
                // groups, as RE2 and Rust do.
                for _ in 0..lo - 1 {
                    gen(mut c, inner[0])
                    if c.error != "" {
                        return
                    }
                }
                let mut skip = -1
                if lo == 0 {
                    skip = emit(mut c, Inst { op: SPLIT(), a: 0, b: 0, ranges: [] })
                }
                let body = len(c.program)
                gen(mut c, inner[0])
                let again = emit(mut c, Inst { op: SPLIT(), a: 0, b: 0, ranges: [] })
                prefer(mut c, again, body, len(c.program), greedy)
                if skip >= 0 {
                    prefer(mut c, skip, body, len(c.program), greedy)
                }
                return
            }
            for _ in 0..lo {
                gen(mut c, inner[0])
                if c.error != "" {
                    return
                }
            }
            if hi >= 0 {
                // Each optional copy: split body, out.
                let mut splits: [Int] = []
                for _ in lo..hi {
                    let split = emit(mut c, Inst { op: SPLIT(), a: 0, b: 0, ranges: [] })
                    push(mut splits, split)
                    gen(mut c, inner[0])
                    if c.error != "" {
                        return
                    }
                }
                let out = len(c.program)
                for s in splits {
                    prefer(mut c, s, s + 1, out, greedy)
                }
            }
        }
    }
}

fn prefer(c: mut Compiler, split: Int, body: Int, out: Int, greedy: Bool) {
    if split >= len(c.program) {
        return
    }
    if greedy {
        c.program[split].a = body
        c.program[split].b = out
    } else {
        c.program[split].a = out
        c.program[split].b = body
    }
}

// Whether every way through the program meets \A before reading anything.
fn starts_anchored(program: [Inst]) -> Bool {
    let mut pc = 0
    for pc < len(program) {
        let i = program[pc]
        if i.op == SAVE() {
            pc = pc + 1
        } else if i.op == LOOK() && i.a == TEXT_START() {
            return true
        } else {
            return false
        }
    }
    return false
}

// The bytes of the characters every match starts with, before any choice.
fn literal_prefix(program: [Inst]) -> Str {
    let mut b = strings.builder()
    let mut pc = 0
    for pc < len(program) && program[pc].op == SAVE() {
        pc = pc + 1
    }
    for pc < len(program) && program[pc].op == CHAR() {
        add_utf8(mut b, program[pc].a)
        pc = pc + 1
    }
    return strings.build(b)
}

fn add_utf8(b: mut strings.Builder, cp: Int) {
    if cp < 0x80 {
        strings.add_byte(mut b, byte(cp))
    } else if cp < 0x800 {
        strings.add_byte(mut b, byte(0xC0 | cp >> 6))
        strings.add_byte(mut b, byte(0x80 | cp & 0x3F))
    } else if cp < 0x10000 {
        strings.add_byte(mut b, byte(0xE0 | cp >> 12))
        strings.add_byte(mut b, byte(0x80 | cp >> 6 & 0x3F))
        strings.add_byte(mut b, byte(0x80 | cp & 0x3F))
    } else {
        strings.add_byte(mut b, byte(0xF0 | cp >> 18))
        strings.add_byte(mut b, byte(0x80 | cp >> 12 & 0x3F))
        strings.add_byte(mut b, byte(0x80 | cp >> 6 & 0x3F))
        strings.add_byte(mut b, byte(0x80 | cp & 0x3F))
    }
}

// The bytes the first character of a match can start with, from the
// program's start through every split and assertion: empty when a match
// can be empty or start with any byte, so no position can be skipped.
fn first_bytes(program: [Inst]) -> [Bool] {
    let mut set: [Bool] = []
    for _ in 0..256 {
        push(mut set, false)
    }
    let mut seen: [Bool] = []
    for _ in program {
        push(mut seen, false)
    }
    let mut stack = [0]
    let mut n = 1
    let mut count = 0
    for n > 0 {
        n = n - 1
        let pc = stack[n]
        if seen[pc] {
            continue
        }
        seen[pc] = true
        let i = program[pc]
        if i.op == MATCH() {
            return []
        } else if i.op == SAVE() || i.op == LOOK() {
            n = push_pc(mut stack, n, pc + 1)
        } else if i.op == JUMP() {
            n = push_pc(mut stack, n, i.a)
        } else if i.op == SPLIT() {
            n = push_pc(mut stack, n, i.a)
            n = push_pc(mut stack, n, i.b)
        } else if i.op == CHAR() {
            let b = lead_byte(i.a)
            if !set[b] {
                set[b] = true
                count = count + 1
            }
        } else {
            for k in 0..len(i.ranges) / 2 {
                let lo = lead_byte(i.ranges[2 * k])
                let hi = lead_byte(i.ranges[2 * k + 1])
                for b in lo..hi + 1 {
                    if !set[b] {
                        set[b] = true
                        count = count + 1
                    }
                }
            }
        }
    }
    if count >= 256 {
        return []
    }
    return set
}

fn push_pc(stack: mut [Int], n: Int, pc: Int) -> Int {
    if n < len(stack) {
        stack[n] = pc
    } else {
        push(mut stack, pc)
    }
    return n + 1
}

// The first byte of a code point's UTF-8 encoding.
fn lead_byte(cp: Int) -> Int {
    if cp < 0x80 {
        return cp
    }
    if cp < 0x800 {
        return 0xC0 | cp >> 6
    }
    if cp < 0x10000 {
        return 0xE0 | cp >> 12
    }
    return 0xF0 | cp >> 18
}

// ---- The Pike VM ----

// Threads at one position: the program counters in priority order, and
// each one's capture slots in `slots` (`width` of them per thread).
type Threads = struct {
    pcs: [Int]
    count: Int
    gen: Int  // which position the list is for: a pc is in it when on[pc] == gen
    on: [Int]
    slots: [Int]
}

fn threads(size: Int, width: Int) -> Threads {
    let mut t = Threads { pcs: [], count: 0, gen: 0, on: [], slots: [] }
    for _ in 0..size {
        push(mut t.pcs, 0)
        push(mut t.on, -1)
    }
    for _ in 0..size * width {
        push(mut t.slots, -1)
    }
    return t
}

fn is_word(text: Str, at: Int, before: Bool) -> Bool {
    if before {
        if at <= 0 {
            return false
        }
        return word_byte(text[at - 1])
    }
    if at >= len(text) {
        return false
    }
    return word_byte(text[at])
}

// Whether a word assertion holds between a word character or not before and
// after.
fn word_holds(kind: Int, before: Bool, after: Bool) -> Bool {
    if kind == WORD() {
        return before != after
    }
    if kind == NOT_WORD() {
        return before == after
    }
    if kind == WORD_START() {
        return !before && after
    }
    if kind == WORD_END() {
        return before && !after
    }
    if kind == WORD_START_HALF() {
        return !before
    }
    return !after
}

// Whether the code point before (or at) byte `at` is a Unicode word
// character; a byte that is not UTF-8 is not one.
fn unicode_word(text: Str, at: Int, before: Bool) -> Bool {
    if before && at <= 0 || !before && at >= len(text) {
        return false
    }
    let mut cp = 0
    if before {
        cp = int(text[at - 1])
        if cp >= 0x80 {
            cp = code_point_before(text, 0, at)
        }
    } else {
        cp = int(text[at])
        if cp >= 0x80 {
            cp = code_point(text, at)
        }
    }
    if cp < 0x80 {
        return cp >= 0 && word_byte(byte(cp))
    }
    return unicode.has(cp, "Word")
}

fn holds(kind: Int, text: Str, at: Int) -> Bool {
    if kind >= 12 {
        // A Unicode word assertion: as the ASCII one, with Unicode's word
        // characters on either side.
        let before = unicode_word(text, at, true)
        let after = unicode_word(text, at, false)
        return word_holds(kind - 8, before, after)
    }
    if kind == TEXT_START() {
        return at == 0
    }
    if kind == TEXT_END() {
        return at == len(text)
    }
    if kind == LINE_START() {
        return at == 0 || text[at - 1] == '\n'
    }
    if kind == LINE_END() {
        return at == len(text) || text[at] == '\n'
    }
    // In CRLF mode, never between the \r and the \n of a line ending.
    if kind == CRLF_START() {
        return at == 0 || text[at - 1] == '\n' || text[at - 1] == '\r' && (at >= len(text) || text[at] != '\n')
    }
    if kind == CRLF_END() {
        return at == len(text) || text[at] == '\r' || text[at] == '\n' && (at == 0 || text[at - 1] != '\r')
    }
    return word_holds(kind, is_word(text, at, true), is_word(text, at, false))
}

// Adds the thread at `pc0`, with the captures `src[off..off + width]`, to
// `t`, following splits, jumps, saves and assertions at text position `at`,
// in priority order. `work` holds the captures as they change on the way;
// `stack` has room for two entries for each instruction.
fn add(re: Regex, t: mut Threads, pc0: Int, src: [Int], off: Int, width: Int, text: Str, at: Int, stack: mut [Int], work: mut [Int]) {
    for s in 0..width {
        work[s] = src[off + s]
    }
    // A stack of [pc, slot to restore (-1 for none), its old value]. Each
    // instruction is visited once, and pushes at most two entries.
    stack[0] = pc0
    stack[1] = -1
    let mut n = 3
    for n > 0 {
        n = n - 3
        let pc = stack[n]
        let slot = stack[n + 1]
        if slot >= 0 {
            work[slot] = stack[n + 2]  // leaving a save: put the slot back
            continue
        }
        if t.on[pc] == t.gen {
            continue
        }
        t.on[pc] = t.gen
        let op = re.ops[pc]
        if op == JUMP() {
            stack[n] = re.xs[pc]
            stack[n + 1] = -1
            n = n + 3
        } else if op == SPLIT() {
            stack[n] = re.ys[pc]
            stack[n + 1] = -1
            stack[n + 3] = re.xs[pc]
            stack[n + 4] = -1
            n = n + 6
        } else if op == SAVE() {
            let x = re.xs[pc]
            if x < width {
                stack[n] = 0
                stack[n + 1] = x
                stack[n + 2] = work[x]
                n = n + 3
                work[x] = at
            }
            stack[n] = pc + 1
            stack[n + 1] = -1
            n = n + 3
        } else if op == LOOK() {
            if holds(re.xs[pc], text, at) {
                stack[n] = pc + 1
                stack[n + 1] = -1
                n = n + 3
            }
        } else {
            let k = t.count
            t.pcs[k] = pc
            let base = k * width
            for s in 0..width {
                t.slots[base + s] = work[s]
            }
            t.count = k + 1
        }
    }
}

fn in_class(ranges: [Int], cp: Int) -> Bool {
    if cp < 0 {
        return false
    }
    let mut lo = 0
    let mut hi = len(ranges) / 2
    for lo < hi {
        let mid = (lo + hi) / 2
        if cp < ranges[2 * mid] {
            hi = mid
        } else if cp > ranges[2 * mid + 1] {
            lo = mid + 1
        } else {
            return true
        }
    }
    return false
}

// The leftmost-first match between `start` and `end`, as `width` capture
// slots, or none: the Pike VM, which every search falls back on.
fn pike(re: Regex, text: Str, start: Int, end: Int, anchored: Bool, width: Int) -> [Int] {
    let size = len(re.ops)
    let mut clist = threads(size, width)
    let mut nlist = threads(size, width)
    let mut empty: [Int] = []
    for _ in 0..width {
        push(mut empty, -1)
    }
    let mut work = empty
    let mut stack: [Int] = []
    for _ in 0..6 * size + 3 {
        push(mut stack, 0)
    }
    let mut best: [Int] = []
    let mut at = start
    let only_start = anchored || re.anchored
    let skip = len(re.first) > 0
    let prefix = re.prefix
    for {
        if len(best) == 0 && !(only_start && at > start) {
            // No match yet: start a thread here, after skipping places
            // where no match can start.
            if clist.count == 0 && !only_start {
                let from = at
                if len(prefix) > 1 {
                    at = find_bytes(text, prefix, at, end)
                    if at < 0 {
                        break
                    }
                } else if skip {
                    for at < end && !re.first[int(text[at])] {
                        at = at + 1
                    }
                    if at >= end {
                        break
                    }
                }
                if at != from {
                    clist.gen = clist.gen + 1  // a new position: what the list met at the old one is not met here
                }
            }
            add(re, mut clist, 0, empty, 0, width, text, at, mut stack, mut work)
        }
        if clist.count == 0 {
            // Every thread died here: unless a match is found or the search
            // is anchored, try again a code point further on.
            if len(best) > 0 || only_start || at >= end {
                break
            }
            at = at + width_at(text, at)
            clist.gen = clist.gen + 1  // a new position: nothing is in the list
            continue
        }
        let mut cp = -1
        let mut w = 1
        if at < end {
            let b = int(text[at])
            if b < 0x80 {
                cp = b
            } else {
                let d = decode(text, at)
                cp = d[0]
                w = d[1]
            }
        }
        nlist.gen = nlist.gen + 1
        nlist.count = 0
        for k in 0..clist.count {
            let pc = clist.pcs[k]
            let op = re.ops[pc]
            if op == MATCH() {
                best = []
                for s in 0..width {
                    push(mut best, clist.slots[k * width + s])
                }
                break  // threads after this one have lower priority
            }
            if at < end && (op == CHAR() && re.xs[pc] == cp || op == CLASS() && in_class(re.sets[pc], cp)) {
                add(re, mut nlist, pc + 1, clist.slots, k * width, width, text, at + w, mut stack, mut work)
            }
        }
        if at >= end {
            break
        }
        let tmp = clist
        clist = nlist
        nlist = tmp
        at = at + w
    }
    return best
}

// The first place at or after `from` where `part` occurs and ends by `end`,
// or -1.
fn find_bytes(text: Str, part: Str, from: Int, end: Int) -> Int {
    let n = len(part)
    let first = part[0]
    let mut at = from
    for at + n <= end {
        if text[at] == first {
            let mut k = 1
            for k < n && text[at + k] == part[k] {
                k = k + 1
            }
            if k == n {
                return at
            }
        }
        at = at + 1
    }
    return -1
}

// ---- The lazy DFA ----
//
// A search first runs a DFA, built while it runs: a state is the list of
// threads the Pike VM would have before their closure, in priority order,
// with the class of the byte read last when the pattern has assertions, and
// each transition, on a code point, is worked out once, when first taken,
// and then is a table lookup. The forward DFA finds where the leftmost-first
// match ends; one of the reversed pattern, run backwards from there, finds
// the leftmost place it can start, which is the match's start; and the VM
// then runs only over the match, and only for groups. Past a number of
// states, the DFA gives up and the VM does the searching.

type Dfa = struct {
    reverse: Bool  // of the reversed program, run backwards
    limit: Int  // states before giving up
    failed: Bool
    pcs: [[Int]]  // each state's threads; LOOP() starts the search again
    sides: [Int]  // each state's class of the byte read last (0 without assertions)
    idle: [Bool]  // the state only waits for a match to start
    ids: Map[Int, Int]  // a hash of a state's side and threads: the last state made with it
    same: [Int]  // each state: the one made before it with the same hash, or -1
    row: Int  // transitions of a state: one for each ASCII byte, -1, and each of the regex's ranges of other code points
    table: [Int]  // state * row + column: -1 not yet known, or next state * 2 + 1 if a match ends before the code point
    on: [Int]  // closure: instructions met, when equal to gen
    gen: Int
    stack: [Int]
    list: [Int]  // closure: the threads reached, in priority order
}

// The DFAs of one call, kept from one match to the next. Until they have
// states, a search of fewer than `least` bytes goes to the VM: on a short
// text, making the states costs more than the VM's whole search.
type Cache = struct {
    dfas: [Dfa]  // forward, then reverse, each made when first needed
    least: Int
    limit: Int  // states each DFA may make
}

fn cache(re: Regex) -> Cache {
    return Cache { dfas: [], least: 256, limit: 3000 }
}

fn dfa(re: Regex, reverse: Bool, limit: Int) -> Dfa {
    let mut size = len(re.ops)
    if reverse {
        size = len(re.rops)
    }
    let mut d = Dfa { reverse: reverse, limit: limit, failed: false, pcs: [], sides: [], idle: [], ids: [:], same: [], row: 130 + len(re.cuts), table: [],
        on: [], gen: 0, stack: [], list: [] }
    for _ in 0..size {
        push(mut d.on, -1)
    }
    for _ in 0..2 * size + 2 {
        push(mut d.stack, 0)
    }
    let _ = state(mut d, [], 0)  // 0: no threads left
    return d
}

fn LOOP() -> Int {
    return -1
}

// The class of a code point beside a position, as assertions see it: 0
// the edge of the text, 1 \n, 2 \r, 3 an ASCII word character, 4 any
// other, and 5 a word character past ASCII when the pattern has Unicode
// word assertions (`uword`), which tell it from the others.
fn class_of(cp: Int, uword: Bool) -> Int {
    if uword && cp >= 0x80 && unicode.has(cp, "Word") {
        return 5
    }
    if cp == 10 {
        return 1
    }
    if cp == 13 {
        return 2
    }
    if cp >= 0 && cp < 0x80 && word_byte(byte(cp)) {
        return 3
    }
    return 4
}

// The class of the code point before (or at) byte `at`.
fn side_class(re: Regex, text: Str, at: Int, before: Bool) -> Int {
    if before && at <= 0 || !before && at >= len(text) {
        return 0
    }
    let mut i = at
    if before {
        i = at - 1
    }
    let b = int(text[i])
    if b < 0x80 || !re.uword {
        return class_of(b, false)
    }
    if before {
        return class_of(code_point_before(text, 0, at), true)
    }
    return class_of(code_point(text, at), true)
}

// Whether an assertion holds between bytes of classes `before` and `after`
// (as `holds` decides from the text).
fn holds_between(kind: Int, before: Int, after: Int) -> Bool {
    if kind == TEXT_START() {
        return before == 0
    }
    if kind == TEXT_END() {
        return after == 0
    }
    if kind == LINE_START() {
        return before == 0 || before == 1
    }
    if kind == LINE_END() {
        return after == 0 || after == 1
    }
    if kind == CRLF_START() {
        return before == 0 || before == 1 || before == 2 && after != 1
    }
    if kind == CRLF_END() {
        return after == 0 || after == 2 || after == 1 && before != 2
    }
    if kind >= 12 {
        return word_holds(kind - 8, before == 3 || before == 5, after == 3 || after == 5)
    }
    return word_holds(kind, before == 3, after == 3)
}

// The state of these threads, made if it is new.
fn state(d: mut Dfa, pcs: [Int], side: Int) -> Int {
    if len(pcs) == 0 && len(d.pcs) > 0 {
        return 0
    }
    let mut h = side
    for p in pcs {
        h = (h * 31 + p + 2) & 0xFFFFFFFFFFF
    }
    let mut last = -1
    match maps.get(d.ids, h) {
        Some(id) => last = id
        None => {}
    }
    let mut k = last
    for k >= 0 {
        if d.sides[k] == side && same(d.pcs[k], pcs) {
            return k
        }
        k = d.same[k]
    }
    if len(d.pcs) >= d.limit || len(d.table) + d.row > 130 * d.limit {
        d.failed = true
        return 0
    }
    let id = len(d.pcs)
    push(mut d.pcs, pcs)
    push(mut d.sides, side)
    push(mut d.idle, len(pcs) == 1 && pcs[0] == LOOP())
    push(mut d.same, last)
    for _ in 0..d.row {
        push(mut d.table, -1)
    }
    d.ids[h] = id
    return id
}

// The closure of state `s`'s threads between bytes of classes `before` and
// `after`, into `d.list`: the threads that read a code point next, in
// priority order. Whether a match ends there; forward, the threads after
// the match are cut, as they could only give matches of lower priority.
fn closure(re: Regex, d: mut Dfa, s: Int, before: Int, after: Int) -> Bool {
    d.gen = d.gen + 1
    d.list = []
    let pcs = d.pcs[s]
    let mut matched = false
    for p in pcs {
        let mut pc = p
        if p == LOOP() {
            pc = 0
        }
        if follow(re, mut d, pc, before, after) {
            matched = true
            if !d.reverse {
                return true
            }
        }
        if p == LOOP() {
            push(mut d.list, LOOP())
        }
    }
    return matched
}

fn follow(re: Regex, d: mut Dfa, pc0: Int, before: Int, after: Int) -> Bool {
    let mut ops = re.ops
    let mut xs = re.xs
    let mut ys = re.ys
    if d.reverse {
        ops = re.rops
        xs = re.rxs
        ys = re.rys
    }
    let mut matched = false
    d.stack[0] = pc0
    let mut n = 1
    for n > 0 {
        n = n - 1
        let pc = d.stack[n]
        if d.on[pc] == d.gen {
            continue
        }
        d.on[pc] = d.gen
        let op = ops[pc]
        if op == JUMP() {
            d.stack[n] = xs[pc]
            n = n + 1
        } else if op == SPLIT() {
            d.stack[n] = ys[pc]
            d.stack[n + 1] = xs[pc]
            n = n + 2
        } else if op == SAVE() {
            d.stack[n] = pc + 1
            n = n + 1
        } else if op == LOOK() {
            if holds_between(xs[pc], before, after) {
                d.stack[n] = pc + 1
                n = n + 1
            }
        } else if op == MATCH() {
            matched = true
            if !d.reverse {
                return true
            }
        } else {
            push(mut d.list, pc)
        }
    }
    return matched
}

// The transition of state `s` on code point `cp` (-1 for a byte that is
// not UTF-8), worked out and kept: the next state * 2, plus 1 when a match
// ends before the code point.
fn step(re: Regex, d: mut Dfa, s: Int, cp: Int) -> Int {
    let cls = class_of(cp, re.uword)
    let side = d.sides[s]
    let mut matched = false
    if d.reverse {
        matched = closure(re, mut d, s, cls, side)
    } else {
        matched = closure(re, mut d, s, side, cls)
    }
    let mut ops = re.ops
    let mut xs = re.xs
    let mut sets = re.sets
    if d.reverse {
        ops = re.rops
        xs = re.rxs
        sets = re.rsets
    }
    let mut next: [Int] = []
    for t in d.list {
        if t == LOOP() {
            push(mut next, LOOP())
        } else if ops[t] == CHAR() && xs[t] == cp || ops[t] == CLASS() && in_class(sets[t], cp) {
            push(mut next, t + 1)
        }
    }
    if d.reverse {
        sort_ints(mut next)  // backwards, every match counts, in any order
    }
    let mut new_side = 0
    if re.looks {
        new_side = cls
    }
    let mut v = state(mut d, next, new_side) * 2
    if matched {
        v = v + 1
    }
    d.table[s * d.row + column(re, cp)] = v
    return v
}

fn same(a: [Int], b: [Int]) -> Bool {
    if len(a) != len(b) {
        return false
    }
    for i in 0..len(a) {
        if a[i] != b[i] {
            return false
        }
    }
    return true
}

// State `s` with the class of the byte read last as the text has it, which
// a byte that is not UTF-8 can hide: after one, the code point it belongs
// to (a search can start inside one) decides what Unicode word assertions
// see, as it does for the VM.
fn resided(d: mut Dfa, s: Int, side: Int) -> Int {
    if d.sides[s] == side {
        return s
    }
    return state(mut d, d.pcs[s], side)
}

fn sort_ints(xs: mut [Int]) {
    for i in 1..len(xs) {
        let x = xs[i]
        let mut j = i
        for j > 0 && xs[j - 1] > x {
            xs[j] = xs[j - 1]
            j = j - 1
        }
        xs[j] = x
    }
}

// Where the leftmost-first match between `start` and `end` ends: -1 if
// there is none, -2 if the DFA gave up. It reads the text as `pike` does,
// a code point at a time from `start`.
fn forward(re: Regex, d: mut Dfa, text: Str, start: Int, end: Int, anchored: Bool) -> Int {
    if d.failed {
        return -2
    }
    let mut side = 0
    if re.looks {
        side = side_class(re, text, start, true)
    }
    let mut s = 0
    if anchored {
        s = state(mut d, [0], side)
    } else {
        s = state(mut d, [LOOP()], side)
    }
    let skip = len(re.prefix) > 1 || len(re.first) > 0
    let mut at = start
    let mut last = -1
    for at < end && !d.failed {
        if skip && d.idle[s] {
            // No match has started: on to where one can.
            let from = at
            if len(re.prefix) > 1 {
                at = find_bytes(text, re.prefix, at, end)
                if at < 0 {
                    return -1
                }
            } else {
                for at < end && !re.first[int(text[at])] {
                    at = at + 1
                }
                if at >= end {
                    return -1
                }
            }
            if at != from && re.looks {
                s = state(mut d, [LOOP()], side_class(re, text, at, true))
            }
        }
        let mut cp = int(text[at])
        let mut w = 1
        let mut col = cp
        if cp >= 0x80 {
            cp = code_point(text, at)
            w = cp_width(cp)
            col = column(re, cp)
        }
        let mut v = d.table[s * d.row + col]
        if v < 0 {
            v = step(re, mut d, s, cp)
        }
        if d.failed {
            return -2
        }
        if v & 1 == 1 {
            last = at
        }
        s = v >> 1
        if s == 0 {
            return last
        }
        at = at + w
        if cp < 0 && re.uword {
            s = resided(mut d, s, side_class(re, text, at, true))
        }
    }
    if d.failed {
        return -2
    }
    if closure(re, mut d, s, d.sides[s], side_class(re, text, at, false)) {
        last = at
    }
    return last
}

// The leftmost place at or after `start` where a match of the pattern can
// start and end at `end`, by the reversed pattern read backwards: -1 if
// there is none, -2 if the DFA gave up.
fn backward(re: Regex, d: mut Dfa, text: Str, start: Int, end: Int) -> Int {
    if d.failed {
        return -2
    }
    let mut side = 0
    if re.looks {
        side = side_class(re, text, end, false)
    }
    let mut s = state(mut d, [0], side)
    let mut at = end
    let mut first = -1
    for at > start && !d.failed {
        let mut cp = int(text[at - 1])
        let mut w = 1
        let mut col = cp
        if cp >= 0x80 {
            cp = code_point_before(text, start, at)
            w = cp_width(cp)
            col = column(re, cp)
        }
        if cp < 0 && re.uword {
            // No thread reads a byte that is not UTF-8 (here, perhaps a
            // code point the search's start cuts): the search ends, at a
            // match if one ends here with the code point the text has
            // before it, as the VM sees it.
            if closure(re, mut d, s, side_class(re, text, at, true), d.sides[s]) {
                first = at
            }
            return first
        }
        let mut v = d.table[s * d.row + col]
        if v < 0 {
            v = step(re, mut d, s, cp)
        }
        if d.failed {
            return -2
        }
        if v & 1 == 1 {
            first = at
        }
        s = v >> 1
        if s == 0 {
            return first
        }
        at = at - w
    }
    if d.failed {
        return -2
    }
    if closure(re, mut d, s, side_class(re, text, at, true), d.sides[s]) {
        first = at
    }
    return first
}

// The code point that ends at byte `at`, as decoding forward from `start`
// reads it, or -1 for a byte that is not part of one.
fn code_point_before(text: Str, start: Int, at: Int) -> Int {
    for k in 1..5 {
        if at - k < start {
            return -1
        }
        if int(text[at - k]) & 0xC0 != 0x80 {
            let cp = code_point(text, at - k)
            if cp >= 0 && cp_width(cp) == k {
                return cp
            }
            return -1
        }
    }
    return -1
}

// The column of a code point in a state's transitions: ASCII bytes, then
// -1, then the ranges of other code points that no literal or class of the
// pattern tells apart.
fn column(re: Regex, cp: Int) -> Int {
    if cp < 0x80 {
        if cp < 0 {
            return 128
        }
        return cp
    }
    // The number of cuts at or before cp.
    let mut lo = 0
    let mut hi = len(re.cuts)
    for lo < hi {
        let mid = (lo + hi) / 2
        if re.cuts[mid] <= cp {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return 129 + lo
}

// Where the literals and classes of a program start or stop including code
// points past ASCII: between two cuts, each code point is in the same ones.
fn cuts_of(program: [Inst], uword: Bool) -> [Int] {
    let mut cuts: [Int] = []
    if uword {
        // Unicode word assertions tell word characters from others too.
        let word = unicode.ranges("Word")
        for k in 0..len(word) {
            let x = word[k] + k % 2
            if x > 0x80 && x <= 0x10FFFF {
                push(mut cuts, x)
            }
        }
    }
    for i in program {
        if i.op == CHAR() && i.a >= 0x80 {
            push(mut cuts, i.a)
            push(mut cuts, i.a + 1)
        } else if i.op == CLASS() {
            for k in 0..len(i.ranges) {
                let x = i.ranges[k] + k % 2  // a range's start, or after its end
                if x > 0x80 && x <= 0x10FFFF {
                    push(mut cuts, x)
                }
            }
        }
    }
    let mut out: [Int] = []
    for x in lists.sort(cuts) {
        if len(out) == 0 || out[len(out) - 1] != x {
            push(mut out, x)
        }
    }
    return out
}

// The leftmost-first match between `start` and `end`, as `width` capture
// slots, or none.
fn search(re: Regex, c: mut Cache, text: Str, start: Int, end: Int, anchored: Bool, width: Int) -> [Int] {
    if len(c.dfas) == 0 {
        if end - start < c.least {
            return pike(re, text, start, end, anchored, width)
        }
        push(mut c.dfas, dfa(re, false, c.limit))
    }
    let only_start = anchored || re.anchored
    let e = forward(re, mut c.dfas[0], text, start, end, only_start)
    if e == -1 {
        return []
    }
    if e >= 0 {
        let mut s = start
        if !only_start {
            if len(c.dfas) == 1 {
                push(mut c.dfas, dfa(re, true, c.limit))  // made for the first match
            }
            s = backward(re, mut c.dfas[1], text, start, e)
        }
        if s >= 0 {
            if width == 2 {
                return [s, e]
            }
            return pike(re, text, s, e, true, width)
        }
    }
    return pike(re, text, start, end, anchored, width)
}

// ---- Tests ----

fn spans(re: Regex, text: Str) -> Str {
    let mut b = strings.builder()
    for m in find_all(re, text) {
        strings.add(mut b, "[" + strings.from_int(m.start) + "," + strings.from_int(m.end) + ")")
    }
    return strings.build(b)
}

fn error_of(pattern: Str) -> Str {
    match compile(pattern) {
        Ok(_) => return "compiled"
        Err(e) => return e
    }
}

test "leftmost-first matches" {
    assert(spans(must("a+"), "baaab aa") == "[1,4)[6,8)")
    assert(spans(must("a|ab"), "ab") == "[0,1)")
    assert(spans(must("ab|a"), "ab") == "[0,2)")
    assert(spans(must("a*?"), "aa") == "[0,0)[1,1)[2,2)")
    assert(spans(must("x*"), "ab") == "[0,0)[1,1)[2,2)")
    assert(is_match(must(r"^\d{4}-\d{2}$"), "2026-10"))
    assert(!is_match(must(r"^\d{4}-\d{2}$"), "2026-1"))
}

test "groups and replacement" {
    let re = must(r"(?P<key>\w+)=(?P<value>\d+)?")
    match captures(re, "a b=12 c") {
        Some(g) => {
            assert(group_text("a b=12 c", g, 0) == "b=12")
            assert(group_text("a b=12 c", g, group_index(re, "key")) == "b")
            assert(group_text("a b=12 c", g, 2) == "12")
        }
        None => assert(false)
    }
    match captures(re, "x=") {
        Some(g) => assert(g[2].start == -1 && group_text("x=", g, 2) == "")
        None => assert(false)
    }
    assert(replace_all(re, "a=1, b=2", "${value}:$key$$") == "1:a$, 2:b$")
    assert(replace_all(must(r"\s+"), " a  b ", "_") == "_a_b_")
    let parts = split(must(r",\s*"), "a, b,c")
    assert(len(parts) == 3 && parts[0] == "a" && parts[1] == "b" && parts[2] == "c")
}

test "flags, classes and assertions" {
    assert(spans(must("(?i)straße|[^x]Y"), "STRAßE aY") == "[0,7)[8,10)")
    assert(spans(must(r"(?m)^\w"), "ab\ncd") == "[0,1)[3,4)")
    assert(spans(must(r"\bis\b"), "this is") == "[5,7)")
    assert(spans(must("[[:digit:]a-c]+"), "x1b2-d") == "[1,4)")
    assert(spans(must("(?s)a.b"), "a\nb") == "[0,3)")
    assert(spans(must("a.b"), "a\nb aéb") == "[4,8)")
    assert(spans(must("(?x) a  b # a comment\n c"), "abc") == "[0,3)")
}

test "empty matches stay on code point boundaries" {
    assert(spans(must(""), "é") == "[0,0)[2,2)")
    assert(len(split(must(""), "aé")) == 4)
}

test "linear time on patterns that backtracking makes exponential" {
    let mut text = ""
    for _ in 0..5000 {
        text = text + "a"
    }
    assert(!is_match(must("(a+)+$"), text + "b"))
    assert(!is_match(must("(a|aa)+c"), text))
    assert(!is_match(must("(x+x+)+y"), text))
}

test "errors" {
    assert(error_of("(a") == "regex error at offset 0: a group without its ')'")
    assert(error_of("*a") != "compiled")
    assert(error_of("[z-a]") != "compiled")
    assert(error_of("a{3,2}") != "compiled")
    assert(error_of(r"\1") != "compiled")
    assert(error_of("(?<n>a)(?<n>b)") != "compiled")
    assert(error_of("a{100001}") != "compiled")
}

// The DFAs against the Pike VM alone, from every byte of texts with
// assertions' edge cases, code points of every width, and bytes that are
// not UTF-8; and with a DFA that gives up at once.
test "the DFAs find what the Pike VM finds" {
    let patterns = ["a+", "(a|ab)(c|bcd)(d*)", r"\bé\w*", "(?m)^.+$", "(?R)^b$", "(?i)Ab|é+", "x*", "[^a]+?b", r"\B..\b", "(?s).{2,3}",
        r"\b{start}\w+\b{end}", r"\<b|\>", "(é|€)+𝄞?", "$", r"\Ab|c\z", r"(?m)(?:\r?\n)+", "a(?:b|)*c", r"[[:space:]]\S+", r"\w\b{end-half}", "(?U)a+"]
    let mut bad = strings.builder()
    strings.add(mut bad, "ab")
    strings.add_byte(mut bad, byte(0xFF))
    strings.add(mut bad, "é")
    strings.add_byte(mut bad, byte(0xC3))
    strings.add(mut bad, "ab\n")
    let texts = ["aabcd ab abcd", "é€𝄞 éa xé\n€é", "a\r\nb\r\n\r\nc\nb", "ab Ab éé", strings.build(bad), "", "\n", "bbb ab é b"]
    for p in patterns {
        let re = must(p)
        for text in texts {
            for start in 0..len(text) + 1 {
                for anchored in [false, true] {
                    for width in [2, re.groups * 2] {
                        let mut c = cache(re)
                        c.least = 0
                        let got = search(re, mut c, text, start, len(text), anchored, width)
                        let want = pike(re, text, start, len(text), anchored, width)
                        if !same(got, want) {
                            print(p + " on " + text + " from " + strings.from_int(start))
                        }
                        assert(same(got, want))
                        let mut small = cache(re)
                        small.least = 0
                        small.limit = 2
                        assert(same(search(re, mut small, text, start, len(text), anchored, width), want))
                    }
                }
            }
        }
    }
}

fn next_random(seed: mut Int) -> Int {
    seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF
    return seed >> 8
}

fn random_pattern(seed: mut Int, depth: Int) -> Str {
    let atoms = ["a", "b", ".", r"\w", r"\s", r"\D", "[a-c]", "[^b]", "é", "€", "[à-ü]", "[^é]", r"\b", r"\B", "^", "$", "(?m:^)", "(?m:$)", "(?R:$)", r"\r",
        r"\n", "(?i:A)", "(?s:.)", r"\b{end}", r"\<", r"\pL", r"\p{Nd}", r"(?-u:\b)", r"(?-u:\w)", "(?i:É)", "(?i:k)"]
    let r = next_random(mut seed) % 20
    if depth > 3 || r < 7 {
        return atoms[next_random(mut seed) % len(atoms)]
    }
    if r < 11 {
        return random_pattern(mut seed, depth + 1) + random_pattern(mut seed, depth + 1)
    }
    if r < 13 {
        return random_pattern(mut seed, depth + 1) + "|" + random_pattern(mut seed, depth + 1)
    }
    if r < 16 {
        return "(" + random_pattern(mut seed, depth + 1) + ")"
    }
    let reps = ["*", "+", "?", "{2}", "{0,2}", "*?", "+?"]
    return "(?:" + random_pattern(mut seed, depth + 1) + ")" + reps[next_random(mut seed) % len(reps)]
}

fn random_text(seed: mut Int) -> Str {
    let parts = ["a", "b", "c", " ", "\n", "\r", "é", "€", "ü", "A", "-", "K", "ß", "١", "É", "́"]
    let mut b = strings.builder()
    let n = next_random(mut seed) % 14
    for _ in 0..n {
        let k = next_random(mut seed) % (len(parts) + 1)
        if k == len(parts) {
            strings.add_byte(mut b, byte(0x80 + next_random(mut seed) % 0x7F))  // not UTF-8 here
        } else {
            strings.add(mut b, parts[k])
        }
    }
    return strings.build(b)
}

test "the DFAs find what the Pike VM finds, on random patterns" {
    let mut seed = 7
    for _ in 0..2000 {
        let p = random_pattern(mut seed, 0)
        match compile(p) {
            Ok(re) => {
                for _ in 0..3 {
                    let text = random_text(mut seed)
                    for start in 0..len(text) + 1 {
                        for anchored in [false, true] {
                            let width = re.groups * 2
                            let mut c = cache(re)
                            c.least = 0
                            let want = pike(re, text, start, len(text), anchored, width)
                            let got = search(re, mut c, text, start, len(text), anchored, width)
                            if !same(got, want) {
                                print(p + " on " + text + " from " + strings.from_int(start))
                            }
                            assert(same(got, want))
                        }
                    }
                }
            }
            Err(_) => {}
        }
    }
}

test "a skip to where a match can start forgets the assertions met before it" {
    // The \b after \n failed at 1; skipped to 3, it holds (with ASCII word
    // characters: in Unicode mode é is one, and \b holds at 1).
    assert(spans(must(r"(?-u)(?:\n)?\b\w+"), "\néAb-c") == "[3,5)[6,7)")
    assert(spans(must(r"(?-u)b|(?:\n)?\b\w+"), "\néAb") == "[3,5)")
    assert(spans(must(r"(?:\n)?\b\w+"), "\néAb-c") == "[0,5)[6,7)")
}

test "Unicode classes, properties and case folding" {
    assert(spans(must(r"\w+"), "naïve café_1") == "[0,6)[7,14)")
    assert(spans(must(r"(?-u)\w+"), "naïve") == "[0,2)[4,6)")
    assert(spans(must(r"\d+"), "x٣٤5") == "[1,6)" && spans(must(r"(?-u)\d+"), "x٣٤5") == "[5,6)")
    // A no-break space is White_Space; ASCII \s leaves it out.
    assert(spans(must(r"\s"), "a\u{a0}b") == "[1,3)" && spans(must(r"(?-u)\s"), "a\u{a0}b") == "")
    assert(spans(must(r"\bé"), "é xé") == "[0,2)" && spans(must(r"(?-u)\bx"), "éx") == "[2,3)")
    assert(spans(must(r"\pL+"), "ab12αβ") == "[0,2)[4,8)" && spans(must(r"\p{Nd}+"), "ab12αβ") == "[2,4)")
    assert(spans(must(r"\P{L}+"), "ab12αβ") == "[2,4)" && spans(must(r"\p{^Lu}+"), "AbC") == "[1,2)")
    assert(spans(must(r"\p{gc=Lowercase_Letter}+"), "AbcD") == "[1,3)" && spans(must(r"[\p{Lu}\d]+"), "aB1c") == "[1,3)")
    // The Kelvin sign folds to k, and ẞ to ß.
    assert(spans(must("(?i)k+"), "kK\u{212a}") == "[0,5)" && spans(must("(?-u)(?i)k+"), "kK\u{212a}") == "[0,2)")
    assert(spans(must("(?i)straße"), "STRA\u{1e9e}E") == "[0,8)" && spans(must("(?i)ω+"), "ΩωΩ") == "[0,6)")
    assert(spans(must("(?i)(?-u)é"), "É") == "")
    assert(error_of(r"\p{Greek}") != "compiled" && error_of(r"(?-u)\pL") != "compiled" && error_of(r"\p{L") != "compiled")
}
